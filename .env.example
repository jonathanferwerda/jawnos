# Copy to .env and edit. `docker compose` reads .env automatically.

# Identity shown in the UI and the host used in generated links. Keep
# 127.0.0.1 when the browser is on the Docker host; use the LAN or tailnet
# name for a remote host.
JAWNOS_NAME=House
JAWNOS_DOMAIN=127.0.0.1

# server = no browser, no watch/teletype servers (the container has no display).
JAWNOS_DEVICE=server
JAWNOS_LANGUAGE=en

# Optional: choose the 4-12 digit unlock code. Without it the first boot
# generates one and prints it once to `docker compose logs`.
# JAWNOS_UNLOCK_CODE=

# Optional: keep a copy of a generated code in the home volume (mode 0600).
# JAWNOS_SAVE_UNLOCK_CODE=1

# Optional: published/listened-on ports. JAWNOS_WS_PORT must be
# JAWNOS_WORKING_PORT + 1.
# JAWNOS_LOCKER_PORT=3000
# JAWNOS_WORKING_PORT=45545
# JAWNOS_WS_PORT=45546

# Optional: bind published ports to one host address. 0.0.0.0 for a server;
# the nightly Docker smoke uses 127.0.0.1.
# JAWNOS_BIND_ADDR=0.0.0.0

# Optional: image tag built and run by Compose. The nightly smoke uses
# jawnos:nightly so it cannot overwrite a hand-built jawnos:local.
# JAWNOS_IMAGE=jawnos:local

# Optional: container paths for host media mounted into the home volume.
# JAWNOS_FOLDERS=/home/jawn/Music:/home/jawn/Pictures

# Optional: a small box can run fewer prefork workers (server default four).
# JAWNOS_MAIN_WORKERS=2

TZ=UTC
