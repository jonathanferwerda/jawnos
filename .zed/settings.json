{
  "file_scan_exclusions": [
    "**/.pio",
    "**/build",
    "**/database/backups",
    "**/database/*.db",
    "**/database/*.db-shm",
    "**/database/*.db-wal",
    "**/voices",
    "**/releases",
    "**/node_modules",
    "..."
  ],
  "languages": {
    "Perl": { "language_servers": [] },
    "JavaScript": { "language_servers": [] },
    "TypeScript": { "language_servers": [] },
    "TSX": { "language_servers": [] },
    "Python": { "language_servers": [] },
    "JSON": { "language_servers": [] },
    "JSONC": { "language_servers": [] },
    "CSS": { "language_servers": [] }
  },
  "lsp": {
    "perlnavigator-server": {
      "settings": {
        "perlnavigator": {
          "perlcriticEnabled": false,
          "perltidyEnabled": false,
          "logging": false
        }
      }
    }
  }
}
