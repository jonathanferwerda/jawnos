#!/bin/sh
set -e

# Python may have cached the desktop package while the app ran; dpkg cannot
# remove a directory that still holds an untracked file.
case "$1" in
	remove|purge)
		rm -rf /usr/share/jawnos/desktop/jawnos_desktop/__pycache__
		rmdir /usr/share/jawnos/desktop/jawnos_desktop 2>/dev/null || true
		rmdir /usr/share/jawnos/desktop 2>/dev/null || true
		rmdir /usr/share/jawnos 2>/dev/null || true
		;;
esac

#DEBHELPER#

if [ "$1" = purge ]; then
	cat <<'EOF'
JawnOS: /var/lib/jawnos (the database, its backups and the TLS material) was
kept on purge. Remove it by hand only when the house is really gone.
EOF
fi
