# Package defaults for jawnos.service. The writable half of the install lives
# here; the code under /usr/share/jawnos stays read-only.
JAWNOS_STORE_DIR=/var/lib/jawnos
# A headless package is a server: no watch/teletype servers, fewer workers.
JAWNOS_DEVICE=server
# The distro (and the package) owns the dependencies; first run must not try to
# install them as the service user.
JAWNOS_PACKAGED=1
