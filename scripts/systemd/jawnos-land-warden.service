[Unit]
Description=JawnOS land warden (rescue one refused ticket into a worktree)
Documentation=file:/home/jawn/jawnos/docs/AGENTS-concurrency.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jawn
WorkingDirectory=/home/jawn/jawnos
Environment=HOME=/home/jawn
Environment=JAWNOS_QA_ROOT=/home/jawn/jawnos-qa
# One ticket and one suite at a time. The warden holds land-warden.lock, so a
# manual run and the timer cannot both rescue the same ticket.
ExecStart=/usr/bin/perl /home/jawn/jawnos/scripts/land_warden.pl --once --max 1 --jobs 2
# The suite is the slow part, and it shares the box with the coordinator.
Nice=10
CPUQuota=200%
TimeoutStartSec=2h
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
