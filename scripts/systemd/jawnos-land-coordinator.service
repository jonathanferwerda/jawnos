[Unit]
Description=JawnOS landing coordinator (one queue, one train)
Documentation=file:/home/jawn/jawnos/docs/AGENTS-concurrency.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jawn
WorkingDirectory=/home/jawn/jawnos
Environment=HOME=/home/jawn
Environment=JAWNOS_QA_ROOT=/home/jawn/jawnos-qa
# One drain at a time. The script also holds land-coordinator.lock, so a manual
# run and the timer cannot both drain. The coordinator lands the tested waves on
# the working branch; the primary checkout follows main, which only the
# promotion job moves.
ExecStart=/usr/bin/perl /home/jawn/jawnos/scripts/land_coordinator.pl --train-size 6 --jobs 4 --trunk working --no-apply
# A wave runs the suite and may serve several branches; a cold guard is minutes.
Nice=5
TimeoutStartSec=4h
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
