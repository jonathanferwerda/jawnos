[Unit]
Description=JawnOS land promotion (weekly release by default)

[Timer]
# Weekly by default. Configure -> Plat -> QA rewrites this through a drop-in
# (an OnCalendar reset plus the chosen line), so a release can be hourly,
# daily, monthly or a phrase like "every third friday of the month". Persistent
# catches a missed run up after a boot; `perl scripts/land_promote.pl --once`
# releases by hand at any time.
OnCalendar=Mon 04:00:00
Persistent=true
Unit=jawnos-land-promote.service

[Install]
WantedBy=timers.target
