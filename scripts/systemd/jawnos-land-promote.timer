[Unit]
Description=JawnOS land promotion (weekly release)

[Timer]
# The weekly release: a quiet working branch is promoted on the first tick
# after this one, and a red suite is retried the following week. `perl
# scripts/land_promote.pl --once` promotes by hand at any time. The coordinator's
# optional --promote-now is the other way to release immediately.
OnBootSec=3min
OnUnitActiveSec=1w
Persistent=true
Unit=jawnos-land-promote.service

[Install]
WantedBy=timers.target
