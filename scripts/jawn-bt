#!/usr/bin/perl
# jawn-bt: client for the JawnOS BLE bridge (JawnBleService in the JawnOS API app).
#
#   jawn-bt scan [seconds]                     list BLE devices
#   jawn-bt connect <mac> [--service U] [--rx U] [--tx U] [--mtu N] [--compress 0|1]
#   jawn-bt send <text> [--mac AA:..]          no --mac = the primary link
#   jawn-bt sendloop [--mac AA:..]             one link, each stdin line a message
#   jawn-bt listen                             stream events as JSON lines
#   jawn-bt status
#   jawn-bt disconnect [mac]                   no mac = every link
#
# Events are printed as raw JSON, one per line, so callers can parse them.
# Up to four links may be live at once; every link-scoped event carries "mac".
use strict;
use warnings;
use IO::Socket::INET;
use IO::Select;
use JSON::PP;
use Time::HiRes qw(sleep time);

$| = 1; # stdout must flush: listen runs for a long time

my $port = 45999;

my $cmd = shift @ARGV;
unless (defined $cmd) {
	die "usage: jawn-bt scan [seconds] | connect <mac> [--service U --rx U --tx U --mtu N --compress 0|1] | send <text> [--mac AA:..] | sendloop [--mac AA:..] | listen | status | disconnect [mac]\n";
}

my %opt;
my @args;
while (defined(my $a = shift @ARGV)) {
	if ($a =~ /^--(service|rx|tx|mtu|compress|mac|id|timeout)$/) { $opt{$1} = shift @ARGV; }
	elsif ($a eq '--all') { $opt{all} = 1; }
	else { push @args, $a; }
}

# How long each command may wait for the daemon. A watch that goes to sleep
# suspends its radio without telling anyone, and a no-response write to it is
# not acknowledged until Android's link supervision timeout (~20 s). Nothing on
# the manager's event loop may sit through that: a deadline is reported as an
# error and the process exits non-zero, so the caller can fall back (an HTTP
# send, a retry) instead of mistaking silence for delivery. --timeout overrides.
my %default_timeout = (connect => 20, send => 15, status => 10, disconnect => 10);
my $timeout = defined $opt{'timeout'} && $opt{'timeout'} =~ /^\d+$/ ? $opt{'timeout'} + 0 : undef;

sub am_path {
	# Android's `am` is not on Termux's PATH in every environment jawn is started
	# from (a background session, the boot path), and a missing `am` made every
	# bridge start fail into /dev/null. Name it outright when it is where Android
	# puts it.
	foreach my $am ('/system/bin/am', '/system/xbin/am') {
		return $am if -x $am;
	}
	return 'am';
}

sub start_daemon {
	# The direct start, as it always was, but with `am` named outright: it is not
	# on Termux's PATH in every environment jawn is started from (a background
	# session, the boot path), and a missing `am` made every start fail into
	# /dev/null.
	system('sh', '-c', am_path() . ' start-foreground-service -n com.termux.api/.JawnBleService >/dev/null 2>&1');
}

sub wake_app {
	# Ask the JawnOS host app to start the bridge, for when the direct start is
	# refused. Android can refuse a foreground-service start from a background app
	# (the error goes to /dev/null, so the bridge simply never came back); the
	# app's JawnWakeReceiver runs in the app's own process, where the start is
	# always allowed, and it brings the BLE bridge up alongside jawn. Safe to
	# repeat: a bridge already up ignores it, and a redundant ./jawn stands down
	# before it touches anything.
	system('sh', '-c', am_path() . ' broadcast -a com.termux.app.JAWN_WAKE -n com.termux/.app.JawnWakeReceiver >/dev/null 2>&1');
}

sub dial {
	# Bounded: the daemon is either up or being started. The old 24 tries with a
	# 2 s connect each could hunt for close to a minute, and the caller waiting on
	# us (a request, a listener reply) wore all of it.
	my $sock;
	my $started = 0;
	for my $i (1 .. 16) {
		$sock = IO::Socket::INET->new(PeerAddr => '127.0.0.1', PeerPort => $port, Proto => 'tcp', Timeout => 1);
		return $sock if $sock;
		unless ($started) { start_daemon(); $started = 1; }
		# Nothing listening a few seconds after the direct start: take the road
		# that is allowed from a background process.
		wake_app() if $i == 6;
		sleep 0.5;
	}
	die "jawn-bt: could not reach the BLE bridge on 127.0.0.1:$port\n";
}

# A hard net over the whole run: a blocking write to a daemon that has stopped
# reading, or a socket call a deadline did not cover, must still end this
# process rather than hang whoever started it. The per-command deadlines below
# are the real bound; this only catches what they miss. listen runs for the life
# of the tree and sendloop for the life of a stream, so neither is armed.
if ($cmd ne 'listen' && $cmd ne 'sendloop') {
	$SIG{ALRM} = sub {
		print JSON::PP->new->encode({ event => 'error', error => 'timeout', cmd => $cmd }), "\n";
		exit 2;
	};
	alarm(($timeout || ($default_timeout{$cmd} || 30)) + 12);
}

my $sock = dial();
$sock->autoflush(1);
$sock->blocking(0);

my $sel = IO::Select->new($sock);
my $buf = '';

sub send_cmd {
	my $h = shift;
	print {$sock} JSON::PP->new->encode($h), "\n";
}

# Does a status event show $want connected? With no $want, asks about the
# primary link (the v1 top-level fields); with a MAC, looks in the v2 list.
sub status_shows_connected {
	my ($o, $want) = @_;
	unless (defined $want) {
		return $o->{'connected'} ? 1 : 0;
	}
	if (ref $o->{'links'} eq 'ARRAY') {
		for my $row (@{ $o->{'links'} }) {
			return 1 if uc($row->{'mac'} || '') eq $want && $row->{'connected'};
		}
		return 0;
	}
	return (uc($o->{'mac'} || '') eq $want && $o->{'connected'}) ? 1 : 0;
}

# Read whatever arrived within $timeout seconds; print each line as JSON.
# Returns the first event satisfying $cond, or undef on timeout/EOF.
# (Non-blocking + select: a blocking readline here would ignore the deadline.)
sub wait_for {
	my ($cond, $timeout) = @_;
	my $deadline = time() + $timeout;
	while (time() < $deadline) {
		my $rem = $deadline - time();
		my @ready = $sel->can_read($rem > 0.2 ? 0.2 : $rem);
		next unless @ready;
		my $chunk = '';
		my $n = sysread($sock, $chunk, 65536);
		return undef unless defined $n && $n > 0;
		$buf .= $chunk;
		while ($buf =~ s/^(.*?)\n//) {
			my $line = $1;
			print $line, "\n";
			my $o = eval { JSON::PP->new->decode($line) };
			return $o if $o && $cond->($o);
		}
	}
	return undef;
}

my $last;
if ($cmd eq 'scan') {
	my $secs = $args[0] || 8;
	send_cmd({ cmd => 'scan', seconds => $secs });
	$last = wait_for(sub { $_[0]->{'event'} eq 'scan_done' || $_[0]->{'event'} eq 'error' }, $timeout || ($secs + 15));
}
elsif ($cmd eq 'connect') {
	my $mac = $args[0] or die "jawn-bt connect: mac required\n";
	my %h = (cmd => 'connect', mac => $mac);
	for my $k (qw/service rx tx/) {
		$h{$k} = $opt{$k} if defined $opt{$k};
	}
	$h{'mtu'} = $opt{'mtu'} + 0 if defined $opt{'mtu'};
	# --compress is per-link and defaults true on the daemon side; only pass it
	# when the caller named it, as a real JSON boolean.
	if (defined $opt{'compress'}) {
		$h{'compress'} = $opt{'compress'} =~ /^(0|false|no|off)$/i
			? JSON::PP::false : JSON::PP::true;
	}
	send_cmd(\%h);
	my $want = uc $mac;
	$last = wait_for(sub {
		my $o = shift;
		return 0 unless $o->{'event'} =~ /^(connected|disconnected|error)$/
			|| $o->{'event'} eq 'status';
		if ($o->{'event'} eq 'status') {
			# The daemon answers an idempotent connect with a snapshot; the
			# initial snapshot on socket accept must not end the wait.
			return status_shows_connected($o, $want) ? 1 : 0;
		}
		# An error without a mac is adapter-wide; a link event for another
		# MAC is not this command's answer.
		return 1 unless defined $o->{'mac'};
		return uc($o->{'mac'}) eq $want;
	}, $timeout || $default_timeout{'connect'});
}
elsif ($cmd eq 'send') {
	my $text = $args[0];
	unless (defined $text) { local $/; $text = <STDIN>; }
	$text =~ s/\s+$// if defined $text;
	die "jawn-bt send: empty message\n" unless defined $text && length $text;
	my %h = (cmd => 'send', message => $text);
	$h{'mac'} = $opt{'mac'} if defined $opt{'mac'};
	$h{'id'} = $opt{'id'} + 0 if defined $opt{'id'};
	send_cmd(\%h);
	my $want = defined $opt{'mac'} ? uc $opt{'mac'} : undef;
	$last = wait_for(sub {
		my $o = shift;
		return 0 unless $o->{'event'} =~ /^(sent|error|disconnected)$/;
		# A link that dropped under the write will never acknowledge it: stop
		# waiting for the radio's own supervision timeout and report the failure.
		if ($o->{'event'} eq 'disconnected') {
			return 1 if !defined $want;
			return 1 if !defined $o->{'mac'} || uc($o->{'mac'}) eq $want;
			return 0;
		}
		return 1 unless defined $want;
		return 1 if defined $o->{'mac'} && uc($o->{'mac'}) eq $want;
		return 1 if $o->{'event'} eq 'error' && !defined $o->{'mac'};
		return 0;
	}, $timeout || $default_timeout{'send'});
}
elsif ($cmd eq 'sendloop') {
	# One connection, many messages: each stdin line is forwarded to the daemon as
	# a send. A streamed reply is a dozen messages in a couple of seconds, and a
	# fresh client (a perl start, on a phone) per part would cost more than the
	# audio itself. No waiting for 'sent' here: the daemon serialises the writes,
	# and the stream's own end-of-parts message is the only confirmation needed.
	# The socket is made blocking for this: the script's dial() sets it
	# non-blocking for the listen path, and a plain print to a non-blocking socket
	# silently loses a line when it cannot go out at once, which is exactly how a
	# stream would arrive with parts missing.
	$sock->blocking(1);
	my %base = (cmd => 'send');
	$base{'mac'} = $opt{'mac'} if defined $opt{'mac'};
	while (defined(my $line = <STDIN>)) {
		chomp $line;
		next unless length $line;
		my %h = %base;
		$h{'message'} = $line;
		print {$sock} JSON::PP->new->encode(\%h), "\n";
	}
	close $sock;
}
elsif ($cmd eq 'status') {
	$last = wait_for(sub { $_[0]->{'event'} eq 'status' }, $timeout || $default_timeout{'status'});
}
elsif ($cmd eq 'disconnect') {
	my %h = (cmd => 'disconnect');
	if (defined $args[0]) { $h{'mac'} = $args[0]; }
	elsif ($opt{'all'}) { $h{'all'} = JSON::PP::true; }
	# No mac and no --all is "disconnect everything", the daemon's default.
	send_cmd(\%h);
	my $want = defined $args[0] ? uc $args[0] : undef;
	$last = wait_for(sub {
		my $o = shift;
		return 0 unless $o->{'event'} =~ /^(disconnected|status|error)$/;
		return 1 unless defined $want;
		if ($o->{'event'} eq 'status') {
			# Only stop when the target no longer shows connected (the
			# daemon sends an initial snapshot on connect).
			return status_shows_connected($o, $want) ? 0 : 1;
		}
		return 1 if defined $o->{'mac'} && uc($o->{'mac'}) eq $want;
		return 1 if $o->{'event'} eq 'error' && !defined $o->{'mac'};
		return 0;
	}, $timeout || $default_timeout{'disconnect'});
}
elsif ($cmd eq 'listen') {
	# Ask for the current link up front: the daemon auto-connects to its stored
	# targets, so a listener that attaches after that connect would otherwise
	# never see a 'connected' event and not know which radios are linked.
	send_cmd({ cmd => 'status' });
	$last = wait_for(sub { 0 }, 86400 * 365);
	exit 0;
}
else {
	die "jawn-bt: unknown command '$cmd'\n";
}

# Exit non-zero unless the daemon actually answered. A timeout used to fall
# through as success ($last undef -> 0), so a caller counted a message sent to a
# sleeping watch as delivered and never took its fallback road.
alarm(0);
my $event = ($last && ref $last eq 'HASH') ? ($last->{'event'} || '') : '';
my $ok = 0;
if    ($cmd eq 'scan')       { $ok = $event eq 'scan_done'; }
elsif ($cmd eq 'connect')    { $ok = $event eq 'connected' || $event eq 'status'; }
elsif ($cmd eq 'send')       { $ok = $event eq 'sent'; }
elsif ($cmd eq 'status')     { $ok = $event eq 'status'; }
elsif ($cmd eq 'disconnect') { $ok = $event eq 'disconnected' || $event eq 'status'; }
elsif ($cmd eq 'sendloop')   { $ok = 1; }
unless ($ok) {
	print JSON::PP->new->encode({ event => 'error', error => ($event eq 'error' ? 'daemon' : 'timeout'), event_got => $event, cmd => $cmd }), "\n";
}
exit($ok ? 0 : 2);
