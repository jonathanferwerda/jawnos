// The clock face draws digits and a colon in Montserrat at a size LVGL does not
// ship. The glyph tables are generated by tools/lv_font_digits.py; including the
// .c keeps it out of the build's source list (PlatformIO and arduino-cli would
// otherwise compile it twice).
#include "fonts/clock_font_72.c"

// JawnWatch index: the original jw.ino was split into ordered parts
// (jw_01_*.ino .. jw_15_*.ino). PlatformIO concatenates them after this index
// in sorted order, so the body is unchanged. setup()/loop() forward to the
// original bodies, renamed jawn_setup()/jawn_loop() in jw_03_setup.ino and
// jw_04_loop.ino.
void jawn_setup();
void jawn_loop();

void setup() { jawn_setup(); }
void loop() { jawn_loop(); }
