#!/bin/sh
# pre-commit - keep the baked Coding-agent protocols in step with AGENTS.md.
#
# It also refuses a commit made in the primary checkout while any worktree
# exists: agent work belongs in a worktree, and the lander cannot move the
# primary onto a commit made in it. The refusal prints the move recipe;
# JAWNOS_ALLOW_PRIMARY_COMMIT=1 is the deliberate single-agent override.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Bypass for a moment:     git commit --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 0

# The primary checkout is the first worktree git lists. A linked worktree is a
# place to work; the primary is the place the dev server runs, and a commit
# there cannot be landed by the gate (it moves the primary, it does not replay
# a commit from it). One worktree is the single-agent case and stays allowed.
if [ "${JAWNOS_ALLOW_PRIMARY_COMMIT:-0}" != "1" ]; then
	primary=""
	count=0
	while IFS= read -r line; do
		case "$line" in
			"worktree "*) count=$((count + 1)); [ -n "$primary" ] || primary=${line#worktree } ;;
		esac
	done <<EOF
$(git worktree list --porcelain 2>/dev/null)
EOF
	current=$(git rev-parse --show-toplevel 2>/dev/null)
	if [ "$count" -gt 1 ] && [ -n "$primary" ] && [ "$primary" = "$current" ]; then
		cat >&2 <<MSG
commit refused: this is the primary checkout at $primary.

Agent work belongs in a worktree. Move what is staged and unstaged:
    git stash push --include-untracked -m "move to worktree"
    git worktree add .worktrees/<task> -b agent/<task> origin/main
    cd .worktrees/<task> && git stash pop

Then land from the worktree with:
    perl ~/jawnos/scripts/agent_land.pl

On purpose, working alone? Set JAWNOS_ALLOW_PRIMARY_COMMIT=1.
MSG
		exit 1
	fi
fi

command -v perl >/dev/null 2>&1 || exit 0

# The repository index is generated from the tree and read by the nightly agent.
# Refresh it with every commit so it cannot describe a tree that no longer is -
# but only when the tree is settled: more than one agent works in this checkout,
# and regenerating from a tree with somebody's uncommitted work in it would bake
# their work into this commit and leave the index disagreeing with the commit it
# rides on. A dirty tree leaves the previous index alone; t/97-agent-help.t
# enforces the match whenever the tree is clean.
if [ -f scripts/agent_help.pl ]; then
	if git diff --quiet -- lib templates public/js perl/help database/schema.sql &&
	   git diff --cached --quiet -- lib templates public/js perl/help database/schema.sql; then
		perl scripts/agent_help.pl --write-index >/dev/null 2>&1
	fi
	if ! git diff --quiet -- qa/coding_night/agent-index.md 2>/dev/null; then
		git add qa/coding_night/agent-index.md
		printf 'pre-commit: refreshed qa/coding_night/agent-index.md\n'
	fi
fi

[ -f AGENTS.md ] || exit 0
[ -f scripts/bake_agents_rules.pl ] || exit 0

perl scripts/bake_agents_rules.pl >/dev/null 2>&1
if ! git diff --quiet -- docs/coding_agent_protocols.md 2>/dev/null; then
	git add docs/coding_agent_protocols.md
	printf 'pre-commit: refreshed docs/coding_agent_protocols.md from AGENTS.md\n'
fi
exit 0
