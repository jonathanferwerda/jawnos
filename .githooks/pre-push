#!/bin/sh
# pre-push - nothing that does not parse ships, and the Help registry stays honest.
#
# First, verify the code in the commits being pushed: Perl compiles, JavaScript
# parses, templates compile, and no file was truncated. A hard failure BLOCKS the
# push, so a whole-file write gone wrong cannot reach the other machines.
#
# Then the help auditor: hard errors (a broken related link, a listed template
# that no longer exists, a control the topic names that is no longer on screen)
# BLOCK the push. Stale topics are printed as a to-do but do not block, so
# tidying the code never traps anyone mid-refactor.
#
# Last, the regression suite in t/ runs in parallel (scripts/run_tests.pl boots
# the app once and forks one child per test). A failing test BLOCKS the push, so
# a behaviour change cannot ship without its test passing.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Bypass for a moment:     git push --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 0

# --- run Perl the way the app runs it ---
# Git launches this hook from whatever shell the push came from, so it may not
# have the user's local::lib on @INC. A GUI or bare shell push then fails a
# file for 'Can't locate Text/Unidecode.pm' while the same commit passes the
# restart guard, which ./jawn runs with its own BEGIN block seeding local::lib.
# Do the same here: if PERL5LIB is already supplied, trust it; otherwise put
# $HOME/perl5/lib/perl5 and its version/arch subdirs on it. With no local::lib
# at all nothing is added, so a clean box still pushes against the system perl.
if [ -z "${PERL5LIB:-}" ] && [ -n "${HOME:-}" ] && [ -d "$HOME/perl5/lib/perl5" ]; then
	perl5lib="$HOME/perl5/lib/perl5"
	for dir in "$perl5lib"/*; do
		[ -d "$dir" ] || continue
		case "${dir##*/}" in
			*-linux-*|[0-9]*.[0-9]*) perl5lib="$perl5lib:$dir" ;;
		esac
	done
	PERL5LIB="$perl5lib"
	export PERL5LIB
fi

# --- the same rule again, plus the interpreter (scripts/perl_env.sh) ---
# Git launches this hook from whatever shell the push came from, so @INC may be
# the bare system one and a GUI or bare-shell push fails a file for
# 'Can't locate Text/Unidecode.pm' while the same commit passes the restart
# guard, which ./jawn runs with its own local::lib BEGIN block. The helper picks
# the interpreter ./jawn's shebang names and exports PERL5LIB, so the guard, the
# help audit and the suite all see the modules the app sees.
if [ ! -r scripts/perl_env.sh ]; then
	printf 'pre-push: scripts/perl_env.sh is missing, so the guard cannot run; blocking (not passing). Push with --no-verify if you accept that.\n' >&2
	exit 1
fi
. ./scripts/perl_env.sh
if [ "${PERL_ENV_OK:-1}" -ne 0 ] || [ -z "${PERL:-}" ]; then
	printf 'pre-push: %s, so the guard cannot run; blocking (not passing). Install perl, or push with --no-verify.\n' "${PERL_ENV_ERROR:-no perl interpreter found}" >&2
	exit 1
fi

# --- the code in this push must parse (scripts/verify_change.pl) ---
verdict=0
if [ -f scripts/verify_change.pl ]; then
	while read local_ref local_sha remote_ref remote_sha; do
		# a ref being deleted carries no code to check
		[ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
		base="$remote_sha"
		if [ "$base" = "0000000000000000000000000000000000000000" ]; then
			# a brand-new ref has no remote side: check it against its own parent
			base=$(git rev-parse --verify -q "$local_sha^" 2>/dev/null) || continue
		fi
		out=$("$PERL" scripts/verify_change.pl --quiet --range "$base..$local_sha" 2>&1)
		if [ $? -ne 0 ]; then
			printf '%s\n' "$out"
			verdict=1
		fi
	done
fi
if [ "$verdict" -ne 0 ]; then
	printf '\nverify_change: this push failed the guard (above) - either the code does not parse, or this machine cannot compile it. Fix it, or push with --no-verify.\n'
	exit 1
fi

# --- keep the Help registry honest (scripts/help_audit.pl) ---
if [ -f scripts/help_audit.pl ] && [ -f help.pl ]; then
	out=$("$PERL" scripts/help_audit.pl --quiet 2>&1)
	status=$?
	printf '%s\n' "$out"
	if [ "$status" -ne 0 ]; then
		printf '\nhelp_audit: the Help registry has errors (above). Fix them, or push with --no-verify.\n'
		exit 1
	fi
fi

# --- the regression suite must pass (t/) ---
# Git exports GIT_DIR (and friends) to this hook. The suite builds throwaway git
# repos of its own; with those inherited, a `git -C <temp>` still acts on this
# checkout, which is how a fixture test once moved the live refs. Clear the git
# environment for the suite only - the guard above already used it.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR
# scripts/agent_land.pl already ran the suite at its own job cap before it pushed,
# and it holds the landing lock while it does, so no other agent is changing the
# tree. Running it again here doubles every landing - and at this hook's default
# parallelism the timing tests flake on a busy box, which fails a landing that
# already passed. The lander sets the flag; a hand push never does.
if [ "${JAWNOS_SUITE_ALREADY_RUN:-0}" = 1 ]; then
	printf 'pre-push: the lander already ran the suite; not running it twice.\n' >&2
elif [ -d t ] && command -v prove >/dev/null 2>&1; then
	if [ -f scripts/run_tests.pl ]; then
		out=$("$PERL" scripts/run_tests.pl 2>&1)
	else
		# a tree older than the forking runner
		out=$("$PERL" -S prove -l t 2>&1)
	fi
	status=$?
	if [ "$status" -ne 0 ]; then
		printf '%s\n' "$out"
		printf '\ntests: the regression suite failed (above). Fix it, or push with --no-verify.\n'
		exit 1
	fi
fi
exit 0
