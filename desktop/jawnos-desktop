#!/usr/bin/env python3
"""jawnos-desktop -- the JawnOS dashboard window."""
import os
import sys

_here = os.path.dirname(os.path.realpath(__file__))
if _here not in sys.path:
    sys.path.insert(0, _here)

from jawnos_desktop import core  # noqa: E402

# Follow the repo's desktop/ tree: when it has changed since this copy was
# installed, refresh the copy and restart on the new code (the desktop's own
# update, the way the app updates from its staged APK).
try:
    if core.sync_self(core.load_settings()):
        os.environ["JAWNOS_SELFUPDATED"] = "1"
        os.execv(sys.executable, [sys.executable, os.path.realpath(__file__)] + sys.argv[1:])
except OSError:
    pass

from jawnos_desktop.ui import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
