#!/usr/bin/env python3
"""jawnos-desktop -- the JawnOS desktop window.

The shell is Qt WebEngine (Chromium), which has WebRTC. PySide6 with its
QtWebEngine bindings is required; there is no GTK/WebKitGTK fallback any more.

    ./jawnos-desktop                  # Qt WebEngine
    ./jawnos-desktop --engine auto    # the same thing (auto means Qt)
    ./jawnos-desktop --engine qt      # and the explicit spelling
"""
import os
import sys

_here = os.path.dirname(os.path.realpath(__file__))
if _here not in sys.path:
    sys.path.insert(0, _here)

ENGINES = ("auto", "qt")

_QT_HINT = (
    "jawnos-desktop: PySide6 with Qt WebEngine is required and could not be "
    "imported.\n"
    "  Arch:   sudo pacman -S pyside6 qt6-webengine qt6-wayland\n"
    "  Debian: sudo apt install python3-pyside6.qtwebenginewidgets\n"
    "  Fedora: sudo dnf install python3-pyside6 qt6-qtwebengine qt6-qtwayland\n")


def _qt_available():
    """True when PySide6 and its QtWebEngine bindings actually import.

    find_spec() is too optimistic: the PySide6 module file can be present while
    the matching Qt WebEngine library is not installed (Arch splits the binding
    from qt6-webengine). Importing is safe without a display -- no QApplication
    is created here -- and it is the same probe the dependency checker uses.
    """
    try:
        import PySide6.QtWebEngineWidgets  # noqa: F401
        return True
    except Exception:
        return False


def _engine(argv):
    """The requested shell engine, and argv with --engine removed."""
    engine = (os.environ.get("JAWNOS_DESKTOP_ENGINE") or "").strip().lower()
    args = list(argv)
    if "--engine" in args:
        index = args.index("--engine")
        try:
            engine = args[index + 1].strip().lower()
            del args[index:index + 2]
        except IndexError:
            del args[index:index + 1]
    return engine, args


def choose_engine(requested):
    """Resolve the engine name; Qt WebEngine is the only engine."""
    name = (requested or "auto").strip().lower()
    if name in ("", "auto", "default", "qt"):
        return "qt"
    if name == "webkit":
        raise ValueError(
            "the WebKitGTK engine has been removed; Qt WebEngine is the only "
            "engine")
    raise ValueError("unknown engine %r (use qt or auto)" % requested)


def main(argv=None):
    requested, args = _engine(sys.argv[1:] if argv is None else argv)
    try:
        choose_engine(requested)
    except ValueError as exc:
        sys.stderr.write("jawnos-desktop: %s\n" % exc)
        return 2
    if not _qt_available():
        sys.stderr.write(_QT_HINT)
        return 2
    try:
        from jawnos_desktop.qt_shell import main as qt_main  # noqa: E402
    except Exception as exc:  # noqa: BLE001
        sys.stderr.write("jawnos-desktop: could not start Qt WebEngine: %s\n" % exc)
        return 2
    return qt_main(args)


if __name__ == "__main__":
    sys.exit(main())
