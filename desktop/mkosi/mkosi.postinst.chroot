#!/bin/sh
# Install the Perl modules the app needs, inside the image, so the first boot
# can seed config.json and the database without a network round trip. The
# distribution packages (compiler, cpanminus, the command line tools) come from
# mkosi.conf; this only covers the CPAN side.
#
# A failure here leaves an image that boots but cannot start JawnOS, so it fails
# the build instead of hiding the problem in a log.
set -eu

export PERL_MM_USE_DEFAULT=1
# The image build shares a memory-constrained host with the running manager.
# Cap the compilers so a CPAN module cannot take the machine (and the build)
# down with it; the previous unlimited build was killed by earlyoom.
export MAKEFLAGS=${MAKEFLAGS:--j2}
export PERL_CPANM_OPT='--notest --jobs 2'

# Arch installs cpanm as /usr/bin/vendor_perl/cpanm; the post-install sandbox
# has a bare PATH, so a plain `cpanm` is "command not found" and every module
# would appear missing. Put the vendor Perl bin directory back on the path.
export PATH="/usr/bin/vendor_perl:$PATH"

cd /opt/jawnos/tree
perl scripts/jawnos_deps.pl --install --no-extras

# Rebuild the initramfs now that the image's own files are in place. The kernel
# package's pacman hook built it during the package transaction, before mkosi
# copied mkosi.extra, so that initrd still has the stock hooks and shows the
# kernel's initialization list. This run picks up /etc/mkinitcpio.conf's
# plymouth hook and the JawnOS theme, so the mark appears before the root
# filesystem is mounted. mkosi then builds the UKI from this image.
mkinitcpio -P

# cpanm keeps its tarballs and work directories under /root. Nothing at runtime
# reads them, and the cache was ~200 MB in every image - a large slice of the
# download and of the 5G root partition. Remove it after the modules are built.
rm -rf /root/.cpanm /root/.cache 2>/dev/null || true
