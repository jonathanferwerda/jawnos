#!/bin/sh
# Copy the running live system onto a disk and carry the house with it.
#
#   jawnos-install              show the plan, change nothing
#   jawnos-install --yes /dev/sdX
#
# The image is copied byte for byte, so the ESP, systemd-boot and the kernel
# travel with it; the partitions are then grown to fill the disk; and the live
# session's /home/jawn is copied onto the new jawnos-state partition. That last
# step is what keeps the changes made while trying the live USB.
set -eu

CONFIRM=no
NEW_SIG=no
TARGET=
for arg in "$@"; do
    case "$arg" in
        --yes) CONFIRM=yes ;;
        --new-signatorial) NEW_SIG=yes ;;
        /dev/*) TARGET="$arg" ;;
        *) echo "unknown argument: $arg" >&2; exit 2 ;;
    esac
done

if [ -z "$TARGET" ]; then
    echo "usage: jawnos-install [--yes] [--new-signatorial] /dev/sdX" >&2
    exit 2
fi
if [ ! -b "$TARGET" ]; then
    echo "not a block device: $TARGET" >&2
    exit 2
fi

# Never write over the stick this system is running from.
ROOTPART=$(blkid -L jawnos-root || true)
if [ -z "$ROOTPART" ]; then
    echo "cannot find the live root (label jawnos-root)" >&2
    exit 1
fi
LIVEDISK=$(lsblk -no PKNAME "$ROOTPART" | head -n 1)
if [ -n "$LIVEDISK" ] && [ "/dev/$LIVEDISK" = "$TARGET" ]; then
    echo "refusing to install over the live media ($TARGET)" >&2
    exit 1
fi

echo "live system: $ROOTPART on /dev/$LIVEDISK"
echo "target:      $TARGET"
echo "this erases $TARGET, then copies the live system and its house onto it"

if [ "$CONFIRM" != yes ]; then
    echo "dry run: nothing was written. Re-run with --yes to proceed." >&2
    exit 0
fi

echo "copying the image..."
dd if="/dev/$LIVEDISK" of="$TARGET" bs=16M status=progress conv=fsync

echo "growing the partitions..."
systemd-repart --dry-run=no --definitions=/usr/lib/jawnos/repart --size=auto "$TARGET"
udevadm settle

STATE=
for p in "$TARGET"?*; do
    [ -b "$p" ] || continue
    if [ "$(blkid -s LABEL -o value "$p" 2>/dev/null || true)" = jawnos-state ]; then
        STATE="$p"
    fi
done
if [ -z "$STATE" ]; then
    echo "the new disk has no jawnos-state partition" >&2
    exit 1
fi

echo "carrying the house onto $STATE..."
mkdir -p /mnt/jawnos-state
mount "$STATE" /mnt/jawnos-state
rsync -a --delete /home/jawn/ /mnt/jawnos-state/

# A live image's config opens its own desktop without the gate (the "live"
# flag). The installed machine is not the demo, so drop it and get the gate
# back. A kept signatorial keeps the live session's cookie valid; a newly
# minted one starts clean and the first login is the Gate or a pairing.
if [ -f /mnt/jawnos-state/jawnos/config.json ]; then
    perl -MJSON::PP -0777 -i -pe '
        my $j = eval { decode_json($_) };
        if (ref $j eq "HASH") { delete $j->{live}; $_ = JSON::PP->new->canonical->pretty->encode($j); }
    ' /mnt/jawnos-state/jawnos/config.json
fi

if [ "$NEW_SIG" = yes ]; then
    NEW=$(openssl rand -hex 32)
    printf '%s\n' "$NEW" > /mnt/jawnos-state/.jawnos_signatorial
    ID=$(printf '%s' "$NEW" | md5sum | cut -d' ' -f1)
    mkdir -p /mnt/jawnos-state/jawnos/database
    printf '%s\n' "$ID" > /mnt/jawnos-state/.jawnos_signatorial_id
    printf '%s\n' "$ID" > /mnt/jawnos-state/jawnos/database/.jawnos_signatorial_id
    chmod 600 /mnt/jawnos-state/.jawnos_signatorial \
        /mnt/jawnos-state/.jawnos_signatorial_id \
        /mnt/jawnos-state/jawnos/database/.jawnos_signatorial_id 2>/dev/null || true
    chown jawn:jawn /mnt/jawnos-state/.jawnos_signatorial \
        /mnt/jawnos-state/.jawnos_signatorial_id \
        /mnt/jawnos-state/jawnos/database/.jawnos_signatorial_id 2>/dev/null || true
    echo "minted a new signatorial for the installed machine"
else
    echo "carried the live install's signatorial"
fi

umount /mnt/jawnos-state

# An NVRAM entry for the new disk. A machine that ignores it can still pick the
# disk from its own boot menu, so a failure here is not fatal.
efibootmgr -c -d "$TARGET" -p 1 -L "JawnOS" -l '\EFI\systemd\systemd-bootx64.efi' >/dev/null 2>&1 || true

echo "done. Remove the live media and boot $TARGET."
