# Seed the house once: copy the image's read-only tree and home skeleton onto
# the state partition, then build a database from the image's defaults. The
# condition is the completion marker rather than the checkout, so a first boot
# that copied the tree but failed to seed is retried instead of skipped.
[Unit]
Description=JawnOS first boot - seed the house
Requires=home-jawn.service
After=home-jawn.service
Before=getty@tty1.service
ConditionPathExists=!/home/jawn/.seeded

[Service]
Type=oneshot
ExecStart=/usr/local/bin/jawnos-firstboot
RemainAfterExit=yes
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
