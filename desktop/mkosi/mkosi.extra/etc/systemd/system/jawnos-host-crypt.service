# Before anything on the host is read, ask on the splash whether the person
# wants their drives used at all: a yes makes their files available in Gallery,
# Music, Folders, the IDE and the archive. Only a yes goes on to unlock the LUKS
# volumes and to let jawnos-host-drives mount anything.
#
# The script never writes the passphrase anywhere, always exits 0, and skips a
# device it cannot open, so a locked or unavailable volume cannot fail the boot.
[Unit]
Description=Offer the host computer's drives (consent + unlock)
Requires=home-jawn.service
After=home-jawn.service systemd-udevd.service
Before=jawnos-host-drives.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=240
ExecStart=/usr/local/bin/jawnos-host-crypt
ExecStop=/usr/local/bin/jawnos-host-crypt --close

[Install]
WantedBy=multi-user.target
