# The house sits on its own partition, so the root can be replaced (an update,
# a reinstall) without touching anything a person made. `nofail` keeps a machine
# usable when the partition is missing or damaged; the first-boot unit notices
# and seeds a fresh one.
[Unit]
Description=JawnOS house state
Before=local-fs.target

[Mount]
What=/dev/disk/by-label/jawnos-state
Where=/home/jawn
Type=ext4
Options=defaults,nofail,x-systemd.device-timeout=10s

[Install]
WantedBy=local-fs.target
