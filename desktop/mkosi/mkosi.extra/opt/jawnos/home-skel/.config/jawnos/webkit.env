# The live image runs on whatever graphics the virtual machine or stick gives
# it. WebKit's DMABUF renderer can render a blank white view on virtio-gpu (and
# some simple framebuffers); forcing it onto shared memory was the only switch
# in the seven-case QEMU matrix that produced a rendered frame on virtio-vga.
# The full three-switch software set (disable compositing + disable DMABUF +
# Skia CPU) blanked or duplicated after a mode change.
#
# This is the app's documented escape hatch (desktop/README.md) and the
# environment always wins over it. JAWNOS_GPU=1 (environment or this file) drops
# this workaround as well as the Skylake/X11 fallback, so a real GPU machine can
# opt back into the plain accelerated path.
WEBKIT_DMABUF_RENDERER_FORCE_SHM=1
