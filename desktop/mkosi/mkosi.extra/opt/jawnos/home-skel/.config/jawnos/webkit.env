# The live image runs on whatever graphics the virtual machine or stick gives
# it. WebKit's GPU paths (DMABUF and compositing) render a blank white view on
# virtio-gpu and some simple framebuffers, so the session starts on the software
# path. Video still decodes through GStreamer; only compositing is software.
# This file is the app's documented escape hatch (desktop/README.md) and the
# environment always wins over it, so a real GPU machine can opt back in with
# JAWNOS_GPU=1.
WEBKIT_DISABLE_COMPOSITING_MODE=1
WEBKIT_DISABLE_DMABUF_RENDERER=1
WEBKIT_SKIA_ENABLE_CPU_RENDERING=1
