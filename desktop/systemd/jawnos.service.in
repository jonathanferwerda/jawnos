[Unit]
Description=JawnOS server (jawn)
Documentation=https://github.com/jonathanferwerda/jawnos
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The database, its WAL, the backups and the logs are house data; nothing the
# tree creates should land group- or world-readable.
UMask=0077
WorkingDirectory=@JAWN_DIR@
ExecStart=@PERL@ ./jawn
Restart=on-failure
RestartSec=5

# jawn writes its own ~/manager.log; keep the service log separate.
StandardOutput=append:%h/.local/state/jawnos/jawn-stdout.log
StandardError=append:%h/.local/state/jawnos/jawn-stdout.log

[Install]
WantedBy=default.target
