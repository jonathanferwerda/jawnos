[Unit]
Description=JawnOS TLS certificate (Let's Encrypt via DNS-01)
Documentation=https://github.com/jonathanferwerda/jawnos
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# No root: certbot keeps its account, certs and logs under ~/.jawnos_tls, and
# the copy into server/ belongs to the same user that runs the house.
User=@JAWN_USER@
Group=@JAWN_GROUP@
UMask=0077
WorkingDirectory=@JAWN_DIR@
ExecStart=@PERL@ scripts/tls_issue.pl --renew
# A renewal that fails must not spam a restart loop; the timer tries again
# tomorrow, and the last error is left in ~/.president/tls_status.json for the
# DNS panel to show.
TimeoutStartSec=600
