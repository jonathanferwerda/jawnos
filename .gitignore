# --- Firmware build artifacts (Arduino / PlatformIO / ESP32 / RP2040) ---
build/
.pio/
*.ino.cpp
*.ino.elf
*.ino.map
*.ino.bin
*.ino.uf2
*.esp32s3.*.bin
*.esp32.*.bin
*.rp2040.*.bin

# --- Secrets & personal configuration ---
.secrets/
config.json
signatorials/
server/privkey.pem
server/fullchain.pem
*.pem
*.key
# Docker Compose environment: .env.example is tracked, a filled .env is not
# (it may carry JAWNOS_UNLOCK_CODE).
.env

# --- Logs ---
*.log

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp
*~

# --- Built app releases (APKs). Replicated across devices as blobs, never ---
# --- committed: a ~35 MB binary per version would bloat git history forever. ---
releases/

# --- Windows build output (build-portable.ps1, the release workflow). ---
# --- The Setup.exe is a build artifact; release copies live in releases/. ---
dist/

# --- Speech voices (Piper models + the piper binary). Same deal as releases/: ---
# --- multi-MB blobs carried across devices, never committed. ---
voices/

# --- Python tooling (font + face preview generator) ---
__pycache__/
*.pyc

# --- Agent test harnesses (see .shots/README.md) ---
.shots/

# --- Agent field notes: the map is tracked, the deep notes stay on disk ---
docs/AGENTS-notes.md

# --- The machine's one live database and its backups: install-local, never ---
# --- committed. database/initial.enc (the seed) and schema.sql ARE tracked; ---
# --- the working database/initial.db and database/backups/ are not. ---
database/*.db
database/*.db-shm
database/*.db-wal
database/backups/
# the hidden thumbnail caches beside the database (phone avatars, and the
# icon-set PNGs the native home requests): generated locally, never shared
database/.thumbs/
database/.icons/
# the machine's own signatorial, mirrored beside the database so a restored
# database (or a run with the wrong HOME) cannot change this machine's identity
database/.jawnos_signatorial_id

# --- The SCO gateway helper: built per machine by scripts/build_sco.pl ---
# --- (it links the local BlueZ), so the source is tracked and the binary is not. ---
perl/sco/sco_helper

# Agent worktrees: one per task, never tracked (docs/AGENTS-concurrency.md).
/.worktrees/

# --- Runtime sockets and watch files (workers hand each other live pushes) ---
/run/

# --- Packaging: fetched CPAN dists, .deb output and makepkg scratch -------------
/vendor/
/packaging/out/
/packaging/aur/pkg/
/packaging/aur/src/
/packaging/aur/*.pkg.tar.*
/packaging/aur/.SRCINFO
