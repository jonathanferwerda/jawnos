# --- Firmware build artifacts (Arduino / PlatformIO / ESP32 / RP2040) ---
build/
.pio/
*.ino.cpp
*.ino.elf
*.ino.map
*.ino.bin
*.ino.uf2
*.esp32s3.*.bin
*.esp32.*.bin
*.rp2040.*.bin

# --- Secrets & personal configuration ---
.secrets/
config.json
signatorials/
server/privkey.pem
server/fullchain.pem
*.pem
*.key

# --- Logs ---
*.log

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp
*~

# --- Built app releases (APKs). Replicated across devices as blobs, never ---
# --- committed: a ~35 MB binary per version would bloat git history forever. ---
releases/

# --- Speech voices (Piper models + the piper binary). Same deal as releases/: ---
# --- multi-MB blobs carried across devices, never committed. ---
voices/

# --- Python tooling (font + face preview generator) ---
__pycache__/
*.pyc

# --- Agent test harnesses (see .shots/README.md) ---
.shots/

# --- Agent field notes: kept on disk, never committed ---
AGENTS.md
docs/AGENTS-notes.md

# --- The machine's one live database and its backups: install-local, never ---
# --- committed. database/initial.enc (the seed) and schema.sql ARE tracked; ---
# --- the working database/initial.db and database/backups/ are not. ---
database/*.db
database/*.db-shm
database/*.db-wal
database/backups/
