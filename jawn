#!/usr/bin/perl

use strict;
use warnings;

# Somebody launching this (a desktop app, a systemd unit, an .desktop entry) never
# sources ~/.zshrc, so only the system @INC is present and the first 'use' below
# dies on 'Can't locate Mojo/...'. Find the same local::lib tree the shell would
# and export it too, so President.pl and every worker inherit it as well.
BEGIN {
	my $base = (($ENV{HOME} || (getpwuid $<)[7] || '') . '/perl5/lib/perl5');
	if ($base =~ m{/} && -d $base) {
		my @dirs = ($base);
		if (opendir(my $dh, $base)) {
			for my $name (sort readdir $dh) {
				my $dir = "$base/$name";
				push @dirs, $dir
					if $name ne '.' && $name ne '..' && -d $dir
					&& ($name =~ /-linux-/ || $name =~ /^[0-9]+\.[0-9]+/);
			}
			closedir $dh;
		}
		my %in_inc = map { $_ => 1 } @INC;
		unshift @INC, grep { !$in_inc{$_} } @dirs;
		my $lib = join ':', @dirs;
		$ENV{PERL5LIB} = $ENV{PERL5LIB} ? "$lib:$ENV{PERL5LIB}" : $lib;
	}
}

use Mojo::IOLoop::ReadWriteFork;
use IO::Socket::UNIX;
use IO::Select;
use Fcntl qw/F_SETFD FD_CLOEXEC/;
use File::Slurp;
use Mojo::File 'path';
use Mojo::Log;
use Mojo::JSON qw/decode_json encode_json/;
use Data::Dumper;
use Sereal::Encoder qw(encode_sereal SRL_SNAPPY SRL_ZSTD);
use Sereal::Decoder qw(decode_sereal);
use feature 'current_sub';
my $encoder = Sereal::Encoder->new({ compress => SRL_ZSTD, compress_level => 3 });
my $decoder = Sereal::Decoder->new();
no warnings 'uninitialized';

# One master per machine: the watch socket is the machine's alone, so a launch
# that finds a master *answering* on it is a second jawn. A bare connect() is no
# proof of life - children inherit the listening fd, so survivors of a dead
# master still accept into the kernel backlog - therefore the framed query
# below, and only a reply counts. It stands down here - before the
# ~/.president wipe below, which must not eat the serving master's state, and
# before a single President.pl is started. Two masters otherwise fight over the
# ports and the socket, kill each other's trees, and cycle forever.
my $watch_path = &home('~/.process_watch');
if (-S $watch_path) {
	my $watch_live = 0;
	eval {
		my $probe = IO::Socket::UNIX->new(Peer => $watch_path);
		if ($probe) {
			$probe->autoflush(1);
			my $blob = $encoder->encode({ query => 'subprocesses' });
			my $packet = pack('N', length($blob)) . $blob;
			$probe->syswrite($packet);
			if (IO::Select->new($probe)->can_read(3)) {
				my $header = '';
				$watch_live = 1 if sysread($probe, $header, 4);
			}
		}
	};
	if ($watch_live) {
		print "\nAnother jawn is already running; this one is standing down.\n\n";
		exit 0;
	}
}

my $dump_dir = &home('~/.president');
`rm -R $dump_dir/*` if -e $dump_dir;
`mkdir $dump_dir` unless -e $dump_dir;
my $subprocesses = {};
our $logfile = &home('~/manager.log');

`touch $logfile` if not -e $logfile;
our $log = Mojo::Log->new(path => $logfile);

# Tee the tree's console into ~/pty.log: everything President.pl and its workers
# print or warn about passes through this pty, and the error watch reads the file
# for faults to fix. Truncated here, at the master's start, so each boot begins
# clean; it lives outside ~/.president, which is wiped below.
our $pty_log_fh;
{
	my $pty_log_path = &home('~/pty.log');
	if (open(my $fh, '>', $pty_log_path)) {
		$pty_log_fh = $fh;
		$pty_log_fh->autoflush(1);
	}
}
my $tmp_dir = '/tmp';
unless ( -d $tmp_dir ) {
	$tmp_dir = &home('~/.president/');
}
`mkdir $tmp_dir/ws` unless -e $tmp_dir . '/ws';

if (-l $0) {
  print "The script was executed via a symbolic link!\n";
  my $path = readlink($0);
	print $path . "\n";
	my @dir = split '/', $path;
	pop @dir;
	$path = join '/', @dir;
	chdir($path);
}
$| = 1;

# ---- first run: install dependencies, then run the setup wizard -------------
&first_run_setup();

my $fork = Mojo::IOLoop::ReadWriteFork->new;

$SIG{INT} = sub {
	&shut_down();
	exit 0;
};

my ($master_boot_watch, $master_boot_tries);
$fork = &terminal_pty_runner({ 'program' => './President.pl' });
&arm_boot_watch();

my $status = 'off';

my @printless = (
	'Permission denied',
	'cannot open /proc/net',
	'Cannot bind netlink'
);


my ($master_timer,$master_timer_paused);
&master_time_looper();
sub master_time_looper() {
	$master_timer = Mojo::IOLoop->recurring(2 => sub {
		my ($loop, $timer_id) = @_;
		$master_timer = $timer_id;
		my $status_file = &home('~/.president/status');
		my $f_status = -e $status_file ? read_file($status_file) : '';
		if ($status eq 'frozen' || $f_status eq 'restart') {
		  Mojo::IOLoop->remove($master_timer);
		  return if $master_timer_paused == 1;
			$master_timer_paused = 1;
			# A requested restart on a live tree is verified first: a change that does
			# not parse would only come back broken (or blank, like the /manager page a
			# truncated manager.js once blanked), so refuse it, keep the running tree
			# serving and say so. The failure is printed into the pty, where the error
			# watch reads it and offers a fix. A frozen tree is already down, so it is
			# restarted regardless - there is nothing serving to protect.
			if ($f_status eq 'restart' && $status ne 'frozen') {
				my $proof = &tree_verify();
				unless ($proof->{'ok'}) {
					write_file($status_file, 'good');
					print "restart refused - the tree is still serving; the code does not verify:\n" . $proof->{'report'} . "\n";
					$master_timer_paused = 0;
					&master_time_looper();
					return;
				}
			}
			# the request is ours now: left standing, the next two-second tick reads
			# it again, kills the fresh boot before it writes "good", and restarts
			# forever
			write_file($status_file, 'good') if $f_status eq 'restart';
			&shut_down();
			$status = 'dead';
		}
		if ($status eq 'dead') {

			$status = 'restarting';
			print "restarting president in 3";
			sleep 1;
			print "... 2";
			sleep 1;
			print "... 1";
			sleep 1;
			$fork = undef;

			$fork = &terminal_pty_runner({ 'program' => './President.pl' });
			# the paused flag only guards this restart sequence; clear it or the next
			# restart trigger takes the early return above and the master loop stays
			# dead until ./jawn is run by hand
			$master_timer_paused = 0;
		  &master_time_looper();
			&arm_boot_watch();
		}
	});
}


# Verify the tree before a restart loads it. scripts/verify_change.pl checks that
# every Perl file compiles, every JavaScript file parses and every template
# compiles, across the whole tree. It runs here, once, while the old tree is
# still serving, so it adds nothing to the interruption; the restart only goes
# ahead when it passes. Returns { ok => 1 } when it passes (or when the script is
# not present yet), else the tail of its report to print.
sub tree_verify() {
	return { ok => 1 } unless -f 'scripts/verify_change.pl';
	my $out = `perl scripts/verify_change.pl --all --quiet 2>&1`;
	my $code = $? >> 8;
	$out = '' unless defined $out;
	return { ok => 1 } if $code == 0;
	$out =~ s/\s+$//;
	return { ok => 0, report => substr($out, 0, 2000) };
}


# A config.json is usable once it exists and names a signatorial (the file the
# cookie signing key is derived from). read_file has to be evaluated in scalar
# context -- otherwise it returns a list of lines and we only ever decode the
# first one.
sub config_is_usable() {
	return 0 unless -e './config.json';
	my $json = read_file('./config.json');
	my $config = eval { decode_json $json };
	return ( ref $config eq 'HASH' && $config->{'signatorial'} ) ? 1 : 0;
}

# First-run experience: install dependencies (terminal) and then run the web
# setup wizard for config.json + the encrypted database. Returns once a usable
# config.json exists, or exits if setup was abandoned.
sub first_run_setup() {
	my $force = grep { $_ eq '--setup' } @ARGV;
	my $config_ok = config_is_usable();
	return if $config_ok && !$force;

	print "\n";
	if ($force && $config_ok) {
		print "Re-running JawnOS setup at your request.\n\n";
	}
	else {
		print "Looks like this is a first run. Let's get you set up.\n\n";
	}

	# 1. dependencies (core-perl checker; works before anything is installed)
	system( 'perl', 'scripts/jawnos_deps.pl' ) if -e 'scripts/jawnos_deps.pl';

	# 2. web wizard for config.json and the database
	system( 'perl', 'scripts/jawnos_setup.pl' ) if -e 'scripts/jawnos_setup.pl';

	unless ( config_is_usable() ) {
		print "\nSetup was not completed. Re-run ./jawn to try again.\n";
		exit 1;
	}
	print "\nSetup complete. Starting JawnOS...\n\n";
}

my $process_watch;
my $process_watch_file = &home('~/.process_watch');
my %buffers;

$process_watch = &process_watch();
Mojo::IOLoop->recurring(2 => sub {

	my $is_running = $process_watch && defined Mojo::IOLoop->acceptor($process_watch) ? 1 : 0;
	if (!$is_running) {
		Mojo::IOLoop->remove($process_watch) if $process_watch;
		$process_watch = &process_watch();
	}
	else {

	}

});

sub shut_down() {
	print "pres Ctrl+C! Closing...\n";
	# this tear-down is on purpose, so the fork's own close must not be read as a
	# crash (see the close handler in terminal_pty_runner)
	$fork->{'jawn_deliberate'} = 1 if $fork;
	$fork->write("\x03");
	# The named sweep is the workhorse: it takes the tree by process name and full
	# command line, and whatever still holds the web port. (2026-10-14: this used to
	# be followed by pid-as-substring matches against `ps -e`, which once matched a
	# freshly-started President and killed the boot. Only exact, verified pids now.)
	# run it with this interpreter, not by its shebang: on Termux perl is not at
	# /usr/bin/perl, so './scripts/manager_killer.pl' fails to exec and the sweep
	# silently never runs (leftover processes keep the web port and wedge the
	# next boot). $^X is the interpreter running this master.
	`"$^X" ./scripts/manager_killer.pl`;
	# the pids the tree reported to the master, each by its exact number and only
	# when its command line still names a jawn program - never a substring match, so
	# a reused pid (or a new process whose number merely contains an old one) is
	# left alone
	my @tracked;
	foreach my $s ( keys %{$subprocesses} ) {
		next if $s =~ /[a-zA-Z]/;
		push @tracked, $s;
		my $kids = $subprocesses->{$s}->{'subprocesses'};
		push @tracked, keys %{$kids} if eval { keys %{$kids} };
	}
	my %seen;
	@tracked = grep { /^[0-9]+$/ && !$seen{$_}++ } @tracked;
	my @sent;
	foreach my $pid ( grep { &pid_alive($_) && &pid_is_jawn($_) } @tracked ) {
		kill 'INT', $pid;
		push @sent, $pid;
		print "INT $pid\n";
	}
	# our own pty child (bash) ends the terminal; it is our direct child, so its
	# exact pid is safe even though its command line is not a jawn program
	my $fpid = $fork ? $fork->pid : 0;
	if ($fpid && &pid_alive($fpid) && $fpid != $$) {
		kill 'INT', $fpid;
		push @sent, $fpid;
		print "INT $fpid (pty)\n";
	}
	$fork->close if $fork;
	# a short grace for the tree to run its own cleanup, then SIGKILL what is left
	my @alive;
	for (1 .. 10) {
		@alive = grep { &pid_alive($_) } @sent;
		last unless @alive;
		select(undef, undef, undef, 0.1);
	}
	foreach my $pid (@alive) {
		my $ours = ($pid == $fpid) ? 1 : &pid_is_jawn($pid);
		next unless $ours;
		kill 'KILL', $pid;
		print "KILL $pid\n";
	}
	$subprocesses = {};
	sleep .1;
}

# A pid is only signalled when it is still there (kill 0) and, for anything but
# our own pty child, its command line still names a jawn program - so a pid the OS
# handed to an unrelated process in the meantime is never touched.
sub pid_alive {
	my ($pid) = @_;
	return 0 unless $pid && $pid =~ /^[0-9]+$/;
	return kill(0, $pid) ? 1 : 0;
}

sub pid_cmdline {
	my ($pid) = @_;
	return '' unless $pid && $pid =~ /^[0-9]+$/;
	if (open(my $fh, '<', "/proc/$pid/cmdline")) {
		local $/;
		my $line = <$fh>;
		close $fh;
		$line = '' unless defined $line;
		$line =~ s/\0/ /g;
		return $line;
	}
	my $ps = `ps -o args= -p $pid 2>/dev/null`;
	$ps = '' unless defined $ps;
	$ps =~ s/\s+$//;
	return $ps;
}

sub pid_is_jawn {
	my ($pid) = @_;
	return &pid_cmdline($pid) =~ /President\.pl|Manager\.pl|Websocket\.pl|teletype\.pl|watch\.pl|jawn-bt|Music\.pl|Alarm\.pl/ ? 1 : 0;
}

# Bring the tree up (or not): after a (re)start the master checks that the web
# port answers, and if it does not within the window it restarts once more, up to
# a few tries - so a boot that lost a race with another tear-down still recovers.
sub config_port {
	my $file = -e './config.json' ? './config.json' : '';
	return 0 unless $file;
	my $cfg = eval { return decode_json scalar read_file($file) };
	my $port = eval { $cfg->{'port'} } || 0;
	return ($port =~ /^[0-9]+$/) ? $port : 0;
}

sub tree_serving {
	my $port = &config_port();
	return 0 unless $port;
	require IO::Socket::INET;
	my $ok = eval {
		my $sock = IO::Socket::INET->new(PeerAddr => '127.0.0.1', PeerPort => $port, Timeout => 2);
		$sock ? (close($sock), 1) : 0;
	};
	return $ok ? 1 : 0;
}

sub arm_boot_watch {
	return unless &config_port();
	Mojo::IOLoop->remove($master_boot_watch) if $master_boot_watch;
	my $deadline = time + 90;
	$master_boot_watch = Mojo::IOLoop->recurring(3 => sub {
		my ($loop, $id) = @_;
		if (&tree_serving()) {
			print "tree is back up\n";
			Mojo::IOLoop->remove($id);
			$master_boot_watch = undef;
			$master_boot_tries = 0;
			return;
		}
		return if time < $deadline;
		Mojo::IOLoop->remove($id);
		$master_boot_watch = undef;
		$master_boot_tries = ($master_boot_tries || 0) + 1;
		if ($master_boot_tries <= 3) {
			print "the tree did not come up in 90s; restarting it (attempt $master_boot_tries)\n";
			$status = 'frozen';
		}
		else {
			print "the tree did not come up after $master_boot_tries attempts; leaving it for a person\n";
			$master_boot_tries = 0;
		}
	});
}

sub process_watch() {
	eval {

		my $server = Mojo::IOLoop->server({ path => $process_watch_file } => sub {
			my ($loop,$stream,$id) = @_;
			$stream->handle->autoflush(1);
			$stream->high_water_mark(8 * 1024 * 1024);

			$buffers{$id} = '';
			$stream->on(read => sub () {

				my ($stream, $bytes) = @_;

				$buffers{$id} .= $bytes;

				while (1) {
					last if length($buffers{$id}) < 4;

	        my $payload_length = unpack('N', substr($buffers{$id}, 0, 4));

	        # If we don't have the full payload yet, wait for next event loop tick
	        last if length($buffers{$id}) < (4 + $payload_length);

	        # Extract header and data cleanly using 4-argument substr for speed
	        substr($buffers{$id}, 0, 4, '');
	        my $sereal_blob = substr($buffers{$id}, 0, $payload_length, '');

					my $process = eval { $decoder->decode($sereal_blob) };
					if ($@) {
						warn "Worker $$: Failed to parse Sereal: $@";
						next;
					}

					if ($process->{'query'}) {
						my $q = $process->{'query'};
						my $data = {};
						if ($q eq 'subprocesses') {
							$data = $subprocesses;
						}
						eval {

							$subprocesses->{'status'} = 'report';
							my $jwsm = $encoder->encode($data);
							my $payload_length = length($jwsm);
							my $packet = pack('N', $payload_length) . $jwsm;


							$stream->write($packet);
						};
						if ($@) { warn "Worker $$: Failed to send 'stop' state: $@" }
					}
					elsif ($process->{'status'} eq 'report') {
						$log->info('i see the report');
					}
					else {
						$subprocesses->{$process->{'parent'}}->{'subprocesses'}->{$process->{'pid'}} = $process;

						if ($process->{'status'} eq 'stop') {
							delete $subprocesses->{$process->{'parent'}}->{'subprocesses'}->{$process->{'pid'}};
						}

						# Ordinary updates get no reply. A bare uuid write here used to pile up
						# unread in the worker's socket and desync the next length-prefixed
						# query reply (which is why the system settings page only sometimes
						# loaded). Only queries are answered, always length-prefixed.
					}





				}
			});
			$stream->on(close => sub {
				delete $buffers{$id};
			});
		});
		# Mojo keeps listener fds open across exec on purpose ($^F = 1023), so
		# every child inherits this socket; a survivor then keeps it accepting
		# into the kernel backlog long after the master is gone, which is what
		# fooled the guard at the top of this script. This fd is the master's.
		# (server() hands back an id; the acceptor holds the socket.)
		my $acceptor = $server ? Mojo::IOLoop->acceptor($server) : undef;
		my $handle = $acceptor ? $acceptor->handle : undef;
		fcntl($handle, F_SETFD, FD_CLOEXEC) if $handle;
		return $server;
	}
}
Mojo::IOLoop->start unless Mojo::IOLoop->is_running;

sub terminal_pty_runner() {
	return $fork if $status eq 'starting';
	$status = 'starting';
	my $data = shift;
	if (!$fork) {
		$fork = Mojo::IOLoop::ReadWriteFork->new;
	}
	print 'starting fork' . "\n";

	$fork->conduit({raw => 1, type => "pty"});

  $fork->on(read => sub () {
		my ($fork, $bytes) = @_;

		if ($bytes =~ /Address already in use/) {
			print "already in use!!!! AAAAAAAAAH!\n";
			$status = 'frozen';
		}
		elsif ($bytes =~ /they dead/ || $bytes =~ /President Died/ || $bytes =~ /core dumped/) {
			print "See it's dead\n";
			$status = 'frozen';
		}
		elsif ($bytes =~ /Broken Pipe/) {

		}
		unless (grep { $bytes =~ /\Q$_\E/ } @printless) {
			print $bytes;
		}
		# the error watch's copy (an unprintable diagnostic still belongs in it)
		if ($pty_log_fh) {
			print {$pty_log_fh} $bytes;
		}
  });

	my $this_fork = $fork;
  $fork->on(close => sub () {
		my ($exit_value, $signal) = @_;
		print "closing fork";
		# the tree's own terminal exited: unless the master tore it down for a
		# restart (shut_down marks the fork), it died on its own - recover it rather
		# than leave the tree down
		unless ($this_fork->{'jawn_deliberate'}) {
			print "tree exited on its own (exit=$exit_value signal=$signal) - recovering\n";
			$status = 'frozen';
		}
  });

	$fork->on(drain => sub () {
		my ($fork,$drain) = @_;
		print "drain\n";
	});

	$fork->on(spawn => sub() {
		my ($fork) = @_;
		print "fork started " . $data->{'program'} . " k\n";
		if ($data->{'program'}) {
			print "Starting " . $data->{'program'} . "\n";
			Mojo::IOLoop->timer(0.1 => sub {
				$fork->write($data->{'program'} . "\n");
			});
		}
		$status = 'started';

	});

	$fork->start({
		program => "bash",
		program_args => [ "-i" ],
		env          => {
	    %ENV,
	    INPUTRC => '/dev/null',
	    PROMPT_COMMAND => '',
	    TERM => 'dumb'
		}
	});


	return $fork;
}

no warnings 'uninitialized';

# Resolve ~ once. The old version shelled out to `echo $HOME` on every call, and
# the master loop below calls this every couple of seconds -- thousands of forks.
my $home_dir;
sub home() {
	my ($inhabitant) = @_;
	unless (defined $home_dir) {
		$home_dir = $ENV{HOME};
		if (!defined $home_dir || $home_dir eq '') {
			$home_dir = (getpwuid($<))[7] || '';
		}
	}
	$inhabitant =~ s/~/$home_dir/;
	return $inhabitant;
}

1;
