sub shut_down() {
	print "pres Ctrl+C! Closing...\n";
	$fork->write("\x03");
	`./scripts/manager_killer.pl`;
	my $ps = `ps -e`;
	my @ps = split /\n/, $ps;
	foreach my $s ( keys %{$subprocesses} ) {
		if (eval { keys %{$subprocesses->{$s}->{'subprocesses'}} }) {
			foreach my $pid ( keys %{$subprocesses->{$s}->{'subprocesses'}} ) {
				if (grep { $_ =~ /\Q$pid/ } @ps) {
					kill 'INT', $pid;
					print "Manual Kill " . $pid . "\n";
					`kill -9 $pid`;
				}
			}
		}
		my $pid = $s;
		unless ($pid =~ /[a-zA-Z]/) {
			if (grep { $_ =~ /\Q$pid/ } @ps) {
				kill 'INT', $pid;
				print "Manual PKill " . $pid . "\n";
				`kill -9 $pid`;
			}
		}
	}
	$fork->close;
	my $pid = $fork->pid;
	if ($pid != 0) {
		if (grep { $_ =~ /\Q$pid/ } @ps) {
			kill 'INT', $fork->pid;
			print "Manual TKill " . $pid . "\n";
			`kill -9 $pid`;
		}
	}
	$subprocesses = {};
	@all_subprocesses;
	sleep .1;

}

sub process_watch() {
	eval {

		my $server = Mojo::IOLoop->server({ path => $process_watch_file } => sub {
			my ($loop,$stream,$id) = @_;
			$stream->handle->autoflush(1);
			$stream->high_water_mark(8 * 1024 * 1024);

			$buffers{$id} = '';
			$stream->on(read => sub () {

				my ($stream, $bytes) = @_;

				$buffers{$id} .= $bytes;

				while (1) {
					last if length($buffers{$id}) < 4;

	        my $payload_length = unpack('N', substr($buffers{$id}, 0, 4));

	        # If we don't have the full payload yet, wait for next event loop tick
	        last if length($buffers{$id}) < (4 + $payload_length);

	        # Extract header and data cleanly using 4-argument substr for speed
	        substr($buffers{$id}, 0, 4, '');
	        my $sereal_blob = substr($buffers{$id}, 0, $payload_length, '');

					my $process = eval { $decoder->decode($sereal_blob) };
					if ($@) {
						warn "Worker $$: Failed to parse Sereal: $@";
						next;
					}

					if ($process->{'query'}) {
						my $q = $process->{'query'};
						my $data = {};
						if ($q eq 'subprocesses') {
							$data = $subprocesses;
						}
						eval {

							$subprocesses->{'status'} = 'report';
							my $jwsm = $encoder->encode($data);
							my $payload_length = length($jwsm);
							my $packet = pack('N', $payload_length) . $jwsm;


							$stream->write($packet);
						};
						if ($@) { warn "Worker $$: Failed to send 'stop' state: $@" }
					}
					elsif ($process->{'status'} eq 'report') {
						$log->info('i see the report');
					}
					else {
					#	$subprocesses->{$process->{'pid'}} = $process;

						my $cpu_worker = $subprocesses->{$process->{'parent'}}->{'subprocesses'}->{$process->{'pid'}}->{'cpu_worker'} || [];

						$subprocesses->{$process->{'parent'}}->{'subprocesses'}->{$process->{'pid'}} = $process;

						my $cpu = $process->{'htop'};
						if (scalar @{$cpu_worker} > 0) {
							my $count = scalar @{$cpu_worker} - 1;
							foreach my $t ( qw/user system total/) {
								$cpu->{'c_' . $t} = $cpu->{$t} - $cpu_worker->[$count]->{$t};
								my $percentage = 0;
								if (defined $cpu_worker->[$count]->{'timestamp'} && defined $cpu->{'c_' . $t} && $cpu->{'c_' . $t} > 0) {
									eval {
										$percentage = sprintf("%.3f", $cpu->{'c_' . $t} / (($cpu->{'timestamp'} - $cpu_worker->[$count]->{'timestamp'}) / 1000) * 100);
									};
								}
								$cpu->{'p_' . $t} = $percentage;
							}
							splice @{$cpu_worker}, 2;

						}
						push @{$cpu_worker}, $cpu;
						$subprocesses->{$process->{'parent'}}->{'subprocesses'}->{$process->{'pid'}}->{'cpu_worker'} = $cpu_worker;
						$process->{'htop'} = $cpu;
						$subprocesses->{$process->{'parent'}}->{'subprocesses'}->{$process->{'pid'}} = $process;
				#		$log->info(Dumper $cpu);




						if ($process->{'status'} eq 'stop') {
							delete $subprocesses->{$process->{'parent'}}->{'subprocesses'}->{$process->{'pid'}};
						#	foreach my $k ( keys %{$subprocesses} ) {
						#		unless (scalar keys %{$subprocesses->{$k}->{'subprocesses'}}) {
						#			delete $subprocesses->{$k};
						#		}
						#	}
						}

						$stream->write($process->{'uuid'}) if defined $process->{'uuid'} && $process->{'uuid'};
					}





				}
			});
			$stream->on(close => sub {
				delete $buffers{$id};
			});
		});
		return $server;
	}
}
