# One master per machine: the watch socket is the machine's alone, so a launch
# that finds a master *answering* on it is a second jawn. A bare connect() is no
# proof of life - children inherit the listening fd, so survivors of a dead
# master still accept into the kernel backlog - therefore the framed query
# below, and only a reply counts. It stands down here - before the
# ~/.president wipe below, which must not eat the serving master's state, and
# before a single President.pl is started. Two masters otherwise fight over the
# ports and the socket, kill each other's trees, and cycle forever.
my $watch_path = &home('~/.process_watch');
if (-S $watch_path) {
	my $watch_live = 0;
	eval {
		my $probe = IO::Socket::UNIX->new(Peer => $watch_path);
		if ($probe) {
			$probe->autoflush(1);
			my $blob = $encoder->encode({ query => 'subprocesses' });
			my $packet = pack('N', length($blob)) . $blob;
			$probe->syswrite($packet);
			if (IO::Select->new($probe)->can_read(3)) {
				my $header = '';
				$watch_live = 1 if sysread($probe, $header, 4);
			}
		}
	};
	if ($watch_live) {
		print "\nAnother jawn is already running; this one is standing down.\n\n";
		exit 0;
	}
}

