my ($master_timer,$master_timer_paused);
my ($tree_ticks,$tree_misses) = (0,0);
my $reap_ticks = 0;
&master_time_looper();
sub master_time_looper() {
	# In this Mojo the recurring callback is handed the loop as its only argument
	# (Mojo::IOLoop::_timer runs `$self->$cb`), so no timer id is passed to the
	# callback at all. The old code took one anyway (`$master_timer = $timer_id`)
	# and therefore stored undef: every `Mojo::IOLoop->remove($master_timer)` below
	# was a silent no-op, so each restart left the previous ticker running and the
	# master multiplied its own restart logic - thousands of "tree is back up"
	# lines and 43k uninit-$id warnings in jawn-stdout.log - until a stray tick tore
	# down the tree it had just started and the master sat alive-but-idle forever
	# (2026-10-15). One ticker now, its id taken from the return value, never
	# removed: the state machine below is idempotent, and a permanent ticker is
	# also the liveness watchdog that recovers a tree which died unnoticed.
	return if $master_timer;
	# One-second tick: a restart request is noticed at once rather than up to five
	# seconds late. The liveness probe below keeps its own 30s cadence.
	$master_timer = Mojo::IOLoop->recurring(1 => sub {
		# the sleeps below block the loop, so a restart cannot re-enter; guard anyway
		# so a fatality mid-sequence cannot wedge the master permanently
		return if $master_timer_paused;
		my $status_file = &home('~/.president/status');
		my $f_status = -e $status_file ? read_file($status_file) : '';
		# Our own file changed on disk (a git update): reload the master, not just
		# the tree. Verify first: a half-written or broken ./jawn must not replace
		# the master that is still serving. A pending 'restart' is consumed here so
		# the fresh master does not immediately restart again.
		my $stamp = &master_stamp();
		if ($stamp ne '' && $stamp ne $master_stamp) {
			$master_stamp = $stamp;
			my $proof = &tree_verify();
			if ($proof->{'ok'}) {
				print "master changed on disk; reloading $master_path\n";
				write_file($status_file, 'good');
				$master_timer_paused = 1;
				&shut_down();
				exec($^X, $master_path, @ARGV) or do {
					print "re-exec of $master_path failed: $!\n";
					$master_timer_paused = 0;
					$status = 'frozen';
					return;
				};
			}
			else {
				print "master changed on disk but the tree does not verify; keeping the running master:\n" . ($proof->{'report'} || '') . "\n";
			}
		}
		# Liveness watchdog: 'started' means the tree should be serving. Probe the
		# port every 30s; two dead probes (~a minute) mean the pty close handler was
		# missed or the tree died without its terminal noticing - recover it rather
		# than idle. This is exactly the case that used to leave the master alive
		# with nothing on 3000/45545 and no President.pl.
		if ($status eq 'started') {
			if (++$tree_ticks >= 30) {
				$tree_ticks = 0;
				if (&tree_serving()) { $tree_misses = 0 }
				elsif (++$tree_misses >= 2) {
					print "the web port has been dead for ~" . ($tree_misses * 30) . "s with status 'started'; recovering\n";
					$tree_misses = 0;
					$status = 'frozen';
				}
			}
		}
		else { $tree_ticks = 0; $tree_misses = 0 }
		# Safety net for a shell that outlived its fork object (a teardown that
		# died halfway, a re-exec): reap it and any defunct child, but never the
		# current pty child, whose exit status belongs to ReadWriteFork.
		if (++$reap_ticks >= 30) {
			$reap_ticks = 0;
			&reap_own_children($fork ? $fork->pid : 0);
		}
		if ($status eq 'frozen' || $f_status eq 'restart') {
			$master_timer_paused = 1;
			my $died = '';
			eval {
				my $refused = 0;
				# A requested restart on a live tree is verified first: a change that
				# does not parse would only come back broken (or blank, like the /manager
				# page a truncated manager.js once blanked), so refuse it, keep the
				# running tree serving and say so. The failure is printed into the pty,
				# where the error watch reads it and offers a fix. A frozen tree is
				# already down, so it is restarted regardless - nothing serving to protect.
				if ($f_status eq 'restart' && $status ne 'frozen') {
					my $proof = &tree_verify();
					unless ($proof->{'ok'}) {
						write_file($status_file, 'good');
						print "restart refused - the tree is still serving; the code does not verify:\n" . $proof->{'report'} . "\n";
						$refused = 1;
					}
				}
				unless ($refused) {
					# the request is ours now: left standing, the next one-second tick
					# reads it again, kills the fresh boot before it writes "good", and
					# restarts forever
					write_file($status_file, 'good') if $f_status eq 'restart';
					&shut_down();
					$status = 'restarting';
					print "restarting president in 3";
					sleep 1;
					print "... 2";
					sleep 1;
					print "... 1";
					sleep 1;
					$fork = undef;
					$fork = &terminal_pty_runner({ 'program' => './President.pl' });
					&arm_boot_watch();
				}
				1;
			} or $died = $@ || 'unknown error';
			if ($died ne '') {
				print "restart sequence failed: $died\n";
				# arm_boot_watch may already be watching; only force a retry when the
				# sequence died before it armed (a mid-spawn death is recovered there)
				$status = 'frozen' unless $status eq 'restarting';
			}
			$master_timer_paused = 0;
		}
	});
}


# Verify the tree before a restart loads it. scripts/verify_change.pl checks that
# every Perl file compiles, every JavaScript file parses and every template
# compiles, across the whole tree. It runs here, once, while the old tree is
# still serving, so it adds nothing to the interruption; the restart only goes
# ahead when it passes. Returns { ok => 1 } when it passes (or when the script is
# not present yet), else the tail of its report to print.
sub tree_verify() {
	return { ok => 1 } unless -f 'scripts/verify_change.pl';
	my $out = `perl scripts/verify_change.pl --all --quiet 2>&1`;
	my $code = $? >> 8;
	$out = '' unless defined $out;
	return { ok => 1 } if $code == 0;
	$out =~ s/\s+$//;
	return { ok => 0, report => substr($out, 0, 2000) };
}


# A config.json is usable once it exists and names a signatorial (the file the
# cookie signing key is derived from). read_file has to be evaluated in scalar
# context -- otherwise it returns a list of lines and we only ever decode the
# first one.
sub config_is_usable() {
	return 0 unless -e './config.json';
	my $json = read_file('./config.json');
	my $config = eval { decode_json $json };
	return ( ref $config eq 'HASH' && $config->{'signatorial'} ) ? 1 : 0;
}

# First-run experience: install dependencies (terminal) and then run the web
# setup wizard for config.json + the encrypted database. Returns once a usable
# config.json exists, or exits if setup was abandoned.
sub first_run_setup() {
	my $force = grep { $_ eq '--setup' } @ARGV;
	my $config_ok = config_is_usable();
	return if $config_ok && !$force;

	print "\n";
	if ($force && $config_ok) {
		print "Re-running JawnOS setup at your request.\n\n";
	}
	else {
		print "Looks like this is a first run. Let's get you set up.\n\n";
	}

	# 1. dependencies (core-perl checker; works before anything is installed)
	system( 'perl', 'scripts/jawnos_deps.pl' ) if -e 'scripts/jawnos_deps.pl';

	# 2. config.json and the database. Preseed by default, so a container or an
	#    appliance never waits for a browser: answers come from JAWNOS_NAME and
	#    friends, and whatever is left out takes the wizard's default.
	#    JAWNOS_WIZARD=1 brings the interactive web wizard back.
	if ( -e 'scripts/jawnos_setup.pl' ) {
		my @setup = ( 'perl', 'scripts/jawnos_setup.pl' );
		push @setup, '--seed' unless $ENV{'JAWNOS_WIZARD'};
		system(@setup);
	}

	unless ( config_is_usable() ) {
		print "\nSetup was not completed. Re-run ./jawn to try again.\n";
		exit 1;
	}
	print "\nSetup complete. Starting JawnOS...\n\n";
}

