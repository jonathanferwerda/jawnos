#!/usr/bin/perl

use strict;
use warnings;

# Everything this tree writes is house data: the database and its WAL, backups,
# plaintext export temporaries and the logs. Create files private by default so
# a new one is never briefly readable by another local account; every worker
# inherits this umask. Existing files are tightened by
# scripts/privacy_permissions.pl.
umask 077;

# Somebody launching this (a desktop app, a systemd unit, an .desktop entry) never
# sources ~/.zshrc, so only the system @INC is present and the first 'use' below
# dies on 'Can't locate Mojo/...'. Find the same local::lib tree the shell would
# and export it too, so President.pl and every worker inherit it as well.
BEGIN {
	my $base = (($ENV{HOME} || (getpwuid $<)[7] || '') . '/perl5/lib/perl5');
	if ($base =~ m{/} && -d $base) {
		my @dirs = ($base);
		if (opendir(my $dh, $base)) {
			for my $name (sort readdir $dh) {
				my $dir = "$base/$name";
				push @dirs, $dir
					if $name ne '.' && $name ne '..' && -d $dir
					&& ($name =~ /-linux-/ || $name =~ /^[0-9]+\.[0-9]+/);
			}
			closedir $dh;
		}
		my %in_inc = map { $_ => 1 } @INC;
		unshift @INC, grep { !$in_inc{$_} } @dirs;
		my $lib = join ':', @dirs;
		$ENV{PERL5LIB} = $ENV{PERL5LIB} ? "$lib:$ENV{PERL5LIB}" : $lib;
	}
}

use Mojo::IOLoop::ReadWriteFork;
use IO::Socket::UNIX;
use IO::Select;
use Fcntl qw/F_SETFD FD_CLOEXEC/;
use POSIX qw/WNOHANG/;
use File::Slurp;
use File::Path qw/remove_tree/;
use Cwd qw(abs_path);
use Mojo::File 'path';
use Mojo::Log;
use Mojo::JSON qw/decode_json encode_json/;
use Data::Dumper;
use Sereal::Encoder qw(encode_sereal SRL_SNAPPY SRL_ZSTD);
use Sereal::Decoder qw(decode_sereal);
use feature 'current_sub';
my $encoder = Sereal::Encoder->new({ compress => SRL_ZSTD, compress_level => 3 });
my $decoder = Sereal::Decoder->new();
no warnings 'uninitialized';

# One master per machine: the watch socket is the machine's alone, so a launch
# that finds a master *answering* on it is a second jawn. A bare connect() is no
# proof of life - children inherit the listening fd, so survivors of a dead
# master still accept into the kernel backlog - therefore the framed query
# below, and only a reply counts. It stands down here - before the
# ~/.president wipe below, which must not eat the serving master's state, and
# before a single President.pl is started. Two masters otherwise fight over the
# ports and the socket, kill each other's trees, and cycle forever.
my $watch_path = &home('~/.process_watch');
if (-S $watch_path) {
	my $watch_live = 0;
	eval {
		my $probe = IO::Socket::UNIX->new(Peer => $watch_path);
		if ($probe) {
			$probe->autoflush(1);
			my $blob = $encoder->encode({ query => 'subprocesses' });
			my $packet = pack('N', length($blob)) . $blob;
			$probe->syswrite($packet);
			if (IO::Select->new($probe)->can_read(3)) {
				my $header = '';
				$watch_live = 1 if sysread($probe, $header, 4);
			}
		}
	};
	if ($watch_live) {
		print "\nAnother jawn is already running; this one is standing down.\n\n";
		exit 0;
	}
}

# A master that is alive but too busy to answer the watch query in three
# seconds is still a master. That is the phone being thawed after a freeze and
# the laptop just out of suspend: the app's own port probe (and this one) can
# lose to the scheduler, a second tree starts, wipes ~/.president under the
# first, and the two then cycle over the ports - the black screen for a minute
# or two after picking the phone up. The pid file names the boot master, and a
# live pid whose command line still names jawn is proof enough to stand down.
# A stale pid (a reboot, a recycled number) fails the command-line check, so a
# real start is never blocked.
my $boot_pid_file = &home('~/.president/pid');
if (-e $boot_pid_file) {
	my $boot_pid = eval { read_file($boot_pid_file) } // '';
	$boot_pid =~ s/\s+//g;
	if ($boot_pid =~ /^[0-9]+$/ && &pid_alive($boot_pid) && &pid_is_jawn($boot_pid)) {
		print "\nAnother jawn's master (pid $boot_pid) is alive; this one is standing down.\n\n";
		exit 0;
	}
}

my $dump_dir = &home('~/.president');
# Wipe the tree's own run state, but keep the handshake files the Android app
# and this tree exchange. The app's location service can write wake_ready a
# moment before or after the master starts; deleting it here made the manager
# take the permanent wake lock back and lose the batched-wake markers and the
# navigation pace until the next beat.
my %handshake = map { $_ => 1 } qw/wake_ready wake_lock_released utility_idle music_stream_wake gps_pace location.json verify-manifest restart.json restart.log restart.log.1 pending_restart/;
if (-e $dump_dir && opendir(my $dump, $dump_dir)) {
	while (my $entry = readdir($dump)) {
		next if $entry eq '.' || $entry eq '..' || $handshake{$entry};
		remove_tree("$dump_dir/$entry");
	}
	closedir $dump;
}
`mkdir $dump_dir` unless -e $dump_dir;
my $subprocesses = {};
our $logfile = &home('~/manager.log');

`touch $logfile` if not -e $logfile;
our $log = Mojo::Log->new(path => $logfile);

# The tree's console output is kept in a bounded, sequence-numbered ring and
# served over ~/.president/log instead of being teed into ~/pty.log. The error
# watch asks for what it has not seen yet; the ring lives in the master, so it
# still holds a dying tree's last words when the next tree reconnects. The ring
# itself is created after ./lib/JawnOS/LogBus.pm is loaded below, and log_socket
# serves it.
my $tmp_dir = '/tmp';
# Android's root /tmp exists on an emulator but belongs to the shell user, so
# a writable check matters as much as the directory check.
unless ( -d $tmp_dir && -w $tmp_dir ) {
	$tmp_dir = &home('~/.president/');
}
`mkdir $tmp_dir/ws` unless -e $tmp_dir . '/ws';

if (-l $0) {
  print "The script was executed via a symbolic link!\n";
  my $path = readlink($0);
	print $path . "\n";
	my @dir = split '/', $path;
	pop @dir;
	$path = join '/', @dir;
	chdir($path);
}

# The master loads only this file; President.pl and every worker are separate
# processes that the tree restart reloads. So an update that changes ./jawn
# used to leave the old master running until someone logged in and relaunched
# it (its behaviour stayed stale while the tree moved on). Watch our own file
# and replace this process with the new code when it changes - the same pid and
# terminal, so nothing has to supervise us.
my $master_path = -f $0 ? $0 : './jawn';
$master_path = abs_path($master_path) || $master_path;
sub master_stamp {
	my @s = stat($master_path);
	return @s ? ($s[9] . ':' . $s[7]) : '';
}
my $master_stamp = &master_stamp();
# When a changed master last failed to verify. The stamp is deliberately NOT
# consumed by a failure: an agent is often mid-edit when the tick looks, and a
# consumed stamp stranded the master on the old code until the file changed
# again - it never retried. Retried every 10s instead, because a cold guard is
# minutes and a broken file is usually fixed promptly.
my $master_retry_at = 0;
$| = 1;

# ---- first run: install dependencies, then run the setup wizard -------------
&first_run_setup();

# The control socket's protocol: one JSON line in, one out (perl/control.pl).
# Loaded here, after the chdir above, because ./jawn is started from the tree root
# and every other require in this file is cwd-relative too.
require './perl/control.pl';
require './lib/JawnOS/LogBus.pm';

# 4 MB holds roughly an hour of this tree's console output, and the watch reads
# 256 KB per minute, so a normal burst is never overwritten before it is asked
# for. A larger burst is reported as `dropped` rather than silently skipped.
our $log_ring = JawnOS::LogBus::ring_new(4 * 1024 * 1024);

# Seed the ring with the supervisor's tail before the tree starts. The ring is
# memory only, so a crash that took the master down would otherwise vanish; the
# desktop app and both systemd units append jawn's own stdout (which includes the
# pty bytes) to jawn-stdout.log, and that file survives the restart. The old
# pty.log was truncated at this same moment, so this keeps at least as much as it
# did and usually the whole crash. In a bare terminal there is no file and the
# screen is the record; the bus still works, it just starts empty.
sub log_seed {
	my @paths = ( &home('~/.local/state/jawnos/jawn-stdout.log') );
	unshift @paths, "$ENV{'XDG_STATE_HOME'}/jawnos/jawn-stdout.log"
		if defined $ENV{'XDG_STATE_HOME'} && length $ENV{'XDG_STATE_HOME'};
	my %seen;
	@paths = grep { !$seen{$_}++ } @paths;
	# The desktop respects XDG_STATE_HOME while the systemd units use the fixed
	# path, so take whichever candidate the supervisor is actually writing.
	my ($path) = sort { ((stat($b))[9] || 0) <=> ((stat($a))[9] || 0) }
		grep { -f $_ } @paths;
	return unless $path;
	my $size = -s $path;
	return unless $size;
	my $want  = 256 * 1024;
	my $start = $size > $want ? $size - $want : 0;
	open(my $fh, '<', $path) or return;
	seek($fh, $start, 0) or do { close $fh; return };
	my $tail = '';
	while (length($tail) < $size - $start) {
		my $got = read($fh, $tail, $size - $start - length($tail), length($tail));
		last unless $got;
	}
	close $fh;
	return unless length $tail;
	# Start at a line boundary: half a warning at the seek point is not a fault.
	$tail =~ s/^[^\n]*\n// if $start > 0;
	JawnOS::LogBus::ring_append($log_ring, $tail) if length $tail;
	return;
}
&log_seed();

my $fork = Mojo::IOLoop::ReadWriteFork->new;

$SIG{INT} = sub {
	&shut_down();
	exit 0;
};

my ($master_boot_watch, $master_boot_tries);
# The process the pty runs. It names the interpreter rather than relying on
# President.pl's "#!" line: a shebang of /usr/bin/perl only resolves through
# termux-exec's LD_PRELOAD, and the app's own supervisor (docs/roadmap-handoff.md
# M2) runs this tree without termux-exec. $^X is the perl already running here.
# ReadWriteFork execs the argv directly instead of typing it into an interactive
# shell: `bash -i` wrote this command into the house's ~/.bash_history on exit
# and existed only so the runner could write the command (and a ^C, which a raw
# pty never turns into SIGINT) to its stdin.
sub president_process() {
	my $interp = $^X;
	$interp = 'perl' unless defined $interp && length $interp;
	return {
		label        => "$interp ./perl/President.pl",
		program      => $interp,
		program_args => [ './perl/President.pl' ],
	};
}
# A re-exec keeps this master's pid, so any child it fathered before exec is
# still ours - and nobody else can reap it. Clear a stale pty child (and any
# defunct child) before this incarnation starts one of its own.
&reap_own_children();
$fork = &terminal_pty_runner(&president_process());
&arm_boot_watch();

my $status = 'off';
# Why the state machine is about to restart. Set wherever the tree is found down,
# so a recovery restart records a reason instead of looking like a request.
my $status_why = '';
# A restart asked for over the control socket, waiting for the guard's verdict on
# the next tick (the caller is holding a connection until then).
my $pending_restart;
# A restart asked for in the instant this master was reloading itself: the exec
# loses every in-memory structure, so the reason rides in a handshake file that
# the startup wipe preserves, and the new master performs it on its first tick.
{
	my $carry = &home('~/.president/pending_restart');
	if (-f $carry) {
		my $record = eval { decode_json(scalar read_file($carry)) };
		unlink $carry;
		if (ref $record eq 'HASH') {
			$pending_restart = {
				reason => $record->{'reason'} || 'carried through a master reload',
				source => $record->{'source'} || 'master-reload',
				requested_by => 0,
				stream => undef,
			};
		}
	}
}
# What this tree is running. Read when it is asked for, not once at startup: a
# version bump alone does not reload the master (only ./jawn does), so a cached
# string kept reporting the version from before the restart that shipped it.
sub tree_version {
	return '' unless -f './VERSION';
	open(my $fh, '<', './VERSION') or return '';
	local $/;
	my $version = <$fh>;
	close $fh;
	return '' unless defined $version;
	$version =~ s/\s+//g;
	return $version;
}

my @printless = (
	'Permission denied',
	'cannot open /proc/net',
	'Cannot bind netlink'
);


my ($master_timer,$master_timer_paused);
my ($tree_ticks,$tree_misses) = (0,0);
my ($last_master_tick,$tree_dead_since);
my $reap_ticks = 0;
&master_time_looper();
&control_socket();
&log_socket();
sub master_time_looper() {
	# In this Mojo the recurring callback is handed the loop as its only argument
	# (Mojo::IOLoop::_timer runs `$self->$cb`), so no timer id is passed to the
	# callback at all. The old code took one anyway (`$master_timer = $timer_id`)
	# and therefore stored undef: every `Mojo::IOLoop->remove($master_timer)` below
	# was a silent no-op, so each restart left the previous ticker running and the
	# master multiplied its own restart logic - thousands of "tree is back up"
	# lines and 43k uninit-$id warnings in jawn-stdout.log - until a stray tick tore
	# down the tree it had just started and the master sat alive-but-idle forever
	# (2026-10-15). One ticker now, its id taken from the return value, never
	# removed: the state machine below is idempotent, and a permanent ticker is
	# also the liveness watchdog that recovers a tree which died unnoticed.
	return if $master_timer;
	# One-second tick: a restart request is noticed at once rather than up to five
	# seconds late. The liveness probe below keeps its own 30s cadence.
	$master_timer = Mojo::IOLoop->recurring(1 => sub {
		# the sleeps below block the loop, so a restart cannot re-enter; guard anyway
		# so a fatality mid-sequence cannot wedge the master permanently
		return if $master_timer_paused;
		# A phone's app is frozen whole between scheduled wakes and a laptop suspends
		# the same way, so this ticker simply stops and then resumes. A tree the OS
		# killed while it was frozen leaves no listening port, and the 30s cadence
		# below would take a minute to notice - the "frozen for a minute" after
		# picking a phone up. When our own tick was away, probe at once and again
		# ten seconds later. A boot watch is excluded: it already owns the wait for
		# a tree this master started itself.
		my $tick_now = time;
		my $tick_gap = defined $last_master_tick ? $tick_now - $last_master_tick : 0;
		$last_master_tick = $tick_now;
		my $woke = ($tick_gap > 30 && !$master_boot_watch) ? 1 : 0;
		my $status_file = &home('~/.president/status');
		my $f_status = -e $status_file ? read_file($status_file) : '';
		# Our own file changed on disk (a git update): reload the master, not just
		# the tree. Verify first: a half-written or broken ./jawn must not replace
		# the master that is still serving. A pending 'restart' is consumed here so
		# the fresh master does not immediately restart again.
		my $stamp = &master_stamp();
		if ($stamp ne '' && $stamp ne $master_stamp && time >= $master_retry_at) {
			my $proof = &tree_verify();
			if ($proof->{'ok'}) {
				$master_stamp = $stamp;
				print "master changed on disk; reloading $master_path\n";
				# A restart asked for in this very tick is owed an answer, and the exec
				# loses every structure that could keep it. Answer, then hand the reason
				# to the next incarnation through a file the startup wipe preserves.
				if ($pending_restart) {
					&answer_restart($proof, $status eq 'frozen' ? 'frozen' : 'started');
					write_file(&home('~/.president/pending_restart'), encode_json({
						reason => $pending_restart->{'reason'},
						source => $pending_restart->{'source'},
					}));
					$pending_restart = undef;
				}
				write_file($status_file, 'good');
				$master_timer_paused = 1;
				&shut_down();
				exec($^X, $master_path, @ARGV) or do {
					print "re-exec of $master_path failed: $!\n";
					$master_timer_paused = 0;
					$status = 'frozen';
					$status_why = 'the master could not re-exec itself';
					return;
				};
			}
			else {
				$master_retry_at = time + 10;
				print "master changed on disk but the tree does not verify; keeping the running master:\n" . ($proof->{'report'} || '') . "\n";
			}
		}
		# Liveness watchdog: 'started' means the tree should be serving. Probe the
		# port every 30s; two dead probes (~a minute, or ~10s after a wake where a
		# killed tree is the likely story) mean the pty close handler was missed or
		# the tree died without its terminal noticing - recover it rather than idle.
		# This is exactly the case that used to leave the master alive
		# with nothing on 3000/45545 and no President.pl.
		# The boot watch owns the wait for a tree this master just started: it
		# probes every 3s and restarts after 90s. Running the 30s watchdog as
		# well would count the same slow boot twice and could tear down a tree
		# that is still binding its main server.
		if ($status eq 'started' && !$master_boot_watch) {
			if ($woke) { $tree_ticks = 29 }   # probe on this very tick
			if (++$tree_ticks >= 30) {
				# after a wake the second probe follows in ~10s, not 30
				$tree_ticks = $woke ? 20 : 0;
				if (&tree_serving()) { $tree_misses = 0; $tree_dead_since = undef }
				elsif (++$tree_misses >= 2) {
					$tree_dead_since ||= $tick_now;
					my $dead_for = $tick_now - $tree_dead_since;
					my $dump = &wedge_dump();
					print "the web port has been dead for ~" . $dead_for . "s with status 'started'; recovering"
						. ($dump ne '' ? " (what it was doing: $dump)" : '') . "\n";
					$tree_misses = 0;
					$tree_dead_since = undef;
					$status = 'frozen';
					$status_why = 'the web port stopped answering for ~' . $dead_for . 's';
				}
				else { $tree_dead_since ||= $tick_now }
			}
		}
		else { $tree_ticks = 0; $tree_misses = 0; $tree_dead_since = undef }
		# Safety net for a pty child that outlived its fork object (a teardown that
		# died halfway, a re-exec): reap it and any defunct child, but never the
		# current pty child, whose exit status belongs to ReadWriteFork.
		if (++$reap_ticks >= 30) {
			$reap_ticks = 0;
			&reap_own_children($fork ? $fork->pid : 0);
		}
		# A restart is asked for three ways, and all three end here so all three are
		# verified, recorded and answered the same way: the control socket (a caller
		# holding a connection, waiting for the verdict), the status file (the old
		# channel, still the one a worker about to be killed uses), or the master
		# finding the tree down. The file has said exactly "restart" since the
		# beginning; anything after it is the reason the writer gave.
		my ($file_restart, $file_why) = &control::status_reason($f_status);
		my $request;
		if ($pending_restart) { $request = $pending_restart }
		elsif ($file_restart) {
			$request = {
				reason => length $file_why ? $file_why : 'asked through the status file',
				source => 'status-file',
			};
		}
		if ($status eq 'frozen') {
			my $down = length $status_why ? $status_why : 'the tree went down';
			if ($request) {
				$request->{'reason'} .= ' (the tree was already down: ' . $down . ')'
					unless index($request->{'reason'}, $down) >= 0;
			}
			else { $request = { reason => $down, source => 'master-watchdog' } }
		}
		if ($request) {
			$master_timer_paused = 1;
			my $before = $status eq 'frozen' ? 'frozen' : 'started';
			my $died = '';
			eval {
				# A live tree is verified first: a change that does not parse would
				# only come back broken (or blank, like the /manager page a truncated
				# manager.js once blanked), so refuse it, keep the running tree serving
				# and say so. A frozen tree is already down - nothing serving to
				# protect - so it restarts regardless.
				my $proof = $status eq 'frozen'
					? { ok => 1, skipped => 'not verified: the tree was already down' }
					: &tree_verify();
				# the request is ours now: left standing, the next one-second tick
				# reads it again, kills the fresh boot before it writes "good", and
				# restarts forever
				write_file($status_file, 'good') if $file_restart;
				print 'restart asked by ' . ($request->{'source'} || '?') . ': ' . $request->{'reason'} . "\n";
				&control::write_record({
					ok => $proof->{'ok'} ? 1 : 0,
					refused => $proof->{'ok'} ? undef : 'verify',
					reason => $request->{'reason'},
					source => $request->{'source'} || 'status-file',
					requested_by => $request->{'requested_by'} || 0,
					status_before => $before,
					version => &tree_version(),
					master_pid => $$,
					verify => $proof->{'summary'} || $proof->{'skipped'} || '',
					report => $proof->{'ok'} ? '' : &control::clean_text($proof->{'report'} || '', 2000),
				}, dir => &home('~/.president'));
				&answer_restart($proof, $before);
				$pending_restart = undef;
				if ($proof->{'ok'}) {
					&shut_down();
					$status = 'restarting';
					$status_why = '';
					# No blind countdown: shut_down() already waited for the pids it
					# signalled, and the bind check below is the real gate, so "in 3...
					# 2... 1" only added three seconds to every restart.
					print "restarting president\n";
					# The old listeners are released asynchronously: a prefork
					# manager can be signalled and still hold its socket for a few
					# seconds. A boot that binds first loses the main server with
					# "Address already in use" while the dock still answers - and
					# it used to stay that way, because the liveness check only
					# knew the dock. Wait until every configured port is free (a
					# bind, not a connect: a stuck listener still answers a
					# connect) or the deadline passes; the boot watch recovers a
					# tree that could not come up.
					my $free_deadline = time + 20;
					while (time < $free_deadline) {
						my $busy = 0;
						foreach my $port ( &config_ports() ) {
							$busy = 1 unless &port_free($port);
						}
						last unless $busy;
						sleep .5;
					}
					$fork = undef;
					$fork = &terminal_pty_runner(&president_process());
					&arm_boot_watch();
				}
				else {
					print "restart refused - the tree is still serving; the code does not verify:\n" . ($proof->{'report'} || '') . "\n";
				}
				1;
			} or $died = $@ || 'unknown error';
			if ($died ne '') {
				print "restart sequence failed: $died\n";
				# arm_boot_watch may already be watching; only force a retry when the
				# sequence died before it armed (a mid-spawn death is recovered there)
				unless ($status eq 'restarting') {
					$status = 'frozen';
					$status_why = 'the restart sequence failed: ' . $died;
				}
			}
			$master_timer_paused = 0;
		}
	});
}


# Verify the tree before a restart loads it. scripts/verify_change.pl checks that
# every Perl file compiles, every JavaScript file parses and every template
# compiles, across the whole tree. It runs here, once, while the old tree is
# still serving, so it adds nothing to the interruption; the restart only goes
# ahead when it passes. Returns { ok => 1, summary => ... } when it passes (or
# when the script is not present yet), else { ok => 0, report => ... }.
#
# The sweep is handed a manifest so it re-checks only the files whose bytes moved
# since they last passed: judging all 744 files costs ~90s of perl -c, node
# --check and git show each, and that sat on the critical path of every restart
# (agents reporting a minute-long "restart" from a status file). With the
# manifest a restart with nothing new to judge is ~0.4s; a fresh tree, a new
# manifest version, or a tree that just failed still gets the full sweep.
sub tree_verify() {
	return { ok => 1 } unless -f 'scripts/verify_change.pl';
	my $manifest = &home('~/.president/verify-manifest');
	my $out = `perl scripts/verify_change.pl --all --quiet --manifest "$manifest" 2>&1`;
	my $code = $? >> 8;
	$out = '' unless defined $out;
	$out =~ s/\s+$//;
	# the summary line ("745 file(s) pass (...)") is what a caller is shown back
	my ($summary) = reverse grep { /\S/ } split /\n/, $out;
	$summary = '' unless defined $summary;
	return { ok => 1, summary => &control::clean_text($summary, 300) } if $code == 0;
	return { ok => 0, report => substr($out, 0, 2000) };
}


# A config.json is usable once it exists and names a signatorial (the file the
# cookie signing key is derived from). read_file has to be evaluated in scalar
# context -- otherwise it returns a list of lines and we only ever decode the
# first one.
sub config_is_usable() {
	return 0 unless -e './config.json';
	my $json = read_file('./config.json');
	my $config = eval { decode_json $json };
	return ( ref $config eq 'HASH' && $config->{'signatorial'} ) ? 1 : 0;
}

# First-run experience: install dependencies (terminal) and then run the web
# setup wizard for config.json + the encrypted database. Returns once a usable
# config.json exists, or exits if setup was abandoned.
sub first_run_setup() {
	my $force = grep { $_ eq '--setup' } @ARGV;
	my $config_ok = config_is_usable();
	return if $config_ok && !$force;

	print "\n";
	if ($force && $config_ok) {
		print "Re-running JawnOS setup at your request.\n\n";
	}
	else {
		print "Looks like this is a first run. Let's get you set up.\n\n";
	}

	# 1. dependencies (core-perl checker; works before anything is installed)
	# A machine with a display is a desktop: check the app's own packages too -
	# WebKitGTK and GStreamer for the embedded view, and the colour emoji font
	# Chat's SMS emoji need. A headless server and the phone keep to the core.
	if ( -e 'scripts/jawnos_deps.pl' ) {
		my @deps = ( 'perl', 'scripts/jawnos_deps.pl' );
		push @deps, '--desktop' if $ENV{'DISPLAY'} || $ENV{'WAYLAND_DISPLAY'};
		system(@deps);
	}

	# 2. config.json and the database. Preseed by default, so a container or an
	#    appliance never waits for a browser: answers come from JAWNOS_NAME and
	#    friends, and whatever is left out takes the wizard's default.
	#    JAWNOS_WIZARD=1 brings the interactive web wizard back.
	if ( -e 'scripts/jawnos_setup.pl' ) {
		my @setup = ( 'perl', 'scripts/jawnos_setup.pl' );
		push @setup, '--seed' unless $ENV{'JAWNOS_WIZARD'};
		system(@setup);
	}

	unless ( config_is_usable() ) {
		print "\nSetup was not completed. Re-run ./jawn to try again.\n";
		exit 1;
	}
	print "\nSetup complete. Starting JawnOS...\n\n";
}

