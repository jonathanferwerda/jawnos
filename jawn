sub shut_down() {
	print "pres Ctrl+C! Closing...\n";
	# this tear-down is on purpose, so the fork's own close must not be read as a
	# crash (see the close handler in terminal_pty_runner)
	$fork->{'jawn_deliberate'} = 1 if $fork;
	# No ^C byte: the pty runs raw (conduit raw => 1), so a written \x03 is data
	# for a process that never reads stdin, not SIGINT. The named INT below and
	# the sweep after it are the stop.
	# The named sweep is the workhorse: it takes the tree by process name and full
	# command line, and whatever still holds the web port. (2026-10-14: this used to
	# be followed by pid-as-substring matches against `ps -e`, which once matched a
	# freshly-started President and killed the boot. Only exact, verified pids now.)
	# run it with this interpreter, not by its shebang: on Termux perl is not at
	# /usr/bin/perl, so './scripts/manager_killer.pl' fails to exec and the sweep
	# silently never runs (leftover processes keep the web port and wedge the
	# next boot). $^X is the interpreter running this master.
	`"$^X" ./scripts/manager_killer.pl`;
	# the pids the tree reported to the master, each by its exact number and only
	# when its command line still names a jawn program - never a substring match, so
	# a reused pid (or a new process whose number merely contains an old one) is
	# left alone
	my @tracked;
	foreach my $s ( keys %{$subprocesses} ) {
		next if $s =~ /[a-zA-Z]/;
		push @tracked, $s;
		my $kids = $subprocesses->{$s}->{'subprocesses'};
		push @tracked, keys %{$kids} if eval { keys %{$kids} };
	}
	my %seen;
	@tracked = grep { /^[0-9]+$/ && !$seen{$_}++ } @tracked;
	my @sent;
	foreach my $pid ( grep { &pid_alive($_) && &pid_is_jawn($_) } @tracked ) {
		kill 'INT', $pid;
		push @sent, $pid;
		print "INT $pid\n";
	}
	# our own pty child (President) ends the terminal; it is our direct child, so
	# its exact pid is safe even though the kill sweep matches by command line
	my $fpid = $fork ? $fork->pid : 0;
	if ($fpid && &pid_alive($fpid) && $fpid != $$) {
		kill 'INT', $fpid;
		push @sent, $fpid;
		print "INT $fpid (pty)\n";
	}
	$fork->close if $fork;
	# a short grace for the tree to run its own cleanup, then SIGKILL what is left
	my @alive;
	for (1 .. 10) {
		@alive = grep { &pid_alive($_) } @sent;
		last unless @alive;
		select(undef, undef, undef, 0.1);
	}
	foreach my $pid (@alive) {
		my $ours = ($pid == $fpid) ? 1 : &pid_is_jawn($pid);
		next unless $ours;
		kill 'KILL', $pid;
		print "KILL $pid\n";
	}
	# A last, independent sweep of /proc by command line: anything that booted into
	# the tree while we were tearing it down (a respawned worker, a manager that
	# re-registered) still holds the web port or the watch socket and would fight
	# the next boot. Stop and Restart both end here, so both leave the box provably
	# clear. Compile probes are left alone: another agent's `perl -c perl/Manager.pl`
	# looks like a worker by name, so a command line carrying -c/-e/-M is skipped.
	my @leftovers;
	if (opendir(my $procs, '/proc')) {
		for my $entry (readdir $procs) {
			next unless $entry =~ /^([0-9]+)$/;
			my $pid = $1;
			next if $pid == $$ || $pid == $fpid;
			my $cmd = &pid_cmdline($pid);
			next if $cmd =~ / (?:-c|-e|-M) /;
			# The house advertiser runs under a worker; a killed tree can orphan the
			# avahi-publish-service (ppid 1) and it then keeps advertising the dead
			# tree's ports. Match only our service name, not every avahi publication.
			push @leftovers, $pid
				if $cmd =~ /President\.pl|Manager\.pl|Websocket\.pl|teletype\.pl|watch\.pl|jawn-bt|Music\.pl|Alarm\.pl/
				|| ($cmd =~ /avahi-publish-service/ && $cmd =~ /_jawnos-house\._tcp/);
		}
		closedir $procs;
	}
	my $cleared = 0;
	foreach my $pid (@leftovers) {
		next unless &pid_alive($pid);
		kill 'KILL', $pid;
		$cleared++;
		print "KILL leftover $pid\n";
	}
	print "leftover check: " . ($cleared ? "$cleared cleared" : 'clean') . "; web port " . (&config_port() || 0) . " is " . (&tree_serving() ? 'STILL ANSWERING' : 'free') . "\n";
	# The pty child is our child too. Collect it here: the IOLoop waiter cannot run
	# during the sleeps above, and the re-exec path exec()s straight after this,
	# which would strand a dead child as a defunct process forever.
	&reap_own_children();
	$subprocesses = {};
	sleep .1;
}

# A pid is only signalled when it is still there (kill 0) and, for anything but
# our own pty child, its command line still names a jawn program - so a pid the OS
# handed to an unrelated process in the meantime is never touched.
sub pid_alive {
	my ($pid) = @_;
	return 0 unless $pid && $pid =~ /^[0-9]+$/;
	return kill(0, $pid) ? 1 : 0;
}

sub pid_cmdline {
	my ($pid) = @_;
	return '' unless $pid && $pid =~ /^[0-9]+$/;
	if (open(my $fh, '<', "/proc/$pid/cmdline")) {
		local $/;
		my $line = <$fh>;
		close $fh;
		$line = '' unless defined $line;
		$line =~ s/\0/ /g;
		return $line;
	}
	my $ps = `ps -o args= -p $pid 2>/dev/null`;
	$ps = '' unless defined $ps;
	$ps =~ s/\s+$//;
	return $ps;
}

sub pid_is_jawn {
	my ($pid) = @_;
	return &pid_cmdline($pid) =~ /President\.pl|Manager\.pl|Websocket\.pl|teletype\.pl|watch\.pl|jawn-bt|Music\.pl|Alarm\.pl/ ? 1 : 0;
}

# Reap the master's own direct children. The pty child is a child of the master,
# not of the OS: ReadWriteFork's waiter cannot run while a teardown blocks in
# sleep/select, and a re-exec leaves before the IOLoop runs again, so a child
# killed there stayed a zombie for the life of the next incarnation - the
# `[bash] <defunct>` that survived a re-exec on 2026-10-21, from when the pty
# ran a shell. `keep` is the current pty child, whose exit status belongs to its
# close event.
sub reap_own_children {
	my ($keep) = @_;
	$keep ||= 0;
	my @kids;
	if (opendir(my $procs, '/proc')) {
		for my $entry (readdir $procs) {
			next unless $entry =~ /^([0-9]+)$/;
			my $pid = $1;
			next if $pid == $$ || $pid == $keep;
			next unless open(my $fh, '<', "/proc/$pid/stat");
			my $line = <$fh>;
			close $fh;
			next unless defined $line;
			# "pid (comm) state ppid ..." - comm may hold spaces and parens
			my ($state, $ppid) = $line =~ /\)\s+(\S+)\s+([0-9]+)\s/;
			push @kids, [$pid, $state] if defined $ppid && $ppid == $$;
		}
		closedir $procs;
	}
	my $cleaned = 0;
	for my $kid (@kids) {
		my ($pid, $state) = @$kid;
		if ($state ne 'Z') {
			kill 'INT', $pid;
			for (1 .. 10) { last unless &pid_alive($pid); select(undef, undef, undef, 0.05) }
			kill 'KILL', $pid if &pid_alive($pid);
		}
		# waitpid is the point: an unregistered child is only gone once we
		# collect it, so keep trying briefly rather than leave it defunct
		for (1 .. 20) {
			my $got = waitpid($pid, WNOHANG);
			last if $got == $pid || $got == -1;
			select(undef, undef, undef, 0.05);
		}
		print 'cleared leftover child ' . $pid . "\n";
		$cleaned++;
	}
	return $cleaned;
}

# Bring the tree up (or not): after a (re)start the master checks that the web
# port answers, and if it does not within the window it restarts once more, up to
# a few tries - so a boot that lost a race with another tear-down still recovers.
# Every port the tree is meant to answer on: the dock (`port`, the locker
# server) and the manager (`working_port`, the main server the app opens). They
# are separate listeners, so a tree whose main server lost its bind to a
# leftover listener still answers the dock; probing only the dock called that
# "serving" and neither the boot watch nor the watchdog ever recovered the
# screen the app was opening (2026-10-29: the phone's 45545 stayed dead while
# 3000 answered, and the app sat black).
sub config_ports {
	my $file = -e './config.json' ? './config.json' : '';
	return () unless $file;
	my $cfg = eval { return decode_json scalar read_file($file) };
	return () unless $cfg && ref $cfg eq 'HASH';
	my @ports;
	foreach my $key ( 'port', 'working_port' ) {
		my $p = eval { $cfg->{$key} } || 0;
		next unless $p =~ /^[0-9]+$/ && $p > 0;
		next if grep { $_ == $p } @ports;
		push @ports, $p;
	}
	return @ports;
}

# The dock port, kept for callers that name one port (the boot watch's early
# return and the messages print it).
sub config_port {
	my @ports = &config_ports();
	return @ports ? $ports[0] : 0;
}

sub port_answers {
	my ($port) = @_;
	return 0 unless $port;
	# A connect() proves only that a listening socket exists: a tree whose event
	# loop is blocked (a wedged database write, a handler waiting on a lock) still
	# completes the handshake into the accept queue, so this watchdog read exactly
	# the failure it exists to catch as healthy and never recovered the tree.
	# port_free() below draws the same distinction for the one question a bind
	# answers. Ask for an HTTP answer instead; probe.pl asks it, and the route it
	# asks reads the database.
	eval { require './perl/probe.pl' };
	return probe::serving($port, 'timeout' => 2) if defined &probe::serving;
	# No probe module (a half-copied tree): keep the socket test rather than call
	# a healthy tree dead and restart the house over a missing file.
	require IO::Socket::INET;
	my $ok = eval {
		my $sock = IO::Socket::INET->new(PeerAddr => '127.0.0.1', PeerPort => $port, Timeout => 2);
		$sock ? (close($sock), 1) : 0;
	};
	return $ok ? 1 : 0;
}

# What the tree was doing when it stopped answering. The master holds no
# database handle and cannot see inside a stuck worker, so record the outside
# view before the restart destroys it: the process table with each process's
# kernel wait channel (D = disk, S = sleeping in a syscall), the database and
# its WAL, and the log's tail. The error watch reads this path from the pty.
sub wedge_dump {
	my $path = &home('~/.president') . '/wedge-' . time . '.txt';
	my @out = ('tree wedged ' . localtime() . " - the ports stopped answering\n\n");
	my $ps = `ps -eo pid,ppid,stat,wchan:24,etime,args 2>/dev/null`;
	my @tree = grep { /\b(?:President|Manager|Websocket|teletype|watch|Music|Alarm|pen)\.pl\b/ }
		split(/\n/, defined $ps ? $ps : '');
	push @out, "PROCESSES\n", (map { "$_\n" } @tree), "\n" if @tree;
	foreach my $file ( glob('database/jawnos.db*') ) {
		my $bytes = -s $file;
		$bytes = 0 unless defined $bytes;
		push @out, sprintf("%-34s %12d bytes\n", $file, $bytes);
	}
	push @out, "\n";
	my $log_path = $logfile;
	if (-e $log_path && open(my $fh, '<', $log_path)) {
		my $size = -s $fh || 0;
		seek($fh, $size > 16384 ? $size - 16384 : 0, 0);
		my @tail = <$fh>;
		close $fh;
		splice(@tail, 0, @tail - 40) if @tail > 40;
		push @out, "LOG (last 40 lines of $log_path)\n", @tail;
	}
	my $ok = eval { write_file($path, join('', @out)); chmod 0600, $path; 1 };
	return $ok ? $path : '';
}

# True when nothing is bound to the port. A connect() is not the same question:
# a stuck listener still completes (or queues) it, and a full accept queue just
# times out, so the bind is what decides whether a boot can take the port.
sub port_free {
	my ($port) = @_;
	return 0 unless $port;
	require IO::Socket::INET;
	my $sock = eval {
		IO::Socket::INET->new(
			LocalAddr => '0.0.0.0', LocalPort => $port,
			Listen => 1, ReuseAddr => 1
		);
	};
	return 0 unless $sock;
	close $sock;
	return 1;
}

sub tree_serving {
	my @ports = &config_ports();
	return 0 unless scalar @ports;
	foreach my $port ( @ports ) {
		return 0 unless &port_answers($port);
	}
	return 1;
}

sub arm_boot_watch {
	return unless &config_port();
	Mojo::IOLoop->remove($master_boot_watch) if $master_boot_watch;
	$master_boot_watch = undef;
	my $deadline = time + 90;
	# Same callback-argument rule as the master ticker: the id comes from the return
	# value, never from the callback (it is not passed), so the "tree is back up"
	# branch can actually remove this timer. Taken from the callback instead, it was
	# undef, the remove was a no-op, and this ticked every 3s forever printing "tree
	# is back up" (18715 lines in jawn-stdout.log).
	$master_boot_watch = Mojo::IOLoop->recurring(3 => sub {
		if (&tree_serving()) {
			print "tree is back up\n";
			Mojo::IOLoop->remove($master_boot_watch) if $master_boot_watch;
			$master_boot_watch = undef;
			$master_boot_tries = 0;
			return;
		}
		return if time < $deadline;
		Mojo::IOLoop->remove($master_boot_watch) if $master_boot_watch;
		$master_boot_watch = undef;
		$master_boot_tries = ($master_boot_tries || 0) + 1;
		if ($master_boot_tries <= 3) {
			print "the tree did not come up in 90s; restarting it (attempt $master_boot_tries)\n";
			$status = 'frozen';
			$status_why = 'the tree did not come up in 90s (attempt ' . $master_boot_tries . ')';
		}
		else {
			# The tree could not boot after several tries. Standing down (rather than
			# sitting alive-but-idle) lets a fresh launch take over: the mobile app's
			# autostart sees the master gone and starts a clean one, instead of reading
			# a half-dead master as "restarting..." forever.
			print "the tree did not come up after $master_boot_tries attempts; standing down for a fresh launch\n";
			$master_boot_tries = 0;
			exit 1;
		}
	});
}

# ---- the control socket ------------------------------------------------------
#
# One JSON line in, one JSON line out on ~/.president/control. The protocol lives
# in perl/control.pl so scripts/restart.pl and t/57-control-socket.t speak exactly
# what this does; only the plumbing is here. A restart is answered after the tree
# guard has run, which is why the tick holds the caller's connection: the reply
# is the verdict, not an acknowledgement.

# Answer a restart request made over the socket, if one is waiting. Called from
# the tick before shut_down(): the write has to reach the caller while the loop
# still runs, because the teardown blocks it for seconds.
sub answer_restart {
	my ($proof, $before) = @_;
	my $request = $pending_restart or return;
	my $stream = $request->{'stream'} or return;
	my $reply = &control::restart_reply({
		proof => $proof,
		reason => $request->{'reason'},
		source => $request->{'source'},
		version => &tree_version(),
		pid => $$,
		status_before => $before,
	});
	&control_write($stream, encode_json($reply) . "\n");
	return;
}

# A reply leaves on the wire here, not through Mojo's write buffer. write() only
# buffers and registers the handle writable - the syswrite happens on the next
# pass of the loop - so write-then-close, which is what a one-shot protocol does,
# silently discarded every answer (the caller saw a clean EOF and reported a
# timeout). A direct syswrite also matters for the restart verdict: it has to be
# out before shut_down() blocks this loop for seconds.
sub control_write {
	my ($stream, $text) = @_;
	return unless $stream && defined $text && length $text;
	my $handle = eval { $stream->handle };
	unless ($handle) {
		eval { $stream->write($text); $stream->close_gracefully };
		return;
	}
	my $data = $text;
	while (length $data) {
		my $sent = eval { syswrite($handle, $data) };
		last unless defined $sent && $sent > 0;
		substr($data, 0, $sent, '');
	}
	# whatever a full socket would not take, hand to the reactor rather than lose
	if (length $data) { eval { $stream->write($data); $stream->close_gracefully }; return }
	eval { $stream->close };
	return;
}

# Mojo records every listener it binds in $ENV{MOJO_REUSE} ("unix:<path>:<fd>") so
# a re-exec can inherit the fd and keep accepting. These two sockets want the
# opposite: no worker may inherit them - a survivor of a dead master would answer
# for it, which is what fools the duplicate-master guard at the top of this
# script - so the fd is marked CLOEXEC. The env entry survives the exec while the
# fd does not, and the next incarnation then dies inside listen() with "Can't open
# file descriptor N: Bad file descriptor". The control socket vanished on the
# first master reload in testing; the watch socket had been missing since some
# reload nobody noticed (its eval swallowed the failure). Bind, keep the fd ours,
# and forget the entry. (ws_server_socket in lib/JawnOS/Manager.pm does the same
# for the worker sockets, for the same reason.)
sub forget_mojo_reuse {
	my $path = shift;
	return unless defined $path && defined $ENV{'MOJO_REUSE'} && length $ENV{'MOJO_REUSE'};
	$ENV{'MOJO_REUSE'} = join ',', grep { !/^unix:\Q$path\E:/ } split /,/, $ENV{'MOJO_REUSE'};
	return;
}

sub private_unix_listener {
	my ($path, $id) = @_;
	return $id unless $id;
	my $acceptor = Mojo::IOLoop->acceptor($id);
	my $handle = $acceptor ? $acceptor->handle : undef;
	return $id unless $handle;
	fcntl($handle, F_SETFD, FD_CLOEXEC);
	&forget_mojo_reuse($path);
	return $id;
}

sub log_socket() {
	my $path = &home('~/.president/log');
	eval {
		&forget_mojo_reuse($path);
		my $id = Mojo::IOLoop->server({ path => $path } => sub {
			my ($loop, $stream, $cid) = @_;
			my $buffer = '';
			$stream->high_water_mark(8 * 1024 * 1024);
			$stream->on(read => sub {
				my ($stream, $bytes) = @_;
				$buffer .= $bytes;
				unless ($buffer =~ /\n/) {
					# one line is one request; a client that never ends one is not one
					$stream->close if length($buffer) > 8192;
					return;
				}
				my ($line) = split /\n/, $buffer, 2;
				$buffer = '';
				my $reply = JawnOS::LogBus::reply_for($log_ring, $line);
				$stream->write($reply);
				$stream->close_gracefully;
			});
		});
		# The same private-listener rule as control and watch: Mojo keeps listener
		# fds open across exec, so a child would inherit this socket and a survivor
		# of a dead master would answer for it - and a kept MOJO_REUSE entry makes
		# the next reload die in listen().
		&private_unix_listener($path, $id);
		1;
	} or print "the log socket could not be started: $@\n";
	return;
}

sub control_socket() {
	my $path = &home('~/.president/control');
	eval {
		&forget_mojo_reuse($path);
		my $id = Mojo::IOLoop->server({ path => $path } => sub {
			my ($loop, $stream, $cid) = @_;
			my $buffer = '';
			$stream->on(read => sub {
				my ($stream, $bytes) = @_;
				$buffer .= $bytes;
				unless ($buffer =~ /\n/) {
					# one line is one request; a client that never ends one is not one
					$stream->close if length($buffer) > 8192;
					return;
				}
				my ($line) = split /\n/, $buffer, 2;
				$buffer = '';
				my $answer = &control::handle($line, {
					status => $status,
					why => $status_why,
					pid => $$,
					version => &tree_version(),
					pending => $pending_restart ? 1 : 0,
					last => &control::read_record(dir => &home('~/.president')),
					verify => \&tree_verify,
				});
				if (my $reply = $answer->{'reply'}) {
					&control_write($stream, encode_json($reply) . "\n");
					return;
				}
				# A restart: one at a time. A second caller while one is waiting is
				# told so, rather than silently queued behind a request it did not make.
				if ($pending_restart) {
					&control_write($stream, encode_json({
						ok => 0, cmd => 'restart', accepted => 0, error => 'busy',
						message => 'a restart is already pending',
					}) . "\n");
					return;
				}
				$pending_restart = {
					reason => $answer->{'reason'},
					source => $answer->{'source'},
					requested_by => $answer->{'requested_by'},
					cid => $cid,
					stream => $stream,
				};
			});
			$stream->on(close => sub {
				# The caller hung up before the verdict: the request was still made, so
				# the restart goes ahead - there is just nobody left to tell.
				if ($pending_restart && defined $pending_restart->{'cid'} && $pending_restart->{'cid'} eq $cid) {
					$pending_restart->{'stream'} = undef;
				}
			});
		});
		# Mojo keeps listener fds open across exec on purpose, so every child would
		# inherit this socket and a survivor of a dead master would answer for it -
		# the same trap the watch socket at the top of this script guards against.
		&private_unix_listener($path, $id);
		1;
	} or print "the control socket could not be started: $@\n";
	return;
}

sub process_watch() {
	eval {

		# a stale MOJO_REUSE entry names a dead fd and makes listen() die instead
		# of binding (see private_unix_listener below)
		&forget_mojo_reuse($process_watch_file);
		my $server = Mojo::IOLoop->server({ path => $process_watch_file } => sub {
			my ($loop,$stream,$id) = @_;
			$stream->handle->autoflush(1);
			$stream->high_water_mark(8 * 1024 * 1024);

			$buffers{$id} = '';
			$stream->on(read => sub () {

				my ($stream, $bytes) = @_;

				$buffers{$id} .= $bytes;

				while (1) {
					last if length($buffers{$id}) < 4;

	        my $payload_length = unpack('N', substr($buffers{$id}, 0, 4));

	        # If we don't have the full payload yet, wait for next event loop tick
	        last if length($buffers{$id}) < (4 + $payload_length);

	        # Extract header and data cleanly using 4-argument substr for speed
	        substr($buffers{$id}, 0, 4, '');
	        my $sereal_blob = substr($buffers{$id}, 0, $payload_length, '');

					my $process = eval { $decoder->decode($sereal_blob) };
					if ($@) {
						warn "Worker $$: Failed to parse Sereal: $@";
						next;
					}

					if ($process->{'query'}) {
						my $q = $process->{'query'};
						my $data = {};
						if ($q eq 'subprocesses') {
							$data = $subprocesses;
						}
						eval {

							$subprocesses->{'status'} = 'report';
							my $jwsm = $encoder->encode($data);
							my $payload_length = length($jwsm);
							my $packet = pack('N', $payload_length) . $jwsm;


							$stream->write($packet);
						};
						if ($@) { warn "Worker $$: Failed to send 'stop' state: $@" }
					}
					elsif ($process->{'status'} eq 'report') {
						$log->info('i see the report');
					}
					else {
						$subprocesses->{$process->{'parent'}}->{'subprocesses'}->{$process->{'pid'}} = $process;

						if ($process->{'status'} eq 'stop') {
							delete $subprocesses->{$process->{'parent'}}->{'subprocesses'}->{$process->{'pid'}};
						}

						# Ordinary updates get no reply. A bare uuid write here used to pile up
						# unread in the worker's socket and desync the next length-prefixed
						# query reply (which is why the system settings page only sometimes
						# loaded). Only queries are answered, always length-prefixed.
					}





				}
			});
			$stream->on(close => sub {
				delete $buffers{$id};
			});
		});
		# Mojo keeps listener fds open across exec on purpose ($^F = 1023), so
		# every child inherits this socket; a survivor then keeps it accepting
		# into the kernel backlog long after the master is gone, which is what
		# fooled the guard at the top of this script. This fd is the master's - and
		# the MOJO_REUSE entry has to go with it, or the next reload cannot bind.
		return &private_unix_listener($process_watch_file, $server);
	}
}
Mojo::IOLoop->start unless Mojo::IOLoop->is_running;

sub terminal_pty_runner() {
	return $fork if $status eq 'starting';
	$status = 'starting';
	my $data = shift;
	if (!$fork) {
		$fork = Mojo::IOLoop::ReadWriteFork->new;
	}
	print 'starting fork' . "\n";

	$fork->conduit({raw => 1, type => "pty"});

  $fork->on(read => sub () {
		my ($fork, $bytes) = @_;

		# A listener rebind can lose to a sibling process and log this without the
		# tree being dead: the tunnel hub binds a port per peer on whichever worker
		# accepted the websocket, and a redial can land in another worker while the
		# sibling still holds it. Treating the text as a death made the whole tree
		# restart every couple of minutes, which cut every sync at its confirm step.
		# A tree that truly cannot bind its web port is caught by the liveness
		# watchdog (two 30s probes) and arm_boot_watch (90s), so this stays a note.
		if ($bytes =~ /Address already in use/) {
			print "listener already bound (not a tree death)\n";
		}
		# President prints "They dead" from its END block even on a restart this
		# master asked for; jawn_deliberate marks that case, so it cannot re-freeze
		# the fresh tree whose output arrives on the same pty.
		elsif (!$fork->{'jawn_deliberate'} && ($bytes =~ /they dead/ || $bytes =~ /President Died/ || $bytes =~ /core dumped/)) {
			print "See it's dead\n";
			$status = 'frozen';
			$status_why = 'the tree printed that it died';
		}
		elsif ($bytes =~ /Broken Pipe/) {

		}
		unless (grep { $bytes =~ /\Q$_\E/ } @printless) {
			print $bytes;
		}
		# the error watch's copy: kept in the master's ring and served over
		# ~/.president/log, so there is no ~/pty.log file to grow or rotate
		JawnOS::LogBus::ring_append($log_ring, $bytes);
  });

	my $this_fork = $fork;
  $fork->on(close => sub () {
		my ($exit_value, $signal) = @_;
		print "closing fork";
		# the tree's own terminal exited: unless the master tore it down for a
		# restart (shut_down marks the fork), it died on its own - recover it rather
		# than leave the tree down
		unless ($this_fork->{'jawn_deliberate'}) {
			print "tree exited on its own (exit=$exit_value signal=$signal) - recovering\n";
			$status = 'frozen';
			$status_why = 'the tree exited on its own (exit=' . (defined $exit_value ? $exit_value : '?') . ' signal=' . (defined $signal ? $signal : '?') . ')';
		}
  });

	$fork->on(drain => sub () {
		my ($fork,$drain) = @_;
		print "drain\n";
	});

	$fork->on(spawn => sub() {
		my ($fork) = @_;
		my $label = $data->{'label'} || $data->{'program'};
		print "fork started " . $label . " k\n";
		print "Starting " . $label . "\n";
		$status = 'started';
		$status_why = '';

	});

	$fork->start({
		program      => $data->{'program'},
		program_args => $data->{'program_args'} || [],
		env          => {
	    %ENV,
	    TERM => 'dumb'
		}
	});


	return $fork;
}

no warnings 'uninitialized';

# Resolve ~ once. The old version shelled out to `echo $HOME` on every call, and
# the master loop below calls this every couple of seconds -- thousands of forks.
my $home_dir;
sub home() {
	my ($inhabitant) = @_;
	unless (defined $home_dir) {
		$home_dir = $ENV{HOME};
		if (!defined $home_dir || $home_dir eq '') {
			$home_dir = (getpwuid($<))[7] || '';
		}
	}
	$inhabitant =~ s/~/$home_dir/;
	return $inhabitant;
}

