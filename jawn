sub terminal_pty_runner() {
	return $fork if $status eq 'starting';
	$status = 'starting';
	my $data = shift;
	if (!$fork) {
		$fork = Mojo::IOLoop::ReadWriteFork->new;
	}
	print 'starting fork' . "\n";

	$fork->conduit({raw => 1, type => "pty"});

  $fork->on(read => sub () {
		my ($fork, $bytes) = @_;

		if ($bytes =~ /Address already in use/) {
			print "already in use!!!! AAAAAAAAAH!\n";
			$status = 'frozen';
		}
		elsif ($bytes =~ /they dead/ || $bytes =~ /President Died/ || $bytes =~ /core dumped/) {
			print "See it's dead\n";
			$status = 'frozen';
		}
		elsif ($bytes =~ /Broken Pipe/) {

		}
		unless (grep { $bytes =~ /\Q$_\E/ } @printless) {
			print $bytes;
		}
  });

  $fork->on(close => sub () {
		my ($fork, $exit_code) = @_;
		print "closing fork";
  });

	$fork->on(drain => sub () {
		my ($fork,$drain) = @_;
		print "drain\n";
	});

	$fork->on(spawn => sub() {
		my ($fork) = @_;
		print "fork started " . $data->{'program'} . " k\n";
		if ($data->{'program'}) {
			print "Starting " . $data->{'program'} . "\n";
			Mojo::IOLoop->timer(0.1 => sub {
				$fork->write($data->{'program'} . "\n");
			});
		}
		$status = 'started';

	});

	$fork->start({
		program => "bash",
		program_args => [ "-i" ],
		env          => {
	    %ENV,
	    INPUTRC => '/dev/null',
	    PROMPT_COMMAND => '',
	    TERM => 'dumb'
		}
	});


	return $fork;
}

