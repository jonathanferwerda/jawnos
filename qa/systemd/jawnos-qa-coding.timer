[Unit]
Description=Nightly JawnOS coding agent
Documentation=file:/home/jawn/jawnos/qa/README.md

[Timer]
# After the 05:00 suite and the 05:30 UX loop. One note at a time, so the run
# can be long; Persistent=true catches up after a missed night.
OnCalendar=*-*-* 06:00:00
Persistent=true
Unit=jawnos-qa-coding.service

[Install]
WantedBy=timers.target
