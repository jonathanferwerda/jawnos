[Unit]
Description=Nightly JawnOS installer package freshness (testing only)

[Timer]
# 03:45, ahead of the 04:30 Docker smoke and the 05:00 suite. It is metadata
# only and needs no Docker or toolchain, so it is not one of the three
# Configure -> Plat -> QA times.
OnCalendar=*-*-* 03:45:00
Persistent=true
RandomizedDelaySec=10m
Unit=jawnos-qa-installers.service

[Install]
WantedBy=timers.target
