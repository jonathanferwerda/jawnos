[Unit]
Description=JawnOS QA suite (fenced route + database layers)
Documentation=file:/home/jawn/jawnos/qa/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jawn
WorkingDirectory=/home/jawn/jawnos
Environment=HOME=/home/jawn
# The relay test needs a writable directory that is not /tmp; the QA root is
# the one path this unit leaves writable.
Environment=JAWNOS_QA_ROOT=/home/jawn/jawnos-qa
# The house's nightly suite runs on the machine chosen in Configure -> Plat ->
# QA. The helper exits 0 for the chosen machine (or when no choice is saved, or
# when this machine cannot read its own identity) and 1 for every other, which
# skips this unit without marking it failed. Install the unit on every machine
# that might be chosen.
ExecCondition=/usr/bin/perl /home/jawn/jawnos/qa/device_target.pl
ExecStartPre=/usr/bin/perl /home/jawn/jawnos/qa/prune.pl --keep 14
ExecStart=/usr/bin/perl /home/jawn/jawnos/qa/run.pl --layers l0,l1,l2 --profile full

# Protect the live house. The runner already uses a copy and its own namespaces;
# this is the second fence. The repo is read-only here, and only the QA root is
# writable. Loopback is all the suite needs: no peers, mail, or model APIs.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryMax=4G
CPUQuota=300%
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/jawn/jawnos-qa
NoNewPrivileges=yes
IPAddressDeny=any
IPAddressAllow=localhost
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
