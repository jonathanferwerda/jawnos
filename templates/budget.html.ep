<% no warnings 'uninitialized'; %>
<div id="budget_<%= $timestamp %>" style="width: 100%; height:100%;background-color:var(--panel);overflow:scroll;">
	<div id="budget_header" style="vertical-align:top;">
		<select class="budget_config" config="display" style="vertical-align:top;">
			<% foreach my $d ( @{$displays} ) { %>
				<option value="<%= $d->[0] %>" <% if ($d->[0] eq $display) { %>selected<% } %>><%= $d->[1] %></option>
			<% } %>
		</select>
		<img src="<%= &subs::icon_for('/images/decipherable/gear.png') %>" hint="Configure" class="little_thumb hover" id="budget_settings_toggle">
		<% if ($display eq 'statement') { %>
			<% if ( scalar keys %{$settings->{$display . '_displays'}} > 0) { %>
				<select id="budget_display" class="budget_config" budget_display="<%= $display %>" config="<%= $display %>_display" style="vertical-align:top;">
					<option value="" <% if ($settings->{$display . '_display'} eq '') { %>selected<% } %>></option>
					<% foreach my $sd ( sort keys %{$settings->{$display . '_displays'}} ) { %>
						<option value="<%= $sd %>" <% if ($sd eq $settings->{$display . '_display'}) { %>selected<% } %>><%= &subs::format_name($sd) %></option>
					<% } %>
				</select>
			<% } %>
		<% } %>
	</div>
	<div id="budget_settings" style="display:none;">
		<span style="float:left;width:30%;" >
			<input placeholder="Graph Increments" class="budget_config" config="increments" value="<%= $settings->{'increments'} || 30 %>" style="width:120px;">
			<select class="budget_config" config="scope" style="">
				<% foreach my $sc ( sort qw/hour day week month year/ ) { %>
					<option value="<%= $sc %>" <% if ($sc eq $scope) { %>selected<% } %>><%= &subs::format_name($sc) %></option>
				<% } %>
			</select>
			<div>
				<input class="time budget_time" setting="start_time" timestamp="<%= $start %>" style="width:120px;">
				<input class="time budget_time" setting="end_time" timestamp="<%= $end %>" style="width:120px;">
				<img src="<%= &subs::icon_for('/images/make believe/key.png') %>" hint="Lock" class="statistic_lock little_thumb hover <% if ($settings->{'s_lock'} eq 'on') { %>selected<% } %>" app="budget" locked="<%= $settings->{'s_lock'} %>">
				<select class="budget_config" config="when_multiplier" style="vertical-align:bottom;" hint="How many periods">
					<% foreach my $count (1..30) { %>
						<option value="<%= $count %>" <% if ($count == $settings->{'when_multiplier'}) { %>selected<% } %>><%= $count %></option>
					<% } %>
				</select>
				<select class="budget_config" config="time_when" style="vertical-align:bottom;" hint="Which period">
					<% foreach my $when ( @{$time_scopes} ) { %>
						<option value="<%= $when %>" <% if ($when eq $settings->{'time_when'}) { %>selected<% } %>><%= &subs::format_name($when) %></option>
					<% } %>
				</select>
			</div>
		</span>
		<span>
			<select class="budget_config" multiple config="columns" style="height:100px; vertical-align:bottom;">
				<option value="all" <% if (grep { $_ eq 'all' } @{$columns}) { %>selected<% } %>><%= &subs::format_name('all') %></option>
				<% foreach my $col ( @{$all_columns} ) { %>
					<option value="<%= $col %>" <% if (grep { $_ eq $col } @{$columns}) { %>selected<% } %>><%= &subs::format_name($col) %></option>
				<% } %>
			</select>
			<select class="budget_config" multiple config="accounts" style="height:100px; vertical-align:bottom;">
				<% foreach my $ac ( @{$all_accounts} ) { %>
					<option value="<%= $ac->{'app'} %>" <% if (grep {$ac->{'app'} eq $_ } @{$account}) { %>selected<% } %>><%= &subs::format_name($ac->{'app'}) %></option>
				<% } %>
			</select>
			<select class="budget_config" multiple config="projects" style="height:100px;vertical-align:bottom;">
				<% foreach my $pr ( @{$all_projects} ) { %>
					<option value="<%= $pr->{'app'} %>" <% if (grep { $pr->{'app'} eq $_ } @{$project}) { %>selected<% } %>><%= &subs::format_name($pr->{'app'}) %></option>
				<% } %>
			</select>
			<select class="budget_config" config="movement" multiple style="height:100px;vertical-align:bottom;">
				<% foreach my $sc ( sort @gb::movements ) { %>
					<option value="<%= $sc %>" <% if (grep { $_ eq $sc } @{$movement}) { %>selected<% } %>><%= &subs::format_name($sc) %></option>
				<% } %>
			</select>
			<% if ($display eq 'statement') { %>
				<input id="budget_display_name" display_type="statement" placeholder="name" style="width:20%;vertical-align:top;" value="<%= $settings->{$display . '_display'} %>">
				<select id="budget_display_categorization" class="budget_config" config="display_categorization" value="<%= $settings->{'display_categorization'} %>">
					<% foreach my $bdc ( qw/app category project account/) { %>
						<option value="<%= $bdc %>" <% if ($bdc eq $settings->{'display_categorization'}) { %>selected<% } %>><%= &subs::format_name($bdc) %></option>
					<% } %>
				</select>
				<img src="<%= &subs::icon_for('/images/decipherable/diskette.png') %>" hint="Save" class="little_thumb hover" id="budget_display_save">
				<img src="<%= &subs::icon_for('/icons/trash.png') %>" hint="Delete" class="little_thumb hover" id="budget_display_delete">
			<% } %>
			<img class="little_thumb hover" id="budget_refresh" src="<%= &subs::icon_for('/images/make believe/renew.png') %>" hint="Refresh">
		</span>
	</div>
	<div>
		<% my ($total_minimum,$total_delta,$total_balance,$total_available); %>
		<b>Count: <%= scalar @{$transactions} %></b>
		<table style="width:100%;border:groove;">
			<thead style="text-align:left;font-size:20px;">
				<th><u>Account</u></th><th><u>Balance</u></th><th><u>Avail</u></th><th><u>Minimum</u></th><th><u>Delta</u></th>
			</thead>
			<tbody>
				<% foreach my $account ( sort keys %{$accounts} ) { %>
					% next if $accounts->{$account}->{'balance'} == 0;
					% $accounts->{$account}->{'settings'}->{'minimum'} = 0 unless $accounts->{$account}->{'settings'}->{'minimum'};
					<% $total_balance = $total_balance + $accounts->{$account}->{'balance'}; %>
					<% $total_minimum = $total_minimum + $accounts->{$account}->{'settings'}->{'minimum'}; %>
					<% my $available = ($accounts->{$account}->{'balance'} - ($accounts->{$account}->{'settings'}->{'minimum'} || 0));
					<% $total_available = $total_available + $available; %>
					<tr>
						<td><b style="color:<%= $accounts->{$account}->{'settings'}->{'colour'} %>;" colour="<%= $accounts->{$account}->{'settings'}->{'colour'} %>" class="hover budget_account" account="<%= $accounts->{$account}->{'app'} %>"><%= &subs::format_name($accounts->{$account}->{'app'}) %></b></td>
						<td><%= &subs::price_formatter($accounts->{$account}->{'balance'}) %></td>
						<td><%= &subs::price_formatter($available) %></td>
						<td><%= &subs::price_formatter($accounts->{$account}->{'settings'}->{'minimum'} || 0) %></td>
						<td><%= &subs::price_formatter($accounts->{$account}->{'delta'} || 0) %></td>
					</tr>
				<% } %>
				<tr style="font-size:18px;">
					<td><b><u class="hover budget_account" account="total" colour="black">Total</u></b></td>
					<td><u><%= &subs::price_formatter($total_balance) %></u></td>
					<td><u><%= &subs::price_formatter($total_available) %></u></td>
					<td><u><%= &subs::price_formatter($total_minimum) %></td>
					<td><u><%= &subs::price_formatter($total_delta) %></td>
				</tr>
			</tbody>
		</table>
	</div>
	<% if ($accounts) { %>
		<canvas style="width:98%;height:200px;display:none;" id="budget_account_canvas"></canvas>
		<div id="budget_account_information" style="display:none;position:fixed;background-color:var(--panel);border:solid;border-radius:5px;"></div>
		<div id="budget_json_data" style="display:none;"></div>
	<% } %>
	<% if ($display eq 'income_statement') { %>
		<h2 style="margin:4px 0;"><%= &subs::ui('Income Statement') %></h2>
		<div style="opacity:.75;"><%= &subs::ui('For the period') %> <b><%= $period_start %></b> <%= &subs::ui('to') %> <b><%= $period_end %></b> &middot; <%= &subs::ui('Accrual basis') %></div>
		<table class="accounting_statement" style="width:100%;border:groove;border-collapse:collapse;margin-top:8px;">
			<thead style="text-align:left;">
				<th><%= &subs::ui('Category') %></th>
				<th style="text-align:right;"><%= &subs::ui('This period') %></th>
				<th style="text-align:right;"><%= &subs::ui('Prior period') %></th>
			</thead>
			<tbody>
				<tr><th colspan="3" style="text-align:left;border-top:2px solid;"><%= &subs::ui('Income') %></th></tr>
				<% foreach my $r ( @{$reports->{'income'} || []} ) { %>
					<tr><td><%= &subs::format_name($r->{'name'} || $r->{'app'}) %></td><td style="text-align:right;"><%= &subs::price_formatter($r->{'amount'}) %></td><td style="text-align:right;opacity:.75;"><%= &subs::price_formatter($r->{'prior'}) %></td></tr>
				<% } %>
				<tr><td><b><%= &subs::ui('Total income') %></b></td><td style="text-align:right;border-top:1px solid;"><b><%= &subs::price_formatter($reports->{'income_total'}) %></b></td><td style="text-align:right;border-top:1px solid;"><%= &subs::price_formatter($reports->{'prior_income_total'}) %></td></tr>
				<% if (scalar @{$reports->{'cogs'} || []}) { %>
					<tr><th colspan="3" style="text-align:left;border-top:2px solid;"><%= &subs::ui('Cost of goods sold') %></th></tr>
					<% foreach my $r ( @{$reports->{'cogs'} || []} ) { %>
						<tr><td><%= &subs::format_name($r->{'name'}) %></td><td style="text-align:right;"><%= &subs::price_formatter($r->{'amount'}) %></td><td style="text-align:right;opacity:.75;"><%= &subs::price_formatter($r->{'prior'}) %></td></tr>
					<% } %>
					<tr><td><b><%= &subs::ui('Total cost of goods sold') %></b></td><td style="text-align:right;border-top:1px solid;"><b><%= &subs::price_formatter($reports->{'cogs_total'}) %></b></td><td style="text-align:right;border-top:1px solid;"><%= &subs::price_formatter($reports->{'prior_cogs_total'}) %></td></tr>
					<tr><td style="font-size:115%;"><b><%= &subs::ui('Gross profit') %></b></td><td style="text-align:right;border-top:3px double;"><b><%= &subs::price_formatter($reports->{'gross_profit'}) %></b></td><td style="text-align:right;border-top:3px double;"><b><%= &subs::price_formatter($reports->{'prior_gross_profit'}) %></b></td></tr>
				<% } %>
				<tr><th colspan="3" style="text-align:left;border-top:2px solid;"><%= &subs::ui('Expenses') %></th></tr>
				<% foreach my $r ( @{$reports->{'expense'} || []} ) { %>
					<tr><td><%= &subs::format_name($r->{'name'} || $r->{'app'}) %></td><td style="text-align:right;"><%= &subs::price_formatter($r->{'amount'}) %></td><td style="text-align:right;opacity:.75;"><%= &subs::price_formatter($r->{'prior'}) %></td></tr>
				<% } %>
				<tr><td><b><%= &subs::ui('Total expenses') %></b></td><td style="text-align:right;border-top:1px solid;"><b><%= &subs::price_formatter($reports->{'expense_total'}) %></b></td><td style="text-align:right;border-top:1px solid;"><%= &subs::price_formatter($reports->{'prior_expense_total'}) %></td></tr>
				<tr><td style="font-size:120%;"><b><%= &subs::ui('Net income') %></b></td><td style="text-align:right;border-top:3px double;"><b><%= &subs::price_formatter($reports->{'net_income'}) %></b></td><td style="text-align:right;border-top:3px double;"><b><%= &subs::price_formatter($reports->{'prior_net_income'}) %></b></td></tr>
			</tbody>
		</table>
		<% if (($reports->{'tax_in'} || 0) != 0 || ($reports->{'tax_out'} || 0) != 0) { %>
			<div style="opacity:.7;margin-top:6px;"><%= &subs::ui('Tax included') %>: <%= &subs::ui('collected') %> <%= &subs::price_formatter($reports->{'tax_in'}) %> &middot; <%= &subs::ui('paid') %> <%= &subs::price_formatter($reports->{'tax_out'}) %></div>
		<% } %>
	<% } elsif ($display eq 'balance_sheet') { %>
		<h2 style="margin:4px 0;"><%= &subs::ui('Balance Sheet') %></h2>
		<div style="opacity:.75;"><%= &subs::ui('As of') %> <b><%= $period_end %></b> &middot; <%= &subs::ui('Accrual basis') %></div>
		<table class="accounting_statement" style="width:100%;border:groove;border-collapse:collapse;margin-top:8px;">
			<tbody>
				<tr><th colspan="2" style="text-align:left;border-bottom:2px solid;"><%= &subs::ui('Assets') %></th></tr>
				<% foreach my $r ( @{$reports->{'assets'} || []} ) { %>
					<tr><td><%= &subs::format_name($r->{'name'} || $r->{'app'}) %></td><td style="text-align:right;"><%= &subs::price_formatter($r->{'balance'}) %></td></tr>
				<% } %>
				<tr><td><%= &subs::ui('Accounts receivable') %> <span style="opacity:.6;">(<%= $reports->{'receivables'}->{'count'} || 0 %> <%= &subs::ui('open') %>)</span></td><td style="text-align:right;"><%= &subs::price_formatter($reports->{'receivables_balance'} || 0) %></td></tr>
				<tr><td><b><%= &subs::ui('Total assets') %></b></td><td style="text-align:right;border-top:1px solid;"><b><%= &subs::price_formatter($reports->{'assets_total'}) %></b></td></tr>
				<tr><th colspan="2" style="text-align:left;border-bottom:2px solid;"><%= &subs::ui('Liabilities') %></th></tr>
				<% foreach my $r ( @{$reports->{'liabilities'} || []} ) { %>
					<tr><td><%= &subs::format_name($r->{'name'} || $r->{'app'}) %></td><td style="text-align:right;"><%= &subs::price_formatter($r->{'balance'}) %></td></tr>
				<% } %>
				<% unless (scalar @{$reports->{'liabilities'} || []}) { %>
					<tr><td colspan="2" style="opacity:.6;"><%= &subs::ui('None') %></td></tr>
				<% } %>
				<tr><td><b><%= &subs::ui('Total liabilities') %></b></td><td style="text-align:right;border-top:1px solid;"><b><%= &subs::price_formatter($reports->{'liabilities_total'}) %></b></td></tr>
				<tr><th colspan="2" style="text-align:left;border-bottom:2px solid;"><%= &subs::ui('Equity') %></th></tr>
				<tr><td><%= &subs::ui('Equity (net assets)') %></td><td style="text-align:right;"><%= &subs::price_formatter($reports->{'equity'}) %></td></tr>
				<tr><td><b><%= &subs::ui('Total liabilities and equity') %></b></td><td style="text-align:right;border-top:3px double;"><b><%= &subs::price_formatter($reports->{'liabilities_total'} + $reports->{'equity'}) %></b></td></tr>
			</tbody>
		</table>
		<div style="opacity:.65;margin-top:6px;max-width:70%;"><%= &subs::ui('Equity is what is left of the assets once the liabilities are taken off. The balance sheet is read from the double-entry journal, so every line is an account balance and it agrees with the Trial Balance.') %></div>
	<% } elsif ($display eq 'cash_flow') { %>
		<h2 style="margin:4px 0;"><%= &subs::ui('Cash Flow') %></h2>
		<div style="opacity:.75;"><%= &subs::ui('For the period') %> <b><%= $period_start %></b> <%= &subs::ui('to') %> <b><%= $period_end %></b> &middot; <%= &subs::ui('Cash basis') %></div>
		<table class="accounting_statement" style="width:100%;border:groove;border-collapse:collapse;margin-top:8px;">
			<thead style="text-align:left;">
				<th></th>
				<th style="text-align:right;"><%= &subs::ui('This period') %></th>
				<th style="text-align:right;"><%= &subs::ui('Prior period') %></th>
			</thead>
			<tbody>
				<tr><th colspan="3" style="text-align:left;border-top:2px solid;"><%= &subs::ui('Operating') %></th></tr>
				<tr><td><%= &subs::ui('Receipts') %></td><td style="text-align:right;"><%= &subs::price_formatter($reports->{'cash'}->{'in'}) %></td><td style="text-align:right;opacity:.75;"><%= &subs::price_formatter($reports->{'cash'}->{'prior_in'}) %></td></tr>
				<tr><td><%= &subs::ui('Payments') %></td><td style="text-align:right;"><%= &subs::price_formatter(-$reports->{'cash'}->{'out'}) %></td><td style="text-align:right;opacity:.75;"><%= &subs::price_formatter(-$reports->{'cash'}->{'prior_out'}) %></td></tr>
				<tr><td><b><%= &subs::ui('Net cash from operations') %></b></td><td style="text-align:right;border-top:1px solid;"><b><%= &subs::price_formatter($reports->{'cash'}->{'in'} - $reports->{'cash'}->{'out'}) %></b></td><td style="text-align:right;border-top:1px solid;"><%= &subs::price_formatter($reports->{'cash'}->{'prior_in'} - $reports->{'cash'}->{'prior_out'}) %></td></tr>
				<tr><th colspan="3" style="text-align:left;border-top:2px solid;"><%= &subs::ui('Transfers and adjustments') %></th></tr>
				<tr><td><%= &subs::ui('Transfers between accounts (net)') %></td><td style="text-align:right;"><%= &subs::price_formatter($reports->{'cash'}->{'transfers'}) %></td><td style="text-align:right;opacity:.75;"><%= &subs::price_formatter($reports->{'cash'}->{'prior_transfers'}) %></td></tr>
				<tr><td><%= &subs::ui('Balance adjustments (inventory)') %></td><td style="text-align:right;"><%= &subs::price_formatter($reports->{'cash'}->{'adjustment'}) %></td><td style="text-align:right;opacity:.75;"><%= &subs::price_formatter($reports->{'cash'}->{'prior_adjustment'}) %></td></tr>
				<tr><td><b><%= &subs::ui('Net change in cash') %></b></td><td style="text-align:right;border-top:1px solid;"><b><%= &subs::price_formatter($reports->{'cash'}->{'change'}) %></b></td><td style="text-align:right;border-top:1px solid;"><%= &subs::price_formatter($reports->{'cash'}->{'prior_change'}) %></td></tr>
				<tr><td><%= &subs::ui('Opening cash (net of overdrafts)') %></td><td style="text-align:right;"><%= &subs::price_formatter($reports->{'cash'}->{'opening'}) %></td><td style="text-align:right;opacity:.75;"><%= &subs::price_formatter($reports->{'cash'}->{'prior_opening'}) %></td></tr>
				<tr><td><b><%= &subs::ui('Closing cash (net of overdrafts)') %></b></td><td style="text-align:right;border-top:3px double;"><b><%= &subs::price_formatter($reports->{'cash'}->{'closing'}) %></b></td><td style="text-align:right;border-top:3px double;"><%= &subs::price_formatter($reports->{'cash'}->{'prior_closing'}) %></td></tr>
			</tbody>
		</table>
		<div style="opacity:.65;margin-top:6px;max-width:70%;"><%= &subs::ui('A transfer between two of the house accounts moves cash without changing the total; a balance adjustment is an inventory figure replacing what the ledger had.') %></div>
	<% } elsif ($display eq 'account_activity') { %>
		<h2 style="margin:4px 0;"><%= &subs::ui('Account Activity') %></h2>
		<div style="opacity:.75;"><%= &subs::ui('For the period') %> <b><%= $period_start %></b> <%= &subs::ui('to') %> <b><%= $period_end %></b> &middot; <%= &subs::ui('Cash basis') %></div>
		<table class="accounting_statement" style="width:100%;border:groove;border-collapse:collapse;margin-top:8px;">
			<thead style="text-align:left;">
				<th><%= &subs::ui('Account') %></th>
				<th style="text-align:right;"><%= &subs::ui('Opening') %></th>
				<th style="text-align:right;"><%= &subs::ui('Receipts') %></th>
				<th style="text-align:right;"><%= &subs::ui('Payments') %></th>
				<th style="text-align:right;"><%= &subs::ui('Transfers') %></th>
				<th style="text-align:right;"><%= &subs::ui('Closing') %></th>
			</thead>
			<tbody>
				<% foreach my $r ( @{$reports->{'activity'} || []} ) { %>
					<tr><td><%= &subs::format_name($r->{'app'}) %></td><td style="text-align:right;"><%= &subs::price_formatter($r->{'opening'}) %></td><td style="text-align:right;"><%= &subs::price_formatter($r->{'in'}) %></td><td style="text-align:right;"><%= &subs::price_formatter(-$r->{'out'}) %></td><td style="text-align:right;"><%= &subs::price_formatter($r->{'transfer'}) %></td><td style="text-align:right;"><b><%= &subs::price_formatter($r->{'closing'}) %></b></td></tr>
				<% } %>
				<tr><td><b><%= &subs::ui('Total') %></b></td><td style="text-align:right;border-top:1px solid;"><b><%= &subs::price_formatter($reports->{'activity_totals'}->{'opening'}) %></b></td><td style="text-align:right;border-top:1px solid;"><b><%= &subs::price_formatter($reports->{'activity_totals'}->{'in'}) %></b></td><td style="text-align:right;border-top:1px solid;"><b><%= &subs::price_formatter(-$reports->{'activity_totals'}->{'out'}) %></b></td><td style="text-align:right;border-top:1px solid;"><b><%= &subs::price_formatter($reports->{'activity_totals'}->{'transfer'}) %></b></td><td style="text-align:right;border-top:1px solid;"><b><%= &subs::price_formatter($reports->{'activity_totals'}->{'closing'}) %></b></td></tr>
			</tbody>
		</table>
	<% } elsif ($display eq 'receivables') { %>
		<h2 style="margin:4px 0;"><%= &subs::ui('Receivables') %></h2>
		<div style="opacity:.75;"><%= &subs::ui('Aged from the invoice date') %> &middot; <%= &subs::ui('As of') %> <b><%= $period_end %></b></div>
		<table class="accounting_statement" style="width:100%;border:groove;border-collapse:collapse;margin-top:8px;">
			<thead style="text-align:left;">
				<th><%= &subs::ui('Customer') %></th>
				<th><%= &subs::ui('Invoice') %></th>
				<th><%= &subs::ui('Issued') %></th>
				<th style="text-align:right;"><%= &subs::ui('Age (days)') %></th>
				<th style="text-align:right;"><%= &subs::ui('Total') %></th>
				<th style="text-align:right;"><%= &subs::ui('Paid') %></th>
				<th style="text-align:right;"><%= &subs::ui('Balance') %></th>
				<th><%= &subs::ui('Ageing') %></th>
			</thead>
			<tbody>
				<% foreach my $r ( @{$reports->{'receivables'}->{'rows'} || []} ) { %>
					<tr><td><%= &subs::format_name($r->{'app'}) %></td><td><%= $r->{'id'} %></td><td><span class="time" timestamp="<%= $r->{'timestamp'} %>"></span></td><td style="text-align:right;"><%= $r->{'age'} %></td><td style="text-align:right;"><%= &subs::price_formatter($r->{'total'}) %></td><td style="text-align:right;"><%= &subs::price_formatter($r->{'paid'}) %></td><td style="text-align:right;"><b><%= &subs::price_formatter($r->{'balance'}) %></b></td><td><%= &subs::format_name($r->{'bucket'}) %></td></tr>
				<% } %>
				<tr><td colspan="6"><b><%= &subs::ui('Total') %></b></td><td style="text-align:right;border-top:1px solid;"><b><%= &subs::price_formatter($reports->{'receivables'}->{'total'}) %></b></td><td></td></tr>
			</tbody>
		</table>
		<table style="margin-top:8px;border:groove;">
			<tr><th style="text-align:left;"><%= &subs::ui('Ageing') %></th><th style="text-align:right;"><%= &subs::ui('Balance') %></th></tr>
			<% foreach my $b ( qw/current 31_60 61_90 over_90/ ) { %>
				<tr><td><%= &subs::format_name($b eq 'current' ? 'current (0-30)' : $b eq '31_60' ? '31-60 days' : $b eq '61_90' ? '61-90 days' : 'over 90 days') %></td><td style="text-align:right;"><%= &subs::price_formatter($reports->{'receivables'}->{'buckets'}->{$b}) %></td></tr>
			<% } %>
		</table>
	<% } elsif ($display eq 'payables') { %>
		<h2 style="margin:4px 0;"><%= &subs::ui('Payables') %></h2>
		<div style="opacity:.75;"><%= &subs::ui('Aged from the bill date') %> &middot; <%= &subs::ui('As of') %> <b><%= $period_end %></b> &middot; <%= $payables->{'count'} || 0 %> <%= &subs::ui('open') %> &middot; <%= $payables->{'paid_count'} || 0 %> <%= &subs::ui('paid') %></div>
		<% if (scalar @{$notification_booked || []}) { %>
			<h3 style="margin-bottom:4px;"><%= &subs::ui('Booked from notifications') %></h3>
			<div style="opacity:.7;margin-bottom:4px;"><%= &subs::ui('A notification from a bank that names a payment is booked as a bill and paid from the account it came from, with no press. Undo removes it and leaves that notification unbooked.') %></div>
			<table class="accounting_statement" style="width:100%;border:groove;border-collapse:collapse;">
				<thead style="text-align:left;">
					<th><%= &subs::ui('Date') %></th>
					<th><%= &subs::ui('Merchant') %></th>
					<th style="text-align:right;"><%= &subs::ui('Amount') %></th>
					<th><%= &subs::ui('App') %></th>
					<th><%= &subs::ui('Paid from') %></th>
					<th></th>
				</thead>
				<tbody>
					<% foreach my $n ( @{$notification_booked || []} ) { %>
						<tr class="budget_note_row" uuid="<%= $n->{'uuid'} %>">
							<td><span class="time" timestamp="<%= $n->{'timestamp'} %>"></span></td>
							<td><%= &subs::format_name($n->{'vendor'} || $n->{'app'}) %></td>
							<td style="text-align:right;"><%= &subs::price_formatter($n->{'total'}) %></td>
							<td><%= &subs::format_name($n->{'app'}) %></td>
							<td><% if ($n->{'pay_account'}) { %><%= &subs::format_name($n->{'pay_account'}) %><% } else { %><%= &subs::ui('Still owed') %><% } %></td>
							<td style="white-space:nowrap;"><button class="budget_payable_delete" uuid="<%= $n->{'uuid'} %>" hint="<%= &subs::lang('common.undo') %>"><%= &subs::lang('common.undo') %></button></td>
						</tr>
					<% } %>
				</tbody>
			</table>
		<% } %>
		<table class="accounting_statement" style="width:100%;border:groove;border-collapse:collapse;margin-top:8px;">
			<thead style="text-align:left;">
				<th><%= &subs::ui('Vendor') %></th>
				<th><%= &subs::ui('App') %></th>
				<th><%= &subs::ui('Item') %></th>
				<th><%= &subs::ui('Bill date') %></th>
				<th style="text-align:right;"><%= &subs::ui('Age (days)') %></th>
				<th style="text-align:right;"><%= &subs::ui('Total') %></th>
				<th style="text-align:right;"><%= &subs::ui('Paid') %></th>
				<th style="text-align:right;"><%= &subs::ui('Balance') %></th>
				<th><%= &subs::ui('Ageing') %></th>
				<th><%= &subs::ui('Pay') %></th>
			</thead>
			<tbody>
				<% foreach my $r ( @{$payables->{'rows'} || []} ) { %>
					<tr class="budget_payable_row" uuid="<%= $r->{'uuid'} %>">
						<td><%= &subs::format_name($r->{'vendor'} || $r->{'app'}) %></td>
						<td><%= &subs::format_name($r->{'app'}) %></td>
						<td><%= &subs::format_name($r->{'item'}) %></td>
						<td><span class="time" timestamp="<%= $r->{'timestamp'} %>"></span></td>
						<td style="text-align:right;"><%= $r->{'age'} %></td>
						<td style="text-align:right;"><%= &subs::price_formatter($r->{'total'}) %></td>
						<td style="text-align:right;"><%= &subs::price_formatter($r->{'paid'}) %></td>
						<td style="text-align:right;"><b><%= &subs::price_formatter($r->{'balance'}) %></b></td>
						<td><%= &subs::format_name($r->{'bucket'}) %></td>
						<td style="white-space:nowrap;">
							<select class="budget_payable_account" hint="<%= &subs::ui('Pay from') %>">
								<% foreach my $ac ( @{$all_accounts} ) { %>
									% next if $ac->{'app'} eq 'all' || $ac->{'app'} eq 'gallery';
									<option value="<%= $ac->{'app'} %>"><%= &subs::format_name($ac->{'app'}) %></option>
								<% } %>
							</select>
							<input class="budget_payable_amount" value="<%= sprintf('%.2f', $r->{'balance'}) %>" style="width:80px;" hint="<%= &subs::ui('Amount') %>">
							<button class="budget_payable_pay" uuid="<%= $r->{'uuid'} %>"><%= &subs::ui('Pay') %></button>
							<button class="budget_payable_delete" uuid="<%= $r->{'uuid'} %>" hint="<%= &subs::ui('Delete') %>">&times;</button>
						</td>
					</tr>
				<% } %>
				<tr><td colspan="7"><b><%= &subs::ui('Total') %></b></td><td style="text-align:right;border-top:1px solid;"><b><%= &subs::price_formatter($payables->{'total'}) %></b></td><td></td><td></td></tr>
			</tbody>
		</table>
		<table style="margin-top:8px;border:groove;">
			<tr><th style="text-align:left;"><%= &subs::ui('Ageing') %></th><th style="text-align:right;"><%= &subs::ui('Balance') %></th></tr>
			<% foreach my $b ( qw/current 31_60 61_90 over_90/ ) { %>
				<tr><td><%= &subs::format_name($b eq 'current' ? 'current (0-30)' : $b eq '31_60' ? '31-60 days' : $b eq '61_90' ? '61-90 days' : 'over 90 days') %></td><td style="text-align:right;"><%= &subs::price_formatter($payables->{'buckets'}->{$b}) %></td></tr>
			<% } %>
		</table>
		<h3 style="margin-bottom:4px;"><%= &subs::ui('Record a bill') %></h3>
		<div style="margin-bottom:6px;">
			<input id="budget_payable_vendor" placeholder="<%= &subs::ui('Vendor') %>" style="width:16%;">
			<input id="budget_payable_app" list="budget_payable_apps" placeholder="<%= &subs::ui('App') %>" style="width:14%;">
			<input id="budget_payable_item" placeholder="<%= &subs::ui('Item') %>" style="width:14%;">
			<input id="budget_payable_total" placeholder="<%= &subs::ui('Total') %>" style="width:9%;">
			<input id="budget_payable_tax" placeholder="<%= &subs::ui('Tax') %>" style="width:8%;">
			<input id="budget_payable_date" placeholder="YYYY-MM-DD" value="<%= POSIX::strftime('%Y-%m-%d', localtime) %>" style="width:11%;">
			<select id="budget_payable_repeat" hint="<%= &subs::ui('Repeat') %>">
				<option value="once"><%= &subs::ui('Once') %></option>
				<option value="weekly"><%= &subs::ui('Every week') %></option>
				<option value="2weeks"><%= &subs::ui('Every 2 weeks') %></option>
				<option value="30days"><%= &subs::ui('Every 30 days') %></option>
				<option value="monthly"><%= &subs::ui('Every month') %></option>
				<option value="quarterly"><%= &subs::ui('Every quarter') %></option>
				<option value="yearly"><%= &subs::ui('Every year') %></option>
			</select>
			<button id="budget_payable_add"><%= &subs::ui('Add bill') %></button>
			<span id="budget_payable_message"></span>
		</div>
		<datalist id="budget_payable_apps">
			<% foreach my $pa ( @{$payable_apps || []} ) { %><option value="<%= $pa %>"><% } %>
		</datalist>
		<h3 style="margin-bottom:4px;"><%= &subs::ui('Scheduled bills') %></h3>
		<% if (scalar @{$schedules || []}) { %>
			<table class="accounting_statement" style="width:100%;border:groove;border-collapse:collapse;">
				<thead style="text-align:left;">
					<th><%= &subs::ui('Vendor') %></th>
					<th><%= &subs::ui('App') %></th>
					<th style="text-align:right;"><%= &subs::ui('Amount') %></th>
					<th><%= &subs::ui('Repeats') %></th>
					<th><%= &subs::ui('Next bill') %></th>
					<th></th>
				</thead>
				<tbody>
					<% my %repeat_label = ( once => 'Once', weekly => 'Every week', '2weeks' => 'Every 2 weeks', '30days' => 'Every 30 days', monthly => 'Every month', quarterly => 'Every quarter', yearly => 'Every year' ); %>
					<% foreach my $s ( @{$schedules || []} ) { %>
						<tr class="budget_schedule_row" uuid="<%= $s->{'uuid'} %>">
							<td><%= &subs::format_name($s->{'vendor'}) %></td>
							<td><%= &subs::format_name($s->{'app'}) %></td>
							<td style="text-align:right;"><%= &subs::price_formatter($s->{'amount'}) %></td>
							<td><%= &subs::ui($repeat_label{$s->{'every'} || 'monthly'} || 'Every month') %></td>
							<td><span class="time" timestamp="<%= $s->{'next'} %>"></span><% if (($s->{'active'} || 'on') eq 'off') { %> <span style="opacity:.6;">(<%= &subs::ui('paused') %>)</span><% } %></td>
							<td style="white-space:nowrap;">
								<button class="budget_schedule_toggle" uuid="<%= $s->{'uuid'} %>"><%= &subs::ui(($s->{'active'} || 'on') eq 'off' ? 'Resume' : 'Pause') %></button>
								<button class="budget_schedule_delete" uuid="<%= $s->{'uuid'} %>" hint="<%= &subs::ui('Delete') %>">&times;</button>
							</td>
						</tr>
					<% } %>
				</tbody>
			</table>
		<% } else { %>
			<div style="opacity:.6;"><%= &subs::ui('None') %></div>
		<% } %>
		<div style="opacity:.65;margin-top:6px;max-width:75%;"><%= &subs::ui('A bill is money owed, not money moved: the expense and the payable are booked when the bill is entered, and paying it moves the payable to the bank account. The payables account is the credit side the trial balance carries.') %></div>
	<% } elsif ($display eq 'trial_balance') { %>
		<h2 style="margin:4px 0;"><%= &subs::ui('Trial Balance') %></h2>
		<div style="opacity:.75;"><%= &subs::ui('As of') %> <b><%= $period_end %></b> &middot; <%= &subs::ui('Double entry, cash basis with receivables') %> &middot; <%= $trial->{'entries'} || 0 %> <%= &subs::ui('entries') %></div>
		<div style="margin:6px 0;"><button id="budget_journal_rebuild"><%= &subs::ui('Rebuild journal') %></button> <span id="budget_journal_message"></span></div>
		<table class="accounting_statement" style="width:100%;border:groove;border-collapse:collapse;">
			<thead style="text-align:left;">
				<th><%= &subs::ui('Code') %></th>
				<th><%= &subs::ui('Account') %></th>
				<th><%= &subs::ui('Type') %></th>
				<th style="text-align:right;"><%= &subs::ui('Debit') %></th>
				<th style="text-align:right;"><%= &subs::ui('Credit') %></th>
			</thead>
			<tbody>
				<% foreach my $r ( @{$trial->{'lines'} || []} ) { %>
					<tr><td><%= $r->{'code'} %></td><td><%= $r->{'name'} %></td><td><%= &subs::format_name($r->{'type'}) %></td><td style="text-align:right;"><%= $r->{'debit'} ? &subs::price_formatter($r->{'debit'}) : '' %></td><td style="text-align:right;"><%= $r->{'credit'} ? &subs::price_formatter($r->{'credit'}) : '' %></td></tr>
				<% } %>
				<tr><td colspan="3"><b><%= &subs::ui('Total') %></b></td><td style="text-align:right;border-top:3px double;"><b><%= &subs::price_formatter($trial->{'debit_total'}) %></b></td><td style="text-align:right;border-top:3px double;"><b><%= &subs::price_formatter($trial->{'credit_total'}) %></b></td></tr>
			</tbody>
		</table>
		<% if (abs($trial->{'difference'} || 0) < 0.005) { %>
			<div style="color:green;font-weight:700;margin-top:6px;"><%= &subs::ui('Debits equal credits.') %></div>
		<% } else { %>
			<div style="color:red;font-weight:700;margin-top:6px;"><%= &subs::ui('Out of balance by') %> <%= &subs::price_formatter($trial->{'difference'}) %></div>
		<% } %>
		<div style="opacity:.65;margin-top:6px;max-width:75%;"><%= &subs::ui('Every money move posts once with its other side: a bank account against the app that earned or spent it, an invoice against receivables, and a transfer against the other account. The clearing line is money moved to an account whose leg was not recorded.') %></div>
	<% } elsif ($display eq 'statement') { %>
		<table style="width:100%;border:groove;">
			<% foreach my $d (qw/income expense transfer/) { %>
				<thead>
					<tr></tr>
					<tr><th colspan=<%= @{$columns} %> style="text-align:center;font-size:26px;"><%= &subs::format_name($d) %></th></tr>
					<% foreach my $col ( @{$columns} ) { %>
						<% unless ($col eq 'all') { %>
							<th><%= &subs::format_name($col) %></th>
						<% } %>
					<% } %>
				</thead>
				<tbody>
					<% foreach my $app ( sort keys %{$tally} ) { %>
						<% if (eval {scalar @{$tally->{$app}->{$d}}} > 0) { %>
							<tr class="budget_row" movement="<%= $d %>" status="closed" app="<%= $app %>" style="font-size:20px;background-color:<%= $tally->{$app}->{'settings'}->{'colour'} %>;"></u>
								<% if (grep { $_ eq 'app' } @{$columns}) { %>
									<td class="hover"><u><%= &subs::format_name($app) %></u></td>
								<% } %>
								<% if (grep { $_ eq 'when' } @{$columns}) { %>
									<td><span class="time" timestamp="<%= $tally->{$app}->{$d}->[0]->{'timestamp'} %>"></span></td>
								<% } %>
								<% if (grep { $_ eq 'occurences' } @{$columns}) { %>
									<td style="background-color:<%= $tally->{$app}->{'budget'}->{'occurences'}->{'colour'} %>"><span><%= $tally->{$app}->{'totals'}->{'occurences'} %></span></td>
								<% } %>
								<% if (grep { $_ eq 'occurence_budget' } @{$columns}) { %>
									<td><%= $tally->{$app}->{'budget'}->{'occurences'}->{'formatted_budget'} %></td>
								<% } %>
								<% if (grep { $_ eq 'duration' } @{$columns}) { %>
									<td style="background-color:<%= $tally->{$app}->{'budget'}->{'duration'}->{'colour'} %>" ><%= &subs::duration_sayer($tally->{$app}->{'totals'}->{'duration'} / 1000) %></td>
								<% } %>
								<% if (grep { $_ eq 'duration_budget' } @{$columns}) { %>
									<td><%= $tally->{$app}->{'budget'}->{'duration'}->{'formatted_budget'} %></td>
								<% } %>
								<% if (grep { $_ eq 'duration_percent' } @{$columns}) { %>
									<td><%= abs &subs::percent_formatter($tally->{$app}->{'totals'}->{$d}->{'duration'} / $total_duration) %></td>
								<% } %>
								<% if (grep { $_ eq 'total_budget' } @{$columns}) { %>
									<td><%= $tally->{$app}->{'budget'}->{'total'}->{'formatted_budget'} %></td>
								<% } %>
								<% if (grep { $_ eq 'manufacturer' } @{$columns}) { %>
									<td><%= &subs::format_name($tally->{$app}->{'budget'}->{'total'}->{$d}->{'manufacturer'}) %></td>
								<% } %>
								<% if (grep { $_ eq 'item' } @{$columns}) { %>
									<td><%= &subs::format_name($tally->{$app}->{'budget'}->{'total'}->{$d}->{'item'}) %></td>
								<% } %>
								<% if (grep { $_ eq 'vendor' } @{$columns}) { %>
									<td><%= &subs::format_name($tally->{$app}->{'budget'}->{'total'}->{$d}->{'vendor'}) %></td>
								<% } %>
								<% if (grep { $_ eq 'account' } @{$columns}) { %>
									<td></td>
								<% } %>
								<% if (grep { $_ eq 'project' } @{$columns}) { %>
									<td></td>
								<% } %>
								<% foreach my $cash ( @{$dollas} ) { %>
									<% if (grep { $_ eq $cash } @{$columns}) { %>
										<td  style="background-color:<%= $tally->{$app}->{'budget'}->{'total'}->{'colour'} %>"><%= &subs::price_formatter($tally->{$app}->{'totals'}->{$d}->{$cash}) %></td>
									<% } %>
								<% } %>
							</tr>
							<% foreach my $t ( @{$tally->{$app}->{$d}} ) { %>
								<tr class="budget_detail_row" filter="<%= $t->{'type'} %>" timestamp="<%= $t->{'timestamp'} %>" server_time="<%= $t->{'server_time'} %>"
									movement="<%= $d %>" app="<%= $app %>" style="display:none;font-size:18px;background-color:<%= $tally->{$t->{'app'}}->{'settings'}->{'colour'} %>;">
									<% if (grep { $_ eq 'app' } @{$columns}) { %>
										<td class="budget_app hover" app="<%= $app %>"><%= &subs::format_name($t->{'app'}) %></td>
									<% } %>
									<% if (grep { $_ eq 'when' } @{$columns}) { %>
										<td><span class="time" timestamp="<%= $t->{'timestamp'} %>"></span></td>
									<% } %>
									<% if (grep { $_ eq 'occurences' } @{$columns}) { %>
										<td><span><%= $t->{'occurences'} %></span></td>
									<% } %>
									<% if (grep { $_ eq 'occurence_budget' } @{$columns}) { %>
										<td></td>
									<% } %>
									<% if (grep { $_ eq 'duration' } @{$columns}) { %>
										<td><%= &subs::duration_sayer($t->{'duration'} / 1000) %></td>
									<% } %>
									<% if (grep { $_ eq 'duration_budget' } @{$columns}) { %>
										<td></td>
									<% } %>
									<% if (grep { $_ eq 'duration_percent' } @{$columns}) { %>
										<td><%= abs &subs::percent_formatter($t->{'duration'} / $total_duration) %></td>
									<% } %>
									<% if (grep { $_ eq 'total_budget' } @{$columns}) { %>
										<td></td>
									<% } %>
									<% if (grep { $_ eq 'manufacturer' } @{$columns}) { %>
										<td><%= &subs::format_name($t->{'manufacturer'}) %></td>
									<% } %>
									<% if (grep { $_ eq 'item' } @{$columns}) { %>
										<td><%= &subs::format_name($t->{'item'}) %></td>
									<% } %>
									<% if (grep { $_ eq 'vendor' } @{$columns}) { %>
										<td><%= &subs::format_name($t->{'vendor'}) %></td>
									<% } %>
									<% if (grep { $_ eq 'account' } @{$columns}) { %>
										<td><%= &subs::format_name($t->{'account'}) %></td>
									<% } %>
									<% if (grep { $_ eq 'project' } @{$columns}) { %>
										<td><%= &subs::format_name($t->{'project'}) %></td>
									<% } %>
									<% foreach my $cash (@{$dollas}) { %>
										<% if (grep { $_ eq $cash } @{$columns}) { %>
											<td><%= &subs::price_formatter($t->{$cash}) %></td>
										<% } %>
									<% } %>
								</tr>
							<% } %>
						<% } %>
					<% } %>
					<tr style="font-size:24px;">
						<td><b>Total <%= &subs::format_name($d) %></u></b></td>
						<% foreach my $col ( @{$columns} ) { %>
							<% unless ($col eq 'app') { %>
								<td><b><u>
									<% if (grep { $_ eq $col } @{$dollas}) { %>
										<%= &subs::price_formatter($totals->{$d}->{$col}) %>
									<% } else { %>
										<%= $totals->{$d}->{$col} %>
									<% } %>
								</u></b></td>
							<% } %>
						<% } %>
					</tr>
				</tbody>
				<% } %>
					<tr style="font-size:26px;">
						<td><b>Total</u></b></td>
						<% foreach my $col ( @{$columns} ) { %>
							<% unless ($col eq 'app') { %>
								<td style="border-bottom: 3px double;">
									<b>
										<% if (grep { $_ eq $col } @{$dollas}) { %>
											<u><%= &subs::price_formatter($totals->{'total'}->{$col}) %></u>
										<% } elsif (grep { $_ eq $col } qw/duration/) { %>
											<%= &subs::duration_sayer($totals->{'total'}->{$col} / 1000) %>
										<% } else { %>
											<%= $totals->{'total'}->{$col} %>
										<% } %>
									</b>
								</td>
							<% } %>
						<% } %>
					</tr>
				</tbody>
		</table>

	<% } elsif ($display eq 'daily_sheet') { %>
		<table style="width:100%;">
			<thead><th>Cat</th><th>App</th><% foreach my $d ( @{$dollas} ) { %><th><%= &subs::format_name($d) %></th><% } %></thead>
			<tbody>
				<% my $starter = {}; %>
				<% foreach my $cat ( sort { $a cmp $b } keys %{$categories} ) { %>
					<% foreach my $ca ( grep { $_ ne 'info' } keys %{$categories->{$cat}} ) { %>
						<tr>
							<td>
								<% for (my $count = 0; $count < $categories->{$cat}->{$ca}->{'ca'} || 0; $count++ ) { %>&nbsp;&nbsp;<% } %>
								<%= $cat %> <%= $ca %>
							</td>
							<td></td>
							<% foreach my $d ( @{$dollas} ) { %>
								<td><%= &subs::price_formatter($categories->{$cat}->{$ca}->{$d}) %></td>
							<% } %>
						</tr>
						<% foreach my $l ( sort { $a->{'timestamp'} <=> $b->{'timestamp'} } @{$categories->{$cat}->{$ca}->{'list'}} ) { %>
							<% unless ($starter->{$l->{'app'}}) { $starter->{$l->{'app'}} = $start; } %>
							<% my $current_appts = &subs::db_query('select * from appointments where app=? and ( type=? or type = ? or type = ? or type = ? ) and timestamp >= ? and timestamp <= ?', $l->{'app'}, 'stop', 'start', 'record','usual', $starter->{$l->{'app'}}, $l->{'timestamp'})->hashes; %> 

							<tr>
								<td><span class="time" timestamp="<%= $starter->{$l->{'app'}} %>"></span> -- <span class="time" timestamp="<%= $l->{'timestamp'} %>"></span>  <%= scalar @{$current_appts} %></td>
								<td><%= &subs::format_name($l->{'app'}) %></td>
								<td><%= $l->{'quantity'} || -1 %></td>
								<td><%= $l->{'unit'} || '' %></td>
								<td><%= $l->{'type'} %></td>
								<td><span class="time" timestamp="<%= $l->{'timestamp'} %>"></span></td>
								<% $starter->{$l->{'app'}} = $l->{'timestamp'}; %>
							</tr>

						<% } %>
					<% } %>
			
				<% } %>
			</tbody>
		</table>
	<% } elsif ($display eq 'invoices') { %>
		<b><%= scalar @{$documents} %></b> document<% unless (scalar @{$documents} == 1) { %>s<% } %>
		<table id="budget_invoices" style="width:100%;border:groove;">
			<thead style="text-align:left;font-size:20px;">
				<th>Type</th>
				<th>#</th>
				<th>Customer</th>
				<th>Item</th>
				<th>When</th>
				<th>Total</th>
				<th>Paid</th>
				<th>Balance</th>
				<th>Status</th>
			</thead>
			<tbody>
				<% foreach my $d ( @{$documents} ) { %>
					<tr class="budget_invoice hover" app="<%= $d->{'app'} %>" uuid="<%= $d->{'uuid'} %>" timestamp="<%= $d->{'timestamp'} %>">
						<td><%= $d->{'formatted_type'} %></td>
						<td><%= $d->{'data'}->{'id'} %></td>
						<td><%= &subs::format_name($d->{'app'}) %></td>
						<td><%= $d->{'formatted_item'} %></td>
						<td><span class="time" timestamp="<%= $d->{'timestamp'} %>"></span></td>
						<td><%= $d->{'formatted_total'} %></td>
						<td><%= $d->{'formatted_paid'} %>
							<% if (scalar @{$d->{'data'}->{'payments'} || []} > 0) { %>
								<img class="tiny_thumb budget_invoice_payments_toggle hover" uuid="<%= $d->{'uuid'} %>" hint="Payments" src="<%= &subs::icon_for('/images/decipherable/list.png') %>">
							<% } %>
						</td>
						<td><%= $d->{'formatted_balance'} %></td>
						<td><%= $d->{'formatted_status'} %></td>
					</tr>
					<% if (scalar @{$d->{'data'}->{'payments'} || []} > 0) { %>
						<tr class="budget_invoice_payment_row" uuid="<%= $d->{'uuid'} %>" style="display:none;font-size:16px;">
							<td colspan="9">
								<% foreach my $p ( @{$d->{'data'}->{'payments'}} ) { %>
									<%= &subs::price_formatter($p->{'amount'}) %> <%= &subs::format_name($p->{'account'}) %> <span class="time" timestamp="<%= $p->{'timestamp'} %>"></span><br>
								<% } %>
							</td>
						</tr>
					<% } %>
				<% } %>
				<% foreach my $dt ( qw/invoice quote/ ) { %>
					<tr style="font-size:18px;">
						<td colspan="5"><b><%= &subs::format_name($dt . 's') %></b></td>
						<td><b><%= &subs::price_formatter($totals->{'documents'}->{$dt}->{'total'} || 0) %></b></td>
						<td><b><%= &subs::price_formatter($totals->{'documents'}->{$dt}->{'paid'} || 0) %></b></td>
						<td><b><%= &subs::price_formatter($totals->{'documents'}->{$dt}->{'balance'} || 0) %></b></td>
						<td></td>
					</tr>
				<% } %>
				<tr style="font-size:20px;">
					<td colspan="5"><b>Total</b></td>
					<td><b><%= &subs::price_formatter($totals->{'documents'}->{'total'} || 0) %></b></td>
					<td><b><%= &subs::price_formatter($totals->{'documents'}->{'paid'} || 0) %></b></td>
					<td><b><%= &subs::price_formatter($totals->{'documents'}->{'balance'} || 0) %></b></td>
					<td></td>
				</tr>
			</tbody>
		</table>
	<% } elsif ($display eq 'reconcile') { %>
		<div id="budget_reconcile">
			<h3><%= &subs::ui('Import a bank statement') %></h3>
			<span>
				<select id="budget_reconcile_account" hint="<%= &subs::ui('Account') %>">
					<% foreach my $ac ( grep { $_->{'app'} ne 'all' && $_->{'app'} ne 'gallery' } @{$all_accounts} ) { %>
						<option value="<%= $ac->{'app'} %>" <% if (((grep { $_ eq 'all' } @{$account}) ? 0 : 1) && (grep { $_ eq $ac->{'app'} } @{$account})) { %>selected<% } %>><%= &subs::format_name($ac->{'app'}) %></option>
					<% } %>
				</select>
				<select id="budget_reconcile_date_order" hint="<%= &subs::ui('Date order') %>">
					<option value="mdy"><%= &subs::ui('Month / Day / Year') %></option>
					<option value="dmy"><%= &subs::ui('Day / Month / Year') %></option>
				</select>
				<input type="file" id="budget_reconcile_file" accept=".csv,.qif,.ofx,.txt">
				<button id="budget_reconcile_import"><%= &subs::ui('Import') %></button>
			</span>
			<div id="budget_reconcile_message"></div>
			<div id="budget_reconcile_area"></div>
		</div>
	<% } %>
</div>
<script>appointment_chron()</script>