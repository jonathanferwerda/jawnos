<% no warnings 'uninitialized'; %>
<div class="pay_page">
	<div class="pay_card">
		<h1><%= $ok ? &subs::ui('Payment received') : ($pending ? &subs::ui('Payment is still processing') : &subs::ui('Payment was not completed')) %></h1>
		<p><%= $message %></p>
		<% if ($invoice_url) { %><p><a class="pay_back" href="<%= $invoice_url %>">&larr; <%= &subs::ui('Back to the invoice') %></a></p><% } %>
	</div>
</div>
<style>
	.pay_page { max-width: 560px; margin: 8vh auto; padding: 0 16px; }
	.pay_card { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 26px 28px; box-shadow: 0 10px 30px rgba(0,0,0,.12); }
	.pay_card h1 { margin: 0 0 12px; font-size: 26px; }
	.pay_card p { margin: 0 0 14px; line-height: 1.5; }
	.pay_back { font-weight: 600; color: var(--ink); }
</style>
