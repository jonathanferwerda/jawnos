<%# Controller's body: the roster, adding one, and confirming a code. The roster
    is drawn from GET /manager/controllers/list by public/js/manager/controllers.js
    so it can be refreshed after an approval without redrawing the window. %>
	<div class="controller_section">
		<h2><%= &subs::ui('Controllers') %></h2>
		<p class="controller_note"><%= &subs::ui('The controllers that can talk to this house. A controller waiting to be confirmed is marked pending.') %></p>
		<div id="controller_roster" class="controller_card" aria-live="polite">
			<div class="controller_empty"><%= &subs::ui('Reading the controllers...') %></div>
		</div>
	</div>

	<%# Flash a blank board from this computer. The list route reports whether this
	    computer can reach a board over USB; until it says so this section stays
	    hidden, so a phone or a server never sees the button. %>
	<div class="controller_section" id="controllers_new_section" hidden>
		<h2><%= &subs::ui('New controller') %></h2>
		<p class="controller_note"><%= &subs::ui('Flash the house image to a blank board over USB from this computer.') %></p>
		<div class="controller_toolbar">
			<button type="button" id="controllers_new_button"><%= &subs::ui('New controller') %></button>
			<div id="controllers_new_status" class="controller_status" aria-live="polite"></div>
		</div>
		<div id="controllers_new_panel" class="controller_card" hidden></div>
	</div>

	<div class="controller_section">
		<h2><%= &subs::ui('Add a controller') %></h2>
		<p class="controller_note"><%= &subs::ui('Name the controller, then add it. The house answers with a code; confirm the same code below.') %></p>
		<div>
			<input type="text" id="controller_name" placeholder="<%= &subs::ui('Controller name') %>" aria-label="<%= &subs::ui('Controller name') %>">
			<button type="button" id="controller_add_button"><%= &subs::ui('Add a controller') %></button>
		</div>
		<div id="controller_code" class="controller_code" hidden></div>
		<p id="controller_code_note" class="controller_note" hidden><%= &subs::ui('Type this code on the controller, then approve the same code here.') %></p>
		<div id="controller_add_status" class="controller_status"></div>
	</div>

	<div class="controller_section">
		<h2><%= &subs::ui('Approve a code') %></h2>
		<p class="controller_note"><%= &subs::ui('Type the code the controller shows and approve it.') %></p>
		<div>
			<input type="text" id="controllers_approve_code" placeholder="<%= &subs::ui('Code') %>" aria-label="<%= &subs::ui('Code') %>">
			<button type="button" id="controllers_approve_button"><%= &subs::ui('Approve') %></button>
		</div>
		<div id="controllers_approve_status" class="controller_status" aria-live="polite"></div>
	</div>

	<%# Storage and ROMs act on the controller selected in the roster above. The
	    sections are drawn by public/js/manager/controllers.js from the two JSON
	    routes; the markup here is only the frame they fill. %>
	<div class="controller_section">
		<h2><%= &subs::ui('Storage') %></h2>
		<p class="controller_note"><%= &subs::ui('A blank archive folder merges nothing: the card has to be mounted for merging to work.') %></p>
		<div id="controllers_selected" class="controller_selected" aria-live="polite"><%= &subs::ui('Select a controller above to set its storage and copy its ROMs.') %></div>
		<div id="controllers_storage" class="controller_card">
			<div class="controller_empty"><%= &subs::ui('Select a controller above to set its storage.') %></div>
		</div>
	</div>

	<div class="controller_section">
		<h2><%= &subs::ui('ROMs') %></h2>
		<p class="controller_note"><%= &subs::ui('Copy a game from one card to the other. A game already on the other card is left alone and says so.') %></p>
		<div class="controller_toolbar">
			<button type="button" id="controllers_refresh_button" disabled><%= &subs::ui('Refresh') %></button>
			<div id="controllers_roms_status" class="controller_status" aria-live="polite"></div>
		</div>
		<div id="controllers_roms" class="controller_roms">
			<div class="controller_empty"><%= &subs::ui('Select a controller above to see its ROMs.') %></div>
		</div>
	</div>
