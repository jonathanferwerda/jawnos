<%# The controller app: the roster of controllers that can talk to the house,
    adding one (which returns a pairing code), confirming that code, and then
    the selected controller's storage and ROMs. The page is wrapped by
    window_maker, so it draws only its contents. %>
<div id="controllers_app" style="overflow:auto;background-color:var(--panel);height:100%;width:100%;">
	<%= include 'controllers/style' %>
	<%= include 'controllers/body' %>
</div>
