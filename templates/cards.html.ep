<% my @decks = (
	[ tarot     => &subs::ui('Tarot') ],
	[ solitaire => &subs::ui('Solitaire') ],
	[ mahjong   => &subs::ui('Mahjong') ],
);
my $start = $variant // '';
my $known = ($start eq 'tarot' || $start eq 'solitaire' || $start eq 'mahjong') ? $start : '';
%>
<div id="cards" class="cards_app" data-variant="<%= $known %>">
<%= include 'cards/style' %>
	<header class="cards_bar">
		<button type="button" class="cards_brand" data-variant=""><%= &subs::ui('Cards') %></button>
		<nav class="cards_variant_bar" aria-label="<%= &subs::ui('Decks') %>">
			<% foreach my $deck ( @decks ) { %>
				<button type="button" class="cards_variant<% if ($known eq $deck->[0]) { %> active<% } %>" data-variant="<%= $deck->[0] %>"><%= $deck->[1] %></button>
			<% } %>
		</nav>
	</header>
	<main class="cards_body">
		<%= include 'cards/chooser', open => (length $known ? 0 : 1) %>
		<%= include 'cards/tarot', history => $history, mode => $mode, active => ($known eq 'tarot') %>
		<%= include 'cards/solitaire', bank => $bank, active => ($known eq 'solitaire') %>
		<%= include 'cards/mahjong', active => ($known eq 'mahjong') %>
	</main>
</div>
