<%	my $syl_count = 10;

$syl_count = 1 unless $device_type eq 'microcontroller';
my $syl = &subs::shorthand_name($component,$syl_count); %>

<span class="watch_<%= $component %>_container embedded_container" numero="<%= $n %>">
	<button id="watch_<%= $component %><%= $n %>" numero="<%= $n %>" class="centre_view watch_component watch_<%= $component %>" component="<%= $component %>"
		app="<%= $settings->{$syl . $n}->{'app'} %>"><%= $settings->{$syl . $n}->{'formatted_name'} || $pin || $n %></button>
	<div id="watch_configure_<%= $component %>_<%= $n %>" style="background-color:<%= $settings->{$syl . $n}->{'settings'}->{'colour'} || 'var(--panel)' %>;<% if ($source eq 'gpio') { %>display:none;border:solid;width:95%;border-radius:2%;<% } %>">
		<span style="align:center;width:100%;background-color:var(--panel);"><b>Pin <%= $pin %> <%= $component %></b></span><br>
		<input placeholder="<%= &subs::ui('app name') %>" hint="<%= &subs::ui('The app this pin runs; type it, then pick it from the list') %>" id="watch_input_<%= $component %>_<%= $n %>" style="width:90%;" ip="<%= $embedded->{'ip'} %>" pre_value="<%= $settings->{$syl . $n}->{'app'} %>" edt="<%= $device_type %>" component="<%= $component %>" type="text" app="<%= $settings->{$syl . $n}->{'app'} %>" numero="<%= $n %>" class="watch_input" style="width:110px;" value="<%= &subs::format_name($settings->{$syl . $n}->{'app'}) %>"><br>
		<input type="text" value="<%= &subs::format_name($settings->{$syl . $n}->{'name'}) %>"
			placeholder="<%= &subs::ui('pin name') %>" hint="<%= &subs::ui('A name for this pin on the device') %>"
			class="watch_setting" setting="name" numero="<%= $n %>" component="<%= $component %>"
		>
		<% if ($components->{$component}->{'state'}) { %>
			<% if ($components->{$component}->{'direction'} eq 'output') { %>
				<input class="watch_toggle" edt="<%= $device_type %>" ip="<%= $embedded->{'ip'} %>" app="<%= $settings->{$syl . $n}->{'app'} %>" component="<%= $component %>" pin="<%= $n %>" value="<%= $settings->{$syl . $n}->{'toggle'} %>" style="width:60px;">
			<% } %>
<!--
			<select class="watch_measures" value="<%= $settings->{$syl . $n}->{'measure'} %>" edt="<%= $device_type %>" ip="<%= $embedded->{'ip'} %>" app="<%= $settings->{$syl . $n}->{'app'} %>" component="<%= $component %>" pin="<%= $n %>" style="width:110px;">
				<option value=""></option>
				<% foreach my $meas ( keys %{$settings->{$syl . $n}->{'settings'}->{'measures'}} ) { %>
					<option value="<%= $meas %>" <% if ($settings->{$syl . $n}->{'measure'} eq $meas) { %>selected<% } %>><%= &subs::format_name($meas) %></option>
				<% } %>
			</select>
-->
		<% } if ($components->{$component}->{'direction'} eq 'input') { %>
			<% if ($settings->{$syl . $n}->{'app'}) { %>
				<select id="watch_movement_<%= $component %>_<%= $n %>" component="<%= $component %>" class="watch_movement watch_setting" setting="movement" numero="<%= $n %>" hint="<%= &subs::ui('What a press does') %>">
					<option value=""></option>
					<% foreach my $mov ( sort keys %{$movements} ) { %>
						<option 
							<% if ( $movements->{$mov}->{'mov'} eq $settings->{$syl . $n}->{'movement'}) { %>selected<% } %>
							value="<%= $movements->{$mov}->{'mov'} %>"><%= $movements->{$mov}->{'formatted_name'} %></option>
					<% } %>
				</select>
				<select class="watch_destination watch_setting" setting="destination" numero="<%= $n %>" component="<%= $component %>" edt="<%= $device_type %>" chip_id="<%= $embedded->{'chip_id'} %>" hint="<%= &subs::ui('Which machine runs this') %>">
					<option value=""><%= &subs::ui('every machine') %></option>
					<% foreach my $rm ( @{$destinations || []} ) { %>
						<option value="<%= $rm->{'signatorial'} %>" <% if (($settings->{$syl . $n}->{'destination'} || '') eq $rm->{'signatorial'}) { %>selected<% } %>><%= $rm->{'hostname'} %></option>
					<% } %>
				</select>
				<% my $media_movement = $settings->{$syl . $n}->{'movement'} || ''; %>
				<% if ($media_movement eq 'video' || $media_movement eq 'audio') { %>
					<% my $video = $media_movement eq 'video' ? 1 : 0;
					my $media_kind = $settings->{$syl . $n}->{'media_kind'} || '';
					$media_kind = $video ? 'video' : 'audio'
						unless $video ? ($media_kind =~ /^(?:video|video_front)$/) : ($media_kind =~ /^(?:audio|system)$/);
					my $kind_hint = $video ? &subs::ui('Which camera records') : &subs::ui('Which microphone records');
					my $media_machine = $settings->{$syl . $n}->{'media_machine'} || '';
					my @media_machines = grep {
						($_->{'signatorial'} || '') ne ''
							&& ($_->{'signatorial'} || '') ne &subs::signatorial_designer()
							&& ($_->{'device'} || '') =~ /^(?:mobile|computer|server)$/
					} @{$destinations || []}; %>
					<select class="watch_setting" setting="media_kind" numero="<%= $n %>" component="<%= $component %>" edt="<%= $device_type %>" chip_id="<%= $embedded->{'chip_id'} %>" title="<%= $kind_hint %>" aria-label="<%= $kind_hint %>">
						<% if ($video) { %>
							<option value="video" <% if ($media_kind eq 'video') { %>selected<% } %>><%= &subs::ui('Camera (rear)') %></option>
							<option value="video_front" <% if ($media_kind eq 'video_front') { %>selected<% } %>><%= &subs::ui('Camera (front)') %></option>
						<% } else { %>
							<option value="audio" <% if ($media_kind eq 'audio') { %>selected<% } %>><%= &subs::ui('Microphone') %></option>
							<option value="system" <% if ($media_kind eq 'system') { %>selected<% } %>><%= &subs::ui('System audio') %></option>
						<% } %>
					</select>
					<select class="watch_setting" setting="media_machine" numero="<%= $n %>" component="<%= $component %>" edt="<%= $device_type %>" chip_id="<%= $embedded->{'chip_id'} %>" title="<%= &subs::ui('Which machine records this') %>" aria-label="<%= &subs::ui('Which machine records this') %>">
						<option value=""><%= &subs::ui('This machine') %></option>
						<% foreach my $rm ( @media_machines ) { %>
							<option value="<%= $rm->{'signatorial'} %>" <% if ($media_machine eq $rm->{'signatorial'}) { %>selected<% } %>><%= $rm->{'hostname'} %></option>
						<% } %>
					</select>
				<% } %>
			<% } %>
		<% } elsif ($components->{$component}->{'direction'} eq 'output') { %>
			<% if ($settings->{$syl . $n}->{'app'}) { %>
				<button class="watch_toggle" edt="<%= $device_type %>" ip="<%= $embedded->{'ip'} %>" app="<%= $settings->{$syl . $n}->{'app'} %>" component="<%= $component %>" pin="<%= $n %>" state="<%= $settings->{$syl . $n}->{'toggle'} %>"><%= $settings->{$syl . $n}->{'toggle'} == 1 ? 'On' : 'Off' %></button>

				<select id="watch_movement_<%= $component %>_<%= $n %>" component="<%= $component %>" class="watch_movement watch_setting" setting="movement" numero="<%= $n %>" hint="<%= &subs::ui('What a press does') %>">
					<option value=""></option>
					<% foreach my $mov ( qw/record start measure command/ ) { %>
						<option 
							<% if ( $movements->{$mov}->{'mov'} eq $settings->{$syl . $n}->{'movement'}) { %>selected<% } %>
							value="<%= $movements->{$mov}->{'mov'} %>"><%= $movements->{$mov}->{'formatted_name'} %>
						</option>
					<% } %>
				</select>
				<select class="watch_destination watch_setting" setting="destination" numero="<%= $n %>" component="<%= $component %>" edt="<%= $device_type %>" chip_id="<%= $embedded->{'chip_id'} %>" hint="<%= &subs::ui('Which machine runs this') %>">
					<option value=""><%= &subs::ui('every machine') %></option>
					<% foreach my $rm ( @{$destinations || []} ) { %>
						<option value="<%= $rm->{'signatorial'} %>" <% if (($settings->{$syl . $n}->{'destination'} || '') eq $rm->{'signatorial'}) { %>selected<% } %>><%= $rm->{'hostname'} %></option>
					<% } %>
				</select>
				<% if ($settings->{$syl . $n}->{'movement'} eq 'measure') { %>
					<% my $selected_measure = {}; %>
					<select class="watch_measures" value="<%= $settings->{$syl . $n}->{'measure'} %>" edt="<%= $device_type %>" ip="<%= $embedded->{'ip'} %>" app="<%= $settings->{$syl . $n}->{'app'} %>" component="<%= $component %>" pin="<%= $n %>" style="width:110px;">
						<option value=""></option>
						<% foreach my $meas ( keys %{$settings->{$syl . $n}->{'settings'}->{'measures'}} ) { %>
							<option value="<%= $meas %>" <% if ($settings->{$syl . $n}->{'measure'} eq $meas) { 
								$selected_measure = $settings->{$syl . $n}->{'settings'}->{'measures'}->{$meas}; 
							%>selected<% } %>><%= &subs::format_name($meas) %></option>
						<% } %>
					</select>
					<%= $selected_measure->{'type'} %>
					<% if ($selected_measure->{'type'} eq 'range' || $selected_measure->{'type'} eq 'number') { %>
						Threshold:
						<input type="range" min="<%= $selected_measure->{'min'} %>" step=".1" max="<%= $selected_measure->{'max'} %>" value="<%= $settings->{$syl . $n}->{'threshold'} %>"
							class="watch_setting" setting="threshold" numero="<%= $n %>" component="<%= $component %>"
						>
						<select value="<%= $settings->{$syl . $n}->{'comparison'} %>" class="watch_setting" setting="comparison" numero="<%= $n %>" component="<%= $component %>">
							<% foreach my $cmp ( qw/< <= = >= >/ ) { %>
								<option value="<%= $cmp %>" <% if ($settings->{$syl . $n}->{'comparison'} eq $cmp ) { %>selected<% } %>><%= $cmp %></option>
							<% } %>
						</select>
						<input type="number" value="<%= $settings->{$syl . $n}->{'threshold'} %>" class="watch_setting" setting="threshold" numero="<%= $n %>" component="<%= $component %>">
						<span class="watch_setting_view" setting="threshold" component="<%= $component %>" numero="<%= $n %>"><%= $settings->{$syl . $n}->{'threshold'} %></span>
					<% } elsif ($selected_measure->{'type'} eq 'text') { %>
						<% if ( $settings->{$syl . $n}->{'settings'}->{'seen_measures'} > 0) { %>
							<select class="watch_setting" setting="named_measure" numero="<%= $n %>" component="<%= $component %>" value="<%= $settings->{$syl . $n}->{'named_measure'} %>">
								<% my $sm = $settings->{$syl . $n}->{'settings'}->{'seen_measures'}; %>
								<option value=""></option>
								<% foreach my $tm ( @{$sm} ) { %>
									<option value="<%= $tm %>" <% if ($tm eq $settings->{$syl . $n}->{'named_measure'}) { %>selected<% } %>><%= &subs::format_name($tm) %></option>
								<% } %>
							</select>
						<% } %>
					<% } %>
				<% } %>


				<input type="checkbox" class="watch_inverted watch_setting" setting="inverted" edt="<%= $device_type %>" ip="<%= $embedded->{'ip'} %>" app="<%= $settings->{$syl . $n}->{'app'} %>" component="<%= $component %>" numero="<%= $n %>" <%= $settings->{$syl . $n}->{'inverted'} == 1 ? 'checked' : '' %>>Inverted
			<% } %>
		<% } %>
		<br><br>
	</div>
</span>