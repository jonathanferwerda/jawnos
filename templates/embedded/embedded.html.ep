<% use Mojo::JSON qw/decode_json encode_json/; %>
<% my $destinations = [ grep { $_->{'hostname'} && ($_->{'connection'} || 'active') eq 'active' } @{ &subs::remote_machine_lister({}) || [] } ]; %>
<div id="embedded" style="overflow:scroll;text-align:center;background-color:var(--panel);height:100%;width:100%;">
	<%# The Embedded app carries its own styles, like every other app: the classes
	    below (embedded_*, teletype_*, centre_view/watch_*) were used but styled
	    nowhere, so the app rendered raw while the rest of the house wore the theme
	    tokens. Scoped on #embedded so it cannot leak. Colours come from the tokens
	    (--panel/--panel-2/--line/--ink) and so follow the light and dark themes. %>
	<%= include 'embedded/style' %>
	<%= include 'embedded/body', destinations => $destinations %>
</div>
