<% use Mojo::JSON qw/encode_json/; %>
<%# The JawnOS on-screen keyboard. One dock serves every editable field in the
    house: letters, a calculator for numbers, and a page of special characters.
    It is placed by soft_keyboard.js - inside the Chat composer, inside the
    window being typed in, or fixed at the foot of the page - so the system
    keyboard never has to reshape the page. %>
<%# The units a typed quantity can name: the registry the old calculator used,
    plus every coin, so "5jpy" and "32.33L" resolve in the browser. The values
    are decoded here because this file's own literals are UTF-8 bytes. %>
<% my $kb_chars = sub {
	my $s = shift;
	return '' unless defined $s;
	utf8::decode($s) if length $s && !utf8::is_utf8($s);
	return $s;
}; %>
<% my $kb_units = &Manager::measures_all(); %>
<% my (%kb, %kb_sym); %>
<% foreach my $k ( sort keys %{$kb_units} ) {
	my $u = $kb_units->{$k};
	next unless ref $u eq 'HASH';
	$kb{$k} = {
		name => $kb_chars->($u->{'name'} || $k),
		types => [ @{ $u->{'types'} || [] } ],
		symbol => $kb_chars->($u->{'symbol'} || ''),
	};
} %>
<% my $kb_base = &subs::crypto_report_currency(); %>
<% if ( &subs::crypto_enabled() ) {
	foreach my $a ( @{ &subs::crypto_assets() } ) {
		my $code = uc($a->{'code'} || '');
		next unless length $code;
		my $name = $kb_chars->($a->{'name'} || $code);
		my $symbol = $kb_chars->($a->{'symbol'} || '');
		$kb{$code} ||= { name => $name, types => [ 'currency' ], symbol => $symbol };
		$kb_sym{$symbol} = $code if length $symbol && $symbol ne '$';
	}
} %>
<% foreach my $f ( @{ &subs::crypto_fiat_table() } ) {
	my $code = uc($f->{'code'} || '');
	next unless length $code;
	$kb{$code} ||= { name => $kb_chars->($f->{'name'} || $code), types => [ 'currency' ], symbol => '' };
} %>
<% $kb_sym{'€'} = 'EUR'; $kb_sym{'£'} = 'GBP'; $kb_sym{'¥'} = 'JPY'; $kb_sym{'₹'} = 'INR'; $kb_sym{'₽'} = 'RUB'; $kb_sym{'₩'} = 'KRW'; $kb_sym{'₺'} = 'TRY'; %>
<% $kb_sym{'$'} = $kb_base; %>
<% my @symbols = (
	'€','£','¥','₹','₽','₿','¢','$',
	'±','×','÷','−','≠','≈','≤','≥','∞','π','√','∑','∏','∆','∂','∫','°','%','‰',
	'—','–','…','•','·','§','¶','†','‡','«','»','“','”','‘','’','¡','¿',
	'←','→','↑','↓','↔','⇒','⇐','⇔',
	'©','®','™','✓','✗','★','☆','♥','♦','♣','♠','♪','☀','☾','♀','♂','½','¼','¾','⅓','⅔',
); %>
<div id="jawn_soft_keyboard" class="soft_kb" hidden aria-hidden="true">
	<div class="soft_kb_bar">
		<button type="button" class="soft_kb_mode active" data-kb_mode="letters">abc</button>
		<button type="button" class="soft_kb_mode" data-kb_mode="calc">123</button>
		<button type="button" class="soft_kb_mode" data-kb_mode="symbols">#+=</button>
		<span class="soft_kb_title"></span>
		<button type="button" class="soft_kb_close" data-kb_action="close" aria-label="<%= &subs::ui('Hide keyboard') %>">⌄</button>
	</div>

	<div id="soft_kb_convert" class="soft_kb_convert" hidden>
		<span id="soft_kb_convert_src" class="soft_kb_convert_src"></span>
		<div id="soft_kb_convert_rows" class="soft_kb_convert_rows"></div>
	</div>

	<div id="soft_kb_suggest" class="soft_kb_convert" hidden>
		<span id="soft_kb_suggest_label" class="soft_kb_convert_src"></span>
		<div id="soft_kb_suggest_rows" class="soft_kb_convert_rows"></div>
	</div>

	<script id="soft_kb_units" type="application/json"><%== encode_json({ units => \%kb, symbols => \%kb_sym, base => $kb_base }) %></script>

	<div class="soft_kb_panel" data-kb_panel="letters">
		<div class="soft_kb_row">
			<% foreach my $k (qw/1 2 3 4 5 6 7 8 9 0/) { %><button type="button" class="soft_kb_key soft_kb_wide" data-kb_key="<%= $k %>"><%= $k %></button><% } %>
			<button type="button" class="soft_kb_key soft_kb_mod" data-kb_key="backspace" aria-label="<%= &subs::ui('Backspace') %>">⌫</button>
		</div>
		<div class="soft_kb_row">
			<% foreach my $k (qw/q w e r t y u i o p/) { %><button type="button" class="soft_kb_key soft_kb_letter soft_kb_wide" data-kb_key="<%= $k %>"><%= $k %></button><% } %>
		</div>
		<div class="soft_kb_row">
			<% foreach my $k (qw/a s d f g h j k l/) { %><button type="button" class="soft_kb_key soft_kb_letter soft_kb_wide" data-kb_key="<%= $k %>"><%= $k %></button><% } %>
			<button type="button" class="soft_kb_key soft_kb_wide" data-kb_key="'">'</button>
		</div>
		<div class="soft_kb_row">
			<button type="button" class="soft_kb_key soft_kb_mod" data-kb_key="shift" aria-label="<%= &subs::ui('Shift') %>">⇧</button>
			<% foreach my $k (qw/z x c v b n m/) { %><button type="button" class="soft_kb_key soft_kb_letter soft_kb_wide" data-kb_key="<%= $k %>"><%= $k %></button><% } %>
			<button type="button" class="soft_kb_key soft_kb_wide" data-kb_key=",">,</button>
			<button type="button" class="soft_kb_key soft_kb_wide" data-kb_key=".">.</button>
			<button type="button" class="soft_kb_key soft_kb_wide" data-kb_key="?">?</button>
		</div>
		<div class="soft_kb_row">
			<button type="button" class="soft_kb_key soft_kb_mod" data-kb_mode="symbols">#+=</button>
			<button type="button" class="soft_kb_key soft_kb_space" data-kb_key="space"><%= &subs::lang('chat.space') %></button>
			<button type="button" class="soft_kb_key soft_kb_mod" data-kb_key="enter" aria-label="<%= &subs::ui('New line') %>">⏎</button>
		</div>
	</div>

	<div class="soft_kb_panel" data-kb_panel="calc" hidden>
		<div class="soft_kb_display">
			<div id="soft_kb_expr" class="soft_kb_expr">0</div>
			<div id="soft_kb_result" class="soft_kb_result"></div>
		</div>
		<div id="soft_kb_history_wrap" class="soft_kb_history_wrap" hidden>
			<div id="soft_kb_history" class="soft_kb_history"></div>
			<button type="button" class="soft_kb_history_clear" data-kb_action="clear_history" aria-label="<%= &subs::ui('Clear history') %>">×</button>
		</div>
		<div class="soft_kb_row">
			<button type="button" class="soft_kb_key soft_kb_func" data-kb_key="clear">C</button>
			<button type="button" class="soft_kb_key soft_kb_func" data-kb_key="backspace" aria-label="<%= &subs::ui('Backspace') %>">⌫</button>
			<button type="button" class="soft_kb_key soft_kb_func" data-kb_key="(">(</button>
			<button type="button" class="soft_kb_key soft_kb_func" data-kb_key=")">)</button>
			<button type="button" class="soft_kb_key soft_kb_func" data-kb_key="%">%</button>
			<button type="button" class="soft_kb_key soft_kb_func" data-kb_key="sign">±</button>
		</div>
		<div class="soft_kb_numpad">
			<button type="button" class="soft_kb_key" data-kb_key="7">7</button>
			<button type="button" class="soft_kb_key" data-kb_key="8">8</button>
			<button type="button" class="soft_kb_key" data-kb_key="9">9</button>
			<button type="button" class="soft_kb_key soft_kb_op" data-kb_key="/">÷</button>
			<button type="button" class="soft_kb_key" data-kb_key="4">4</button>
			<button type="button" class="soft_kb_key" data-kb_key="5">5</button>
			<button type="button" class="soft_kb_key" data-kb_key="6">6</button>
			<button type="button" class="soft_kb_key soft_kb_op" data-kb_key="*">×</button>
			<button type="button" class="soft_kb_key" data-kb_key="1">1</button>
			<button type="button" class="soft_kb_key" data-kb_key="2">2</button>
			<button type="button" class="soft_kb_key" data-kb_key="3">3</button>
			<button type="button" class="soft_kb_key soft_kb_op" data-kb_key="-">−</button>
			<button type="button" class="soft_kb_key" data-kb_key="0">0</button>
			<button type="button" class="soft_kb_key" data-kb_key=".">.</button>
			<button type="button" class="soft_kb_key soft_kb_equals" data-kb_key="=">=</button>
			<button type="button" class="soft_kb_key soft_kb_op" data-kb_key="+">+</button>
		</div>
		<div class="soft_kb_row">
			<button type="button" class="soft_kb_key soft_kb_mod" data-kb_mode="letters">abc</button>
			<button type="button" class="soft_kb_key soft_kb_mod" data-kb_mode="symbols">#+=</button>
			<button type="button" class="soft_kb_key soft_kb_space" data-kb_key="enter" aria-label="<%= &subs::ui('Return') %>">⏎</button>
			<button type="button" class="soft_kb_key soft_kb_mod" data-kb_action="close" aria-label="<%= &subs::ui('Hide keyboard') %>">⌄</button>
		</div>
	</div>

	<div class="soft_kb_panel" data-kb_panel="symbols" hidden>
		<div class="soft_kb_symbols">
			<% foreach my $c ( @symbols ) { %><button type="button" class="soft_kb_sym" data-kb_char="<%= $c %>"><%= $c %></button><% } %>
		</div>
		<div class="soft_kb_row">
			<button type="button" class="soft_kb_key soft_kb_mod" data-kb_mode="letters">abc</button>
			<button type="button" class="soft_kb_key soft_kb_mod" data-kb_mode="calc">123</button>
			<button type="button" class="soft_kb_key soft_kb_space" data-kb_action="close" aria-label="<%= &subs::ui('Hide keyboard') %>">⌄</button>
		</div>
	</div>
</div>
