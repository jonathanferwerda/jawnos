<!DOCTYPE html>
<html>
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title><%= &subs::ui('JawnOS app required') %></title>
		<script>
			var bti = sessionStorage.getItem('browser_tab_id');
			if (!bti) { bti = 'app-' + Math.random().toString(36).slice(2); sessionStorage.setItem('browser_tab_id', bti); }
			var bt = localStorage.getItem('browser_tab');
			if (!bt) { bt = bti; localStorage.setItem('browser_tab', bt); }
			var signatorial = "<%= $c->stash('signatorial') || '' %>";
			window.jawnLockedDevice = "<%= $device_uuid || '' %>";
		</script>
		<script src="/js/jquery.js"></script>
		<script src="/js/numeral.min.js"></script>
		<script src="/js/universal.js?string=<%= &subs::jawn_version() %>"></script>
		<style>
			html, body { margin: 0; height: 100%; background: #101010; color: #f4f4f4; font-family: sans-serif; }
			#app_required { max-width: 620px; margin: 0 auto; padding: 9vh 20px; text-align: center; }
			#app_required h1 { font-size: 26px; line-height: 1.25; margin-bottom: 14px; }
			#app_required p { font-size: 16px; line-height: 1.5; color: #c9c9c9; }
			#app_required a { color: #8fd; }
			#app_required_status { min-height: 22px; margin-top: 14px; color: #ffd; }
			#app_required .small { font-size: 13px; color: #888; margin-top: 26px; }
		</style>
	</head>
	<body>
		<div id="app_required">
			<h1><%= &subs::ui('Open this in the JawnOS app') %></h1>
			<p><%= &subs::ui('The manager is only available inside the installed JawnOS app. A browser cannot open it.') %></p>
			<p><%= &subs::ui('The homepage and the store are still public.') %></p>
			<p><a href="/"><%= &subs::ui('Homepage') %></a> &middot; <a href="/store"><%= &subs::ui('Store') %></a></p>
			<div id="app_required_status"></div>
			<div id="app_required_actions"></div>
			<p class="small"><%= &subs::ui('If this is the app, approve its key on a phone that is already signed in, then reload.') %></p>
		</div>
		<script>
		(function () {
			var polling = false;
			function status(text) {
				var el = document.getElementById('app_required_status');
				if (el) { el.textContent = text || ''; }
			}
			function reloadSoon() {
				// A page that keeps landing back here must not spin: the app session
				// may be gone while localStorage still remembers an old `until`.
				var last = 0;
				try { last = parseInt(sessionStorage.getItem('jawn_app_reload') || '0', 10) || 0; } catch (e) { last = 0; }
				if (last && Date.now() - last < 5000) {
					status(<%== &subs::json_chars(&subs::ui('Still signing in...')) %>);
					return;
				}
				try { sessionStorage.setItem('jawn_app_reload', String(Date.now())); } catch (e) {}
				status(<%== &subs::json_chars(&subs::ui('Signed in. Loading...')) %>);
				setTimeout(function () { window.location.reload(); }, 400);
			}
			function showPairLink() {
				var box = document.getElementById('app_required_actions');
				if (!box || box.getAttribute('data-pair')) { return; }
				box.setAttribute('data-pair', '1');
				var a = document.createElement('a');
				a.href = '/gate';
				a.textContent = <%== &subs::json_chars(&subs::ui('Pair this device')) %>;
				a.style.cssText = 'display:inline-block;margin-top:10px;font-size:16px;padding:10px 16px;border:1px solid #8fd;border-radius:9px;color:#8fd;text-decoration:none;';
				box.appendChild(a);
			}
			function showFingerprintSetup() {
				var box = document.getElementById('app_required_actions');
				if (!box || box.getAttribute('data-fp')) { return; }
				box.setAttribute('data-fp', '1');
				var b = document.createElement('button');
				b.type = 'button';
				b.textContent = <%== &subs::json_chars(&subs::ui('Set up this device\'s fingerprint')) %>;
				b.style.cssText = 'margin-top:10px;font-size:16px;padding:10px 16px;border-radius:9px;border:1px solid #2b6;background:#2b6;color:#08110a;font-weight:bold;cursor:pointer;';
				b.onclick = function () {
					if (typeof jawnosBiometricEnroll !== 'function') {
						status(<%== &subs::json_chars(&subs::ui('Fingerprint setup is not available in this app.')) %>);
						return;
					}
					b.disabled = true;
					jawnosBiometricEnroll(status).then(function () {
						return jawnAppLogin(true);
					}).then(reloadSoon).catch(function (err2) {
						b.disabled = false;
						var e2 = (err2 && err2.error) || '';
						status(e2 === 'not paired' ? <%== &subs::json_chars(&subs::ui('Pair this device first, then set up the fingerprint.')) %>
							: e2 === 'unavailable' ? <%== &subs::json_chars(&subs::ui('No fingerprint reader is available on this device.')) %>
							: <%== &subs::json_chars(&subs::ui('Could not set up the fingerprint.')) %>);
					});
				};
				box.appendChild(b);
			}
			function poll() {
				if (polling || !window.JawnDesktop) { return; }
				polling = true;
				setTimeout(function check() {
					$.getJSON('/manager/device/app_status', { device_uuid: jawnDeviceUuid() }).then(function (s) {
						if (s && s.has_app) {
							polling = false;
							jawnAppLogin(true).then(reloadSoon).catch(function () { status(<%== &subs::json_chars(&subs::ui('Could not sign in this app.')) %>); });
							return;
						}
						// A request older than an hour is cleared on the server. Ask again
						// instead of waiting forever on a request that no longer exists.
						if (s && s.ok && !s.pending && typeof jawnAppEnrollDesktop === 'function') {
							jawnAppEnrollDesktop().catch(function () {});
						}
						setTimeout(check, 3000);
					}).catch(function () { setTimeout(check, 5000); });
				}, 3000);
			}
			document.addEventListener('DOMContentLoaded', function () {
				if (typeof jawnAppLogin !== 'function') { return; }
				if (!window.JawnBiometricKey && !window.JawnDesktop) { return; }
				if (!jawnDeviceUuid()) {
					status(<%== &subs::json_chars(&subs::ui('This device is not paired with the house yet.')) %>);
					showPairLink();
					return;
				}
				status(<%== &subs::json_chars(&subs::ui('Checking this app...')) %>);
				jawnAppLogin(true).then(function (ok) {
					if (ok) { reloadSoon(); }
					else { status(<%== &subs::json_chars(&subs::ui('This app needs a key approved on a phone that is already signed in.')) %>); }
				}).catch(function (err) {
					var e = (err && err.error) || '';
					if (window.JawnDesktop && (e === 'no app key' || e === 'pending')) {
						status(<%== &subs::json_chars(&subs::ui('Waiting for approval on a signed-in phone.')) %>);
						if (e !== 'pending' && typeof jawnAppEnrollDesktop === 'function') {
							jawnAppEnrollDesktop().catch(function () {});
						}
						poll();
						return;
					}
					status(e === 'pending' ? <%== &subs::json_chars(&subs::ui('Waiting for approval on a signed-in phone.')) %>
						: e === 'not paired' ? <%== &subs::json_chars(&subs::ui('This device is not paired with the house yet.')) %>
						: e === 'no app key' && window.JawnBiometricKey ? <%== &subs::json_chars(&subs::ui('This device has no fingerprint key yet.')) %>
						: e === 'no key' ? <%== &subs::json_chars(&subs::ui('No app key is enrolled. Approve this app on a signed-in phone.')) %>
						: <%== &subs::json_chars(&subs::ui('Could not sign in this app.')) %>);
				if (e === 'not paired') { showPairLink(); }
				if (!window.JawnDesktop && window.JawnBiometricKey && (e === 'no app key' || e === 'no key')) { showFingerprintSetup(); }
				});
			});
		})();
		</script>
	</body>
</html>
