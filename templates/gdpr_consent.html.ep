<%# The transparency notice shown on the public homepage and in the store until
    the visitor acknowledges it. Only essential storage is used, so this is a
    notice rather than a consent gate; the privacy policy gives the detail. %>
<div id="jawnos_consent" role="dialog" aria-live="polite" aria-label="<%= &subs::lang('privacy.title') %>">
	<p><%= &subs::lang('home.consent_text') %></p>
	<a href="/privacy" target="_blank" rel="noopener"><%= &subs::lang('privacy.link') %></a>
	<button type="button" id="jawnos_consent_ok"><%= &subs::lang('home.consent_ok') %></button>
</div>
<style>
	#jawnos_consent {
		position:fixed;
		left:10px;
		right:10px;
		bottom:10px;
		z-index:10000;
		display:none;
		align-items:center;
		gap:12px;
		flex-wrap:wrap;
		padding:12px 16px;
		border:2px solid var(--line, #444);
		border-radius:10px;
		background:var(--panel, #fff);
		color:var(--ink, #111);
		font-size:14px;
		line-height:1.35;
		box-shadow:0 4px 18px rgba(0,0,0,.28);
		text-align:left;
	}
	#jawnos_consent p { margin:0; flex:1 1 320px; }
	#jawnos_consent a { white-space:nowrap; }
	#jawnos_consent button { flex:0 0 auto; }
	@media (max-width:560px) {
		#jawnos_consent { flex-direction:column; align-items:stretch; }
	}
</style>
<script>
(function () {
	var key = 'jawnos_consent_v1';
	var box = document.getElementById('jawnos_consent');
	if (!box) { return; }
	try { if (localStorage.getItem(key)) { return; } } catch (e) { /* storage may be blocked */ }
	box.style.display = 'flex';
	document.getElementById('jawnos_consent_ok').addEventListener('click', function () {
		try {
			localStorage.setItem(key, JSON.stringify({ necessary: true, analytics: false, at: Date.now() }));
		} catch (e) { /* nothing to remember, but the notice can still close */ }
		box.style.display = 'none';
	});
})();
</script>
