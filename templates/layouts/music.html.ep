<!DOCTYPE html>
<html>
  <head>
	  <link rel='icon' href="<%= &subs::icon_for('/images/make believe/Pillow.png') %>"/>
    <title><%= title %></title>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<script src="/js/jquery.js"></script>
		<script src="/js/universal.js?string=<%= $string %>"></script>
		<script src="/js/jquery-ui.js"></script>
		<script src="/js/numeral.min.js"></script>
		<% if ($window_maker ne 'yes') { %>
			<script src="/js/manager.js?string=<%= $string %>"></script>
			<%# the shared control/panel rules: without universal.css this standalone
			    page left every input and select on the browser's white face while
			    the theme ink was light %>
			<link rel="stylesheet" href="/css/universal.css?string=<%= $string %>" />
			<link rel="stylesheet" href="/css/manager.css?string=<%= $string %>" />
			<link rel="stylesheet" href="/css/music.css?string=<%= $string %>" />

		<% } %>
			



  </head>
  <body data-texture="<%= &subs::texture_name() %>" style="<%= &subs::theme_panel_css() %>">
		<%= content %>
		<div id="red_dot" class="circular_thumb dot">
			<span class="dot_info"><span>
		</div>
		<div id="yellow_dot" class="circular_thumb dot">
			<span class="dot_info"><span>
		</div>
		<div id="green_dot" class="circular_thumb dot">
			<span class="dot_info"><span>
		</div>
	</body>
</html>