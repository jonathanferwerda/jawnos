% use Mojo::JSON qw/decode_json encode_json/;
<!DOCTYPE html>
<html lang="<%= &subs::language() %>" dir="<%= &subs::language_dir() %>" style="zoom: <%= &subs::misc_setting('ui_zoom') || 100 %>%;">
  <head>
    <title><%= $title %></title>
		<link rel="manifest" type="application/json" href="/manifest.json">

		<% if (my $logo = &subs::setting_grabber({ app => 'me', setting => 'logo' })) { %>
			<link rel='icon' type='image/png' href="<%= $logo %>">
		<% } else { %>
		  <link rel='icon' href="<%= &subs::icon_for('/images/make believe/Pillow.png') %>"/>
		<% } %>
		<meta charset="utf-8">
		<meta name="mobile-web-app-capable" content="yes">
		<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1.0, user-scalable=0">

		<script src="/js/jquery.js"></script>
		<script>
			var bti = sessionStorage.getItem('browser_tab_id'); 
			if (bti == null) { 
				console.log('bti is null');
				bti = '<%= $browser_tab_id %>';
				sessionStorage.setItem('browser_tab_id', '<%= $browser_tab_id %>');
			}
			var bt = localStorage.getItem('browser_tab');
			if (!bt) { 
				localStorage.setItem('browser_tab', '<%= $browser_tab %>');
			}
			var device = "<%= $device %>";
			var signatorial = "<%= $signatorial %>";
			// the code revision: client caches that hold rendered HTML (the music
			// window contents) key on it, so a template change is never served stale
			var jawnos_version = '<%= $string %>';
			// Windows-style display zoom. 100% is the size everything was designed
			// at; the misc settings' slider runs 25%–200% in 5% steps. Applied on the
			// root element so fixed-position windows and bars scale with the rest.
			function jawnosZoomApply(pct) {
				pct = parseInt(pct, 10);
				if (isNaN(pct) || pct < 1) { pct = 100; }
				document.documentElement.style.zoom = pct + '%';
			}
			var paperboy_url = '<%= $paperboy_url %>';
			var ws_url = '<%= $ws_url %>';
			var mail_ws_url = '<%= $mail_ws_url %>';
			var my_name = '<%= $my_name %>';
			var advertise_watching = '<%= $advertise_watching %>';
			window.jawnos_lang = <%== &subs::lang_js() %>;
			window.jawnos_lang_code = '<%= &subs::language() %>';
			window.jawnos_lang_dir = '<%= &subs::language_dir() %>';
			var volumeInterval;
			<% if ($c->session('ticket_uuid')) { %>
					$.ajax({
						url: '/manager/debrief_grabber',
						type: 'GET',
						success: function(deb) {
							// the debrief is the store's own snapshot, and it seeds this browser
							// once: it fills keys this browser has never kept and never writes over
							// what it already holds, so a stale snapshot cannot drag the store
							// (and the windows that read it) back to the day the ticket was made
							if (typeof jawnosStoreFold == 'function') {
								jawnosStoreFold(deb, true);
							}
							else {
								$.each(deb,function(i,v) {
									if (localStorage.getItem(i) === null) { localStorage.setItem(i,v); }
								});
							}
						}
					});
			<% } %>
			var me_tax = <%= &subs::setting_grabber({ app => 'me', setting => 'tax' }) || 1.00 %>;
			var sales_tax = <%= &subs::setting_grabber({ app => 'me', setting => 'sales_tax' }) || 1.00 %>;
			// what the keyboard's config keeps per device: the damping the timeline
			// and the clothesline read, seeded here so either is right before its
			// keyboard is ever opened
			var keyboard_sensitivity = {
				trackpad: '<%= &subs::setting_grabber({ app => 'keyboard', setting => 'trackpad_sensitivity' }) || '.02' %>',
				clothesline: '<%= &subs::setting_grabber({ app => 'keyboard', setting => 'clothesline_sensitivity' }) || '.4' %>'
			};
			// where the dock and the taskbar live, which of the two the search rides
			// in, which end of the bar the start button takes, and the clock's own
			// face: the misc settings, seeded here so the bars are laid out right
			// from the first paint
			var jawnos_bar_settings = {
				dock_position: '<%= &subs::misc_setting('dock_position') || 'bottom' %>',
				taskbar_position: '<%= &subs::misc_setting('taskbar_position') || 'bottom' %>',
				search_placement: '<%= &subs::misc_setting('search_placement') || 'dock' %>',
				start_button_side: '<%= &subs::misc_setting('start_button_side') || 'right' %>',
				dock_icons: '<%= &subs::misc_setting('dock_icons') || 'shown' %>',
				taskbar_height: '<%= &subs::misc_setting('taskbar_height') || 44 %>',
				navbar_height: '<%= &subs::misc_setting('navbar_height') || 36 %>',
				// a border width whose 0 is meaningful: seed it empty when unset so the
				// script's own default (3) applies, rather than turning 0 into 3
				window_border: '<%= &subs::misc_setting('window_border') // '' %>',
				// the frame's colour, independent of the theme's --line; blank follows
				// the theme (the ring's own fallback)
				window_border_colour: '<%= &subs::misc_setting('window_border_colour') || '' %>',
				// the edge on the things you press - buttons, image buttons, icons and
				// the canvas clothesline. 0 is meaningful (a bare control), so seed it
				// empty when unset and let the script's own default (3) apply
				button_border: '<%= &subs::misc_setting('button_border') // '' %>',
				// the colour of that edge, independent of the theme's --line; blank
				// follows the theme (and the material's own rim on the canvas)
				button_border_colour: '<%= &subs::misc_setting('button_border_colour') || '' %>',
				clothesline_height: '<%= &subs::misc_setting('clothesline_height') || 40 %>',
				// the desk's material: classic (Plain), round, sandglass, glass, paper,
				// fabric, wood or metal; universal.css and the canvas clothesline both
				// read it
				texture: '<%= &subs::texture_name() %>',
				// the bar's furniture and order ride as JSON so a quoted value does
				// not come back HTML-escaped; a bad value falls back to null (default)
				taskbar_order: <%== encode_json(eval { decode_json(&subs::misc_setting('taskbar_order')) } || undef) %>,
				taskbar_autohide: '<%= &subs::misc_setting('taskbar_autohide') || 'off' %>'
			};
			var jawnos_clock_format = '<%= &subs::misc_setting('clock_format') || '24' %>';
			var jawnos_clock_timezone = '<%= &subs::misc_setting('clock_timezone') || '' %>';
			var jawnos_clock_notifications = '<%= &subs::misc_setting('clock_notifications') || 'on' %>';
			// the built-in apps, from the server's own list (gb::known_appts), so the
			// client keeps no copy of its own that can drift
			var jawnos_builtin_apps = <%== encode_json({ map { $_ => 1 } sort keys %{$gb::known_appts} }) %>;
			// each scheme's window surface, keyed by its manager colour: jawnosApplyInk
			// reads this so a live scheme change picks the same curated window shade
			// the server rendered
			var jawnos_colour_windows = <%== encode_json({ map { lc($subs::colour_schemes{$_}->[2]) => $subs::colour_schemes{$_}->[3] } @subs::colour_scheme_order }) %>;
		</script>
		<!-- the manager's scripts load at the foot of the body, so the desktop can
		     paint before the parser waits on them; see the bundle there -->
		<link rel="stylesheet" href="/css/keyboard.css?string=<%= $string %>" />
		<link rel="stylesheet" href="/css/music.css?string=<%= $string %>" />
		<link rel="stylesheet" href="/css/universal.css?string=<%= $string %>" />
		<link rel="stylesheet" href="/css/manager.css?string=<%= $string %>" />
		<link rel="stylesheet" href="/css/chat.css?string=<%= $string %>" />
		<link rel="stylesheet" href="/css/store.css?string=<%= $string %>" />
		<link rel="stylesheet" href="/css/jquery-ui.css?string=<%= $string %>" />
  </head>
<%# a running start/record appointment with a theme owns the desktop; otherwise
    the Misc manager colour is the system theme %>
<% my ($manager_bg, $manager_appt_theme) = &subs::active_manager_background(); %>
<% my $theme_dark = &subs::theme_is_dark(); %>
  <% my $body_class = join ' ', grep { length } (($theme_dark ? 'dark_theme' : ''), ((&Manager::fingerprint_available() && &Manager::padlock_request_is_local($c)) ? '' : 'no_local_fingerprint')); %>
  <body<% if (length $body_class) { %> class="<%= $body_class %>"<% } %> style="background-color:<%= $manager_bg %>;<%= &subs::theme_panel_css($manager_bg) %>" data-texture="<%= &subs::texture_name() %>"<% if ($manager_appt_theme) { %> data-appt-theme="yes"<% } %>>
  <% my $title_font = &subs::setting_grabber({ app => 'misc', setting => 'title_font' }) || 'system-ui, sans-serif'; %>
  <style>
    :root { --jawnos-font: <%= $title_font %>; }
    /* the Misc → Font choice is the program's face, not just a few titles:
       the shell and the controls inherit it, while surfaces that declare their
       own family (the terminal, the IDE, mailed text) keep it. */
    body, button, input, select, textarea,
    .ui-widget, .ui-widget input, .ui-widget select, .ui-widget textarea, .ui-widget button,
    .title_font { font-family: var(--jawnos-font); }
  </style>
		<div id="everything">
			<%= content %>
			<div id="red_dot" class="circular_thumb dot">
				<span class="dot_info"><span>
			</div>
			<div id="yellow_dot" class="circular_thumb dot">
				<span class="dot_info"><span>
			</div>
			<div id="green_dot" class="circular_thumb dot">
				<span class="dot_info"><span>
			</div>
		</div>

		<!-- every script the desktop needs runs here, just past the desktop markup
		     but *before* #preload below: the preloaded window HTML carries an inline
		     script that uses jQuery UI, so the libraries must already be loaded when
		     it is parsed. Order matters and the inline windowMaker call stays last.
		     /js/manager/bundle.js concatenates the manager's own files in this order
		     (the list lives in Manager.pl: manager_bundle_files). -->
		<script src="/js/universal.js?string=<%= $string %>"></script>
		<% if (&subs::language() ne 'en') { %>
			<script src="/i18n/ui-<%= &subs::language() %>.js?string=<%= $string %>"></script>
		<% } %>
		<script src="/js/translate.js?string=<%= $string %>"></script>
		<script src="/js/manager/clickfx.js?string=<%= $string %>"></script>
		<script src="/js/jquery-ui.js"></script>
		<script src="/js/jquery.ui.touch-punch.min.js"></script>
		<script src="/js/touch-threshold.js"></script>
		<script src="/js/numeral.min.js"></script>
		<script src="/js/moment.js"></script>
		<script src="/js/manager/bundle.js?string=<%= $string %>"></script>
		<script src="/js/screensaver.js?string=<%= $string %>"></script>
	<!--	<script src="/js/paperboy.js?string=<%= $string %>"></script> -->
		<div style="display:none;width:100%;height:100%;" id="padlock_frame">

		</div>
		<div style="display:none;" id="preload"><%= $website %></div>
		<script>var preload = $('#preload').text(); var timestamp = Date.now(); $(document).ready(function() { windowMaker(preload,timestamp); });</script>
	</body>
	<script src="/js/manager/websocket.js?string=<%= $string %>"></script>
	<script src="/js/manager/jp.js?string=<%= $string %>"></script>
	<div id="printer_view" style="display:none;"></div>
</html>
