<div id="synth">
	<div class="synth_toolbar">
		<label>Sound</label>
		<select id="synth_preset" class="synth_select synth_preset" hint="Choose a preset"></select>
		<label>MIDI</label>
		<select id="synth_midi" class="synth_select" hint="A connected USB MIDI keyboard"></select>
		<button id="synth_midi_connect" class="hover" hint="Connect a USB MIDI keyboard">Connect</button>
		<button id="synth_keyboard_toggle" class="hover" hint="Play the piano with your computer keyboard (A W S E D F T G Y H U J K …)">Keys: off</button>
		<button id="synth_arp_toggle" class="hover" hint="Arpeggiate the notes you hold">Arp: off</button>
		<select id="synth_arp_rate" class="synth_select" hint="Arpeggiator speed (steps per second)">
			<option value="4">4</option><option value="6">6</option><option value="8" selected>8</option><option value="10">10</option><option value="12">12</option><option value="16">16</option>
		</select>
		<select id="synth_arp_mode" class="synth_select" hint="Arpeggiator pattern">
			<option value="up">up</option><option value="down">down</option><option value="updown">up/down</option><option value="random">random</option>
		</select>
		<select id="synth_arp_octaves" class="synth_select" hint="Arpeggiator octaves">
			<option value="1">1 oct</option><option value="2">2 oct</option><option value="3">3 oct</option><option value="4">4 oct</option>
		</select>
		<button id="synth_mono_toggle" class="hover" hint="One voice, gliding between notes">Mono: off</button>
		<input id="synth_glide" type="range" min="0" max="300" value="0" style="width:70px;" hint="Glide (milliseconds between notes when Mono is on)">
		<select id="synth_learn_param" class="synth_select" hint="The parameter to map, then press Learn and move a knob on your controller"></select>
		<button id="synth_learn" class="hover" hint="Arm MIDI learn for the chosen parameter">Learn</button>
		<button id="synth_learn_clear" class="hover" hint="Forget every learned mapping">Clear</button>
		<span id="synth_learn_state" class="synth_voices" style="margin-left:0;"></span>
		<span id="synth_octave" class="synth_voices" style="margin-left:0;" hint="Octave for the computer keyboard (Z down, X up)"></span>
		<span id="synth_voices" class="synth_voices"></span>
	</div>

	<div class="synth_keys" id="synth_keys"></div>

	<div class="synth_controls">
		<div class="synth_knob"><label>Cutoff</label><input type="range" class="synth_param" param="filter.cutoff" min="0" max="100" value="55"></div>
		<div class="synth_knob"><label>Resonance</label><input type="range" class="synth_param" param="filter.q" min="0" max="100" value="15"></div>
		<div class="synth_knob"><label>Filter env</label><input type="range" class="synth_param" param="filter.env" min="0" max="100" value="30"></div>
		<div class="synth_knob"><label>Attack</label><input type="range" class="synth_param" param="amp.a" min="0" max="100" value="8"></div>
		<div class="synth_knob"><label>Decay</label><input type="range" class="synth_param" param="amp.d" min="0" max="100" value="30"></div>
		<div class="synth_knob"><label>Sustain</label><input type="range" class="synth_param" param="amp.s" min="0" max="100" value="60"></div>
		<div class="synth_knob"><label>Release</label><input type="range" class="synth_param" param="amp.r" min="0" max="100" value="30"></div>
		<div class="synth_knob"><label>Detune</label><input type="range" class="synth_param" param="osc2.detune" min="0" max="100" value="55"></div>
		<div class="synth_knob"><label>LFO</label><input type="range" class="synth_param" param="lfo.rate" min="0" max="100" value="0"></div>
		<div class="synth_knob"><label>Drive</label><input type="range" class="synth_param" param="drive" min="0" max="100" value="0"></div>
	</div>

	<div class="synth_hint">Play the keys above, or a connected MIDI keyboard. To record, open Studio, set a channel's input to Synth (or drag the JawnSynth pedal onto it), arm the channel, and record.</div>

	<div class="synth_seq_toolbar">
		<button id="synth_seq_toggle" class="hover" hint="Loop this step grid through the synth">Seq: off</button>
		<select id="synth_seq_rate" class="synth_select" hint="Sequencer speed (steps per second)">
			<option value="4">4</option><option value="6">6</option><option value="8" selected>8</option><option value="12">12</option><option value="16">16</option>
		</select>
		<select id="synth_seq_steps" class="synth_select" hint="Grid length (steps)">
			<option value="8">8 steps</option><option value="16" selected>16 steps</option><option value="24">24 steps</option><option value="32">32 steps</option>
		</select>
		<button id="synth_seq_clear" class="hover" hint="Clear every cell">Clear</button>
	</div>
	<div class="synth_seq" id="synth_seq"></div>
</div>

<style>
	#synth { padding: 8px; max-width: 100%; box-sizing: border-box; }
	.synth_toolbar {
		display: flex;
		align-items: center;
		gap: 8px;
		flex-wrap: wrap;
		margin-bottom: 8px;
	}
	.synth_toolbar label { opacity: .7; }
	.synth_select {
		font-size: 15px;
		border: solid 1px var(--line);
		border-radius: 5px;
		background: var(--panel);
		color: inherit;
		padding: 3px 5px;
	}
	#synth_midi_connect {
		font-size: 14px;
		border: solid 1px var(--line);
		border-radius: 5px;
		background: var(--panel);
		color: inherit;
		padding: 3px 8px;
		cursor: pointer;
	}
	.synth_voices { opacity: .55; margin-left: auto; font-size: 13px; }

	.synth_keys {
		position: relative;
		width: 100%;
		box-sizing: border-box;
		height: 124px;
		overflow-x: auto;
		overflow-y: hidden;
		padding-bottom: 4px;
		border-radius: 4px;
	}
	.synth_keys_inner {
		position: relative;
		height: 118px;
		white-space: nowrap;
	}
	.piano_key {
		cursor: pointer;
		user-select: none;
		border: solid;
		border-width: 1px;
		box-sizing: border-box;
	}
	.piano_key.white {
		display: inline-block;
		vertical-align: top;
		width: 26px;
		height: 118px;
		background: #fdfdfa;
		color: #666;
		font-size: 9px;
		text-align: center;
		padding-top: 100px;
		border-radius: 0 0 4px 4px;
		position: relative;
		z-index: 1;
	}
	.piano_key.black {
		position: absolute;
		top: 0;
		width: 16px;
		height: 74px;
		background: #141414;
		border-color: #000;
		border-radius: 0 0 3px 3px;
		z-index: 2;
	}
	.piano_key.white.piano_key_on { background: #ffd21e; }
	.piano_key.black.piano_key_on { background: #b8860b; }

	.synth_controls {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 10px;
	}
	.synth_knob {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 74px;
	}
	.synth_knob label { font-size: 12px; opacity: .7; margin-bottom: 2px; }
	.synth_knob input[type=range] { width: 68px; }

	.synth_hint { margin-top: 10px; opacity: .6; font-size: 13px; max-width: 640px; }

	.synth_seq_toolbar { display: flex; align-items: center; gap: 8px; margin-top: 12px; flex-wrap: wrap; }
	.synth_seq { margin-top: 6px; overflow-x: auto; padding-bottom: 4px; }
	.synth_seq_row { display: flex; align-items: center; height: 16px; }
	.synth_seq_label { width: 36px; font-size: 10px; opacity: .6; flex: none; }
	.synth_seq_cell { width: 16px; height: 14px; margin-right: 2px; border: 1px solid var(--line); border-radius: 2px; background: var(--panel); flex: none; cursor: pointer; }
	.synth_seq_cell.on { background: #4caf50; }
	.synth_seq_cell.synth_seq_playing { outline: 2px solid #ffd21e; }
</style>
