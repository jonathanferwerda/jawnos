<% no warnings 'uninitialized'; %>
<% my $crypto_wallets = &subs::crypto_enabled() ? &subs::crypto_wallets_report() : []; %>
<img src="<%= &subs::icon_for('/images/make believe/cancel_button.png') %>" hint="<%= &subs::lang('common.close') %>" class="main_viewer_cancel_button little_thumb" style="float:right;">
<% my $list_title = $type eq 'quote' ? &subs::lang('store.quotes') : ($type eq 'sale' ? &subs::lang('common.sale') : &subs::lang('store.invoices')); %>
<h1 class="store_journal_title"><%= $list_title %></h1>
<h3 class="store_journal_customer"><%= &subs::format_name($customer->{'app'}) %></h3>

<% if (scalar @{$list} == 0) { %>
	<p class="store_journal_empty"><%= $type eq 'quote' ? &subs::ui('No quotes yet for this customer.') : &subs::ui('No invoices yet for this customer.') %></p>
<% } else { %>
	<div class="store_documents">
		<% foreach my $quote ( @{$list} ) { %>
			<% my $q = $quote->{$type} || {}; my $numbers = $q->{'numbers'} || {}; %>
			<div class="store_document quote" server_time="<%= $quote->{'server_time'} %>">
				<div class="store_document_head">
					<div class="store_document_identity">
						<strong class="store_document_id">#<%= $q->{'id'} %></strong>
						<span class="store_journal_muted"><%= &subs::format_name($q->{'item'}) %> · <%= &subs::format_name($q->{'model'}->{'name'}) %></span>
					</div>
					<div class="store_document_date"><span class="time" mode="fixed" timestamp="<%= $quote->{'timestamp'} %>"></span></div>
					<div class="store_document_total"><%= &subs::price_formatter($numbers->{'total'}) %></div>
					<div class="store_document_actions">
						<img type="<%= $type %>" action="print" cx_uuid="<%= $customer->{'value'} %>" uuid="<%= $quote->{'uuid'} %>" src="<%= &subs::icon_for('/images/decipherable/feeder.png') %>" hint="<%= &subs::lang('common.print') %>" class="medium_thumb print hover">
						<img type="<%= $type %>" action="email" cx_uuid="<%= $customer->{'value'} %>" uuid="<%= $quote->{'uuid'} %>" src="<%= &subs::icon_for('/images/decipherable/envelope.png') %>" hint="<%= &subs::lang('common.email') %>" class="medium_thumb email hover">
						<% if ($type eq 'quote') { %>
							<img type="<%= $type %>" action="invoice" cx_uuid="<%= $customer->{'value'} %>" uuid="<%= $quote->{'uuid'} %>" src="<%= &subs::icon_for('/images/decipherable/register.png') %>" hint="<%= &subs::lang('common.invoice') %>" class="medium_thumb quote_move hover">
						<% } %>
						<% if ($type eq 'invoice') { %>
							<img type="<%= $type %>" action="quote" cx_uuid="<%= $customer->{'value'} %>" uuid="<%= $quote->{'uuid'} %>" src="<%= &subs::icon_for('/images/decipherable/list.png') %>" hint="<%= &subs::lang('common.quote') %>" class="medium_thumb quote_move hover">
							<img type="<%= $type %>" action="sale" cx_uuid="<%= $customer->{'value'} %>" uuid="<%= $quote->{'uuid'} %>" src="<%= &subs::icon_for('/images/decipherable/cash.png') %>" hint="<%= &subs::lang('common.sale') %>" class="medium_thumb quote_move hover">
							<% if (scalar @{$crypto_wallets}) { %>
								<img type="<%= $type %>" cx_uuid="<%= $customer->{'value'} %>" uuid="<%= $quote->{'uuid'} %>" src="<%= &subs::icon_path('wallet', '/images/decipherable/cash.png') %>" hint="Crypto payment" class="medium_thumb crypto_payment hover">
							<% } %>
						<% } %>
						<img cx_uuid="<%= $customer->{'value'} %>" doc_type="<%= $type %>" uuid="<%= $quote->{'uuid'} %>" src="<%= &subs::icon_for('/icons/trash.png') %>" hint="<%= &subs::lang('common.delete') %>" class="medium_thumb delete_quote hover">
					</div>
				</div>

				<table class="store_document_table">
					<thead>
						<tr>
							<th><%= &subs::lang('common.item') %></th>
							<th><%= &subs::lang('common.name') %></th>
							<th><%= &subs::lang('common.quantity') %></th>
							<th><%= &subs::lang('common.unit') %></th>
							<th><%= &subs::lang('common.cost') %></th>
							<th><%= &subs::lang('common.markup') %></th>
							<th><%= &subs::lang('common.price') %></th>
							<th><%= &subs::lang('common.tax') %></th>
							<th><%= &subs::lang('common.total') %></th>
							<th><%= &subs::ui('Balance') %></th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td><%= &subs::lang('common.model') %></td>
							<td><%= &subs::format_name($q->{'model'}->{'name'}) %></td>
							<td><%= $q->{'model'}->{'quantity'} || 1 %></td>
							<td><%= $q->{'model'}->{'unit'} %></td>
							<td><%= &subs::price_formatter($q->{'model'}->{'cost'}) %></td>
							<td><% if ($q->{'model'}->{'cost'} && $q->{'model'}->{'price'}) { %><%= &subs::percent_formatter(($q->{'model'}->{'price'} / $q->{'model'}->{'cost'}) - 1) %><% } %></td>
							<td><%= &subs::price_formatter($q->{'model'}->{'price'}) %></td>
							<td><%= &subs::price_formatter($q->{'model'}->{'tax'}) %></td>
							<td>
								<% my $mq = $q->{'model'}->{'quantity'} || 1; %>
								<% if ($q->{'model'}->{'price'} && $numbers->{'tax_rate'}) { %>
									<%= &subs::price_formatter(($q->{'model'}->{'price'} + $q->{'model'}->{'tax'}) * $mq) %>
								<% } else { %>
									<%= &subs::price_formatter($q->{'model'}->{'price'} * $mq) %>
								<% } %>
							</td>
							<td></td>
						</tr>
						<% foreach my $oc ( sort keys %{ $q->{'options'} || {} } ) { %>
							<% next unless scalar @{ $q->{'options'}->{$oc} || [] } > 0; %>
							<tr class="store_document_group">
								<td colspan="10"><%= &subs::format_name($oc) %></td>
							</tr>
							<% foreach my $o ( @{ $q->{'options'}->{$oc} } ) { %>
								<tr>
									<td><%= &subs::lang('common.option') %></td>
									<td><%= &subs::format_name($o->{'name'}) %></td>
									<td><%= $o->{'quantity'} || 1 %></td>
									<td><%= $o->{'unit'} %></td>
									<td><%= &subs::price_formatter($o->{'cost'}) %></td>
									<td><% if ($o->{'cost'} && $o->{'price'}) { %><%= &subs::percent_formatter(($o->{'price'} / $o->{'cost'}) - 1) %><% } %></td>
									<td><%= &subs::price_formatter($o->{'price'}) %></td>
									<td><%= &subs::price_formatter($o->{'tax'}) %></td>
									<td>
										<% if ($o->{'price'} && $numbers->{'tax_rate'}) { %>
											<%= &subs::price_formatter($o->{'price'} * ($o->{'quantity'} || 1) * $numbers->{'tax_rate'}) %>
										<% } else { %>
											<%= &subs::price_formatter($o->{'price'} * ($o->{'quantity'} || 1)) %>
										<% } %>
									</td>
									<td></td>
								</tr>
							<% } %>
						<% } %>
					</tbody>
					<tfoot>
						<tr>
							<th colspan="4"><%= &subs::ui('Totals') %></th>
							<th><%= &subs::price_formatter($numbers->{'cost'}) %></th>
							<th><%= &subs::percent_formatter($numbers->{'markup'}) %></th>
							<th><%= &subs::price_formatter($numbers->{'subtotal'}) %></th>
							<th><%= &subs::price_formatter($numbers->{'tax'}) %></th>
							<th><u><%= &subs::price_formatter($numbers->{'total'}) %></u></th>
							<th><u><%= &subs::price_formatter($numbers->{'balance'}) %></u></th>
						</tr>
					</tfoot>
				</table>
			</div>
		<% } %>
	</div>

	<div class="store_totals">
		<div class="store_totals_cell">
			<span class="store_journal_summary_label"><%= &subs::lang('common.total') %></span>
			<strong><%= &subs::price_formatter($totals->{'total'}) %></strong>
		</div>
		<div class="store_totals_cell">
			<span class="store_journal_summary_label"><%= &subs::ui('Paid') %></span>
			<strong><%= &subs::price_formatter(($totals->{'total'} || 0) - ($totals->{'balance'} || 0)) %></strong>
		</div>
		<div class="store_totals_cell">
			<span class="store_journal_summary_label"><%= &subs::ui('Balance') %></span>
			<strong><%= &subs::price_formatter($totals->{'balance'}) %></strong>
		</div>
		<div class="store_totals_cell store_totals_print">
			<img type="<%= $type %>" action="print" cx_uuid="<%= $customer->{'value'} %>" uuid="all" src="<%= &subs::icon_for('/images/decipherable/feeder.png') %>" hint="<%= &subs::lang('common.print') %>" class="medium_thumb print hover">
		</div>
	</div>
<% } %>
