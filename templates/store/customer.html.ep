<div id="cx" style="vertical-align:bottom;bottom:0px;">
	<img src="<%= &subs::icon_for('/images/decipherable/list.png') %>" hint="List" class="little_thumb customer_list hover" type="quotes">
	<img src="<%= &subs::icon_for('/images/decipherable/register.png') %>" hint="Register" class="little_thumb customer_list hover" type="invoice"> 
	<img src="<%= &subs::icon_for('/images/decipherable/cash.png') %>" hint="Cash" class="little_thumb customer_list hover" type="sale">
	<img src="<%= &subs::icon_for('/images/decipherable/envelope.png') %>" hint="Mail" class="little_thumb customer_list hover" id="mail_toggle" type="correspondance">
	<span style="vertical-align:top;padding-top:0px;top:20px;font-size:20px;max-width:200px;" class="customer_name hover"></span>
</div>