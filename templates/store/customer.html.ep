<div id="cx" style="vertical-align:bottom;bottom:0px;">
	<img src="<%= &subs::icon_for('/images/decipherable/list.png') %>" hint="<%= &subs::lang('common.list') %>" class="little_thumb customer_list hover" type="quotes">
	<img src="<%= &subs::icon_for('/images/decipherable/register.png') %>" hint="<%= &subs::lang('common.register') %>" class="little_thumb customer_list hover" type="invoice">
	<img src="<%= &subs::icon_for('/images/decipherable/cash.png') %>" hint="<%= &subs::lang('common.cash') %>" class="little_thumb customer_list hover" type="sale">
	<img src="<%= &subs::icon_for('/images/decipherable/envelope.png') %>" hint="<%= &subs::lang('common.mail') %>" class="little_thumb customer_list hover" id="mail_toggle" type="correspondance">
	<span style="vertical-align:top;padding-top:0px;top:20px;font-size:20px;max-width:200px;" class="customer_name hover"></span>
</div>