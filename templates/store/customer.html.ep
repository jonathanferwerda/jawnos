<div id="cx" class="store_customer_actions">
	<button type="button" class="customer_action" data-list="quotes" title="<%= &subs::lang('store.quotes') %>">
		<img src="<%= &subs::icon_for('/images/decipherable/list.png') %>" alt="">
		<span><%= &subs::lang('store.quotes') %></span>
	</button>
	<button type="button" class="customer_action" data-list="invoice" title="<%= &subs::lang('store.invoices') %>">
		<img src="<%= &subs::icon_for('/images/decipherable/register.png') %>" alt="">
		<span><%= &subs::lang('store.invoices') %></span>
	</button>
	<button type="button" class="customer_action" data-list="register" title="<%= &subs::lang('common.register') %>">
		<img src="<%= &subs::icon_for('/images/decipherable/cash.png') %>" alt="">
		<span><%= &subs::lang('common.register') %></span>
	</button>
	<button type="button" class="customer_action" data-list="correspondence" title="<%= &subs::lang('store.correspondence') %>">
		<img src="<%= &subs::icon_for('/images/decipherable/envelope.png') %>" alt="">
		<span><%= &subs::lang('store.correspondence') %></span>
	</button>
	<span class="customer_name hover"></span>
</div>
