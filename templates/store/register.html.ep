<% no warnings 'uninitialized'; %>
<div id="store_register" class="store_register" data-cx="<%= $cx %>" role="dialog" aria-modal="true" aria-label="<%= &subs::lang('common.register') %>">
	<header class="store_register_header">
		<h2 class="store_register_title"><%= &subs::lang('common.register') %></h2>
		<div class="store_register_header_actions">
			<button type="button" id="store_register_last_receipt" class="store_register_button" style="display:none;"><%= &subs::lang('common.receipt') %></button>
			<button type="button" id="store_register_floor" class="store_register_button" hint="<%= &subs::ui('Floor') %>"><%= &subs::ui('Floor') %></button>
			<button type="button" id="store_register_new" class="store_register_button"><%= &subs::lang('store.new_order') %></button>
			<button type="button" id="store_register_close" class="store_register_button store_register_close"><%= &subs::lang('common.close') %></button>
		</div>
	</header>

	<div id="store_register_till" class="store_register_till" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;padding:6px 12px;">
		<span class="store_register_till_label"><%= &subs::ui('Till') %></span>
		<span id="store_register_till_shift" class="store_register_till_shift"></span>
		<button type="button" id="store_register_till_open" class="store_register_button"><%= &subs::ui('Open till') %></button>
		<button type="button" id="store_register_till_eod" class="store_register_button" style="display:none;"><%= &subs::ui('End of day') %></button>
		<span id="store_register_till_status" class="store_register_till_status" role="status" aria-live="polite"></span>
	</div>

	<div id="store_register_till_panel" class="store_register_till_panel" style="display:none;gap:10px;align-items:center;flex-wrap:wrap;padding:6px 12px;">
		<label class="store_register_till_field">
			<span><%= &subs::ui('Associate') %></span>
			<input type="text" id="store_register_till_associate" autocomplete="off">
		</label>
		<label class="store_register_till_field">
			<span><%= &subs::ui('Till PIN') %></span>
			<input type="password" inputmode="numeric" maxlength="8" id="store_register_till_pin" autocomplete="off">
		</label>
		<button type="button" id="store_register_till_pin_unlock" class="store_register_button"><%= &subs::ui('Use PIN') %></button>
		<label class="store_register_till_field">
			<span><%= &subs::ui('Tag token') %></span>
			<input type="text" id="store_register_till_tag_secret" autocomplete="off">
		</label>
		<button type="button" id="store_register_till_tag_unlock" class="store_register_button"><%= &subs::ui('Use tag token') %></button>
		<button type="button" id="store_register_till_tag_scan" class="store_register_button"><%= &subs::ui('Tap tag') %></button>
		<% if ($webauthn_available) { %>
			<button type="button" id="store_register_till_passkey" class="store_register_button" style="display:none;"><%= &subs::ui('Use passkey') %></button>
		<% } %>
		<label class="store_register_till_field">
			<span><%= &subs::ui('Float') %></span>
			<input type="text" inputmode="decimal" id="store_register_till_float" value="0.00">
		</label>
		<button type="button" id="store_register_till_start" class="store_register_button"><%= &subs::ui('Start shift') %></button>
		<button type="button" id="store_register_till_cancel" class="store_register_button"><%= &subs::ui('Cancel') %></button>
		<span id="store_register_till_unlocked" class="store_register_till_unlocked" role="status" aria-live="polite"></span>
		<span id="store_register_till_unlock_status" class="store_register_till_status" role="status" aria-live="polite"></span>
	</div>

	<div id="store_register_till_close_panel" class="store_register_till_close_panel" style="display:none;gap:10px;align-items:center;flex-wrap:wrap;padding:6px 12px;">
		<span><%= &subs::ui('Expected') %> <b id="store_register_till_expected">$0.00</b></span>
		<span class="store_register_till_unlocked"><%= &subs::ui('Unlocked') %> <b id="store_register_till_close_unlocked"></b></span>
		<label class="store_register_till_field">
			<span><%= &subs::ui('Counted') %></span>
			<input type="text" inputmode="decimal" id="store_register_till_counted" value="0.00">
		</label>
		<span><%= &subs::ui('Over / short') %> <b id="store_register_till_over_short">$0.00</b></span>
		<label class="store_register_till_field">
			<span><%= &subs::ui('Notes') %></span>
			<input type="text" id="store_register_till_notes" autocomplete="off">
		</label>
		<label class="store_register_till_field">
			<span><%= &subs::ui('Till PIN') %></span>
			<input type="password" inputmode="numeric" maxlength="8" id="store_register_till_close_pin" autocomplete="off">
		</label>
		<button type="button" id="store_register_till_close_pin_unlock" class="store_register_button"><%= &subs::ui('Use PIN') %></button>
		<label class="store_register_till_field">
			<span><%= &subs::ui('Tag token') %></span>
			<input type="text" id="store_register_till_close_tag_secret" autocomplete="off">
		</label>
		<button type="button" id="store_register_till_close_tag_unlock" class="store_register_button"><%= &subs::ui('Use tag token') %></button>
		<% if ($webauthn_available) { %>
			<button type="button" id="store_register_till_close_passkey" class="store_register_button" style="display:none;"><%= &subs::ui('Use passkey') %></button>
		<% } %>
		<span id="store_register_till_close_unlock_status" class="store_register_till_status" role="status" aria-live="polite"></span>
		<button type="button" id="store_register_till_finish" class="store_register_button"><%= &subs::ui('End of day') %></button>
		<button type="button" id="store_register_till_close_cancel" class="store_register_button"><%= &subs::ui('Cancel') %></button>
	</div>

	<div id="store_register_till_report" class="store_register_till_report" style="display:none;padding:6px 12px;">
		<div id="store_register_till_report_paper" class="store_register_till_report_paper"></div>
		<button type="button" id="store_register_till_print" class="store_register_button"><%= &subs::lang('common.print') %></button>
		<button type="button" id="store_register_till_report_close" class="store_register_button"><%= &subs::lang('common.close') %></button>
	</div>

	<div id="store_register_tabs" class="store_register_tabs" role="tablist"></div>

	<div class="store_register_body">
		<section class="store_register_order" aria-live="polite">
			<div class="store_register_customer">
				<span class="store_register_customer_label"><%= &subs::lang('common.customer') %></span>
				<strong id="store_register_customer_name">—</strong>
				<div class="store_register_exemption">
					<label class="store_register_exempt_toggle">
						<input type="checkbox" id="store_register_tax_exempt">
						<%= &subs::ui('Tax exempt') %>
					</label>
					<input type="text" id="store_register_tax_exemption" class="store_register_exemption_id" placeholder="<%= &subs::ui('Exemption ID') %>" style="display:none;">
				</div>
				<button type="button" id="store_register_customer_open" class="store_register_button" hint="<%= &subs::ui('Name this customer') %>"><%= &subs::ui('Name this customer') %></button>
			</div>

			<div id="store_register_customer_panel" class="store_register_customer_panel" style="display:none;">
				<label class="store_register_customer_field">
					<span><%= &subs::ui('Search a name') %></span>
					<input type="search" id="store_register_customer_search" autocomplete="off">
				</label>
				<div id="store_register_customer_results" class="store_register_customer_results"></div>
				<div class="store_register_customer_new">
					<label class="store_register_customer_field">
						<span><%= &subs::ui('Or add them as') %></span>
						<select id="store_register_customer_kind">
							<% foreach my $scons ( sort { $a->{'order'} <=> $b->{'order'} } values %{$gb::social_constructs} ) { %>
								<option value="<%= $scons->{'sing'} %>"><%= &subs::ui(&subs::format_name($scons->{'sing'})) %></option>
							<% } %>
						</select>
					</label>
					<label class="store_register_customer_field">
						<span><%= &subs::lang('common.name') %></span>
						<input type="text" id="store_register_customer_new_name" autocomplete="off">
					</label>
					<button type="button" id="store_register_customer_save" class="store_register_button"><%= &subs::ui('Add and use') %></button>
				</div>
				<div id="store_register_customer_status" class="store_register_customer_status" role="status" aria-live="polite"></div>
			</div>

			<div id="store_register_items" class="store_register_items"></div>

			<div class="store_register_totals">
				<span><%= &subs::lang('common.quantity') %> <b id="store_register_quantity">0</b></span>
				<span><%= &subs::lang('common.total') %> <b id="store_register_total">$0.00</b></span>
			</div>
			<div id="store_register_tax_lines" class="store_register_tax_lines"></div>

			<label class="store_register_search_wrap">
				<span class="store_register_search_label"><%= &subs::lang('common.item') %></span>
				<input type="search" id="store_register_search" autocomplete="off" placeholder="<%= &subs::lang('common.search') %>">
			</label>
			<div id="store_register_results" class="store_register_results" aria-live="polite"></div>
		</section>

		<section class="store_register_pay" aria-live="polite">
			<h3 class="store_register_pay_title"><%= &subs::lang('store.payment_method') %></h3>
			<div id="store_register_methods" class="store_register_methods" role="group" aria-label="<%= &subs::lang('store.payment_method') %>">
				<% foreach my $method ( @{ &subs::store_register_payment_methods() } ) { %>
					<button type="button" class="store_register_method" data-method="<%= $method %>"><%= &subs::store_register_payment_label($method) %></button>
				<% } %>
			</div>

			<div id="store_register_cash" class="store_register_cash">
				<div class="store_register_cash_label"><%= &subs::lang('common.cash') %> · <%= &subs::lang('store.received') %></div>
				<div class="store_register_denominations" role="group" aria-label="<%= &subs::lang('common.cash') %>">
					<button type="button" class="store_register_denomination" data-amount="5"><%= &subs::price_formatter(5) %></button>
					<button type="button" class="store_register_denomination" data-amount="10"><%= &subs::price_formatter(10) %></button>
					<button type="button" class="store_register_denomination" data-amount="20"><%= &subs::price_formatter(20) %></button>
					<button type="button" class="store_register_denomination" data-amount="50"><%= &subs::price_formatter(50) %></button>
					<button type="button" class="store_register_denomination" data-amount="100"><%= &subs::price_formatter(100) %></button>
				</div>
				<div class="store_register_coins" role="group" aria-label="<%= &subs::ui('Common change') %>">
					<% foreach my $coin ( qw(0.05 0.10 0.25 1 2) ) { %>
						<button type="button" class="store_register_coin" data-add="<%= $coin %>"><%= &subs::price_formatter($coin) %></button>
					<% } %>
				</div>
				<label class="store_register_received_wrap">
					<span><%= &subs::lang('store.received') %></span>
					<input type="text" inputmode="decimal" id="store_register_received" value="0.00">
				</label>
				<div class="store_register_change_row">
					<span><%= &subs::lang('store.change') %></span>
					<strong id="store_register_change">$0.00</strong>
				</div>
				<div id="store_register_rounding" class="store_register_rounding" style="display:none;font-size:13px;opacity:.8;margin-top:4px;"></div>
				<div id="store_register_breakdown" class="store_register_breakdown"></div>
			</div>

			<div class="store_register_commit">
				<button type="button" id="store_register_complete" class="store_register_complete"><%= &subs::lang('store.complete_sale') %></button>
				<button type="button" id="store_register_void" class="store_register_void"><%= &subs::lang('store.void') %></button>
			</div>
			<div id="store_register_status" class="store_register_status" role="status" aria-live="polite" style="display:none;"></div>
		</section>
	</div>

	<div id="store_register_receipt" class="store_register_receipt" style="display:none;">
		<div class="store_register_receipt_bar">
			<h3><%= &subs::lang('store.sale_complete') %></h3>
			<div>
				<button type="button" id="store_register_print" class="store_register_button"><%= &subs::lang('common.print') %></button>
				<button type="button" id="store_register_receipt_close" class="store_register_button"><%= &subs::lang('common.close') %></button>
			</div>
		</div>
		<div id="store_register_receipt_paper"></div>
	</div>
</div>
