<% no warnings 'uninitialized'; %>
<div id="store_register" class="store_register" data-cx="<%= $cx %>" role="dialog" aria-modal="true" aria-label="<%= &subs::lang('common.register') %>">
	<header class="store_register_header">
		<h2 class="store_register_title"><%= &subs::lang('common.register') %></h2>
		<div class="store_register_header_actions">
			<button type="button" id="store_register_last_receipt" class="store_register_button" style="display:none;"><%= &subs::lang('common.receipt') %></button>
			<button type="button" id="store_register_new" class="store_register_button"><%= &subs::lang('store.new_order') %></button>
			<button type="button" id="store_register_close" class="store_register_button store_register_close"><%= &subs::lang('common.close') %></button>
		</div>
	</header>

	<div id="store_register_tabs" class="store_register_tabs" role="tablist"></div>

	<div class="store_register_body">
		<section class="store_register_order" aria-live="polite">
			<div class="store_register_customer">
				<span class="store_register_customer_label"><%= &subs::lang('common.customer') %></span>
				<strong id="store_register_customer_name">—</strong>
			</div>

			<div id="store_register_items" class="store_register_items"></div>

			<div class="store_register_totals">
				<span><%= &subs::lang('common.quantity') %> <b id="store_register_quantity">0</b></span>
				<span><%= &subs::lang('common.total') %> <b id="store_register_total">$0.00</b></span>
			</div>

			<label class="store_register_search_wrap">
				<span class="store_register_search_label"><%= &subs::lang('common.item') %></span>
				<input type="search" id="store_register_search" autocomplete="off" placeholder="<%= &subs::lang('common.search') %>">
			</label>
			<div id="store_register_results" class="store_register_results" aria-live="polite"></div>
		</section>

		<section class="store_register_pay" aria-live="polite">
			<h3 class="store_register_pay_title"><%= &subs::lang('store.payment_method') %></h3>
			<div id="store_register_methods" class="store_register_methods" role="group" aria-label="<%= &subs::lang('store.payment_method') %>">
				<% foreach my $method ( @{ &subs::store_register_payment_methods() } ) { %>
					<button type="button" class="store_register_method" data-method="<%= $method %>"><%= &subs::store_register_payment_label($method) %></button>
				<% } %>
			</div>

			<div id="store_register_cash" class="store_register_cash">
				<div class="store_register_cash_label"><%= &subs::lang('common.cash') %> · <%= &subs::lang('store.received') %></div>
				<div class="store_register_denominations" role="group" aria-label="<%= &subs::lang('common.cash') %>">
					<button type="button" class="store_register_denomination" data-amount="5"><%= &subs::price_formatter(5) %></button>
					<button type="button" class="store_register_denomination" data-amount="10"><%= &subs::price_formatter(10) %></button>
					<button type="button" class="store_register_denomination" data-amount="20"><%= &subs::price_formatter(20) %></button>
					<button type="button" class="store_register_denomination" data-amount="50"><%= &subs::price_formatter(50) %></button>
					<button type="button" class="store_register_denomination" data-amount="100"><%= &subs::price_formatter(100) %></button>
				</div>
				<div class="store_register_coins" role="group" aria-label="<%= &subs::ui('Common change') %>">
					<% foreach my $coin ( qw(0.05 0.10 0.25 1 2) ) { %>
						<button type="button" class="store_register_coin" data-add="<%= $coin %>"><%= &subs::price_formatter($coin) %></button>
					<% } %>
				</div>
				<label class="store_register_received_wrap">
					<span><%= &subs::lang('store.received') %></span>
					<input type="text" inputmode="decimal" id="store_register_received" value="0.00">
				</label>
				<div class="store_register_change_row">
					<span><%= &subs::lang('store.change') %></span>
					<strong id="store_register_change">$0.00</strong>
				</div>
				<div id="store_register_breakdown" class="store_register_breakdown"></div>
			</div>

			<div class="store_register_commit">
				<button type="button" id="store_register_complete" class="store_register_complete"><%= &subs::lang('store.complete_sale') %></button>
				<button type="button" id="store_register_void" class="store_register_void"><%= &subs::lang('store.void') %></button>
			</div>
			<div id="store_register_status" class="store_register_status" role="status" aria-live="polite" style="display:none;"></div>
		</section>
	</div>

	<div id="store_register_receipt" class="store_register_receipt" style="display:none;">
		<div class="store_register_receipt_bar">
			<h3><%= &subs::lang('store.sale_complete') %></h3>
			<div>
				<button type="button" id="store_register_print" class="store_register_button"><%= &subs::lang('common.print') %></button>
				<button type="button" id="store_register_receipt_close" class="store_register_button"><%= &subs::lang('common.close') %></button>
			</div>
		</div>
		<div id="store_register_receipt_paper"></div>
	</div>
</div>
