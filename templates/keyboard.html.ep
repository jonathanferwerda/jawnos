<% use Mojo::JSON qw/decode_json/; %>
<span class="typewriter" style="">

	<% if ($toggle eq 'remote_control') { %>
		<span class="keyboard bc theme_surface" id="remote_control" style="background-color:<%= $config->{$device}->{'remote_control'}->{'background_colour'} %>">
			<% $remote_control = defined $remote_control ? $remote_control : &subs::setting_grabber({ app => 'me', setting => 'remote_control_machine' }); %>
			<% $remote_machines = ref $remote_machines eq 'ARRAY' ? $remote_machines
				: ($remote_machines ? (eval { decode_json $remote_machines } || []) : &subs::remote_machine_lister()); %>
			<% my @rm_options = grep { ($_->{'mirror'} || '') ne 'yes' && ($_->{'hostname'} || '') !~ / \(mirror\)$/ && ($_->{'hostname'} || '') ne 'me' } @{$remote_machines}; %>
			<%# A pick saved before uuids (an ip or a signatorial) still names its machine. %>
			<% my $pick = (defined $remote_control && !ref $remote_control) ? $remote_control : ''; %>
			<% my ($selected_rm) = grep { $pick ne '' && (($_->{'uuid'} || '') eq $pick || ($_->{'signatorial'} || '') eq $pick || ($_->{'ip'} || '') eq $pick) } @rm_options; %>
			<% $remote_control = $selected_rm ? ($selected_rm->{'uuid'} || '') : ''; %>

			<select id="remote_control_machine_select" value="<%= $remote_control %>" onchange="settingSetter({ 'app': 'me', 'setting': 'remote_control_machine', 'value': this.value });keyboardManagerButton(this);keyboardMaker({ toggle: 'remote_control', state: 'on', remote_uuid: this.value })" style="vertical-align:top;">
				<option value="" <% if ( !$selected_rm ) { %>selected<% } %>>Me</option>
				<% foreach my $rm ( @rm_options ) { %>
					<option value="<%= $rm->{'uuid'} %>" manager="<%= $rm->{'manager'} %>" data-tailnet="<%= &subs::tailnet_address($rm) %>" <% if ( $selected_rm && ($rm->{'uuid'} || '') eq ($selected_rm->{'uuid'} || '') ) { %>selected<% } %>><%= $rm->{'hostname'} || $rm->{'domain'} || $rm->{'ip'} %></option>
				<% } %>
			</select>
			<button type="button" id="remote_control_go" class="remote_manager_open" uuid="<%= $selected_rm ? $selected_rm->{'uuid'} : '' %>" manager="<%= $selected_rm ? $selected_rm->{'manager'} : '' %>" hint="<%= &subs::ui("Open this machine's Manager") %>" <% if (!$selected_rm) { %>style="display:none;"<% } %>><%= &subs::lang('common.go') %></button>
			<button type="button" id="remote_control_vpn" class="hover" hint="<%= &subs::ui("Route this device's web traffic through the exit node chosen on the Me view") %>" status="off" style="display:none;"><%= &subs::lang('vpn') %></button>
			<img class="jonathan little_thumb keyboard_config_toggle" onclick="keyboardConfigToggle('remote_control')" src="<%= &subs::icon_for('/images/decipherable/wrench.png') %>" hint="Configure"></img>
			<br>
			<div id="remote_control_view" class="keyboard_content">
				<% my $public_ip_choice = &subs::public_ip_check_choice(); %>
				<% if ( !$selected_rm ) { %>
					ME!<br>
					<%= &subs::device_setter() %><br>
					<% if ($public_ip_choice ne 'none') { %>
						<span id="local_public_ip_row"><%= &subs::lang('remote_control.public_ip') %>: <span id="local_public_ip" class="clip" hint="<%= &subs::ui('Click to copy the public address') %>">…</span></span>
					<% } elsif (&subs::device_setter() eq 'server') { %>
						<% my $server_public_ip = &subs::public_interface_address({ network => &subs::network_interface_reporter() }); %>
						<% if ($server_public_ip) { %><%= &subs::lang('remote_control.public_ip') %>: <span class="clip" hint="<%= &subs::ui('Click to copy the public address') %>"><%= $server_public_ip %></span><% } %>
					<% } %>
					<span id="remote_control_vpn_row" style="display:none;"><br><%= &subs::lang('vpn') %>: <select id="remote_control_vpn_node" hint="<%= &subs::ui('The machine your web traffic leaves from while the VPN is on') %>" style="vertical-align:top;"></select></span>
				<% } else { %>
					<%= $selected_rm->{'hostname'} || $selected_rm->{'fqdn'} || $selected_rm->{'ip'} %><br>
					<%= $selected_rm->{'ip'} %><br>
					<% my $rm_public_ip = $public_ip_choice ne 'none'
						? &subs::remote_public_address($selected_rm)
						: (($selected_rm->{'device'} || '') eq 'server' ? &subs::public_interface_address($selected_rm) : ''); %>
					<% if ($rm_public_ip) { %><%= &subs::lang('remote_control.public_ip') %>: <span id="remote_public_ip" class="clip" hint="<%= &subs::ui('Click to copy the public address') %>"><%= $rm_public_ip %></span><br><% } %>
					<%= &subs::device_setter() %><br>
					<%= $selected_rm->{'uuid'} %>
				<% } %>

				<br><span id="manager_file" style=""><%= $selected_rm ? ($selected_rm->{'manager_file'} || '') : $manager_file %></span>
				<div id="remote_command_box" style="margin-top:6px;">
					<input id="remote_command_text" placeholder="Tell that machine to..." style="width:65%;vertical-align:top;" onkeydown="if(event.key==='Enter'){jawnosRemoteCommand();}">
					<button type="button" id="remote_command_send">Send</button>
					<div id="remote_command_reply" style="font-size:13px;opacity:0.85;"></div>
				</div>
				<%# Keyboard and mouse sharing: the screen picked above is treated as
				    sitting on one side of this view. Taking control sends this
				    machine's pointer and keys to that screen, and moving back to the
				    far edge (or pressing Escape) returns them here. The setting is
				    per peer, because a laptop is usually to one side and a table to
				    another. %>
				<% my $ri_on = &subs::setting_grabber({ app => 'me', setting => 'remote_control_input' }); %>
				<% my $ri_edge = $remote_control ? &subs::setting_grabber({ app => 'me', setting => 'remote_control_edge', subsetting => $remote_control }) : ''; %>
				<% $ri_edge = 'right' unless defined $ri_edge && $ri_edge =~ /^(?:left|right|top|bottom)$/; %>
				<% my $ri_display = $selected_rm ? '' : 'display:none;'; %>
				<div id="remote_input_controls" remote_uuid="<%= $remote_control %>" data-edge="<%= $ri_edge %>" style="<%= $ri_display %>margin-top:8px;border-top:1px solid rgba(128,128,128,.35);padding-top:6px;">
					<label style="display:block;"><input type="checkbox" id="remote_input_enabled" <% if (defined $ri_on && $ri_on eq 'on') { %>checked="checked"<% } %>> <%= &subs::lang('remote_control.input') %></label>
					<span id="remote_input_edge_row" style="display:block;margin-top:3px;opacity:<% if (defined $ri_on && $ri_on eq 'on') { %>1<% } else { %>.55<% } %>;">
						<%= &subs::lang('remote_control.that_screen') %>
						<select id="remote_input_edge">
							<option value="left" <% if ($ri_edge eq 'left') { %>selected<% } %>><%= &subs::lang('remote_control.edge_left') %></option>
							<option value="right" <% if ($ri_edge eq 'right') { %>selected<% } %>><%= &subs::lang('remote_control.edge_right') %></option>
							<option value="top" <% if ($ri_edge eq 'top') { %>selected<% } %>><%= &subs::lang('remote_control.edge_top') %></option>
							<option value="bottom" <% if ($ri_edge eq 'bottom') { %>selected<% } %>><%= &subs::lang('remote_control.edge_bottom') %></option>
						</select>
					</span>
					<span style="display:block;margin-top:4px;">
						<button type="button" id="remote_input_take" class="hover" hint="<%= &subs::ui('Send this machine\'s keyboard and mouse to the selected machine') %>"><%= &subs::lang('remote_control.take') %></button>
						<button type="button" id="remote_input_return" class="hover" style="display:none;" hint="<%= &subs::ui('Bring the keyboard and mouse back to this machine') %>"><%= &subs::lang('remote_control.release') %></button>
						<span id="remote_input_state" style="font-size:12px;opacity:.85;"></span>
					</span>
					<div id="remote_input_type_wrap" style="display:none;margin-top:4px;">
						<input type="text" id="remote_input_type" style="width:65%;vertical-align:top;" placeholder="<%= &subs::ui('Type to that machine...') %>" autocomplete="off" autocapitalize="off" spellcheck="false">
					</div>
					<textarea id="remote_input_clipboard" style="display:none;width:90%;height:48px;margin-top:4px;" placeholder="<%= &subs::ui('Clipboard from that machine') %>" spellcheck="false"></textarea>
				</div>
				<% if (!$selected_rm) { %>
					<div style="font-size:12px;opacity:.7;margin-top:6px;"><%= &subs::ui('Pick a machine other than Me to control its keyboard and mouse.') %></div>
				<% } %>
			</div>
			<div toggle="<%= $toggle %>" class="keyboard_config remote_control_configuration" style="display:none;width:100%;" remote_uuid="<%= $remote_control %>">
				Keyboard Config
			</div>
		</span>

	<% } %>
<%# The keyboard's panels have moved to the apps that own their surface:
    Notifications is its own app and a taskbar widget; the Controller is a
    Network tab; the time machine (formerly delorean) and Sessions are Clock
    tabs; Walkboy is the Sound app's Media devices list; and the keyboard and
    calculator are start menu apps with Ctrl+Super+K and Ctrl+Super+C. Their
    old dock faces start off, so this template now draws only Remote control.
    The music receiver strip is still carried by the websocket table, now in
    the Network app. Keep the panel data server-side with the app, not here. %>
</span>

