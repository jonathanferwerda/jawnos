<canvas id="twirl" style="background-color:var(--panel);width:100%;height:100%;">
</canvas>
<script>
	var twirlHighScore = '<%= $settings->{'high_score'} %>';
	var twirlHighScoreInitials = '<%= $settings->{'high_score_initials'} %>';
	<% my $hs_js = ($settings->{'high_scores'} && $settings->{'high_scores'} ne '') ? $settings->{'high_scores'} : '[]'; $hs_js =~ s/\\/\\\\/g; $hs_js =~ s/'/\\'/g; $hs_js =~ s{</}{<\\/}g; %>
	var twirlHighScores = '<%== $hs_js %>';
	twirlGame();
</script>