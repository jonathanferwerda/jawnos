<% use Mojo::JSON qw/encode_json/; %>
<%
	# Footswitch artwork is colour-specific, so resolve every existing colour through
	# the selected icon set here and hand the map to studio.js.
	my %jawnos_button_icons;
	foreach my $state (qw/pressed depressed/) {
		foreach my $f (glob('public/images/studio/button_' . $state . '_*.png')) {
			my ($colour) = $f =~ m{button_${state}_(.+)\.png$};
			$jawnos_button_icons{$state}->{$colour} = &subs::icon_for('/images/studio/button_' . $state . '_' . $colour . '.png');
		}
	}
	my $button_icon = sub {
		my ($state, $colour) = @_;
		return $jawnos_button_icons{$state}->{$colour} if $jawnos_button_icons{$state}->{$colour};
		return '/images/studio/button_' . $state . '_' . $colour . '.png';
	};
%>
<script>window.jawnos_studio_button_icons = <%== encode_json \%jawnos_button_icons %>;</script>
<div id="studio" uuid="<%= $last_song->{'uuid'} %>" name="<%= $last_song->{'name'} %>">
	<audio id="metronome" autoplay style="display:none;"></audio>
	<div id="studio_plug_select_container" style="position:fixed;display:none;background-color:lightgreen;z-index:50009;border:solid;border-radius:4px;"></div>
	<div id="pedalboard" style="display:none;">
		<% my $count = 0; %>
		<% foreach my $p ( @{$gb::studio->{'pedals'}} ) { %>
			<span id="pedal_<%= $p->{'name'} %>" class="pedal" style="left:<%= $count * 175 %>px;">
				<% my $ch = $p->{'name'}; %>
				<img class="pedal_background" hint="<%= $p->{'name'} %>" src="/images/studio/<%= $p->{'image'} %>.png">
				<% foreach my $k ( @{$p->{'knobs'}} ) { %>
					<input type="range" channel="<%= $ch %>" name="<%= $k->{'control'} %>" control="<%= $k->{'control'} %>" class="knob_control <%= $k->{'control'} %>" style="display:none;left:3px;">
					<img class="knob <%= $k->{'control'} %>" style="position:absolute;width:<%= $k->{'width'} || '60px' %>;left:<%= $k->{'left'} %>;top:<%= $k->{'top'} %>;"  flip="<%= $k->{'flip'} %>" direction="<%= $k->{'direction'} %>" channel="<%= $ch %>" control="<%= $k->{'control'} %>" hint="<%= &subs::format_name($k->{'control'}) %>" src="/images/studio/knob_<%= $k->{'colour'} %>.png">

				<% } %>
				<% foreach my $b ( @{$p->{'buttons'}} ) { %>
					<img class="button_control" style="position:absolute;height:<%= $b->{'height'} || $b->{'width'} || '60px' %>;width:<%= $b->{'width'} || '60px'; %>;left:<%= $b->{'left'} %>;top:<%= $b->{'top'} %>;"  flip="<%= $b->{'flip'} %>" state="<%= $b->{'status'} || "depressed" %>" channel="<%= $ch %>" control="<%= $b->{'control'} %>" colour="<%= $b->{'colour'} %>" src="<%= $button_icon->('depressed', $b->{'colour'}) %>">
				<% } %>
			</span>
			<% $count++; %>
		<% } %>
	</div>
	<% my $channel_count = $settings->{'channel_count'} || 4; %>
	<div id="studio_viewer" style="height:200px;" channel_count="<%= $channel_count %>">
		<% for (my $ch = 1; $ch <= $channel_count; $ch++) { %>
			<canvas style="width:95%;height:calc(90% / <%= $channel_count + 1 %>);border:solid;" class="track track_<%= $ch %>" id="track_view_<%= $ch %>" hint="Drag to move a clip, its edges to trim, double-click to cut, select + Delete to remove">track name <%= $ch %></canvas>
		<% } %>
	</div>
	<div id="studio_mixer">
		<% for (my $ch = 1; $ch <= $channel_count; $ch++) { %>
			<span class="channel channel_<%= $ch %>">
				<img class="tiny_thumb jack studio_jack hover" hint="Jack" src="<%= &subs::icon_for('/images/studio/jack.png') %>" channel="<%= $ch %>">
				<div class="studio_channel_information" style="display:none;" channel="<%= $ch %>" direction="input"></div>

				<% foreach my $k ( grep { $_->{'placement'} eq 'channel' } @{$gb::studio->{'knobs'}}) { %>
					<input type="range" channel="<%= $ch %>" name="<%= $k->{'control'} %>" control="<%= $k->{'control'} %>" class="knob_control <%= $k->{'control'} %>" style="display:none;left:3px;">
					<img class="knob <%= $k->{'control'} %>" flip="<%= $k->{'flip'} %>" direction="<%= $k->{'direction'} %>" channel="<%= $ch %>" control="<%= $k->{'control'} %>" hint="<%= &subs::format_name($k->{'control'}) %>" src="/images/studio/knob_<%= $k->{'colour'} %>.png">
					<span class="to_sound" channel="<%= $ch %>" >
						<img class="cord draggable" hint="Cord" style="display:none;" control="input" channel="<%= $ch %>" src="<%= &subs::icon_for('/images/studio/cord.png') %>">
					</span>
				<% } %>
				<img class="tiny_thumb jack studio_cord hover" hint="Cord" src="<%= &subs::icon_for('/images/studio/cord.png') %>" channel="<%= $ch %>">
				<div class="studio_channel_information" style="display:none;" channel="<%= $ch %>" direction="output"></div>
				<button class="armed" channel="<%= $ch %>" control="armed" state="off">O</button>
				<span class="channel_fx" channel="<%= $ch %>" hint="Inserted pedals (drag a pedal here)"></span>
				<span class="channel_fader">
					<canvas class="channel_volume_metre channel_volume_metre_<%= $ch %>" id="channel_volume_metre_<%= $ch %>"></canvas>
					<input height="50" channel="<%= $ch %>" type="range" min="0" max="100" control="volume" class="channel_volume channel_volume_<%= $ch %>" value="1">
				</span>

			</span>
		<% } %>
		<span id="studio_controls">
			<span style="left:2px;top:50px;position:absolute;">

				<img class="little_thumb record hover" hint="Record" id="studio_record" src="<%= &subs::icon_for('/images/make believe/record.png') %>">
				<img class="little_thumb play hover" hint="Play" id="studio_play" src="<%= &subs::icon_for('/images/make believe/play.png') %>">
				<img class="little_thumb stop hover" hint="Stop" id="studio_stop" src="<%= &subs::icon_for('/images/make believe/stop.png') %>">
				<img class="little_thumb prev hover" hint="Previous" id="studio_prev" src="<%= &subs::icon_for('/images/make believe/left arrow.png') %>">
				<img class="little_thumb next hover" hint="Next" id="studio_next" src="<%= &subs::icon_for('/images/make believe/right arrow.png') %>">

			</span>
			<span style="left:2px;top:95px;position:absolute;">
				<img class="little_thumb mark hover" hint="Drop a mark" id="studio_mark" src="<%= &subs::icon_for('/images/studio/plus.png') %>">
				<img class="little_thumb metronome hover" hint="Metronome" id="studio_metronome" src="<%= &subs::icon_for('/images/studio/metronome.png') %>">
				<input style="width:50px;vertical-align:top;" id="studio_bpm" value="120">
				<input style="width:50px;vertical-align:top;" id="studio_signature" value="4/4">
				<% foreach my $k ( grep { $_->{'placement'} eq 'metronome' } @{$gb::studio->{'knobs'}}) { %>
					<input channel="metronome" type="range" name="<%= $k->{'control'} %>" control="<%= $k->{'control'} %>" class="knob_control <%= $k->{'control'} %>" style="display:none;left:3px;">
					<img class="knob <%= $k->{'control'} %>" style="position:absolute;width:<%= $k->{'width'} || '60px' %>;left:<%= $k->{'left'} %>;top:<%= $k->{'top'} %>;"  flip="<%= $k->{'flip'} %>" direction="<%= $k->{'direction'} %>" channel="metronome" control="<%= $k->{'control'} %>" hint="<%= &subs::format_name($k->{'control'}) %>" src="/images/studio/knob_<%= $k->{'colour'} %>.png">
				<% } %>
			</span>
			<span style="left:2px;top:140px;position:absolute;">

			</span>
			<span style="left:2px;top:190px;position:absolute;">
				<img class="little_thumb hover video_toggle" hint="Camera" id="studio_video_toggle" src="<%= &subs::icon_for('/images/make believe/camera.png') %>">
				<img class="little_thumb hover" hint="Pedalboard" src="<%= &subs::icon_for('/images/make believe/burger.png') %>" id="pedalboard_hamburger">
				<img class="little_thumb hover" hint="Configure" src="<%= &subs::icon_for('/images/decipherable/gear.png') %>" id="studio_config_toggle">
				<img src="<%= &subs::icon_for('/images/studio/repeat.png') %>" hint="Loop" class="little_thumb hover" id="studio_loop">
			</span>
			<span style="left:2px;top:240px;position:absolute;">
				<span id="studio_time_display">
					0:00
				</span><br>
				<span id="studio_time_duration">
					0:00
				</span>

			</span>
			<span id="studio_video_monitors" style="position:absolute;height:110px;top:300px;width:100%;">
				<% for (my $ch = 1; $ch <= $channel_count; $ch++) { %>
					<video id="studio_video_monitor_<%= $ch %>" style="display:none;height:100%;" muted autoplay class=""></video>
				<% } %>
			</span>
			<video id="studio_video_monitor" style="position:absolute;left:510px;top:311px;width:200px;" muted autoplay class=""></video>


		</span>
		<span class="jog_wheel_frame">
			<img class="jog_wheel" hint="Jog wheel" id="studio_jog_wheel" src="/images/studio/jog wheel tye dye.png">
			<span class="jog_wheel_centre" style="width:5px;height:5px;"></span>
		</span>
	</div>
	<div id="studio_track_container"></div>
	<div id="studio_config" style="display:none; width:100%;background-color:var(--panel);">
		<h1>Configure</h1>

		<div id="song_controls" style="">
			<img id="studio_new" hint="New song" style="vertical-align:top;" class="little_thumb hover" src="<%= &subs::icon_for('/images/decipherable/file.png') %>">
			<%= include 'studio/song_select', songs => $songs, last_song => $last_song %>
			<img id="studio_save" hint="Save" style="vertical-align:top;" class="little_thumb hover" src="<%= &subs::icon_for('/images/decipherable/diskette.png') %>">
			<img id="studio_delete" hint="Delete" style="vertical-align:top;" class="little_thumb hover" src="<%= &subs::icon_for('/icons/trash.png') %>">
			<img class="little_thumb hover" hint="Configure" src="<%= &subs::icon_for('/images/decipherable/gear.png') %>" id="studio_config_toggle"><br>
			<input type="hidden" id="studio_name">
		</div>
		<div>
			<table style="width:98%;">
				<thead>
					<th>Setting</th>
					<th>Value</th>
				</thead>
				<tbody>
					<tr>
						<td>Channels</td>
						<td><input class="studio_config" setting="channel_count" value="<%= $settings->{'channel_count'} || 4 %>" restart="yes"></td>
					</tr>
					<tr>
						<td>Record offset (ms)<br><span style="font-size:12px;">shifts new takes earlier to cancel input latency</span></td>
						<td><input class="studio_config" setting="record_offset" value="<%= $settings->{'record_offset'} || '' %>"></td>
					</tr>
					<tr>
						<td>Crossfade (s)<br><span style="font-size:12px;">clips that meet ramp into each other</span></td>
						<td><input class="studio_config" setting="crossfade" value="<%= $settings->{'crossfade'} || '' %>"></td>
					</tr>
					<tr>
						<td>Loop bars<br><span style="font-size:12px;">arm a channel to L and record: the phrase loops over this many bars from where recording starts. 0 lets the phrase run free (its length follows Start on).</span></td>
						<td><input class="studio_config" setting="loop_bars" value="<%= $settings->{'loop_bars'} || 4 %>"></td>
					</tr>
					<tr>
						<td>Start on<br><span style="font-size:12px;">where a recording locks when it begins: the bar line, the nearest beat, or nothing at all (free wheeling from the playhead)</span></td>
						<td>
							<select class="studio_config" setting="snap">
								<option value="bar"<%= (($settings->{'snap'} || 'bar') eq 'bar') ? ' selected' : '' %>>bar</option>
								<option value="beat"<%= (($settings->{'snap'} || 'bar') eq 'beat') ? ' selected' : '' %>>beat</option>
								<option value="off"<%= (($settings->{'snap'} || 'bar') eq 'off') ? ' selected' : '' %>>off (free)</option>
							</select>
						</td>
					</tr>
					<tr>
						<td>Count-in (beats)<br><span style="font-size:12px;">clicks this many beats before recording starts; blank follows the signature (4 in 4/4), 0 turns it off</span></td>
						<td><input class="studio_config" setting="count_in" value="<%= $settings->{'count_in'} || '' %>"></td>
					</tr>
					<tr>
						<td>Monitor input<br><span style="font-size:12px;">hear the live input through the pedals: headphones only, speakers will feed back</span></td>
						<td>
							<select class="studio_config" setting="monitor">
								<option value="no"<%= (($settings->{'monitor'} || 'no') eq 'no') ? ' selected' : '' %>>no</option>
								<option value="yes"<%= (($settings->{'monitor'} || 'no') eq 'yes') ? ' selected' : '' %>>yes</option>
							</select>
						</td>
					</tr>
					<tr>
						<td colspan="2" style="padding-top:14px;"><b>Recording quality</b><br><span style="font-size:12px;">applies to the next recording. Bit depth is not selectable: browser recorders always encode Opus or AAC, so the sample rate, channels and bit rate are the quality knobs that exist.</span></td>
					</tr>
					<tr>
						<td>Video height<br><span style="font-size:12px;">320p up to the device maximum</span></td>
						<td>
							<select class="studio_config" setting="video_height">
								<option value=""<%= (($settings->{'video_height'} || '') eq '') ? ' selected' : '' %>>maximum</option>
								<% foreach my $h (1440, 1080, 720, 480, 360, 320) { %>
								<option value="<%= $h %>"<%= (($settings->{'video_height'} || '') eq $h) ? ' selected' : '' %>><%= $h %>p</option>
								<% } %>
							</select>
						</td>
					</tr>
					<tr>
						<td>Video frame rate<br><span style="font-size:12px;">fps; blank takes what the device offers</span></td>
						<td><input class="studio_config" setting="video_fps" value="<%= $settings->{'video_fps'} || '' %>"></td>
					</tr>
					<tr>
						<td>Video bit rate (Mbps)<br><span style="font-size:12px;">blank lets the browser choose</span></td>
						<td><input class="studio_config" setting="video_mbps" value="<%= $settings->{'video_mbps'} || '' %>"></td>
					</tr>
					<tr>
						<td>Audio bit rate (kbps)<br><span style="font-size:12px;">64 to 320</span></td>
						<td><input class="studio_config" setting="audio_kbps" value="<%= $settings->{'audio_kbps'} || 256 %>"></td>
					</tr>
					<tr>
						<td>Audio channels</td>
						<td>
							<select class="studio_config" setting="audio_channels">
								<option value="2"<%= (($settings->{'audio_channels'} || '2') eq '2') ? ' selected' : '' %>>stereo</option>
								<option value="1"<%= (($settings->{'audio_channels'} || '2') eq '1') ? ' selected' : '' %>>mono</option>
							</select>
						</td>
					</tr>
					<tr>
						<td>Sample rate<br><span style="font-size:12px;">changing this reboots the studio window, so save first</span></td>
						<td>
							<select class="studio_config" setting="sample_rate" restart="yes">
								<option value=""<%= (($settings->{'sample_rate'} || '') eq '') ? ' selected' : '' %>>device default</option>
								<option value="44100"<%= (($settings->{'sample_rate'} || '') eq '44100') ? ' selected' : '' %>>44100</option>
								<option value="48000"<%= (($settings->{'sample_rate'} || '') eq '48000') ? ' selected' : '' %>>48000</option>
							</select>
						</td>
					</tr>
					<tr>
						<td>Latency hint<br><span style="font-size:12px;">how small a buffer to ask the browser for; too low crackles. Fixed when the window opens, so it rebuilds (save first)</span></td>
						<td>
							<select class="studio_config" setting="latency_hint">
								<option value="interactive"<%= (($settings->{'latency_hint'} || 'interactive') eq 'interactive') ? ' selected' : '' %>>interactive (default)</option>
								<option value="balanced"<%= (($settings->{'latency_hint'} || '') eq 'balanced') ? ' selected' : '' %>>balanced</option>
								<option value="playback"<%= (($settings->{'latency_hint'} || '') eq 'playback') ? ' selected' : '' %>>playback (most robust)</option>
								<option value="0.01"<%= (($settings->{'latency_hint'} || '') eq '0.01') ? ' selected' : '' %>>low &mdash; 10 ms target</option>
								<option value="0.005"<%= (($settings->{'latency_hint'} || '') eq '0.005') ? ' selected' : '' %>>lower &mdash; 5 ms target</option>
								<option value="0.003"<%= (($settings->{'latency_hint'} || '') eq '0.003') ? ' selected' : '' %>>lowest &mdash; 3 ms target</option>
							</select>
						</td>
					</tr>
					<tr>
						<td>Latency<br><span style="font-size:12px;">what the browser reports for this session</span></td>
						<td><span id="studio_latency_info">&mdash;</span></td>
					</tr>
					<tr>
						<td>Round trip<br><span style="font-size:12px;">plays a few clicks through the speakers and times the echo on the mic; use speakers (not headphones) and stay quiet</span></td>
						<td><button id="studio_latency_measure">Measure</button> <span id="studio_latency_result">&mdash;</span></td>
					</tr>
				</tbody>
			</table>
						
		</div>
	</div>
</div>

<style>
	.pedal {
		width: 160px;
		max-height: 187px;
		position: absolute;
		top: 12px;
		border: solid;
		border-width: 5px;
		border-radius: 10px;
		background: brown;
	}
	#pedalboard {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 215px;
		overflow-x: auto;
		overflow-y: hidden;
		background-color: rgba(60, 32, 12, 0.97);
		border-top: 3px solid #2a1608;
		z-index: 60000;
	}
	.pedal_background {
		width: 100%;
	}
	#studio_pedalboard_toggle {
		right: 0px;
		bottom:60px;
		position:fixed;
	}
	#studio_controls {
		position:absolute;
		padding-left:5px;
	}
	#studio_track_container {
		position:absolute;
		right: -130px;
		width: 130px;
		overflow:scroll;
		top:0px;
		height: 100%;
	}
	.track {
		width: 100%;
		height: calc(100% / <%= $channel_count %>);
		cursor: grab;
	}
	.channel_fx {
		display: block;
		font-size: 10px;
		line-height: 1.15;
		word-break: break-word;
		max-height: 42px;
		overflow: hidden;
		color: #04325f;
	}
	.knob {
		width: 30px;
		aspect-ratio: 1 / 1;
		box-sizing: border-box;
		object-fit: contain;
		transform: rotate(180deg);
		border-radius: 50%;
	}
	.channel_fx_pedal {
		display: block;
		width: 100%;
		margin-bottom: 2px;
		border-radius: 3px;
	}
	.channel.selected_channel {
		box-shadow: inset 0 0 0 3px #8ab4f8;
	}
	.pedal_background {
		cursor: grab;
	}
	.knob {
		cursor: ns-resize;
		touch-action: none;
	}
	.knob.knob_active {
		filter: brightness(1.3);
	}
	/* the value bubble a knob shows while it is dragged or rolled */
	#studio_knob_readout {
		position: absolute;
		display: none;
		z-index: 70000;
		padding: 1px 6px;
		background: #04325f;
		color: #fff;
		border-radius: 4px;
		font-size: 12px;
		pointer-events: none;
	}
	/* a channel's inserted-pedal badge jumps the pedalboard to that pedal */
	.channel_fx_pedal {
		cursor: pointer;
	}
	.pedal.pedal_revealed {
		box-shadow: 0 0 0 4px #ffd21e;
	}
	.knob_control {
		appearance:none;
		width: 30px;
		height: 100px;

		writing-mode: vertical-lr;
	  direction: rtl;
	  vertical-align: middle;
	}
	.armed {
		height: 30px;
		width: 20px;
		/* the button never gives way to a fader drawn over the strip */
		position: relative;
		z-index: 1;
	}
	.armed[state=off] {
		background:grey;
	}
	.armed[state=rec] {
		background:red;
	}
	.armed[state=play] {
		background:green;
	}
	.armed[state=loop] {
		background:blue;
	}
	.cord {
		width:40px;
	}
	.jack {
		width:40px;
	}

	/* the fader and its metre live inside the strip, below the arm button, so
	   they can never sit on top of the record/play/loop toggle */
	.channel_fader {
		position: relative;
		display: block;
		width: 34px;
		height: 120px;
		margin: 2px 0 4px 0;
		/* dropped to the foot of the strip when there is room for it, but it
		   stays below the arm button when the strip is short */
		margin-top: auto;
	}
	.channel_volume {
		position:absolute;
		appearance: none;
		height: 118px;
		width: 34px;
		left: 0;
		top: 0;
		border: solid;
		border-radius: 5px;
		border-width: .1px;
		background-color:transparent;
		color: black;
		outline: none;
	  writing-mode: vertical-lr;
	  direction: rtl;
	  vertical-align: middle;
		background-image: url('<%= &subs::icon_for('/images/studio/slider2.png') %>');
	}
	.channel_volume_metre {
		position:absolute;
		height: 118px;
		width: 30px;
		left: 2px;
		top: 1px;
		color: black;
		outline: none;
	  vertical-align: middle;

	}
	.channel {
		border: solid;
		border-width: 2px;
		border-radius: 5px;
		width: 40px;
		height: 100%;
		display: inline-flex;
		flex-direction: column;
		align-items: center;
		padding-top:10px;
		position: relative;

	}
	/* controls keep their size whether or not the strip is tall enough */
	.channel > * {
		flex: none;
	}
	<% for (my $ch = 0; $ch <= $channel_count; $ch++) { %>
		.channel_<%= $ch %> {

		}
		.knob_control[channel=<%= $ch %>] {
			left: <%= 45 * $ch %>px;
		}
	<% } %>
	#studio {
		height:100%;
		width:100%;
		border-width: 10px;
		border-radius: 10px;
		border: solid;
	}
	#studio_viewer {
		height: 30%;
		width: 100%;
		background-color: lightblue;
	}
	#studio_mixer {
