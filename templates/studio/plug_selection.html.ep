<div id="studio_plug_select" channel="<%= $channel %>" direction="<%= $direction %>">

	<h3>Channel <%= $channel %> <%= &subs::format_name($direction) %>s <span style="float:right;"><img src="<%= &subs::icon_for('/images/make believe/cancel_button.png') %>" hint="Close" class="hover little_thumb close_plug_select"></span></h3>
	<table>
		<thead>
			<tr><th></th><th></th></tr>
		</thead>
		<tbody>
			<% my %device_number; foreach my $av ( @{$constraints->{'all'}} ) {
				if (($direction eq 'input' && $av->{'kind'} =~ /input/gi) || ($direction eq 'output' && $av->{'kind'} =~ /output/gi)) {
					if ($av->{'kind'} eq 'audioinput') {
						$av->{'icon'} = 'microphone';
						$av->{'av'} = 'a';
					}
					elsif ($av->{'kind'} eq 'videoinput') {
						$av->{'av'} = 'av';
						if (defined $av->{'label'} && $av->{'label'} =~ /front/i) {
							$av->{'icon'} = 'camera front';
						}
						else {
							$av->{'icon'} = 'camera back';
						}
						
					}
					elsif ($av->{'kind'} eq 'audiooutput') {
						$av->{'icon'} = 'speaker';
						$av->{'av'} = 'a';
					}
					$device_number{$av->{'kind'}} = ($device_number{$av->{'kind'}} || 0) + 1;
					my $label = defined $av->{'label'} ? $av->{'label'} : '';
					if ($label !~ /\S/) {
						my $word = $av->{'kind'} eq 'videoinput' ? 'Camera'
							: $av->{'kind'} eq 'audiooutput' ? 'Speaker' : 'Microphone';
						$label = &subs::ui($word) . ' ' . $device_number{$av->{'kind'}};
					}
				%>
					<tr class="studio_plug_selection hover" channel="<%= $channel %>" direction="<%= $direction %>" type="usermedia" hint="<%= &subs::ui('Use this microphone or camera on the channel') %>" sid="<%= $av->{'deviceId'} %>" av="<%= $av->{'av'} %>" app="">
						<td><img class="little_thumb" src="<%= &subs::icon_for('/images/decipherable/' . $av->{'icon'} . '.png') %>" hint="<%= &subs::format_name($av->{'icon'}) %>"></td>
						<td style="font-size:20px;vertical-align:top;"><%= $label %>
							<% if ($av->{'kind'} eq 'audioinput') { %>
								<br><select class="studio_input_channel" hint="<%= &subs::ui('Choose which input of this device the channel uses') %>">
									<option value="0"<%= $input ? '' : ' selected' %>><%= &subs::ui('Input 1 (channel 0)') %></option>
									<option value="1"<%= $input ? ' selected' : '' %>><%= &subs::ui('Input 2 (channel 1)') %></option>
								</select>
							<% } %>
						</td>
					</tr>
				<% } 
				} %>
				<% foreach my $app ( grep { $_->{'direction'} eq $direction || !$_->{'direction'} } @{$apps} ) {
					my $main_image = &subs::main_icon_maker({ app => $app->{'app'}, timestamp => &subs::rightNow, size => 'little' });
				%>
					<tr class="studio_plug_selection hover" channel="<%= $channel %>" direction="<%= $direction %>" type="app" hint="<%= &subs::ui('Patch this app into the channel') %>" sid="<%= $app->{'id'} %>" app="<%= $app->{'app'} %>" av="<%= $app->{'av'} %>">
						<td><%== $main_image %></td><td style="font-size:20px;vertical-align:top;"><%= &subs::format_name($app->{'app'}) %></td>
					</tr>
				<% } %>
				<% my @other_channels = ref $channels eq 'ARRAY' ? @{$channels} : (); %>
				<% foreach my $other (@other_channels) { %>
					<tr class="studio_plug_selection hover" channel="<%= $channel %>" direction="<%= $direction %>" type="channel" <% if ($direction eq 'input') { %>hint="<%= &subs::ui('Take another channel\'s output as this channel\'s input') %>"<% } else { %>hint="<%= &subs::ui('Send this channel\'s output to another channel') %>"<% } %> sid="<%= $other %>" app="" av="a">
						<td><img class="little_thumb" src="<%= &subs::icon_for('/images/decipherable/speaker.png') %>" hint="<%= &subs::ui('Channel') %>"></td>
						<td style="font-size:20px;vertical-align:top;"><%= &subs::ui('Channel') %> <%= $other %></td>
					</tr>
				<% } %>
				% if ($screen_share && $direction eq 'input') {
					<tr class="studio_plug_selection hover" channel="<%= $channel %>" direction="<%= $direction %>" type="screen_share" hint="<%= &subs::ui('Put another window or a screen share on the channel') %>" av="av" sid="" app=""> 
						<td><img src="<%= &subs::icon_for('/images/make believe/monitor.png') %>" hint="Monitor" class="little_thumb"></td><td style="font-size:20px;vertical-align:top;">Screen Share</td>
					</tr>
				% }
				% my $show_input_node = defined $direction && $direction eq 'input' && ref $sources eq 'ARRAY' && @{$sources} && (!defined $information->{'type'} || $information->{'type'} ne 'channel');
				% if ($show_input_node) {
					<tr class="studio_input_node_row">
						<td colspan="2" style="padding:6px 0 2px 24px;">
							<label for="studio_input_node_<%= $channel %>"><%= &subs::ui('This machine\'s input') %></label><br>
							<select class="studio_input_node" channel="<%= $channel %>" input="<%= defined $input ? $input : 0 %>" hint="<%= &subs::ui('Choose which of this machine\'s inputs the channel captures') %>">
								<option value=""<%= (defined $input_node && length $input_node) ? '' : ' selected' %>><%= &subs::ui('The machine\'s default input') %></option>
							% foreach my $source ( @{$sources} ) {
								<option value="<%= $source->{'node'} %>"<%= (defined $input_node && $input_node eq $source->{'node'}) ? ' selected' : '' %>><%= $source->{'name'} %></option>
							% }
							</select>
							<span class="studio_input_node_note"></span>
						</td>
					</tr>
				% }
			</tbody>
		</table>
	% if (defined $direction && $direction eq 'input') {
		<div class="studio_house_patch" id="studio_house_patch">
			<h3><%= &subs::ui('House patch') %></h3>
			<p class="studio_house_patch_engine" id="studio_house_patch_engine"></p>
			<div class="studio_house_patch_sources"></div>
			<div class="studio_house_patch_take"></div>
			<p class="studio_house_patch_note" id="studio_house_patch_note"></p>
		</div>
	% }
</div>