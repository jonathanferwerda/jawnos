<% use Mojo::JSON; %>
<div id="studio" uuid="<%= $last_song->{'uuid'} %>" name="<%= $last_song->{'name'} %>">
	<%# The effect contract (names, labels, controls) is data, not markup, so the rack
	   and the master rack build the same controls the palette offers. %>
	<script>window.jawnos_studio_effects = <%== Mojo::JSON::encode_json($gb::studio->{'effects'}) %>;
	window.jawnos_studio_master = <%== Mojo::JSON::encode_json($gb::studio->{'master'}) %>;
	window.jawnos_studio_pedal_art = <%== Mojo::JSON::encode_json({ map { $_->{'name'} => &subs::icon_for('/images/studio/' . $_->{'image'} . '.png') } @{$gb::studio->{'pedals'}} }) %>;
	window.jawnos_studio_pedalboards = <%== Mojo::JSON::encode_json(eval { Mojo::JSON::decode_json($settings->{'pedalboards'} || '[]') } || []) %>;</script>
	<audio id="metronome" autoplay style="display:none;"></audio>
	<%# The selector's box (position, stacking, the window cap that lets a long
	   list scroll) lives in studio/style so channelSelect() can clamp the same
	   edges it enforces. %>
	<div id="studio_plug_select_container"></div>
	<%# The artwork the chain tiles borrow. The tiles themselves are cloned from
	   the hidden library below, so a track's board looks like the pedals it holds. %>
	<% my %shelf_kind = (
		CompressionX => 'compressor', Distorjawn => 'distortion',
		Delayed => 'delay', reverb2 => 'reverb', JawnSynth => 'synth',
	); %>
	<% my %shelf_has = map { ($shelf_kind{ $_->{'name'} } || $_->{'name'}) => 1 } @{$gb::studio->{'pedals'}}; %>
	<%# The pedalboard is a bottom sheet over the foot of the window: it floats
	   above the console instead of taking a grid row, and its own bar carries
	   Close plus the Add list. A channel starts with an empty board; the list
	   offers every effect, and Add puts the chosen one in the chain the In/Out
	   switch shows. The board draws those effects as the stompbox tiles below. %>
	<%# The board's pedal size is one saved setting: the +/- buttons beside Close
	   nudge it and the choice survives a reload. The CSS zoom reads the custom
	   property, so the value is clamped here and always emitted as a number. %>
	<% my $pedal_zoom = $settings->{'pedal_zoom'}; %>
	<% $pedal_zoom = 1 unless (defined $pedal_zoom && $pedal_zoom =~ /^\d+(?:\.\d+)?$/); %>
	<% $pedal_zoom = 0.75 if $pedal_zoom < 0.75; %>
	<% $pedal_zoom = 1.6 if $pedal_zoom > 1.6; %>
	<% $pedal_zoom += 0; %>
	<div id="pedalboard" data-zoom="<%= $pedal_zoom %>" style="display:none; --studio-pedal-zoom: <%= $pedal_zoom %>;">
		<div class="studio_pedalboard_bar">
			<span class="studio_effect_palette">
				<span id="studio_palette_channel" class="studio_palette_channel"></span>
				<select id="studio_palette_effect" hint="<%= &subs::ui('Choose an effect to add to this track\'s chain') %>">
					<% foreach my $name ( @{$gb::studio->{'palette'}} ) { %>
						<% my $effect = $gb::studio->{'effects'}->{$name} || {}; %>
						<option value="<%= $name %>"><%= &subs::ui($effect->{'label'} || $name) %></option>
					<% } %>
					<option value="Jtune"><%= &subs::ui('Jtune') %></option>
				</select>
				<button id="studio_palette_add" class="hover" hint="<%= &subs::ui('Add the chosen effect to this chain') %>"><%= &subs::ui('Add') %></button>
			</span>
			<%# A saved board is a named copy of this track's chain, kept in the house's
			   settings like the synth loops, so it is one press away on another
			   track, another song or another machine. The list is newest-used first. %>
			<span class="studio_board_presets" role="group" aria-label="<%= &subs::ui('Saved pedalboards') %>">
				<input id="studio_board_save_name" class="studio_board_save_name" placeholder="<%= &subs::ui('Pedalboard name') %>" hint="<%= &subs::ui('Name this pedalboard') %>">
				<button id="studio_board_save" class="hover" hint="<%= &subs::ui('Save this track\'s pedalboard under this name') %>"><%= &subs::ui('Save board') %></button>
				<select id="studio_board_presets" hint="<%= &subs::ui('Load a saved pedalboard, most recently used first') %>">
					<option value=""><%= &subs::ui('Saved pedalboards') %></option>
				</select>
				<button id="studio_board_delete" class="hover" hint="<%= &subs::ui('Delete this saved pedalboard') %>"><%= &subs::ui('Delete board') %></button>
			</span>
			<span class="studio_board_size" role="group" aria-label="<%= &subs::ui('Pedal size and Close') %>">
				<button id="studio_pedalboard_zoom_out" class="hover" hint="<%= &subs::ui('Smaller pedals') %>">&minus;</button>
				<button id="studio_pedalboard_zoom_in" class="hover" hint="<%= &subs::ui('Bigger pedals') %>">+</button>
				<button id="studio_pedalboard_close" class="hover" hint="<%= &subs::ui('Close the pedalboard') %>"><%= &subs::ui('Close') %></button>
			</span>
		</div>
		<%# A controller edits the peer's chain with `pedal` commands; the note names
		   the machine a press is sent to rather than calling the sheet read-only. %>
		<span id="studio_pedalboard_remote" class="studio_pedalboard_remote" role="status" aria-live="polite" style="display:none;"><%= &subs::ui('Pedal changes are sent to the machine this Studio controls') %></span>
		<%# The In/Out switch and the selected track's board. studioRackRender()
		   fills both; the board holds only the inserts, in signal order. %>
		<div id="studio_pedalboard_chain" class="studio_pedalboard_chain"></div>
		<div id="studio_pedalboard_rack" class="studio_channel_rack" hint="<%= &subs::ui('The effects in this track\'s chain, in order') %>"></div>
	</div>
	<%# The tile library. It is never shown: studioRackRender() clones one tile per
	   insert into the board, so every pedal keeps its artwork, knobs and stomp. %>
	<div id="studio_pedalboard_tiles" style="display:none;" aria-hidden="true">
	<% foreach my $p ( @{$gb::studio->{'pedals'}} ) { %>
		<span id="pedal_<%= $p->{'name'} %>" class="pedal" data-effect="<%= $p->{'name'} %>"<% if ($p->{'tuner'}) { %> data-tuner="yes"<% } %> hint="<%= $p->{'tuner'} ? &subs::ui('Start or stop the tuner') : &subs::ui('Drag to reorder this effect') %>">
			<% my $ch = $p->{'name'}; %>
			<span class="studio_pedal_led" role="button" aria-pressed="false" title="<%= &subs::ui('Off for this track') %>" hint="<%= &subs::ui('Turn this pedal on or off for this track') %>"></span>
			<img class="pedal_background" hint="<%= $p->{'name'} %>" src="<%= &subs::icon_for('/images/studio/' . $p->{'image'} . '.png') %>">
			<% if ($p->{'tuner'}) { %>
				<span class="studio_tuner" aria-live="polite">
					<span class="studio_tuner_arrow studio_tuner_up" aria-hidden="true">▲</span>
					<span class="studio_tuner_note"><b class="studio_tuner_letter"><%= &subs::ui('TUNE') %></b><span class="studio_tuner_octave"></span></span>
					<span class="studio_tuner_arrow studio_tuner_down" aria-hidden="true">▼</span>
					<span class="studio_tuner_cents"><%= &subs::ui('press to tune') %></span>
				</span>
			<% } %>
			<% foreach my $k ( @{$p->{'knobs'}} ) { %>
				<input type="range" channel="<%= $ch %>" name="<%= $k->{'control'} %>" control="<%= $k->{'control'} %>" class="knob_control <%= $k->{'control'} %>" style="display:none;left:3px;">
				<img class="knob <%= $k->{'control'} %>" style="position:absolute;width:<%= $k->{'width'} || '60px' %>;left:<%= $k->{'left'} %>;top:<%= $k->{'top'} %>;" flip="<%= $k->{'flip'} %>" direction="<%= $k->{'direction'} %>" channel="<%= $ch %>" control="<%= $k->{'control'} %>" hint="<%= &subs::format_name($k->{'control'}) %>" src="<%= &subs::icon_for('/images/studio/knob_' . $k->{'colour'} . '.png') %>">
			<% } %>
			<% foreach my $b ( @{$p->{'buttons'}} ) { %>
				<img class="button_control" style="position:absolute;height:<%= $b->{'height'} || $b->{'width'} || '60px' %>;width:<%= $b->{'width'} || '60px'; %>;left:<%= $b->{'left'} %>;top:<%= $b->{'top'} %>;" flip="<%= $b->{'flip'} %>" state="<%= $b->{'status'} || "depressed" %>" channel="<%= $ch %>" control="<%= $b->{'control'} %>" colour="<%= $b->{'colour'} %>" hint="<%= &subs::ui($b->{'hint'} || &subs::format_name($b->{'control'})) %>" src="<%= $button_icon->('depressed', $b->{'colour'}) %>">
			<% } %>
			<%# A hand-drawn shelf tile may still carry a choice or a tempo field the
			   artwork does not paint: the pedals entry lists the control and its
			   place, and the same handlers the drawn tiles use do the rest. %>
			<% foreach my $s ( @{$p->{'selects'} || []} ) { %>
				<% my $shelf_effect = $gb::studio->{'effects'}->{$p->{'name'}} || {}; %>
				<% my ($pick) = grep { ($_->{'control'} || '') eq $s->{'control'} } @{$shelf_effect->{'controls'} || []}; %>
				<select class="studio_pedal_model pedal_select" channel="<%= $ch %>" control="<%= $s->{'control'} %>" style="position:absolute;left:<%= $s->{'left'} %>;top:<%= $s->{'top'} %>;width:<%= $s->{'width'} %>;z-index:6;" hint="<%= &subs::ui(($pick && $pick->{'hint'}) || 'Choose the option') %>">
					<% my $oi = 0; %>
					<% foreach my $option ( @{($pick && $pick->{'options'}) || []} ) { %>
						<option value="<%= $oi %>"><%= &subs::ui($option) %></option>
						<% $oi++; %>
					<% } %>
				</select>
			<% } %>
			<% if ($p->{'sync'}) { %>
				<label class="pedal_select_row pedal_sync_row">
					<span class="pedal_knob_label"><%= &subs::ui('Sync') %></span>
					<input type="text" class="studio_pedal_text pedal_text" channel="<%= $ch %>" control="sync" list="studio_tempo_<%= &subs::html_name($ch) %>_sync" hint="<%= &subs::ui('A note division, milliseconds, or off') %>" value="" placeholder="off">
					<datalist id="studio_tempo_<%= &subs::html_name($ch) %>_sync">
						<% foreach my $division ( @{$gb::studio->{'tempo_divisions'}} ) { %>
							<option value="<%= $division %>"></option>
						<% } %>
					</datalist>
				</label>
			<% } %>
			<% if ($p->{'name'} eq 'reverb2') { %>
				<select class="studio_pedal_model pedal_model" channel="<%= $ch %>" control="model" hint="<%= &subs::ui('Choose the reverb model') %>">
					<% my $mi = 0; %>
					<% foreach my $model ( @{$gb::studio->{'reverb_models'}} ) { %>
						<option value="<%= $mi %>"<%= $mi == 2 ? ' selected' : '' %>><%= &subs::ui($model) %></option>
						<% $mi++; %>
					<% } %>
				</select>
			<% } %>
			<%# The Delay shelf pedal keeps its artwork's knobs, so its tempo sync is
			   the one readable control row above the footswitch. The text field
			   accepts any note division, a manual millisecond value, or off; the
			   datalist only offers the common ones. %>
			<% if ($p->{'name'} eq 'Delayed') { %>
				<label class="pedal_select_row pedal_sync_row">
					<span class="pedal_knob_label"><%= &subs::ui('Sync') %></span>
					<input type="text" class="studio_pedal_text pedal_text" channel="<%= $ch %>" control="sync" list="studio_tempo_<%= &subs::html_name($ch) %>_sync" hint="<%= &subs::ui('A note division, milliseconds, or off') %>" value="" placeholder="off">
					<datalist id="studio_tempo_<%= &subs::html_name($ch) %>_sync">
						<% foreach my $division ( @{$gb::studio->{'tempo_divisions'}} ) { %>
							<option value="<%= $division %>"></option>
						<% } %>
					</datalist>
				</label>
			<% } %>
			<img class="button_control studio_pedal_foot studio_pedal_stomp" role="button" tabindex="0" control="stomp" colour="ruby_red" state="depressed" aria-pressed="false" effect="<%= $p->{'name'} %>" hint="<%= &subs::ui('Turn this pedal on or off for this track') %>" src="<%= $button_icon->('depressed', 'ruby_red') %>">
		</span>
	<% } %>
		<% foreach my $name ( @{$gb::studio->{'palette'}} ) { next if $shelf_has{$name}; %>
			<% my $effect = $gb::studio->{'effects'}->{$name} || {}; %>
			<% my $art = $gb::studio->{'palette_art'}->{$name} || []; %>
			<% my $fallback = $gb::studio->{'palette_knob_colours'} || [ 'grey_plain' ]; %>
			<span id="pedal_<%= $name %>" class="pedal pedal_graphic" data-effect="<%= $name %>" hint="<%= &subs::ui('Drag to reorder this effect') %>">
				<span class="studio_pedal_led" role="button" aria-pressed="false" title="<%= &subs::ui('Off for this track') %>" hint="<%= &subs::ui('Turn this pedal on or off for this track') %>"></span>
				<span class="pedal_body" aria-hidden="true"></span>
				<b class="pedal_title"><%= &subs::ui($effect->{'label'} || $name) %></b>
				<span class="pedal_controls">
					<span class="pedal_knobs">
					<% my $ki = 0; %>
					<% foreach my $k ( @{$effect->{'controls'} || []} ) { next if $k->{'options'}; %>
						<% my $colour = $art->[$ki] || $fallback->[ $ki % scalar(@$fallback) ]; %>
						<label class="pedal_knob">
							<input type="range" channel="<%= $name %>" name="<%= $k->{'control'} %>" control="<%= $k->{'control'} %>" class="knob_control" style="display:none;">
							<img class="knob" channel="<%= $name %>" control="<%= $k->{'control'} %>" flip="180" hint="<%= &subs::format_name($k->{'control'}) %>" src="<%= &subs::icon_for('/images/studio/knob_' . $colour . '.png') %>">
							<span class="pedal_knob_label"><%= &subs::ui($k->{'label'} || $k->{'control'}) %></span>
						</label>
						<% $ki++; %>
					<% } %>
					</span>
					<% foreach my $k ( @{$effect->{'controls'} || []} ) { next unless $k->{'options'}; next if $k->{'typed'}; %>
						<label class="pedal_select_row">
							<span class="pedal_knob_label"><%= &subs::ui($k->{'label'} || $k->{'control'}) %></span>
							<select class="studio_pedal_model pedal_select" channel="<%= $name %>" control="<%= $k->{'control'} %>" hint="<%= &subs::ui($k->{'hint'} || 'Choose the option') %>">
								<% my $oi = 0; %>
								<% foreach my $option ( @{$k->{'options'}} ) { %>
									<option value="<%= $oi %>"><%= &subs::ui($option) %></option>
									<% $oi++; %>
								<% } %>
							</select>
						</label>
					<% } %>
					<%# A typed control is a visible text field with a datalist of the
					   common values, not a closed dropdown: the parser accepts any n/d
					   fraction, dotted and triplet suffixes, whole notes, and a manual
					   millisecond value. studioRackTile() gives every clone its own
					   datalist id. %>
					<% foreach my $k ( @{$effect->{'controls'} || []} ) { next unless $k->{'typed'}; %>
						<label class="pedal_select_row">
							<span class="pedal_knob_label"><%= &subs::ui($k->{'label'} || $k->{'control'}) %></span>
							<input type="text" class="studio_pedal_text pedal_text" channel="<%= $name %>" control="<%= $k->{'control'} %>" list="studio_tempo_<%= &subs::html_name($name) %>_<%= &subs::html_name($k->{'control'}) %>" hint="<%= &subs::ui($k->{'hint'} || 'Choose the option') %>" value="" placeholder="off">
							<datalist id="studio_tempo_<%= &subs::html_name($name) %>_<%= &subs::html_name($k->{'control'}) %>">
								<% foreach my $option ( @{$k->{'options'} || []} ) { %>
									<option value="<%= $option %>"></option>
								<% } %>
							</datalist>
						</label>
					<% } %></span>
				<img class="button_control studio_pedal_foot studio_pedal_stomp" role="button" tabindex="0" control="stomp" colour="ruby_red" state="depressed" aria-pressed="false" effect="<%= $name %>" hint="<%= &subs::ui('Turn this pedal on or off for this track') %>" src="<%= $button_icon->('depressed', 'ruby_red') %>">
			</span>
		<% } %>
	</div>
	<%# The small tools cloned onto every board tile. The labels stay literal so the
	   help registry can see them. %>
	<div id="studio_board_tool_template" class="studio_board_tools" style="display:none;" aria-hidden="true">
		<button type="button" class="studio_rack_up hover" hint="<%= &subs::ui('Move this effect earlier in the chain') %>">‹</button>
		<button type="button" class="studio_rack_down hover" hint="<%= &subs::ui('Move this effect later in the chain') %>">›</button>
		<button type="button" class="studio_rack_remove hover" hint="<%= &subs::ui('Remove this effect from the chain') %>">X</button>
	</div>
	<div id="studio_layout_bar" class="studio_layout_bar">
		<span class="studio_window_grip hover" hint="<%= &subs::ui('Drag to move the Studio window') %>">⠿</span>
		<%# The song's own file controls sit at the left edge, beside Configure:
		   New, Open, Save and the gear are one press away without a sheet. %>
		<span class="studio_file_buttons" role="group" aria-label="<%= &subs::ui('Song files') %>">
			<img id="studio_new" hint="New song" class="little_thumb hover" src="<%= &subs::icon_for('/images/decipherable/file.png') %>">
			<img id="studio_open" class="little_thumb hover" hint="<%= &subs::ui('Open a saved studio song') %>" alt="<%= &subs::ui('Open') %>" src="<%= &subs::icon_for('/images/decipherable/folder.png') %>">
			<img id="studio_save" hint="Save" class="little_thumb hover" src="<%= &subs::icon_for('/images/decipherable/diskette.png') %>">
			<img class="little_thumb hover" hint="Configure" src="<%= &subs::icon_for('/images/decipherable/gear.png') %>" id="studio_config_toggle">
		</span>
		<span id="studio_track_count" class="studio_track_count"></span>
		<%# A phone or tablet may drive another machine's Studio. The picker starts on
		   this machine; choosing a peer turns this window into that table's controls
		   and the badge names the machine currently being driven. %>
		<span id="studio_remote_picker" class="studio_remote_picker" role="group" aria-label="<%= &subs::ui('Control another machine') %>">
			<label class="studio_remote_label" for="studio_remote_machine"><%= &subs::ui('Machine') %></label>
			<select id="studio_remote_machine" class="studio_remote_machine" hint="<%= &subs::ui('Choose the machine this Studio controls') %>">
				<option value=""><%= &subs::ui('This machine') %></option>
			</select>
			<%# The monitor picker mixes two kinds of output: the controlled
			   machine's own speaker, jack or sink, and a stream of its monitor mix
			   to this tablet's Music receiver. Hidden while this window drives
			   itself. The stream option is a select sentinel, not a device id. %>
			<span id="studio_remote_monitor_picker" class="studio_remote_monitor_picker" role="group" aria-label="<%= &subs::ui('Monitor output') %>" hidden>
				<label class="studio_remote_label" for="studio_remote_monitor"><%= &subs::ui('Monitor') %></label>
				<select id="studio_remote_monitor" class="studio_remote_monitor" hint="<%= &subs::ui('Choose the output the controlled machine is monitored on; a stream plays through the Music receiver on this tablet') %>">
					<option value="__stream__" class="studio_remote_monitor_stream"><%= &subs::ui('Stream to this tablet') %></option>
				</select>
				<span id="studio_remote_monitor_status" class="studio_remote_monitor_status" role="status" aria-live="polite"></span>
			</span>
			<span id="studio_remote_status" class="studio_remote_status" role="status" aria-live="polite"></span>
		</span>
		<%# One button for the DAW-informed arrangement: transport across the top,
		   the timeline under it, and the console at the foot. On a narrow window
		   every panel stacks instead. %>
		<button id="studio_arrange" class="hover" hint="<%= &subs::ui('Arrange the panels') %>"><%= &subs::ui('Arrange') %></button>
		<%# Where the sound is actually going: the engine or this browser. It
		   sits on the layout bar, beside the panel taskbar, so the transport row
		   keeps its room for the clock and the knobs. %>
		<span class="studio_audio_path" id="studio_audio_path" aria-live="polite" hint="<%= &subs::ui('Which side is recording and playing: the engine or this browser') %>"><%= &subs::ui('Browser') %></span>
		<%# The top bar is the panels' own taskbar: one entry per interior window,
		   so a minimized panel is still one press away. The panel's own title bar
		   carries Minimize and Maximize. %>
		<div id="studio_panel_taskbar" class="studio_panel_taskbar" role="toolbar" aria-label="<%= &subs::ui('Studio panels') %>">
			<button class="studio_panel_task hover" data-panel="transport" aria-pressed="true" hint="<%= &subs::ui('Show this panel, or minimize it') %>"><%= &subs::ui('Transport') %></button>
			<button class="studio_panel_task hover" data-panel="tracks" aria-pressed="true" hint="<%= &subs::ui('Show this panel, or minimize it') %>"><%= &subs::ui('Tracks') %></button>
			<button class="studio_panel_task hover" data-panel="mixer" aria-pressed="true" hint="<%= &subs::ui('Show this panel, or minimize it') %>"><%= &subs::ui('Channels') %></button>
			<button class="studio_panel_task hover" data-panel="drums" aria-pressed="true" hint="<%= &subs::ui('Show this panel, or minimize it') %>"><%= &subs::ui('Drums') %></button>
			<button class="studio_panel_task hover" data-panel="synth" aria-pressed="true" hint="<%= &subs::ui('Show this panel, or minimize it') %>"><%= &subs::ui('Synth') %></button>
			<button class="studio_panel_task hover" data-panel="notes" aria-pressed="true" hint="<%= &subs::ui('Show this panel, or minimize it') %>"><%= &subs::ui('Notes') %></button>
		</div>
		<%# Effects are added from the pedalboard now, so this end of the bar
		   carries the track action instead of a second effect palette. %>
		<button id="studio_add_track" class="hover" title="<%= &subs::ui('Add a track, up to 32') %>" hint="<%= &subs::ui('Add a track, up to 32') %>"><%= &subs::ui('Add track') %></button>
	</div>
	<div id="studio_grid" class="studio_grid">
	<%# The drum machine is an interior panel window; its own template carries
	   its data, its markup and its script. The full Synth surface and the note
	   editor are interior windows too. %>
	<%= include 'studio/drums' %>
	<%= include 'studio/synth' %>
	<%= include 'studio/notes' %>
	<div id="studio_tracks_panel" class="studio_panel">
		<div class="studio_panel_bar">
			<span class="studio_drag_handle" data-studio-drag="tracks" hint="<%= &subs::ui('Drag to move the track listing') %>"><%= &subs::ui('Tracks') %></span>
			<%# The editing tool sits on the bar above the ruler. Cursor moves and
			   trims; Select draws a time range across lanes; Cut splits a take. %>
			<span class="studio_tools" role="toolbar" aria-label="<%= &subs::ui('Timeline tools') %>">
				<button class="studio_tool hover" data-tool="cursor" aria-pressed="true" hint="<%= &subs::ui('Drag clips and their edges') %>"><%= &subs::ui('Cursor') %></button>
				<button class="studio_tool hover" data-tool="select" aria-pressed="false" hint="<%= &subs::ui('Select a time range across tracks') %>"><%= &subs::ui('Select') %></button>
				<button class="studio_tool hover" data-tool="cut" aria-pressed="false" hint="<%= &subs::ui('Click a clip to cut it at that point') %>"><%= &subs::ui('Cut') %></button>
				<button id="studio_follow" class="studio_follow hover" aria-pressed="true" aria-label="<%= &subs::ui('Follow the playhead') %>" hint="<%= &subs::ui('Follow the playhead; press to unlock the view') %>">
					<svg class="studio_follow_icon" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" focusable="false">
						<path d="M5.2 7V5.2a2.8 2.8 0 0 1 5.6 0V7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
						<rect x="3.2" y="7" width="9.6" height="6.4" rx="1.3" fill="none" stroke="currentColor" stroke-width="1.6"/>
						<circle cx="8" cy="10.2" r="1" fill="currentColor"/>
					</svg>
					<span class="studio_follow_label"><%= &subs::ui('Follow') %></span>
				</button>
			</span>
			<span class="studio_panel_buttons">
				<button class="studio_panel_pin hover" data-panel="tracks" aria-pressed="false" hint="<%= &subs::ui('Keep this panel above the others') %>">📌</button>
				<button class="studio_panel_min hover" data-panel="tracks" hint="<%= &subs::ui('Minimize this panel') %>">–</button>
				<button class="studio_panel_max hover" data-panel="tracks" aria-pressed="false" hint="<%= &subs::ui('Maximize or restore this panel') %>">□</button>
			</span>
		</div>
		<%# What a Select drag last made, and the three things it is for: repeat
		   it, print it through each track's pedals, or export it as a file. %>
		<div id="studio_selection_bar" class="studio_selection_bar" style="display:none;" role="status" aria-live="polite">
			<span id="studio_selection_label" class="studio_selection_label"></span>
			<button id="studio_selection_loop" class="hover" hint="<%= &subs::ui('Repeat this time range') %>"><%= &subs::ui('Loop') %></button>
			<button id="studio_selection_bounce" class="hover" hint="<%= &subs::ui('Print this range through each track\'s pedals') %>"><%= &subs::ui('Bounce') %></button>
			<button id="studio_selection_export" class="hover" hint="<%= &subs::ui('Export this range as a file') %>"><%= &subs::ui('Export') %></button>
			<button id="studio_selection_clear" class="hover" hint="<%= &subs::ui('Clear the selection') %>"><%= &subs::ui('Clear') %></button>
		</div>
		<span class="studio_resize_handle" data-studio-resize="tracks" hint="<%= &subs::ui('Drag to resize this panel') %>"></span>
		<span class="studio_panel_bottom" data-studio-bottom="tracks" hint="<%= &subs::ui('Drag the bottom edge to resize this panel\'s height') %>"></span>
		<%# The ruler sits over the timeline. Its first cell matches a track's panel
		   column, so a tick lands over the same moment on every canvas below. %>
		<div id="studio_ruler" class="studio_ruler">
			<span class="studio_ruler_pad"></span>
			<canvas id="studio_ruler_canvas" class="studio_ruler_canvas" aria-label="<%= &subs::ui('Timeline ruler') %>" hint="<%= &subs::ui('Click the ruler to move the playhead while stopped or playing') %>"></canvas>
			<div id="studio_ruler_selection" class="studio_ruler_selection" aria-hidden="true"></div>
		</div>
		<div id="studio_viewer" channel_count="<%= $channel_count %>" data-max-tracks="<%= $max_tracks %>">
			<% for (my $ch = 1; $ch <= $channel_count; $ch++) { %>
				<div class="studio_track" data-channel="<%= $ch %>" id="studio_track_row_<%= $ch %>">
					<div class="studio_track_panel" channel="<%= $ch %>" hint="<%= &subs::ui('Tap to select; press and hold for channel in, out and delete') %>">
						<div class="studio_track_line">
							<button class="armed studio_track_arm" channel="<%= $ch %>" control="armed" state="off" hint="<%= &subs::ui('Off, record, play or loop') %>">O</button>
							<input class="studio_track_name" channel="<%= $ch %>" value="<%= &subs::ui('Track') %> <%= $ch %>" hint="<%= &subs::ui('Rename this track') %>">
						<input type="color" class="studio_track_colour hover" channel="<%= $ch %>" control="colour" value="#3b7ddd" aria-label="<%= &subs::ui('Choose this track\'s colour') %>" hint="<%= &subs::ui('Choose this track\'s colour') %>">
						</div>
						<div class="studio_track_line studio_track_volume_line">
							<input type="range" min="0" max="100" value="1" channel="<%= $ch %>" control="volume" class="channel_volume studio_track_volume" hint="<%= &subs::ui('Mix this track against the others') %>">
						</div>
						<div class="studio_track_line studio_track_actions">
							<button class="studio_track_fx hover" channel="<%= $ch %>" hint="<%= &subs::ui('Open the pedalboard for this track') %>"><%= &subs::ui('FX') %></button>
							<button class="studio_track_monitor hover" channel="<%= $ch %>" aria-pressed="false" hint="<%= &subs::ui('Hear this track\'s live input through the monitor; one track at a time') %>"><%= &subs::ui('Monitor') %></button>
							<button class="studio_track_automation hover" channel="<%= $ch %>" aria-pressed="false" hint="<%= &subs::ui('Show automation for this track') %>"><%= &subs::ui('Auto') %></button>
							<button class="studio_track_delete hover" channel="<%= $ch %>" armed="no" hint="<%= &subs::ui('Delete this track') %>"><%= &subs::ui('Delete') %></button>
						</div>
						<div class="studio_track_line studio_track_metre_line">
							<canvas class="channel_volume_metre channel_volume_metre_<%= $ch %>" id="channel_volume_metre_<%= $ch %>"></canvas>
						</div>
					</div>
					<div class="studio_track_body">
						<canvas class="track track_<%= $ch %>" id="track_view_<%= $ch %>" hint="<%= &subs::ui('Drag to move a clip, its edges to trim, double-click to cut, right-click for split, cut, copy and paste, select + Delete to remove') %>"></canvas>
						<div class="studio_track_automation_lane" aria-hidden="true"><%= &subs::ui('Automation') %></div>
					</div>
					<span class="studio_track_resize hover" channel="<%= $ch %>" hint="<%= &subs::ui('Drag the bottom edge to resize this track') %>"></span>
				</div>
			<% } %>
			<div id="studio_selection_overlay" class="studio_selection_overlay" aria-hidden="true"></div>
		</div>
		<%# A controller paints the chosen peer's clips and playhead here. It
		   sits over the viewer and takes no pointer, so the mirror is
		   read-only; the local timeline is untouched when no peer is chosen. %>
		<canvas id="studio_remote_overlay" class="studio_remote_overlay" aria-hidden="true"></canvas>
		<div id="studio_track_container"></div>
	</div>
	<div id="studio_mixer" class="studio_panel">
		<div class="studio_panel_bar">
			<span class="studio_drag_handle" data-studio-drag="mixer" hint="<%= &subs::ui('Drag to move the channel strips') %>"><%= &subs::ui('Channels') %></span>
			<span class="studio_panel_buttons">
				<button class="studio_panel_pin hover" data-panel="mixer" aria-pressed="false" hint="<%= &subs::ui('Keep this panel above the others') %>">📌</button>
				<button class="studio_panel_min hover" data-panel="mixer" hint="<%= &subs::ui('Minimize this panel') %>">–</button>
				<button class="studio_panel_max hover" data-panel="mixer" aria-pressed="false" hint="<%= &subs::ui('Maximize or restore this panel') %>">□</button>
			</span>
		</div>
		<span class="studio_resize_handle" data-studio-resize="mixer" hint="<%= &subs::ui('Drag to resize this panel') %>"></span>
		<span class="studio_panel_bottom" data-studio-bottom="mixer" hint="<%= &subs::ui('Drag the bottom edge to resize this panel\'s height') %>"></span>
		<div id="studio_mixer_strips">
			<% for (my $ch = 1; $ch <= $channel_count; $ch++) { %>
				<span class="channel channel_<%= $ch %>">
					<%# Input and output sit side by side at the head of the strip: the jack
					   chooses what feeds the track, the cord what it feeds. %>
					<span class="channel_jacks">
						<img class="tiny_thumb jack studio_jack hover" hint="Jack" src="<%= &subs::icon_for('/images/studio/jack.png') %>" channel="<%= $ch %>">
						<img class="tiny_thumb jack studio_cord hover" hint="Cord" src="<%= &subs::icon_for('/images/studio/cord.png') %>" channel="<%= $ch %>">
						<div class="studio_channel_information" style="display:none;" channel="<%= $ch %>" direction="input"></div>
						<div class="studio_channel_information" style="display:none;" channel="<%= $ch %>" direction="output"></div>
					</span>

					<%# The knobs and the volume fader share the strip: the fader is the
					   same track volume as the slider under the track, in the console. %>
					<span class="studio_strip_body">
						<span class="studio_strip_knobs">
						<% foreach my $k ( grep { $_->{'placement'} eq 'channel' } @{$gb::studio->{'knobs'}}) { %>
							<input type="range" channel="<%= $ch %>" name="<%= $k->{'control'} %>" control="<%= $k->{'control'} %>" class="knob_control <%= $k->{'control'} %>" style="display:none;left:3px;">
							<img class="knob <%= $k->{'control'} %>" flip="<%= $k->{'flip'} %>" direction="<%= $k->{'direction'} %>" channel="<%= $ch %>" control="<%= $k->{'control'} %>" hint="<%= &subs::format_name($k->{'control'}) %>" src="<%= &subs::icon_for('/images/studio/knob_' . $k->{'colour'} . '.png') %>">
							<span class="to_sound" channel="<%= $ch %>" >
								<img class="cord draggable" hint="Cord" style="display:none;" control="input" channel="<%= $ch %>" src="<%= &subs::icon_for('/images/studio/cord.png') %>">
							</span>
						<% } %>
						</span>
						<span class="studio_strip_control">
						<span class="studio_strip_fader_group">
							<span class="channel_fader">
								<span class="studio_strip_scale" aria-hidden="true">
									<span style="top:2%">0.0</span>
									<span style="top:50%">-6</span>
									<span style="top:75%">-12</span>
									<span style="top:94%">-24</span>
									<span class="studio_strip_scale_last" style="top:100%">&minus;&infin;</span>
								</span>
								<input type="range" min="0" max="100" value="1" channel="<%= $ch %>" control="volume" class="channel_volume studio_strip_volume" hint="<%= &subs::ui('Mix this track against the others') %>">
							</span>
							<span class="studio_strip_meter" channel="<%= $ch %>" aria-hidden="true">
								<% for my $led (0 .. 9) { %>
									<span class="studio_strip_led <%= $led < 5 ? 'led_green' : ($led < 8 ? 'led_yellow' : 'led_red') %>" data-led="<%= $led %>"></span>
								<% } %>
							</span>
						</span>
						</span>
					</span>
					<span class="studio_strip_mute_solo">
						<button class="studio_strip_mute hover" channel="<%= $ch %>" aria-pressed="false" hint="<%= &subs::ui('Mute this channel') %>">M</button>
						<button class="studio_strip_solo hover" channel="<%= $ch %>" aria-pressed="false" hint="<%= &subs::ui('Solo this channel') %>">S</button>
					</span>
				</span>
			<% } %>
			<%# The mastering chain is one rack on the mixer's bus, not a pedal on a
			   track: a dark chassis with a rail down each side, a level meter over
			   the units, one numbered rack unit per effect and the graphic EQ's
			   wide fader block. It is the last strip in the row, so it sits at the
			   far right of the strips and scrolls with them instead of covering
			   them. %>
			<div id="studio_master_rack" class="studio_master_rack" hint="<%= &subs::ui('Master effects, after every track') %>">
				<b class="studio_master_title"><%= &subs::ui('Master') %></b>
				<span id="studio_master_meter" class="studio_master_meter" aria-hidden="true">
					<% for my $led (0 .. 11) { %>
						<span class="studio_master_led <%= $led < 7 ? 'led_green' : ($led < 10 ? 'led_yellow' : 'led_red') %>" data-led="<%= $led %>"></span>
					<% } %>
				</span>
				<%# Mastering automation: a measurement mic on the master, ten bands
				   learned against a target. It sits inside the rack, above the units,
				   because it drives the rack's own ten-band EQ. Learn is one shot
				   (docs/studio-mastering-automation.md section 7.1); the bars show the
				   measured difference and the applied correction in each band. %>
				<div id="studio_mastering" class="studio_mastering" hint="<%= &subs::ui('Measure the room with a microphone and flatten the master to a target') %>">
					<span class="studio_mastering_head">
						<b class="studio_mastering_title"><%= &subs::ui('Mastering automation') %></b>
						<select id="studio_mastering_mic" class="studio_mastering_mic" aria-label="<%= &subs::ui('Measurement microphone') %>" hint="<%= &subs::ui('Choose the microphone that measures the room') %>">
							<option value=""><%= &subs::ui('Default microphone') %></option>
						</select>
					</span>
					<span class="studio_mastering_row">
						<label class="studio_mastering_choice hover" hint="<%= &subs::ui('A gentle downward tilt that a room hears as balanced') %>"><input type="radio" name="studio_mastering_target" value="house" checked> <%= &subs::ui('House') %></label>
						<label class="studio_mastering_choice hover" hint="<%= &subs::ui('A flat target for a calibrated measurement microphone') %>"><input type="radio" name="studio_mastering_target" value="flat"> <%= &subs::ui('Flat') %></label>
					</span>
					<span class="studio_mastering_row">
						<button id="studio_mastering_learn" class="studio_mastering_learn hover" aria-pressed="false" hint="<%= &subs::ui('Listen for ten seconds and set the ten master bands') %>"><%= &subs::ui('Learn') %></button>
						<button id="studio_mastering_reset" class="studio_mastering_reset hover" hint="<%= &subs::ui('Put the master bands back where they were before Learn') %>"><%= &subs::ui('Reset') %></button>
					</span>
					<span id="studio_mastering_status" class="studio_mastering_status" aria-live="polite"><%= &subs::ui('Off') %></span>
					<span id="studio_mastering_bars" class="studio_mastering_bars" aria-hidden="true">
						<% my @mastering_bands = ( [ 'b32', '32', 32 ], [ 'b64', '64', 64 ], [ 'b125', '125', 125 ], [ 'b250', '250', 250 ], [ 'b500', '500', 500 ], [ 'b1k', '1k', 1000 ], [ 'b2k', '2k', 2000 ], [ 'b4k', '4k', 4000 ], [ 'b8k', '8k', 8000 ], [ 'b16k', '16k', 16000 ] ); foreach my $mb ( @mastering_bands ) { %>
							<span class="studio_mastering_band" data-control="<%= $mb->[0] %>" data-hz="<%= $mb->[2] %>">
								<span class="studio_mastering_band_hz"><%= $mb->[1] %></span>
								<span class="studio_mastering_band_plot">
									<span class="studio_mastering_band_target"></span>
									<span class="studio_mastering_band_before"></span>
									<span class="studio_mastering_band_after"></span>
								</span>
								<span class="studio_mastering_band_db" title="<%= &subs::ui('Correction in dB') %>">0</span>
							</span>
						<% } %>
					</span>
				</div>
				<% my $unit = 0; foreach my $m ( @{$gb::studio->{'master'}} ) { $unit++;
					my $graphic = ( ($m->{'layout'} // '') eq 'graphic' ) ? 1 : 0; %>
					<div class="studio_master_effect<%= $graphic ? ' studio_master_graphic' : '' %>" effect="<%= $m->{'name'} %>" data-unit="<%= $unit %>">
						<span class="studio_master_unit_head">
							<span class="studio_master_unit_no" aria-hidden="true"><%= sprintf('%02d', $unit) %></span>
							<button class="studio_master_toggle hover" effect="<%= $m->{'name'} %>" aria-pressed="false" hint="<%= &subs::ui('Turn this mastering effect on or off') %>"><%= &subs::ui($m->{'label'}) %></button>
							<button class="studio_master_defaults hover" effect="<%= $m->{'name'} %>" hint="<%= &subs::ui('Put this mastering effect back to its defaults') %>"><%= &subs::ui('Defaults') %></button>
						</span>
						<span class="studio_master_controls">
							<% foreach my $c ( @{$m->{'controls'}} ) { %>
								<% if ($c->{'options'}) { %>
									<label class="studio_master_label"><%= &subs::ui($c->{'label'}) %>
										<select class="studio_master_control" effect="<%= $m->{'name'} %>" control="<%= $c->{'control'} %>" hint="<%= &subs::ui('Choose the reverb model') %>">
											<% my $oi = 0; %>
											<% foreach my $o ( @{$c->{'options'}} ) { %>
												<option value="<%= $oi %>"<%= $oi == 2 ? ' selected' : '' %>><%= &subs::ui($o) %></option>
												<% $oi++; %>
											<% } %>
										</select>
									</label>
								<% } elsif ($graphic) { %>
									<%# A graphic fader: the band name above the vertical slider and
									   the fader's dB below it. 10_master.js keeps the readout in
									   step with the value, because the generic loop only moves
									   the input. %>
									<label class="studio_master_label studio_master_band" hint="<%= &subs::ui($c->{'label'} . ' Hz band') %>">
										<span class="studio_master_band_hz"><%= $c->{'label'} %></span>
										<input type="range" min="0" max="100" value="50" class="studio_master_control" effect="<%= $m->{'name'} %>" control="<%= $c->{'control'} %>" aria-label="<%= $c->{'label'} %> Hz">
										<span class="studio_master_band_db" aria-hidden="true">0</span>
									</label>
								<% } else { %>
									<label class="studio_master_label"><%= &subs::ui($c->{'label'}) %>
										<input type="range" min="0" max="100" value="50" class="studio_master_control" effect="<%= $m->{'name'} %>" control="<%= $c->{'control'} %>">
									</label>
								<% } %>
							<% } %>
						</span>
					</div>
				<% } %>
			</div>
		</div>
	</div>
	<div id="studio_transport_panel" class="studio_panel">
		<div class="studio_panel_bar">
			<span class="studio_drag_handle" data-studio-drag="transport" hint="<%= &subs::ui('Drag to move the transport') %>"><%= &subs::ui('Transport') %></span>
			<span class="studio_panel_buttons">
				<button class="studio_panel_pin hover" data-panel="transport" aria-pressed="false" hint="<%= &subs::ui('Keep this panel above the others') %>">📌</button>
				<button class="studio_panel_min hover" data-panel="transport" hint="<%= &subs::ui('Minimize this panel') %>">–</button>
				<button class="studio_panel_max hover" data-panel="transport" aria-pressed="false" hint="<%= &subs::ui('Maximize or restore this panel') %>">□</button>
			</span>
		</div>
		<span class="studio_resize_handle" data-studio-resize="transport" hint="<%= &subs::ui('Drag to resize this panel') %>"></span>
		<span class="studio_panel_bottom" data-studio-bottom="transport" hint="<%= &subs::ui('Drag the bottom edge to resize this panel\'s height') %>"></span>
		<span id="studio_controls">
			<div class="studio_transport_row" id="studio_transport_row">
				<img class="little_thumb record hover" hint="Record" id="studio_record" src="<%= &subs::icon_for('/images/make believe/record.png') %>">
				<img class="little_thumb play hover" hint="Play" id="studio_play" src="<%= &subs::icon_for('/images/make believe/play.png') %>">
				<img class="little_thumb stop hover" hint="Stop" id="studio_stop" src="<%= &subs::icon_for('/images/make believe/stop.png') %>">
				<img class="little_thumb prev hover" hint="Previous" id="studio_prev" src="<%= &subs::icon_for('/images/make believe/left arrow.png') %>">
				<img class="little_thumb next hover" hint="Next" id="studio_next" src="<%= &subs::icon_for('/images/make believe/right arrow.png') %>">
				<span class="jog_wheel_frame">
					<img class="jog_wheel" hint="Jog wheel" id="studio_jog_wheel" src="<%= &subs::icon_for('/images/studio/jog wheel tye dye.png') %>">
					<span class="jog_wheel_centre" style="width:5px;height:5px;"></span>
				</span>
				<img class="little_thumb mark hover" hint="Drop a mark" id="studio_mark" src="<%= &subs::icon_for('/images/studio/plus.png') %>">
				<img class="little_thumb metronome hover" hint="Metronome" id="studio_metronome" src="<%= &subs::icon_for('/images/studio/metronome.png') %>">
				<span class="studio_monitor_note" id="studio_monitor_note" aria-live="polite"></span>
				<input class="studio_transport_field" id="studio_bpm" value="120" hint="<%= &subs::ui('Tempo in beats per minute') %>">
				<input class="studio_transport_field" id="studio_signature" value="4/4" hint="<%= &subs::ui('Time signature') %>">
				<% foreach my $k ( grep { $_->{'placement'} eq 'metronome' } @{$gb::studio->{'knobs'}}) { %>
					<input channel="metronome" type="range" name="<%= $k->{'control'} %>" control="<%= $k->{'control'} %>" class="knob_control <%= $k->{'control'} %>" style="display:none;">
					<img class="knob studio_transport_knob <%= $k->{'control'} %>" flip="<%= $k->{'flip'} %>" direction="<%= $k->{'direction'} %>" channel="metronome" control="<%= $k->{'control'} %>" hint="<%= &subs::format_name($k->{'control'}) %>" src="<%= &subs::icon_for('/images/studio/knob_' . $k->{'colour'} . '.png') %>">
				<% } %>
				<span class="studio_transport_time">
					<span class="studio_transport_clock"><span id="studio_time_display">0:00.0000</span><span class="studio_transport_sep">/</span><span id="studio_time_duration">0:00.0000</span></span>
					<span class="studio_transport_beats" id="studio_time_beats">0:0.00</span>
				</span>
				<img class="little_thumb hover video_toggle" hint="Camera" id="studio_video_toggle" src="<%= &subs::icon_for('/images/make believe/camera.png') %>">
				<img src="<%= &subs::icon_for('/images/studio/repeat.png') %>" hint="Loop" class="little_thumb hover" id="studio_loop">
			</div>
			<%# The video previews have no room in a one-row transport; they keep
			   their elements here, hidden, so the monitor code still finds them. %>
			<span id="studio_video_monitors" style="display:none;">
				<% for (my $ch = 1; $ch <= $channel_count; $ch++) { %>
					<video id="studio_video_monitor_<%= $ch %>" style="display:none;" muted autoplay class=""></video>
				<% } %>
				<video id="studio_video_monitor" style="display:none;" muted autoplay class=""></video>
			</span>
		</span>
	</div>
	</div>
	<div id="studio_open_dialog" class="studio_dialog" style="display:none;" role="dialog" aria-modal="true" aria-label="<%= &subs::ui('Open a studio song') %>">
		<div class="studio_dialog_bar">
			<b><%= &subs::ui('Open a studio song') %></b>
			<button id="studio_open_close" class="hover" hint="<%= &subs::ui('Close this list') %>"><%= &subs::ui('Close') %></button>
		</div>
		<div class="studio_dialog_list">
			<% if (@{$songs}) { %>
				<% foreach my $song ( @{$songs} ) { %>
					<button class="studio_open_row hover" data-uuid="<%= $song->{'uuid'} %>" hint="<%= &subs::ui('Open this song') %>">
						<span class="studio_open_name"><%= &subs::format_name($song->{'app'}) %></span>
						<span class="studio_open_time time" timestamp="<%= $song->{'timestamp'} %>"></span>
					</button>
				<% } %>
			<% } else { %>
				<p class="studio_dialog_empty"><%= &subs::ui('There are no saved studio songs yet.') %></p>
			<% } %>
		</div>
	</div>
</div>
<div id="studio_config" style="display:none;">
		<h1>Configure</h1>

		<div id="song_controls">
			<img id="studio_delete" hint="Delete" style="vertical-align:top;" class="little_thumb hover" src="<%= &subs::icon_for('/icons/trash.png') %>">
			<img class="little_thumb hover studio_config_toggle_close" hint="Configure" src="<%= &subs::icon_for('/images/decipherable/gear.png') %>" id="studio_config_close"><br>
			<input type="hidden" id="studio_name">
			<%# The old dropdown stays hidden: the Open dialog reads it, and the save
			   response replaces it, so no route learns a new shape. %>
			<div id="studio_song_select_holder" style="display:none;" aria-hidden="true">
				<%= include 'studio/song_select', songs => $songs, last_song => $last_song %>
			</div>
		</div>
		<div>
			<table style="width:98%;">
				<thead>
					<th>Setting</th>
					<th>Value</th>
				</thead>
				<tbody>
					<tr>
						<td>Channels</td>
						<td><input class="studio_config" setting="channel_count" value="<%= $settings->{'channel_count'} || 1 %>" restart="yes" hint="<%= &subs::ui('Tracks to open; Add track changes this live, 1 to 32') %>"></td>
					</tr>
					<tr>
						<td>Record offset (ms)<br><span style="font-size:12px;">shifts new takes earlier to cancel input latency</span></td>
						<td><input class="studio_config" setting="record_offset" value="<%= $settings->{'record_offset'} || '' %>"></td>
					</tr>
					<tr>
						<td>Crossfade (s)<br><span style="font-size:12px;">clips that meet ramp into each other</span></td>
						<td><input class="studio_config" setting="crossfade" value="<%= $settings->{'crossfade'} || '' %>"></td>
					</tr>
					<tr>
						<td>Loop bars<br><span style="font-size:12px;">arm a channel to L and record: the phrase loops over this many bars from where recording starts. 0 lets the phrase run free (its length follows Start on).</span></td>
						<td><input class="studio_config" setting="loop_bars" value="<%= $settings->{'loop_bars'} || 4 %>"></td>
					</tr>
					<tr>
						<td>Start on<br><span style="font-size:12px;">where a recording locks when it begins: the bar line, the nearest beat, or nothing at all (free wheeling from the playhead)</span></td>
						<td>
							<select class="studio_config" setting="snap">
								<option value="bar"<%= (($settings->{'snap'} || 'bar') eq 'bar') ? ' selected' : '' %>>bar</option>
								<option value="beat"<%= (($settings->{'snap'} || 'bar') eq 'beat') ? ' selected' : '' %>>beat</option>
								<option value="off"<%= (($settings->{'snap'} || 'bar') eq 'off') ? ' selected' : '' %>>off (free)</option>
							</select>
						</td>
					</tr>
					<tr>
						<td>Count-in (beats)<br><span style="font-size:12px;">clicks this many beats before recording starts; blank follows the signature (4 in 4/4), 0 turns it off</span></td>
						<td><input class="studio_config" setting="count_in" value="<%= $settings->{'count_in'} || '' %>"></td>
					</tr>
					<tr>
						<td>Monitor input<br><span style="font-size:12px;">hear the live input through the pedals: headphones only, speakers will feed back</span></td>
						<td>
							<select class="studio_config" setting="monitor">
								<option value="no"<%= (($settings->{'monitor'} || 'no') eq 'no') ? ' selected' : '' %>>no</option>
								<option value="yes"<%= (($settings->{'monitor'} || 'no') eq 'yes') ? ' selected' : '' %>>yes</option>
							</select>
						</td>
					</tr>
					<tr>
						<td colspan="2" style="padding-top:14px;"><b>Recording quality</b><br><span style="font-size:12px;">applies to the next recording. Bit depth is not selectable: browser recorders always encode Opus or AAC, so the sample rate, channels and bit rate are the quality knobs that exist.</span></td>
					</tr>
					<tr>
						<td>Video height<br><span style="font-size:12px;">320p up to the device maximum</span></td>
						<td>
							<select class="studio_config" setting="video_height">
								<option value=""<%= (($settings->{'video_height'} || '') eq '') ? ' selected' : '' %>>maximum</option>
								<% foreach my $h (1440, 1080, 720, 480, 360, 320) { %>
								<option value="<%= $h %>"<%= (($settings->{'video_height'} || '') eq $h) ? ' selected' : '' %>><%= $h %>p</option>
								<% } %>
							</select>
						</td>
					</tr>
					<tr>
						<td>Video frame rate<br><span style="font-size:12px;">fps; blank takes what the device offers</span></td>
						<td><input class="studio_config" setting="video_fps" value="<%= $settings->{'video_fps'} || '' %>"></td>
					</tr>
					<tr>
						<td>Video bit rate (Mbps)<br><span style="font-size:12px;">blank lets the browser choose</span></td>
						<td><input class="studio_config" setting="video_mbps" value="<%= $settings->{'video_mbps'} || '' %>"></td>
					</tr>
					<tr>
						<td>Audio bit rate (kbps)<br><span style="font-size:12px;">64 to 320</span></td>
						<td><input class="studio_config" setting="audio_kbps" value="<%= $settings->{'audio_kbps'} || 256 %>"></td>
					</tr>
					<tr>
						<td>Audio channels</td>
						<td>
							<select class="studio_config" setting="audio_channels">
								<option value="2"<%= (($settings->{'audio_channels'} || '2') eq '2') ? ' selected' : '' %>>stereo</option>
								<option value="1"<%= (($settings->{'audio_channels'} || '2') eq '1') ? ' selected' : '' %>>mono</option>
							</select>
						</td>
					</tr>
					<tr>
						<td>Sample rate<br><span style="font-size:12px;">changing this reboots the studio window, so save first</span></td>
						<td>
							<select class="studio_config" setting="sample_rate" restart="yes">
								<option value=""<%= (($settings->{'sample_rate'} || '') eq '') ? ' selected' : '' %>>device default</option>
								<option value="44100"<%= (($settings->{'sample_rate'} || '') eq '44100') ? ' selected' : '' %>>44100</option>
								<option value="48000"<%= (($settings->{'sample_rate'} || '') eq '48000') ? ' selected' : '' %>>48000</option>
							</select>
						</td>
					</tr>
					<tr>
						<td>Latency hint<br><span style="font-size:12px;">how small a buffer to ask the browser for; too low crackles. Fixed when the window opens, so it rebuilds (save first)</span></td>
						<td>
							<select class="studio_config" setting="latency_hint">
								<option value="interactive"<%= (($settings->{'latency_hint'} || 'interactive') eq 'interactive') ? ' selected' : '' %>>interactive (default)</option>
								<option value="balanced"<%= (($settings->{'latency_hint'} || '') eq 'balanced') ? ' selected' : '' %>>balanced</option>
								<option value="playback"<%= (($settings->{'latency_hint'} || '') eq 'playback') ? ' selected' : '' %>>playback (most robust)</option>
								<option value="0.01"<%= (($settings->{'latency_hint'} || '') eq '0.01') ? ' selected' : '' %>>low &mdash; 10 ms target</option>
								<option value="0.005"<%= (($settings->{'latency_hint'} || '') eq '0.005') ? ' selected' : '' %>>lower &mdash; 5 ms target</option>
								<option value="0.003"<%= (($settings->{'latency_hint'} || '') eq '0.003') ? ' selected' : '' %>>lowest &mdash; 3 ms target</option>
							</select>
						</td>
					</tr>
					<tr>
						<td>Latency<br><span style="font-size:12px;">what the browser reports for this session</span></td>
						<td><span id="studio_latency_info">&mdash;</span></td>
					</tr>
					<tr>
						<td colspan="2" style="padding-top:14px;"><b>Export</b><br><span style="font-size:12px;">renders the whole song once through every track's output pedals and fader and the mastering rack, then saves one mixed file named after the song</span></td>
					</tr>
					<tr>
						<td>Format</td>
						<td>
							<select id="studio_export_format" hint="<%= &subs::ui('Choose the export format') %>">
								<option value="wav">WAV</option>
								<option value="mp3" selected>MP3</option>
								<option value="flac">FLAC</option>
							</select>
						</td>
					</tr>
					<tr>
						<td>Bit rate (kbps)</td>
						<td>
							<select id="studio_export_bitrate" hint="<%= &subs::ui('Choose the export bit rate') %>">
								<option value="128">128</option>
								<option value="192" selected>192</option>
								<option value="256">256</option>
								<option value="320">320</option>
							</select>
						</td>
					</tr>
					<tr>
						<td>Master</td>
						<td><label><input type="checkbox" id="studio_export_master" checked hint="<%= &subs::ui('Include the mastering rack') %>"> <%= &subs::ui('Include the mastering rack') %></label></td>
					</tr>
					<tr>
						<td>Export now</td>
						<td><button id="studio_export_tracks" class="hover" hint="<%= &subs::ui('Export the whole song as one mixed audio file') %>"><%= &subs::ui('Export mix') %></button> <span id="studio_export_state" aria-live="polite"></span></td>
					</tr>
					<tr>
						<td><%= &subs::ui('Monitor through') %><br><span style="font-size:12px;"><%= &subs::ui('the native path Listen and Monitor use; only what this device has is listed') %></span></td>
						<td><select id="studio_monitor_backend" hint="<%= &subs::ui('Choose the native path the live monitor runs through') %>"><option value="auto"><%= &subs::ui('Auto') %></option></select> <label><%= &subs::ui('Buffer') %> <select id="studio_monitor_buffer" hint="<%= &subs::ui('Choose the live monitor buffer: Auto finds the shortest one this device holds, or pick a fixed one') %>"><option value="auto" selected><%= &subs::ui('Auto') %></option><option value="16">16 ms</option><option value="12">12 ms</option><option value="10">10 ms</option><option value="8">8 ms</option><option value="4">4 ms</option><option value="2">2 ms</option></select></label> <span id="studio_monitor_backend_note" aria-live="polite"></span></td>
					</tr>
					<tr>
						<td>Round trip<br><span style="font-size:12px;">plays a few clicks through the speakers and times the echo on the mic; use speakers (not headphones) and stay quiet</span></td>
						<td><select id="studio_latency_backend" hint="Measure the round trip through this browser or a native audio backend"><option value="javascript" selected>this browser</option><option value="alsa">ALSA</option><option value="pipewire">PipeWire</option><option value="jack">JACK</option></select> <button id="studio_latency_measure">Measure</button> <span id="studio_latency_result">&mdash;</span></td>
					</tr>
					<tr>
						<td colspan="2" style="padding-top:14px;"><b><%= &subs::ui('Engine take') %></b><br><span style="font-size:12px;"><%= &subs::ui('records on the native audio engine, beside the browser transport; the browser audio path is left alone') %></span></td>
					</tr>
					<tr>
						<td><%= &subs::ui('Output') %><br><span style="font-size:12px;"><%= &subs::ui('the interface the engine plays and records through') %></span></td>
						<td>
							<select id="studio_output_device" hint="<%= &subs::ui('Choose the output the engine plays through') %>"></select>
							<button type="button" id="studio_output_apply" hint="<%= &subs::ui('Use this output and restart the engine') %>"><%= &subs::ui('Use this output') %></button>
							<span id="studio_output_note" aria-live="polite"></span>
						</td>
					</tr>
					<tr>
						<td><%= &subs::ui('Start, stop and the strip') %><br><span style="font-size:12px;"><%= &subs::ui('seconds; one to eight tracks, each picking its own input and mono or stereo; each track records through its own rack; gain goes 0 to 4 and pan -1 to 1') %></span></td>
						<td id="studio_engine_panel">
							<button id="studio_engine_start" hint="<%= &subs::ui('Arm a take on the audio engine') %>"><%= &subs::ui('Start take') %></button>
							<button id="studio_engine_stop" hint="<%= &subs::ui('End the engine take and close its file') %>"><%= &subs::ui('Stop take') %></button>
							<label><%= &subs::ui('Seconds') %> <input id="studio_engine_seconds" value="10" size="4"></label>
							<label><%= &subs::ui('Tracks') %> <select id="studio_engine_tracks" hint="<%= &subs::ui('How many tracks the engine take records') %>"><% for my $n (1 .. 8) { %><option value="<%= $n %>"><%= $n %></option><% } %></select></label>
							<label><input type="checkbox" id="studio_engine_count_in" checked hint="<%= &subs::ui('Count in before an engine take starts') %>"> <%= &subs::ui('Count-in') %></label>
							<div id="studio_engine_inputs_rows"></div>
							<input type="hidden" id="studio_engine_inputs">
							<label><%= &subs::ui('Listen inserts') %> <input id="studio_engine_inserts" size="12" placeholder="tone,delay"></label>
							<hr>
							<button id="studio_listen_toggle" aria-pressed="false" hint="<%= &subs::ui('Start or stop live monitoring on the engine') %>"><%= &subs::ui('Listen') %></button>
							<label><%= &subs::ui('Listen input') %> <select id="studio_listen_input" hint="<%= &subs::ui('Choose the interface input to monitor: input 1 is channel 0, input 2 is channel 1') %>"><option value="0"><%= &subs::ui('Input 1 (channel 0)') %></option><option value="1"><%= &subs::ui('Input 2 (channel 1)') %></option></select></label>
							<label><%= &subs::ui('Listen gain') %> <input id="studio_listen_gain" type="range" min="0" max="4" step="0.01" value="0.8"></label>
							<div id="studio_listen_status" style="font-size:12px;">
								<span id="studio_listen_state">&mdash;</span>
								<span id="studio_listen_input_text"></span>
								<span id="studio_listen_frames"></span>
							</div>
							<div id="studio_engine_error" style="font-size:12px;"></div>
							<div id="studio_engine_monitor" style="font-size:12px;"></div>
							<div id="studio_engine_strips"></div>
						</td>
					</tr>
				</tbody>
			</table>
						
		</div>
	</div>

