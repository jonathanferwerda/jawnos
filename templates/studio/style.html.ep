		text-align: left;
	}
	.studio_drums_key {
		padding: 0;
		text-align: center;
		font-weight: bold;
	}
	/* a key button in Learn mode says so, in the accent colour */
	.studio_drums_key[aria-pressed="true"] {
		background: var(--accent-soft, var(--panel-2));
		border-color: var(--accent-line, var(--accent));
		color: var(--ink);
	}
	/* the mute lamp: green and lit when the voice sounds, dark when muted */
	.studio_drums_lamp {
		width: 14px;
		height: 14px;
		/* the house button rule gives every button a 28px floor; a lamp is not
		   a button to press with a thumb, it is a 14px roundel */
		min-width: 14px;
		max-width: 14px;
		min-height: 14px;
		max-height: 14px;
		padding: 0;
		border: 2px solid var(--line);
		border-radius: 50%;
		box-sizing: border-box;
		background: var(--runway-good, #2f7d4f);
		box-shadow: 0 0 6px color-mix(in srgb, var(--runway-good, #2f7d4f) 55%, transparent);
	}
	.studio_drums_lamp[aria-pressed="false"] {
		background: color-mix(in srgb, var(--ink) 28%, var(--panel-2));
		box-shadow: none;
	}
	.studio_drums_step {
		height: 22px;
		min-width: 13px;
		padding: 0;
		border: 1px solid var(--line);
		border-radius: 3px;
		background: var(--panel);
	}
	.studio_drums_step[aria-pressed="true"] {
		background: var(--accent);
		border-color: var(--accent-line, var(--accent));
	}
	.studio_drums_step[data-accent="yes"] {
		background: var(--accent-line, var(--accent));
		box-shadow: inset 0 0 0 2px var(--accent-ink, #fff);
	}
	/* the column the scheduler is sounding now */
	.studio_drums_step.studio_drums_playing {
		outline: 2px solid var(--accent-line, var(--accent));
		outline-offset: 1px;
	}
	.studio_drums_key_state {
		font-size: 11px;
		color: var(--ink-muted, var(--ink));
