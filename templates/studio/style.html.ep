	}
	.studio_menu_velocity span {
		min-width: 34px;
		text-align: center;
		font-variant-numeric: tabular-nums;
	}
	/* A placed beat carries its velocity as a CSS variable, so a soft hit reads
	   fainter than an accent without a second colour. */
	.studio_drums_step[aria-pressed="true"] {
		opacity: calc(.4 + var(--drums-velocity, 1) * .6);
	}
	/* the drum machine's Kit list sits beside Loop, in the same small type */
	.studio_drums_kit_label {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-size: 11px;
	}
	#studio_drums_kit {
		max-width: 112px;
		font-size: 11px;
		padding: 1px 3px;
	}
	/* ---- the drum machine -------------------------------------------------
	   Eight rows of sixteen steps. Every surface takes its colours from the
	   theme; the only fixed colours left are the pedal LEDs, which are lamps. */
	#studio_drums {
		display: flex;
		flex-direction: column;
		min-width: 0;
		min-height: 0;
	}
	#studio_drums_body {
		flex: 1 1 auto;
		min-height: 0;
		/* the chart is the only scroller; the footer stays in reach */
		overflow: hidden;
		padding: 4px;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	.studio_drums_scroll {
		flex: 1 1 auto;
		min-height: 0;
		overflow: auto;
	}
	/* one grid for the head and every row, so the sixteen columns line up */
	.studio_drums_head,
	.studio_drums_row {
		display: grid;
		grid-template-columns: 72px 24px 14px repeat(16, minmax(12px, 1fr));
		gap: 2px;
		align-items: center;
		min-width: 338px;
	}
	.studio_drums_head {
		position: sticky;
		top: 0;
		z-index: 1;
		align-items: end;
		min-height: 16px;
		padding-top: 3px;
		box-sizing: border-box;
		background: var(--panel-2);
