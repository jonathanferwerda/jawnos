<style>
	/* Every tile is the same 170x190 box: the artwork pedals, the palette's drawn
	   pedals and the tuner line up, and the row scrolls instead of overlapping.
	   The size leaves room for a row of knobs, a dropdown and the footswitch. */
	.pedal {
		width: 170px;
		height: 190px;
		flex: 0 0 auto;
		position: relative;
		left: auto;
		top: auto;
		box-sizing: border-box;
		border: 5px solid var(--line);
		border-radius: 10px;
		background: var(--panel-2);
		overflow: hidden;
		cursor: var(--jawnos-cursor-grab, grab);
		transition: transform .12s ease, box-shadow .12s ease;
	}
	/* Hovering lifts a tile a little, so a cramped row of knobs is readable
	   without making the whole sheet taller. The scroller's padding leaves the
	   scaled tile room, so nothing is clipped. */
	.pedal:hover,
	.pedal:focus-within {
		transform: scale(1.05);
		transform-origin: bottom center;
		z-index: 3;
		box-shadow: var(--shadow-2), 0 0 0 2px var(--accent-line, var(--accent));
	}
	/* The pedalboard is a bottom sheet over the console, not a grid row: opening
	   it never shrinks the arranged timeline and it cannot be pushed off the
	   window. Its own bar holds Close and the tiles scroll inside it. */
	#pedalboard {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 70002;
		/* the bar (20px) plus the 190px tiles, the scroller's padding and a thin
		   scrollbar: 238px */
		max-height: 238px;
		overflow: hidden;
		background-color: var(--panel-2);
		border-top: 3px solid var(--line);
		box-shadow: var(--shadow-2);
		box-sizing: border-box;
	}
	.studio_pedalboard_bar {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 8px;
		height: 20px;
		padding: 0 6px;
		box-sizing: border-box;
		flex: 0 0 auto;
	}
	#studio_pedalboard_close {
		font-size: 12px;
		/* the bar is 20px: the house button height would reach down onto a tile */
		height: 18px;
		min-height: 18px;
		line-height: 16px;
		padding: 0 4px;
	}
	#studio_pedalboard_pedals {
		position: static;
		display: flex;
		align-items: flex-start;
		gap: 12px;
		min-height: 0;
		max-height: 214px;
		/* room for a tile's hover scale above it, so the lift never clips */
		padding: 10px 10px 8px;
		box-sizing: border-box;
		/* sideways, and down only if the window really cannot give the row its
		   190px; a thin scrollbar is part of the 214px budget */
		overflow: auto;
		scrollbar-width: thin;
	}
	#studio_pedalboard_pedals::-webkit-scrollbar {
		width: 6px;
		height: 6px;
	}
	.pedal_background {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}
	/* A palette effect with no hand-drawn artwork is drawn from the theme at the
	   same size: a case frame, a body inside it, one knob per slider and the
	   footswitch. The frame matches the black case the artwork pedals wear, in
	   the theme's own dark end. */
	.pedal_graphic {
		background: color-mix(in srgb, var(--panel-2) 30%, #000);
	}
	.pedal_graphic::before {
		content: '';
		position: absolute;
		inset: 3px;
		z-index: 1;
		border-radius: 7px;
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .22), inset 0 0 0 2px rgba(0, 0, 0, .5);
		pointer-events: none;
	}
	.pedal_body {
		position: absolute;
		inset: 4px;
		z-index: 0;
		border-radius: 5px;
		background:
			radial-gradient(130% 90% at 50% -10%, color-mix(in srgb, var(--accent) 30%, transparent), transparent 62%),
			repeating-linear-gradient(90deg, rgba(255, 255, 255, .03) 0 2px, transparent 2px 5px),
			linear-gradient(180deg, color-mix(in srgb, var(--panel) 80%, var(--accent)) 0%, var(--panel-2) 55%, color-mix(in srgb, var(--panel-2) 82%, var(--ink)) 100%);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, .18), inset 0 -12px 20px rgba(0, 0, 0, .45);
		pointer-events: none;
	}
	/* two case screws, at the foot either side of the footswitch */
	.pedal_body::before,
	.pedal_body::after {
		content: '';
		position: absolute;
		bottom: 34px;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: radial-gradient(circle at 35% 35%, color-mix(in srgb, var(--ink) 55%, #fff), color-mix(in srgb, var(--ink) 35%, #000));
		box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .5);
	}
	.pedal_body::before { left: 8px; }
	.pedal_body::after { right: 8px; }
	.pedal_title {
		position: absolute;
		top: 7px;
		left: 12px;
		right: 12px;
		z-index: 4;
		text-align: center;
		font-size: 13px;
		line-height: 1.1;
		letter-spacing: .02em;
		color: var(--ink);
		text-shadow: 0 1px 1px rgba(0, 0, 0, .5);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.pedal_controls {
		position: absolute;
		left: 5px;
		right: 5px;
		top: 27px;
		bottom: 30px;
		z-index: 4;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 5px;
	}
	.pedal_knobs {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: center;
		/* four 35px knobs and their gaps fit one row inside the tile */
		gap: 2px 1px;
	}
	.pedal_knob {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1px;
		width: 35px;
		cursor: var(--jawnos-cursor-ns-resize, ns-resize);
	}
	.pedal_knob .knob {
		width: 30px;
		height: 30px;
	}
	.pedal_knob_label {
		font-size: 9px;
		line-height: 10px;
		text-align: center;
		white-space: nowrap;
		color: var(--ink);
		opacity: .85;
	}
	.pedal_select_row {
		display: flex;
		align-items: center;
		gap: 5px;
		width: 100%;
	}
	.pedal_select_row .pedal_knob_label {
		flex: 0 0 auto;
		opacity: .75;
	}
	/* the same small dropdown the shelf's reverb carries, in the pedal's row */
	.pedal_select,
	.pedal_model {
		box-sizing: border-box;
		height: 18px;
		min-height: 18px;
		padding: 0 4px;
		font-size: 10px;
		line-height: 16px;
		border-width: 1px;
		border-radius: 4px;
	}
	.pedal_select {
		flex: 1 1 auto;
		min-width: 0;
		width: auto;
	}
	/* The shelf's reverb model sits in its own row above the footswitch, clear
	   of the knobs; the old top-percentage position left it over Mix. */
	.pedal .pedal_model {
		position: absolute;
		left: 7%;
		right: 7%;
		bottom: 30px;
		width: auto;
		z-index: 6;
	}
	/* The footswitch is the pedal's own stomp switch: a domed treadle in the
	   case, and the lamp beside it reads the same state. Press it, or the lamp,
	   and the pedal switches where it stands. */
	.studio_pedal_foot {
		position: absolute;
		left: 50%;
		bottom: 4px;
		width: 74px;
		height: 22px;
		min-width: 0;
		min-height: 22px;
		max-height: 22px;
		padding: 0;
		line-height: 18px;
		font-size: 10px;
		letter-spacing: .06em;
		text-transform: uppercase;
		box-sizing: border-box;
		transform: translateX(-50%);
		border: 2px solid color-mix(in srgb, var(--panel-2) 25%, #000);
		border-radius: 11px;
		background:
			radial-gradient(120% 160% at 50% -20%, rgba(255, 255, 255, .5), transparent 55%),
			linear-gradient(180deg, color-mix(in srgb, var(--ink) 22%, var(--panel)) 0%, color-mix(in srgb, var(--ink) 38%, var(--panel)) 55%, color-mix(in srgb, var(--ink) 52%, var(--panel)) 100%);
		color: var(--ink);
		text-shadow: 0 1px 0 rgba(255, 255, 255, .28), 0 -1px 0 rgba(0, 0, 0, .4);
		box-shadow: 0 3px 0 color-mix(in srgb, var(--panel-2) 25%, #000), inset 0 1px 0 rgba(255, 255, 255, .55), inset 0 -4px 8px rgba(0, 0, 0, .3);
		cursor: var(--jawnos-cursor-pointer, pointer);
		z-index: 7;
	}
	.studio_pedal_foot[aria-pressed="true"] {
		background:
			radial-gradient(120% 160% at 50% -20%, rgba(255, 255, 255, .5), transparent 55%),
			linear-gradient(180deg, color-mix(in srgb, var(--accent) 62%, var(--panel)) 0%, color-mix(in srgb, var(--accent) 44%, var(--panel)) 60%, color-mix(in srgb, var(--accent) 32%, var(--panel)) 100%);
		color: var(--accent-ink, #fff);
		text-shadow: 0 -1px 0 rgba(0, 0, 0, .35);
		box-shadow: 0 3px 0 color-mix(in srgb, var(--panel-2) 25%, #000), 0 0 10px color-mix(in srgb, var(--accent) 55%, transparent), inset 0 1px 0 rgba(255, 255, 255, .45);
	}
	.studio_pedal_foot:active {
		bottom: 3px;
		box-shadow: 0 2px 0 color-mix(in srgb, var(--panel-2) 25%, #000), inset 0 2px 5px rgba(0, 0, 0, .45);
	}
	/* The lamp: a 14px roundel. The unlit state is a dark red disc with a pale
	   ring (never invisible); on it is a bright green with a soft glow. Every
	   tile and rack row carries one. */
	.studio_pedal_led {
		position: absolute;
		right: 6px;
		top: 6px;
		width: 14px;
		height: 14px;
		box-sizing: border-box;
		border: 2px solid #1b1414;
		border-radius: 50%;
		background: #5a1010;
		box-shadow: inset 0 1px 2px #000, 0 0 0 1px rgba(255, 255, 255, .3);
		cursor: var(--jawnos-cursor-pointer, pointer);
		z-index: 5;
	}
	.studio_pedal_led[aria-pressed="true"] {
		background: #35e05a;
		border-color: #0b4a1a;
		box-shadow: 0 0 10px #35e05a, 0 0 3px #fff, inset 0 1px 2px #0b4a1a;
	}
	/* Jtune's lamp is not an effect's lamp: it is the tuner's state light - grey
	   when it is off, amber while it listens, green in tune. */
	.pedal[data-tuner="yes"] .studio_pedal_led {
		background: #6b7280;
		border-color: #2b3138;
		box-shadow: inset 0 1px 2px #000, 0 0 0 1px rgba(255, 255, 255, .3);
	}
	.pedal[data-tuner="yes"] .studio_pedal_led.studio_tuner_listening {
		background: #f0b429;
		border-color: #6b4a05;
		box-shadow: 0 0 8px #f0b429, inset 0 1px 2px #6b4a05;
	}
	.pedal[data-tuner="yes"] .studio_pedal_led.studio_tuner_tuned {
		background: #35e05a;
		border-color: #0b4a1a;
		box-shadow: 0 0 10px #35e05a, 0 0 3px #fff, inset 0 1px 2px #0b4a1a;
	}
	/* The tuner's screen sits on Jtune's drawn yellow panel: the note between the
	   two arrows, and the cents (or the "press to tune" line) under it. The
	   colours are the screen's own ink, like the LEDs are lamps. */
	.studio_tuner {
		position: absolute;
		left: 13%;
		right: 13%;
		top: 30%;
		height: 29%;
		z-index: 3;
		display: grid;
		grid-template-columns: 18px minmax(0, 1fr) 18px;
		grid-template-rows: 1fr auto;
		align-items: center;
		justify-items: center;
		box-sizing: border-box;
		padding: 2px 4px;
		border-radius: 4px;
		background: color-mix(in srgb, #000 10%, transparent);
		color: #3a2f05;
		text-shadow: 0 1px 0 rgba(255, 255, 255, .45);
		font-family: monospace;
		pointer-events: none;
	}
	.studio_tuner_up { grid-area: 1 / 1; }
	.studio_tuner_note { grid-area: 1 / 2; display: inline-flex; align-items: baseline; gap: 2px; }
	.studio_tuner_down { grid-area: 1 / 3; }
	.studio_tuner_cents { grid-area: 2 / 1 / 2 / 4; font-size: 10px; line-height: 11px; font-weight: bold; white-space: nowrap; }
	.studio_tuner_letter { font-size: 24px; line-height: 24px; font-weight: bold; letter-spacing: .02em; }
	.studio_tuner_octave { font-size: 11px; }
	.studio_tuner_arrow { font-size: 14px; line-height: 14px; color: rgba(58, 47, 5, .4); }
	.studio_tuner_arrow_on { color: #b45309; text-shadow: 0 0 6px rgba(180, 83, 9, .65); }
	.studio_tuner_tuned .studio_tuner_letter,
	.studio_tuner_tuned .studio_tuner_cents { color: #1f7a3a; }
	.studio_tuner_off .studio_tuner_letter { font-size: 13px; letter-spacing: .08em; }
	.studio_rack_led {
		position: static;
		flex: 0 0 14px;
		width: 14px;
		height: 14px;
		align-self: center;
	}
	/* The insertion marker the rack sortable shows while a pedal is dragged. */
	.studio_rack_placeholder {
		display: block;
		height: 24px;
		margin: 2px 0;
		border: 1px dashed var(--accent);
		border-radius: 4px;
		background: var(--accent-soft, var(--panel-2));
	}
	/* the rack row dims when bypassed, but its lamp must stay readable */
	.studio_rack_off .studio_rack_led {
		opacity: 1;
	}
	#studio_pedalboard_toggle {
		right: 0px;
		bottom:60px;
		position:fixed;
	}
	/* the four docked panels and the docked pedalboard share the window's height */
	#studio_layout_bar { order: 1; }
	#studio_grid { order: 2; }
	#studio_controls {
		position: static;
		display: block;
		padding: 0;
		width: 100%;
	}
	/* One row: the buttons, the jog wheel, tempo, signature, position and the
	   metronome. It wraps only when the panel is genuinely too narrow. */
	.studio_transport_row {
		display: flex;
		align-items: center;
		gap: 4px;
		flex-wrap: wrap;
		padding: 2px 4px;
		box-sizing: border-box;
		width: 100%;
	}
	.studio_transport_row .little_thumb {
		width: 24px;
		height: 24px;
		flex: 0 0 24px;
	}
	.studio_transport_row .jog_wheel_frame {
		flex: 0 0 28px;
		width: 28px;
		height: 28px;
	}
	.studio_transport_row #studio_jog_wheel {
		width: 28px;
		height: 28px;
		left: 0;
		top: 0;
		position: static;
	}
	.studio_transport_field {
		width: 44px;
		height: 24px;
		font-size: 12px;
		vertical-align: middle;
	}
	.studio_transport_knob {
		position: static;
		width: 24px;
		height: 24px;
	}
	.studio_transport_time {
		display: inline-flex;
		align-items: baseline;
		gap: 3px;
		margin-left: auto;
		font-size: 18px;
		white-space: nowrap;
	}
	.studio_transport_sep {
		opacity: .5;
		font-size: 13px;
	}
	#studio_time_display {
		font-size: 18px;
	}
	#studio_track_container {
		/* the hidden media elements live inside the track area, a clipped 1px box:
		   they must never paint on the window (or the desk) beside it */
		position: absolute;
		left: 0;
		top: 0;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}
	.track {
		width: 100%;
		height: 100%;
		cursor: var(--jawnos-cursor-grab, grab);
	}
	.channel_fx {
		display: block;
		font-size: 10px;
		line-height: 1.15;
		word-break: break-word;
		max-height: 42px;
		overflow: hidden;
		color: var(--ink-muted, var(--ink));
	}
	.knob {
		width: 30px;
		aspect-ratio: 1 / 1;
		box-sizing: border-box;
		object-fit: contain;
		transform: rotate(180deg);
		border-radius: 50%;
	}
	.channel_fx_pedal {
		display: block;
		width: 100%;
		margin-bottom: 2px;
		border-radius: 3px;
	}
	.channel.selected_channel {
		box-shadow: inset 0 0 0 3px var(--accent);
	}
	.pedal_background {
		cursor: var(--jawnos-cursor-grab, grab);
	}
	.knob {
		cursor: var(--jawnos-cursor-ns-resize, ns-resize);
		touch-action: none;
	}
	.knob.knob_active {
		filter: brightness(1.3);
	}
	/* the value bubble a knob shows while it is dragged or rolled */
	#studio_knob_readout {
		position: absolute;
		display: none;
		z-index: 70000;
		padding: 1px 6px;
		background: var(--accent);
		color: var(--accent-ink, #fff);
		border-radius: 4px;
		font-size: 12px;
		pointer-events: none;
	}
	/* a channel's inserted-pedal badge jumps the pedalboard to that pedal */
	.channel_fx_pedal {
		cursor: var(--jawnos-cursor-pointer, pointer);
	}
	.pedal.pedal_revealed {
		box-shadow: 0 0 0 4px var(--accent);
	}
	.knob_control {
		appearance:none;
		width: 30px;
		height: 100px;

		writing-mode: vertical-lr;
	  direction: rtl;
	  vertical-align: middle;
	}
	.armed {
		height: 30px;
		width: 20px;
		/* the button never gives way to a fader drawn over the strip */
		position: relative;
		z-index: 1;
	}
	.armed[state=off] {
		background: var(--panel-2);
		color: var(--ink);
	}
	.armed[state=rec] {
		background: var(--runway-bad, #b3453f);
		color: #fff;
	}
	.armed[state=play] {
		background: var(--runway-good, #2f7d4f);
		color: #fff;
	}
	.armed[state=loop] {
		background: var(--accent);
		color: var(--accent-ink, #fff);
	}
	.cord {
		width:40px;
	}
	.jack {
		width:40px;
	}

	/* the fader and its metre live inside the strip, below the arm button, so
	   they can never sit on top of the record/play/loop toggle */
	/* the knobs and the volume fader sit side by side in the strip */
	.studio_strip_body {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		justify-content: center;
		gap: 2px;
		width: 100%;
		min-width: 0;
	}
	.studio_strip_knobs {
		display: flex;
		flex-direction: column;
		align-items: center;
		min-width: 0;
	}
	.channel_fader {
		position: relative;
		display: block;
		width: 34px;
		height: 120px;
		margin: 2px 0 4px 0;
		/* dropped to the foot of the strip when there is room for it, but it
		   stays below the arm button when the strip is short */
		margin-top: auto;
	}
	.channel_volume {
		position:absolute;
		appearance: none;
		height: 118px;
		width: 34px;
		left: 0;
		top: 0;
		border: solid;
		border-radius: 5px;
		border-width: .1px;
		background-color:transparent;
		color: var(--ink);
		outline: none;
	  writing-mode: vertical-lr;
	  direction: rtl;
	  vertical-align: middle;
		background-image: url('<%= &subs::icon_for('/images/studio/slider2.png') %>');
	}
	.channel_volume_metre {
		position:absolute;
		height: 118px;
		width: 30px;
		left: 2px;
		top: 1px;
		color: var(--ink);
		outline: none;
	  vertical-align: middle;

	}
	.channel {
		border: 2px solid var(--line);
		border-radius: 5px;
		background: var(--panel);
		width: 40px;
		height: auto;
		min-height: 0;
		display: inline-flex;
		flex-direction: column;
		align-items: center;
		padding-top:10px;
		position: relative;

	}
	/* controls keep their size whether or not the strip is tall enough */
	.channel > * {
		flex: none;
	}
	<%# The channel controls are per track now, so no per-channel rule is needed. %>
	#studio {
		height:100%;
		width:100%;
		border: 10px solid var(--line);
		border-radius: 10px;
		background: var(--panel);
		position: relative;
		box-sizing: border-box;
		min-width: 380px;
		/* the grid owns the height; the window never grows to fit a panel */
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}
	#studio_viewer {
		flex: 1 1 auto;
		min-height: 0;
		width: 100%;
		overflow-x: hidden;
		overflow-y: auto;
		background-color: var(--panel-2);
	}
	/* Configure is a full-window sheet. It takes the height the grid leaves,
	   and its own settings table plus the engine panel scroll inside it, so
	   nothing is clipped in a short window. The window's width and colour come
	   from here, not from inline style on the element. */
	#studio_config {
		flex: 1 1 auto;
		min-height: 0;
		width: 100%;
		box-sizing: border-box;
		overflow-y: auto;
		overflow-x: hidden;
		padding: 4px 10px;
		background-color: var(--panel);
	}
	/* The class stands the grid down while Configure is open: the viewer and the
	   panels behind it are out of the way, and a floated panel cannot overlap
	   the settings. Removing the class restores whatever the hide toggles set. */
	#studio.studio_config_open #studio_viewer { display: none; }
	#studio.studio_config_open #studio_grid,
	#studio.studio_config_open > .studio_panel,
	#studio.studio_config_open > .studio_synth_panel {
		display: none;
	}
	/* Manual packing is a column of flex rows. A row holds the panels that share
	   one line, so it is exactly as tall as its tallest panel: shorten a panel
	   and its row shrinks, the rows below move up and their flex-grow takes the
	   freed height. A row whose panels all carry a saved height is fixed; the
	   rest share what is left. A floated panel leaves the flow (07_layout.js).
	   Arrange swaps this for the explicit grid below. */
	.studio_grid {
		display: flex;
		flex-direction: column;
		gap: 6px;
		flex: 1 1 auto;
		min-height: 0;
		padding: 4px;
		box-sizing: border-box;
		overflow-y: auto;
	}
	.studio_grid_row {
		display: flex;
		flex-direction: row;
		align-items: stretch;
		gap: 6px;
		flex: 1 1 0;
		min-width: 0;
	}
	/* A docked panel never paints over its neighbour: each one is a scroll box
	   (`min-height: 0` + `overflow: auto`) and its own content scrolls inside. */
	.studio_grid > div,
	.studio_grid_row > div {
		min-width: 0;
		min-height: 0;
		position: relative;
		overflow: auto;
	}
	.studio_grid > div {
		grid-column: span 1;
	}
	/* the row is a flex box, not one more scroll box */
	.studio_grid > .studio_grid_row {
		min-height: 120px;
		overflow: visible;
		position: static;
	}
	/* Content widths in manual packing: the instruments start at a sensible
	   width (the drums fit their sixteen steps, the synth its preset row) and
	   the tracks panel grows into what is left. A saved width wins. */
	.studio_grid_row > #studio_synth {
		flex: 0 1 auto;
		width: 300px;
		min-width: 220px;
	}
	.studio_grid_row > #studio_drums {
		flex: 0 1 auto;
		width: 360px;
		min-width: 320px;
	}
	.studio_grid_row > #studio_tracks_panel {
		flex: 1 1 280px;
	}
	.studio_grid_row > #studio_mixer {
		flex: 1 1 300px;
	}
	.studio_grid_row > #studio_transport_panel {
		flex: 1 1 100%;
		max-height: 104px;
		align-self: flex-start;
	}
	/* ---- arranged mode ------------------------------------------------------
	   Arrange gives the grid its explicit DAW areas: the transport keeps only
	   its own height, the timeline takes the flexible middle with the synth
	   beside it, and the console gets a compact band at the foot. The placement
	   is `!important` so the manual order/span inline styles (kept for when
	   arranged mode ends) cannot override the named areas. 07_layout.js removes
	   .studio_arranged the moment a panel is moved, floated, docked, widened or
	   re-ordered, and the manual packing takes over again. */
	#studio_grid.studio_arranged {
		display: grid;
		/* the tracks column takes what is left; the synth starts at its preset
		   row's width and stops at 300px */
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(220px, 300px);
		grid-auto-flow: dense;
		grid-auto-rows: minmax(0, 1fr);
		/* the console row is auto: its own 132px cap sizes the band, and that is
		   well under 45% of the grid at the target window sizes, so the timeline
		   keeps the room */
		/* the timeline keeps a track's worth (90px) even on a short window, and
		   the console takes at most 45% of the grid rather than sizing its row to
		   the strip's full height and leaving the timeline at zero */
		grid-template-rows: auto minmax(90px, 1fr) minmax(120px, 45%);
		grid-template-areas:
			"transport transport transport"
			"tracks tracks synth"
			"mixer mixer mixer";
		grid-auto-flow: row;
		/* a very short window scrolls the whole arranged grid rather than
		   clipping an area; each panel still scrolls inside itself */
		overflow-y: auto;
	}
	#studio_grid.studio_arranged > #studio_transport_panel {
		grid-area: transport !important;
		/* one row that grows only when it wraps on a narrow window */
		height: auto;
		min-height: 56px;
		max-height: 104px;
	}
	#studio_grid.studio_arranged > #studio_tracks_panel {
		grid-area: tracks !important;
	}
	#studio_grid.studio_arranged > #studio_synth {
		grid-area: synth !important;
	}
	/* The drum machine is a fifth panel. Arrange gives it a column of its own
	   only while it is docked and visible; hide or float it and the three-column
	   grid above returns, so the timeline and the synth reclaim the width. The
	   timeline keeps its full height either way. */
	#studio_grid.studio_arranged.studio_drums_open {
		/* content-sized instrument columns beside a tracks column that takes the
		   rest: the drums keep their sixteen steps readable, the synth its
		   preset row, and the timeline gets everything else */
		grid-template-columns: minmax(0, 1fr) clamp(260px, 28%, 320px) clamp(320px, 36%, 360px);
		grid-template-areas:
			"transport transport transport"
			"tracks synth drums"
			"mixer mixer mixer";
	}
	#studio_grid.studio_arranged.studio_drums_open > #studio_drums {
		grid-area: drums !important;
	}
	#studio_grid.studio_arranged_compact.studio_drums_open {
		grid-template-rows: auto minmax(0, 1fr) auto auto auto;
		grid-template-areas:
			"transport"
			"tracks"
			"mixer"
			"synth"
			"drums";
	}
	#studio_grid.studio_arranged_compact.studio_drums_open > #studio_drums {
		grid-area: drums !important;
		height: auto;
		max-height: 190px;
	}
	#studio_grid.studio_arranged > #studio_mixer {
		grid-area: mixer !important;
		height: auto;
		/* the bar plus a whole channel strip (the strips are ~240px of knobs
		   and jacks under the window's own control sizes); the row's 45% cap
		   keeps it from starving the timeline, and the grip still trades the
		   two */
		height: 100%;
		max-height: 100%;
	}
	/* A phone-width window stacks the same areas: transport, dominant timeline,
	   a compact console, then the synth. The fixed auto-row heights are small so
	   a short window still leaves the timeline room; every panel scrolls. */
	#studio_grid.studio_arranged_compact {
		grid-template-columns: minmax(0, 1fr);
		grid-template-rows: auto minmax(0, 1fr) auto auto;
		grid-template-areas:
			"transport"
			"tracks"
			"mixer"
			"synth";
		grid-auto-flow: row;
		overflow-y: auto;
	}
	#studio_grid.studio_arranged_compact > #studio_transport_panel {
		grid-area: transport !important;
		height: auto;
		min-height: 56px;
	}
	#studio_grid.studio_arranged_compact > #studio_tracks_panel {
		grid-area: tracks !important;
	}
	#studio_grid.studio_arranged_compact > #studio_mixer {
		grid-area: mixer !important;
		height: 104px;
	}
	#studio_grid.studio_arranged_compact > #studio_synth {
		grid-area: synth !important;
		height: 104px;
	}
	#studio_mixer {
		min-width: 0;
		min-height: 0;
		width: 100%;
		background-color: var(--panel-2);
		display: flex;
		flex-direction: column;
		overflow: auto;
	}
	#studio_mixer_strips {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		gap: 4px;
		padding: 4px;
		box-sizing: border-box;
		/* strips scroll both ways: their faders are reachable even when the
		   panel is short, and many strips still scroll sideways */
		overflow-x: auto;
		overflow-y: auto;
		flex: 1 1 auto;
		min-height: 0;
	}
	/* The strips fill the console: they grow into the room the master leaves,
	   and only scroll once 76px each is no longer available. */
	#studio_mixer_strips .channel {
		flex: 1 1 88px;
		min-width: 76px;
		height: auto;
		min-height: 0;
	}
	#studio_transport_panel {
		position: relative;
		min-width: 0;
		min-height: 0;
		width: 100%;
		/* the transport and its video previews scroll inside the window; nothing
		   in this panel may paint below it */
		overflow: auto;
	}
	#studio_jog_wheel {
		border-radius: 50%;
	}
	.jog_wheel_frame {
		position: relative;
		display: inline-block;
		flex: 0 0 44px;
		width: 44px;
		height: 44px;
		vertical-align: middle;
	}
	.jog_wheel_frame .jog_wheel_centre {
		position: absolute;
		left: 50%;
		top: 50%;
		margin-left: -2px;
		margin-top: -2px;
	}
	#studio_time_display {
		font-size: 18px;
	}
	#studio_synth {
		min-width: 0;
		min-height: 0;
		overflow: auto;
	}
	/* Studio is a desk-wide app. The dock and the taskbar sit at 39997/39998;
	   raising the Studio window above them keeps the transport clickable at
	   800x600 without taking the desk's start menu or power menu with it. */
	@media (min-width: 640px) {
		.wind[app="studio"] { z-index: 39999 !important; }
	}
	/* ---- layout bar, per-track panels and floating panels ------------------ */
	.studio_layout_bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 4px;
		padding: 3px 4px;
		flex: 0 0 auto;
	}
	.studio_layout_bar button {
		font-size: 12px;
	}
	/* the effect palette: add any contract effect to the selected track */
	.studio_effect_palette {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		margin-left: 6px;
	}
	.studio_effect_palette select {
		font-size: 12px;
		max-width: 150px;
	}
	.studio_palette_label,
	.studio_palette_channel {
		font-size: 12px;
		opacity: .7;
	}
	.studio_rack_template {
		display: none;
	}
	.studio_track_count {
		font-size: 12px;
		opacity: .7;
		padding: 0 4px;
	}
	#studio_tracks_panel {
		display: flex;
		flex-direction: column;
		min-width: 0;
		min-height: 0;
		position: relative;
		overflow: auto;
	}
	.studio_panel_bar {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 2px 4px;
		flex: 0 0 auto;
		background: color-mix(in srgb, var(--ink) 8%, transparent);
		position: relative;
		z-index: 2;
	}
	.studio_drag_handle {
		cursor: var(--jawnos-cursor-grab, grab);
		touch-action: none;
		user-select: none;
		font-weight: bold;
	}
	.studio_panel_bar .studio_drag_handle {
		font-size: 12px;
	}
	.studio_dock {
		display: none;
	}
	.studio_panel_floating .studio_dock {
		display: inline-block;
	}
	/* the width toggle belongs to a docked panel; a float is sized by its box */
	.studio_span_toggle {
		font-size: 12px;
	}
	.studio_panel_floating .studio_span_toggle {
		display: none;
	}
	.studio_panel_floating {
		position: absolute !important;
		z-index: 70000;
		background: var(--panel, #eee);
		border: 2px solid var(--line, #333);
		border-radius: 8px;
		box-shadow: var(--shadow-2);
		max-width: 96%;
		max-height: 92%;
		overflow: auto;
	}
	.studio_panel_dragging {
		opacity: .92;
		cursor: var(--jawnos-cursor-grabbing, grabbing);
	}
	/* a resize grip rides the floated panel's bottom-right corner */
	.studio_resize_handle {
		display: block;
		position: absolute;
		right: 0;
		bottom: 0;
		width: 18px;
		height: 18px;
		/* above the width grip: the corner belongs to the height drag */
		z-index: 4;
		cursor: var(--jawnos-cursor-nwse-resize, nwse-resize);
		touch-action: none;
		background: linear-gradient(135deg, transparent 0 42%, var(--line, #333) 43% 50%, transparent 51% 62%, var(--line, #333) 63% 70%, transparent 71%);
	}
	/* a width grip rides the docked panel's right edge; the corner keeps height */
	.studio_width_handle {
		display: block;
		position: absolute;
		right: 0;
		top: 0;
		bottom: 0;
		width: 8px;
		z-index: 3;
		cursor: var(--jawnos-cursor-ew-resize, ew-resize);
		touch-action: none;
	}
	.studio_width_handle:hover {
		background: color-mix(in srgb, var(--accent) 35%, transparent);
	}
	.studio_panel_floating .studio_width_handle {
		display: none;
	}
	.studio_panel_resizing { cursor: var(--jawnos-cursor-nwse-resize, nwse-resize); }
	/* A track has its own row height (90px by default); its bottom edge is the
	   grip. The timeline scrolls; it never stretches one track to fill the panel. */
	.studio_track {
		display: flex;
		align-items: stretch;
		gap: 4px;
		position: relative;
		height: var(--studio_track_height, 90px);
		min-height: 64px;
		flex: 0 0 auto;
		border-bottom: 1px solid var(--line);
	}
	.studio_track_panel {
		flex: 0 0 150px;
		width: 150px;
		height: 100%;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding: 2px 4px;
		background: var(--panel);
		border-right: 1px solid var(--line);
		min-width: 0;
		overflow: hidden;
		cursor: var(--jawnos-cursor-pointer, pointer);
	}
	.studio_track_panel.selected_channel {
		box-shadow: inset 0 0 0 3px var(--accent);
	}
	.studio_track_line {
		display: flex;
		align-items: center;
		gap: 3px;
		min-width: 0;
	}
	.studio_track_line > * {
		flex: none;
	}
	.studio_track_arm {
		min-width: 22px;
	}
	.studio_track_name {
		flex: 1 1 auto !important;
		min-width: 0;
		width: 100%;
		font-size: 12px;
		border: solid 1px var(--line, #999);
		border-radius: 3px;
		background: var(--panel);
		color: var(--ink);
	}
	.studio_track_actions {
		display: flex;
		gap: 2px;
		min-width: 0;
		overflow: hidden;
	}
	.studio_track_fx,
	.studio_track_automation,
	.studio_track_monitor,
	.studio_track_delete {
		font-size: 10px;
		padding: 0 3px;
		flex: 0 0 auto;
	}
	.studio_track_automation[aria-pressed="true"],
	.studio_track_monitor[aria-pressed="true"] {
		background: var(--accent-soft, var(--accent));
		color: var(--ink);
	}
	.studio_track_resize {
		position: absolute;
		left: 0;
		right: 0;
		bottom: -3px;
		height: 7px;
		z-index: 4;
		cursor: var(--jawnos-cursor-ns-resize, ns-resize);
		touch-action: none;
	}
	.studio_track_resize:hover {
		background: var(--accent);
		opacity: .35;
	}
	.studio_track_resizing {
		cursor: var(--jawnos-cursor-ns-resize, ns-resize);
	}
	/* while the edge is dragged the canvas must not swallow the pointer */
	.studio_track_resizing .track {
		pointer-events: none;
	}
	.studio_track_panel .channel_volume {
		position: relative;
		width: 100%;
		height: 18px;
		writing-mode: horizontal-tb;
		direction: ltr;
		background-image: none;
		border-radius: 9px;
		flex: 1 1 auto !important;
	}
	.studio_monitor_note {
		font-size: 11px;
		color: var(--danger, #c53030);
		max-width: 220px;
		line-height: 1.2;
	}
	.studio_monitor_toggle[aria-pressed="true"] {
		background: var(--accent-soft, var(--accent));
		border-color: var(--accent-line, var(--accent));
		color: var(--accent-ink, inherit);
	}
	.studio_track_panel .channel_volume_metre {
		position: relative;
		left: 0;
		top: 0;
		width: 80px;
		height: 6px;
	}
	.studio_track_panel .channel_fx {
		display: none;
		max-height: 34px;
	}
	.studio_track_panel .channel_fx.studio_fx_open {
		display: block;
	}
	/* A track's rack is the ordered chain itself: FX opens it under the panel. */
	.studio_channel_rack {
		display: none;
		margin-top: 2px;
		font-size: 11px;
		max-height: 260px;
		overflow-y: auto;
	}
	.studio_track.studio_fx_open .studio_channel_rack {
		display: block;
	}
	.studio_rack_row {
		border: 1px solid var(--line);
		border-radius: 4px;
		padding: 2px;
		margin-bottom: 2px;
		background: var(--panel);
		color: var(--ink);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 2px;
	}
	.studio_rack_row.studio_rack_off {
		opacity: .45;
	}
	.studio_rack_handle {
		cursor: var(--jawnos-cursor-grab, grab);
		padding: 0 2px;
	}
	.studio_rack_name {
		flex: 1 1 auto;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-weight: bold;
	}
	.studio_rack_row button {
		font-size: 10px;
		padding: 0 3px;
	}
	.studio_rack_controls {
		flex: 1 1 100%;
		display: flex;
		flex-wrap: wrap;
		gap: 2px 6px;
	}
	.studio_rack_control {
		display: flex;
		flex-direction: column;
		font-size: 9px;
	}
	.studio_rack_control input[type=range] {
		width: 64px;
	}
	.studio_rack_control select {
		max-width: 90px;
		font-size: 10px;
	}
	.channel_fx_pedal.studio_fx_bypassed,
	.channel_fx_text.studio_fx_bypassed {
		opacity: .45;
		text-decoration: line-through;
	}
	/* The mastering chain: one rack on the mixer's own bus, and the strips' last
	   child so it sits at their far right. It is a compact block that wraps and
	   scrolls inside its own box instead of spilling over the strips. */
	.studio_master_rack {
		flex: 0 0 210px;
		width: 210px;
		align-self: stretch;
		max-height: 100%;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		gap: 3px;
		padding: 4px;
		border-left: 2px solid var(--line);
		overflow: auto;
	}
	.studio_master_title {
		flex: 0 0 auto;
		font-size: 12px;
	}
	.studio_master_effect {
		border: 1px solid var(--line);
		border-radius: 4px;
		padding: 2px 4px;
		background: var(--panel);
		color: var(--ink);
		font-size: 11px;
		box-sizing: border-box;
	}
	.studio_master_effect.studio_master_on {
		background: var(--accent-soft, var(--panel-2));
		border-color: var(--accent-line, var(--accent));
	}
	.studio_master_toggle {
		font-size: 11px;
	}
	.studio_master_controls {
		display: flex;
		flex-wrap: wrap;
		gap: 2px 6px;
	}
	.studio_master_label {
		display: flex;
		flex-direction: column;
		font-size: 9px;
	}
	.studio_master_label input[type=range] {
		width: 54px;
	}
	.studio_master_label select {
		max-width: 100px;
		font-size: 10px;
	}
	.studio_track_body {
		position: relative;
		flex: 1 1 auto;
		min-width: 0;
		display: flex;
		flex-direction: column;
	}
	.studio_track_body .track {
		/* the lane below it is a sibling, so the canvas takes what is left
		   rather than 100% of the row */
		flex: 1 1 auto;
		min-height: 0;
		width: 100%;
		height: auto;
		box-sizing: border-box;
	}
	.studio_track_automation_lane {
		display: none;
		flex: 0 0 26px;
		height: 26px;
		padding: 2px 5px;
		font-size: 11px;
		box-sizing: border-box;
		background: color-mix(in srgb, var(--accent) 14%, transparent);
		border-top: 1px dashed var(--accent-line, var(--accent));
		color: var(--ink);
	}
	.studio_track.studio_track_automation_on .studio_track_automation_lane {
		display: block;
	}
	/* ---- timeline ruler ----------------------------------------------------
	   The ruler's first cell is exactly a track's panel column (150px + the
	   row's 4px gap), so a ruler click and the playhead line up over every
	   canvas below it. The canvas repaints itself from studioDrawRuler(). */
	.studio_ruler {
		display: flex;
		align-items: stretch;
		gap: 4px;
		flex: 0 0 auto;
		height: 22px;
		border-bottom: 1px solid var(--line);
		background: var(--panel);
		position: sticky;
		top: 0;
		z-index: 3;
	}
	.studio_ruler_pad {
		flex: 0 0 150px;
		width: 150px;
	}
	.studio_ruler_canvas {
		flex: 1 1 auto;
		min-width: 0;
		width: 100%;
		height: 21px;
		box-sizing: border-box;
		cursor: var(--jawnos-cursor-pointer, pointer);
		touch-action: none;
	}
	/* A track's own colour dresses its panel edge, so a selected row reads at a
	   glance; the canvas paint uses the same value (studioTrackColour). */
	.studio_track_colour {
		flex: 0 0 18px;
		width: 18px;
		min-width: 18px;
		height: 18px;
		padding: 0;
		border: 1px solid var(--line);
		border-radius: 3px;
		background: none;
		cursor: var(--jawnos-cursor-pointer, pointer);
	}
	.studio_track[data-colour] .studio_track_panel {
		border-right-color: var(--studio-track-colour, var(--line));
		border-left: 3px solid var(--studio-track-colour, transparent);
	}
	/* ---- small context menus -----------------------------------------------
	   One themed card for the timeline's clip menu and a beat's velocity menu.
	   The caller positions it in viewport coordinates and removes it on the
	   next press, exactly as the Clothesline menu does. */
	.studio_menu {
		position: fixed;
		z-index: 60000;
		min-width: 148px;
		padding: 4px;
		border: 1px solid var(--line);
		border-radius: calc(var(--jawnos-corner, 12px) * .6);
		background: var(--panel);
		color: var(--ink);
		box-shadow: var(--shadow-2, 0 8px 24px rgba(0, 0, 0, .28));
