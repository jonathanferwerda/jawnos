<style>
	/* Every tile is the same 170x190 box: the artwork pedals, the palette's drawn
	   pedals and the tuner line up, and the row scrolls instead of overlapping.
	   The size leaves room for a row of knobs, a dropdown and the footswitch. */
	.pedal {
		width: 170px;
		height: 190px;
		flex: 0 0 auto;
		position: relative;
		left: auto;
		top: auto;
		box-sizing: border-box;
		border: 5px solid var(--line);
		border-radius: 10px;
		background: var(--panel-2);
		overflow: hidden;
		cursor: var(--jawnos-cursor-grab, grab);
		transition: transform .12s ease, box-shadow .12s ease;
	}
	/* Hovering lifts a tile a little, so a cramped row of knobs is readable
	   without making the whole sheet taller. The scroller's padding leaves the
	   scaled tile room, so nothing is clipped. */
	.pedal:hover,
	.pedal:focus-within {
		transform: scale(1.05);
		transform-origin: bottom center;
		z-index: 3;
		box-shadow: var(--shadow-2), 0 0 0 2px var(--accent-line, var(--accent));
	}
	/* The pedalboard is a bottom sheet over the console, not a grid row: opening
	   it never shrinks the arranged timeline and it cannot be pushed off the
	   window. Its own bar holds Close and the Add list, and the selected track's
	   chain sits under the bar. */
	#pedalboard {
		display: flex;
		flex-direction: column;
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 70002;
		/* the bar plus the chain's bounded scroll box */
		max-height: 344px;
		overflow: hidden;
		background-color: var(--panel-2);
		border-top: 3px solid var(--line);
		box-shadow: var(--shadow-2);
		box-sizing: border-box;
	}
	/* Once the board is carried into the Tracks panel it is a row of that panel,
	   right under the track whose chain it draws: no longer a sheet over the
	   console. #studio_viewer is position: relative and its selection overlay is
	   an absolute inset: 0 at z-index 2, so the board sits above it and the rack
	   keeps its own horizontal scroll. The absolute rules above still cover the
	   moment between the page loading and the first open. */
	#studio_viewer > #pedalboard,
	#pedalboard.studio_board_inline {
		position: relative;
		left: auto;
		top: auto;
		right: auto;
		bottom: auto;
		width: 100%;
		max-height: 300px;
		z-index: 3;
		border-top: 2px solid var(--line);
		border-bottom: 2px solid var(--line);
		box-shadow: none;
		box-sizing: border-box;
	}
	/* The board's header (the In/Out switch) and the tiles themselves. */
	#studio_pedalboard_chain {
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 2px 10px;
		flex: 0 0 auto;
	}
	#studio_pedalboard_rack {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		gap: 12px;
		min-height: 0;
		max-height: 240px;
		overflow-x: auto;
		overflow-y: hidden;
		padding: 10px;
		box-sizing: border-box;
		border-bottom: 1px solid var(--line);
	}
	/* A mouse with one wheel can still move the board: the wheel scrolls the
	   rack sideways (04_knobs) and this thin bar can be dragged. The shared
	   sheet hides every scrollbar, so the board asks for its own one back. */
	#studio_pedalboard_rack {
		scrollbar-width: thin;
	}
	#studio_pedalboard_rack::-webkit-scrollbar {
		display: block;
		height: 10px;
	}
	#studio_pedalboard_rack::-webkit-scrollbar-track {
		background: color-mix(in srgb, var(--ink) 8%, transparent);
		border-radius: 5px;
	}
	#studio_pedalboard_rack::-webkit-scrollbar-thumb {
		background: var(--line);
		border-radius: 5px;
	}
	#studio_pedalboard_rack .pedal {
		margin: 0;
	}
	.studio_board_tools {
		position: absolute;
		left: 4px;
		top: 4px;
		display: flex;
		gap: 2px;
		/* Above the title and controls that share the tile's face, so a tool is
		   always the thing the pointer lands on. */
		z-index: 6;
	}
	.studio_board_tools button {
		font-size: 10px;
		min-width: 0;
		height: 16px;
		min-height: 16px;
		line-height: 14px;
		padding: 0 3px;
	}
	.studio_board_empty {
		opacity: .6;
		font-size: 12px;
		padding: 8px;
	}
	/* A controller mirrors another machine and has no pedal command, so the
	   sheet says it is read-only rather than swallowing every press in silence. */
	.studio_pedalboard_remote {
		display: block;
		padding: 4px 10px;
		font-size: 12px;
		line-height: 1.25;
		color: var(--ink);
		background: var(--accent-soft, var(--panel-2));
		border-bottom: 1px solid var(--line);
	}
	.studio_board_readonly #studio_pedalboard_rack {
		opacity: .55;
	}
	.studio_board_readonly .studio_pedal_foot,
	.studio_board_readonly .studio_pedal_led,
	.studio_board_readonly .studio_board_tools,
	.studio_board_readonly .studio_chain_choice,
	.studio_board_readonly #studio_palette_add,
	.studio_board_readonly #studio_palette_effect {
		cursor: var(--jawnos-cursor-not-allowed, not-allowed);
	}
	.studio_pedalboard_bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		height: auto;
		min-height: 20px;
		flex-wrap: wrap;
		padding: 0 6px;
		box-sizing: border-box;
		flex: 0 0 auto;
	}
	/* The saved-board group: a name, Save and the recently-used list, kept in
	   the bar so a board can be named and recalled without leaving the rack. */
	.studio_board_presets {
		display: inline-flex;
		align-items: center;
		gap: 3px;
		flex-wrap: wrap;
	}
	.studio_board_presets button {
		font-size: 12px;
		height: 18px;
		min-height: 18px;
		line-height: 16px;
		padding: 0 4px;
	}
	.studio_board_save_name {
		width: 110px;
		font-size: 12px;
	}
	#studio_board_presets {
		max-width: 150px;
		font-size: 12px;
	}
	#studio_pedalboard_close {
		font-size: 12px;
		/* the bar is 20px: the house button height would reach down onto a tile */
		height: 18px;
		min-height: 18px;
		line-height: 16px;
		padding: 0 4px;
		/* the palette keeps the left; Close sits at the right edge */
		margin-left: auto;
	}
	#studio_palette_add {
		font-size: 12px;
		height: 18px;
		min-height: 18px;
		line-height: 16px;
		padding: 0 6px;
	}
	.pedal_background {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}
	/* A palette effect with no hand-drawn artwork is drawn from the theme at the
	   same size: a case frame, a body inside it, one knob per slider and the
	   footswitch. The frame matches the black case the artwork pedals wear, in
	   the theme's own dark end. */
	.pedal_graphic {
		background: color-mix(in srgb, var(--panel-2) 30%, #000);
	}
	.pedal_graphic::before {
		content: '';
		position: absolute;
		inset: 3px;
		z-index: 1;
		border-radius: 7px;
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .22), inset 0 0 0 2px rgba(0, 0, 0, .5);
		pointer-events: none;
	}
	.pedal_body {
		position: absolute;
		inset: 4px;
		z-index: 0;
		border-radius: 5px;
		background:
			radial-gradient(130% 90% at 50% -10%, color-mix(in srgb, var(--accent) 30%, transparent), transparent 62%),
			repeating-linear-gradient(90deg, rgba(255, 255, 255, .03) 0 2px, transparent 2px 5px),
			linear-gradient(180deg, color-mix(in srgb, var(--panel) 80%, var(--accent)) 0%, var(--panel-2) 55%, color-mix(in srgb, var(--panel-2) 82%, var(--ink)) 100%);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, .18), inset 0 -12px 20px rgba(0, 0, 0, .45);
		pointer-events: none;
	}
	/* two case screws, at the foot either side of the footswitch */
	.pedal_body::before,
	.pedal_body::after {
		content: '';
		position: absolute;
		bottom: 34px;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: radial-gradient(circle at 35% 35%, color-mix(in srgb, var(--ink) 55%, #fff), color-mix(in srgb, var(--ink) 35%, #000));
		box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .5);
	}
	.pedal_body::before { left: 8px; }
	.pedal_body::after { right: 8px; }
	.pedal_title {
		position: absolute;
		top: 7px;
		left: 12px;
		right: 12px;
		z-index: 4;
		text-align: center;
		font-size: 13px;
		line-height: 1.1;
		letter-spacing: .02em;
		color: var(--ink);
		text-shadow: 0 1px 1px rgba(0, 0, 0, .5);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.pedal_controls {
		position: absolute;
		left: 5px;
		right: 5px;
		top: 27px;
		bottom: 30px;
		z-index: 4;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 5px;
	}
	.pedal_knobs {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: center;
		/* four 35px knobs and their gaps fit one row inside the tile */
		gap: 2px 1px;
	}
	.pedal_knob {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1px;
		width: 35px;
		cursor: var(--jawnos-cursor-ns-resize, ns-resize);
	}
	.pedal_knob .knob {
		width: 30px;
		height: 30px;
	}
	.pedal_knob_label {
		font-size: 9px;
		line-height: 10px;
		text-align: center;
		white-space: nowrap;
		color: var(--ink);
		opacity: .85;
	}
	.pedal_select_row {
		display: flex;
		align-items: center;
		gap: 5px;
		width: 100%;
	}
	.pedal_select_row .pedal_knob_label {
		flex: 0 0 auto;
		opacity: .75;
	}
	/* the same small dropdown the shelf's reverb carries, in the pedal's row */
	.pedal_select,
	.pedal_model {
		box-sizing: border-box;
		height: 18px;
		min-height: 18px;
		padding: 0 4px;
		font-size: 10px;
		line-height: 16px;
		border-width: 1px;
		border-radius: 4px;
	}
	.pedal_select {
		flex: 1 1 auto;
		min-width: 0;
		width: auto;
	}
	/* A tempo-sync field is a free-text entry with a datalist of the common
	   divisions, not a closed dropdown: the person can type any n/d value. */
	.pedal_text {
		box-sizing: border-box;
		flex: 1 1 auto;
		min-width: 0;
		width: auto;
		height: 18px;
		min-height: 18px;
		padding: 0 4px;
		font-size: 10px;
		line-height: 16px;
		border-width: 1px;
		border-radius: 4px;
	}
	/* The Delay shelf tile has no .pedal_controls column, so its sync row
	   sits directly above the footswitch like the reverb's model select. */
	.pedal .pedal_sync_row {
		position: absolute;
		left: 7%;
		right: 7%;
		bottom: 30px;
		width: auto;
		z-index: 6;
	}
	/* The shelf's reverb model sits in its own row above the footswitch, clear
	   of the knobs; the old top-percentage position left it over Mix. */
	.pedal .pedal_model {
		position: absolute;
		left: 7%;
		right: 7%;
		bottom: 30px;
		width: auto;
		z-index: 6;
	}
	/* The footswitch is the pedal's own stomp switch: a domed treadle in the
	   case, and the lamp beside it reads the same state. Press it, or the lamp,
	   and the pedal switches where it stands. */
	.studio_pedal_foot {
		position: absolute;
		left: 50%;
		bottom: 4px;
		width: 74px;
		height: 22px;
		min-width: 0;
		min-height: 22px;
		max-height: 22px;
		padding: 0;
		line-height: 18px;
		font-size: 10px;
		letter-spacing: .06em;
		text-transform: uppercase;
		box-sizing: border-box;
		transform: translateX(-50%);
		border: 2px solid color-mix(in srgb, var(--panel-2) 25%, #000);
		border-radius: 11px;
		background:
			radial-gradient(120% 160% at 50% -20%, rgba(255, 255, 255, .5), transparent 55%),
			linear-gradient(180deg, color-mix(in srgb, var(--ink) 22%, var(--panel)) 0%, color-mix(in srgb, var(--ink) 38%, var(--panel)) 55%, color-mix(in srgb, var(--ink) 52%, var(--panel)) 100%);
		color: var(--ink);
		text-shadow: 0 1px 0 rgba(255, 255, 255, .28), 0 -1px 0 rgba(0, 0, 0, .4);
		box-shadow: 0 3px 0 color-mix(in srgb, var(--panel-2) 25%, #000), inset 0 1px 0 rgba(255, 255, 255, .55), inset 0 -4px 8px rgba(0, 0, 0, .3);
		cursor: var(--jawnos-cursor-pointer, pointer);
		z-index: 7;
	}
	.studio_pedal_foot[aria-pressed="true"] {
		background:
			radial-gradient(120% 160% at 50% -20%, rgba(255, 255, 255, .5), transparent 55%),
			linear-gradient(180deg, color-mix(in srgb, var(--accent) 62%, var(--panel)) 0%, color-mix(in srgb, var(--accent) 44%, var(--panel)) 60%, color-mix(in srgb, var(--accent) 32%, var(--panel)) 100%);
		color: var(--accent-ink, #fff);
		text-shadow: 0 -1px 0 rgba(0, 0, 0, .35);
		box-shadow: 0 3px 0 color-mix(in srgb, var(--panel-2) 25%, #000), 0 0 10px color-mix(in srgb, var(--accent) 55%, transparent), inset 0 1px 0 rgba(255, 255, 255, .45);
	}
	.studio_pedal_foot:active {
		bottom: 3px;
		box-shadow: 0 2px 0 color-mix(in srgb, var(--panel-2) 25%, #000), inset 0 2px 5px rgba(0, 0, 0, .45);
	}
	/* The lamp: a 14px roundel. The unlit state is a dark red disc with a pale
	   ring (never invisible); on it is a bright green with a soft glow. Every
	   tile and rack row carries one. */
	.studio_pedal_led {
		position: absolute;
		right: 6px;
		top: 6px;
		width: 14px;
		height: 14px;
		box-sizing: border-box;
		border: 2px solid #1b1414;
		border-radius: 50%;
		background: #5a1010;
		box-shadow: inset 0 1px 2px #000, 0 0 0 1px rgba(255, 255, 255, .3);
		cursor: var(--jawnos-cursor-pointer, pointer);
		z-index: 5;
	}
	.studio_pedal_led[aria-pressed="true"] {
		background: #35e05a;
		border-color: #0b4a1a;
		box-shadow: 0 0 10px #35e05a, 0 0 3px #fff, inset 0 1px 2px #0b4a1a;
	}
	/* Jtune's lamp is not an effect's lamp: it is the tuner's state light - grey
	   when it is off, amber while it listens, green in tune. */
	.pedal[data-tuner="yes"] .studio_pedal_led {
		background: #6b7280;
		border-color: #2b3138;
		box-shadow: inset 0 1px 2px #000, 0 0 0 1px rgba(255, 255, 255, .3);
	}
	.pedal[data-tuner="yes"] .studio_pedal_led.studio_tuner_listening {
		background: #f0b429;
		border-color: #6b4a05;
		box-shadow: 0 0 8px #f0b429, inset 0 1px 2px #6b4a05;
	}
	.pedal[data-tuner="yes"] .studio_pedal_led.studio_tuner_tuned {
		background: #35e05a;
		border-color: #0b4a1a;
		box-shadow: 0 0 10px #35e05a, 0 0 3px #fff, inset 0 1px 2px #0b4a1a;
	}
	/* The tuner's screen sits on Jtune's drawn yellow panel: the note between the
	   two arrows, and the cents (or the "press to tune" line) under it. The
	   colours are the screen's own ink, like the LEDs are lamps. */
	.studio_tuner {
		position: absolute;
		left: 13%;
		right: 13%;
		top: 30%;
		height: 29%;
		z-index: 3;
		display: grid;
		grid-template-columns: 18px minmax(0, 1fr) 18px;
		grid-template-rows: 1fr auto;
		align-items: center;
		justify-items: center;
		box-sizing: border-box;
		padding: 2px 4px;
		border-radius: 4px;
		background: color-mix(in srgb, #000 10%, transparent);
		color: #3a2f05;
		text-shadow: 0 1px 0 rgba(255, 255, 255, .45);
		font-family: monospace;
		pointer-events: none;
	}
	.studio_tuner_up { grid-area: 1 / 1; }
	.studio_tuner_note { grid-area: 1 / 2; display: inline-flex; align-items: baseline; gap: 2px; }
	.studio_tuner_down { grid-area: 1 / 3; }
	.studio_tuner_cents { grid-area: 2 / 1 / 2 / 4; font-size: 10px; line-height: 11px; font-weight: bold; white-space: nowrap; }
	.studio_tuner_letter { font-size: 24px; line-height: 24px; font-weight: bold; letter-spacing: .02em; }
	.studio_tuner_octave { font-size: 11px; }
	.studio_tuner_arrow { font-size: 14px; line-height: 14px; color: rgba(58, 47, 5, .4); }
	.studio_tuner_arrow_on { color: #b45309; text-shadow: 0 0 6px rgba(180, 83, 9, .65); }
	.studio_tuner_tuned .studio_tuner_letter,
	.studio_tuner_tuned .studio_tuner_cents { color: #1f7a3a; }
	.studio_tuner_off .studio_tuner_letter { font-size: 13px; letter-spacing: .08em; }
	/* The insertion marker the board sortable shows while a pedal is dragged. */
	.studio_rack_placeholder {
		display: inline-block;
		width: 170px;
		height: 190px;
		margin: 0;
		border: 1px dashed var(--accent);
		border-radius: 4px;
		background: var(--accent-soft, var(--panel-2));
	}
	/* a tile dims when bypassed, but its lamp must stay readable */
	.studio_rack_tile.studio_rack_off .studio_pedal_led {
		opacity: 1;
	}
	#studio_pedalboard_toggle {
		right: 0px;
		bottom:60px;
		position:fixed;
	}
	/* the four docked panels and the docked pedalboard share the window's height */
	#studio_layout_bar { order: 1; }
	#studio_grid { order: 2; }
	#studio_controls {
		position: static;
		display: block;
		padding: 0;
		width: 100%;
	}
	/* One row: the buttons, the jog wheel, tempo, signature, position and the
	   metronome. It wraps only when the panel is genuinely too narrow. */
	.studio_transport_row {
		display: flex;
		align-items: center;
		gap: 4px;
		flex-wrap: wrap;
		padding: 2px 4px;
		box-sizing: border-box;
		width: 100%;
	}
	.studio_transport_row .little_thumb {
		width: 24px;
		height: 24px;
		flex: 0 0 24px;
	}
	.studio_transport_row .jog_wheel_frame {
		flex: 0 0 28px;
		width: 28px;
		height: 28px;
	}
	.studio_transport_row #studio_jog_wheel {
		width: 28px;
		height: 28px;
		left: 0;
		top: 0;
		position: static;
	}
	.studio_transport_field {
		width: 44px;
		height: 24px;
		font-size: 12px;
		vertical-align: middle;
	}
	.studio_transport_knob {
		position: static;
		width: 24px;
		height: 24px;
	}
	/* The clock is the transport's biggest read: minutes and seconds with
	   ten-thousandths on top, and the bar and beat, to a hundredth of a beat,
	   underneath it in a smaller line. */
	.studio_transport_time {
		display: inline-flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0;
		margin-left: auto;
		line-height: 1.05;
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
	}
	.studio_transport_clock {
		display: inline-flex;
		align-items: baseline;
		gap: 3px;
	}
	.studio_transport_sep {
		opacity: .5;
		font-size: 14px;
	}
	#studio_time_display {
		font-size: 30px;
	}
	#studio_time_duration {
		font-size: 14px;
		opacity: .65;
	}
	#studio_time_beats {
		font-size: 12px;
		opacity: .8;
	}
	#studio_track_container {
		/* the hidden media elements live inside the track area, a clipped 1px box:
		   they must never paint on the window (or the desk) beside it */
		position: absolute;
		left: 0;
		top: 0;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}
	.track {
		width: 100%;
		height: 100%;
		cursor: var(--jawnos-cursor-grab, grab);
	}
	.channel_fx {
		display: block;
		font-size: 10px;
		line-height: 1.15;
		word-break: break-word;
		max-height: 42px;
		overflow: hidden;
		color: var(--ink-muted, var(--ink));
	}
	.knob {
		width: 30px;
		aspect-ratio: 1 / 1;
		box-sizing: border-box;
		object-fit: contain;
		transform: rotate(180deg);
		border-radius: 50%;
	}
	.channel_fx_pedal {
		display: block;
		width: 100%;
		margin-bottom: 2px;
		border-radius: 3px;
	}
	.channel.selected_channel {
		box-shadow: inset 0 0 0 3px var(--accent);
	}
	.pedal_background {
		cursor: var(--jawnos-cursor-grab, grab);
	}
	.knob {
		cursor: var(--jawnos-cursor-ns-resize, ns-resize);
		touch-action: none;
	}
	.knob.knob_active {
		filter: brightness(1.3);
	}
	/* the value bubble a knob shows while it is dragged or rolled */
	#studio_knob_readout {
		position: absolute;
		display: none;
		z-index: 70000;
		padding: 1px 6px;
		background: var(--accent);
		color: var(--accent-ink, #fff);
		border-radius: 4px;
		font-size: 12px;
		pointer-events: none;
	}
	/* A pedal's knob is a picture of a rotation, so it prints its value above
	   itself: a chain reloaded from the song shows where every control was left.
	   The artwork tiles place theirs in percents of the pedal, the drawn ones in
	   the knob's own column. */
	.knob_value {
		position: absolute;
		text-align: center;
		font-size: 9px;
		line-height: 12px;
		font-weight: 600;
		color: var(--ink);
		text-shadow: 0 1px 1px rgba(0, 0, 0, .55);
		pointer-events: none;
		z-index: 5;
	}
	.pedal_knob .knob_value {
		position: static;
		width: 100%;
	}
	/* a channel's inserted-pedal badge jumps the pedalboard to that pedal */
	.channel_fx_pedal {
		cursor: var(--jawnos-cursor-pointer, pointer);
	}
	.pedal.pedal_revealed {
		box-shadow: 0 0 0 4px var(--accent);
	}
	.knob_control {
		appearance:none;
		width: 30px;
		height: 100px;

		writing-mode: vertical-lr;
	  direction: rtl;
	  vertical-align: middle;
	}
	.armed {
		height: 30px;
		width: 20px;
		/* the button never gives way to a fader drawn over the strip */
		position: relative;
		z-index: 1;
	}
	.armed[state=off] {
		background: var(--panel-2);
		color: var(--ink);
	}
	.armed[state=rec] {
		background: var(--runway-bad, #b3453f);
		color: #fff;
	}
	.armed[state=play] {
		background: var(--runway-good, #2f7d4f);
		color: #fff;
	}
	.armed[state=loop] {
		background: var(--accent);
		color: var(--accent-ink, #fff);
	}
	.cord {
		width:40px;
	}
	.jack {
		width:40px;
	}
	/* Input and output share the head of the strip, so both are in reach and the
	   foot of the fader is free. Two 40px icons do not fit a 76px strip. */
	.channel_jacks {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		width: 100%;
		flex: 0 0 auto;
	}
	.channel_jacks .jack {
		width: 32px;
		height: 24px;
		object-fit: contain;
	}

	/* the fader and its metre live inside the strip, below the arm button, so
	   they can never sit on top of the record/play/loop toggle */
	/* the knobs and the volume fader sit side by side in the strip */
	.studio_strip_body {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		justify-content: center;
		gap: 2px;
		width: 100%;
		min-width: 0;
	}
	.studio_strip_knobs {
		display: flex;
		flex-direction: column;
		align-items: center;
		min-width: 0;
	}
	.channel_fader {
		position: relative;
		display: block;
		width: 34px;
		height: 120px;
		margin: 2px 0 4px 0;
		/* dropped to the foot of the strip when there is room for it, but it
		   stays below the arm button when the strip is short */
		margin-top: auto;
	}
	.channel_volume {
		position:absolute;
		appearance: none;
		height: 118px;
		width: 34px;
		left: 0;
		top: 0;
		border: solid;
		border-radius: 5px;
		border-width: .1px;
		background-color:transparent;
		color: var(--ink);
		outline: none;
	  writing-mode: vertical-lr;
	  direction: rtl;
	  vertical-align: middle;
		background-image: url('<%= &subs::icon_for('/images/studio/slider2.png') %>');
	}
	.channel_volume_metre {
		position:absolute;
		height: 118px;
		width: 30px;
		left: 2px;
		top: 1px;
		color: var(--ink);
		outline: none;
	  vertical-align: middle;

	}
	.channel {
		border: 2px solid var(--line);
		border-radius: 5px;
		background: var(--panel);
		width: 40px;
		height: auto;
		min-height: 0;
		display: inline-flex;
		flex-direction: column;
		align-items: center;
		padding-top:10px;
		position: relative;

	}
	/* controls keep their size whether or not the strip is tall enough */
	.channel > * {
		flex: none;
	}
	<%# The channel controls are per track now, so no per-channel rule is needed. %>
	#studio {
		height:100%;
		width:100%;
		border: 10px solid var(--line);
		border-radius: 10px;
		background: var(--panel);
		position: relative;
		box-sizing: border-box;
		min-width: 380px;
		/* the grid owns the height; the window never grows to fit a panel */
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}
	#studio_viewer {
		flex: 1 1 auto;
		min-height: 0;
		width: 100%;
		overflow-x: hidden;
		overflow-y: auto;
		background-color: var(--panel-2);
	}
	/* Configure is a full-window sheet. It takes the height the grid leaves,
	   and its own settings table plus the engine panel scroll inside it, so
	   nothing is clipped in a short window. The window's width and colour come
	   from here, not from inline style on the element. */
	#studio_config {
		flex: 1 1 auto;
		min-height: 0;
		width: 100%;
		box-sizing: border-box;
		overflow-y: auto;
		overflow-x: hidden;
		padding: 4px 10px;
		background-color: var(--panel);
	}
	/* The class stands the desk down while Configure is open: the viewer and the
	   interior panel windows are out of the way. */
	#studio.studio_config_open #studio_viewer { display: none; }
	#studio.studio_config_open #studio_grid {
		display: none;
	}
	/* The desk is the panels' screen: every panel is an interior window,
	   positioned and stacked inside this box. It never scrolls; a panel's own
	   content does. */
	.studio_grid {
		position: relative;
		flex: 1 1 auto;
		min-height: 0;
		padding: 0;
		box-sizing: border-box;
		overflow: hidden;
		background-color: var(--panel-2);
	}
	/* An interior panel window: a title bar, its content and a corner grip. The
	   title bar stays put; each panel's own content is the scroll box. */
	.studio_panel {
		position: absolute;
		box-sizing: border-box;
		min-width: 180px;
		min-height: 80px;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		/* the bottom grip owns this strip, so a track's own bottom edge stays
		   reachable just above it */
		padding-bottom: 6px;
		background: var(--panel, #eee);
		border: 2px solid var(--line, #333);
		border-radius: 8px;
		box-shadow: var(--shadow-2);
	}
	.studio_panel.studio_panel_minimized { display: none !important; }
	.studio_panel.studio_panel_raised { box-shadow: var(--shadow-2), 0 0 0 1px var(--accent); }
	.studio_panel.studio_panel_maximized { border-radius: 0; }
	.studio_panel_dragging { opacity: .92; }
	#studio_mixer {
		min-width: 0;
		min-height: 0;
		background-color: var(--panel-2);
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}
	#studio_mixer_strips {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		gap: 4px;
		padding: 4px;
		box-sizing: border-box;
		/* strips scroll both ways: their faders are reachable even when the
		   panel is short, and many strips still scroll sideways */
		overflow-x: auto;
		overflow-y: auto;
		flex: 1 1 auto;
		min-height: 0;
	}
	/* The strips fill the console: they grow into the room the master leaves,
	   and only scroll once 76px each is no longer available. */
	#studio_mixer_strips .channel {
		flex: 1 1 88px;
		min-width: 76px;
		height: auto;
		min-height: 0;
	}
	#studio_transport_panel {
		min-width: 0;
		min-height: 0;
		/* the title bar stays put; the control row scrolls inside */
		overflow: hidden;
	}
	#studio_controls {
		flex: 1 1 auto;
		min-height: 0;
		overflow: auto;
	}
	#studio_jog_wheel {
		border-radius: 50%;
	}
	.jog_wheel_frame {
		position: relative;
		display: inline-block;
		flex: 0 0 44px;
		width: 44px;
		height: 44px;
		vertical-align: middle;
	}
	.jog_wheel_frame .jog_wheel_centre {
		position: absolute;
		left: 50%;
		top: 50%;
		margin-left: -2px;
		margin-top: -2px;
	}
	/* Studio follows the shared window stack. Its old z-index pin
	   (`39999 !important`) kept it above the dock and taskbar, but it also
	   stopped the window manager from ever raising it above another window. */
	/* ---- layout bar, interior panel windows and the track list -------------- */
	.studio_layout_bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 4px;
		padding: 3px 4px;
		flex: 0 0 auto;
	}
	.studio_layout_bar button {
		font-size: 12px;
	}
	/* New, Open, Save and Configure sit together at the left edge. */
	.studio_file_buttons {
		display: inline-flex;
		align-items: center;
		gap: 2px;
		padding-right: 4px;
		border-right: 1px solid var(--line);
	}
	.studio_file_buttons button {
		font-size: 12px;
		padding: 2px 8px;
	}
	/* the app-bar grip moves the whole window, so the title bar is never the
	   only place a crowded top edge leaves to grab */
	.studio_window_grip {
		cursor: var(--jawnos-cursor-grab, grab);
		touch-action: none;
		user-select: none;
		padding: 0 4px;
		font-size: 14px;
		line-height: 1;
		opacity: .65;
	}
	.studio_window_grip:hover { opacity: 1; }
	/* the effect palette: add any contract effect to the selected track */
	.studio_effect_palette {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		margin-left: 6px;
	}
	.studio_effect_palette select {
		font-size: 12px;
		max-width: 150px;
	}
	.studio_palette_label,
	.studio_palette_channel {
		font-size: 12px;
		opacity: .7;
	}
	.studio_rack_template {
		display: none;
	}
	.studio_track_count {
		font-size: 12px;
		opacity: .7;
		padding: 0 4px;
	}
	/* A controller's machine picker lives in the top bar; the badge names the
	   table whose Studio this window is driving. */
	.studio_remote_picker {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-size: 12px;
	}
	.studio_remote_label {
		opacity: .7;
	}
	.studio_remote_machine {
		font-size: 12px;
		max-width: 160px;
	}
	/* The controlled machine's own output picker. It is absent until a peer is
	   chosen, so the bar reads as this machine's when it drives itself. */
	.studio_remote_monitor_picker {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-size: 12px;
	}
	.studio_remote_monitor_picker[hidden] {
		display: none;
	}
	.studio_remote_monitor {
		font-size: 12px;
		max-width: 160px;
	}
	/* The stream row is a different kind of monitor: its italic label sets it
	   apart from the target's physical outputs below it. */
	.studio_remote_monitor_stream {
		font-style: italic;
	}
	/* The stream's own line: hidden until the target answers, so an empty bar
	   stays empty; the poll leaves an unchanged line untouched. */
	.studio_remote_monitor_status {
		display: none;
		font-size: 12px;
		padding: 1px 6px;
		border-radius: 4px;
		white-space: nowrap;
	}
	.studio_remote_monitor_status.on,
	.studio_remote_monitor_status.stopped,
	.studio_remote_monitor_status.pending,
	.studio_remote_monitor_status.error {
		display: inline-block;
	}
	.studio_remote_monitor_status.on {
		background: var(--accent-soft, var(--accent));
		color: var(--panel);
	}
	.studio_remote_monitor_status.stopped,
	.studio_remote_monitor_status.pending {
		opacity: .7;
	}
	.studio_remote_monitor_status.error {
		color: var(--danger, #c53030);
	}
	.studio_remote_status {
		display: none;
		font-size: 12px;
		padding: 1px 6px;
		border-radius: 4px;
		background: var(--accent-soft, var(--accent));
		color: var(--panel);
		white-space: nowrap;
	}
	.studio_remote_status.on {
		display: inline-block;
	}
	#studio.studio_remote_controller .studio_layout_bar {
		box-shadow: inset 0 -2px 0 var(--accent);
	}
	/* The target's clips and playhead are painted here. The overlay is a mirror:
	   it sits over the lanes, takes no pointer, and is blank outside controller
	   mode, so the local timeline is never drawn into. */
	.studio_remote_overlay {
		position: absolute;
		left: 0;
		top: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		z-index: 3;
		display: none;
	}
	#studio.studio_remote_controller .studio_remote_overlay {
		display: block;
	}
	#studio_tracks_panel {
		display: flex;
		flex-direction: column;
		min-width: 0;
		min-height: 0;
		/* the title bar stays put; the ruler and timeline scroll below it */
		overflow: hidden;
	}
	.studio_panel_bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		padding: 2px 4px;
		flex: 0 0 auto;
		background: color-mix(in srgb, var(--ink) 8%, transparent);
		position: relative;
		z-index: 2;
		touch-action: none;
		user-select: none;
	}
	.studio_panel_buttons {
		display: inline-flex;
		align-items: center;
		gap: 2px;
		margin-left: auto;
	}
	/* A pinned panel stays above the others however the stack is raised. */
	.studio_panel_pin[aria-pressed="true"] {
		/* A pinned panel reads as a pressed, lit control, not a faint tint. */
		background: var(--accent);
		color: var(--panel);
		border-radius: 4px;
		box-shadow: 0 0 0 2px var(--accent), 0 0 7px color-mix(in srgb, var(--accent) 70%, transparent);
		filter: none;
	}
	.studio_panel_pin {
		font-size: 11px;
		line-height: 1;
		padding: 1px 4px;
	}
	/* The timeline tools live on the Tracks title bar, above the ruler. */
	.studio_tools {
		display: inline-flex;
		align-items: center;
		gap: 2px;
	}
	.studio_tools .studio_tool {
		font-size: 11px;
		line-height: 1;
		padding: 2px 7px;
		border-radius: 4px;
	}
	.studio_tools .studio_tool[aria-pressed="true"] {
		background: var(--accent);
		color: var(--panel);
	}
	/* The padlock locks the view to the playhead; lit means following. */
	.studio_tools .studio_follow {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		margin-left: 4px;
		font-size: 11px;
		line-height: 1;
		padding: 2px 7px;
		border-radius: 4px;
	}
	.studio_tools .studio_follow_icon {
		width: 13px;
		height: 13px;
		display: block;
	}
	.studio_tools .studio_follow[aria-pressed="true"] {
		background: var(--accent);
		color: var(--panel);
		box-shadow: 0 0 0 1px var(--accent), 0 0 6px color-mix(in srgb, var(--accent) 55%, transparent);
	}
	/* Select and Cut change the pointer over the lanes and the ruler. */
	#studio_viewer.studio_tool_select canvas.track,
	#studio_ruler.studio_tool_select .studio_ruler_canvas {
		cursor: var(--jawnos-cursor-crosshair, crosshair);
	}
	#studio_viewer.studio_tool_cut canvas.track {
		cursor: var(--jawnos-cursor-cell, cell);
	}
	/* The selection bar names the chosen span and offers its three actions. */
	.studio_selection_bar {
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 2px 4px;
		flex: 0 0 auto;
		background: color-mix(in srgb, var(--accent) 12%, transparent);
		border-bottom: 1px solid var(--line);
	}
	.studio_selection_label {
		font-size: 11px;
		opacity: .8;
		white-space: nowrap;
	}
	.studio_selection_bar button {
		font-size: 11px;
		line-height: 1;
		padding: 2px 7px;
	}
	/* A translucent block over each selected lane, and over the ruler span. */
	#studio_viewer {
		position: relative;
	}
	.studio_selection_overlay {
		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: 2;
	}
	.studio_selection_lane {
		position: absolute;
		background: color-mix(in srgb, var(--accent) 24%, transparent);
		border-left: 1px solid var(--accent);
		border-right: 1px solid var(--accent);
		box-sizing: border-box;
	}
	.studio_ruler_selection {
		position: absolute;
		top: 0;
		height: 100%;
		pointer-events: none;
		background: color-mix(in srgb, var(--accent) 34%, transparent);
		border-left: 1px solid var(--accent);
		border-right: 1px solid var(--accent);
		box-sizing: border-box;
		z-index: 2;
	}
	/* The Open sheet: a list of every saved studio song, over the window. */
	.studio_dialog {
		position: absolute;
		left: 50%;
		top: 12%;
		transform: translateX(-50%);
		width: min(520px, 88vw);
		max-height: 70%;
		display: flex;
		flex-direction: column;
		z-index: 9000;
		border: 1px solid var(--line);
		border-radius: calc(var(--jawnos-corner, 12px) * .8);
		background: var(--panel);
		color: var(--ink);
		box-shadow: var(--shadow-2, 0 8px 24px rgba(0, 0, 0, .28));
	}
	.studio_dialog_bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		padding: 6px 8px;
		border-bottom: 1px solid var(--line);
	}
	.studio_dialog_list {
		overflow-y: auto;
		min-height: 0;
		padding: 4px;
	}
	.studio_open_row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 12px;
		width: 100%;
		box-sizing: border-box;
		text-align: left;
		padding: 6px 8px;
		border: 0;
		border-radius: 6px;
		background: transparent;
		color: inherit;
		font-size: 13px;
	}
	.studio_open_row:hover {
		background: var(--accent-soft, var(--panel-2));
	}
	.studio_open_time {
		font-size: 11px;
		opacity: .6;
		white-space: nowrap;
	}
	.studio_dialog_empty {
		padding: 10px;
		opacity: .7;
	}
	.studio_panel_bar button {
		font-size: 12px;
		line-height: 1;
		padding: 2px 6px;
	}
	.studio_panel_bar button,
	.studio_panel_bar select,
	.studio_panel_bar input,
	.studio_panel_bar label {
		cursor: var(--jawnos-cursor-default, default);
	}
	.studio_drag_handle {
		cursor: var(--jawnos-cursor-grab, grab);
		touch-action: none;
		user-select: none;
		font-weight: bold;
	}
	/* the title spans the bar's empty room, so the whole title area drags */
	.studio_panel_bar .studio_drag_handle {
		font-size: 12px;
		flex: 1 1 auto;
		min-width: 40px;
	}
	/* The top bar is the panels' taskbar: a small button per interior window. */
	.studio_panel_taskbar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 3px;
		flex: 1 1 auto;
		min-width: 0;
		overflow-x: auto;
		padding: 2px;
		border: 1px solid var(--line);
		border-radius: 6px;
		background: color-mix(in srgb, var(--ink) 8%, transparent);
	}
	.studio_panel_taskbar button {
		flex: 0 0 auto;
		font-size: 12px;
		padding: 2px 10px;
		border-radius: 4px;
	}
	.studio_panel_taskbar button.studio_task_active {
		background: var(--accent);
		color: var(--panel);
	}
	.studio_panel_taskbar button.studio_task_minimized {
		opacity: .55;
	}
	/* the resize grip rides every interior window's bottom-right corner */
	.studio_resize_handle {
		display: block;
		position: absolute;
		right: 0;
		bottom: 0;
		width: 18px;
		height: 18px;
		/* above a track's own bottom grip, which it overlaps at the corner */
		z-index: 31;
		cursor: var(--jawnos-cursor-nwse-resize, nwse-resize);
		touch-action: none;
		background: linear-gradient(135deg, transparent 0 42%, var(--line, #333) 43% 50%, transparent 51% 62%, var(--line, #333) 63% 70%, transparent 71%);
	}
	/* The bottom edge resizes the height. It sits above the content so a track's
	   own edge cannot swallow the press at the foot of the window. */
	.studio_panel_bottom {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 6px;
		z-index: 30;
		touch-action: none;
		cursor: var(--jawnos-cursor-ns-resize, ns-resize);
	}
	.studio_panel_bottom:hover {
		background: var(--accent);
		opacity: .28;
	}
	.studio_panel_resizing { cursor: var(--jawnos-cursor-nwse-resize, nwse-resize); }
	/* A track has its own row height (90px by default); its bottom edge is the
	   grip. The timeline scrolls; it never stretches one track to fill the panel. */
	.studio_track {
		display: flex;
		align-items: stretch;
		gap: 4px;
		position: relative;
		height: var(--studio_track_height, 90px);
		min-height: 64px;
		flex: 0 0 auto;
		border-bottom: 1px solid var(--line);
	}
	.studio_track_panel {
		flex: 0 0 150px;
		width: 150px;
		height: 100%;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding: 2px 4px;
		background: var(--panel);
		border-right: 1px solid var(--line);
		min-width: 0;
		overflow: hidden;
		cursor: var(--jawnos-cursor-pointer, pointer);
	}
	.studio_track_panel.selected_channel {
		box-shadow: inset 0 0 0 3px var(--accent);
	}
	.studio_track_line {
		display: flex;
		align-items: center;
		gap: 3px;
		min-width: 0;
	}
	.studio_track_line > * {
		flex: none;
	}
	.studio_track_arm {
		min-width: 22px;
	}
	.studio_track_name {
		flex: 1 1 auto !important;
		min-width: 0;
		width: 100%;
		font-size: 12px;
		border: solid 1px var(--line, #999);
		border-radius: 3px;
		background: var(--panel);
		color: var(--ink);
	}
	.studio_track_actions {
		display: flex;
		gap: 2px;
		min-width: 0;
		overflow: hidden;
	}
	.studio_track_fx,
	.studio_track_automation,
	.studio_track_monitor,
	.studio_track_delete {
		font-size: 10px;
		padding: 0 3px;
		flex: 0 0 auto;
	}
	.studio_track_automation[aria-pressed="true"],
	.studio_track_monitor[aria-pressed="true"] {
		background: var(--accent-soft, var(--accent));
		color: var(--ink);
	}
	.studio_track_resize {
		position: absolute;
		left: 0;
		right: 0;
		bottom: -3px;
		height: 7px;
		z-index: 4;
		cursor: var(--jawnos-cursor-ns-resize, ns-resize);
		touch-action: none;
	}
	.studio_track_resize:hover {
		background: var(--accent);
		opacity: .35;
	}
	.studio_track_resizing {
		cursor: var(--jawnos-cursor-ns-resize, ns-resize);
	}
	/* while the edge is dragged the canvas must not swallow the pointer */
	.studio_track_resizing .track {
		pointer-events: none;
	}
	.studio_track_panel .channel_volume {
		position: relative;
		width: 100%;
		height: 18px;
		writing-mode: horizontal-tb;
		direction: ltr;
		background-image: none;
		border-radius: 9px;
		flex: 1 1 auto !important;
	}
	.studio_monitor_note {
		font-size: 11px;
		color: var(--danger, #c53030);
		max-width: 220px;
		line-height: 1.2;
	}
	/* The transport's Engine/Browser badge: the path a take is actually on, not
	   a setting. Engine gets the accent, a live recording the alarm colour. */
	.studio_audio_path {
		font-size: 11px;
		padding: 2px 6px;
		border-radius: 4px;
		background: var(--panel-2);
		border: 1px solid var(--accent-line, var(--accent));
		white-space: nowrap;
	}
	.studio_audio_path.engine { color: var(--accent); }
	.studio_audio_path.recording { color: var(--danger, #c53030); font-weight: 600; }
	.studio_monitor_toggle[aria-pressed="true"] {
		background: var(--accent-soft, var(--accent));
		border-color: var(--accent-line, var(--accent));
		color: var(--accent-ink, inherit);
	}
	.studio_track_panel .channel_volume_metre {
		position: relative;
		left: 0;
		top: 0;
		width: 80px;
		height: 6px;
	}
	/* A track's rack is the ordered chain itself, drawn in the pedalboard above
	   the shelf: the panel never carries a list of effects. */
	.studio_channel_rack {
		margin-top: 2px;
		font-size: 11px;
	}
	.studio_rack_tile.studio_rack_off {
		opacity: .45;
	}
	.studio_rack_tile button {
		font-size: 10px;
		padding: 0 3px;
	}
	.channel_fx_pedal.studio_fx_bypassed,
	.channel_fx_text.studio_fx_bypassed {
		opacity: .45;
		text-decoration: line-through;
	}
	/* The mastering chain: a rack on the mixer's own bus, and the strips' last
	   child so it sits at their far right. A dark chassis with a grip rail down
	   each side, a meter plate on top and one numbered rack unit per effect; it
	   scrolls inside its own box instead of spilling over the strips. */
	.studio_master_rack {
		--rack-face: #1d1f23;
		--rack-face-top: #26282d;
		--rack-unit: #1b1c1f;
		--rack-edge: #34363c;
		--rack-screw: #8d9096;
		--rack-ink: #d3d6dc;
		--rack-ink-dim: #9a9da4;
		position: relative;
		flex: 0 0 244px;
		width: 244px;
		align-self: stretch;
		max-height: 100%;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding: 8px 14px 8px 14px;
		background: linear-gradient(180deg, var(--rack-face-top), var(--rack-face) 30%, #131417);
		border: 1px solid #0e0f11;
		border-left: 2px solid #3c3e44;
		border-radius: 6px;
		box-shadow: inset 0 0 24px rgba(0, 0, 0, .7), inset 0 1px 0 rgba(255, 255, 255, .05), 0 2px 8px rgba(0, 0, 0, .45);
		color: var(--rack-ink);
		overflow: auto;
	}
	/* The grip rails: a repeated tread on each side, the way a rack's handles
	   run the height of the chassis. They are inside the box so the scrollbar
	   and the rounded corners do not clip them. */
	.studio_master_rack::before,
	.studio_master_rack::after {
		content: "";
		position: absolute;
		top: 4px;
		bottom: 4px;
		width: 7px;
		border-radius: 3px;
		background: repeating-linear-gradient(180deg, #3b3d43 0 5px, #202126 5px 10px);
		box-shadow: inset 0 0 3px rgba(0, 0, 0, .8), 0 0 2px rgba(255, 255, 255, .06);
		pointer-events: none;
	}
	.studio_master_rack::before { left: 2px; }
	.studio_master_rack::after { right: 2px; }
	.studio_master_title {
		flex: 0 0 auto;
		text-align: center;
		font-size: 10px;
		letter-spacing: .18em;
		text-transform: uppercase;
		color: var(--rack-ink-dim);
		text-shadow: 0 1px 0 #000;
	}
	/* The rack's output meter: one segment per LED, lit by 10_master.js from the
	   destination analyser the mixer already feeds. */
	.studio_master_meter {
		flex: 0 0 auto;
		display: flex;
		gap: 1px;
		height: 8px;
		padding: 2px;
		box-sizing: border-box;
		background: #090a0b;
		border: 1px solid #0d0e10;
		border-radius: 2px;
		box-shadow: inset 0 1px 3px rgba(0, 0, 0, .9);
	}
	.studio_master_led {
		flex: 1 1 0;
		min-width: 2px;
		border-radius: 1px;
		background: #1a1d1a;
		opacity: .55;
	}
	.studio_master_led.lit { opacity: 1; }
	.studio_master_led.led_green.lit { background: #43a86a; box-shadow: 0 0 4px rgba(67, 168, 106, .8); }
	.studio_master_led.led_yellow.lit { background: #d6b24a; box-shadow: 0 0 4px rgba(214, 178, 74, .8); }
	.studio_master_led.led_red.lit { background: #c1524a; box-shadow: 0 0 5px rgba(193, 82, 74, .85); }
	/* One rack unit: a faceplate between two drilled rails, with a numbered
	   header and the unit's controls below it. */
	.studio_master_effect {
		position: relative;
		border: 1px solid #0d0e10;
		border-radius: 3px;
		padding: 3px 13px 5px 13px;
		background: linear-gradient(180deg, var(--rack-face-top), var(--rack-unit));
		color: var(--rack-ink);
		font-size: 10px;
		box-sizing: border-box;
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, .06), inset 0 -1px 0 rgba(0, 0, 0, .6), 0 1px 2px rgba(0, 0, 0, .5);
	}
	.studio_master_effect::before,
	.studio_master_effect::after {
		content: "";
		position: absolute;
		top: 0;
		bottom: 0;
		width: 9px;
		background-color: #17181b;
		background-image:
			radial-gradient(circle at 50% 4px, var(--rack-screw) 0 1.3px, #060708 1.7px, transparent 2px),
			radial-gradient(circle at 50% calc(100% - 4px), var(--rack-screw) 0 1.3px, #060708 1.7px, transparent 2px);
		background-repeat: no-repeat;
		border-radius: 2px;
		pointer-events: none;
	}
	.studio_master_effect::before { left: 1px; }
	.studio_master_effect::after { right: 1px; }
	.studio_master_effect.studio_master_on {
		background: linear-gradient(180deg, #2e3330, #202521);
		border-color: #4d7a5e;
		box-shadow: inset 0 0 10px rgba(67, 168, 106, .14), 0 1px 2px rgba(0, 0, 0, .5);
	}
	.studio_master_unit_head {
		display: flex;
		align-items: center;
		gap: 5px;
	}
	.studio_master_unit_no {
		flex: 0 0 auto;
		font-size: 8px;
		font-variant-numeric: tabular-nums;
		color: #6f727a;
		text-shadow: 0 1px 0 #000;
	}
	.studio_master_toggle {
		flex: 1 1 auto;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		text-align: left;
		font-size: 10px;
		letter-spacing: .03em;
		color: var(--rack-ink);
		background: linear-gradient(180deg, #3b3d43, #26282c);
		border: 1px solid #101113;
		border-radius: 3px;
		padding: 2px 6px;
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, .14), 0 1px 1px rgba(0, 0, 0, .6);
	}
	/* The footswitch's lamp sits in the button, dark until the unit is on. */
	.studio_master_toggle::before {
		content: "";
		display: inline-block;
		width: 6px;
		height: 6px;
		margin-right: 5px;
		border-radius: 50%;
		vertical-align: middle;
		background: #3a2020;
		box-shadow: inset 0 0 2px #000, 0 0 0 1px #0c0d0e;
	}
	.studio_master_effect.studio_master_on .studio_master_toggle::before {
		background: #5fd389;
		box-shadow: 0 0 6px rgba(95, 211, 137, .9), 0 0 0 1px #0c0d0e;
	}
	.studio_master_controls {
		display: flex;
		flex-wrap: wrap;
		gap: 3px 8px;
		margin-top: 3px;
	}
	.studio_master_label {
		display: flex;
		flex-direction: column;
		font-size: 9px;
		color: var(--rack-ink-dim);
	}
	.studio_master_label input[type=range] {
		width: 56px;
		accent-color: #b9bcc2;
	}
	.studio_master_label select {
		max-width: 108px;
		font-size: 10px;
		color: var(--rack-ink);
		background: #26282c;
		border: 1px solid #101113;
	}
	/* The graphic EQ: ten vertical faders across the unit, each with its band
	   name above and its dB below. The grid keeps the columns even, so the
	   block reads as one wide graphic rather than ten knobs. */
	.studio_master_graphic .studio_master_controls {
		display: grid;
		grid-template-columns: repeat(10, minmax(0, 1fr));
		gap: 0;
		margin-top: 2px;
	}
	.studio_master_band {
		align-items: center;
		gap: 1px;
		font-size: 8px;
		color: var(--rack-ink-dim);
	}
	.studio_master_band_hz,
	.studio_master_band_db {
		font-variant-numeric: tabular-nums;
		line-height: 1.1;
		text-shadow: 0 1px 0 #000;
	}
	.studio_master_band_db {
		color: #7f838b;
		min-height: 9px;
	}
	.studio_master_band input[type=range] {
		-webkit-appearance: slider-vertical;
		writing-mode: vertical-lr;
		direction: rtl;
		width: 18px;
		height: 84px;
		margin: 0;
		padding: 0;
		accent-color: #b9bcc2;
	}
	.studio_master_graphic.studio_master_on .studio_master_band_db {
		color: #7fd39b;
	}
	/* Mastering automation: a measurement mic inside the rack, above the units.
	   The ten columns mirror the graphic EQ's bands; each column shows the
	   measured difference and the applied correction either side of a zero
	   line, with the target as a thin mark. */
	.studio_mastering {
		display: flex;
		flex-direction: column;
		gap: 3px;
		padding: 4px 12px 6px 12px;
		border: 1px solid #0d0e10;
		border-radius: 3px;
		background: linear-gradient(180deg, #24262a, #1a1b1e);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, .05), inset 0 -1px 0 rgba(0, 0, 0, .6);
		font-size: 9px;
		color: var(--rack-ink-dim);
	}
	.studio_mastering_head {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	.studio_mastering_title {
		font-size: 8px;
		font-weight: normal;
		letter-spacing: .12em;
		text-transform: uppercase;
		color: var(--rack-ink-dim);
		text-shadow: 0 1px 0 #000;
	}
	.studio_mastering_mic {
		width: 100%;
		font-size: 10px;
		color: var(--rack-ink);
		background: #26282c;
		border: 1px solid #101113;
		border-radius: 2px;
	}
	.studio_mastering_row {
		display: flex;
		align-items: center;
		gap: 6px;
	}
	.studio_mastering_choice {
		display: flex;
		align-items: center;
		gap: 3px;
		font-size: 9px;
		color: var(--rack-ink-dim);
	}
	.studio_mastering_choice input[type=radio] {
		margin: 0;
		accent-color: #b9bcc2;
	}
	.studio_mastering_learn,
	.studio_mastering_reset {
		flex: 1 1 0;
		font-size: 10px;
		color: var(--rack-ink);
		background: linear-gradient(180deg, #3b3d43, #26282c);
		border: 1px solid #101113;
		border-radius: 3px;
		padding: 2px 6px;
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, .14), 0 1px 1px rgba(0, 0, 0, .6);
	}
	.studio_mastering_learn[aria-pressed=true] {
		background: linear-gradient(180deg, #4b3320, #2c2118);
		border-color: #8a5a2a;
		color: #f0c48a;
	}
	.studio_mastering_status {
		min-height: 22px;
		line-height: 1.2;
		font-size: 9px;
		color: #a7abb2;
	}
	.studio_mastering_bars {
		display: grid;
		grid-template-columns: repeat(10, minmax(0, 1fr));
		gap: 1px;
	}
	.studio_mastering_band {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1px;
		font-size: 7px;
		color: var(--rack-ink-dim);
	}
	.studio_mastering_band_hz {
		font-variant-numeric: tabular-nums;
		line-height: 1.1;
		text-shadow: 0 1px 0 #000;
	}
	.studio_mastering_band_plot {
		position: relative;
		width: 100%;
		height: 34px;
		background: #0a0b0d;
		border: 1px solid #0d0e10;
		border-radius: 2px;
		box-shadow: inset 0 1px 3px rgba(0, 0, 0, .9);
		overflow: hidden;
	}
	.studio_mastering_band_plot::before {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		top: 50%;
		height: 1px;
		background: #2a2d31;
	}
	.studio_mastering_band_before,
	.studio_mastering_band_after {
		position: absolute;
		height: 0;
		border-radius: 1px;
		pointer-events: none;
	}
	.studio_mastering_band_before {
		left: 10%;
		width: 36%;
		background: #5b6068;
	}
	.studio_mastering_band_after {
		left: 54%;
		width: 36%;
		background: #5fd389;
		box-shadow: 0 0 4px rgba(95, 211, 137, .5);
	}
	.studio_mastering_band_target {
		position: absolute;
		left: 0;
		right: 0;
		top: 50%;
		height: 1px;
		background: #d6b24a;
		opacity: .75;
		pointer-events: none;
	}
	.studio_mastering_band_db {
		font-variant-numeric: tabular-nums;
		color: #7f838b;
		min-height: 8px;
	}
	.studio_mastering_band.studio_mastering_gated {
		opacity: .45;
	}
	.studio_track_body {
		position: relative;
		flex: 1 1 auto;
		min-width: 0;
		display: flex;
		flex-direction: column;
	}
	.studio_track_body .track {
		/* the lane below it is a sibling, so the canvas takes what is left
		   rather than 100% of the row */
		flex: 1 1 auto;
		min-height: 0;
		width: 100%;
		height: auto;
		box-sizing: border-box;
	}
	.studio_track_automation_lane {
		display: none;
		flex: 0 0 26px;
		height: 26px;
		padding: 2px 5px;
		font-size: 11px;
		box-sizing: border-box;
		background: color-mix(in srgb, var(--accent) 14%, transparent);
		border-top: 1px dashed var(--accent-line, var(--accent));
		color: var(--ink);
	}
	.studio_track.studio_track_automation_on .studio_track_automation_lane {
		display: block;
	}
	/* ---- timeline ruler ----------------------------------------------------
	   The ruler's first cell is exactly a track's panel column (150px + the
	   row's 4px gap), so a ruler click and the playhead line up over every
	   canvas below it. The canvas repaints itself from studioDrawRuler(). */
	.studio_ruler {
		display: flex;
		align-items: stretch;
		gap: 4px;
		flex: 0 0 auto;
		height: 22px;
		border-bottom: 1px solid var(--line);
		background: var(--panel);
		position: sticky;
		top: 0;
		z-index: 3;
	}
	.studio_ruler_pad {
		flex: 0 0 150px;
		width: 150px;
	}
	.studio_ruler_canvas {
		flex: 1 1 auto;
		min-width: 0;
		width: 100%;
		height: 21px;
		box-sizing: border-box;
		cursor: var(--jawnos-cursor-pointer, pointer);
		touch-action: none;
	}
	/* A track's own colour dresses its panel edge, so a selected row reads at a
	   glance; the canvas paint uses the same value (studioTrackColour). */
	.studio_track_colour {
		flex: 0 0 18px;
		width: 18px;
		min-width: 18px;
		height: 18px;
		padding: 0;
		border: 1px solid var(--line);
		border-radius: 3px;
		background: none;
		cursor: var(--jawnos-cursor-pointer, pointer);
	}
	.studio_track[data-colour] .studio_track_panel {
		border-right-color: var(--studio-track-colour, var(--line));
		border-left: 3px solid var(--studio-track-colour, transparent);
	}
	/* ---- the channel input/output selector ---------------------------------
	   It floats at the pointer, so it must never grow past the window: a table's
	   list of devices, apps and Screen Share is long, and an uncapped box runs
	   off the bottom with its last dropdown unreachable. The 8px margin is the
	   same one channelSelect() clamps left/top to. */
	#studio_plug_select_container {
		position: fixed;
		display: none;
		box-sizing: border-box;
		max-width: min(520px, calc(100vw - 16px));
		max-height: min(60vh, 480px);
		overflow-x: hidden;
		overflow-y: auto;
		z-index: 50009;
		border: solid;
		border-radius: 4px;
		background-color: var(--accent-soft, var(--panel-2));
	}
	/* The chosen plug keeps a stable theme tint and border; the global flashing
	   .active_background is for alarms, not a selection. */
	#studio_plug_select table {
		width: 100%;
		table-layout: fixed;
	}
	#studio_plug_select td {
		overflow-wrap: anywhere;
	}
	#studio_plug_select td:first-child {
		width: 44px;
	}
	#studio_plug_select .studio_plug_selection {
		border: 2px solid transparent;
		border-radius: 6px;
	}
	#studio_plug_select .studio_plug_selection.studio_plug_active {
		background: var(--accent-soft, color-mix(in srgb, var(--accent) 18%, transparent));
		border-color: var(--accent);
		outline: 2px solid var(--accent);
		outline-offset: -2px;
		box-shadow: inset 0 0 0 2px var(--accent);
	}
	#studio_plug_select .studio_plug_note {
		padding: 4px 8px;
		font-size: 12px;
		color: var(--runway-bad, #b3453f);
	}
	/* ---- the House patch in the input picker -------------------------------
	   The plan's other sources (a voice, the deck) cannot own a track take, so
	   their monitor, effects and bus take live under the channel's plug list. */
	#studio_house_patch {
		margin-top: 8px;
		padding: 6px 8px;
		border-top: 1px solid var(--line);
		font-size: 12px;
	}
	#studio_house_patch h3 {
		margin: 0 0 4px;
		font-size: 15px;
	}
	.studio_house_patch_engine,
	.studio_house_patch_note {
		margin: 2px 0;
		font-size: 11px;
		opacity: .7;
	}
	.studio_house_source {
		padding: 5px 0;
		border-top: 1px solid var(--line);
	}
	.studio_house_source_head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 6px;
	}
	.studio_house_source_name {
		font-weight: 600;
	}
	.studio_house_source_kind {
		font-size: 11px;
		opacity: .65;
	}
	.studio_house_source_state {
		margin-left: auto;
		font-size: 11px;
		text-transform: lowercase;
	}
	.studio_house_state_bound { color: var(--accent-strong, var(--accent)); }
	.studio_house_state_silent { color: var(--danger, #c33); }
	.studio_house_state_pending { opacity: .6; }
	.studio_house_monitor,
	.studio_house_mute_label {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		margin-right: 10px;
	}
	.studio_house_monitor_value {
		min-width: 32px;
		font-variant-numeric: tabular-nums;
		font-size: 11px;
		opacity: .75;
	}
	.studio_house_inserts {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 4px;
		margin-top: 4px;
	}
	.studio_house_inserts_head,
	.studio_house_no_inserts,
	.studio_house_no_route {
		font-size: 11px;
		opacity: .65;
	}
	.studio_house_no_route { margin: 2px 0 0; }
	.studio_house_insert {
		display: inline-flex;
		align-items: center;
		gap: 3px;
		padding: 1px 4px;
		border: 1px solid var(--line);
		border-radius: 4px;
	}
	.studio_house_insert_remove {
		padding: 0 3px;
		border: 0;
		background: none;
		cursor: var(--jawnos-cursor-pointer, pointer);
	}
	.studio_house_take {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 5px;
		margin-top: 8px;
		padding-top: 6px;
		border-top: 1px solid var(--line);
	}
	.studio_house_take_head {
		font-weight: 600;
	}
	.studio_house_take_seconds {
		width: 64px;
	}
	.studio_house_take_status {
		flex-basis: 100%;
		font-size: 11px;
		opacity: .75;
	}
	/* ---- small context menus -----------------------------------------------
	   One themed card for the timeline's clip menu and a beat's velocity menu.
	   The caller positions it in viewport coordinates and removes it on the
	   next press, exactly as the Clothesline menu does. */
	.studio_menu {
		position: fixed;
		z-index: 60000;
		min-width: 148px;
		padding: 4px;
		border: 1px solid var(--line);
		border-radius: calc(var(--jawnos-corner, 12px) * .6);
		background: var(--panel);
		color: var(--ink);
		box-shadow: var(--shadow-2, 0 8px 24px rgba(0, 0, 0, .28));
	}
	.studio_menu_head {
		padding: 2px 8px 4px;
		font-size: 11px;
		opacity: .65;
	}
	.studio_menu_row {
		display: block;
		width: 100%;
		box-sizing: border-box;
		text-align: left;
		padding: 4px 8px;
		border: 0;
		border-radius: 6px;
		background: transparent;
		color: inherit;
		font-size: 13px;
	}
	.studio_menu_row:hover {
		background: var(--accent-soft, var(--panel-2));
	}
	.studio_menu_row[disabled] {
		opacity: .45;
	}
	.studio_menu_velocity {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 6px;
		padding: 2px 4px;
	}
	.studio_menu_velocity button {
		min-width: 30px;
	}
	.studio_menu_velocity span {
		min-width: 34px;
		text-align: center;
		font-variant-numeric: tabular-nums;
	}
	/* A placed beat carries its velocity as a CSS variable, so a soft hit reads
	   fainter than an accent without a second colour. */
	.studio_drums_step[aria-pressed="true"] {
		opacity: calc(.4 + var(--drums-velocity, 1) * .6);
	}
	/* the drum machine's Kit, Sound, Player and Style lists sit beside Loop, in the same small type */
	.studio_drums_kit_label, .studio_drums_sound_label,
	.studio_drums_player_label, .studio_drums_style_label {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-size: 11px;
	}
	#studio_drums_kit {
		max-width: 112px;
		font-size: 11px;
		padding: 1px 3px;
	}
	#studio_drums_sound {
		max-width: 92px;
		font-size: 11px;
		padding: 1px 3px;
	}
	#studio_drums_player {
		max-width: 96px;
		font-size: 11px;
		padding: 1px 3px;
	}
	#studio_drums_style {
		max-width: 96px;
		font-size: 11px;
		padding: 1px 3px;
	}
	.studio_drums_player_note {
		flex: 1 1 100%;
	}
	.studio_drums_player_note:empty {
		display: none;
	}
	/* ---- the drum machine -------------------------------------------------
	   Eight rows of sixteen steps. Every surface takes its colours from the
	   theme; the only fixed colours left are the pedal LEDs, which are lamps. */
	#studio_drums {
		display: flex;
		flex-direction: column;
		min-width: 0;
		min-height: 0;
	}
	#studio_drums_body {
		flex: 1 1 auto;
		min-height: 0;
		/* the chart is the only scroller; the footer stays in reach */
		overflow: hidden;
		padding: 4px;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	.studio_drums_scroll {
		flex: 1 1 auto;
		min-height: 0;
		overflow: auto;
	}
	/* one grid for the head and every row, so the sixteen columns line up */
	.studio_drums_head,
	.studio_drums_row {
		display: grid;
		grid-template-columns: 72px 24px 14px repeat(16, minmax(12px, 1fr));
		gap: 2px;
		align-items: center;
		min-width: 338px;
	}
	.studio_drums_head {
		position: sticky;
		top: 0;
		z-index: 1;
		align-items: end;
		min-height: 16px;
		padding-top: 3px;
		box-sizing: border-box;
		background: var(--panel-2);
	}
	.studio_drums_head > span {
		line-height: 12px;
	}
	.studio_drums_row {
		margin-bottom: 2px;
	}
	.studio_drums_count {
		font-size: 9px;
		text-align: center;
		opacity: .6;
	}
	.studio_drums_name_head,
	.studio_drums_key_head {
		font-size: 10px;
		opacity: .7;
	}
	.studio_drums_voice,
	.studio_drums_key {
		height: 22px;
		min-width: 0;
		padding: 0 4px;
		font-size: 11px;
		line-height: 20px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		background: var(--panel);
		color: var(--ink);
		border: 1px solid var(--line);
		border-radius: 3px;
	}
	.studio_drums_voice {
		text-align: left;
	}
	.studio_drums_key {
		padding: 0;
		text-align: center;
		font-weight: bold;
	}
	/* a key button in Learn mode says so, in the accent colour */
	.studio_drums_key[aria-pressed="true"] {
		background: var(--accent-soft, var(--panel-2));
		border-color: var(--accent-line, var(--accent));
		color: var(--ink);
	}
	/* the mute lamp: green and lit when the voice sounds, dark when muted */
	.studio_drums_lamp {
		width: 14px;
		height: 14px;
		/* the house button rule gives every button a 28px floor; a lamp is not
		   a button to press with a thumb, it is a 14px roundel */
		min-width: 14px;
		max-width: 14px;
		min-height: 14px;
		max-height: 14px;
		padding: 0;
		border: 2px solid var(--line);
		border-radius: 50%;
		box-sizing: border-box;
		background: var(--runway-good, #2f7d4f);
		box-shadow: 0 0 6px color-mix(in srgb, var(--runway-good, #2f7d4f) 55%, transparent);
	}
	.studio_drums_lamp[aria-pressed="false"] {
		background: color-mix(in srgb, var(--ink) 28%, var(--panel-2));
		box-shadow: none;
	}
	.studio_drums_step {
		height: 22px;
		min-width: 13px;
		padding: 0;
		border: 1px solid var(--line);
		border-radius: 3px;
		background: var(--panel);
	}
	.studio_drums_step[aria-pressed="true"] {
		background: var(--accent);
		border-color: var(--accent-line, var(--accent));
	}
	.studio_drums_step[data-accent="yes"] {
		background: var(--accent-line, var(--accent));
		box-shadow: inset 0 0 0 2px var(--accent-ink, #fff);
	}
	/* the column the scheduler is sounding now */
	.studio_drums_step.studio_drums_playing {
		outline: 2px solid var(--accent-line, var(--accent));
		outline-offset: 1px;
	}
	.studio_drums_key_state {
		font-size: 11px;
		color: var(--ink-muted, var(--ink));
	}
	.studio_drums_loop_label {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-size: 11px;
	}
	.studio_drums_footer {
		display: flex;
		align-items: center;
		gap: 6px;
		flex-wrap: wrap;
		flex: 0 0 auto;
	}
	.studio_drums_footer #studio_drums_midi_input {
		max-width: 100px;
		font-size: 11px;
	}
	#studio_drums_midi_state {
		flex: 1 1 100%;
	}
	#studio_drums_midi_state:empty {
		display: none;
	}
	.studio_drums_note {
		font-size: 10px;
		color: var(--ink-muted, var(--ink));
		opacity: .8;
	}
	/* Close lives in the dock's own bar, so it can never land on a pedal. */
	#studio_pedalboard_close {
		position: static;
		z-index: 1;
	}
	@media (max-width: 800px) {
		.studio_track_panel {
			flex-basis: 118px;
			width: 118px;
		}
		.studio_track_panel .channel_volume {
			width: 56px;
			flex-basis: 56px !important;
		}
		#studio_time_display {
			font-size: 24px;
		}
		#studio_time_duration,
		.studio_transport_sep {
			font-size: 12px;
		}
	}
	/* The transport's controls are larger, and the jog wheel is twice their size. */
	.studio_transport_row .little_thumb {
		width: 32px;
		height: 32px;
		flex: 0 0 32px;
	}
	.studio_transport_row .jog_wheel_frame {
		flex: 0 0 64px;
		width: 64px;
		height: 64px;
	}
	.studio_transport_row #studio_jog_wheel {
		width: 64px;
		height: 64px;
	}
	.studio_transport_row .jog_wheel_frame .jog_wheel_centre {
		width: 10px;
		height: 10px;
		margin-left: -5px;
		margin-top: -5px;
	}
	.studio_transport_knob {
		width: 32px;
		height: 32px;
	}
	/* A dial is a roundel, never a square tile. */
	.knob,
	.studio_transport_knob,
	#studio_jog_wheel {
		border-radius: 50%;
		clip-path: circle(50% at 50% 50%);
	}
	/* A strip is a compact channel: knobs left, fader + meter right, M/S below. */
	#studio_mixer_strips .channel {
		flex: 1 1 88px;
		max-width: 104px;
		height: 100%;
	}
	#studio_master_rack {
		margin-left: auto;
	}
	.studio_strip_body {
		height: 100%;
		flex: 1 1 auto;
		min-height: 0;
		align-items: stretch;
		gap: 4px;
	}
	.studio_strip_knobs {
		flex: 0 0 30px;
	}
	.studio_strip_control {
		display: flex;
		flex-direction: column;
		/* the fader and its meter give up a little width so the mute/solo row
		   below can carry larger buttons */
		flex: 0 0 42px;
		width: 42px;
		height: 100%;
	}
	.studio_strip_fader_group {
		display: flex;
		flex-direction: row;
		align-items: stretch;
		gap: 3px;
		/* the mute/solo row now lives under the whole strip, so the fader group
		   takes the rest of the control column instead of leaving 20% empty */
		height: 100%;
		min-height: 90px;
		flex: 1 1 auto;
		width: 100%;
	}
	.channel_fader {
		position: relative;
		width: 30px;
		height: 100%;
		flex: 0 0 30px;
	}
	.channel_fader .channel_volume {
		position: absolute;
		top: 0;
		left: 0;
		width: 30px;
		height: 100%;
		border: 1px solid var(--line);
		border-radius: 4px;
		background-color: color-mix(in srgb, var(--ink) 8%, transparent);
		/* the shared .channel_volume paints fixed handle artwork that reads as a
		   button parked in the middle; the accent thumb is the only handle, so
		   the strip fader paints a bare track instead */
		background-image: none;
	}
	.channel_fader .channel_volume::-webkit-slider-thumb {
		-webkit-appearance: none;
		appearance: none;
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: var(--accent);
		border: 1px solid var(--accent-line, var(--accent));
		box-shadow: 0 1px 3px rgba(0, 0, 0, .4);
	}
	.channel_fader .channel_volume::-moz-range-thumb {
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: var(--accent);
		border: 1px solid var(--accent-line, var(--accent));
	}
	.studio_strip_scale {
		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: 2;
		font-size: 8px;
		line-height: 1;
		color: var(--ink-muted, var(--ink));
	}
	.studio_strip_scale span {
		position: absolute;
		right: 1px;
		transform: translateY(-50%);
		padding: 0 1px;
		background: color-mix(in srgb, var(--panel) 72%, transparent);
		border-radius: 2px;
	}
	.studio_strip_scale .studio_strip_scale_last {
		transform: translateY(-100%);
	}
	.studio_strip_meter {
		flex: 0 0 8px;
		width: 8px;
		height: 100%;
		display: flex;
		flex-direction: column-reverse;
		gap: 2px;
	}
	.studio_strip_led {
		flex: 1 1 0;
		min-height: 3px;
		width: 10px;
		border: 1px solid color-mix(in srgb, var(--panel) 75%, transparent);
		border-radius: 2px;
		background: color-mix(in srgb, var(--ink) 16%, transparent);
		opacity: .45;
	}
	.studio_strip_led.lit {
		opacity: 1;
	}
	.studio_strip_led.led_green.lit {
		background: var(--runway-good, #2f7d4f);
		box-shadow: 0 0 4px color-mix(in srgb, var(--runway-good, #2f7d4f) 70%, transparent);
	}
	.studio_strip_led.led_yellow.lit {
		background: #d6b24a;
		box-shadow: 0 0 4px rgba(214, 178, 74, .7);
	}
	.studio_strip_led.led_red.lit {
		background: var(--runway-bad, #b3453f);
		box-shadow: 0 0 4px color-mix(in srgb, var(--runway-bad, #b3453f) 70%, transparent);
	}
	.studio_strip_mute_solo {
		position: static;
		left: auto;
		right: auto;
		flex: 0 0 30px;
		height: 30px;
		width: 100%;
		box-sizing: border-box;
		display: flex;
		gap: 3px;
		justify-content: center;
		align-items: center;
	}
	/* M and S share the whole strip's width, so a finger can hit them */
	.studio_strip_mute,
	.studio_strip_solo {
		flex: 1 1 0;
		width: auto;
		min-width: 0;
		height: 26px;
		padding: 0;
		font-size: 13px;
		font-weight: bold;
		line-height: 24px;
		border-radius: 4px;
	}
	.studio_strip_mute[aria-pressed="true"] {
		background: var(--runway-bad, #b3453f);
		color: #fff;
	}
	.studio_strip_solo[aria-pressed="true"] {
		background: var(--runway-good, #2f7d4f);
		color: #fff;
	}
	.channel.studio_solo_muted {
		opacity: .55;
	}
	/* The FX rack's input/output chain switch and the drum loop controls. */
	.studio_chain_toggle {
		display: flex;
		gap: 2px;
		padding: 2px 4px;
	}
	.studio_chain_choice {
		font-size: 10px;
		padding: 0 5px;
		min-width: 28px;
	}
	.studio_chain_choice[aria-pressed="true"] {
		background: var(--accent-soft, var(--panel-2));
		border-color: var(--accent-line, var(--accent));
	}
	.studio_drums_length,
	.studio_drums_library {
		display: inline-flex;
		align-items: center;
		gap: 3px;
		font-size: 11px;
	}
	.studio_drums_length button,
	.studio_drums_library button {
		min-width: 22px;
		padding: 0 4px;
		font-size: 11px;
	}
	.studio_drums_loops {
		max-width: 120px;
		font-size: 11px;
	}
	.studio_drums_save_name {
		width: 100px;
		font-size: 11px;
	}
	#studio_export_state {
		font-size: 12px;
		opacity: .8;
	}
	/* ---- the synth and note panels -----------------------------------------
	   The shared synth surface is scoped to #synth, which is the panel body;
	   these rules give the window its box and make that body the scroller. The
	   note editor's ResizeObserver keeps its canvases on the box it measures. */
	#studio_synth,
	#studio_notes {
		display: flex;
		flex-direction: column;
		min-width: 0;
		min-height: 0;
		overflow: hidden;
	}
	#studio_synth .studio_synth_body {
		flex: 1 1 auto;
		min-height: 0;
		overflow: auto;
	}
	#studio_synth .studio_synth_library {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 3px;
		padding: 3px 6px;
		font-size: 11px;
		flex: 0 0 auto;
	}
	#studio_synth .studio_synth_library button {
		min-width: 22px;
		padding: 0 5px;
		font-size: 11px;
	}
	#studio_synth .studio_synth_save_name {
		width: 100px;
		font-size: 11px;
	}
	#studio_synth .studio_synth_loops {
		max-width: 140px;
		font-size: 11px;
	}
	#studio_notes #studio_notes_body {
		flex: 1 1 auto;
		min-height: 0;
		overflow: hidden;
	}
</style>
