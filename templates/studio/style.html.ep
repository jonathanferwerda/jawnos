<style>
	.pedal {
		width: 160px;
		max-height: 187px;
		position: absolute;
		top: 12px;
		border: solid;
		border-width: 5px;
		border-radius: 10px;
		background: brown;
	}
	#pedalboard {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 215px;
		overflow-x: auto;
		overflow-y: hidden;
		background-color: rgba(60, 32, 12, 0.97);
		border-top: 3px solid #2a1608;
		z-index: 60000;
	}
	.pedal_background {
		width: 100%;
	}
	#studio_pedalboard_toggle {
		right: 0px;
		bottom:60px;
		position:fixed;
	}
	#studio_controls {
		position:absolute;
		padding-left:5px;
		left:0;
		right:0;
		top:0;
		bottom:0;
		width:auto;
	}
	/* the transport buttons and the jog wheel share one row, so the wheel can
	   never cover Prev/Next and the panel's own width is the only constraint */
	.studio_transport_row {
		display: flex;
		align-items: center;
		gap: 6px;
		flex-wrap: nowrap;
	}
	.studio_transport_row .little_thumb {
		width: 40px;
		height: 40px;
		flex: 0 0 40px;
	}
	#studio_track_container {
		/* the hidden media elements live inside the track area, a clipped 1px box:
		   they must never paint on the window (or the desk) beside it */
		position: absolute;
		left: 0;
		top: 0;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}
	.track {
		width: 100%;
		height: 100%;
		cursor: var(--jawnos-cursor-grab, grab);
	}
	.channel_fx {
		display: block;
		font-size: 10px;
		line-height: 1.15;
		word-break: break-word;
		max-height: 42px;
		overflow: hidden;
		color: #04325f;
	}
	.knob {
		width: 30px;
		aspect-ratio: 1 / 1;
		box-sizing: border-box;
		object-fit: contain;
		transform: rotate(180deg);
		border-radius: 50%;
	}
	.channel_fx_pedal {
		display: block;
		width: 100%;
		margin-bottom: 2px;
		border-radius: 3px;
	}
	.channel.selected_channel {
		box-shadow: inset 0 0 0 3px #8ab4f8;
	}
	.pedal_background {
		cursor: var(--jawnos-cursor-grab, grab);
	}
	.knob {
		cursor: var(--jawnos-cursor-ns-resize, ns-resize);
		touch-action: none;
	}
	.knob.knob_active {
		filter: brightness(1.3);
	}
	/* the value bubble a knob shows while it is dragged or rolled */
	#studio_knob_readout {
		position: absolute;
		display: none;
		z-index: 70000;
		padding: 1px 6px;
		background: #04325f;
		color: #fff;
		border-radius: 4px;
		font-size: 12px;
		pointer-events: none;
	}
	/* a channel's inserted-pedal badge jumps the pedalboard to that pedal */
	.channel_fx_pedal {
		cursor: var(--jawnos-cursor-pointer, pointer);
	}
	.pedal.pedal_revealed {
		box-shadow: 0 0 0 4px #ffd21e;
	}
	.knob_control {
		appearance:none;
		width: 30px;
		height: 100px;

		writing-mode: vertical-lr;
	  direction: rtl;
	  vertical-align: middle;
	}
	.armed {
		height: 30px;
		width: 20px;
		/* the button never gives way to a fader drawn over the strip */
		position: relative;
		z-index: 1;
	}
	.armed[state=off] {
		background:grey;
	}
	.armed[state=rec] {
		background:red;
	}
	.armed[state=play] {
		background:green;
	}
	.armed[state=loop] {
		background:blue;
	}
	.cord {
		width:40px;
	}
	.jack {
		width:40px;
	}

	/* the fader and its metre live inside the strip, below the arm button, so
	   they can never sit on top of the record/play/loop toggle */
	.channel_fader {
		position: relative;
		display: block;
		width: 34px;
		height: 120px;
		margin: 2px 0 4px 0;
		/* dropped to the foot of the strip when there is room for it, but it
		   stays below the arm button when the strip is short */
		margin-top: auto;
	}
	.channel_volume {
		position:absolute;
		appearance: none;
		height: 118px;
		width: 34px;
		left: 0;
		top: 0;
		border: solid;
		border-radius: 5px;
		border-width: .1px;
		background-color:transparent;
		color: black;
		outline: none;
	  writing-mode: vertical-lr;
	  direction: rtl;
	  vertical-align: middle;
		background-image: url('<%= &subs::icon_for('/images/studio/slider2.png') %>');
	}
	.channel_volume_metre {
		position:absolute;
		height: 118px;
		width: 30px;
		left: 2px;
		top: 1px;
		color: black;
		outline: none;
	  vertical-align: middle;

	}
	.channel {
		border: solid;
		border-width: 2px;
		border-radius: 5px;
		width: 40px;
		height: 100%;
		display: inline-flex;
		flex-direction: column;
		align-items: center;
		padding-top:10px;
		position: relative;

	}
	/* controls keep their size whether or not the strip is tall enough */
	.channel > * {
		flex: none;
	}
	<%# The channel controls are per track now, so no per-channel rule is needed. %>
	#studio {
		height:100%;
		width:100%;
		border-width: 10px;
		border-radius: 10px;
		border: solid;
		position: relative;
		box-sizing: border-box;
		min-width: 380px;
		/* the grid owns the height; the window never grows to fit a panel */
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}
	#studio_viewer {
		flex: 1 1 auto;
		min-height: 120px;
		width: 100%;
		overflow-x: hidden;
		overflow-y: auto;
		background-color: lightblue;
	}
	/* The four docked panels pack into one grid: every panel is one column wide
	   by default, auto-flow dense fills the gaps, and a two-column span is the
	   only widening. Nothing owns a named cell, so the transport fits beside the
	   strips. A floated panel leaves the grid (07_layout.js). */
	.studio_grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		grid-auto-flow: dense;
		grid-auto-rows: minmax(0, 1fr);
		gap: 6px;
		flex: 1 1 auto;
		min-height: 0;
		padding: 4px;
		box-sizing: border-box;
		overflow: hidden;
	}
	.studio_grid > div {
		grid-column: span 1;
		min-width: 0;
		min-height: 0;
	}
	#studio_mixer {
		min-width: 0;
		min-height: 0;
		width: 100%;
		background-color: tan;
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}
	#studio_mixer_strips {
		display: flex;
		flex-direction: row;
		align-items: stretch;
		gap: 4px;
		padding: 4px;
		box-sizing: border-box;
		/* strips scroll both ways: their faders are reachable even when the
		   panel is short, and many strips still scroll sideways */
		overflow-x: auto;
		overflow-y: auto;
		flex: 1 1 auto;
		min-height: 0;
	}
	#studio_mixer_strips .channel {
		flex: 0 0 44px;
		height: auto;
		min-height: 180px;
	}
	#studio_transport_panel {
		position: relative;
		min-width: 0;
		min-height: 0;
		width: 100%;
		/* the transport and its video previews scroll inside the window; nothing
		   in this panel may paint below it */
		overflow: auto;
	}
	#studio_jog_wheel {
		left: 2px;
		top: 2px;
		position:absolute;
		height: 40px;
		width: 40px;
		border-radius: 50%;
	}
	.jog_wheel_frame {
		position: relative;
		display: inline-block;
		flex: 0 0 44px;
		width: 44px;
		height: 44px;
		vertical-align: middle;
	}
	.jog_wheel_frame .jog_wheel_centre {
		position: absolute;
		left: 50%;
		top: 50%;
		margin-left: -2px;
		margin-top: -2px;
	}
	#studio_time_display {
		font-size: 32px;
	}
	#studio_synth {
		min-width: 0;
		min-height: 0;
		overflow: auto;
	}
	/* Studio is a desk-wide app. The dock and the taskbar sit at 39997/39998;
	   raising the Studio window above them keeps the transport clickable at
	   800x600 without taking the desk's start menu or power menu with it. */
	@media (min-width: 640px) {
		.wind[app="studio"] { z-index: 39999 !important; }
	}
	/* ---- layout bar, per-track panels and floating panels ------------------ */
	.studio_layout_bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 4px;
		padding: 3px 4px;
		flex: 0 0 auto;
	}
	.studio_layout_bar button {
		font-size: 12px;
	}
	.studio_track_count {
		font-size: 12px;
		opacity: .7;
		padding: 0 4px;
	}
	#studio_tracks_panel {
		display: flex;
		flex-direction: column;
		min-width: 0;
		min-height: 0;
		position: relative;
		overflow: hidden;
	}
	.studio_panel_bar {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 2px 4px;
		flex: 0 0 auto;
		background: rgba(0, 0, 0, 0.08);
		position: relative;
		z-index: 2;
	}
	.studio_drag_handle {
		cursor: var(--jawnos-cursor-grab, grab);
		touch-action: none;
		user-select: none;
		font-weight: bold;
	}
	.studio_panel_bar .studio_drag_handle {
		font-size: 12px;
	}
	.studio_dock {
		display: none;
	}
	.studio_panel_floating .studio_dock {
		display: inline-block;
	}
	/* the width toggle belongs to a docked panel; a float is sized by its box */
	.studio_span_toggle {
		font-size: 12px;
	}
	.studio_panel_floating .studio_span_toggle {
		display: none;
	}
	.studio_panel_floating {
		position: absolute !important;
		z-index: 70000;
		background: var(--panel, #eee);
		border: 2px solid var(--line, #333);
		border-radius: 8px;
		box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
		max-width: 96%;
		max-height: 92%;
		overflow: auto;
	}
	.studio_panel_dragging {
		opacity: .92;
		cursor: var(--jawnos-cursor-grabbing, grabbing);
	}
	/* a resize grip rides the floated panel's bottom-right corner */
	.studio_resize_handle {
		display: none;
		position: absolute;
		right: 0;
		bottom: 0;
		width: 18px;
		height: 18px;
		z-index: 3;
		cursor: var(--jawnos-cursor-nwse-resize, nwse-resize);
		touch-action: none;
		background: linear-gradient(135deg, transparent 0 42%, var(--line, #333) 43% 50%, transparent 51% 62%, var(--line, #333) 63% 70%, transparent 71%);
	}
	.studio_panel_floating .studio_resize_handle { display: block; }
	.studio_panel_resizing { cursor: var(--jawnos-cursor-nwse-resize, nwse-resize); }
	.studio_track {
		display: flex;
		align-items: stretch;
		gap: 4px;
		min-height: 64px;
		border-bottom: 1px solid rgba(0, 0, 0, .12);
	}
	.studio_track_panel {
		flex: 0 0 150px;
		width: 150px;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding: 2px 4px;
		background: rgba(255, 255, 255, .35);
		min-width: 0;
		cursor: var(--jawnos-cursor-pointer, pointer);
	}
	.studio_track_panel.selected_channel {
		box-shadow: inset 0 0 0 3px #8ab4f8;
	}
	.studio_track_line {
		display: flex;
		align-items: center;
		gap: 3px;
		min-width: 0;
	}
	.studio_track_line > * {
		flex: none;
	}
	.studio_track_arm {
		min-width: 22px;
	}
	.studio_track_name {
		flex: 1 1 auto !important;
		min-width: 0;
		width: 100%;
		font-size: 12px;
		border: solid 1px var(--line, #999);
		border-radius: 3px;
		background: var(--panel, #fff);
		color: inherit;
	}
	.studio_track_fx,
	.studio_track_automation,
	.studio_track_delete {
		font-size: 11px;
		padding: 1px 4px;
	}
	.studio_track_automation[aria-pressed="true"] {
		background: #ffd21e;
	}
	.studio_track_panel .channel_volume {
		position: relative;
		width: 80px;
		height: 18px;
		writing-mode: horizontal-tb;
		direction: ltr;
		background-image: none;
		border-radius: 9px;
		flex: 0 0 80px !important;
	}
	.studio_track_panel .channel_volume_metre {
		position: relative;
		left: 0;
		top: 0;
		width: 80px;
		height: 6px;
	}
	.studio_track_panel .channel_fx {
		display: none;
		max-height: 34px;
	}
	.studio_track_panel .channel_fx.studio_fx_open {
		display: block;
	}
	.studio_track_body {
		position: relative;
		flex: 1 1 auto;
		min-width: 0;
		display: flex;
		flex-direction: column;
	}
	.studio_track_body .track {
		flex: 1 1 auto;
		min-height: 55px;
		width: 100%;
		height: 100%;
		box-sizing: border-box;
	}
	.studio_track_automation_lane {
		display: none;
		height: 26px;
		padding: 2px 5px;
		font-size: 11px;
		box-sizing: border-box;
		background: rgba(4, 50, 95, .12);
		border-top: 1px dashed rgba(4, 50, 95, .5);
	}
	.studio_track.studio_track_automation_on .studio_track_automation_lane {
		display: block;
	}
	#studio_pedalboard_close {
		position: absolute;
		right: 6px;
		top: 4px;
		z-index: 60001;
	}
	@media (max-width: 800px) {
		.studio_track_panel {
			flex-basis: 118px;
			width: 118px;
		}
		.studio_track_panel .channel_volume {
			width: 56px;
			flex-basis: 56px !important;
		}
		#studio_transport_panel {
			flex-basis: 300px;
		}
	}
</style>
