<style>
	/* Every tile is the same 140px box: the artwork pedals, the palette's text
	   tiles and Autotune line up, and the row scrolls instead of overlapping. */
	.pedal {
		width: 160px;
		height: 140px;
		flex: 0 0 auto;
		position: relative;
		left: auto;
		top: auto;
		box-sizing: border-box;
		border: solid;
		border-width: 5px;
		border-radius: 10px;
		background: brown;
		overflow: hidden;
	}
	/* The pedalboard is a docked row at the foot of the window, never an overlay:
	   its own bar holds Close and the tiles scroll sideways in the row below it. */
	#pedalboard {
		position: relative;
		order: 3;
		flex: 0 0 auto;
		min-height: 0;
		/* the bar (20px) plus the 140px tiles and a thin scrollbar: 170px, so
		   the arranged grid still keeps its timeline on a 600px-tall window */
		max-height: 170px;
		overflow: hidden;
		background-color: rgba(60, 32, 12, 0.97);
		border-top: 3px solid #2a1608;
		box-sizing: border-box;
	}
	.studio_pedalboard_bar {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 8px;
		height: 20px;
		padding: 0 6px;
		box-sizing: border-box;
		flex: 0 0 auto;
	}
	#studio_pedalboard_close {
		font-size: 12px;
		line-height: 18px;
		padding: 0 4px;
	}
	#studio_pedalboard_pedals {
		position: static;
		display: flex;
		align-items: flex-start;
		gap: 10px;
		min-height: 0;
		max-height: 150px;
		padding: 0 6px;
		box-sizing: border-box;
		/* sideways, and down only if the window really cannot give the row its
		   140px; a thin scrollbar is part of the 150px budget */
		overflow: auto;
		scrollbar-width: thin;
	}
	#studio_pedalboard_pedals::-webkit-scrollbar {
		width: 6px;
		height: 6px;
	}
	.pedal_background {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}
	/* A palette effect with no artwork is a text tile, not a smaller box. */
	.pedal_text {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 10px;
		background: #3a2a1a;
		color: #fff;
	}
	.studio_pedal_name {
		font-size: 15px;
		text-align: center;
		padding: 0 6px 0 14px;
	}
	.studio_pedal_foot {
		font-size: 12px;
	}
	/* The lamp: a 14px roundel. The unlit state is a dark red disc with a pale
	   ring (never invisible); on it is a bright green with a soft glow. Every
	   tile and rack row carries one. */
	.studio_pedal_led {
		position: absolute;
		right: 6px;
		top: 6px;
		width: 14px;
		height: 14px;
		box-sizing: border-box;
		border: 2px solid #1b1414;
		border-radius: 50%;
		background: #5a1010;
		box-shadow: inset 0 1px 2px #000, 0 0 0 1px rgba(255, 255, 255, .3);
		cursor: var(--jawnos-cursor-pointer, pointer);
		z-index: 5;
	}
	.studio_pedal_led[aria-pressed="true"] {
		background: #35e05a;
		border-color: #0b4a1a;
		box-shadow: 0 0 10px #35e05a, 0 0 3px #fff, inset 0 1px 2px #0b4a1a;
	}
	.studio_rack_led {
		position: static;
		flex: 0 0 14px;
		width: 14px;
		height: 14px;
		align-self: center;
	}
	/* the rack row dims when bypassed, but its lamp must stay readable */
	.studio_rack_off .studio_rack_led {
		opacity: 1;
	}
	#studio_pedalboard_toggle {
		right: 0px;
		bottom:60px;
		position:fixed;
	}
	/* the four docked panels and the docked pedalboard share the window's height */
	#studio_layout_bar { order: 1; }
	#studio_grid { order: 2; }
	#studio_controls {
		position:absolute;
		padding-left:5px;
		left:0;
		right:0;
		top:0;
		bottom:0;
		width:auto;
	}
	/* the transport buttons and the jog wheel share one row, so the wheel can
	   never cover Prev/Next and the panel's own width is the only constraint */
	.studio_transport_row {
		display: flex;
		align-items: center;
		gap: 6px;
		flex-wrap: nowrap;
	}
	.studio_transport_row .little_thumb {
		width: 40px;
		height: 40px;
		flex: 0 0 40px;
	}
	#studio_track_container {
		/* the hidden media elements live inside the track area, a clipped 1px box:
		   they must never paint on the window (or the desk) beside it */
		position: absolute;
		left: 0;
		top: 0;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}
	.track {
		width: 100%;
		height: 100%;
		cursor: var(--jawnos-cursor-grab, grab);
	}
	.channel_fx {
		display: block;
		font-size: 10px;
		line-height: 1.15;
		word-break: break-word;
		max-height: 42px;
		overflow: hidden;
		color: #04325f;
	}
	.knob {
		width: 30px;
		aspect-ratio: 1 / 1;
		box-sizing: border-box;
		object-fit: contain;
		transform: rotate(180deg);
		border-radius: 50%;
	}
	.channel_fx_pedal {
		display: block;
		width: 100%;
		margin-bottom: 2px;
		border-radius: 3px;
	}
	.channel.selected_channel {
		box-shadow: inset 0 0 0 3px #8ab4f8;
	}
	.pedal_background {
		cursor: var(--jawnos-cursor-grab, grab);
	}
	.knob {
		cursor: var(--jawnos-cursor-ns-resize, ns-resize);
		touch-action: none;
	}
	.knob.knob_active {
		filter: brightness(1.3);
	}
	/* the value bubble a knob shows while it is dragged or rolled */
	#studio_knob_readout {
		position: absolute;
		display: none;
		z-index: 70000;
		padding: 1px 6px;
		background: #04325f;
		color: #fff;
		border-radius: 4px;
		font-size: 12px;
		pointer-events: none;
	}
	/* a channel's inserted-pedal badge jumps the pedalboard to that pedal */
	.channel_fx_pedal {
		cursor: var(--jawnos-cursor-pointer, pointer);
	}
	.pedal.pedal_revealed {
		box-shadow: 0 0 0 4px #ffd21e;
	}
	.knob_control {
		appearance:none;
		width: 30px;
		height: 100px;

		writing-mode: vertical-lr;
	  direction: rtl;
	  vertical-align: middle;
	}
	.armed {
		height: 30px;
		width: 20px;
		/* the button never gives way to a fader drawn over the strip */
		position: relative;
		z-index: 1;
	}
	.armed[state=off] {
		background:grey;
	}
	.armed[state=rec] {
		background:red;
	}
	.armed[state=play] {
		background:green;
	}
	.armed[state=loop] {
		background:blue;
	}
	.cord {
		width:40px;
	}
	.jack {
		width:40px;
	}

	/* the fader and its metre live inside the strip, below the arm button, so
	   they can never sit on top of the record/play/loop toggle */
	.channel_fader {
		position: relative;
		display: block;
		width: 34px;
		height: 120px;
		margin: 2px 0 4px 0;
		/* dropped to the foot of the strip when there is room for it, but it
		   stays below the arm button when the strip is short */
		margin-top: auto;
	}
	.channel_volume {
		position:absolute;
		appearance: none;
		height: 118px;
		width: 34px;
		left: 0;
		top: 0;
		border: solid;
		border-radius: 5px;
		border-width: .1px;
		background-color:transparent;
		color: black;
		outline: none;
	  writing-mode: vertical-lr;
	  direction: rtl;
	  vertical-align: middle;
		background-image: url('<%= &subs::icon_for('/images/studio/slider2.png') %>');
	}
	.channel_volume_metre {
		position:absolute;
		height: 118px;
		width: 30px;
		left: 2px;
		top: 1px;
		color: black;
		outline: none;
	  vertical-align: middle;

	}
	.channel {
		border: solid;
		border-width: 2px;
		border-radius: 5px;
		width: 40px;
		height: auto;
		min-height: 0;
		display: inline-flex;
		flex-direction: column;
		align-items: center;
		padding-top:10px;
		position: relative;

	}
	/* controls keep their size whether or not the strip is tall enough */
	.channel > * {
		flex: none;
	}
	<%# The channel controls are per track now, so no per-channel rule is needed. %>
	#studio {
		height:100%;
		width:100%;
		border-width: 10px;
		border-radius: 10px;
		border: solid;
		position: relative;
		box-sizing: border-box;
		min-width: 380px;
		/* the grid owns the height; the window never grows to fit a panel */
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}
	#studio_viewer {
		flex: 1 1 auto;
		min-height: 0;
		width: 100%;
		overflow-x: hidden;
		overflow-y: auto;
		background-color: lightblue;
	}
	/* The four docked panels pack into one grid: every panel is one column wide
	   by default, auto-flow dense fills the gaps, and a two-column span is the
	   only widening. Nothing owns a named cell, so the transport fits beside the
	   strips. A floated panel leaves the grid (07_layout.js). */
	.studio_grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		grid-auto-flow: dense;
		grid-auto-rows: minmax(0, 1fr);
		gap: 6px;
		flex: 1 1 auto;
		min-height: 0;
		padding: 4px;
		box-sizing: border-box;
		overflow: hidden;
	}
	/* A docked panel never paints over its neighbour: each one is a scroll box
	   (`min-height: 0` + `overflow: auto`) and its own content scrolls inside. */
	.studio_grid > div {
		grid-column: span 1;
		min-width: 0;
		min-height: 0;
		overflow: auto;
	}
	/* ---- arranged mode ------------------------------------------------------
	   Arrange gives the grid its explicit DAW areas: the transport keeps only
	   its own height, the timeline takes the flexible middle with the synth
	   beside it, and the console gets a compact band at the foot. The placement
	   is `!important` so the manual order/span inline styles (kept for when
	   arranged mode ends) cannot override the named areas. 07_layout.js removes
	   .studio_arranged the moment a panel is moved, floated, docked, widened or
	   re-ordered, and the manual packing takes over again. */
	#studio_grid.studio_arranged {
		grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
		/* the console row is auto: its own 132px cap sizes the band, and that is
		   well under 45% of the grid at the target window sizes, so the timeline
		   keeps the room */
		grid-template-rows: auto minmax(0, 1fr) auto;
		grid-template-areas:
			"transport transport transport"
			"tracks tracks synth"
			"mixer mixer mixer";
		grid-auto-flow: row;
		/* a very short window scrolls the whole arranged grid rather than
		   clipping an area; each panel still scrolls inside itself */
		overflow-y: auto;
	}
	#studio_grid.studio_arranged > #studio_transport_panel {
		grid-area: transport !important;
		/* the record row and the tempo row; the rest scrolls */
		height: 96px;
	}
	#studio_grid.studio_arranged > #studio_tracks_panel {
		grid-area: tracks !important;
	}
	#studio_grid.studio_arranged > #studio_synth {
		grid-area: synth !important;
	}
	#studio_grid.studio_arranged > #studio_mixer {
		grid-area: mixer !important;
		height: auto;
		max-height: 132px;
	}
	/* A phone-width window stacks the same areas: transport, dominant timeline,
	   a compact console, then the synth. The fixed auto-row heights are small so
	   a short window still leaves the timeline room; every panel scrolls. */
	#studio_grid.studio_arranged_compact {
		grid-template-columns: minmax(0, 1fr);
		grid-template-rows: auto minmax(0, 1fr) auto auto;
		grid-template-areas:
			"transport"
			"tracks"
			"mixer"
			"synth";
		grid-auto-flow: row;
		overflow-y: auto;
	}
	#studio_grid.studio_arranged_compact > #studio_transport_panel {
		grid-area: transport !important;
		height: 88px;
	}
	#studio_grid.studio_arranged_compact > #studio_tracks_panel {
		grid-area: tracks !important;
	}
	#studio_grid.studio_arranged_compact > #studio_mixer {
		grid-area: mixer !important;
		height: 104px;
	}
	#studio_grid.studio_arranged_compact > #studio_synth {
		grid-area: synth !important;
		height: 104px;
	}
	#studio_mixer {
		min-width: 0;
		min-height: 0;
		width: 100%;
		background-color: tan;
		display: flex;
		flex-direction: column;
		overflow: auto;
	}
	#studio_mixer_strips {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		gap: 4px;
		padding: 4px;
		box-sizing: border-box;
		/* strips scroll both ways: their faders are reachable even when the
		   panel is short, and many strips still scroll sideways */
		overflow-x: auto;
		overflow-y: auto;
		flex: 1 1 auto;
		min-height: 0;
	}
	#studio_mixer_strips .channel {
		flex: 0 0 44px;
		height: auto;
		min-height: 0;
	}
	#studio_transport_panel {
		position: relative;
		min-width: 0;
		min-height: 0;
		width: 100%;
		/* the transport and its video previews scroll inside the window; nothing
		   in this panel may paint below it */
		overflow: auto;
	}
	#studio_jog_wheel {
		left: 2px;
		top: 2px;
		position:absolute;
		height: 40px;
		width: 40px;
		border-radius: 50%;
	}
	.jog_wheel_frame {
		position: relative;
		display: inline-block;
		flex: 0 0 44px;
		width: 44px;
		height: 44px;
		vertical-align: middle;
	}
	.jog_wheel_frame .jog_wheel_centre {
		position: absolute;
		left: 50%;
		top: 50%;
		margin-left: -2px;
		margin-top: -2px;
	}
	#studio_time_display {
		font-size: 32px;
	}
	#studio_synth {
		min-width: 0;
		min-height: 0;
		overflow: auto;
	}
	/* Studio is a desk-wide app. The dock and the taskbar sit at 39997/39998;
	   raising the Studio window above them keeps the transport clickable at
	   800x600 without taking the desk's start menu or power menu with it. */
	@media (min-width: 640px) {
		.wind[app="studio"] { z-index: 39999 !important; }
	}
	/* ---- layout bar, per-track panels and floating panels ------------------ */
	.studio_layout_bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 4px;
		padding: 3px 4px;
		flex: 0 0 auto;
	}
	.studio_layout_bar button {
		font-size: 12px;
	}
	/* the effect palette: add any contract effect to the selected track */
	.studio_effect_palette {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		margin-left: 6px;
	}
	.studio_effect_palette select {
		font-size: 12px;
		max-width: 150px;
	}
	.studio_palette_label,
	.studio_palette_channel {
		font-size: 12px;
		opacity: .7;
	}
	.studio_rack_template {
		display: none;
	}
	.studio_track_count {
		font-size: 12px;
		opacity: .7;
		padding: 0 4px;
	}
	#studio_tracks_panel {
		display: flex;
		flex-direction: column;
		min-width: 0;
		min-height: 0;
		position: relative;
		overflow: auto;
	}
	.studio_panel_bar {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 2px 4px;
		flex: 0 0 auto;
		background: rgba(0, 0, 0, 0.08);
		position: relative;
		z-index: 2;
	}
	.studio_drag_handle {
		cursor: var(--jawnos-cursor-grab, grab);
		touch-action: none;
		user-select: none;
		font-weight: bold;
	}
	.studio_panel_bar .studio_drag_handle {
		font-size: 12px;
	}
	.studio_dock {
		display: none;
	}
	.studio_panel_floating .studio_dock {
		display: inline-block;
	}
	/* the width toggle belongs to a docked panel; a float is sized by its box */
	.studio_span_toggle {
		font-size: 12px;
	}
	.studio_panel_floating .studio_span_toggle {
		display: none;
	}
	.studio_panel_floating {
		position: absolute !important;
		z-index: 70000;
		background: var(--panel, #eee);
		border: 2px solid var(--line, #333);
		border-radius: 8px;
		box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
		max-width: 96%;
		max-height: 92%;
		overflow: auto;
	}
	.studio_panel_dragging {
		opacity: .92;
		cursor: var(--jawnos-cursor-grabbing, grabbing);
	}
	/* a resize grip rides the floated panel's bottom-right corner */
	.studio_resize_handle {
		display: none;
		position: absolute;
		right: 0;
		bottom: 0;
		width: 18px;
		height: 18px;
		z-index: 3;
		cursor: var(--jawnos-cursor-nwse-resize, nwse-resize);
		touch-action: none;
		background: linear-gradient(135deg, transparent 0 42%, var(--line, #333) 43% 50%, transparent 51% 62%, var(--line, #333) 63% 70%, transparent 71%);
	}
	.studio_panel_floating .studio_resize_handle { display: block; }
	.studio_panel_resizing { cursor: var(--jawnos-cursor-nwse-resize, nwse-resize); }
	.studio_track {
		display: flex;
		align-items: stretch;
		gap: 4px;
		min-height: 64px;
		border-bottom: 1px solid rgba(0, 0, 0, .12);
	}
	.studio_track_panel {
		flex: 0 0 150px;
		width: 150px;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		gap: 2px;
		padding: 2px 4px;
		background: rgba(255, 255, 255, .35);
		min-width: 0;
		cursor: var(--jawnos-cursor-pointer, pointer);
	}
	.studio_track_panel.selected_channel {
		box-shadow: inset 0 0 0 3px #8ab4f8;
	}
	.studio_track_line {
		display: flex;
		align-items: center;
		gap: 3px;
		min-width: 0;
	}
	.studio_track_line > * {
		flex: none;
	}
	.studio_track_arm {
		min-width: 22px;
	}
	.studio_track_name {
		flex: 1 1 auto !important;
		min-width: 0;
		width: 100%;
		font-size: 12px;
		border: solid 1px var(--line, #999);
		border-radius: 3px;
		background: var(--panel, #fff);
		color: inherit;
	}
	.studio_track_fx,
	.studio_track_automation,
	.studio_track_delete {
		font-size: 11px;
		padding: 1px 4px;
	}
	.studio_track_automation[aria-pressed="true"] {
		background: #ffd21e;
	}
	.studio_track_panel .channel_volume {
		position: relative;
		width: 80px;
		height: 18px;
		writing-mode: horizontal-tb;
		direction: ltr;
		background-image: none;
		border-radius: 9px;
		flex: 0 0 80px !important;
	}
	.studio_track_panel .channel_volume_metre {
		position: relative;
		left: 0;
		top: 0;
		width: 80px;
		height: 6px;
	}
	.studio_track_panel .channel_fx {
		display: none;
		max-height: 34px;
	}
	.studio_track_panel .channel_fx.studio_fx_open {
		display: block;
	}
	/* A track's rack is the ordered chain itself: FX opens it under the panel. */
	.studio_channel_rack {
		display: none;
		margin-top: 2px;
		font-size: 11px;
		max-height: 260px;
		overflow-y: auto;
	}
	.studio_track.studio_fx_open .studio_channel_rack {
		display: block;
	}
	.studio_rack_row {
		border: 1px solid rgba(4, 50, 95, .25);
		border-radius: 4px;
		padding: 2px;
		margin-bottom: 2px;
		background: rgba(255, 255, 255, .45);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 2px;
	}
	.studio_rack_row.studio_rack_off {
		opacity: .45;
	}
	.studio_rack_handle {
		cursor: var(--jawnos-cursor-grab, grab);
		padding: 0 2px;
	}
	.studio_rack_name {
		flex: 1 1 auto;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-weight: bold;
	}
	.studio_rack_row button {
		font-size: 10px;
		padding: 0 3px;
	}
	.studio_rack_controls {
		flex: 1 1 100%;
		display: flex;
		flex-wrap: wrap;
		gap: 2px 6px;
	}
	.studio_rack_control {
		display: flex;
		flex-direction: column;
		font-size: 9px;
	}
	.studio_rack_control input[type=range] {
		width: 64px;
	}
	.studio_rack_control select {
		max-width: 90px;
		font-size: 10px;
	}
	.channel_fx_pedal.studio_fx_bypassed,
	.channel_fx_text.studio_fx_bypassed {
		opacity: .45;
		text-decoration: line-through;
	}
	/* The mastering chain: one rack on the mixer's own bus, and the strips' last
	   child so it sits at their far right. It is a compact block that wraps and
	   scrolls inside its own box instead of spilling over the strips. */
	.studio_master_rack {
		flex: 0 0 210px;
