<style>
	.pedal {
		width: 160px;
		max-height: 187px;
		position: absolute;
		top: 12px;
		border: solid;
		border-width: 5px;
		border-radius: 10px;
		background: brown;
	}
	#pedalboard {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 215px;
		overflow-x: auto;
		overflow-y: hidden;
		background-color: rgba(60, 32, 12, 0.97);
		border-top: 3px solid #2a1608;
		z-index: 60000;
	}
	.pedal_background {
		width: 100%;
	}
	#studio_pedalboard_toggle {
		right: 0px;
		bottom:60px;
		position:fixed;
	}
	#studio_controls {
		position:absolute;
		padding-left:5px;
	}
	#studio_track_container {
		position:absolute;
		right: -130px;
		width: 130px;
		overflow:scroll;
		top:0px;
		height: 100%;
	}
	.track {
		width: 100%;
		height: calc(100% / <%= $channel_count %>);
		cursor: grab;
	}
	.channel_fx {
		display: block;
		font-size: 10px;
		line-height: 1.15;
		word-break: break-word;
		max-height: 42px;
		overflow: hidden;
		color: #04325f;
	}
	.knob {
		width: 30px;
		aspect-ratio: 1 / 1;
		box-sizing: border-box;
		object-fit: contain;
		transform: rotate(180deg);
		border-radius: 50%;
	}
	.channel_fx_pedal {
		display: block;
		width: 100%;
		margin-bottom: 2px;
		border-radius: 3px;
	}
	.channel.selected_channel {
		box-shadow: inset 0 0 0 3px #8ab4f8;
	}
	.pedal_background {
		cursor: grab;
	}
	.knob {
		cursor: ns-resize;
		touch-action: none;
	}
	.knob.knob_active {
		filter: brightness(1.3);
	}
	/* the value bubble a knob shows while it is dragged or rolled */
	#studio_knob_readout {
		position: absolute;
		display: none;
		z-index: 70000;
		padding: 1px 6px;
		background: #04325f;
		color: #fff;
		border-radius: 4px;
		font-size: 12px;
		pointer-events: none;
	}
	/* a channel's inserted-pedal badge jumps the pedalboard to that pedal */
	.channel_fx_pedal {
		cursor: pointer;
	}
	.pedal.pedal_revealed {
		box-shadow: 0 0 0 4px #ffd21e;
	}
	.knob_control {
		appearance:none;
		width: 30px;
		height: 100px;

		writing-mode: vertical-lr;
	  direction: rtl;
	  vertical-align: middle;
	}
	.armed {
		height: 30px;
		width: 20px;
		/* the button never gives way to a fader drawn over the strip */
		position: relative;
		z-index: 1;
	}
	.armed[state=off] {
		background:grey;
	}
	.armed[state=rec] {
		background:red;
	}
	.armed[state=play] {
		background:green;
	}
	.armed[state=loop] {
		background:blue;
	}
	.cord {
		width:40px;
	}
	.jack {
		width:40px;
	}

	/* the fader and its metre live inside the strip, below the arm button, so
	   they can never sit on top of the record/play/loop toggle */
	.channel_fader {
		position: relative;
		display: block;
		width: 34px;
		height: 120px;
		margin: 2px 0 4px 0;
		/* dropped to the foot of the strip when there is room for it, but it
		   stays below the arm button when the strip is short */
		margin-top: auto;
	}
	.channel_volume {
		position:absolute;
		appearance: none;
		height: 118px;
		width: 34px;
		left: 0;
		top: 0;
		border: solid;
		border-radius: 5px;
		border-width: .1px;
		background-color:transparent;
		color: black;
		outline: none;
	  writing-mode: vertical-lr;
	  direction: rtl;
	  vertical-align: middle;
		background-image: url('<%= &subs::icon_for('/images/studio/slider2.png') %>');
	}
	.channel_volume_metre {
		position:absolute;
		height: 118px;
		width: 30px;
		left: 2px;
		top: 1px;
		color: black;
		outline: none;
	  vertical-align: middle;

	}
	.channel {
		border: solid;
		border-width: 2px;
		border-radius: 5px;
		width: 40px;
		height: 100%;
		display: inline-flex;
		flex-direction: column;
		align-items: center;
		padding-top:10px;
		position: relative;

	}
	/* controls keep their size whether or not the strip is tall enough */
	.channel > * {
		flex: none;
	}
	<% for (my $ch = 0; $ch <= $channel_count; $ch++) { %>
		.channel_<%= $ch %> {

		}
		.knob_control[channel=<%= $ch %>] {
			left: <%= 45 * $ch %>px;
		}
	<% } %>
	#studio {
		height:100%;
		width:100%;
		border-width: 10px;
		border-radius: 10px;
		border: solid;
	}
	#studio_viewer {
		height: 30%;
		width: 100%;
		background-color: lightblue;
	}
	#studio_mixer {
		height: 70%;
		width: 100%;
		background-color: tan;
	}	
	#studio_controls {
		width: 100%;
	}
	#studio_jog_wheel {
		right: 40px;
		position:absolute;
		bottom: 10px;
		height: 110px;
		width: 110px;
		border-radius: 50%;
	}
	#studio_time_display {
		font-size: 32px;
	}
</style>
