<% use Mojo::JSON; %>
<%# The drum machine: eight synthesised voices over a chart of up to eight bars.
   The voice and kit tables are data (perl/gb/05_abilities_and_studio.pl), so
   the rows, the starting keys, the MIDI notes and the Kit list have one source.
   The saved drum loops are an app setting published as an array; the browser
   part is public/js/manager/studio/11_drums.js. %>
<script>window.jawnos_studio_drums = <%== Mojo::JSON::encode_json($gb::studio->{'drums'}) %>;</script>
<script>window.jawnos_studio_drum_kits = <%== Mojo::JSON::encode_json($gb::studio->{'drum_kits'}) %>;</script>
<script>window.jawnos_studio_drum_loops = <%== Mojo::JSON::encode_json(eval { Mojo::JSON::decode_json($settings->{'drum_loops'} || '[]') } || []) %>;</script>
<div id="studio_drums" class="studio_panel">
	<div class="studio_panel_bar">
		<span class="studio_drag_handle" data-studio-drag="drums" hint="<%= &subs::ui('Drag to move the drums') %>"><%= &subs::ui('Drums') %></span>
		<span id="studio_drums_key_state" class="studio_drums_key_state" aria-live="polite" hint="<%= &subs::ui('Computer keys follow the Studio window') %>"><%= &subs::ui('Keys live') %></span>
		<label class="studio_drums_loop_label" hint="<%= &subs::ui('Repeat the drum chart each bar') %>"><input type="checkbox" id="studio_drums_loop" checked><%= &subs::ui('Loop') %></label>
		<label class="studio_drums_kit_label"><%= &subs::ui('Kit') %>
			<select id="studio_drums_kit" aria-label="<%= &subs::ui('Choose a drum kit') %>" hint="<%= &subs::ui('Choose a drum kit') %>">
				<% foreach my $k ( @{$gb::studio->{'drum_kits'}} ) { %>
					<option value="<%= $k->{'name'} %>"><%= &subs::ui($k->{'label'}) %></option>
				<% } %>
			</select>
		</label>
		<span class="studio_panel_buttons">
			<button class="studio_panel_min hover" data-panel="drums" hint="<%= &subs::ui('Minimize this panel') %>">–</button>
			<button class="studio_panel_max hover" data-panel="drums" aria-pressed="false" hint="<%= &subs::ui('Maximize or restore this panel') %>">□</button>
		</span>
	</div>
	<span class="studio_resize_handle" data-studio-resize="drums" hint="<%= &subs::ui('Drag to resize this panel') %>"></span>
	<div id="studio_drums_body">
		<div class="studio_drums_scroll">
			<div class="studio_drums_head">
				<span class="studio_drums_name_head"><%= &subs::ui('Drum') %></span>
				<span class="studio_drums_key_head"><%= &subs::ui('Key') %></span>
				<span class="studio_drums_lamp_head"></span>
				<% for my $step (0 .. 127) { %>
					<span class="studio_drums_count" data-step="<%= $step %>"><%= $step + 1 %></span>
				<% } %>
			</div>
			<% foreach my $v ( @{$gb::studio->{'drums'}} ) { %>
				<div class="studio_drums_row" data-voice="<%= $v->{'name'} %>">
					<button class="studio_drums_voice hover" data-voice="<%= $v->{'name'} %>" hint="<%= &subs::ui('Play this drum') %>"><%= &subs::ui($v->{'label'}) %></button>
					<button class="studio_drums_key hover" data-voice="<%= $v->{'name'} %>" aria-pressed="false" title="<%= uc($v->{'key'}) %>" hint="<%= &subs::ui('Assign a computer key to this drum') %>"><%= uc($v->{'key'}) %></button>
					<button class="studio_drums_lamp hover" data-voice="<%= $v->{'name'} %>" aria-pressed="true" title="<%= &subs::ui('Audible') %>" hint="<%= &subs::ui('Mute this drum') %>"></button>
					<% for my $step (0 .. 127) { %>
						<button class="studio_drums_step hover" data-voice="<%= $v->{'name'} %>" data-step="<%= $step %>" aria-pressed="false" hint="<%= &subs::ui('Click to place a beat, hold Shift for an accent, right-click to set its velocity') %>"></button>
					<% } %>
				</div>
			<% } %>
		</div>
		<div class="studio_drums_footer">
			<span class="studio_drums_length">
				<button id="studio_drums_bar_remove" class="hover" hint="<%= &subs::ui('Remove a bar from the drum loop') %>">&minus; Bar</button>
				<button id="studio_drums_bar_add" class="hover" hint="<%= &subs::ui('Add a bar to the drum loop') %>">+ Bar</button>
				<button id="studio_drums_beat_remove" class="hover" hint="<%= &subs::ui('Remove a beat from the drum loop') %>">&minus; Beat</button>
				<button id="studio_drums_beat_add" class="hover" hint="<%= &subs::ui('Add a beat to the drum loop') %>">+ Beat</button>
				<span id="studio_drums_length_readout" class="studio_drums_length_readout"></span>
			</span>
			<span class="studio_drums_library">
				<input id="studio_drums_save_name" class="studio_drums_save_name" placeholder="<%= &subs::ui('Loop name') %>" hint="<%= &subs::ui('Name this drum loop') %>">
				<button id="studio_drums_save_loop" class="studio_drums_save_loop hover" hint="<%= &subs::ui('Save the drum pattern as a loop') %>"><%= &subs::ui('Save loop') %></button>
				<select id="studio_drums_loops" class="studio_drums_loops" hint="<%= &subs::ui('Choose a drum loop') %>"><option value=""><%= &subs::ui('No saved loop') %></option></select>
				<button id="studio_drums_load_loop" class="hover" hint="<%= &subs::ui('Load the chosen drum loop') %>"><%= &subs::ui('Load') %></button>
				<button id="studio_drums_delete_loop" class="hover" hint="<%= &subs::ui('Delete the chosen drum loop') %>"><%= &subs::ui('Delete') %></button>
			</span>
			<button id="studio_drums_clear" class="hover" hint="<%= &subs::ui('Clear the drum chart') %>"><%= &subs::ui('Clear') %></button>
			<button id="studio_drums_midi" class="hover" disabled hint="<%= &subs::ui('Connect a MIDI keyboard to the drums') %>"><%= &subs::ui('MIDI') %></button>
			<select id="studio_drums_midi_input" hint="<%= &subs::ui('Choose a MIDI input for the drums') %>" disabled>
				<option value=""><%= &subs::ui('No MIDI input') %></option>
			</select>
			<span class="studio_drums_note" title="<%= &subs::ui('The browser take records the drums; the engine take does not yet.') %>"><%= &subs::ui('Browser take only') %></span>
			<span id="studio_drums_midi_state" class="studio_drums_note"></span>
		</div>
	</div>
</div>
