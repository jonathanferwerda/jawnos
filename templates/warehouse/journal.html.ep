% no warnings 'uninitialized';
<div class="warehouse_journal_panel">
	<span class="warehouse_journal_close hover" hint="Close" style="float:right;cursor:pointer;">&times;</span>
	<b>Stock journal<% if ($item) { %>: <%= &subs::format_name($item) %><% } %></b>
	<% if (scalar @{$rows} == 0) { %><br><i>No movements recorded.</i><% } %>
	<table style="width:100%;text-align:left;">
		<thead>
			<th>When</th>
			<% unless ($item) { %><th>Item</th><% } %>
			<th>Qty</th><th>Place</th><th>Reason</th><th>Source</th>
		</thead>
		<tbody>
			<% foreach my $r ( @{$rows} ) { %>
				% my $j = $r->{'journal'} || {};
				<tr class="warehouse_journal_row">
					<td class="time" timestamp="<%= $r->{'timestamp'} %>"></td>
					<% unless ($item) { %><td><%= &subs::format_name($r->{'item'}) %></td><% } %>
					<td><%= &subs::numeric_formatter($r->{'quantity'}) %><%= $r->{'unit'} %></td>
					<td><%= &subs::format_name($r->{'place'}) %></td>
					<td><%= &subs::format_name($j->{'reason'} || $r->{'type'}) %></td>
					<td>
						<% if ($j->{'source'}) { %>
							<span class="hover" onclick="appointmentGrabber('<%= $j->{'source'} %>',<%= &subs::rightNow() %>)"><%= &subs::format_name($j->{'source'}) %></span>
						<% } %>
					</td>
				</tr>
			<% } %>
		</tbody>
	</table>
</div>
