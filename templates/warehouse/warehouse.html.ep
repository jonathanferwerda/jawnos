% my $places = &subs::db_query('select * from settings where (setting = ? or setting = ?) and value = ? and device = ?', 'pos', 'mab', 'place', &subs::device_setter() )->hashes;
% use Mojo::JSON qw/decode_json encode_json/;
% $settings->{'place'} = eval { return decode_json $settings->{'place'} } || ['all'];

<div id="warehouse" style="width:100%;height:100%;background-color:white;">
	<select id="warehouse_place" class="warehouse_config" config="place" multiple style="height:100px;">
		<option value="all" <% if (grep { $_ eq 'all' } @{$settings->{'place'}}) { %>selected<% } %>>All</option>
		<% foreach my $p ( sort { $a->{'app'} cmp $b->{'app'} } @{$places} ) { %>
			<option value="<%= $p->{'app'} %>" <% if (grep { $_ eq $p->{'app'} } @{$settings->{'place'}}) { %>selected<% } %>><%= &subs::format_name($p->{'app'}) %></option>
		<% } %>
	</option>
</div>