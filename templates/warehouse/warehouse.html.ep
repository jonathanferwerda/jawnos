% my $places = &subs::db_query('select * from settings where (setting = ? or setting = ?) and value = ? and device = ?', 'pos', 'mab', 'place', &subs::device_setter() )->hashes;
% use Mojo::JSON qw/decode_json encode_json/;
% $settings->{'place'} = eval { return decode_json $settings->{'place'} } || ['all'];

<div id="warehouse" style="width:100%;height:100%;background-color:var(--panel);display:flex;flex-direction:column;">
	<div id="warehouse_toolbar" style="padding:4px;flex:0 0 auto;">
		<select id="warehouse_display" class="warehouse_config" config="display" style="vertical-align:top;">
			<% foreach my $d ( qw/levels moves/ ) { %>
				<option value="<%= $d %>" <% if (($settings->{'display'} || 'levels') eq $d) { %>selected<% } %>><%= &subs::format_name($d) %></option>
			<% } %>
		</select>
		<input type="text" id="warehouse_search" placeholder="Search items" style="width:50%;vertical-align:top;">
		<select id="warehouse_place" class="warehouse_config" config="place" multiple style="height:100px;max-width:45%;">
			<option value="all" <% if (grep { $_ eq 'all' } @{$settings->{'place'}}) { %>selected<% } %>>All</option>
			<% foreach my $p ( sort { $a->{'app'} cmp $b->{'app'} } @{$places} ) { %>
				<option value="<%= $p->{'app'} %>" <% if (grep { $_ eq $p->{'app'} } @{$settings->{'place'}}) { %>selected<% } %>><%= &subs::format_name($p->{'app'}) %></option>
			<% } %>
		</select>
	</div>
	<div id="warehouse_results" style="flex:1 1 auto;overflow:scroll;">
		<% if (($settings->{'display'} || 'levels') eq 'moves') { %>
			<%= include 'warehouse/moves', moves => $moves, search => $search %>
		<% } else { %>
			<%= include 'warehouse/listing', warehouse => $warehouse, places => $settings->{'place'}, search => $search %>
		<% } %>
	</div>
</div>
