	<div class="security_view" view="passkeys" style="<% unless ( $president->{'security_view'} eq 'passkeys' ) { %>display:none;<% } %>">
		<%
			# A passkey can only be made on a page under the house domain, so the
			# in-panel button is offered only when this window is already on that
			# name; on 127.0.0.1 the browser refuses before it ever prompts.
			my $window_host = lc($c->req->url->base->host || '');
			my $rp_host = lc($webauthn_rp || '');
			my $on_house_name = (length $rp_host && ($window_host eq $rp_host || $window_host =~ /\.\Q$rp_host\E$/)) ? 1 : 0;
		%>
		<h2>Passkeys</h2>
		<p style="line-height:1.4;max-width:640px;">
			A passkey is a keypair made by a security key you plug in - a USB or NFC key, not this device's own
			reader and not a phone. The house keeps only its public half,
			so there is nothing here to steal, and the key signs a challenge from this house rather than a password
			that can be typed into the wrong page. A passkey registered here is bound to
			<b><%= length($webauthn_rp || '') ? $webauthn_rp : 'the house domain (not set yet)' %></b>, so the same
			key works on every machine under that name.
		</p>
		<% if (!length($webauthn_rp || '')) { %>
			<p style="color:#e5484d;">Set the house domain first: Configure &rarr; Plat &rarr; DNS &rarr; House domain.</p>
		<% } %>
		<% if (!$passkey_person) { %>
			<p style="color:#e5484d;">This device is not assigned to a person yet. Assign it under Devices, then come back.</p>
		<% } %>
		<table style="width:100%;text-align:left;">
			<thead>
				<tr><th>Name</th><th>Person</th><th>Added</th><th>Last used</th><th></th></tr>
			</thead>
			<tbody>
				<% if (!scalar @{$passkeys}) { %>
					<tr><td colspan="5" style="opacity:.7;">No passkeys yet.</td></tr>
				<% } %>
				<% foreach my $pk ( @{$passkeys} ) { %>
					<tr class="passkey_row">
						<td><%= $pk->{'name'} || 'Passkey' %></td>
						<td><%= $pk->{'person_name'} || '' %></td>
						<td><% if ($pk->{'created'}) { %><span class="time" mode="fixed" timestamp="<%= $pk->{'created'} %>"></span><% } %></td>
						<td><% if ($pk->{'last_used'}) { %><span class="time" mode="fixed" timestamp="<%= $pk->{'last_used'} %>"></span><% } else { %>never<% } %></td>
						<td>
							<% if ($passkey_person && ($pk->{'person_uuid'} || '') eq $passkey_person->{'uuid'}) { %>
								<button class="passkey_remove" id="<%= $pk->{'id'} %>" type="button">Remove</button>
							<% } %>
						</td>
					</tr>
				<% } %>
			</tbody>
		</table>
		<div style="margin-top:12px;">
			<% if ($on_house_name) { %>
				<input id="passkey_name" type="text" placeholder="Laptop" style="width:170px;" autocomplete="off" spellcheck="false">
				<button id="passkey_add" type="button" data-rp="<%= $webauthn_rp || '' %>"<% if (!$passkey_person || !length($webauthn_rp || '')) { %> disabled<% } %>>Add a passkey</button>
			<% } %>
			<button id="passkey_open_browser" type="button"<% if (!$passkey_person || !length($webauthn_rp || '')) { %> disabled<% } %>>Open in browser</button>
			<span id="passkey_status" style="font-size:14px;margin-left:8px;"></span>
		</div>
		<p style="font-size:13px;color:#777;max-width:640px;">
			<b>Open in browser</b> is the reliable way: it makes a five-minute, single-use link and opens it on the
			house name, where the authenticator prompt can run.
			<% if ($on_house_name) { %>
				<b>Add a passkey</b> makes one right here, in this window.
			<% } else { %>
				<b>Add a passkey</b> is not offered here because this window is on <%= $window_host || 'an address' %>,
				not the house name - a passkey can only be made on a page under the house domain.
			<% } %>
			Removing a passkey here only forgets it in the house; the key stays in the device until you delete it there.
			A passkey proves who you are, not what you may do - privileges still come from the person.
		</p>
	</div>

