% my $signatorial = &subs::signatorial_designer();
% my $navigation_information = &subs::navigation_information({ cache => 'yes', signatorial => $signatorial });
% my $lockdown = &subs::lockdown_active() ? 1 : 0;
%# What this machine can do beyond leaving: the Leave dialog renders a button
%# for each, while Exit is always there. A phone's app cannot power the phone,
%# and a machine without systemd/logind has nothing to ask.
% my @leave_power = &subs::power_actions();
<style>
#start_menu.lockdown .start_menu_header,
#start_menu.lockdown .start_menu_pages,
#start_menu.lockdown .start_menu_categories,
#start_menu.lockdown .start_menu_footer,
#start_menu.lockdown .start_menu_group_label,
#start_menu.lockdown .start_menu_empty,
#start_menu.lockdown .start_menu_view_content,
#start_menu.lockdown #running_start,
#start_menu.lockdown .site_type_manual_changer_options { display:none !important; }
#start_menu.lockdown .start_menu_main_display > *:not(.start_menu_lockdown_note):not(.start_menu_recent_group):not(.start_menu_all_group):not(.start_menu_lockdown_keep) { display:none !important; }
#start_menu.lockdown .start_menu_item:not(.start_menu_lockdown_keep) { display:none !important; }
#start_menu.lockdown .start_menu_lockdown_note { display:block !important; }
</style>
<div id="start_menu" class="theme_surface<% if ($lockdown) { %> lockdown<% } %>" role="dialog"
     aria-label="<%= &subs::ui('Start menu') %>"
     data-forget-label="<%= &subs::lang('start_menu.forget') %>"
     style="display:none;max-width:100%;overflow:hidden;background-color:<%= &subs::theme_surface_colour('start_menu', $device) || 'var(--panel)' %>;">

	<div class="start_menu_header">
		<span class="start_menu_title"><%= &subs::lang('start_menu.start') %></span>
		<span class="start_menu_search_slot"></span>
		<%# The search bar searches the house on every page, like the global search
		    box; the category chips below narrow the catalogue. The global search
		    replaces it when its own home is the menu. %>
		<input type="search" id="start_menu_filter" class="start_menu_filter"
		       placeholder="<%= &subs::lang('start_menu.search_apps') %>"
		       aria-label="<%= &subs::lang('start_menu.search_apps') %>"
		       autocomplete="off" spellcheck="false">
		<%# Configure holds the header's right edge on every page. %>
		<img id="main_logo" class="jonathan little_thumb configuration"
		     src="<%= &subs::icon_for('/images/decipherable/wrench.png') %>" hint="Configure" alt="">
	</div>

	<% my %page_icon = (
		app  => &subs::icon_for('/images/jbuttons/logo3.png'),
		run  => &subs::icon_for('/images/make believe/new sun.png'),
		up   => &subs::icon_for('/images/make believe/road ahead.png'),
		exp  => &subs::icon_for('/images/make believe/nonsense.png'),
		view => &subs::icon_for('/images/make believe/water.png')
	); %>
	<% my %page_label = (
		app  => &subs::lang('search.apps'),
		run  => &subs::lang('running'),
		up   => &subs::lang('start_menu.upcoming'),
		exp  => &subs::lang('start_menu.expiring'),
		view => &subs::lang('configure.follow_system')
	); %>
	<div class="start_menu_pages" role="tablist" aria-label="<%= &subs::ui('Start menu pages') %>">
		<% foreach my $b ( qw/app run up exp view/ ) { %>
			<button type="button" class="start_menu_menu<% if ($menu eq $b) { %> selected<% } %>"
			        menu="<%= $b %>" role="tab"
			        aria-selected="<%= $menu eq $b ? 'true' : 'false' %>"
			        hint="<%= $page_label{$b} %>">
				<img class="start_menu_page_glyph" src="<%= $page_icon{$b} %>" alt="" aria-hidden="true">
				<span class="start_menu_page_text"><%= $page_label{$b} %></span>
			</button>
		<% } %>
	</div>

	<div class="start_menu_body">
		<% if ($menu eq 'view') { %>
			<span class="start_menu_view_content">
			<!--
			<img src="<%= &subs::icon_for('/images/make believe/eye.png') %>" hint="Webcam" id="browser_toggle" style="border-color: yellow" class="little_thumb jonathan"></img>
			-->
			<%= include 'start_menu/htop', cache => &subs::cache_get({ app => '__president', context => 'htop', subcontext => 'current' }), levels => &subs::levels_snapshot() %>

			<div id="parking_lot" style="width:100%;margin-top:10px;">
				<% foreach my $pl ( sort keys %{$parking_lot} ) { %>
					<span class="past_life hover" direction="load" start_menu="yes" timestamp="<%= $parking_lot->{$pl}->{'timestamp'} %>"><h4><%= &subs::format_name($pl) %></h4></span>
				<% } %>
			</div>
			</span>
		<% } elsif ($menu eq 'app') { %>
			<%# the shelf icons the category rail wears: media keeps the photo the
			    social construct already has, the other four were added to the sets %>
			<% my $category_icons = {
				accessories => '/images/decipherable/calculator.png',
				business => '/images/decipherable/cash.png',
				games => '/images/decipherable/tetris.png',
				media => '/images/make believe/music.png',
				system => '/images/decipherable/gear.png'
			}; %>
			<%# the menu is fetched with the list; the pre-rendered include carries no
			    recent key, so it is read from the stash rather than a bare name %>
			<% my $recent = $c->stash('recent') || []; %>
			<div class="start_menu_app_menu">
				<div class="start_menu_categories" role="tablist" aria-label="<%= &subs::ui('App categories') %>">
					<button type="button" class="start_menu_category selected" category="all"
					        role="tab" aria-selected="true" hint="<%= &subs::lang('start_menu.all') %>">
						<img class="start_menu_cat_glyph" src="<%= &subs::icon_for('/images/jbuttons/logo3.png') %>" alt="" aria-hidden="true">
						<span class="start_menu_cat_text"><%= &subs::lang('start_menu.all') %></span>
					</button>
					<% foreach my $category ( sort keys %{$category_icons} ) { %>
						<button type="button" class="start_menu_category" category="<%= $category %>"
						        role="tab" aria-selected="false" hint="<%= &subs::format_name($category) %>">
							<img class="start_menu_cat_glyph" src="<%= &subs::icon_path($category, $category_icons->{$category}) %>" alt="" aria-hidden="true">
							<span class="start_menu_cat_text"><%= &subs::format_name($category) %></span>
						</button>
					<% } %>
				</div>
				<div class="start_menu_main_display" recent="<%= join ',', @{$recent} %>" hidden_apps="<%= join '|', @{$hidden_apps || []} %>">
					<div class="start_menu_lockdown_note" style="display:none;padding:18px;line-height:1.5;max-width:520px;">
						<h2><%= &subs::ui('Lockdown') %></h2>
						<p><%= &subs::ui('An enemy is present, or this is a dangerous place. Only Security and apps marked Dangerous stay open. Open Security for the way out.') %></p>
					</div>

					<div class="start_menu_recent_group">
						<div class="start_menu_group_label start_menu_recent_label"><%= &subs::lang('chat.recent') %></div>
					</div>

					<div class="start_menu_all_group">
						<div class="start_menu_group_label start_menu_all_label"><%= &subs::lang('start_menu.all_apps') %></div>
					</div>

					<div class="start_menu_empty" style="display:none;"><%= &subs::lang('start_menu.no_matches') %></div>

					<img class="jonathan" category="system" src="<%= &subs::icon_for('/images/make believe/web_button.png') %>" hint="<%= &subs::lang('internet') %>" id="internet_toggle"></img>
					<img class="jonathan" category="system" src="<%= &subs::icon_for('/images/make believe/search_button.png') %>" hint="<%= &subs::lang('common.search') %>" id="search_app_toggle"></img>
					<img class="jonathan" category="system" src="<%= &subs::icon_for('/images/decipherable/folder.png') %>" hint="Folders" id="folders_toggle"></img>
				<img class="jonathan" category="business" src="<%= &subs::icon_for('/images/decipherable/chart.png') %>" hint="<%= &subs::lang('accounting') %>" id="budget"></img>
				<img id="travel_toggle" category="business" src="<%= &subs::icon_for('/images/decipherable/aeroplane.png') %>" hint="Travel" class="jonathan gps"></img>
				<img id="relational_toggle" category="business" src="<%= &subs::icon_for('/images/make believe/strawbeery.png') %>" hint="<%= &subs::ui('Relational') %>" class="jonathan relational">
				<img id="people_toggle" category="business" src="<%= &subs::icon_for('/images/make believe/people.png') %>" hint="<%= &subs::lang('people') %>" class="jonathan people">
				<img id="mailbox_toggle" category="business" src="<%= &subs::icon_for('/images/make believe/mailbox.png') %>" hint="Mailbox" class="jonathan mail">
								<img id="email_toggle" category="business" src="<%= &subs::icon_for('/images/decipherable/envelope.png') %>" hint="Email" class="jonathan email">
								<img id="chat_toggle" category="business" src="<%= &subs::icon_for('/images/make believe/phone_sms.png') %>" hint="Chat" class="jonathan chat">
				<br>


				<img id="music_toggle" category="media" src="<%= &subs::icon_for('/images/make believe/music.png') %>" hint="Music" class="jonathan music"></img>
				<img id="embedded_toggle" category="system" src="<%= &subs::icon_for('/images/decipherable/microchip.png') %>" hint="Embedded" class="jonathan embedded"></img>
				<img id="controllers_toggle" category="games" src="<%= &subs::icon_for('/images/decipherable/computer.png') %>" hint="<%= &subs::ui('Controllers') %>" class="jonathan controllers"></img>
				<img id="ticketmaker" class="jonathan little_thumb" category="business" src="<%= &subs::icon_for('/images/decipherable/ticket.png') %>" hint="Passes">
				<img id="cards_toggle" category="games" src="<%= &subs::icon_for('/images/decipherable/cards.png') %>" hint="Cards" class="jonathan cards">
				<br>
				<img class="jonathan" id="backup_now" category="system" src="<%= &subs::icon_for('/images/decipherable/diskette.png') %>" hint="Backup now" ></img>
				<img id="security_toggle" category="system" src="<%= &subs::icon_for('/images/make believe/badge.png') %>" hint="Security" class="jonathan security"></img>
				<img id="notifications_toggle" category="system" src="<%= &subs::icon_for('/images/decipherable/bell.png') %>" hint="<%= &subs::ui('Notifications') %>" class="jonathan"></img>
				<img id="terminal_toggle" category="system" src="<%= &subs::icon_for('/images/decipherable/code.png') %>" hint="Terminal" class="jonathan terminal"></img>
				<img id="network_toggle" category="system" src="<%= &subs::icon_for('/images/decipherable/server.png') %>" hint="<%= &subs::lang('network') %>" class="jonathan network"></img>
				<img id="ide_toggle" class="jonathan ide" category="system" src="<%= &subs::icon_for('/images/make believe/monitor.png') %>" hint="IDE"></img>
				<img class="jonathan little_thumb" id="upload" category="accessories" src="<%= &subs::icon_for('/images/make believe/up.png') %>" hint="Upload" />
				<br>
				<img id="image_toggle" category="media" src="<%= &subs::icon_for('/images/decipherable/gallery.png') %>" hint="Gallery" class="jonathan gallery"></img>
				<img id="camera_toggle" category="media" src="<%= &subs::icon_for('/images/decipherable/camera back.png') %>" hint="Camera" class="jonathan camera"></img>
				<img id="scan_toggle" category="business" src="<%= &subs::icon_for('/images/decipherable/file.png') %>" hint="<%= &subs::ui('Scan') %>" class="jonathan scan"></img>
				<img id="phone_toggle" category="business" src="<%= &subs::icon_for('/images/decipherable/phone.png') %>" hint="Phone" class="jonathan phone"></img>
				<img id="synth_toggle" category="media" src="<%= &subs::icon_for('/images/decipherable/piano.png') %>" hint="Synth" class="jonathan synth"></img>
				<img id="editor_toggle" category="business" src="<%= &subs::icon_for('/images/decipherable/love letter.png') %>" hint="Editor" class="jonathan editor"></img>
				<img id="marker_toggle" class="jonathan marker" category="media" src="<%= &subs::icon_for('/images/decipherable/marker.png') %>" hint="Marker"></img>
				<img id="notes_toggle" class="jonathan notes" category="accessories" src="<%= &subs::icon_for('/images/decipherable/list.png') %>" hint="Notes"></img>
				<img id="clock_toggle" class="jonathan clock" category="accessories" src="<%= &subs::icon_for('/icons/clock.svg') %>" hint="<%= &subs::lang('clock') %>"></img>
				<img id="power_toggle" class="jonathan power" category="system" src="<%= &subs::icon_path('logo2', '/icons/power.svg') %>" hint="<%= &subs::lang('power') %>"></img>
				<img id="sound_toggle" class="jonathan sound" category="system" src="<%= &subs::icon_path('speaker', '/icons/sound.svg') %>" hint="<%= &subs::lang('sound') %>"></img>
				<img id="packages_toggle" class="jonathan packages" category="system" src="<%= &subs::icon_for('/images/decipherable/diskette.png') %>" hint="<%= &subs::ui('Packages') %>"></img>
				<img id="keyboard_toggle" class="jonathan" category="accessories" src="<%= &subs::icon_for('/images/decipherable/keyboard.png') %>" hint="<%= &subs::lang('keyboard') %>"></img>
				<img id="calculator_toggle" class="jonathan" category="accessories" src="<%= &subs::icon_for('/images/decipherable/calculator.png') %>" hint="<%= &subs::ui('Calculator') %>"></img>
				<img id="weather_toggle" class="jonathan weather" category="system" src="<%= &subs::icon_for($gb::known_appts->{'weather'}->{'icon'}) %>" hint="<%= &subs::ui('Weather') %>"></img>

				<br>

				<img class="jonathan" category="system" src="<%= &subs::icon_for('/images/decipherable/stop sign.png') %>" hint="Stop all" id="stop_all"></img>
				<img id="twirl_toggle" class="jonathan twirl" category="games" src="<%= &subs::icon_for('/images/decipherable/tetris.png') %>" hint="Twirl"></img>
				<img id="pipedream_toggle" class="jonathan pipedream" category="games" src="<%= &subs::icon_for('/images/decipherable/tunnel.png') %>" hint="Pipedream"></img>
				<img id="minesweeper_toggle" class="jonathan minesweeper" category="games" src="<%= &subs::icon_for('/images/decipherable/marker.png') %>" hint="Minesweeper"></img>
				<%# One row per DOS card the browser can run. A desk and a phone have no
				    DOSBox, so the card opens the same game in js-dos; the handheld
				    keeps its native shelf and does not get a second launcher. %>
				<% foreach my $dos_game (@{ $dos_games || [] }) { %>
					<img class="jonathan dos_game_toggle" category="games" loading="lazy" decoding="async" id="dos_game_<%= $dos_game->{'id'} %>" data-game="<%= $dos_game->{'id'} %>" hint="<%= $dos_game->{'title'} %>" src="<%= $dos_game->{'art'} ? '/manager/games/art?id=' . $dos_game->{'id'} : &subs::icon_for('/images/decipherable/diskette.png') %>">
				<% } %>
				<img id="studio_toggle" category="media" src="<%= &subs::icon_for('/images/decipherable/mixer.png') %>" hint="Studio" class="jonathan mixer"></img>
				<img class="handbook medium_thumb jonathan" id="handbook_toggle" category="business" src="<%= &subs::icon_for('/images/decipherable/handbook.png') %>" hint="Handbook">
				<img class="jonathan medium_thumb" id="help_toggle" category="system" src="<%= &subs::icon_for('/images/decipherable/question mark.png') %>" hint="Help">
				<img class="home medium_thumb jonathan" id="home_toggle" category="system" hint="Home" src="<%= &subs::icon_for($gb::known_appts->{'guest'}->{'icon'}) %>">
				<br>

				<% if ($device eq 'mobile') { %>
					<img class="little_thumb hover nfc_benign_reader" category="accessories" src="<%= &subs::icon_for('/images/make believe/water.png') %>" hint="Scan NFC">

					<img class="jonathan torch_toggle" category="accessories" src="<%= &subs::icon_for('/images/decipherable/nightlight.png') %>" hint="Torch"></img>
					<img class="jonathan" category="accessories" src="<%= &subs::icon_for('/images/make believe/phone_sms.png') %>" hint="SMS" id="sms_list_check"></img>
				<% } %>
				<img style="" class="little_thumb permission_asker hover jonathan" category="accessories" src="<%= &subs::icon_for('/images/make believe/good.png') %>" hint="Permissions">
				<br>
				<img class="medium_thumb jonathan" id="store_toggle" category="business" hint="Store" src="<%= &subs::icon_for($gb::known_appts->{'resident'}->{'icon'}) %>">
				<img class="jonathan measures_toggle" category="accessories" src="<%= &subs::icon_for('/images/decipherable/measures.png') %>" hint="Measures">
				<img id="market_toggle" class="jonathan market_toggle" category="business" src="<%= &subs::icon_for('/icons/pos/vendor.png') %>" hint="Market">
				<img class="jonathan warehouse_toggle" category="business" src="<%= &subs::icon_for('/icons/pos/manufacturer.png') %>" hint="Warehouse">
					<img class="jonathan process_monitor_toggle" category="system" src="<%= &subs::icon_for($gb::known_appts->{'process_monitor'}->{'icon'}) %>" hint="Process Monitor">
				<div class="nfc_read_status" style="width:100%;"></div>
				<script>
					var search = $('#search').val();
					$('.take_on_me').each(function(i,v) {
						console.log(v);
						var link = $(v).attr('href');
						var route = link.split('?');

						var route = route[0] + '?search=' + search
						console.log(route);
						$(v).attr('href', route);
					});
					</script>

				</div>
			</div>

			<% if ($navigation_information->{$signatorial}->{'site_rating'} < 10) { %>
				<div class="site_type_manual_changer_options" style="float:right;display:none;">
					<button site="reset" class="hover site_type_manual_changer">
						Reset
					</button><br>
					<% foreach my $site ( sort { $gb::site_types->{$a}->{'rating'} <=> $gb::site_types->{$b}->{'rating'} } keys %{$gb::site_types} ) { %>
						<% if ($gb::site_types->{$site}->{'rating'} && $navigation_information->{$signatorial}->{'site_rating'} <= $gb::site_types->{$site}->{'rating'}) { %>
							<span site="<%= $site %>" class="hover site_type_manual_changer">
								<img class="little_thumb" hint="Set site type" src="<%= &subs::icon_for($gb::site_types->{$site}->{'icon'}) %>" style=""></img>
								<%= &subs::format_name($site) %>
								<%= $gb::site_types->{$site}->{'rating'} %>
							</span><br>
						<% } %>
					<% } %>
				</div>
			<% } %>

		<% } elsif ($menu eq 'run' || $menu eq 'up' || $menu eq 'exp') { %>

			<div id="running_start">
				<table style="overflow:scroll;width:100%;text-align:left;">
					<thead>
						<th></th><th>App</th><th>Time</th>
					</thead>
					<tbody>
						<% my $query; 
						if ($menu eq 'run') {
							$query = &subs::db_query('select * from appointments where (type=? or type=?) and stop_seen is null and timestamp <= ? order by timestamp desc', 'start','record', &subs::rightNow())->hashes;
						} elsif ($menu eq 'exp') {
							$query = &subs::db_query('select * from appointments where cast(warranty as integer) >= cast(? as integer) order by cast(warranty as integer) asc limit 20', &subs::rightNow())->hashes;
						} else { 
							# A daily measurement (the moon, space weather, the magnetometer)
							# is a reading, not an event: it belongs in the charts, not in a
							# list of things still to come. Keeping `measure` out also stops a
							# row dated later today from appearing as a future appointment.
							$query = &subs::db_query("select * from appointments where timestamp >= ? and coalesce(type, '') <> 'measure' order by timestamp asc limit 20", &subs::rightNow())->hashes;
						} %>
						<% my $private_open = &subs::private_reachable_now() && &subs::private_revealed(); %>
						<% foreach my $app ( grep { !&subs::app_hidden_now($_->{'app'}) && (!&subs::appointment_private_now($_) || $private_open) } @{$query} ) { %>
							<tr>
								<td><%== &subs::main_icon_maker({ app => $app->{'app'}, timestamp => &subs::rightNow(), size => 'little' }) %></td>
								<td>
									<span class="start_menu_list hover title_font" style="font-size:20px;" onClick="appointmentGrabber('<%= $app->{'app'} %>','<%= &subs::rightNow() %>')">
										<%= &subs::format_name($app->{'app'}) %>
									</span>
								</td>
								<td class="time" timestamp="<%= $menu eq 'exp' ? $app->{'warranty'} : $app->{'timestamp'} %>"></td>
							</tr>
						<% } %>
					</tbody>
				</table>
			</div>
		<% } %>
	</div>

	<div class="start_menu_footer">
		<button type="button" class="start_menu_foot start_menu_leave_button"
		        aria-label="<%= &subs::lang('power_leave') %>">
			<img class="jonathan little_thumb leave" src="<%= &subs::icon_for('/images/decipherable/exit.png') %>" hint="<%= &subs::lang('power_leave') %>" power="<%= join ',', @leave_power %>" alt="">
			<span class="start_menu_foot_label"><%= &subs::lang('power_leave') %></span>
		</button>

		<button type="button" class="start_menu_foot start_menu_site_button"
		        aria-label="<%= &subs::lang('start_menu.site_type') %>">
			<img id="site_type_toggle" class="little_thumb <% if ($navigation_information->{$signatorial}->{'site_rating'} < 10) { %>hover site_type_manual_changer_toggle <% } %>" hint="<%= &subs::lang('start_menu.site_type') %>"
				src="<%= &subs::icon_for($gb::site_types->{$navigation_information->{$signatorial}->{'site_type'}}->{'icon'}) %>"
				style="<% if ($navigation_information->{$signatorial}->{'site_source'} eq 'manual') { %>border-solid;border-color:red;border-width:8px;
				<% } elsif ($navigation_information->{$signatorial}->{'site_source'} eq 'lost') { %>border-solid;border-color:black;border-width:8px;
				<% } %>" alt="">
			<span class="start_menu_foot_label"><%= &subs::lang('start_menu.site_type') %></span>
		</button>

		<button type="button" class="start_menu_foot start_menu_more"
		        aria-haspopup="menu" aria-expanded="false" aria-controls="start_menu_more_menu">
			<span class="start_menu_more_glyph" aria-hidden="true">⋯</span>
			<span class="start_menu_foot_label"><%= &subs::lang('start_menu.more') %></span>
		</button>

		<div id="start_menu_more_menu" class="start_menu_more_menu" role="menu" hidden>
			<%# the now, assistant, navigation and bird buttons live under More now, off
			    the search's own row; they used to sit across the menu's top-left where a
			    reach for the search kept landing on the bird %>
			<% my $now_plain = &subs::icon_for('/images/decipherable/now.png'); %>
			<button type="button" class="start_menu_more_item" role="menuitem" aria-label="<%= &subs::ui('Now') %>">
				<img src="<%= &subs::icon_path('now here', $now_plain) %>" jawnos_icon="/images/decipherable/now.png" hint="Now" presence="unknown" id="now_toggle" class="little_thumb now jonathan start_menu_corner" alt="">
				<span class="start_menu_more_label"><%= &subs::ui('Now') %></span>
			</button>
			<button type="button" class="start_menu_more_item" role="menuitem" aria-label="<%= &subs::ui('Assistant') %>">
				<img src="<%= &subs::icon_for('/images/make believe/assistant.png') %>" jawnos_icon="/images/make believe/assistant.png" class="little_thumb assistant hover start_menu_corner" id="assistant" alt="">
				<span class="start_menu_more_label"><%= &subs::ui('Assistant') %></span>
			</button>
			<button type="button" class="start_menu_more_item" role="menuitem" aria-label="<%= &subs::ui('Navigation') %>">
				<img src="<%= &subs::icon_for('/images/make believe/gps.png') %>" jawnos_icon="/images/make believe/gps.png" hint="<%= &subs::lang('navigation.update') %>" class="little_thumb hover start_menu_corner" id="navigation_now" alt="">
				<span class="start_menu_more_label"><%= &subs::ui('Navigation') %></span>
			</button>
			<button type="button" class="start_menu_more_item" role="menuitem" aria-label="<%= &subs::ui('Bird') %>">
				<img class="jonathan little_thumb fuck_you start_menu_corner" hint="Flip the bird" src="<%= &subs::icon_for('/images/decipherable/the bird.png') %>" jawnos_icon="/images/decipherable/the bird.png" alt="">
				<span class="start_menu_more_label"><%= &subs::ui('Bird') %></span>
			</button>

			<%# The desktop app's embedded view shows this and nothing else does: it
			    asks the app to switch back to its dashboard tab. A browser tab has
			    no such place, so the icon stays hidden there (see manager.css). %>
			<div class="start_menu_admin_item">
				<button type="button" class="start_menu_more_item" role="menuitem" aria-label="<%= &subs::ui('Admin') %>">
					<img id="admin_console_toggle" class="jonathan little_thumb start_menu_corner" hint="Admin console" src="<%= &subs::icon_for('/images/decipherable/gear.png') %>" onclick="window.jawnosAdminConsole && jawnosAdminConsole()" alt="">
					<span class="start_menu_more_label"><%= &subs::ui('Admin') %></span>
				</button>
			</div>
		</div>
	</div>
</div>
