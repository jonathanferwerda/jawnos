% my $signatorial = &subs::signatorial_designer();
% my $navigation_information = &subs::navigation_information({ cache => 'yes', signatorial => $signatorial });
<div id="start_menu" style="display:none;max-width:100%;overflow:scroll;background-color:<%= $config->{$device}->{'start_menu'}->{'background_colour'} || 'yellow' %>;">
	<span style="float:right;width:20%;position:absolute;right:0px;top:0px;">

		<% my $images = {
			app => '/images/jbuttons/logo3.png',
			run => '/images/make believe/new sun.png',
			up => '/images/make believe/road ahead.png',
			exp => '/images/make believe/nonsense.png',
			view => '/images/make believe/water.png'
		}; %>



		<% my %menu_hints = ( app => 'Apps', run => 'Running', up => 'Upcoming', exp => 'Expiring', view => 'System' ); %>
		<% foreach my $b ( qw/app run up exp view/ ) { %>
			<img src="<%= &subs::icon_for($images->{$b}) %>" hint="<%= $menu_hints{$b} %>" class="medium_thumb start_menu_menu hover <% if ($menu eq $b) { %>selected<% } %>" menu="<%= $b %>">
		<% } %>
		<img id="main_logo" class="jonathan little_thumb configuration"  src="<%= &subs::icon_for('/images/decipherable/wrench.png') %>" hint="Configure"></img>

		<!--

			<a target="_blank" class="take_on_me" href="https://<%= $c->req->url->base->host . ':' . $ENV{'PORT_AHOY'} %>/"><img class="jonathan" src="<%= $gb::known_appts->{'guest'}->{'icon'} %>"></a>
			<a target="_blank" class="take_on_me" href="https://<%= $c->req->url->base->host . ':' . $ENV{'PORT_AHOY'} %>/manager"><img class="jonathan" src="<%= $gb::known_appts->{'citizen'}->{'icon'} %>"></a>
			<a target="_blank" class="take_on_me" href="https://<%= $c->req->url->base->host . ':' . $ENV{'PORT_AHOY'} %>/store"><img class="jonathan" src="<%= $gb::known_appts->{'resident'}->{'icon'} %>"></a>
		-->
	</span>
	<span class="start_menu_body">
		<% if ($menu eq 'view') { %>
			<!--
			<img src="<%= &subs::icon_for('/images/make believe/eye.png') %>" hint="Webcam" id="browser_toggle" style="border-color: yellow" class="little_thumb jonathan"></img>
			-->
			<%= include 'start_menu/htop', cache => &subs::cache_get({ app => '__president', context => 'htop', subcontext => 'current' }) %>

			<div id="parking_lot" style="position:absolute;width:100%;bottom:0px;">
				<% foreach my $pl ( sort keys %{$parking_lot} ) { %>
					<span class="past_life hover" direction="load" start_menu="yes" timestamp="<%= $parking_lot->{$pl}->{'timestamp'} %>"><h4><%= &subs::format_name($pl) %></h4></span>
				<% } %>
			</div>
		<% } elsif ($menu eq 'app') { %>
			<%# the shelf icons the category rail wears: media keeps the photo the
			    social construct already has, the other four were added to the sets %>
			<% my $category_icons = {
				accessories => '/images/decipherable/calculator.png',
				business => '/images/decipherable/cash.png',
				games => '/images/decipherable/tetris.png',
				media => '/images/make believe/music.png',
				system => '/images/decipherable/gear.png'
			}; %>
			<%# the menu is fetched with the list; the pre-rendered include carries no
			    recent key, so it is read from the stash rather than a bare name %>
			<% my $recent = $c->stash('recent') || []; %>
			<span class="start_menu_app_menu">
				<span class="start_menu_categories">
					<% foreach my $category ( sort keys %{$category_icons} ) { %>
						<img class="start_menu_category hover" category="<%= $category %>" hint="<%= &subs::format_name($category) %>" src="<%= &subs::icon_path($category, $category_icons->{$category}) %>">
					<% } %>
				</span>
				<span class="start_menu_main_display" recent="<%= join ',', @{$recent} %>">
					<%# the app menu is the recent list; until a press fills it, the note
					    stands where the rows will - startMenuView() toggles it %>
					<span class="start_menu_empty" style="display:none;">No recent apps yet - the ones you open from here land here</span>
					<img class="jonathan" category="system" src="<%= &subs::icon_for('/images/decipherable/folder.png') %>" hint="Folders" id="folders_toggle"></img>
				<img class="jonathan" category="business" src="<%= &subs::icon_for('/images/decipherable/chart.png') %>" hint="Budget" id="budget"></img>
				<img id="travel_toggle" category="business" src="<%= &subs::icon_for('/images/decipherable/aeroplane.png') %>" hint="Travel" class="jonathan gps"></img>
				<img id="relational_toggle" category="business" src="<%= &subs::icon_for('/images/make believe/strawbeery.png') %>" hint="Contacts" class="jonathan relational">
				<img id="mailbox_toggle" category="business" src="<%= &subs::icon_for('/images/decipherable/envelope.png') %>" hint="Mailbox" class="jonathan mail">
				<br>


				<img id="music_toggle" category="media" src="<%= &subs::icon_for('/images/make believe/music.png') %>" hint="Music" class="jonathan music"></img>
				<img id="embedded_toggle" category="system" src="<%= &subs::icon_for('/images/decipherable/microchip.png') %>" hint="Embedded" class="jonathan embedded"></img>
				<span><img id="ticketmaker" class="jonathan little_thumb" category="business" src="<%= &subs::icon_for('/images/decipherable/ticket.png') %>" hint="Tickets"></span>
				<img id="cards_toggle" category="games" src="<%= &subs::icon_for('/images/decipherable/cards.png') %>" hint="Cards" class="jonathan cards">
				<img class="jonathan" category="media" src="<%= &subs::icon_for('/images/make believe/web_button.png') %>" hint="Web" id="web_toggle"></img>
				<br>
				<img class="jonathan" id="backup_now" category="system" src="<%= &subs::icon_for('/images/decipherable/diskette.png') %>" hint="Backup now" ></img>
				<img id="security_toggle" category="system" src="<%= &subs::icon_for('/images/make believe/badge.png') %>" hint="Security" class="jonathan security"></img>
				<img id="terminal_toggle" category="system" src="<%= &subs::icon_for('/images/decipherable/code.png') %>" hint="Terminal" class="jonathan terminal"></img>
				<img id="ide_toggle" class="jonathan ide" category="system" src="<%= &subs::icon_for('/images/make believe/monitor.png') %>" hint="IDE"></img>
				<img class="jonathan little_thumb" id="upload" category="accessories" src="<%= &subs::icon_for('/images/make believe/up.png') %>" hint="Upload" />
				<br>
				<img id="image_toggle" category="media" src="<%= &subs::icon_for('/images/decipherable/gallery.png') %>" hint="Gallery" class="jonathan gallery"></img>
				<img id="synth_toggle" category="media" src="<%= &subs::icon_for('/images/decipherable/piano.png') %>" hint="Synth" class="jonathan synth"></img>
				<img id="editor_toggle" category="business" src="<%= &subs::icon_for('/images/decipherable/love letter.png') %>" hint="Editor" class="jonathan editor"></img>
				<img id="marker_toggle" class="jonathan marker" category="media" src="<%= &subs::icon_for('/images/decipherable/marker.png') %>" hint="Marker"></img>

				<br>

				<img class="jonathan" category="system" src="<%= &subs::icon_for('/images/decipherable/stop sign.png') %>" hint="Stop all" id="stop_all"></img>
				<img id="twirl_toggle" class="jonathan twirl" category="games" src="<%= &subs::icon_for('/images/decipherable/tetris.png') %>" hint="Twirl"></img>
				<img id="studio_toggle" category="media" src="<%= &subs::icon_for('/images/decipherable/mixer.png') %>" hint="Studio" class="jonathan mixer"></img>
				<img class="handbook medium_thumb jonathan" id="handbook_toggle" category="business" src="<%= &subs::icon_for('/images/decipherable/handbook.png') %>" hint="Handbook">
				<img class="home medium_thumb jonathan" id="home_toggle" category="system" hint="Home" src="<%= &subs::icon_for($gb::known_appts->{'guest'}->{'icon'}) %>">
				<br>

				<img class="voice_prompt medium_thumb jonathan" category="accessories" src="<%= &subs::icon_for('/images/decipherable/speech to text.png') %>" hint="Voice prompt" />
		
				<% if ($device eq 'mobile') { %>
					<img class="little_thumb hover nfc_benign_reader" category="accessories" src="<%= &subs::icon_for('/images/make believe/water.png') %>" hint="Scan NFC">

					<img class="jonathan torch_toggle" category="accessories" src="<%= &subs::icon_for('/images/decipherable/nightlight.png') %>" hint="Torch"></img>
					<img class="jonathan" category="accessories" src="<%= &subs::icon_for('/images/make believe/phone_sms.png') %>" hint="SMS" id="sms_list_check"></img>
				<% } %>
				<img style="" class="little_thumb permission_asker hover jonathan" category="accessories" src="<%= &subs::icon_for('/images/make believe/good.png') %>" hint="Permissions">
				<br>
				<img class="medium_thumb jonathan" id="store_toggle" category="business" hint="Store" src="<%= &subs::icon_for($gb::known_appts->{'resident'}->{'icon'}) %>">
				<img class="jonathan measures_toggle" category="accessories" src="<%= &subs::icon_for('/images/decipherable/measures.png') %>" hint="Measures">
				<img class="jonathan market_toggle" category="business" src="<%= &subs::icon_for('/icons/pos/vendor.png') %>" hint="Market">
				<img class="jonathan warehouse_toggle" category="business" src="<%= &subs::icon_for('/icons/pos/manufacturer.png') %>" hint="Warehouse">
				<div class="nfc_read_status" style="width:100%;"></div>
				<script>
					var search = $('#search').val();
					$('.take_on_me').each(function(i,v) {
						console.log(v);
						var link = $(v).attr('href');
						var route = link.split('?');

						var route = route[0] + '?search=' + search
						console.log(route);
						$(v).attr('href', route);
					});
					</script>

				</span>
			</span>
			<img class="jonathan little_thumb leave" src="<%= &subs::icon_for('/images/decipherable/exit.png') %>" hint="Leave" style="position:absolute;top:0px;left:0px;"></img>
			<img class="little_thumb <% if ($navigation_information->{$signatorial}->{'site_rating'} < 10) { %>hover site_type_manual_changer_toggle <% } %>" hint="Site type" 
				src="<%= &subs::icon_for($gb::site_types->{$navigation_information->{$signatorial}->{'site_type'}}->{'icon'}) %>" hint="Site type" style="position:absolute;top:0px;left:44px;
				<% if ($navigation_information->{$signatorial}->{'site_source'} eq 'manual') { %>border-solid;border-color:red;border-width:8px;
				<% } elsif ($navigation_information->{$signatorial}->{'site_source'} eq 'lost') { %>border-solid;border-color:black;border-width:8px;
				<% } %>"></img>

			<% if ($navigation_information->{$signatorial}->{'site_rating'} < 10) { %>
				<div class="site_type_manual_changer_options" style="float:right;display:none;">
					<button site="reset" class="hover site_type_manual_changer">
						Reset
					</button><br>
					<% foreach my $site ( sort { $gb::site_types->{$a}->{'rating'} <=> $gb::site_types->{$b}->{'rating'} } keys %{$gb::site_types} ) { %>
						<% if ($gb::site_types->{$site}->{'rating'} && $navigation_information->{$signatorial}->{'site_rating'} <= $gb::site_types->{$site}->{'rating'}) { %>
							<span site="<%= $site %>" class="hover site_type_manual_changer">
								<img class="little_thumb" hint="Set site type" src="<%= &subs::icon_for($gb::site_types->{$site}->{'icon'}) %>" style=""></img>
								<%= &subs::format_name($site) %>
								<%= $gb::site_types->{$site}->{'rating'} %>
							</span><br>
						<% } %>
					<% } %>
				</div>
			<% } %>

		<% } elsif ($menu eq 'run' || $menu eq 'up' || $menu eq 'exp') { %>

			<div id="running_start">
				<table style="overflow:scroll;width:100%;text-align:left;">
					<thead>
						<th></th><th>App</th><th>Time</th>
					</thead>
					<tbody>
						<% my $query; 
						if ($menu eq 'run') {
							$query = &subs::db_query('select * from appointments where (type=? or type=?) and timestamp <= ? order by timestamp desc', 'start','record', &subs::rightNow())->hashes;
						} elsif ($menu eq 'exp') {
							$query = &subs::db_query('select * from appointments where warranty >= ? order by warranty asc limit 20', &subs::rightNow())->hashes;
						} else { 
							$query = &subs::db_query('select * from appointments where timestamp >= ? order by timestamp asc limit 20', &subs::rightNow())->hashes;
						} %>
						<% foreach my $app ( @{$query} ) { %>
							<tr>
								<td><%== &subs::main_icon_maker({ app => $app->{'app'}, timestamp => &subs::rightNow(), size => 'little' }) %></td>
								<td>
									<span class="start_menu_list hover title_font" style="font-size:20px;" onClick="appointmentGrabber('<%= $app->{'app'} %>','<%= &subs::rightNow() %>')">
										<%= &subs::format_name($app->{'app'}) %>
									</span>
								</td>
								<td class="time" timestamp="<%= $menu eq 'exp' ? $app->{'warranty'} : $app->{'timestamp'} %>"></td>
							</tr>
						<% } %>
					</tbody>
				</table>
			</div>
		<% } %>
	</span>
</div>