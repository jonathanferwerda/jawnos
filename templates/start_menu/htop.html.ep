<div id="htop_viewer">

	<h4 style="float:left;">System <span class="htop_view time" view="timestamp" timestamp="<%= $cache->{'current'}->{'timestamp'} %>"></span>
		<span class="jawn_version" style="margin-left:8px;opacity:0.6;font-weight:normal;">v<%= &subs::jawn_version() %></span>

		<button class="president_restart_trigger" style="">Restart</button>
		<button class="president_restart_trigger" restart="yes" style="">ReRestart</button>
	</h4>
	<%# The CPU rows that used to live here measured the utility worker's own
	    time, not the machine's, so they were removed. PPS and PPM divided one
	    sample by one interval; PPH is the only rate worth showing, and it is a
	    least-squares slope over the discharging samples in the last hour. %>
	<% my $battery = $cache->{'current'}->{'battery'} || {}; %>
	<% if ($battery->{'percentage'}) { %>
		<h4 style="float:left;">Battery</h4>
		<table style="width:100%;">
			<thead><th>%</th><th>State</th><th>Health</th><th>Temp</th><th>Voltage</th><th>Current</th><th title="percentage points per hour while discharging">PPH</th></thead>
			<tbody>
				<tr>
					<td><%= $battery->{'percentage'} %>%</td>
					<td><%= &subs::format_name($battery->{'status'} || '') %></td>
					<td><%= &subs::format_name($battery->{'health'} || '') %></td>
					<td><%= defined $battery->{'temperature'} ? sprintf('%.1f', $battery->{'temperature'}) : '&mdash;' %><%= ($battery->{'temperature_source'} || '') eq 'cpu' ? ' (cpu)' : '' %></td>
					<td><%= defined $battery->{'voltage'} ? sprintf('%.3f V', $battery->{'voltage'}) : '&mdash;' %></td>
					<td><%= defined $battery->{'current'} ? sprintf('%.0f mA', $battery->{'current'}) : '&mdash;' %></td>
					<td title="<%= defined $battery->{'pph_window'} ? sprintf('over %.0f min from %d samples', $battery->{'pph_window'} * 60, $battery->{'pph_points'} || 0) : 'needs a discharging window of at least 5 minutes' %>"><%= defined $battery->{'pph'} ? sprintf('%.2f %%/h', $battery->{'pph'}) : '&mdash;' %></td>
				</tr>
			</tbody>
		</table>
	<% } %>

</div>
