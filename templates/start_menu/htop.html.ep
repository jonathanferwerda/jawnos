<div id="htop_viewer">

	<h4 style="float:left;">System <span class="htop_view time" view="timestamp" timestamp="<%= $cache->{'current'}->{'timestamp'} %>"></span>

		<button class="president_restart_trigger" style="">Restart</button>
		<button class="president_restart_trigger" restart="yes" style="">ReRestart</button>
	</h4>
	<%# the CPU rows that used to live here measured the utility worker's own
	    time, not the machine's, so they were removed; the battery readout stays %>
	<% if ($cache->{'current'}->{'battery'}) { %>
		<h4 style="float:left;">Battery</h4>
		<table style="width:100%;">
			<thead><th>Scope</th><th>%</th><th>Power</th><th>Temp</th><th>PPS</th><th>PPM</th><th>PPH</th></thead>
			<tbody>
				<% foreach my $scope ( qw/current average/ ) { %>
					<tr>
						<td><%= &subs::format_name($scope) %></td>
						<td><%= $cache->{$scope}->{'battery'}->{'percentage'} %></td>
						<td><%= $cache->{$scope}->{'battery'}->{'power'} %></td>
						<td><%= $cache->{$scope}->{'battery'}->{'temperature'} %></td>
						<td><%= $cache->{$scope}->{'battery'}->{'pps'} %></td>
						<td><%= $cache->{$scope}->{'battery'}->{'ppm'} %></td>
						<td><%= $cache->{$scope}->{'battery'}->{'pph'} %></td>
					</tr>
				<% } %>
			</tbody>
		</table>
	<% } %>

</div>
