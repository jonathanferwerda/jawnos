<% my $when = sub {
	my $at = shift || 0;
	return 'not yet' unless $at;
	my $age = int((&subs::rightNow() - $at) / 1000);
	return 'just now' if $age < 60;
	return int($age / 60) . 'm ago' if $age < 3600;
	return int($age / 3600) . 'h ago';
}; %>
<% my $level_class = sub {
	my $p = shift;
	return 'level_ok' unless defined $p;
	return 'level_low' if $p < 20;
	return 'level_mid' if $p < 50;
	return 'level_ok';
}; %>
<% my $bar_width = sub {
	my $p = shift;
	$p = 0 unless defined $p && $p =~ /^-?\d+(?:\.\d+)?$/;
	$p = 0 if $p < 0;
	$p = 100 if $p > 100;
	return sprintf('%.0f', $p);
}; %>
<% my $usage_class = sub {
	my $p = shift;
	return '' unless defined $p;
	return 'usage_hot' if $p >= 80;
	return 'usage_mid' if $p >= 50;
	return 'usage_ok';
}; %>
<% my $usage_line = sub {
	my ($u) = @_;
	$u = {} unless ref $u eq 'HASH';
	my @bits;
	if (defined $u->{'cpu'}) {
		my $label = 'CPU ' . sprintf('%.0f%%', $u->{'cpu'});
		$label .= ' (JawnOS)' if ($u->{'cpu_scope'} || '') eq 'jawnos';
		push @bits, '<span class="' . $usage_class->($u->{'cpu'}) . '">' . $label . '</span>';
	}
	if (defined $u->{'mem'}) {
		push @bits, '<span class="' . $usage_class->($u->{'mem'}) . '">RAM ' . sprintf('%.0f%%', $u->{'mem'}) . '</span>';
	}
	return '' unless @bits;
	return '<div class="level_usage">' . join(' &middot; ', @bits) . '</div>';
}; %>
<% my $battery_meta = sub {
	my ($b) = @_;
	my @bits;
	my $state = &subs::format_name($b->{'status'} || '');
	push @bits, $state if $state ne '';
	push @bits, sprintf('%.1f&deg;', $b->{'temperature'}) if defined $b->{'temperature'};
	push @bits, sprintf('%.2f V', $b->{'voltage'}) if defined $b->{'voltage'};
	push @bits, sprintf('%.0f mA', $b->{'current'}) if defined $b->{'current'};
	push @bits, sprintf('%.2f %%/h', $b->{'pph'}) if defined $b->{'pph'};
	return join(' &middot; ', @bits);
}; %>
<% my $duration = sub {
	my $h = shift;
	return '—' unless defined $h && $h > 0;
	my $m = int($h * 60 + 0.5);
	return $m . 'm' if $m < 60;
	return int($m / 60) . 'h ' . ($m % 60) . 'm';
}; %>
<% my $eta_text = sub {
	my ($b) = @_;
	my $pct = $b->{'percentage'};
	return '' unless defined $pct;
	my $status = lc($b->{'status'} || '');
	return 'full' if $status eq 'full' || $pct >= 100;
	if ($status eq 'charging') {
		# The gauge's own energy/current reading answers at once; the slope is
		# the fallback for a pack that does not report one.
		if (defined $b->{'charge_eta'} && $b->{'charge_eta'} > 0 && $pct < 100) {
			return '~' . $duration->($b->{'charge_eta'}) . ' to full';
		}
		if (defined $b->{'charge_pph'} && $b->{'charge_pph'} > 0 && $pct < 100) {
			return '~' . $duration->((100 - $pct) / $b->{'charge_pph'}) . ' to full';
		}
		return 'charging';
	}
	if ($status eq 'discharging' || ($status eq '' && (defined $b->{'pph'} || defined $b->{'discharge_eta'}))) {
		if (defined $b->{'discharge_eta'} && $b->{'discharge_eta'} > 0 && $pct > 0) {
			return '~' . $duration->($b->{'discharge_eta'}) . ' left';
		}
		if (defined $b->{'pph'} && $b->{'pph'} > 0 && $pct > 0) {
			return '~' . $duration->($pct / $b->{'pph'}) . ' left';
		}
		return 'estimating';
	}
	return 'plugged in' if $status =~ /not[ _]charging/;
	return '';
}; %>
<% my @machines = @{ $levels->{'machines'} || [] }; %>
<% my @local = grep { $_->{'local'} } @machines; %>
<% my @peers = sort { ($a->{'hostname'} || '') cmp ($b->{'hostname'} || '') } grep { !$_->{'local'} } @machines; %>
<% my @devices = @{ $levels->{'devices'} || [] }; %>
<div id="htop_viewer">
	<div class="levels_head">
		<span>Levels</span>
		<span><%= $when->($levels->{'at'}) %></span>
	</div>
	<% foreach my $m ( @local ) { %>
		<% my $b = $m->{'battery'} || {}; %>
		<% my $pct = $b->{'percentage'}; %>
		<div class="level_tile level_you">
			<div class="level_top">
				<span class="level_name"><%= $m->{'hostname'} || 'this machine' %></span>
				<% if (defined $pct) { %><span class="level_pct <%= $level_class->($pct) %>"><%= sprintf('%.0f%%', $pct) %></span>
				<% } else { %><span class="level_pct level_mains">mains</span><% } %>
			</div>
			<div class="level_sub"><%= &subs::format_name($m->{'device'} || '') %> &middot; this machine &middot; v<%= $m->{'version'} || &subs::jawn_version() %></div>
			<% if (defined $pct) { %>
				<div class="level_bar"><i class="<%= $level_class->($pct) %>" style="width:<%= $bar_width->($pct) %>%"></i></div>
				<div class="level_meta"><%== $battery_meta->($b) %></div>
			<% } else { %>
				<div class="level_meta"><%= &subs::format_name($b->{'status'} || 'no battery') %></div>
			<% } %>
			<%== $usage_line->($m->{'usage'}) %>
			<% my $eta = $eta_text->($b); %>
			<% if ($eta ne '') { %><div class="level_eta"><%= $eta %></div><% } %>
		</div>
	<% } %>
	<div class="levels_caption">House</div>
	<% if (!@peers) { %>
		<div class="level_empty">No other machines reporting yet.</div>
	<% } %>
	<% foreach my $m ( @peers ) { %>
		<% my $b = $m->{'battery'} || {}; %>
		<% my $pct = $b->{'percentage'}; %>
		<div class="level_tile<% if ($m->{'stale'}) { %> level_stale<% } %>">
			<div class="level_top">
				<span class="level_name"><%= $m->{'hostname'} || 'machine' %></span>
				<% if (defined $pct) { %><span class="level_pct <%= $level_class->($pct) %>"><%= sprintf('%.0f%%', $pct) %></span>
				<% } else { %><span class="level_pct level_mains">mains</span><% } %>
			</div>
			<div class="level_sub"><%= &subs::format_name($m->{'device'} || '') %><% if ($m->{'stale'}) { %> &middot; last seen <%= $when->($m->{'seen'}) %><% } else { %> &middot; v<%= $m->{'version'} || '?' %><% } %></div>
			<% if (defined $pct) { %>
				<div class="level_bar"><i class="<%= $level_class->($pct) %>" style="width:<%= $bar_width->($pct) %>%"></i></div>
				<div class="level_meta"><%== $battery_meta->($b) %></div>
			<% } else { %>
				<div class="level_meta"><%== $battery_meta->($b) || 'on mains' %></div>
			<% } %>
			<%== $usage_line->($m->{'usage'}) %>
			<% my $eta = $eta_text->($b); %>
			<% if ($eta ne '') { %><div class="level_eta"><%= $eta %></div><% } %>
		</div>
	<% } %>
	<% if (@devices) { %>
		<div class="levels_caption">Devices</div>
		<% foreach my $d ( @devices ) { %>
			<% my $pct = $d->{'battery'}; %>
			<div class="level_tile level_device<% if (!$d->{'online'}) { %> level_stale<% } %>">
				<div class="level_top">
					<span class="level_name"><%= $d->{'name'} || &subs::format_name($d->{'purpose'} || 'device') %></span>
					<% if (defined $pct) { %><span class="level_pct <%= $level_class->($pct) %>"><%= sprintf('%.0f%%', $pct) %></span>
					<% } else { %><span class="level_pct level_mains">&mdash;</span><% } %>
				</div>
				<div class="level_sub"><%= &subs::format_name($d->{'purpose'} || '') %><% if ($d->{'host'}) { %> &middot; via <%= $d->{'host'} %><% } %><% if (($d->{'link'} || '') ne '') { %> &middot; <%= $d->{'link'} eq 'bluetooth' ? 'Bluetooth' : 'Wi-Fi' %><% } %><% if (!$d->{'online'}) { %><% if ($d->{'seen'}) { %> &middot; last seen <%= $when->($d->{'seen'}) %><% } else { %> &middot; not answering<% } %><% } %></div>
				<% if (defined $pct) { %>
					<div class="level_bar"><i class="<%= $level_class->($pct) %>" style="width:<%= $bar_width->($pct) %>%"></i></div>
				<% } %>
				<% if (defined $d->{'battery_mv'}) { %>
					<div class="level_meta"><%= sprintf('%.2f V', $d->{'battery_mv'} / 1000) %><% if (!$d->{'online'}) { %> &middot; not answering<% } %></div>
				<% } %>
				<%== $usage_line->($d->{'usage'}) %>
				<% my $dev_b = { percentage => $pct, status => $d->{'status'}, pph => $d->{'pph'}, charge_pph => $d->{'charge_pph'}, charge_eta => $d->{'charge_eta'}, discharge_eta => $d->{'discharge_eta'} }; %>
				<% my $eta = $eta_text->($dev_b); %>
				<% if ($eta ne '') { %><div class="level_eta"><%= $eta %></div><% } %>
			</div>
		<% } %>
	<% } %>
	<div class="levels_foot">v<%= &subs::jawn_version() %><% if (($levels->{'peers'} || 0) > 0) { %> &middot; <%= $levels->{'peers'} %> peers<% } %><% if (($levels->{'failed'} || 0) > 0) { %> &middot; <%= $levels->{'failed'} %> unreached<% } %></div>
</div>
