% title $title;
<% use Mojo::JSON qw/encode_json decode_json/; %>
<div id="alert" style="display:none;">
	<h1>ALERT!!!!</h1>
	<h4 id="alert_message"></h4>
	<input type="text" style="display:none;" id="alert_input">
	<span id="alert_buttons">
	</span>
</div>

<span id="header"></span>
<% my $taskbar_position = &subs::misc_setting('taskbar_position') || 'bottom'; %>
<div id="taskbar" class="theme_surface_soft" position="<%= $taskbar_position %>">
	<span id="taskbar_windows"></span>
	<span id="taskbar_icons"></span>
	<span id="taskbar_clock"></span>
</div>
<canvas class="background" id="background"></canvas>
<canvas class="background" id="leaderboard" style="height: 100vh;"></canvas>
<canvas class="background" id="timeline"></canvas>
<canvas class="background" id="clockface"></canvas>
<canvas class="background" id="continent"></canvas>
<canvas class="background" id="calendar"></canvas>
<canvas class="background" id="narrator"></canvas>


<img id="mouse_pointer" height="40" width="30" src="<%= &subs::icon_for('/images/make believe/pointer.png') %>" style="display:none;z-index:6000;object-fit:contain;">
<div id="remote_managers"></div>
<%= $bar %>

<div id="browser">
	<div id="editormaster">
		<img id="grapple" src="<%= &subs::icon_for('/images/make believe/bullseye.png') %>" jawnos_icon="/images/make believe/bullseye.png" style="z-index:10000;display:none;" class="draggable medium_thumb">
	</div>
	<div id="ticketmaster">
		<img id="ticket_sales" class="medium_thumb draggable lock" style="position:fixed;right:8px;top:96px;z-index:10000;display:none;" src="<%= &subs::icon_for('/images/make believe/key.png') %>" jawnos_icon="/images/make believe/key.png">
	</div>
	<div id="keyboard_container"></div>
</div>

<div id="top_right_buttons">
	<div id="assistant_view" class="assistant_view" conversation="assistant" style="position:fixed;display:none;background-color:var(--panel);border:solid;border-radius:8px;box-shadow:0 8px 26px rgba(0,0,0,.35);overflow:hidden;">
		<div class="assistant_header" hint="Drag here to move this associate" style="position:absolute;top:0;left:0;right:0;height:38px;display:flex;align-items:center;gap:6px;padding:0 6px;box-sizing:border-box;border-bottom:1px solid var(--line);">
			<img src="<%= &subs::icon_for('/images/make believe/assistant.png') %>" jawnos_icon="/images/make believe/assistant.png" class="little_thumb assistant_anchor" hint="Drag me onto a picture or a control and the guide will look at it">
			<span class="assistant_title" style="flex:1;font-weight:bold;opacity:.85;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">Guide's associate</span>
			<% my $guide_confirm = &subs::setting_grabber({ app => '__president', setting => 'guide_confirm', device => 'all' }); %>
			<span class="assistant_new hover" hint="Open another associate, with its own thread" style="cursor:pointer;font-size:16px;font-weight:bold;line-height:1;opacity:.6;padding:0 3px;">+</span>
			<img class="assistant_config little_thumb hover" hint="Configure the Guide's associate" src="<%= &subs::icon_for('/images/make believe/set_button.png') %>" jawnos_icon="/images/make believe/set_button.png">
			<img class="assistant_close little_thumb hover" hint="Close" src="<%= &subs::icon_for('/images/make believe/cancel_button.png') %>" jawnos_icon="/images/make believe/cancel_button.png">
		</div>
		<div class="assistant_config_menu" style="position:absolute;top:38px;right:6px;display:none;z-index:5;background:var(--panel);border:1px solid var(--line);border-radius:8px;box-shadow:0 6px 18px rgba(0,0,0,.3);padding:8px 10px;">
			<label style="display:flex;align-items:center;gap:5px;font-size:12px;opacity:.9;cursor:pointer;white-space:nowrap;" hint="Confirmation Requirement: with this ticked, the Guide asks before it saves what it proposes; untick it and the Guide saves what it proposes without asking"><input type="checkbox" class="assistant_confirm" <%= (defined $guide_confirm && $guide_confirm eq 'off') ? '' : 'checked' %>> Confirm before saving</label>
			<% my $guide_confirm_delete = &subs::setting_grabber({ app => '__president', setting => 'guide_confirm_delete', device => 'all' }); %>
			<label style="display:flex;align-items:center;gap:5px;font-size:12px;opacity:.9;cursor:pointer;white-space:nowrap;margin-top:6px;" hint="With this ticked the Guide asks before it deletes an appointment; untick it and a delete it carries out goes through without asking"><input type="checkbox" class="assistant_confirm_delete" <%= (defined $guide_confirm_delete && $guide_confirm_delete eq 'off') ? '' : 'checked' %>> Confirm before deleting</label>
			<% my $assistant_speech = (&subs::setting_grabber({ app => '__president', setting => 'assistant_speech', device => 'all' }) // ''); %>
			<label style="display:flex;align-items:center;gap:5px;font-size:12px;opacity:.9;cursor:pointer;white-space:nowrap;padding-top:6px;border-top:1px solid var(--line);margin-top:6px;" hint="With this ticked each reply is written and spoken - through the voice set under Configure → Misc → Speech (Piper first), the same voice the watch's answers use"><input type="checkbox" class="assistant_speak" <%= ($assistant_speech eq 'on') ? 'checked' : '' %>> Speak the replies</label>
			<div class="assistant_staged_open hover" hint="Show what the Guide has staged and is waiting to save" style="display:flex;align-items:center;gap:5px;font-size:12px;opacity:.9;cursor:pointer;white-space:nowrap;padding-top:6px;margin-top:6px;border-top:1px solid var(--line);">Staged<span class="assistant_staged_count" style="opacity:.6;"></span></div>
		</div>
		<div class="assistant_chat_log" style="position:absolute;top:38px;bottom:46px;left:0;right:0;overflow-y:auto;padding:8px 10px;box-sizing:border-box;"></div>
		<div class="assistant_input_row" style="position:absolute;bottom:0;left:0;right:0;height:46px;display:flex;gap:6px;align-items:center;padding:0 8px;box-sizing:border-box;border-top:1px solid var(--line);background:var(--panel);">
			<textarea class="assistant_question" rows="1" placeholder="Ask the guide…" style="flex:1;box-sizing:border-box;height:32px;min-height:32px;max-height:32px;resize:none;border-radius:8px;border:1px solid var(--line);background:var(--panel);color:var(--ink);padding:6px 8px;font-family:inherit;"></textarea>
			<button class="assistant_send button" hint="Ask, or ask it to do it" style="padding:6px 12px;border-radius:8px;border:2px solid var(--line);cursor:pointer;font-weight:bold;">Ask</button>
		</div>
		<div class="assistant_staged_panel" style="position:absolute;top:38px;bottom:0;left:0;right:0;display:none;flex-direction:column;box-sizing:border-box;background:var(--panel);">
			<div style="display:flex;align-items:center;gap:6px;padding:6px 10px;border-bottom:1px solid var(--line);box-sizing:border-box;">
				<img class="assistant_staged_back little_thumb hover" hint="Back to the chat, as you left it" src="<%= &subs::icon_for('/images/make believe/left arrow.png') %>" jawnos_icon="/images/make believe/left arrow.png">
				<span style="font-weight:bold;font-size:13px;opacity:.85;">Staged appointments</span>
			</div>
			<div class="assistant_staged_list" style="flex:1;overflow-y:auto;padding:8px 10px;box-sizing:border-box;"></div>
		</div>
		<span class="assistant_model" style="display:none;"><%= &subs::setting_grabber({ app => 'mail', setting => 'help_assistant' }) %></span>
		<span class="assistant_trash_icon" style="display:none;"><%= &subs::icon_path('trash', '/icons/trash.png') %></span>
	</div>
	<% my $padlock_sighting = eval { return decode_json &subs::setting_grabber({app => '__president', setting => 'padlock_contexts' }) } || []; %>
	<% my $house_gate = (scalar @{$padlock} > 0 && grep { $_ eq 'general' } @{$padlock_sighting}) ? 1 : 0; %>
			<img id="lock_session" hint="Tap to lock this screen; double-tap to lock the house" style="<% unless ($house_gate) { %>display:none;<% } %>" class="jonathan little_thumb" src="<%= &subs::icon_for('/images/decipherable/padlock.png') %>" jawnos_icon="/images/decipherable/padlock.png"></img>


		<%# the start button's own face: a misc setting picks the picture out of the
		    jbuttons folder, and the active icon set may carry a variant of it - the
		    jawnos_icon attribute is what jawnosReloadIcons() re-maps when the set
		    changes %>
		<% my $start_icon = &subs::misc_setting('start_menu_icon') || '/images/jbuttons/logo1.png'; %>
		<img id="start_menu_toggle" hint="Start menu" class="jonathan little_thumb start" src="<%= &subs::icon_for($start_icon) %>" jawnos_icon="<%= $start_icon %>">
</div>
<!-- the menu hangs off the corner itself rather than out of the button box: it
     must stand over the dock and the taskbar, which the box it used to live in
     sits under -->
<%= include 'start_menu/start_menu', parking_lot => {} %>
<div id="start_menu_backlog"></div>
<div id="bottom_left_buttons">

</div>
<div id="bottom_right_buttons">

</div>

<div id="secret_workspace" style="display:none;">
</div>
<div id="temporary_workspace"></div>
<div id="dialog_boxes"></div>
<div id="app_switcher" style="z-index:50000;display:none;background-color:lightblue;border:4px;border-radius:3%;padding:20px;position:fixed;top: 50%;left: 50%; transform: translate(-50%, -50%);">I am the app switcher</div>
