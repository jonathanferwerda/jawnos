% title $title;
<% use Mojo::JSON qw/encode_json decode_json/; %>
<div id="alert" style="display:none;">
	<h1>ALERT!!!!</h1>
	<h4 id="alert_message"></h4>
	<input type="text" style="display:none;" id="alert_input">
	<span id="alert_buttons">
	</span>
</div>

<span id="header"></span>
<% my $taskbar_position = &subs::misc_setting('taskbar_position') || 'bottom'; %>
<div id="taskbar" position="<%= $taskbar_position %>">
	<span id="taskbar_windows"></span>
	<span id="taskbar_icons"></span>
	<span id="taskbar_clock"></span>
</div>
<canvas class="background" id="background"></canvas>
<canvas class="background" id="leaderboard" style="height: 100vh;"></canvas>
<canvas class="background" id="timeline"></canvas>
<canvas class="background" id="clockface"></canvas>
<canvas class="background" id="continent"></canvas>
<canvas class="background" id="calendar"></canvas>
<canvas class="background" id="narrator"></canvas>


<img id="mouse_pointer" height="40" width="30" src="<%= &subs::icon_for('/images/make believe/pointer.png') %>" style="display:none;z-index:6000;object-fit:contain;">
<div id="remote_managers"></div>
<%= $bar %>

<div id="browser">
	<div id="editormaster">
		<img id="grapple" src="<%= &subs::icon_for('/images/make believe/bullseye.png') %>" jawnos_icon="/images/make believe/bullseye.png" style="z-index:10000;display:none;" class="draggable medium_thumb">
	</div>
	<div id="ticketmaster">
		<img id="ticket_sales" class="medium_thumb draggable lock" style="position:fixed;right:8px;top:96px;z-index:10000;display:none;" src="<%= &subs::icon_for('/images/make believe/key.png') %>" jawnos_icon="/images/make believe/key.png">
	</div>
	<div id="keyboard_container"></div>
</div>

<div id="top_right_buttons">
	<div id="assistant_view" style="position:fixed;height:360px;width:320px;display:none;background-color:var(--panel);border:solid;border-radius:8px;box-shadow:0 8px 26px rgba(0,0,0,.35);overflow:hidden;">
		<div id="assistant_header" style="position:absolute;top:0;left:0;right:0;height:38px;display:flex;align-items:center;gap:6px;padding:0 6px;box-sizing:border-box;border-bottom:1px solid var(--line);">
			<img src="<%= &subs::icon_for('/images/make believe/assistant.png') %>" jawnos_icon="/images/make believe/assistant.png" class="little_thumb" id="assistant_anchor" hint="Drag me onto a picture or a control and the guide will look at it">
			<span style="flex:1;font-weight:bold;font-size:13px;opacity:.85;">Guide's associate</span>
			<% my $guide_confirm = &subs::setting_grabber({ app => '__president', setting => 'guide_confirm', device => 'all' }); %>
			<label style="display:flex;align-items:center;gap:3px;font-size:11px;opacity:.85;cursor:pointer;white-space:nowrap;" hint="Confirmation Requirement: with this ticked, the Guide asks before it saves what it proposes; untick it and the Guide acts on its own"><input type="checkbox" id="assistant_confirm" <%= (defined $guide_confirm && $guide_confirm eq 'off') ? '' : 'checked' %>> Confirm</label>
			<img id="assistant_close" hint="Close" class="little_thumb hover" src="<%= &subs::icon_for('/images/make believe/cancel_button.png') %>" jawnos_icon="/images/make believe/cancel_button.png">
		</div>
		<div class="assistant_chat_log" style="position:absolute;top:38px;bottom:46px;left:0;right:0;overflow-y:auto;padding:8px 10px;box-sizing:border-box;"></div>
		<div style="position:absolute;bottom:0;left:0;right:0;height:46px;display:flex;gap:6px;align-items:center;padding:0 8px;box-sizing:border-box;border-top:1px solid var(--line);background:var(--panel);">
			<textarea id="assistant_question" rows="1" placeholder="Ask the guide…" style="flex:1;box-sizing:border-box;height:32px;min-height:32px;max-height:32px;resize:none;border-radius:8px;border:1px solid var(--line);background:var(--panel);color:var(--ink);padding:6px 8px;font-size:13px;font-family:inherit;"></textarea>
			<button id="assistant_send" class="button" hint="Ask, or ask it to do it" style="padding:6px 12px;border-radius:8px;border:2px solid var(--line);cursor:pointer;font-weight:bold;">Ask</button>
		</div>
		<span id="assistant_model" style="display:none;"><%= &subs::setting_grabber({ app => 'mail', setting => 'help_assistant' }) %></span>
	</div>
	<% my $padlock_sighting = eval { return decode_json &subs::setting_grabber({app => '__president', setting => 'padlock_contexts' }) } || []; %>
			<img id="lock_session" hint="Lock session" style="	<% if (scalar @{$padlock} == 0 || grep { $_ ne 'music' } @{$padlock_sighting}) { %>display:none;<% } %>"class="jonathan little_thumb"  src="<%= &subs::icon_for('/images/decipherable/padlock.png') %>" jawnos_icon="/images/decipherable/padlock.png"></img>


		<%# the start button's own face: a misc setting picks the picture out of the
		    jbuttons folder, and the active icon set may carry a variant of it - the
		    jawnos_icon attribute is what jawnosReloadIcons() re-maps when the set
		    changes %>
		<% my $start_icon = &subs::misc_setting('start_menu_icon') || '/images/jbuttons/logo1.png'; %>
		<img id="start_menu_toggle" hint="Start menu" class="jonathan little_thumb start" src="<%= &subs::icon_for($start_icon) %>" jawnos_icon="<%= $start_icon %>">
</div>
<!-- the menu hangs off the corner itself rather than out of the button box: it
     must stand over the dock and the taskbar, which the box it used to live in
     sits under -->
<%= include 'start_menu/start_menu', parking_lot => {} %>
<div id="start_menu_backlog"></div>
<div id="bottom_left_buttons">

</div>
<div id="bottom_right_buttons">

</div>

<div id="secret_workspace" style="display:none;">
</div>
<div id="temporary_workspace"></div>
<div id="dialog_boxes"></div>
<div id="app_switcher" style="z-index:50000;display:none;background-color:lightblue;border:4px;border-radius:3%;padding:20px;position:fixed;top: 50%;left: 50%; transform: translate(-50%, -50%);">I am the app switcher</div>
