<% use Mojo::JSON qw/decode_json/; %>
<img id="pointer" style="position:fixed;" height="26" width="26" src="<%= &subs::icon_for('/images/make believe/start.png') %>" hint="Start">
<div id="marker">
	<canvas id="whiteboard"></canvas>
	<div id="marker_toolbox" class="marker_toolbox" style="overflow:scroll; position:absolute;right:0px; float:right; top: 35px; height:100%; width: 85px; border: 2px; border-radius: 7px; background-color: green;">

		<button class="button" id="marker_toolbox_hide" hint="Hide the toolbox" style="width:100%;">&#187;</button>
		<button class="button marker_init" onclick="markerInit()">Init</button>
		<img src="<%= &subs::icon_for('/images/decipherable/marker.png') %>" hint="Stylus (palm protection)" toggle="<%= $settings->{'stylus_toggle'} %>" class="little_thumb hover marker_stylus_toggle">
		<br>
		<input type="text" id="flipbook_interval" class="flipbook_interval" style="width: 80px;" value="60"><br>
		<button movement="back" class="button flipbook"><-</button>
		<button movement="forward" class="button flipbook">-></button><br>
		<img id="marker_pause" class="little_thumb pause_marker" style="display:none;" src="<%= &subs::icon_for('/images/make believe/pause.png') %>" hint="Pause">
		<img id="marker_record" class="medium_thumb record_marker" movement="forward" src="<%= &subs::icon_for('/images/make believe/record.png') %>" hint="Record">
		<img class="tiny_thumb play_marker" movement="back" style="transform: rotate(180deg);" src="<%= &subs::icon_for('/images/make believe/play.png') %>" hint="Play">
		<img class="tiny_thumb play_marker" movement="forward" src="<%= &subs::icon_for('/images/make believe/play.png') %>" hint="Play">

		<button class="button marker_tool" tool="pencil">Pencil</button><br>
		<button class="button marker_tool" tool="brush">Brush</button><br>
		<button class="button marker_tool" tool="spray">Spray</button><br>
		<button class="button marker_tool" tool="fill">Fill</button><br>
		<button class="button marker_erase_toggle" erase="off" hint="Erase with the current brush">Erase</button><br>
		<button class="button marker_tool" tool="kb">KB</button><br>
		<button class="button marker_tool" tool="sample">Sample</button><br>

		<button class="button" id="marker_layers_toggle">Layers</button><br>
		<div id="marker_layers" style="display:none;">
			<div id="marker_layer_tools">
				<button class="button marker_layer_add hover" hint="New layer">+</button>
				<button class="button marker_layer_up hover" hint="Raise layer">&#9650;</button>
				<button class="button marker_layer_down hover" hint="Lower layer">&#9660;</button>
				<button class="button marker_layer_front hover" hint="Bring to front">&#10514;</button>
				<button class="button marker_layer_delete hover" hint="Delete layer">&#10005;</button>
				<br>
				<button class="button marker_undo hover" hint="Undo">&#8630;</button>
				<button class="button marker_redo hover" hint="Redo">&#8631;</button>
				<button class="button marker_zoom_out hover" hint="Zoom out (or ctrl + scroll out)">-</button>
				<button class="button marker_zoom_in hover" hint="Zoom in (or ctrl + scroll in)">+</button>
				<button class="button marker_zoom_fit hover" hint="Fit the drawing (0 key)">Fit</button>
				<button class="button" id="marker_wheel_mode" hint="Scroll pans, ctrl + scroll zooms">Scroll</button>
				<button class="button marker_new_board hover" hint="New drawing">New</button>
				<button class="button marker_session_save hover" hint="Save this drawing as a session">Session</button>
			</div>
			<div id="marker_layer_list"></div>
		</div>
		<script>var marker_layer_eye = '<%= &subs::icon_for('/images/make believe/eye.png') %>';</script>

		<button class="button save_marker">Save</button>
		<div id="marker_kit">
			<% 
				my $colours = eval { return decode_json $settings->{'colours'} } || [];
				if (scalar @{$colours} > 0) { %>
					<% foreach my $colour ( @{$colours} ) { %>
						<input type="color" style="width:45%;" uuid="<%= $colour->{'uuid'} %>" id="marker_colour" class="marker_colour" value="<%= $colour->{'colour'} %>" />
						<button class="marker_colour_remove" uuid="<%= $colour->{'uuid'} %>">-</button><br>
					<% } %>
				<% } else { %>
					<% my $uuid = &subs::random_string_creator(10); %>
					<input type="color" style="width:45%;" uuid="<%= $uuid %>" id="marker_colour" class="marker_colour" value="#000000" />
					<button class="marker_colour_remove" uuid="<%= $uuid %>">-</button><br>
				<% } %>
				<script>

				</script>
		</div>
		<button id="marker_colour_add">+</button>

		<div class="kit">
			<input class="slider_bar" style="width: 89%" type="range" id="marker_size" step=1 max=40 min=1 />
			<input class="slider_bar" style="width: 89%" type="range" id="marker_transparency" step=.02 max=1 min=0 />
		</div>
		<img src="<%= &subs::icon_for('/images/decipherable/gallery.png') %>" hint="Gallery" class="little_thumb" id="marker_gallery">
		<div id="portfolio" style="max-width:100%; overflow:scroll;">
		<% foreach my $d ( @{$drawings} ) { %>
			<% my $files = eval { return decode_json $d->{'file'} } || []; %>

			<% foreach my $fi ( grep { $_->{'type'} eq 'image' } @{$files} ) { %>
				<button class="marker_delete" timestamp="<%= $d->{timestamp} %>" app="<%= $d->{'app'} %>" app_uuid="<%= $d->{'uuid'} %>" file_uuid="<%= $fi->{uuid} %>">D</button>
				<img class="paper" timestamp="<%= $d->{timestamp} %>" app="<%= $d->{'app'} %>" app_uuid="<%= $d->{'uuid'} %>" file_uuid="<%= $fi->{uuid} %>" src="/file_open?file=<%= $fi->{'f'} %>&timestamp=<%= $fi->{'server_time'} %>" style="width:40px;height:60px"></img>
			<% } %>
		<% } %>
		</div>
	</div>
	<button class="button" id="marker_toolbox_show" hint="Show the toolbox" style="position:absolute;right:0px;top:38px;display:none;z-index:30;">&#171;</button>
	<img id="marker_targeting" style="position:fixed;display:none;" height="36" width="36" src="<%= &subs::icon_for('/images/make believe/bullseye.png') %>" hint="Target">
</div>