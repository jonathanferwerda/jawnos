<% sub array_converter() {
	my $jdata = shift;
	my %tdata;
	my $count = 1;
	%tdata = map { $count . 'arr' => $_ } @{$jdata};
	$jdata = \%tdata;
	return $jdata;
} 
sub nb() {
	my $count = shift;
	my $text = '&nbsp;';
	for ( my $n = 0; $n <= $count; $n++ ) {
		$text .= $text;
	}
	return '';
}
%>

