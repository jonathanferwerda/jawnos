<% 	no warnings 'uninitialized'; %>
<%# The Notes app: what the watch heard when the words were not a command, plus
    anything typed here. A note is its own row now, not an appointment. Click a
    note to edit it in the box at the foot, drag one onto an appointment window to
    fold it into that app's notes, and the X is a two-click delete. %>
<div id="notes" style="width:100%;height:100%;background-color:var(--panel);padding:6px;display:flex;flex-direction:column;">
	<div id="notes_list" style="flex:1 1 auto;overflow:scroll;">
		<% if (!scalar @{$notes}) { %>
			<span style="font-size:18px;">No notes yet. Anything the watch hears that is not a command lands here.</span>
		<% } %>
		<% foreach my $n ( @{$notes} ) { %>
			<% my $draft_of = $n->{'app'} || ''; %>
			<div class="note hover" uuid="<%= $n->{'uuid'} %>" timestamp="<%= $n->{'timestamp'} %>" style="border-bottom:solid 1px var(--line);padding:6px;font-size:18px;cursor:move;">
				<button class="note_delete" uuid="<%= $n->{'uuid'} %>" style="float:right;" title="Delete">X</button>
				<% if ($draft_of ne '' && $draft_of ne 'notes') { %><span class="note_app" title="<%= &subs::lang('notes.draft') %>"><%= $draft_of %> · <%= &subs::lang('notes.draft') %></span><% } %>
				<span class="time" timestamp="<%= $n->{'timestamp'} %>" style="opacity:0.7;font-size:14px;"></span>
				<div class="note_text" style="white-space:pre-wrap;"><%= $n->{'text'} %></div>
			</div>
		<% } %>
	</div>
	<div id="notes_input_row" style="flex:0 0 auto;padding-top:4px;">
		<textarea id="notes_input" rows="2" placeholder="Write a note... (Enter saves, Shift+Enter makes a line)" style="width:80%;vertical-align:top;"></textarea>
		<button id="notes_save" style="width:16%;vertical-align:top;">Save</button>
	</div>
</div>
