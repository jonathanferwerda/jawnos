<% use Mojo::JSON qw/encode_json decode_json/; %>

<div id="security" device_uuid="<%= $current_device_uuid || '' %>" style="background-color:var(--panel);width:100%;height:100%;box-sizing:border-box;">
	<div class="security_tabs">
		<button class="security_view_select" view="padlock" style="<% if ($president->{'security_view'} eq 'padlock') { %>background-color:lightgreen;<% } %>">Padlock</button>
		<button class="security_view_select" view="neighbour_link" style="<% if ($president->{'security_view'} eq 'neighbour_link') { %>background-color:lightgreen;<% } %>">Neighbour</button>
		<button class="security_view_select" view="signatorial" style="<% if ($president->{'security_view'} eq 'signatorial') { %>background-color:lightgreen;<% } %>">Signatorial</button>
		<button class="security_view_select" view="devices" style="<% if ($president->{'security_view'} eq 'devices') { %>background-color:lightgreen;<% } %>">Devices</button>
		<button class="security_view_select" view="recovery" style="<% if ($president->{'security_view'} eq 'recovery') { %>background-color:lightgreen;<% } %>">Recovery</button>
		<button class="security_view_select" view="passkeys" style="<% if ($president->{'security_view'} eq 'passkeys') { %>background-color:lightgreen;<% } %>">Passkeys</button>
	</div>
	<div class="security_view" view="padlock" style="<% unless ( $president->{'security_view'} eq 'padlock' ) { %>display:none;<% } %>">
		<% if ($lockdown_active) { %>
			<div class="security_lockdown" style="border:2px solid #b0342e;border-radius:10px;padding:14px;margin:0 0 14px;max-width:680px;">
				<h2 style="margin-top:0;"><%= &subs::ui('Lockdown') %></h2>
				<p style="line-height:1.5;"><%= &subs::ui('An enemy is present, or this is a dangerous place. Other apps are closed. Confirm with your fingerprint to reveal the appointment so you can stop it.') %></p>
				<% if (scalar @{ $lockdown_apps || [] }) { %>
					<p><%= &subs::ui('Hidden appointment') %>: <%== join ', ', map { &subs::html_text(&subs::format_name($_)) } @{ $lockdown_apps || [] } %></p>
				<% } %>
				<button id="lockdown_unlock" type="button"><%= &subs::ui('Confirm with fingerprint') %></button>
				<div id="lockdown_unlock_note" style="min-height:22px;color:darkred;"></div>
			</div>
		<% } %>
		<% my $padlock = &subs::db_query('select * from security where level=? limit 1', 'padlock')->hashes->[0]; %>
		<div class="padlock_intro">
			<h2>The gate</h2>
			<p style="line-height:1.4;">
				A paired phone or tablet is the key. Tap the padlock on the taskbar to lock
				this screen; double-tap it to lock the whole house. The phone opens the unlock
				page, waits for your tap and fingerprint, and opens only the screen you pick.
				The inactivity timeout is also a whole-house lock. The paper recovery code is
				the emergency way in.
			</p>
			<p id="padlock_set_status" status="<%= $padlock ? 'yes' : 'no' %>">
				<b><%= $padlock ? 'The gate is on.' : 'The gate is off.' %></b>
			</p>
			<button id="padlock_gate_enable" type="button"<% if ($padlock) { %> style="display:none;"<% } %>>Turn the gate on</button>
			<button id="padlock_gate_disable" type="button"<% unless ($padlock) { %> style="display:none;"<% } %>>Turn the gate off</button>
			<br>
			<a href="/manager/security/padlock_key" target="_blank" id="padlock_key_show"
				style="display:inline-block;margin-top:10px;font-size:15px;">Phone unlock page</a>
			<% if (&subs::device_setter() eq 'mobile') { %>
				<div id="padlock_biometric_enroll" style="margin-top:14px;">
					<button id="padlock_biometric_enroll_button" type="button" data-enrolled="<%= $biometric_enrolled ? 1 : 0 %>"><%= $biometric_enrolled ? "Replace this phone's fingerprint" : "Enroll this phone's fingerprint" %></button>
					<div id="padlock_biometric_status" style="font-size:14px;margin-top:6px;"><% if ($biometric_enrolled) { %>A fingerprint is enrolled. Confirm it to replace it.<% } %></div>
				</div>
			<% } %>
		</div>
		<div class="padlock_footer">
			<span style="font-size:14px;" title="Shadow writes what the lock would refuse to the log; Enforce refuses it.">
				Gate
				<select id="padlock_gate">
					<option value="shadow" <% if (($president->{'padlock_gate'} || 'enforce') eq 'shadow') { %>selected<% } %>>Shadow (log only)</option>
					<option value="enforce" <% if (($president->{'padlock_gate'} || 'enforce') eq 'enforce') { %>selected<% } %>>Enforce</option>
				</select>
			</span>
			<% my $app_access = &subs::setting_grabber({ app => '__president', setting => 'app_access', device => 'all' }) || 'shadow'; %>
			<span style="font-size:14px;margin-left:12px;" title="<%= &subs::ui('Off lets any browser in. Shadow logs what it would refuse. Enforce admits only the installed apps and the signed peer rail.') %>">
				<%= &subs::ui('App access') %>
				<select id="app_access">
					<option value="off" <% if ($app_access eq 'off') { %>selected<% } %>><%= &subs::ui('Off (any browser)') %></option>
					<option value="shadow" <% if ($app_access eq 'shadow') { %>selected<% } %>><%= &subs::ui('Shadow (log only)') %></option>
					<option value="enforce" <% if ($app_access eq 'enforce') { %>selected<% } %>><%= &subs::ui('Enforce (app only)') %></option>
				</select>
			</span>
			<% my $selected_contexts = $president->{'padlock_contexts'} || []; %>
			<select id="padlock_contexts" multiple title="General is the whole house; the others are per-app." value="<%= join ',', @{$selected_contexts} %>" style="height:100px;min-width:150px;">
				<% foreach my $context ( qw/general gallery music folders/ ) { %>
					<option value="<%= $context %>" <% if (grep { $_ eq $context } @{$selected_contexts}) { %>selected<% } %>><%= &subs::format_name($context) %></option>
				<% } %>
			</select>
		</div>
	</div>

	<div class="security_view" view="passkeys" style="<% unless ( $president->{'security_view'} eq 'passkeys' ) { %>display:none;<% } %>">
		<%
			# A passkey can only be made on a page under the house domain, so the
			# in-panel button is offered only when this window is already on that
			# name; on 127.0.0.1 the browser refuses before it ever prompts.
			my $window_host = lc($c->req->url->base->host || '');
			my $rp_host = lc($webauthn_rp || '');
			my $on_house_name = (length $rp_host && ($window_host eq $rp_host || $window_host =~ /\.\Q$rp_host\E$/)) ? 1 : 0;
		%>
		<h2>Passkeys</h2>
		<p style="line-height:1.4;max-width:640px;">
			A passkey is a keypair made by a security key you plug in - a USB or NFC key, not this device's own
			reader and not a phone. The house keeps only its public half,
			so there is nothing here to steal, and the key signs a challenge from this house rather than a password
			that can be typed into the wrong page. A passkey registered here is bound to
			<b><%= length($webauthn_rp || '') ? $webauthn_rp : 'the house domain (not set yet)' %></b>, so the same
			key works on every machine under that name.
		</p>
		<% if (!length($webauthn_rp || '')) { %>
			<p style="color:#e5484d;">Set the house domain first: Configure &rarr; Plat &rarr; DNS &rarr; House domain.</p>
		<% } %>
		<% if (!$passkey_person) { %>
			<p style="color:#e5484d;">This device is not assigned to a person yet. Assign it under Devices, then come back.</p>
		<% } %>
		<table style="width:100%;text-align:left;">
			<thead>
				<tr><th>Name</th><th>Person</th><th>Added</th><th>Last used</th><th></th></tr>
			</thead>
			<tbody>
				<% if (!scalar @{$passkeys}) { %>
					<tr><td colspan="5" style="opacity:.7;">No passkeys yet.</td></tr>
				<% } %>
				<% foreach my $pk ( @{$passkeys} ) { %>
					<tr class="passkey_row">
						<td><%= $pk->{'name'} || 'Passkey' %></td>
						<td><%= $pk->{'person_name'} || '' %></td>
						<td><% if ($pk->{'created'}) { %><span class="time" mode="fixed" timestamp="<%= $pk->{'created'} %>"></span><% } %></td>
						<td><% if ($pk->{'last_used'}) { %><span class="time" mode="fixed" timestamp="<%= $pk->{'last_used'} %>"></span><% } else { %>never<% } %></td>
						<td>
							<% if ($passkey_person && ($pk->{'person_uuid'} || '') eq $passkey_person->{'uuid'}) { %>
								<button class="passkey_remove" id="<%= $pk->{'id'} %>" type="button">Remove</button>
							<% } %>
						</td>
					</tr>
				<% } %>
			</tbody>
		</table>
		<div style="margin-top:12px;">
			<% if ($on_house_name) { %>
				<input id="passkey_name" type="text" placeholder="Laptop" style="width:170px;" autocomplete="off" spellcheck="false">
				<button id="passkey_add" type="button" data-rp="<%= $webauthn_rp || '' %>"<% if (!$passkey_person || !length($webauthn_rp || '')) { %> disabled<% } %>>Add a passkey</button>
			<% } %>
			<button id="passkey_open_browser" type="button"<% if (!$passkey_person || !length($webauthn_rp || '')) { %> disabled<% } %>>Open in browser</button>
			<span id="passkey_status" style="font-size:14px;margin-left:8px;"></span>
		</div>
		<p style="font-size:13px;color:#777;max-width:640px;">
			<b>Open in browser</b> is the reliable way: it makes a five-minute, single-use link and opens it on the
			house name, where the authenticator prompt can run.
			<% if ($on_house_name) { %>
				<b>Add a passkey</b> makes one right here, in this window.
			<% } else { %>
				<b>Add a passkey</b> is not offered here because this window is on <%= $window_host || 'an address' %>,
				not the house name - a passkey can only be made on a page under the house domain.
			<% } %>
			Removing a passkey here only forgets it in the house; the key stays in the device until you delete it there.
			A passkey proves who you are, not what you may do - privileges still come from the person.
		</p>
	</div>

	<div class="security_view" view="neighbour_link" style="<% unless ( $president->{'security_view'} eq 'neighbour_link' ) { %>display:none;<% } %>">
		<table style="width:100%;text-align:center;">
			<thead>
				<tr><th>Initiator</th><th>Initiated</th><th>Privilege</th><th>Accepted</th><th>Updated</th><th>Cxl</th></tr>
			</thead>
			<tbody>
				
				<% foreach my $nl ( @{$neighbour_link}) { %>
					<tr class="neighbour_link" uuid="<%= $nl->{'uuid'} %>">
						<td><%= $nl->{'initiator'} %></td>
						<td><%= $nl->{'initiated'} %></td>
						<td><img class="neighbour_link_updater medium_thumb" hint="<%= &subs::format_name($nl->{'status'}) %>" src="<%= &subs::icon_for($gb::known_appts->{$nl->{'status'}}->{'icon'}) %>"><br><%= &subs::format_name($nl->{'status'}) %></td>
						<td class="time" timestamp="<%= $nl->{'ost'} %>"></td>
						<td class="time" timestamp="<%= $nl->{'server_time'} %>"></td>
						<td><img src="<%= &subs::icon_for('/images/make believe/cancel_button.png') %>" hint="Close" class="neighbour_link_delete little_thumb"></td>
					</tr>
					<tr style="display:none;" class="neighbour_link_updater_selection" uuid="<%= $nl->{'uuid'} %>">
						<td colspan="6">
							<% foreach my $chair ( keys %{$gb::chairs} ) { %>
								<img class="neighbour_link_privilege_change large_thumb" privilege="<%= $chair %>" hint="<%= &subs::format_name($chair) %>" src="<%= &subs::icon_for($gb::known_appts->{$chair}->{'icon'}) %>">
							<% } %>
						</td>
					</tr>
				<% } %>
			</tbody>
		</table>
	</div>
	<div class="security_view" view="signatorial" style="<% unless ($president->{'security_view'} eq 'signatorial') { %>display:none;<% } %>">
		<% my $signatorials = eval { return decode_json &subs::setting_grabber({ app => 'customs', setting => 'signatorials'}) } || []; %>
		<% 

		%>
		<% foreach my $r ( @{$signatorials} ) { 
			my ($destination,$asset,$type) = &subs::file_device_renamer({ file => $r->{'f'}, app => $r->{'app'}, type => $r->{'type'} });
			my $file = $destination . $asset;
			%>
			<% if (-e $file) { %>
				<img class="signatorial_selection gigantic_thumb" file="<%= $file %>" src="/file_open?file=<%= $file %>&timestamp=<%= $r->{'server_time'} %>&app=<%= $r->{'app'} %>"
					<% if ($file eq $config->{'signatorial'}) { %>
						style="border-width:5px;border-color:yellow;"
					<% } %>>
			<% } else { %>
				@{$signatorials} = grep { $_->{'uuid'} ne $r->{'uuid'} } @{$signatorials};
				my $jsignatorials = encode_json $signatorials;
				&subs::setting_setter({ app => 'customs', setting => 'signatorials', value => $jsignatorials });
			<% } %>
		<% } %>
		<% if (scalar @{$signatorials} == 0) { %>
			No signatorials
		<% } %>





	</div>
	<div class="security_view" view="devices" style="<% unless ( $president->{'security_view'} eq 'devices' ) { %>display:none;<% } %>">
		<% if (scalar @{ $requests || [] } > 0) { %>
			<h3>Waiting for approval</h3>
			<table style="width:100%;text-align:center;">
				<thead>
					<tr><th>Name</th><th>Code</th><th>Asked</th><th>Agent</th><th>Approve</th><th>Deny</th></tr>
				</thead>
				<tbody>
					<% foreach my $r ( @{$requests} ) { %>
						<tr class="device_request" uuid="<%= $r->{'uuid'} %>">
							<td><%= $r->{'name'} %></td>
							<td style="font-family:monospace;font-size:22px;letter-spacing:3px;"><%= $r->{'code'} %></td>
							<td class="time" timestamp="<%= $r->{'server_time'} %>"></td>
							<td style="font-size:11px;"><%= substr($r->{'agent'} || '', 0, 60) %></td>
							<td><button class="device_request_decide" decision="approve">Approve</button></td>
							<td><button class="device_request_decide" decision="deny">Deny</button></td>
						</tr>
					<% } %>
				</tbody>
			</table>
			<p style="font-size:14px;">Approve only when the code matches the one shown on the device that is asking.</p>
		<% } %>
		<div id="person_add_row" style="text-align:center;margin:8px 0;">
			<input id="person_new_name" type="text" placeholder="<%= &subs::lang('person.name') %>" style="width:170px;">
			<select id="person_new_privilege" title="<%= &subs::lang('person.privilege') %>">
				<option value="resident" selected><%= &subs::ui('Resident') %></option>
				<option value="citizen"><%= &subs::ui('Citizen') %></option>
				<option value="guest"><%= &subs::ui('Guest') %></option>
			</select>
			<button id="person_add_button" type="button"><%= &subs::lang('person.add') %></button>
		</div>
		<% my %device_person = map { ($_->{'uuid'} || '') => ($_->{'person_uuid'} || '') } @{ $devices || [] }; %>
		<% my %person_devices; $person_devices{$_->{'person_uuid'}}++ for grep { ($_->{'person_uuid'} || '') ne '' } @{ $devices || [] }; %>
		<% my $current_person = $device_person{$current_device_uuid} // ''; %>
		<table style="width:100%;text-align:center;">
			<thead><tr><th><%= &subs::lang('person') %></th><th><%= &subs::lang('person.privilege') %></th><th><%= &subs::ui('Devices') %></th><th></th></tr></thead>
			<tbody>
				<% foreach my $p ( @{ $people || [] } ) { %>
					<tr class="person_row" uuid="<%= $p->{'uuid'} %>">
						<td><%= $p->{'name'} %></td>
						<td><%= &subs::ui(&subs::format_name($p->{'privilege'})) %></td>
						<td><%= $person_devices{$p->{'uuid'}} || 0 %></td>
						<td>
							<% if (($p->{'uuid'} || '') eq ($current_person || '')) { %>
								<span style="font-size:13px;"><%= &subs::ui('This is you') %></span>
							<% } elsif (($p->{'uuid'} || '') eq 'owner') { %>
								<span style="font-size:13px;"><%= &subs::ui('The owner') %></span>
							<% } else { %>
								<button class="person_revoke" type="button"><%= &subs::lang('person.revoke') %></button>
							<% } %>
						</td>
					</tr>
				<% } %>
			</tbody>
		</table>
		<p style="font-size:13px;max-width:700px;margin:4px auto;"><%= &subs::ui('Revoking a person revokes every device they carry, deletes the house-key shares those devices hold, and stops their invitations. Their sessions end at the next request.') %></p>
		<table style="width:100%;text-align:center;">
			<thead>
				<tr><th>Name</th><th><%= &subs::lang('person') %></th><th><%= &subs::lang('device.kind') %></th><th>Paired</th><th>Last Seen</th><th>Key</th><th>Revoke</th></tr>
			</thead>
			<tbody>
				<% foreach my $d ( @{ $devices || [] } ) { %>
					<tr class="paired_device" uuid="<%= $d->{'uuid'} %>">
						<td><%= $d->{'name'} %></td>
						<td>
							<% my $dperson = $d->{'person_uuid'} || ''; %>
							<select class="device_person_select" device="<%= $d->{'uuid'} %>" title="<%= &subs::ui('The person this device belongs to') %>">
								<option value="" <% if (!$dperson) { %>selected<% } %>><%= &subs::lang('person.unassigned') %></option>
								<% foreach my $p ( @{ $people || [] } ) { %>
									<option value="<%= $p->{'uuid'} %>" <% if ($dperson eq $p->{'uuid'}) { %>selected<% } %>><%= $p->{'name'} %> (<%= &subs::ui(&subs::format_name($p->{'privilege'})) %>)</option>
								<% } %>
							</select>
							<% if (($current_device_uuid || '') eq $d->{'uuid'}) { %><div style="font-size:11px;"><%= &subs::ui('This is the device you are using') %></div><% } %>
						</td>
						<td><%= &subs::device_kind_label($d) %></td>
						<td class="time" timestamp="<%= $d->{'timestamp'} %>"></td>
						<td class="time" timestamp="<%= $d->{'last_seen'} || $d->{'server_time'} %>"></td>
						<td>Ed25519</td>
						<td><img src="<%= &subs::icon_for('/images/make believe/cancel_button.png') %>" hint="Revoke" class="device_revoke little_thumb hover"></td>
					</tr>
				<% } %>
				<% if (scalar @{ $devices || [] } == 0) { %>
					<tr><td colspan="7">No paired devices. A citizen session pairs its browser the first time the manager loads; after that it logs itself back in.</td></tr>
				<% } %>
			</tbody>
		</table>
	</div>
	<div class="security_view" view="recovery" style="text-align:center;<% unless ( $president->{'security_view'} eq 'recovery' ) { %>display:none;<% } %>">
		<h2>Recovery code</h2>
		<p style="max-width:640px;margin:0 auto;">
			If every pass is lost and no paired device is at hand, the recovery code is the way back in:
			type it at the house's gate and that device is paired on the spot. It is shown once, so write it
			on paper and keep it with your important documents. It stays good until the house key itself is rotated.
		</p>
		<% if ($recovery_stale) { %>
			<p style="color:darkred;"><b>The old code was set aside when the house key changed</b> — it will not work. Make a new one.</p>
		<% } %>
		<% if ($recovery) { %>
			<p>The current code was made <span class="time" timestamp="<%= $recovery->{'server_time'} %>"></span>.</p>
		<% } elsif (!$recovery_stale) { %>
			<p><b>No recovery code exists yet.</b></p>
		<% } %>
		<button id="recovery_create"><%= $recovery ? 'Make a new code' : 'Make a recovery code' %></button>
		<div id="recovery_code_display" style="display:none;margin-top:14px;">
			<p><b>Write this down now — it will not be shown again.</b></p>
			<div id="recovery_code_value" style="display:inline-block;font-family:monospace;font-size:26px;letter-spacing:3px;background-color:var(--panel);border:solid;border-radius:8px;padding:14px;"></div>
		</div>
		<h3 style="margin-top:18px;">Paper shares</h3>
		<p style="max-width:640px;margin:0 auto;">
			<%= &subs::ui('The house key can also be split into five shares: any three rebuild it, and any two reveal nothing. Write each one on a separate sheet and keep them apart. They stay good until the house key is rotated — making a new set does not cancel an older one.') %>
		</p>
		<button id="shares_create" type="button">Make paper shares</button>
		<div id="shares_display" style="display:none;margin-top:14px;">
			<p><b>Write these down now — they will not be shown again.</b></p>
			<pre id="shares_value" style="display:inline-block;text-align:left;font-family:monospace;font-size:13px;background-color:var(--panel);border:solid;border-radius:8px;padding:12px;white-space:pre-wrap;"></pre>
			<div id="shares_qr" style="margin-top:10px;"></div>
			<div id="shares_qr_dir" style="font-size:12px;color:#777;"></div>
		</div>
		<h3 style="margin-top:18px;"><%= &subs::lang('shares.device') %></h3>
		<p style="max-width:640px;margin:0 auto;">
			<%= &subs::ui('A share can live on a person\'s device instead of paper. The device makes a key just for this, this house seals one share to it, and the server never sees the share in the clear. One share per person. Any share that no device takes is still printed below.') %>
		</p>
		<% if ($share_stale) { %>
			<p style="color:darkred;"><b><%= &subs::ui('The house key changed, so the device shares were cleared. Make a new set.') %></b></p>
		<% } %>
		<% my %share_person_name = map { ($_->{'uuid'} || '') => ($_->{'name'} || '') } @{ $people || [] }; %>
		<% if (scalar @{ $share_set || [] } > 0) { %>
			<p style="max-width:640px;margin:0 auto;">
				<%= &subs::ui('Held by devices:') %>
				<% foreach my $s ( @{ $share_set } ) { %>
					<% my $pn = ($s->{'holder_person'} || '') ne '' ? ($share_person_name{$s->{'holder_person'}} || $s->{'holder_person'}) : ''; %>
					<span style="display:inline-block;margin:2px 8px;padding:2px 8px;border:solid 1px;border-radius:6px;">
						#<%= $s->{'share_index'} %> — <%= $pn ne '' ? $pn : &subs::ui('a device') %>
					</span>
				<% } %>
				(<%= $share_k %>/<%= $share_n %>)
			</p>
		<% } %>
		<div style="text-align:center;margin:8px 0;">
			<% my %share_person_seen; %>
			<% foreach my $d ( @{ $share_devices || [] } ) { %>
				<% my $pkey = ($d->{'person_uuid'} || '') ne '' ? 'p:' . $d->{'person_uuid'} : 'd:' . $d->{'uuid'}; %>
				<% my $checked = $share_person_seen{$pkey}++ ? '' : 'checked'; %>
				<label style="display:inline-block;margin:4px 10px;font-size:14px;">
					<input type="checkbox" class="share_device" device="<%= $d->{'uuid'} %>" <%= $checked %>
						title="<%= &subs::ui('Give this device one share') %>">
					<%= $d->{'name'} %><% my $dpn = ($d->{'person_uuid'} || '') ne '' ? ($share_person_name{$d->{'person_uuid'}} || '') : ''; %><% if ($dpn ne '') { %> (<%= $dpn %>)<% } %>
				</label>
			<% } %>
		</div>
		<button id="shares_wrap" type="button"><%= &subs::lang('shares.make.device') %></button>
		<div id="shares_wrap_display" style="display:none;margin-top:14px;">
			<p><b><%= &subs::ui('Write these down now — they will not be shown again.') %></b></p>
			<pre id="shares_wrap_value" style="display:inline-block;text-align:left;font-family:monospace;font-size:13px;background-color:var(--panel);border:solid;border-radius:8px;padding:12px;white-space:pre-wrap;"></pre>
			<div id="shares_wrap_assigned" style="font-size:13px;margin-top:6px;"></div>
			<div id="shares_wrap_qr" style="margin-top:10px;"></div>
			<div id="shares_wrap_qr_dir" style="font-size:12px;color:#777;"></div>
		</div>
		<h4 style="margin-top:18px;"><%= &subs::lang('shares.release') %></h4>
		<p style="max-width:640px;margin:0 auto;">
			<%= &subs::ui('A machine with no key can ask this house for shares. If this device holds one, release it here: it is re-sealed to that machine and never shown to this server.') %>
		</p>
		<div id="share_requests_list" style="max-width:640px;margin:0 auto;">
			<% if (scalar @{ $share_pending || [] } > 0) { %>
				<table style="width:100%;text-align:center;">
					<thead><tr><th><%= &subs::ui('Code') %></th><th><%= &subs::ui('Asking device') %></th><th><%= &subs::ui('Shares') %></th><th></th></tr></thead>
					<tbody>
						<% foreach my $r ( @{ $share_pending } ) { %>
							<tr class="share_request" uuid="<%= $r->{'uuid'} %>" asker="<%= $r->{'asker_pubkey'} %>" set_id="<%= $r->{'set_id'} %>">
								<td style="font-family:monospace;font-size:18px;letter-spacing:2px;"><%= $r->{'code'} %></td>
								<td><%= $r->{'name'} %></td>
								<td><%= $r->{'available'} || 0 %>/<%= $r->{'need'} || 0 %></td>
								<td><button class="share_release" type="button"><%= &subs::lang('shares.release') %></button></td>
							</tr>
						<% } %>
					</tbody>
				</table>
			<% } else { %>
				<p><%= &subs::ui('No device is asking for shares right now.') %></p>
			<% } %>
		</div>
		<button id="share_requests_refresh" type="button"><%= &subs::ui('Refresh') %></button>
		<div id="share_release_note" style="min-height:22px;color:darkred;"></div>
		<h3 style="margin-top:18px;">Sharing</h3>
		<p style="max-width:640px;margin:0 auto;">
			A linked machine that has lost its key can fetch this house key from here while this is ticked. The
			request must carry the machine's pinned signature, and the key is sealed to a one-time secret for the trip.
		</p>
		<label><input type="checkbox" id="vault_share_tick" <% if (($president->{'vault_share'} // 'yes') eq 'yes') { %>checked<% } %>> Linked machines may fetch the key</label>
		<h3 style="margin-top:18px;">Rotation</h3>
		<p style="max-width:640px;margin:0 auto;">
			Rotating replaces the house key with a fresh random one: every sealed value in the database is
			re-sealed, sessions start again (your devices re-admit themselves), and the recovery code above is
			set aside, so write down a new one. The old key stays wrapped under the new one — files and notes
			sealed before the rotation still open, the sealed files themselves re-seal in the background, and
			linked machines are handed the new key.
		</p>
		<button id="rotate_key">Rotate the house key</button>
		<div id="rotate_key_note" style="min-height:22px;color:darkred;"></div>
		<h3 style="margin-top:18px;">Old Seals</h3>
		<p style="max-width:640px;margin:0 auto;">
			Values locked long ago - before this house used its own key - were sealed with a passphrase
			anybody could know. Upgrade Old Seals re-seals any that are left, here and on every linked
			machine; values already under the house key are left alone.
		</p>
		<button id="legacy_reseal">Upgrade Old Seals</button>
		<div id="legacy_reseal_note" style="min-height:22px;color:darkred;"></div>
	</div>
</div>
