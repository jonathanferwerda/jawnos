<% use Mojo::JSON qw/encode_json decode_json/; %>

<div id="security" style="background-color:var(--panel);width:100%;height:100%;overflow:scroll;">
	<div style="position:absolute;width:200px;text-align:right;;right:0px;background-color:var(--panel);">
		<button class="security_view_select" view="padlock" style="<% if ($president->{'security_view'} eq 'padlock') { %>background-color:lightgreen;<% } %>">Padlock</button>
		<button class="security_view_select" view="neighbour_link" style="<% if ($president->{'security_view'} eq 'neighbour_link') { %>background-color:lightgreen;<% } %>">Neighbour</button>
		<button class="security_view_select" view="signatorial" style="<% if ($president->{'security_view'} eq 'signatorial') { %>background-color:lightgreen;<% } %>">Signatorial</button>
		<button class="security_view_select" view="devices" style="<% if ($president->{'security_view'} eq 'devices') { %>background-color:lightgreen;<% } %>">Devices</button>
		<button class="security_view_select" view="recovery" style="<% if ($president->{'security_view'} eq 'recovery') { %>background-color:lightgreen;<% } %>">Recovery</button>
	</div>
	<br><br><br><br>
	<div class="security_view" view="padlock" style="width:100%;position:absolute;bottom:0px;<% unless ( $president->{'security_view'} eq 'padlock' ) { %>display:none;<% } %>">
		<% my $padlock = &subs::db_query('select * from security where level=? limit 1', 'padlock')->hashes->[0]; %>
		<div style="max-width:640px;margin:0 auto 120px auto;text-align:center;">
			<h2>The gate</h2>
			<p style="line-height:1.4;">
				A paired phone or tablet is the key. Tap the padlock on the taskbar to lock
				this screen; double-tap it to lock the whole house. The phone opens the unlock
				page, waits for your tap and fingerprint, and opens only the screen you pick.
				The inactivity timeout is also a whole-house lock. The paper recovery code is
				the emergency way in.
			</p>
			<p id="padlock_set_status" status="<%= $padlock ? 'yes' : 'no' %>">
				<b><%= $padlock ? 'The gate is on.' : 'The gate is off.' %></b>
			</p>
			<button id="padlock_gate_enable" type="button"<% if ($padlock) { %> style="display:none;"<% } %>>Turn the gate on</button>
			<button id="padlock_gate_disable" type="button"<% unless ($padlock) { %> style="display:none;"<% } %>>Turn the gate off</button>
			<br>
			<a href="/manager/security/padlock_key" target="_blank" id="padlock_key_show"
				style="display:inline-block;margin-top:10px;font-size:15px;">Phone unlock page</a>
			<% if (&subs::device_setter() eq 'mobile') { %>
				<div id="padlock_biometric_enroll" style="margin-top:14px;">
					<button id="padlock_biometric_enroll_button" type="button">Enroll this phone's fingerprint</button>
					<div id="padlock_biometric_status" style="font-size:14px;margin-top:6px;"></div>
				</div>
			<% } %>
		</div>
		<% my $selected_contexts = $president->{'padlock_contexts'} || []; %>
		<select id="padlock_contexts" multiple title="General is the whole house; the others are per-app." value="<%= join ',', @{$selected_contexts} %>" style="position:absolute;right:0px;bottom:40px;height:100px;">
			<% foreach my $context ( qw/general gallery music folders/ ) { %>
				<option value="<%= $context %>" <% if (grep { $_ eq $context } @{$selected_contexts}) { %>selected<% } %>><%= &subs::format_name($context) %></option>
			<% } %>
		</select>
		<span style="position:absolute;left:0px;bottom:0px;font-size:14px;" title="Shadow writes what the lock would refuse to the log; Enforce refuses it.">
			Gate
			<select id="padlock_gate">
				<option value="shadow" <% if (($president->{'padlock_gate'} || 'enforce') eq 'shadow') { %>selected<% } %>>Shadow (log only)</option>
				<option value="enforce" <% if (($president->{'padlock_gate'} || 'enforce') eq 'enforce') { %>selected<% } %>>Enforce</option>
			</select>
		</span>
	</div>

	<div class="security_view" view="neighbour_link" style="overflow-x:auto;padding-right:8px;<% unless ( $president->{'security_view'} eq 'neighbour_link' ) { %>display:none;<% } %>">
		<table style="width:100%;table-layout:fixed;text-align:center;"
			<thead>
				<th>Initiator</th><th>Initiated</th><th>Privilege</th><th>Accepted</th><th>Updated</th><th>Cxl</th>
			</thead>
			<tbody>
				
				<% foreach my $nl ( @{$neighbour_link}) { %>
					<tr class="neighbour_link" uuid="<%= $nl->{'uuid'} %>">
						<td><%= $nl->{'initiator'} %></td>
						<td><%= $nl->{'initiated'} %></td>
						<td><img class="neighbour_link_updater medium_thumb" hint="<%= &subs::format_name($nl->{'status'}) %>" src="<%= &subs::icon_for($gb::known_appts->{$nl->{'status'}}->{'icon'}) %>"><br><%= &subs::format_name($nl->{'status'}) %></td>
						<td class="time" timestamp="<%= $nl->{'ost'} %>"></td>
						<td class="time" timestamp="<%= $nl->{'server_time'} %>"></td>
						<td><img src="<%= &subs::icon_for('/images/make believe/cancel_button.png') %>" hint="Close" class="neighbour_link_delete little_thumb"></td>
					</tr>
					<tr style="display:none;" class="neighbour_link_updater_selection" uuid="<%= $nl->{'uuid'} %>">
						<td colspan="6">
							<% foreach my $chair ( keys %{$gb::chairs} ) { %>
								<img class="neighbour_link_privilege_change large_thumb" privilege="<%= $chair %>" hint="<%= &subs::format_name($chair) %>" src="<%= &subs::icon_for($gb::known_appts->{$chair}->{'icon'}) %>">
							<% } %>
						</td>
					</tr>
				<% } %>
			</tbody>
		</table>
	</div>
	<div class="security_view" view="signatorial" style="<% unless ($president->{'security_view'} eq 'signatorial') { %>display:none;<% } %>">
		<% my $signatorials = eval { return decode_json &subs::setting_grabber({ app => 'customs', setting => 'signatorials'}) } || []; %>
		<% 

		%>
		<% foreach my $r ( @{$signatorials} ) { 
			my ($destination,$asset,$type) = &subs::file_device_renamer({ file => $r->{'f'}, app => $r->{'app'}, type => $r->{'type'} });
			my $file = $destination . $asset;
			%>
			<% if (-e $file) { %>
				<img class="signatorial_selection gigantic_thumb" file="<%= $file %>" src="/file_open?file=<%= $file %>&timestamp=<%= $r->{'server_time'} %>&app=<%= $r->{'app'} %>"
					<% if ($file eq $config->{'signatorial'}) { %>
						style="border-width:5px;border-color:yellow;"
					<% } %>>
			<% } else { %>
				@{$signatorials} = grep { $_->{'uuid'} ne $r->{'uuid'} } @{$signatorials};
				my $jsignatorials = encode_json $signatorials;
				&subs::setting_setter({ app => 'customs', setting => 'signatorials', value => $jsignatorials });
			<% } %>
		<% } %>
		<% if (scalar @{$signatorials} == 0) { %>
			No signatorials
		<% } %>





	</div>
	<div class="security_view" view="devices" style="overflow-x:auto;padding-right:8px;<% unless ( $president->{'security_view'} eq 'devices' ) { %>display:none;<% } %>">
		<% if (scalar @{ $requests || [] } > 0) { %>
			<h3>Waiting for approval</h3>
			<table style="width:100%;text-align:center;">
				<thead>
					<th>Name</th><th>Code</th><th>Asked</th><th>Agent</th><th>Approve</th><th>Deny</th>
				</thead>
				<tbody>
					<% foreach my $r ( @{$requests} ) { %>
						<tr class="device_request" uuid="<%= $r->{'uuid'} %>">
							<td><%= $r->{'name'} %></td>
							<td style="font-family:monospace;font-size:22px;letter-spacing:3px;"><%= $r->{'code'} %></td>
							<td class="time" timestamp="<%= $r->{'server_time'} %>"></td>
							<td style="font-size:11px;"><%= substr($r->{'agent'} || '', 0, 60) %></td>
							<td><button class="device_request_decide" decision="approve">Approve</button></td>
							<td><button class="device_request_decide" decision="deny">Deny</button></td>
						</tr>
					<% } %>
				</tbody>
			</table>
			<p style="font-size:14px;">Approve only when the code matches the one shown on the device that is asking.</p>
		<% } %>
		<table style="width:100%;text-align:center;">
			<thead>
				<th>Name</th><th>Paired</th><th>Last Seen</th><th>Key</th><th>Revoke</th>
			</thead>
			<tbody>
				<% foreach my $d ( @{ $devices || [] } ) { %>
					<tr class="paired_device" uuid="<%= $d->{'uuid'} %>">
						<td><%= $d->{'name'} %></td>
						<td class="time" timestamp="<%= $d->{'timestamp'} %>"></td>
						<td class="time" timestamp="<%= $d->{'last_seen'} || $d->{'server_time'} %>"></td>
						<td>Ed25519</td>
						<td><img src="<%= &subs::icon_for('/images/make believe/cancel_button.png') %>" hint="Revoke" class="device_revoke little_thumb hover"></td>
					</tr>
				<% } %>
				<% if (scalar @{ $devices || [] } == 0) { %>
					<tr><td colspan="5">No paired devices. A citizen session pairs its browser the first time the manager loads; after that it logs itself back in.</td></tr>
				<% } %>
			</tbody>
		</table>
	</div>
	<div class="security_view" view="recovery" style="text-align:center;padding:10px;<% unless ( $president->{'security_view'} eq 'recovery' ) { %>display:none;<% } %>">
		<h2>Recovery code</h2>
		<p style="max-width:640px;margin:0 auto;">
			If every ticket is lost and no paired device is at hand, the recovery code is the way back in:
			type it at the house's gate and that device is paired on the spot. It is shown once, so write it
			on paper and keep it with your important documents. It stays good until the house key itself is rotated.
		</p>
		<% if ($recovery_stale) { %>
			<p style="color:darkred;"><b>The old code was set aside when the house key changed</b> — it will not work. Make a new one.</p>
		<% } %>
		<% if ($recovery) { %>
			<p>The current code was made <span class="time" timestamp="<%= $recovery->{'server_time'} %>"></span>.</p>
		<% } elsif (!$recovery_stale) { %>
			<p><b>No recovery code exists yet.</b></p>
		<% } %>
		<button id="recovery_create"><%= $recovery ? 'Make a new code' : 'Make a recovery code' %></button>
		<div id="recovery_code_display" style="display:none;margin-top:14px;">
			<p><b>Write this down now — it will not be shown again.</b></p>
			<div id="recovery_code_value" style="display:inline-block;font-family:monospace;font-size:26px;letter-spacing:3px;background-color:var(--panel);border:solid;border-radius:8px;padding:14px;"></div>
		</div>
		<h3 style="margin-top:18px;">Sharing</h3>
		<p style="max-width:640px;margin:0 auto;">
			A linked machine that has lost its key can fetch this house key from here while this is ticked. The
			request must carry the machine's pinned signature, and the key is sealed to a one-time secret for the trip.
		</p>
		<label><input type="checkbox" id="vault_share_tick" <% if (($president->{'vault_share'} // 'yes') eq 'yes') { %>checked<% } %>> Linked machines may fetch the key</label>
		<h3 style="margin-top:18px;">Rotation</h3>
		<p style="max-width:640px;margin:0 auto;">
			Rotating replaces the house key with a fresh random one: every sealed value in the database is
			re-sealed, sessions start again (your devices re-admit themselves), and the recovery code above is
			set aside, so write down a new one. The old key stays wrapped under the new one — files and notes
			sealed before the rotation still open, the sealed files themselves re-seal in the background, and
			linked machines are handed the new key.
		</p>
		<button id="rotate_key">Rotate the house key</button>
		<div id="rotate_key_note" style="min-height:22px;color:darkred;"></div>
		<h3 style="margin-top:18px;">Old Seals</h3>
		<p style="max-width:640px;margin:0 auto;">
			Values locked long ago - before this house used its own key - were sealed with a passphrase
			anybody could know. Upgrade Old Seals re-seals any that are left, here and on every linked
			machine; values already under the house key are left alone.
		</p>
		<button id="legacy_reseal">Upgrade Old Seals</button>
		<div id="legacy_reseal_note" style="min-height:22px;color:darkred;"></div>
	</div>
</div>
