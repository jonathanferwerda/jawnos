<style>
	/* ---- Terminal ------------------------------------------------------------
	   The canvas is a terminal: dark in either theme, monospace, no chrome in
	   the way. The frame and the toolbar use the app's own theme variables, so
	   the window still belongs to the desk it sits on. */
	.terminal_app {
		--term_bg: #0b0e14;
		--term_bg_soft: #121722;
		--term_ink: #d7dae0;
		--term_dim: #8b93a1;
		--term_accent: #5af78e;
		--term_red: #ff6b6b;
		--term_amber: #f3c969;
		--term_line: #232a38;
		display: flex;
		flex-direction: column;
		position: relative;
		width: 100%;
		height: 100%;
		min-width: 0;
		min-height: 0;
		background: var(--term_bg);
		background-image: none !important;
		color: var(--term_ink);
		font-family: ui-monospace, "SFMono-Regular", "Cascadia Mono", "Liberation Mono", Menlo, Consolas, "Courier New", monospace;
		overflow: hidden;
	}
	.terminal_app .terminal_views {
		position: relative;
		flex: 1 1 auto;
		min-height: 0;
		min-width: 0;
		background: var(--term_bg);
		background-image: none !important;
	}
	.terminal_app .terminal_view {
		position: absolute;
		inset: 0;
		min-height: 0;
	}
	/* ---- the shell --------------------------------------------------------- */
	.terminal_app .terminal_shell_view {
		display: flex;
		flex-direction: column;
		padding: 8px 10px;
		background: var(--term_bg);
		color: var(--term_ink);
		outline: none;
		overflow: hidden;
	}
	.terminal_app .terminal_screen {
		flex: 1 1 auto;
		min-height: 0;
		overflow: hidden;
		white-space: pre;
		font-size: var(--terminal_font, 15px);
		line-height: 1.32;
		letter-spacing: 0;
		tab-size: 8;
		cursor: var(--jawnos-cursor-text, text);
	}
	.terminal_app .term-line {
		white-space: pre;
		height: var(--term-line-height, 1.32em);
		line-height: var(--term-line-height, 1.32em);
	}
	.terminal_app .term-cursor {
		background: var(--term_ink);
		color: var(--term_bg);
		border-radius: 1px;
		animation: terminal_cursor_blink 1.1s steps(1) infinite;
	}
	.terminal_app.term_unfocused .term-cursor { animation: none; opacity: .55; }
	@keyframes terminal_cursor_blink { 0%, 55% { opacity: 1; } 56%, 100% { opacity: 0; } }
	.terminal_app .terminal_keyboard {
		position: absolute;
		left: 8px;
		bottom: 4px;
		width: 2px;
		height: 2px;
		padding: 0;
		margin: 0;
		border: 0;
		opacity: 0;
		background: transparent;
		color: transparent;
		resize: none;
		overflow: hidden;
		z-index: 0;
		font-size: 16px;
	}
	.terminal_app .terminal_jump {
		position: absolute;
		right: 14px;
		bottom: 12px;
		display: none;
		align-items: center;
		gap: 4px;
		padding: 4px 10px;
		border: 1px solid var(--term_line);
		border-radius: 999px;
		background: var(--term_bg_soft);
		color: var(--term_ink);
		font: inherit;
		font-size: 12px;
		cursor: var(--jawnos-cursor-pointer, pointer);
		z-index: 3;
	}
	.terminal_app .terminal_jump[data-show="yes"] { display: inline-flex; }
	/* ---- the command, error and log readers -------------------------------- */
	.terminal_app .terminal_list_view {
		display: flex;
		flex-direction: column;
		background: var(--window, var(--panel));
		color: var(--ink);
		font-family: ui-monospace, "SFMono-Regular", "Cascadia Mono", "Liberation Mono", Menlo, Consolas, "Courier New", monospace;
	}
	.terminal_app .terminal_list_head {
		position: sticky;
		top: 0;
		z-index: 4;
		flex: 0 0 auto;
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 6px 10px;
		background: var(--panel-2);
		color: var(--ink);
		border-bottom: 1px solid var(--line);
		font-size: 13px;
	}
	.terminal_app .terminal_list_title { display: flex; align-items: center; gap: 6px; font-weight: 700; }
	.terminal_app .terminal_prompt {
		display: inline-block;
		padding: 1px 7px;
		border-radius: 4px;
		background: var(--term_amber);
		color: #16181d;
		font-size: 11px;
		font-weight: 800;
		letter-spacing: .02em;
	}
	.terminal_app .terminal_badge {
		display: inline-block;
		min-width: 18px;
		padding: 0 6px;
		border-radius: 999px;
		background: var(--panel);
		border: 1px solid var(--line);
		color: var(--ink-muted);
		font-size: 11px;
		line-height: 17px;
		text-align: center;
	}
	.terminal_app .terminal_clear {
		margin-left: auto;
		flex: 0 0 auto;
		padding: 2px 12px;
		min-height: 24px;
		height: 24px;
		font-size: 12px;
		border-width: 1px !important;
		border-color: var(--line);
		background: var(--panel);
		color: var(--ink);
		cursor: var(--jawnos-cursor-pointer, pointer);
	}
	.terminal_app .terminal_clear:hover { background: var(--panel-2); }
	.terminal_app .terminal_entries {
		flex: 1 1 auto;
		min-height: 0;
		overflow: auto;
		padding: 8px 10px 14px;
		scrollbar-width: thin;
	}
	.terminal_app .terminal_entry {
		display: block;
		margin: 0 0 7px;
		padding: 7px 10px;
		border: 1px solid var(--line);
		border-left: 4px solid var(--line);
		border-radius: 8px;
		background: var(--panel-2);
		font-size: 13px;
		line-height: 1.45;
	}
	.terminal_app .terminal_entry_error { border-left-color: var(--term_red); }
	.terminal_app .terminal_entry_log { border-left-color: #2f9e66; }
	.terminal_app .terminal_entry_command { border-left-color: #4b7bec; }
	.terminal_app .terminal_entry_head {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 4px 9px;
		margin-bottom: 3px;
		color: var(--ink-muted);
		font-size: 11px;
	}
	.terminal_app .terminal_entry_time { font-variant-numeric: tabular-nums; }
	.terminal_app .terminal_entry_code {
		font-weight: 800;
		color: var(--ink);
	}
	.terminal_app .terminal_entry_who { opacity: .8; }
	.terminal_app .terminal_entry_msg {
		white-space: pre-wrap;
		overflow-wrap: anywhere;
		word-break: break-word;
		color: var(--ink);
		font-size: 13px;
	}
	.terminal_app .terminal_entry_more { margin-top: 4px; }
	.terminal_app .terminal_entry_more summary {
		cursor: var(--jawnos-cursor-pointer, pointer);
		font-size: 11px;
		color: var(--ink-muted);
	}
	.terminal_app .terminal_entry_more summary:hover { color: var(--ink); }
	.terminal_app .terminal_entry_more .terminal_entry_msg {
		margin-top: 4px;
		max-height: 40vh;
		overflow: auto;
		padding: 6px 8px;
		border: 1px solid var(--line);
		border-radius: 6px;
		background: var(--panel);
		font-size: 12px;
	}
	.terminal_app .terminal_entry_prompt { color: var(--ink-muted); }
	.terminal_app .terminal_empty {
		padding: 18px 10px;
		color: var(--ink-muted);
		font-size: 13px;
		font-style: italic;
	}
	.terminal_app .terminal_command_row {
		flex: 0 0 auto;
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 6px 10px;
		border-top: 1px solid var(--line);
		background: var(--panel-2);
	}
	.terminal_app .terminal_command_row .terminal_console {
		flex: 1 1 auto;
		min-width: 0;
		height: 30px;
		min-height: 30px;
		padding: 2px 8px;
		border: 1px solid var(--line);
		border-width: 1px !important;
		border-radius: 6px;
		background: var(--panel);
		color: var(--ink);
		font: inherit;
		font-size: 14px;
	}
	.terminal_app .terminal_command_prompt { white-space: nowrap; color: var(--term_accent); font-size: 13px; }
	/* ---- the toolbar ------------------------------------------------------- */
	.terminal_app .terminal_toolbar {
		flex: 0 0 auto;
		display: flex;
		align-items: center;
		gap: 8px;
		position: relative;
		z-index: 10;
		min-height: 44px;
		padding: 4px 8px;
		background: var(--panel-2);
		color: var(--ink);
		border-top: 1px solid var(--line);
		box-sizing: border-box;
	}
	.terminal_app .terminal_status {
		display: flex;
		align-items: center;
		gap: 6px;
		min-width: 0;
		max-width: 34%;
		font-size: 12px;
		color: var(--ink-muted);
	}
	.terminal_app .terminal_shell_status {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		font-family: ui-monospace, "SFMono-Regular", "Cascadia Mono", "Liberation Mono", Menlo, Consolas, monospace;
	}
	.terminal_app .terminal_dot {
		flex: 0 0 auto;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #9aa1ad;
		box-shadow: 0 0 0 2px var(--panel);
	}
	.terminal_app .terminal_dot.local { background: #2f9e66; }
	.terminal_app .terminal_dot.remote { background: #4b7bec; }
	.terminal_app .terminal_dot.connecting { background: var(--term_amber); animation: terminal_pulse 1s ease-in-out infinite; }
	.terminal_app .terminal_dot.ended { background: var(--term_red); }
	@keyframes terminal_pulse { 0%,100% { opacity: 1; } 50% { opacity: .35; } }
	.terminal_app .terminal_toolbar_buttons {
		display: flex;
		align-items: center;
		gap: 3px;
		flex: 1 1 auto;
		min-width: 0;
		overflow-x: auto;
		scrollbar-width: none;
	}
	.terminal_app .terminal_toolbar_buttons::-webkit-scrollbar { display: none; }
	.terminal_app .terminal_view_select {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		flex: 0 0 auto;
		height: 32px;
		min-height: 32px;
		padding: 2px 9px;
		border: 1px solid transparent;
		border-width: 1px !important;
		border-radius: 7px;
		background: transparent;
		color: var(--ink-muted);
		font: inherit;
		font-size: 12px;
		cursor: var(--jawnos-cursor-pointer, pointer);
	}
	.terminal_app .terminal_view_select img { height: 18px; width: 18px; object-fit: contain; border: 0; background: transparent; }
	.terminal_app .terminal_view_select:hover { background: var(--panel); color: var(--ink); }
	.terminal_app .terminal_view_select[selected] {
		background: var(--panel);
		border-color: var(--line);
		color: var(--ink);
		font-weight: 700;
	}
	.terminal_app .terminal_view_select[selected]::after {
		content: "";
		width: 5px;
		height: 5px;
		margin-left: 1px;
		border-radius: 50%;
		background: var(--term_accent);
	}
	.terminal_app .terminal_toolbar_actions { display: flex; align-items: center; gap: 3px; flex: 0 0 auto; }
	.terminal_app .terminal_tool {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 32px;
		min-height: 32px;
		min-width: 32px;
		padding: 0 6px;
		border: 1px solid transparent;
		border-width: 1px !important;
		border-radius: 7px;
		background: transparent;
		color: var(--ink-muted);
		font: inherit;
		font-size: 14px;
		cursor: var(--jawnos-cursor-pointer, pointer);
	}
	.terminal_app .terminal_tool:hover { background: var(--panel); color: var(--ink); }
	.terminal_app .terminal_tool img { height: 18px; width: 18px; border: 0; background: transparent; object-fit: contain; }
	/* ---- the configuration panel ------------------------------------------ */
	.terminal_app .terminal_configure {
		position: absolute;
		left: 8px;
		right: 8px;
		bottom: 52px;
		z-index: 30;
		display: none;
		max-height: calc(100% - 64px);
		overflow: auto;
		background: var(--panel);
		color: var(--ink);
		border: 1px solid var(--line);
		border-radius: 10px;
		box-shadow: 0 14px 44px rgba(0,0,0,.38);
		font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
	}
	.terminal_app .terminal_config_head {
		position: sticky;
		top: 0;
		z-index: 2;
		display: flex;
		align-items: baseline;
		gap: 8px;
		padding: 10px 12px;
		background: var(--panel-2);
		border-bottom: 1px solid var(--line);
	}
	.terminal_app .terminal_config_head b { font-size: 14px; }
	.terminal_app .terminal_config_sub { flex: 1 1 auto; min-width: 0; font-size: 12px; color: var(--ink-muted); }
	.terminal_app .terminal_config_close {
		flex: 0 0 auto;
		height: 24px;
		min-height: 24px;
		padding: 0 8px;
		border-width: 1px !important;
		border-color: var(--line);
		background: var(--panel);
		color: var(--ink);
		font-size: 12px;
		cursor: var(--jawnos-cursor-pointer, pointer);
	}
	.terminal_app .terminal_config_body { padding: 10px 12px 12px; }
	.terminal_app .terminal_config_section { padding: 8px 0; border-bottom: 1px solid var(--line); }
	.terminal_app .terminal_config_section:last-child { border-bottom: 0; }
	.terminal_app .terminal_config_title {
		margin-bottom: 6px;
		font-size: 11px;
		font-weight: 800;
		letter-spacing: .06em;
		text-transform: uppercase;
		color: var(--ink-muted);
	}
	.terminal_app .terminal_local_connect {
		display: flex;
		align-items: center;
		gap: 8px;
		width: 100%;
		padding: 7px 10px;
		border: 1px solid var(--line);
		border-width: 1px !important;
		border-radius: 7px;
		background: var(--panel-2);
		color: var(--ink);
		font: inherit;
		font-size: 13px;
		text-align: left;
		cursor: var(--jawnos-cursor-pointer, pointer);
	}
	.terminal_app .terminal_local_connect:hover { background: var(--panel); }
	.terminal_app .terminal_local_connect.current { border-color: var(--term_accent); }
	.terminal_app .terminal_remote_row {
		display: flex;
		align-items: center;
		gap: 6px;
		flex-wrap: wrap;
		padding: 6px 0;
	}
	.terminal_app .terminal_remote_identity {
		display: flex;
		flex-direction: column;
		min-width: 130px;
		flex: 1 1 150px;
	}
	.terminal_app .terminal_remote_name { font-size: 13px; font-weight: 700; }
	.terminal_app .terminal_remote_addr { font-size: 11px; color: var(--ink-muted); font-family: ui-monospace, monospace; overflow-wrap: anywhere; }
	.terminal_app .terminal_remote_field { display: flex; align-items: center; gap: 4px; font-size: 11px; color: var(--ink-muted); }
	.terminal_app .terminal_remote_field span { white-space: nowrap; }
	.terminal_app .terminal_remote_field input {
		width: 84px;
		height: 28px;
		min-height: 28px;
		padding: 1px 6px;
		border: 1px solid var(--line);
		border-width: 1px !important;
		border-radius: 6px;
		background: var(--panel);
		color: var(--ink);
		font: inherit;
		font-size: 13px;
	}
	.terminal_app .terminal_remote_field.port input { width: 64px; }
	.terminal_app .terminal_remote_connect {
		height: 28px;
		min-height: 28px;
		padding: 0 12px;
		border-width: 1px !important;
		border-color: var(--line);
		background: var(--panel-2);
		color: var(--ink);
		font-size: 12px;
		font-weight: 700;
		cursor: var(--jawnos-cursor-pointer, pointer);
	}
	.terminal_app .terminal_remote_connect:hover { background: var(--term_accent); color: #16181d; }
	.terminal_app .terminal_session_row {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 5px 0;
		border-bottom: 1px dashed var(--line);
	}
	.terminal_app .terminal_session_label {
		flex: 1 1 auto;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-family: ui-monospace, "SFMono-Regular", "Cascadia Mono", "Liberation Mono", Menlo, Consolas, monospace;
		font-size: 13px;
	}
	.terminal_app .terminal_session_state { flex: 0 0 auto; font-size: 11px; color: var(--ink-muted); }
	.terminal_app .terminal_session_open {
		flex: 0 0 auto;
		height: 28px;
		min-height: 28px;
		padding: 0 12px;
		border-width: 1px !important;
		border-color: var(--line);
		background: var(--panel-2);
		color: var(--ink);
		font-size: 12px;
		font-weight: 700;
		cursor: var(--jawnos-cursor-pointer, pointer);
	}
	.terminal_app .terminal_session_open:hover { background: var(--term_accent); color: #16181d; }
	.terminal_app .terminal_session_open:disabled { opacity: .42; cursor: var(--jawnos-cursor-default, default); background: var(--panel-2); color: var(--ink-muted); }
	.terminal_app .terminal_session_end {
		flex: 0 0 auto;
		height: 28px;
		min-height: 28px;
		padding: 0 10px;
		border-width: 1px !important;
		border-color: var(--line);
		background: var(--panel-2);
		color: var(--ink-muted);
		font-size: 12px;
		cursor: var(--jawnos-cursor-pointer, pointer);
	}
	.terminal_app .terminal_session_end:hover { background: var(--term_red); color: #16181d; }
	.terminal_app .terminal_config_hint { margin-top: 6px; font-size: 11px; color: var(--ink-muted); }
	.terminal_app .terminal_config_type { display: flex; align-items: center; gap: 8px; font-size: 12px; }
	.terminal_app .terminal_font_button {
		height: 26px;
		min-height: 26px;
		min-width: 34px;
		padding: 0 8px;
		border-width: 1px !important;
		border-color: var(--line);
		background: var(--panel-2);
		color: var(--ink);
		font-size: 13px;
		cursor: var(--jawnos-cursor-pointer, pointer);
	}
	.terminal_app .terminal_font_size { min-width: 34px; text-align: center; font-variant-numeric: tabular-nums; color: var(--ink-muted); }
	/* Narrow windows keep the icons and drop the words, so every control stays
	   reachable instead of the toolbar overflowing. */
	@media (max-width: 560px) {
		.terminal_app .terminal_view_select span { display: none; }
		.terminal_app .terminal_view_select { padding: 2px 7px; }
		.terminal_app .terminal_status { max-width: 30%; }
		.terminal_app .terminal_view_select[selected]::after { display: none; }
	}
</style>
