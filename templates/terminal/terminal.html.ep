<div id="terminal" style="background-color:black;opacity:.8;width:100%;height:100%;">
	<div class="terminal_view" view="interactive_terminal" id="terminal_interactive" tabindex=0 style="<% if ($settings->{'view'} ne 'interactive_terminal') { %>display:none;<% } %>position:absolute;overflow:scroll;font-size:20px;color:white;background-color:black;height: 85%;width:98%; max-height:100%;">

	</div>
	<div class="terminal_view" view="terminal" id="terminal_view" style="<% if ($settings->{'view'} ne 'terminal') { %>display:none;<% } %>position:absolute;overflow:scroll;font-size:20px;color:white;background-color:black;height: 85%;width:100%; max-height:100%;">
		<span style="color:black;background-color:yellow;">President: </span>Commands</span>
	</div>

	<div class="terminal_view" view="errors" id="terminal_error_view" style="<% if ($settings->{'view'} ne 'errors') { %>display:none;<% } %>position:absolute;overflow:scroll;font-size:20px;color:white;background-color:black;height: 85%;width:100%; max-height:100%;">
		<span style="color:black;background-color:yellow;">President: </span>Error log
		<button style="float:right;" class="terminal_clear">Clear</button>
		<br>

		<% foreach my $err ( @{$settings->{'errors'}} ) { %>
			<%= include 'terminal/error', err => $err %>
		<% } %>
	</div>
	<div class="terminal_view" view="log" id="terminal_log_view" style="<% if ($settings->{'view'} ne 'log') { %>display:none;<% } %>position:absolute;overflow:scroll;font-size:20px;color:white;background-color:black;height: 85%;width:100%; max-height:100%;">
		<span style="color:black;background-color:yellow;">President: </span>Log
		<button style="float:right;" class="terminal_clear">Clear</button>
		<br>

		<% foreach my $log ( @{$settings->{'log'}} ) { %>
			<%= include 'terminal/log', 'log' => $log %>
		<% } %>
	</div>

	<br>
	<div id="terminal_input" style="text-align:left;width:100%; bottom:0px; position:absolute; background-color:black;">
		<input class="" style="font-size:22px;text-align:left;" id="terminal_console" placeholder="<%= $whoami . '@' . $hostname %>"></input>
		<img src="<%= &subs::icon_for('/images/make believe/monitor.png') %>" hint="Interactive" <% if($settings->{'view'} eq 'interactive_terminal') { %>selected<% } %> class="little_thumb terminal_view_select hover" view="interactive_terminal">
		<img src="<%= &subs::icon_for('/images/decipherable/code.png') %>" hint="Terminal" <% if ($settings->{'view'} eq 'terminal') {%>selected<% } %> class="little_thumb terminal_view_select hover" view="terminal">
		<img src="<%= &subs::icon_for('/images/make believe/explosion.png') %>" hint="Errors" <% if ($settings->{'view'} eq 'errors') {%>selected<% } %> class="little_thumb terminal_view_select hover" view="errors">
		<img src="<%= &subs::icon_for('/images/decipherable/list.png') %>" hint="Log" <% if ($settings->{'view'} eq 'log') {%>selected<% } %> class="little_thumb terminal_view_select hover" view="log">
		<img src="<%= &subs::icon_for('/images/decipherable/server.png') %>" hint="Server" class="little_thumb hover" id="terminal_configure_toggle">
	</div>
	<div id="terminal_configure_container" style="width:100%;height:30%;position:absolute;bottom:40px;left:0px;">
		<%= include 'terminal/configure', settings => $settings %>
	</div>
</div>