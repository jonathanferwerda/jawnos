<%= include 'terminal/style' %>

<%
	my $active_view = $settings->{'view'} || 'interactive_terminal';
	my $error_count = defined $c->stash('errors_total') ? $c->stash('errors_total') : scalar(@{$settings->{'errors'} || []});
	my $log_count = defined $c->stash('logs_total') ? $c->stash('logs_total') : scalar(@{$settings->{'log'} || []});
	my $errors_shown = scalar(@{$settings->{'errors'} || []});
	my $logs_shown = scalar(@{$settings->{'log'} || []});
	my $active_shell = $current || { user => $whoami, host => $hostname, label => $whoami . '@' . $hostname, local => 1 };
	my $me = $local || { user => $whoami, host => $hostname, label => $whoami . '@' . $hostname, local => 1 };
	my $machine_list = $remotes || [];
	my $session_rows = $c->stash('open_sessions') || [];
%>

<%= include 'terminal/body', active_shell => $active_shell, active_view => $active_view, error_count => $error_count, errors_shown => $errors_shown, log_count => $log_count, logs_shown => $logs_shown, machine_list => $machine_list, me => $me, session_rows => $session_rows %>
</div>
