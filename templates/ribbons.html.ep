<div id="bottom_ribbon" class="store_customer_bar">
	<% if (($c->session('privilege') || '') eq 'citizen') { %>
		<button type="button" id="store_register_bottom_open" class="customer_action" title="<%= &subs::lang('common.register') %>">
			<img src="<%= &subs::icon_for('/images/decipherable/cash.png') %>" alt="">
			<span><%= &subs::lang('common.register') %></span>
		</button>
		<span id="customer" class="store_customer_name"></span>
		<div id="dock"></div>
		<div class="store_customer_search">
			<input type="search" id="customer_search" placeholder="<%= &subs::ui('Search customers') %>" autocomplete="off">
			<img src="<%= &subs::icon_for('/images/make believe/cancel_button.png') %>" hint="<%= &subs::lang('common.close') %>" id="customer_cancel" class="little_thumb hover" style="display:none;">
			<span id="customer_search_results" class="search_results" style="display:none;"><%= &subs::ui('Results') %></span>
		</div>
	<% } %>
</div>
