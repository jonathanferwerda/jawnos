<style>
	#box_office.bo_shell {
		display: block;
		width: 100%;
		height: 100%;
		box-sizing: border-box;
		padding: 14px;
		overflow-x: auto;
		overflow-y: auto;
		color: var(--ink);
	}

	#box_office .bo_head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		flex-wrap: wrap;
		margin-bottom: 14px;
	}
	#box_office .bo_brand { display: flex; align-items: center; gap: 10px; min-width: 0; }
	#box_office .bo_mark { width: 38px; height: 38px; object-fit: contain; flex: 0 0 auto; }
	#box_office .bo_title { margin: 0; font-size: 22px; line-height: 1.1; font-weight: 700; }
	#box_office .bo_sub { font-size: 12px; color: var(--ink-muted); margin-top: 2px; }

	#box_office .bo_tabs { display: flex; gap: 6px; flex-wrap: wrap; }
	#box_office .bo_tab {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		height: 34px;
		padding: 0 14px;
		font-size: 14px;
		line-height: 1;
		background: var(--panel);
		color: var(--ink);
		border: 1px solid var(--line);
		border-radius: 999px !important;
		cursor: var(--jawnos-cursor-pointer, pointer);
	}
	#box_office .bo_tab:hover { background: var(--panel-2, var(--panel)); }
	#box_office .bo_tab.on { background: var(--accent, #4a90d9); color: #fff; border-color: transparent; }
	#box_office .bo_count {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 20px;
		height: 20px;
		padding: 0 6px;
		border-radius: 999px;
		background: color-mix(in srgb, var(--ink) 14%, transparent);
		font-size: 11px;
		font-weight: 700;
	}
	#box_office .bo_tab.on .bo_count { background: rgba(255,255,255,.24); }
	#box_office .bo_count_alert { background: #b0342e; color: #fff; }

	#box_office .bo_card {
		background: var(--panel-2, var(--panel));
		border: 1px solid var(--line);
		border-radius: 12px;
		padding: 14px;
		margin: 0 0 14px;
	}
	#box_office .bo_card_head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 10px;
		flex-wrap: wrap;
		margin-bottom: 10px;
	}
	#box_office .bo_card_head h3 { margin: 0; font-size: 16px; line-height: 1.2; }
	#box_office .bo_muted, #box_office .bo_hint { color: var(--ink-muted); font-size: 12px; }
	#box_office .bo_hint { max-width: 680px; margin: 0 0 10px; line-height: 1.45; }
	#box_office .bo_empty { text-align: center; color: var(--ink-muted); font-size: 13px; padding: 18px 8px; }

	#box_office .bo_form {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		gap: 10px 12px;
		align-items: end;
	}
	#box_office .bo_field { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
	#box_office .bo_field > span { font-size: 11px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--ink-muted); }
	#box_office .bo_field_wide { min-width: 190px; }
	#box_office .bo_field_inline { flex-direction: row; align-items: center; gap: 8px; }
	#box_office select, #box_office input[type=text] {
		font-size: 14px;
		min-height: 34px;
		height: auto;
		text-align: left;
		padding: 4px 8px;
		background: var(--panel);
		color: var(--ink);
		border: 1px solid var(--line);
		border-radius: 8px;
	}
	#box_office input[type=text] { box-sizing: border-box; }
	#box_office .bo_select_sm { font-size: 12px; min-height: 28px; padding: 2px 6px; border-radius: 7px; }
	#box_office .bo_input_sm { font-size: 12px; min-height: 28px; padding: 2px 6px; border-radius: 7px; width: 70px; }

	#box_office .bo_form_action { grid-column: 1 / -1; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-top: 2px; }
	#box_office .bo_primary {
		font-size: 14px;
		height: 36px;
		padding: 0 16px;
		background: var(--accent, #4a90d9);
		color: #fff;
		border-color: transparent !important;
		cursor: var(--jawnos-cursor-pointer, pointer);
	}
	#box_office .bo_primary:hover { filter: brightness(1.06); }
	#box_office .bo_primary:disabled { opacity: .6; cursor: var(--jawnos-cursor-default, default); }
	#box_office .bo_statusline { font-size: 12px; color: var(--ink-muted); }

	#box_office .bo_acc { margin-top: 12px; border-top: 1px solid var(--line); padding-top: 8px; }
	#box_office summary { cursor: var(--jawnos-cursor-pointer, pointer); list-style: none; user-select: none; }
	#box_office summary::-webkit-details-marker { display: none; }
	#box_office .bo_acc > summary {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: .03em;
		text-transform: uppercase;
		color: var(--ink-muted);
		padding: 2px 0;
	}
	#box_office .bo_acc > summary::before { content: '\25B8'; font-size: 13px; transition: transform .15s ease; }
	#box_office .bo_acc[open] > summary::before { content: '\25BE'; }
	#box_office .bo_acc_meta { margin-left: auto; font-weight: 600; text-transform: none; letter-spacing: 0; }
	#box_office .bo_acc_body { display: flex; align-items: end; flex-wrap: wrap; gap: 12px 16px; padding: 10px 2px 2px; }
	#box_office .bo_ip_line { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; padding-bottom: 6px; }
	#box_office #ticket_network_ip { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 14px; font-weight: 700; }

	#box_office .bo_table_wrap { overflow-x: auto; }
	#box_office table.bo_table { width: 100%; border-collapse: collapse; font-size: 13px; }
	#box_office table.bo_table th {
		text-align: left;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: .06em;
		text-transform: uppercase;
		color: var(--ink-muted);
		padding: 7px 8px;
		border-bottom: 2px solid var(--line);
		white-space: nowrap;
	}
	#box_office table.bo_table td { padding: 7px 8px; border-bottom: 1px solid var(--line); vertical-align: middle; }
	#box_office table.bo_table tbody tr:hover { background: color-mix(in srgb, var(--line) 28%, transparent); }
	#box_office table.bo_table tbody tr[data-status=active] { background: color-mix(in srgb, #2e7d32 7%, transparent); }
	#box_office table.bo_table tbody tr[data-status=suspended] { background: color-mix(in srgb, #b0342e 7%, transparent); }
	#box_office table.bo_table tbody tr[data-status=expired],
	#box_office table.bo_table tbody tr[data-status=rotated] { opacity: .74; }

	#box_office .bo_qr_cell { width: 48px; }
	#box_office .bo_qr_cell .bo_qr { width: 38px; height: 38px; object-fit: contain; cursor: zoom-in; }
	#box_office .bo_ticket_name { display: block; font-size: 14px; font-weight: 600; line-height: 1.2; }
	#box_office .bo_ticket_app { display: block; font-size: 11px; color: var(--ink-muted); margin-top: 1px; }
	#box_office .bo_contact { font-size: 12px; line-height: 1.4; }
	#box_office .bo_description { max-width: 300px; overflow-wrap: break-word; font-size: 12px; }
	#box_office .bo_duration { display: block; margin-top: 2px; }

	#box_office .bo_status, #box_office .bo_chip {
		display: inline-block;
		padding: 1px 8px;
		border-radius: 999px;
		font-size: 11px;
		font-weight: 700;
		background: var(--panel);
		border: 1px solid var(--line);
		white-space: nowrap;
	}
	#box_office .bo_status { text-transform: capitalize; }
	#box_office .bo_status[data-status=active] { background: #2e7d32; color: #fff; border-color: transparent; }
	#box_office .bo_status[data-status=suspended] { background: #b0342e; color: #fff; border-color: transparent; }
	#box_office .bo_status[data-status=expired] { background: #6f6f6f; color: #fff; border-color: transparent; }
	#box_office .bo_status[data-status=rotated] { background: #6a55c9; color: #fff; border-color: transparent; }

	#box_office .bo_log { max-width: 220px; }
	#box_office .bo_log > summary { display: flex; align-items: center; gap: 5px; font-size: 12px; color: var(--ink-muted); }
	#box_office .bo_log > summary::before { content: '\25B8'; font-size: 11px; }
	#box_office .bo_log[open] > summary::before { content: '\25BE'; }
	#box_office .bo_log_count { color: var(--ink-muted); font-size: 11px; }
	#box_office .bo_log_body { max-height: 150px; overflow: auto; margin-top: 4px; padding: 4px 6px; border: 1px solid var(--line); border-radius: 7px; background: var(--panel); }
	#box_office .bo_log_ip { display: flex; justify-content: space-between; gap: 10px; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 11px; padding: 1px 0; }

	#box_office .bo_actions { white-space: nowrap; }
	#box_office .bo_actions > * { margin: 2px 3px 2px 0; }
	#box_office .bo_actions .bo_link { font-size: 12px; }
	#box_office .bo_small {
		font-size: 12px;
		height: 28px;
		min-width: 0;
		padding: 0 8px;
		cursor: var(--jawnos-cursor-pointer, pointer);
		border-width: 1px !important;
		border-radius: 7px;
	}
	#box_office .bo_danger[armed=yes] { background: #b0342e; color: #fff; border-color: transparent !important; }

	#box_office .bo_policy { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
	#box_office .bo_check { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; cursor: var(--jawnos-cursor-pointer, pointer); }
	#box_office .bo_check input { width: 22px; height: 22px; }

	#box_office .bo_crest_cell { max-width: 220px; }
	#box_office .bo_crest { display: flex; flex-direction: column; gap: 3px; align-items: flex-start; font-size: 12px; }
	#box_office .bo_fingerprint { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 10px; overflow-wrap: anywhere; color: var(--ink-muted); max-width: 100%; }
	#box_office .bo_crest_state { font-size: 11px; color: var(--ink-muted); }
	#box_office .bo_crest_chips { display: flex; flex-wrap: wrap; gap: 2px; }
	#box_office .bo_age_cell { white-space: nowrap; }
	#box_office .bo_age_cell > * { vertical-align: middle; }

	#box_office .bo_inline_form { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin: 4px 0 10px; }
	#box_office .bo_inline_form input { width: auto; }
	#box_office #blocked_number_input { width: 160px; }
	#box_office #blocked_number_note { width: 200px; }
	#box_office .bo_chips { display: flex; flex-wrap: wrap; gap: 6px; }
	#box_office .blocked_number {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		border: 1px solid var(--line);
		border-radius: 999px;
		padding: 3px 4px 3px 10px;
		font-size: 12px;
		background: var(--panel);
	}

	#box_office button:active { transform: translateY(1px); border-color: var(--line); }
</style>
