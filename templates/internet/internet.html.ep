<%
	my $websites = &subs::db_query('select * from websites order by timestamp desc')->hashes || [];
%>
<style>
/* The Web/Browse tabs sit under the window's own title bar, like every other
   app, so the window can be moved, minimised and closed from its bar. */
/* The site's app is picked by typing, the way the dock's search works: an
   input, and the matching apps under it. */
.internet_site_picker { position:relative; display:inline-block; min-width:120px; width:100%; }
.internet_site_app_input { width:100%; box-sizing:border-box; padding:4px 6px; }
.internet_app_results { position:absolute; left:0; right:0; top:100%; z-index:60; background:var(--panel); border:1px solid var(--line); max-height:190px; overflow:auto; display:none; }
.internet_app_result { padding:5px 7px; cursor:pointer; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.internet_app_result:hover, .internet_app_result.selected { background:var(--panel-2); }
.internet_app_clear { opacity:0.7; }
</style>
<div id="internet" style="position:relative;width:100%;height:100%;background-color:var(--panel);">
	<div id="internet_tabs" style="display:flex;gap:6px;padding:8px 10px;border-bottom:1px solid var(--line);">
		<span class="internet_tab selected" data-internet-tab="web" onclick="internetTab('web');"><%= &subs::lang('web') %></span>
		<span class="internet_tab" data-internet-tab="browse" onclick="internetTab('browse');"><%= &subs::lang('browse') %></span>
	</div>

	<div id="internet_web" class="internet_pane" style="padding:10px;overflow:auto;height:calc(100% - 50px);">
		<div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
			<img class="little_thumb hover" src="<%= &subs::icon_for('/images/decipherable/measures.png') %>" hint="<%= &subs::lang('open_browser') %>" onclick="internetOpenWeb();">
			<span><%= &subs::ui('Pages the house fetched, ready to open or measure.') %></span>
		</div>
		<table style="width:100%;">
			<thead><tr><th><%= &subs::ui('App') %></th><th><%= &subs::ui('Address') %></th><th><%= &subs::ui('Saved') %></th><th></th></tr></thead>
			<tbody>
				<% foreach my $web ( @{$websites} ) { %>
					<tr class="internet_saved" data-url="<%= &subs::html_text($web->{'url'}) %>" data-app="<%= &subs::html_text($web->{'app'}) %>" data-uuid="<%= &subs::html_text($web->{'uuid'}) %>">
						<td><a href="#" class="internet_open_app" data-app="<%= &subs::html_text($web->{'app'}) %>"><%= &subs::format_name($web->{'app'}) %></a></td>
						<td style="word-break:break-all;"><a href="#" class="internet_open_url" data-url="<%= &subs::html_text($web->{'url'}) %>"><%= &subs::html_text($web->{'url'}) %></a></td>
						<td class="time" timestamp="<%= $web->{'timestamp'} %>"></td>
						<td style="white-space:nowrap;">
							<img class="tiny_thumb hover" src="<%= &subs::icon_for('/images/decipherable/home.png') %>" hint="<%= &subs::lang('open_browser') %>" onclick="internetOpenSaved(this,'browse');">
							<img class="tiny_thumb hover" src="<%= &subs::icon_for('/images/decipherable/measures.png') %>" hint="<%= &subs::lang('measure_page') %>" onclick="internetOpenSaved(this,'measure');">
						</td>
					</tr>
				<% } %>
			</tbody>
		</table>
	</div>

	<div id="internet_browse" class="internet_pane" style="display:none;padding:10px;overflow:auto;height:calc(100% - 50px);">
		<div style="display:flex;gap:8px;align-items:center;margin-bottom:8px;">
			<input id="internet_url" type="text" placeholder="https://" style="flex:1;padding:8px;" onkeydown="if(event.key==='Enter'){internetGo();}">
			<button onclick="internetGo();"><%= &subs::lang('open_browser') %></button>
		</div>
		<p style="opacity:0.75;"><%= &subs::ui('Time is counted in the JawnOS browser only. Other browsers are not counted.') %></p>
		<h4><%= &subs::lang('usage_today') %></h4>
		<table id="internet_sites" style="width:100%;">
			<thead><tr><th><%= &subs::ui('Site') %></th><th><%= &subs::ui('App') %></th><th><%= &subs::lang('time_spent') %></th><th></th></tr></thead>
			<tbody></tbody>
		</table>
		<p id="internet_usage_none" style="display:none;opacity:0.75;"><%= &subs::lang('usage_none') %></p>
	</div>
</div>
