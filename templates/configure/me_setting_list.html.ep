<% use Mojo::JSON qw/decode_json/; %>
<div class="cfg">
	<h2>Me</h2>
	<p class="cfg-note">Your personal details, kept per device. Change one device's setting, or tick Anchor to copy a change to every device at once.</p>

	<div class="cfg-row">
		<label>Anchor</label>
		<span><input type="checkbox" class="anchor_all_settings" setting_type="me"></span>
	</div>

	<% foreach my $d ( @gb::device_types ) { %>
		<div class="cfg-card">
			<h3><%= $d %></h3>
			<% foreach my $m ( sort keys %{$me->{$d}} ) { %>
				<% unless ( $m eq 'pos' || $m eq 'gallery_appts' || $m eq 'currency' || $m eq 'unit' || $m eq 'budget_alarm' || $m eq 'log_me' || $m eq 'advertise_watching' || $m eq 'mugshot' || $m eq 'home_plate' || $m eq 'information' ) { %>
					<div class="cfg-row">
						<label><%= &subs::format_name($m) %></label>
						<input type="text" name="name" class="me_setting" device="<%= $d %>" setting="<%= $m %>" value="<%= $me->{$d}->{$m} %>">
					</div>
				<% } elsif ( $m eq 'unit' ) { %>
					<div class="cfg-row">
						<label><%= &subs::format_name($m) %></label>
						<select name="unit" class="me_setting" device="<%= $d %>" setting="<%= $m %>" value="<%= $me->{$d}->{$m} %>">
							<% foreach my $u ( sort keys %{$gb::measures} ) { %>
								<option value="<%= $u %>" <% if ($me->{$d}->{$m} eq $u) { %>selected<% } %>><%= &subs::format_name($gb::measures->{$u}->{'name'}) %></option>
							<% } %>
						</select>
					</div>
				<% } elsif ( $m eq 'currency' ) { %>
					<div class="cfg-row">
						<label><%= &subs::format_name($m) %></label>
						<select name="currency" class="me_setting" device="<%= $d %>" setting="<%= $m %>" value="<%= $me->{$d}->{$m} %>">
							<% foreach my $dolla ( keys %{$gb::measures} ) { %>
								<% if (grep { $_ eq $m } @{$gb::measures->{$dolla}->{'types'}}) { %>
									<option value="<%= $dolla %>" <% if ($me->{$d}->{$m} eq $dolla) { %>selected<% } %>><%= &subs::format_name($gb::measures->{$dolla}->{'name'}) %></option>
								<% } %>
							<% } %>
						</select>
					</div>
				<% } elsif ( $m eq 'log_me' || $m eq 'gallery_appts' || $m eq 'budget_alarm' ) { %>
					<div class="cfg-row">
						<label><%= &subs::format_name($m) %></label>
						<span><input type="checkbox" name="name" class="me_setting" device="<%= $d %>" setting="<%= $m %>" <% if ( $me->{$d}->{$m} eq 'on' ) { %>checked <% } %> value="<%= $me->{$d}->{$m} %>"></span>
					</div>
				<% } elsif ( $m eq 'advertise_watching') { %>
					<div class="cfg-row">
						<label><%= &subs::format_name($m) %></label>
						<span><input type="checkbox" name="name" class="me_setting" device="<%= $d %>" setting="<%= $m %>" <% if ( $me->{$d}->{$m} eq 'on' ) { %>checked <% } %> value="<%= $me->{$d}->{$m} %>"></span>
					</div>
					<script>
						$(document).on('change', '.me_setting[device="<%= $device %>"][setting="advertise_watching"]', function() {
							if ($(this).is(':checked')) {
								advertise_watching = 'on';
							}
							else {
								advertise_watching = 'off';
							}
						});
					</script>
				<% } elsif ( $m eq 'mugshot') { %>
					<div class="cfg-row">
						<label><%= &subs::format_name($m) %></label>
						<img src="<%= &Manager::mugshot_source($d) || '/images/make believe/face.png' %>" class="large_thumb me_setting mugshot_upload_button"
							device="<%= $d %>" setting="<%= $m %>">
					</div>
					<div class="mugshot_upload_container" device="<%= $d %>">
						<form class="mugshot_upload" device="<%= $d %>" setting="<%= $m %>" style="display:none;">
							<input class="mugshot_upload_input" device="<%= $d %>" setting="<%= $m %>" type="file" name="fileupload" />
							<input type="submit" />
						</form>
					</div>
				<% } elsif ( $m eq 'home_plate' ) { %>
					<div class="cfg-row">
						<label><%= &subs::format_name($m) %></label>
						<img <% if ($me->{$d}->{$m}) { %> style="background-color:lightgreen;" <% } %> src="<%= &subs::icon_for('/images/make believe/gps.png') %>" hint="Location" device="<%= $d %>" setting="<%= $m %>" class="medium_thumb home_plate_record">
					</div>
					<% if ($me->{$d}->{$m}) { %>
						<% my $location = eval { return decode_json $me->{$d}->{$m} } || {}; %>
						<div class="cfg-row">
							<label>lat</label>
							<input type="text" class="manual_home_plate" app="me" setting="latitude" value="<%= $location->{'latitude'} %>" device="<%= $d %>">
						</div>
						<div class="cfg-row">
							<label>long</label>
							<input type="text" class="manual_home_plate" app="me" setting="longitude" value="<%= $location->{'longitude'} %>" device="<%= $d %>">
						</div>
					<% } %>

				<% } elsif ( $m eq 'information' ) { %>
					<div class="cfg-row">
						<label><%= &subs::format_name($m) %></label>
						<textarea class="me_setting" setting="information" device="<%= $d %>"><%= $me->{$d}->{$m} %></textarea>
					</div>
				<% } else { %>
					<div class="cfg-row">
						<label>Part of Speech</label>
						<select name="pos" class="me_setting" setting="pos" device="<%= $d %>" value="<%= $me->{$d}->{$m} %>">
							<% foreach my $p ( keys %{$pos_list} ) { %>
								<option <% if ($p eq $me->{$d}->{$m}) { %>selected<% } %> value="<%= $p %>"><%= &subs::format_name($p) %></option>
							<% } %>
						</select>
					</div>
				<% } %>
			<% } %>
		</div>
	<% } %>
</div>
