<% use Mojo::JSON qw/decode_json/; %>
<style>
/* One card per device. The plainly-valued settings share a wrapping field grid
   (the Pseud panel's shape); a checkbox, the mugshot, the home plate and the
   free-text note each get their own row. */
#me_setting_list .me_grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(190px, 1fr)); gap:8px 10px; margin:0 0 10px; }
#me_setting_list .me_field { display:flex; flex-direction:column; gap:3px; min-width:0; font-size:12.5px; opacity:.85; }
#me_setting_list .me_field > input, #me_setting_list .me_field > select { width:100%; box-sizing:border-box; padding:6px 8px; border-radius:6px; border:1px solid var(--line); background:var(--panel); color:var(--ink); font:inherit; line-height:1.3; }
#me_setting_list .me_checks { display:flex; flex-wrap:wrap; gap:6px 18px; margin:0 0 4px; }
#me_setting_list .me_checks label { display:inline-flex; align-items:center; gap:6px; font-size:13px; }
#me_setting_list .me_timezone { min-width:240px; font:inherit; padding:6px 8px; border-radius:6px; border:1px solid var(--line); background:var(--panel); color:var(--ink); }
#me_setting_list .me_timezone_note { margin-left:8px; font-size:12px; opacity:.8; }
#me_setting_list .tax_catalog_card h3 { margin:0 0 6px; font-size:15px; }
#me_setting_list .tax_catalog_row { display:flex; flex-wrap:wrap; gap:6px; align-items:center; margin:0 0 6px; }
#me_setting_list .tax_catalog_row > input[type=text] { box-sizing:border-box; padding:6px 8px; border-radius:6px; border:1px solid var(--line); background:var(--panel); color:var(--ink); font:inherit; line-height:1.3; }
#me_setting_list .tax_catalog_code { flex:0 1 110px; }
#me_setting_list .tax_catalog_name { flex:1 1 170px; min-width:120px; }
#me_setting_list .tax_catalog_rate { flex:0 1 78px; }
#me_setting_list .tax_catalog_country { flex:0 1 86px; }
#me_setting_list .tax_catalog_default { display:inline-flex; align-items:center; gap:5px; font-size:13px; }
#me_setting_list .tax_catalog_remove { flex:0 0 auto; line-height:1; padding:5px 9px; }
#me_setting_list .tax_catalog_status { margin-left:8px; font-size:12px; opacity:.8; }
</style>
<div class="cfg">
	<h2>Me</h2>
	<p class="cfg-note">Your personal details, kept per device. Change one device's setting, or tick Anchor to copy a change to every device at once.</p>

	<div class="cfg-row">
		<label>Anchor</label>
		<span><input type="checkbox" class="anchor_all_settings" setting_type="me"></span>
	</div>

	<%# One house list, not a card per device: the Store, an invoice and a
	    customer's exemption all read it. The rate keeps the raw text the person
	    typed (13 or 13%); the catalog read normalizes it. %>
	<% my $tax_catalog = &subs::tax_catalog(); %>
	<div class="cfg-card tax_catalog_card" id="me_tax_card">
		<h3><%= &subs::ui('Taxes') %></h3>
		<p class="cfg-note"><%= &subs::ui('The tax list for the whole house. A rate is a percent, so 13 means 13%. Until you save, it suggests common rates for the home currency.') %></p>
		<div class="tax_catalog_rows">
			<% foreach my $tax ( @{$tax_catalog} ) { %>
				<% my $rate_text = $tax->{'rate'} // ''; $rate_text =~ s/0+$// if $rate_text =~ /\./; $rate_text =~ s/\.$//; %>
				<div class="tax_catalog_row">
					<input type="text" class="tax_catalog_code" value="<%= $tax->{'code'} %>" placeholder="<%= &subs::ui('Code') %>" aria-label="<%= &subs::ui('Code') %>" maxlength="40">
					<input type="text" class="tax_catalog_name" value="<%= $tax->{'name'} %>" placeholder="<%= &subs::ui('Name') %>" aria-label="<%= &subs::ui('Name') %>">
					<input type="text" class="tax_catalog_rate" value="<%= $rate_text %>" placeholder="13%" aria-label="<%= &subs::ui('Rate') %>">
					<input type="text" class="tax_catalog_country" value="<%= $tax->{'country'} %>" placeholder="<%= &subs::ui('Country') %>" aria-label="<%= &subs::ui('Country') %>" maxlength="2">
					<label class="tax_catalog_default"><input type="checkbox"<% if ($tax->{'default'}) { %> checked<% } %>> <%= &subs::ui('Default') %></label>
					<button type="button" class="tax_catalog_remove" hint="<%= &subs::ui('Remove this tax') %>" aria-label="<%= &subs::ui('Remove this tax') %>">&times;</button>
				</div>
			<% } %>
		</div>
		<% if (!scalar @{$tax_catalog}) { %>
			<p class="cfg-note tax_catalog_empty"><%= &subs::ui('No taxes yet. Add one below.') %></p>
		<% } %>
		<div class="cfg-row">
			<button type="button" class="tax_catalog_add"><%= &subs::ui('Add tax') %></button>
			<button type="button" class="tax_catalog_save"><%= &subs::ui('Save taxes') %></button>
			<span class="tax_catalog_status" aria-live="polite"><%= &subs::ui('Saved') %></span>
		</div>
	</div>

	<% my $me_device = &subs::device_setter(); %>
	<%# Away is house-wide, not per device: one answer for every machine. The card
	    starts an open-ended period, or a dated one, and ends it early. %>
	<% my $vacation = &subs::vacation_status(); %>
	<% my $current_away = $vacation->{'current'}; %>
	<% my $next_away = $vacation->{'next'}; %>
	<% my $auto = $vacation->{'auto'} || {}; %>
	<% my $auto_hours = $auto->{'after_hours'} || 24; %>
	<% my $proposals = $vacation->{'proposals'} || []; %>
	<% my $date_text = sub { my ($ms) = @_; return '' unless defined $ms; my @l = localtime(int($ms / 1000)); return sprintf('%04d-%02d-%02d', $l[5] + 1900, $l[4] + 1, $l[3]); }; %>
	<% my @now_l = localtime(); my @week_l = localtime(time() + 7 * 86400); %>
	<% my $today = sprintf('%04d-%02d-%02d', $now_l[5] + 1900, $now_l[4] + 1, $now_l[3]); %>
	<% my $week = sprintf('%04d-%02d-%02d', $week_l[5] + 1900, $week_l[4] + 1, $week_l[3]); %>
	<div class="cfg-card" id="me_away_card">
		<h3><%= &subs::ui('Away') %></h3>
		<p class="cfg-note"><%= &subs::ui('A vacation, a trip or a stay away from the house. Budgets are read against the time you were here; routines and non-urgent notices wait.') %></p>
		<div class="cfg-row" id="me_away_detect">
			<label><input type="checkbox" class="away_detect"<% if ($auto->{'detect'}) { %> checked<% } %>> <%= &subs::ui('Detect quiet periods') %></label>
			<span><%= &subs::ui('after') %> <input type="number" class="away_after_hours" min="1" max="720" step="1" value="<%= $auto_hours %>"> <%= &subs::ui('hours') %></span>
			<button type="button" class="away_detect_save"><%= &subs::ui('Save') %></button>
			<span class="cfg-note"><%= &subs::ui('A quiet gap becomes a question on this card; nothing pauses until you confirm it.') %></span>
		</div>
		<%= include 'configure/away_keep' %>
		<% if (scalar @{$proposals}) { %>
			<div class="away_proposals">
				<% foreach my $pp ( @{$proposals} ) { %>
					<p><b><%= &subs::ui('Quiet period') %></b>
						<%= $date_text->($pp->{'from'}) %>
						<% if (defined $pp->{'to'}) { %><%= &subs::ui('until') %> <%= $date_text->($pp->{'to'}) %><% } else { %><%= &subs::ui('until now') %><% } %>.
						<%= &subs::ui('Was that a vacation?') %>
						<button type="button" class="away_accept" uuid="<%= $pp->{'uuid'} %>"><%= &subs::ui('Yes') %></button>
						<button type="button" class="away_dismiss" uuid="<%= $pp->{'uuid'} %>"><%= &subs::ui('No') %></button>
					</p>
				<% } %>
			</div>
		<% } %>
		<% if ($current_away) { %>
			<p><b><%= &subs::ui('Away') %></b>
				<%= $date_text->($current_away->{'from'}) %>
				<%= &subs::ui('until') %>
				<% if (defined $current_away->{'to'}) { %><%= $date_text->($current_away->{'to'}) %><% } else { %><%= &subs::ui('you are home') %><% } %>
			</p>
			<button type="button" class="away_end"><%= &subs::ui('I am home') %></button>
		<% } elsif ($next_away) { %>
			<p><b><%= &subs::ui('Away planned') %></b>
				<%= $date_text->($next_away->{'from'}) %>
				<%= &subs::ui('until') %>
				<% if (defined $next_away->{'to'}) { %><%= $date_text->($next_away->{'to'}) %><% } else { %><%= &subs::ui('you are home') %><% } %>
			</p>
			<button type="button" class="away_cancel" uuid="<%= $next_away->{'uuid'} %>"><%= &subs::ui('Cancel') %></button>
		<% } else { %>
			<div class="cfg-row">
				<label><%= &subs::ui('From') %></label>
				<span><input type="date" class="away_from" value="<%= $today %>"></span>
			</div>
			<div class="cfg-row">
				<label><%= &subs::ui('Until') %></label>
				<span><input type="date" class="away_to" value="<%= $week %>"> <span class="cfg-note"><%= &subs::ui('Leave blank to stay away until you say you are home.') %></span></span>
			</div>
			<div class="cfg-row">
				<label><%= &subs::ui('Note') %></label>
				<span><input type="text" class="away_note" maxlength="200" placeholder="<%= &subs::ui('Optional') %>"></span>
			</div>
			<button type="button" class="away_start"><%= &subs::ui('Start') %></button>
		<% } %>
		<% if (!$current_away && !$next_away && $vacation->{'digest'}) { %>
			<% my $dg = $vacation->{'digest'}; %>
			<p class="away_digest"><b><%= &subs::ui('While you were away') %></b>
				<%= $date_text->($dg->{'from'}) %> - <%= $date_text->($dg->{'to'}) %>,
				<%= sprintf('%.1f', $dg->{'days'}) %> <%= &subs::ui('days') %>.
				<%= $dg->{'notices'} %> <%= $dg->{'notices'} == 1 ? &subs::ui('notice arrived') : &subs::ui('notices arrived') %>.
			</p>
		<% } %>
		<%= include 'configure/away_notices' %>
		<%# Presence simulation lives with Away because it only runs while a period
		    is active. It is opt-in: an empty board or remote is a no-op. The remote
		    list refreshes from /manager/embedded/remotes when the board changes. %>
		<% my $presence = &subs::presence_settings(); %>
		<% my $presence_boards = &subs::presence_boards(); %>
		<% my $presence_remotes = &subs::remote_store_read('microcontroller', $presence->{'chip_id'}); %>
		<div class="cfg-card" id="me_presence_card" style="margin-top:10px;">
			<h3><%= &subs::ui('Presence simulation') %></h3>
			<div class="cfg-row">
				<label><input type="checkbox" class="presence_enabled"<% if (($presence->{'enabled'} // 'no') eq 'yes') { %> checked<% } %>> <%= &subs::ui('Simulate presence') %></label>
			</div>
			<div class="cfg-row">
				<label><%= &subs::ui('Board') %></label>
				<select class="presence_board" hint="<%= &subs::ui('The board that learned the remote') %>">
					<option value=""><%= &subs::ui('Choose a board') %></option>
					<% foreach my $board ( @{$presence_boards} ) { %>
						<option value="<%= $board->{'id'} %>"<% if (($presence->{'chip_id'} // '') eq $board->{'id'}) { %> selected<% } %>><%= $board->{'name'} || $board->{'id'} %></option>
					<% } %>
				</select>
			</div>
			<div class="cfg-row">
				<label><%= &subs::ui('Remote') %></label>
				<select class="presence_remote" hint="<%= &subs::ui('The learned remote to replay') %>">
					<option value=""><%= &subs::ui('Choose a remote') %></option>
					<% foreach my $remote_name ( sort keys %{$presence_remotes} ) { %>
						<option value="<%= $remote_name %>"<% if (($presence->{'remote'} // '') eq $remote_name) { %> selected<% } %>><%= $remote_name %></option>
					<% } %>
				</select>
			</div>
			<div class="cfg-row">
				<label><%= &subs::ui('On') %></label>
				<span><input type="time" class="presence_on" value="<%= $presence->{'on'} %>"></span>
				<label><%= &subs::ui('Off') %></label>
				<span><input type="time" class="presence_off" value="<%= $presence->{'off'} %>"></span>
				<label><%= &subs::ui('Jitter') %></label>
				<span><input type="number" class="presence_jitter" min="0" max="120" step="1" value="<%= $presence->{'jitter'} %>"> <%= &subs::ui('minutes') %></span>
			</div>
			<div class="cfg-row">
				<button type="button" class="presence_save"><%= &subs::ui('Save') %></button>
				<span class="presence_status" aria-live="polite"></span>
			</div>
			<p class="cfg-note"><%= &subs::ui('A learned IR remote is sent at a slightly different time each evening while an away period is active.') %></p>
		</div>
		<span class="away_status" aria-live="polite"></span>
	</div>
	<% foreach my $d ( @gb::device_types ) { %>
		<details class="cfg-acc" data-acc="me-<%= &subs::html_name($d) %>"<% if ($d eq $me_device) { %> open<% } %>>
			<summary><%= $d %></summary>
			<div class="cfg-card">

			<%# Each device keeps its own zone: the taskbar, the handheld's launcher and an
			    evaluation running on that machine all read this device's row. Saving it
			    sets the machine's own clock only when the card is this machine's. %>
			<% my $device_zone = &subs::misc_setting('clock_timezone', $d) || ''; %>
			<div class="cfg-row">
				<label><%= &subs::ui('Time zone') %></label>
				<span>
					<select class="me_timezone" device="<%= $d %>" hint="<%= &subs::ui('The zone this device reads; saving it also sets this machine\'s clock when you are on it') %>">
						<option value=""><%= &subs::ui('Local') %></option>
						<% foreach my $z (@{ $timezones || [] }) { %>
							<option value="<%= $z %>"<% if ($z eq $device_zone) { %> selected<% } %>><%= $z %></option>
						<% } %>
					</select>
					<span class="me_timezone_note" aria-live="polite"></span>
				</span>
			</div>

			<div class="me_grid">
				<% foreach my $m ( sort keys %{$me->{$d}} ) { %>
					<% next if grep { $_ eq $m } qw(pos gallery_appts currency unit budget_alarm log_me advertise_watching mugshot home_plate information); %>
					<label class="me_field"><span><%= &subs::format_name($m) %></span>
						<input type="text" class="me_setting" device="<%= $d %>" setting="<%= $m %>" value="<%= $me->{$d}->{$m} %>">
					</label>
				<% } %>
				<% if (exists $me->{$d}->{'unit'}) { %>
					<label class="me_field"><span><%= &subs::format_name('unit') %></span>
						<select class="me_setting" device="<%= $d %>" setting="unit" value="<%= $me->{$d}->{'unit'} %>">
							<% foreach my $u ( sort keys %{$gb::measures} ) { %>
								<option value="<%= $u %>" <% if ($me->{$d}->{'unit'} eq $u) { %>selected<% } %>><%= &subs::format_name($gb::measures->{$u}->{'name'}) %></option>
							<% } %>
						</select>
					</label>
				<% } %>
				<% if (exists $me->{$d}->{'currency'}) { %>
					<label class="me_field"><span><%= &subs::format_name('currency') %></span>
						<select class="me_setting" device="<%= $d %>" setting="currency" value="<%= $me->{$d}->{'currency'} %>">
							<% foreach my $dolla ( keys %{$gb::measures} ) { %>
								<% if (grep { $_ eq 'currency' } @{$gb::measures->{$dolla}->{'types'}}) { %>
									<option value="<%= $dolla %>" <% if ($me->{$d}->{'currency'} eq $dolla) { %>selected<% } %>><%= &subs::format_name($gb::measures->{$dolla}->{'name'}) %></option>
								<% } %>
							<% } %>
						</select>
					</label>
				<% } %>
				<% if (exists $me->{$d}->{'pos'}) { %>
					<label class="me_field"><span>Part of Speech</span>
						<select class="me_setting" setting="pos" device="<%= $d %>" value="<%= $me->{$d}->{'pos'} %>">
							<% foreach my $p ( keys %{$pos_list} ) { %>
								<option <% if ($p eq $me->{$d}->{'pos'}) { %>selected<% } %> value="<%= $p %>"><%= &subs::format_name($p) %></option>
							<% } %>
						</select>
					</label>
				<% } %>
			</div>

			<div class="me_checks">
				<% foreach my $m ( qw/log_me gallery_appts budget_alarm advertise_watching/ ) { %>
					<% next unless exists $me->{$d}->{$m}; %>
					<label><input type="checkbox" class="me_setting" device="<%= $d %>" setting="<%= $m %>" <% if ( $me->{$d}->{$m} eq 'on' ) { %>checked <% } %> value="<%= $me->{$d}->{$m} %>"> <%= &subs::format_name($m) %></label>
				<% } %>
			</div>

			<script>
				$(document).on('change', '.me_setting[device="<%= $device %>"][setting="advertise_watching"]', function() {
					if ($(this).is(':checked')) {
						advertise_watching = 'on';
					}
					else {
						advertise_watching = 'off';
					}
				});
			</script>

			<% if (exists $me->{$d}->{'mugshot'}) { %>
				<div class="cfg-row">
					<label><%= &subs::format_name('mugshot') %></label>
					<img src="<%= &Manager::mugshot_source($d) || '/images/make believe/face.png' %>" class="large_thumb me_setting mugshot_upload_button"
						device="<%= $d %>" setting="mugshot">
				</div>
				<div class="mugshot_upload_container" device="<%= $d %>">
					<form class="mugshot_upload" device="<%= $d %>" setting="mugshot" style="display:none;">
						<input class="mugshot_upload_input" device="<%= $d %>" setting="mugshot" type="file" name="fileupload" />
						<input type="submit" />
					</form>
				</div>
			<% } %>

			<% if (exists $me->{$d}->{'home_plate'}) { %>
				<div class="cfg-row">
					<label><%= &subs::format_name('home_plate') %></label>
					<img <% if ($me->{$d}->{'home_plate'}) { %> style="background-color:lightgreen;" <% } %> src="<%= &subs::icon_for('/images/make believe/gps.png') %>" hint="Location" device="<%= $d %>" setting="home_plate" class="medium_thumb home_plate_record">
				</div>
				<% if ($me->{$d}->{'home_plate'}) { %>
					<% my $location = eval { return decode_json $me->{$d}->{'home_plate'} } || {}; %>
					<div class="home_plate_configuration" app="me" device="<%= $d %>">
						<%= include 'configure/home_plate_map', app => 'me', device => $d, base => $location, flags => [] %>
					</div>
				<% } %>
			<% } %>

			<% if (exists $me->{$d}->{'information'}) { %>
				<div class="cfg-row">
					<label><%= &subs::format_name('information') %></label>
					<textarea class="me_setting" setting="information" device="<%= $d %>"><%= $me->{$d}->{'information'} %></textarea>
				</div>
			<% } %>
			</div>
		</details>
	<% } %>
</div>
