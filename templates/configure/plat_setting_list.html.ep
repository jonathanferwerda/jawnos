<% use Mojo::JSON qw/decode_json/; %>
<% no warnings 'uninitialized'; %>
<%
	# Every AI model choice and provider credential in one place.
	my @roles = (
		[ 'help_assistant',          'Help guide',           'chat' ],
		[ 'eval_assistant',          'Evaluation',           'chat' ],
		[ 'visual_assistant',        'Vision (reads images)', 'vision' ],
		[ 'text_to_image_assistant', 'Image generation',     'image' ],
		[ 'text_to_audio_assistant', 'Audio generation',     'audio-gen' ],
		[ 'text_to_video_assistant', 'Video generation',     'video-gen' ],
		[ 'chatbot_model',           'Pen chat (default)',   'chat' ],
		[ 'coding_assistant',        'Coding (self-healing)', 'chat' ],
		[ 'transcription_assistant', 'Transcription (speech in)', 'audio' ],
	);
	my $role_settings = &subs::settings_grabber({ app => 'mail', settings => [ map { $_->[0] } @roles ] });
	my $catalogue = &subs::ai_model_catalogue();
	# the scheduled evaluation's preferred worker: the server dispatches the run,
	# and this names the machine it should ask first when that machine is ready
	my $machines = &subs::remote_machine_lister({ self => 'yes', mirrors => 'none' });
	my $eval_machine = &subs::setting_grabber({ app => '__president', setting => 'evaluation_machine' }) || '';
	my $providers = &subs::ai_providers();
	my $key_values = &subs::settings_grabber({ app => 'mail', settings => [ &subs::ai_key_settings() ] });
	# provider id -> its balance row, read from the report the ai balance loop keeps
	# fresh off the page (President.pl refreshes it every ten minutes), so a panel
	# load only ever reads the cache and never waits on a provider.
	my $balance = &subs::ai_balance_report();
	my %balance_for = map { ($_->{'provider'} || '') => $_ } @{ $balance->{'rows'} || [] };
	my $balance_of = sub {
		my ($id) = @_;
		my $b = $balance_for{$id};
		return sprintf('%.2f %s', $b->{'available'}, $b->{'currency'} || '') if $b && defined $b->{'available'};
		return ($b->{'note'} || '—') if $b;
		return 'not read yet' unless $balance->{'at'};
		return '—';
	};
	# which model can reason, and the level chosen for a role: guarded the same way
	# as ai_provider_ready below, so a request served before the tree restarts onto
	# this build keeps the panel's old shape instead of dying on an unknown sub.
	my $thinks_of = defined &subs::ai_model_thinks ? \&subs::ai_model_thinks : sub { 0 };
	my $thinking_of = defined &subs::ai_role_thinking ? \&subs::ai_role_thinking : sub { '' };
	# which providers can answer here at all: a key entered, or a running Ollama.
	# The role lists below only offer these - the rest are named under them, so it
	# is clear which of them wants a key (or a daemon). Until the tree restarts
	# onto this build the helper does not exist yet, and the panel keeps its old
	# shape for those requests rather than dying on it.
	my %provider_ready = map { $_->{'id'} => (defined &subs::ai_provider_ready ? &subs::ai_provider_ready($_->{'id'}) : 1) } @{$catalogue};
	# which billing buckets are stood down (out of credit) - one check per bucket
	my %bucket_ok;
	foreach my $p ( @{$catalogue} ) {
		foreach my $m ( @{ $p->{'models'} } ) {
			$bucket_ok{ $m->{'bucket'} } = &subs::ai_bucket_available($m->{'bucket'}) unless exists $bucket_ok{ $m->{'bucket'} };
		}
	}
	my @down = sort grep { !$bucket_ok{$_} && $_ ne 'ollama' && $_ ne 'cloudflare' } keys %bucket_ok;
	# Remember which Plat sub-tab was last open on this device, so reopening the
	# panel returns to the page the person was using.
	my $plat_tab = &subs::setting_grabber({ app => '__president', setting => 'plat_tab' }) || 'plat_ai';
	$plat_tab = 'plat_ai' unless $plat_tab =~ /^plat_(?:ai|oauth|crypto|dns)$/;
%>
<div class="cfg">
	<h2>Platform</h2>
	<div class="cfg-tabs">
		<button class="cfg_tab_toggle <% if ($plat_tab eq 'plat_ai') { %>active<% } %>" tab="plat_ai">AI</button>
		<button class="cfg_tab_toggle <% if ($plat_tab eq 'plat_oauth') { %>active<% } %>" tab="plat_oauth">OAuth2</button>
		<button class="cfg_tab_toggle <% if ($plat_tab eq 'plat_crypto') { %>active<% } %>" tab="plat_crypto">Crypto</button>
		<button class="cfg_tab_toggle <% if ($plat_tab eq 'plat_dns') { %>active<% } %>" tab="plat_dns">DNS</button>
	</div>
	<div id="plat_ai" class="cfg_tab_panel" style="<%= $plat_tab eq 'plat_ai' ? '' : 'display:none;' %>">
	<p class="cfg-note">Every AI model choice and provider key, in one place.</p>

	<h3>Agent models</h3>
	<p class="cfg-note">Which model each assistant uses. Each list offers only models that fit the role, and marks whether a model is free or paid. The language agents — the Help guide, Evaluation, Vision, the Pen and Coding — each carry a Thinking choice beside their model: none lets it answer as it always has, and low/high/max ask it to reason longer first; a model that ignores the hint simply answers as before. Image generation has no such knob.</p>
	<% if (@down) { %>
		<p class="cfg-note">Out of credit just now, so their paid models are hidden:
			<% foreach my $b ( @down ) { %><span style="white-space:nowrap;"><b><%= $b %></b> <button class="ai_avail_clear" bucket="<%= $b %>" style="font-size:11px;">Clear</button></span> <% } %>
			They come back on their own after a while, or once the account is topped up.</p>
	<% } %>
	<div class="cfg-card">
		<% foreach my $r ( @roles ) {
			my ($setting, $label, $cap) = @{$r};
			my $current = $role_settings->{$setting} // '';
			my $shown = 0;
			# Thinking needs both halves. The agent's kind must call for it - the
			# language agents (Help, Evaluation, Vision, the Pen and Coding) do, image
			# generation does not - and the chosen model must be one that reasons
			# (ai_model_thinks). The row rides the model, appearing and going as the
			# pick changes.
			my $thinking_cap = ($cap eq 'chat' || $cap eq 'vision') ? 1 : 0;
			my $thinks = ($thinking_cap && $current && $thinks_of->($current)) ? 1 : 0;
			my $think = $thinking_of->($setting);
			$think = 'none' unless length $think;
			my $fallback = $role_settings->{$setting . '_fallback'} // '';
			# the models this role can use, flattened once for the fallback (which is
			# the same list, the primary disabled)
			my @role_models;
			foreach my $provider ( @{$catalogue} ) {
				next unless $provider_ready{ $provider->{'id'} };
				my @models = grep {
					my $m = $_;
					scalar( grep { $_ eq $cap } @{ $m->{'caps'} } ) && (!$m->{'paid'} || $bucket_ok{ $m->{'bucket'} })
				} @{ $provider->{'models'} };
				foreach my $m ( @models ) {
					push @role_models, { %{$m}, group => $provider->{'label'} };
				}
			}
			# whisper.cpp on this machine is a transcription choice like any other:
			# it answers locally (warm when the server is running) and costs nothing,
			# so it belongs in both the model and fallback lists.
			if ($setting eq 'transcription_assistant' && -x &subs::home('~/whisper.cpp/build/bin/whisper-cli')) {
				push @role_models, { value => 'local:whisper.cpp', name => 'whisper.cpp', paid => 0, group => 'This machine', caps => ['audio'] };
			}
		%>
			<div class="ai_role" setting="<%= $setting %>">
				<div class="cfg-row">
					<label><%= $label %></label>
					<select class="configure_input ai_role_model" app="mail" setting="<%= $setting %>">
						<option value="">— none —</option>
						<% foreach my $provider ( @{$catalogue} ) {
							next unless $provider_ready{ $provider->{'id'} };
							my @models = grep {
								my $m = $_;
								scalar( grep { $_ eq $cap } @{ $m->{'caps'} } ) && (!$m->{'paid'} || $bucket_ok{ $m->{'bucket'} })
							} @{ $provider->{'models'} };
							next unless scalar @models;
						%>
							<optgroup label="<%= $provider->{'label'} %>">
								<% foreach my $m ( @models ) {
									my @mcaps = grep { $_ ne 'other' } @{ $m->{'caps'} };
								%>
									<option value="<%= $m->{'value'} %>" data-thinks="<%= ($thinking_cap && $thinks_of->($m->{'value'})) ? 1 : 0 %>" <% if ($current eq $m->{'value'}) { %>selected="selected"<% $shown = 1; } %>><%= $m->{'name'} %> · <%= join('+', @mcaps) %> · <%= $m->{'paid'} ? 'paid' : 'free' %></option>
								<% } %>
							</optgroup>
						<% } %>
						<% if ($setting eq 'transcription_assistant' && -x &subs::home('~/whisper.cpp/build/bin/whisper-cli')) { %>
							<optgroup label="This machine">
								<option value="local:whisper.cpp" data-thinks="0" <% if ($current eq 'local:whisper.cpp') { %>selected="selected"<% $shown = 1; } %>>whisper.cpp · this machine · free</option>
							</optgroup>
						<% } %>
						<%# a model already chosen that does not fit, or is paid and stood down, is kept so it is not silently dropped %>
						<% if ($current && !$shown) { %>
							<option value="<%= $current %>" data-thinks="<%= $thinks %>" selected="selected"><%= $current %> (kept — not offered here just now)</option>
						<% } %>
					</select>
				</div>
				<div class="cfg-row ai_fallback_row">
					<label>Fallback</label>
					<select class="configure_input ai_role_fallback" app="mail" setting="<%= $setting %>_fallback">
						<option value="">— none —</option>
						<% foreach my $m ( @role_models ) {
							my @mcaps = grep { $_ ne 'other' } @{ $m->{'caps'} };
						%>
							<option value="<%= $m->{'value'} %>" <% if ($current && $m->{'value'} eq $current) { %>disabled="disabled"<% } %> <% if ($fallback eq $m->{'value'}) { %>selected="selected"<% } %>><%= $m->{'group'} %> · <%= $m->{'name'} %> · <%= $m->{'paid'} ? 'paid' : 'free' %></option>
						<% } %>
					</select>
				</div>
				<% if ($thinking_cap) { %>
					<div class="cfg-row ai_thinking_row"<% if (!$thinks) { %> style="display:none;"<% } %>>
						<label>Thinking</label>
						<select class="configure_input" app="mail" setting="<%= $setting %>_thinking">
							<% foreach my $lvl (qw/none low high max/) { %>
								<option value="<%= $lvl %>" <% if ($think eq $lvl) { %>selected="selected"<% } %>><%= $lvl %></option>
							<% } %>
						</select>
					</div>
				<% } %>
				<% if ($setting eq 'eval_assistant' && scalar @{$machines}) { %>
					<div class="cfg-row">
						<label><%= &subs::ui('Preferred worker') %></label>
						<select class="evaluation_machine" app="__president" setting="evaluation_machine" hint="The worker the server prefers for scheduled evaluations when it is ready; otherwise the server chooses another ready worker. With no server, the house elects by quorum">
							<option value=""><%= &subs::ui('Any worker') %></option>
							<% foreach my $m ( @{$machines} ) { %>
								<% next unless $m->{'signatorial'}; %>
								<option value="<%= $m->{'signatorial'} %>" <% if ($eval_machine eq $m->{'signatorial'}) { %>selected="selected"<% } %>><%= ((($m->{'hostname'} || '') eq 'me') ? 'me (this machine)' : ($m->{'hostname'} || $m->{'signatorial'})) %></option>
							<% } %>
						</select>
					</div>
				<% } %>
			</div>
		<% } %>
	</div>

	<% my @not_ready = grep { !$provider_ready{ $_->{'id'} } } @{$catalogue}; %>
	<% if (@not_ready) { %>
		<p class="cfg-note">Not offered until they can answer: <% foreach my $p (@not_ready) { %><b><%= $p->{'label'} %></b><%= ($p->{'id'} eq 'ollama' ? ' (not running)' : ' (no key)') %><%= ($p->{'id'} eq $not_ready[-1]->{'id'} ? '' : ', ') %><% } %>. Paste a key under Provider access and press Plat again, or start Ollama for the local models.</p>
	<% } %>

	<h3>Self-healing</h3>
	<p class="cfg-note">With a Coding model set, the tree's own error output is watched (the pty log and manager.log). Each new error appears in the IDE's coding panel with a fix the Coding agent proposes; nothing is written until you press Apply there. Tick Apply automatically and each proposal is written, checked (perl -c, with a rollback if it fails) and shipped at once - a file with uncommitted work stands down and waits for you, and the day's token budget still applies. Tick Watch the Guide and the Guide's own saved conversations are read the same way: a turn that went nowhere - a thing not found, a command that could not run, a closing line that says so - is staged for the Coding agent to adjust the Guide's training itself (its rules and verbs). Fixed so far, under the tick, is the record: press review to read every error that has been fixed and shipped. Tick Watch records and the appointments table is audited on the same principle: the fixed audit finds a session that one stop press closed along with others, a row written twice, and an open session run far past its app's length, and stages each finding here for review - nothing is written until you Apply. Only two rows that are the same event written twice are ever applied for you (they are provably one event); a sweep or a long-open session is a judgement call, because a real appointment can be surprisingly long, so each finding waits for you - and you can put any finding to the Coding agent to read before you decide. "Leave this app alone" silences an app you know runs long. The window is how far back it looks (0 is all time).</p>
	<div class="cfg-card">
		<div class="cfg-row">
			<label>Watch errors</label>
			<% my $watching = (&subs::setting_grabber({ app => 'mail', setting => 'error_watch' }) // ''); %>
			<input type="checkbox" class="configure_input" app="mail" setting="error_watch" <% if ($watching eq 'on') { %>checked<% } %>>
		</div>
		<div class="cfg-row">
			<label>Watch the Guide</label>
			<% my $guide_watching = (&subs::setting_grabber({ app => 'mail', setting => 'guide_watch' }) // ''); %>
			<input type="checkbox" class="configure_input" app="mail" setting="guide_watch" <% if ($guide_watching eq 'on') { %>checked<% } %>>
		</div>
		<div class="cfg-row">
			<label>Apply automatically</label>
			<% my $autoing = (&subs::setting_grabber({ app => 'mail', setting => 'error_watch_auto' }) // ''); %>
			<input type="checkbox" class="configure_input" app="mail" setting="error_watch_auto" <% if ($autoing eq 'on') { %>checked<% } %>>
		</div>
		<div class="cfg-row">
			<label>Fixed so far</label>
			<%
				my $fixed_n = 0;
				eval {
					my $fixed_row = &subs::db_query('select count(*) as n from staged_fixes where status = ?', 'applied')->hashes->[0];
					$fixed_n = ($fixed_row->{'n'} || 0) if $fixed_row;
				};
			%>
			<span class="cfg-inline">
				<span id="coding_fixed_open" class="hover" hint="Review the errors the Coding agent has fixed, committed and pushed" style="cursor:pointer;text-decoration:underline;text-underline-offset:2px;">review</span>
				<span class="cfg-note" style="margin:0;"><%= $fixed_n ? "$fixed_n fixed" : 'nothing yet' %></span>
			</span>
		</div>
		<div id="coding_fixed_list" style="display:none;margin:2px 0 8px;padding:6px 0 0;border-top:1px solid var(--line);max-height:320px;overflow:auto;font-size:12px;line-height:1.35;"></div>
		<div class="cfg-row">
			<label>Tokens/day</label>
			<% my $watch_budget = (&subs::setting_grabber({ app => 'mail', setting => 'error_watch_budget' }) // ''); %>
			<input type="text" class="configure_input" app="mail" setting="error_watch_budget" value="<%= $watch_budget %>" placeholder="1000000 — 0 for no cap">
		</div>
		<div class="cfg-row">
			<label>Watch records</label>
			<% my $rec_watching = (&subs::setting_grabber({ app => 'mail', setting => 'records_watch' }) // ''); %>
			<input type="checkbox" class="configure_input" app="mail" setting="records_watch" <% if ($rec_watching eq 'on') { %>checked<% } %>>
		</div>
		<div class="cfg-row">
			<label>Records window</label>
			<% my $rec_window = (&subs::setting_grabber({ app => 'mail', setting => 'records_watch_window' }) // '48'); %>
			<input type="text" class="configure_input" app="mail" setting="records_watch_window" value="<%= $rec_window %>" placeholder="hours back — 0 for all time">
		</div>
		<div class="cfg-row">
			<label>Apply records automatically</label>
			<% my $rec_auto = (&subs::setting_grabber({ app => 'mail', setting => 'records_watch_auto' }) // ''); %>
			<input type="checkbox" class="configure_input" app="mail" setting="records_watch_auto" <% if ($rec_auto eq 'on') { %>checked<% } %>>
		</div>
		<p class="cfg-note">Automatic apply writes only exact duplicates (the same event written twice on the mesh). A sweep or a long-open session always waits for you to review, so a genuinely long appointment is never repaired behind your back.</p>
		<div class="cfg-row">
			<label>Findings waiting</label>
			<%
				my ($rec_pending, $rec_fixed) = (0, 0);
				eval {
					$rec_pending = (&subs::db_query('select count(*) as n from staged_records where status = ?', 'proposed')->hashes->[0]->{'n'}) + 0;
					$rec_fixed = (&subs::db_query('select count(*) as n from staged_records where status = ?', 'applied')->hashes->[0]->{'n'}) + 0;
				};
			%>
			<span class="cfg-inline">
				<span id="records_open" class="hover" hint="Review what the records audit has found, and Apply" style="cursor:pointer;text-decoration:underline;text-underline-offset:2px;">review</span>
				<span id="records_scan_now" class="hover" hint="Run the audit now" style="cursor:pointer;text-decoration:underline;text-underline-offset:2px;">scan now</span>
				<span id="records_waiting_n" class="cfg-note" style="margin:0;"><%= $rec_pending ? "$rec_pending waiting" : 'nothing waiting' %></span>
			</span>
		</div>
		<div id="records_list" style="display:none;margin:2px 0 8px;padding:6px 0 0;border-top:1px solid var(--line);max-height:360px;overflow:auto;font-size:12px;line-height:1.35;"></div>
		<div class="cfg-row">
			<label>Records fixed so far</label>
			<span class="cfg-inline">
				<span id="records_fixed_open" class="hover" hint="Review the findings the records watch has fixed" style="cursor:pointer;text-decoration:underline;text-underline-offset:2px;">review</span>
				<span class="cfg-note" style="margin:0;"><%= $rec_fixed ? "$rec_fixed fixed" : 'nothing yet' %></span>
			</span>
		</div>
		<div id="records_fixed_list" style="display:none;margin:2px 0 8px;padding:6px 0 0;border-top:1px solid var(--line);max-height:320px;overflow:auto;font-size:12px;line-height:1.35;"></div>
	</div>

	<h3>Provider access</h3>
	<p class="cfg-note">Keys and accounts for each provider. Secrets are stored encrypted: a key that is already set shows “••• set” — leave it alone to keep it, or type a new value to replace it.</p>
	<% foreach my $p ( @{$providers} ) { %>
		<% my $set_up = scalar( grep { my $v = $key_values->{$_->[0]}; defined $v && length $v } @{ $p->{'keys'} } ); %>
		<div class="cfg-card">
			<h4 style="margin-top:0;display:flex;align-items:baseline;justify-content:space-between;gap:10px;">
				<span><%= $p->{'label'} %></span>
				<%# the account's money, where the provider reports it, beside its key(s) %>
				<% if ($set_up) { %>
					<span class="cfg-note" style="margin:0;font-weight:normal;font-size:12px;white-space:nowrap;">balance <%= $balance_of->($p->{'id'}) %><% if ($balance->{'at'}) { %> · <span class="time" timestamp="<%= $balance->{'at'} %>"></span><% } %></span>
				<% } %>
			</h4>
			<% foreach my $k ( @{ $p->{'keys'} } ) { %>
				<% my ($name, $label) = @{$k}; my $val = $key_values->{$name}; my $is_secret = ($name =~ /_(key|token)$/) ? 1 : 0; my $set = (defined $val && length $val) ? 1 : 0; %>
				<div class="cfg-row">
					<label><%= $label %></label>
					<% if ($is_secret) { %>
						<span class="cfg-inline">
							<input type="password" class="configure_input" app="mail" setting="<%= $name %>" value=""
								placeholder="<%= $set ? '••• set — type to replace' : 'not set' %>"
								data-set="<%= $set %>">
							<% if ($set) { %><span class="cfg-note" style="margin:0;white-space:nowrap;">✔ set</span><% } %>
						</span>
					<% } else { %>
						<input type="text" class="configure_input" app="mail" setting="<%= $name %>" value="<%= $val %>">
					<% } %>
				</div>
			<% } %>
		</div>
	<% } %>
	<p class="cfg-note">Ollama and Cloudflare model lists are read from each service when this panel opens; the other providers' lists are built in. Models are addressed as <code>provider:model</code> — a bare name goes to Ollama, and <code>@cf/…</code> to Cloudflare. The lists only offer providers that can answer: a key entered (and an account not out of credit), or a local Ollama that is running.</p>

	<h3>Guide commands (runtime)</h3>
	<p class="cfg-note">Extra verbs the Guide can run, added without a code change. Each entry is JSON: a <code>name</code>, a <code>desc</code>, an optional <code>args</code> map, and a <code>primitive</code> with its <code>params</code>. The primitives are <code>say</code>, <code>open_app</code>, <code>set_setting</code>, <code>run_command</code>, <code>toggle</code>, <code>stage</code>, <code>find</code> and <code>play_music</code>; a param value may contain <code>{name}</code> to take one of the model's arguments. The list is a setting, so it syncs to every machine and they all learn the verb.</p>
	<textarea id="guide_verbs_json" spellcheck="false" style="width:100%;box-sizing:border-box;min-height:140px;font-family:monospace;font-size:12px;border-radius:6px;border:1px solid var(--line);background:var(--panel);color:var(--ink);padding:8px;"><%= &subs::setting_grabber({ app => '__president', setting => 'guide_verbs', device => 'all' }) || '[]' %></textarea>
	<div class="cfg-row">
		<button id="guide_verbs_save" class="button" style="padding:6px 12px;border-radius:8px;border:2px solid var(--line);cursor:pointer;font-weight:bold;">Save commands</button>
		<span id="guide_verbs_status" class="cfg-note" style="margin:0;"></span>
	</div>
	</div>
	<div id="plat_oauth" class="cfg_tab_panel" style="<%= $plat_tab eq 'plat_oauth' ? '' : 'display:none;' %>">
		<%= include 'configure/oauth_clients' %>
	</div>
	<div id="plat_crypto" class="cfg_tab_panel" style="<%= $plat_tab eq 'plat_crypto' ? '' : 'display:none;' %>">
		<%= include 'configure/crypto_setting_list' %>
	</div>
	<div id="plat_dns" class="cfg_tab_panel" style="<%= $plat_tab eq 'plat_dns' ? '' : 'display:none;' %>">
		<%= include 'configure/dns_clients' %>
	</div>
</div>
