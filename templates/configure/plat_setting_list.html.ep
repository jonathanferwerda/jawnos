<% use Mojo::JSON qw/decode_json/; %>
<% no warnings 'uninitialized'; %>
<%
	# Every AI model choice and provider credential in one place.
	my @roles = (
		[ 'help_assistant',          'Help guide',           'chat' ],
		[ 'eval_assistant',          'Evaluation',           'chat' ],
		[ 'visual_assistant',        'Vision (reads images)', 'vision' ],
		[ 'text_to_image_assistant', 'Image generation',     'image' ],
		[ 'chatbot_model',           'Pen chat (default)',   'chat' ],
	);
	my $role_settings = &subs::settings_grabber({ app => 'mail', settings => [ map { $_->[0] } @roles ] });
	my $catalogue = &subs::ai_model_catalogue();
	my $providers = &subs::ai_providers();
	my $key_values = &subs::settings_grabber({ app => 'mail', settings => [ &subs::ai_key_settings() ] });
	# which billing buckets are stood down (out of credit) - one check per bucket
	my %bucket_ok;
	foreach my $p ( @{$catalogue} ) {
		foreach my $m ( @{ $p->{'models'} } ) {
			$bucket_ok{ $m->{'bucket'} } = &subs::ai_bucket_available($m->{'bucket'}) unless exists $bucket_ok{ $m->{'bucket'} };
		}
	}
	my @down = sort grep { !$bucket_ok{$_} && $_ ne 'ollama' && $_ ne 'cloudflare' } keys %bucket_ok;
%>
<div class="cfg">
	<h2>Platform</h2>
	<p class="cfg-note">Every AI model choice and provider key, in one place.</p>

	<h3>Agent models</h3>
	<p class="cfg-note">Which model each assistant uses. Each list offers only models that fit the role, and marks whether a model is free or paid.</p>
	<% if (@down) { %>
		<p class="cfg-note">Out of credit just now, so their paid models are hidden:
			<% foreach my $b ( @down ) { %><span style="white-space:nowrap;"><b><%= $b %></b> <button class="ai_avail_clear" bucket="<%= $b %>" style="font-size:11px;">Clear</button></span> <% } %>
			They come back on their own after a while, or once the account is topped up.</p>
	<% } %>
	<div class="cfg-card">
		<% foreach my $r ( @roles ) {
			my ($setting, $label, $cap) = @{$r};
			my $current = $role_settings->{$setting} // '';
			my $shown = 0;
		%>
			<div class="cfg-row">
				<label><%= $label %></label>
				<select class="configure_input" app="mail" setting="<%= $setting %>">
					<option value="">— none —</option>
					<% foreach my $provider ( @{$catalogue} ) {
						my @models = grep {
							my $m = $_;
							scalar( grep { $_ eq $cap } @{ $m->{'caps'} } ) && (!$m->{'paid'} || $bucket_ok{ $m->{'bucket'} })
						} @{ $provider->{'models'} };
						next unless scalar @models;
					%>
						<optgroup label="<%= $provider->{'label'} %>">
							<% foreach my $m ( @models ) {
								my @mcaps = grep { $_ ne 'other' } @{ $m->{'caps'} };
							%>
								<option value="<%= $m->{'value'} %>" <% if ($current eq $m->{'value'}) { %>selected="selected"<% $shown = 1; } %>><%= $m->{'name'} %> · <%= join('+', @mcaps) %> · <%= $m->{'paid'} ? 'paid' : 'free' %></option>
							<% } %>
						</optgroup>
					<% } %>
					<%# a model already chosen that does not fit, or is paid and stood down, is kept so it is not silently dropped %>
					<% if ($current && !$shown) { %>
						<option value="<%= $current %>" selected="selected"><%= $current %> (kept — not offered here just now)</option>
					<% } %>
				</select>
			</div>
		<% } %>
	</div>

	<h3>Provider access</h3>
	<p class="cfg-note">Keys and accounts for each provider. Secrets are stored encrypted: a key that is already set shows “••• set” — leave it alone to keep it, or type a new value to replace it.</p>
	<% foreach my $p ( @{$providers} ) { %>
		<div class="cfg-card">
			<h4 style="margin-top:0;"><%= $p->{'label'} %></h4>
			<% foreach my $k ( @{ $p->{'keys'} } ) { %>
				<% my ($name, $label) = @{$k}; my $val = $key_values->{$name}; my $is_secret = ($name =~ /_(key|token)$/) ? 1 : 0; my $set = (defined $val && length $val) ? 1 : 0; %>
				<div class="cfg-row">
					<label><%= $label %></label>
					<% if ($is_secret) { %>
						<span class="cfg-inline">
							<input type="password" class="configure_input" app="mail" setting="<%= $name %>" value=""
								placeholder="<%= $set ? '••• set — type to replace' : 'not set' %>"
								data-set="<%= $set %>">
							<% if ($set) { %><span class="cfg-note" style="margin:0;white-space:nowrap;">✔ set</span><% } %>
						</span>
					<% } else { %>
						<input type="text" class="configure_input" app="mail" setting="<%= $name %>" value="<%= $val %>">
					<% } %>
				</div>
			<% } %>
		</div>
	<% } %>
	<p class="cfg-note">Ollama and Cloudflare model lists are read from each service when this panel opens; the other providers' lists are built in. Models are addressed as <code>provider:model</code> — a bare name goes to Ollama, and <code>@cf/…</code> to Cloudflare.</p>
</div>
