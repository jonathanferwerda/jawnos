<% use Mojo::JSON qw/decode_json encode_json/; %>
<% no warnings 'uninitialized'; %>
<%
	# ability -> icon name; &subs::icon_path picks the current icon set's tile by
	# that name, or the fallback image when the name has no tile (build.js renders
	# one tile per set). Keeps the App panel's ability grid recognisable at a glance.
	my %ability_icon = (
		notifications => 'bell', category => 'category', description => 'note',
		duration => 'metronome', warranty => 'badge', schedule => 'title',
		phone => 'phone_sms', notes => 'note', email => 'envelope', web => 'web_button',
		phones => 'phone_sms', emails => 'envelope',
		logo => 'gallery', address => 'place', specs => 'list', command => 'code',
		position => 'marker', formulas => 'calculator', kill => 'scraper', cost => 'cash',
		worth => 'chart', minimum => 'down', aka => 'person', budget => 'chart',
		goals => 'bullseye', measures => 'measures', packaging => 'inventory',
		record => 'record', currency => 'cash', unit => 'ruler',
		manufacturer => 'manufacturer', inventory_method => 'inventory',
		quantity => 'calculator', home_plate => 'home', nfc => 'key',
		navigation => 'gps', birthday => 'cake', evaluation => 'checkmark',
	);
%>
<div id="configuration_container" class="cfg">
	<%= include 'configure/appointment_list/style' %>
	<% &subs::manufacturer_grabber(); %>
	<% my $signatorial = &subs::signatorial_designer(); %>
	<% my $app_themes = $app_themes || {}; %>
	<% foreach my $a (sort keys %{$appts}) { %>
		<% if ($appts->{$a}->{'formatted_name'}) { %>
			<div class="cfg-card app_block" app="<%= $a %>">
				<div class="app_block_head">
					<a href="/manager?app=<%= $a %>&timestamp=<%= $timestamp %>" target="_blank" timestamp="<%= $timestamp %>"><img src="<%= &subs::icon_for('/images/decipherable/windows.png') %>" hint="Window" class="medium_thumb" app="<%= $a %>"></a>
					<div class="app_block_name">
						<span app="<%= $a %>"><input setting="name_change" class="name_change timed_input configure_input" app="<%= $a %>" value="<%= $appts->{$a}->{'formatted_name'} %>"></span>
					</div>
					<span class="navbar_buttons" style="right:7px;">
						<img src="<%= &subs::icon_for('/images/decipherable/vacuum.png') %>" hint="Vacuum" class="vacuum_app medium_thumb" app="<%= $a %>">
						<%# Destructive and house-wide: the name has to be typed, so it cannot be
						    hit by accident in the day-to-day panel. %>
						<img src="<%= &subs::icon_for('/icons/trash.png') %>" hint="Delete app" class="delete_whole_app medium_thumb" app="<%= $a %>">
						<img src="<%= &subs::icon_for('/images/decipherable/adopt.png') %>" hint="Adopt" class="adopt_app medium_thumb" app="<%= $a %>">
						<img src="<%= &subs::icon_for('/images/decipherable/home.png') %>" hint="Home" class="medium_thumb" onClick="appointmentGrabber('<%= $a %>','<%= $timestamp %>')">
						<img src="<%= &subs::icon_for('/images/decipherable/clothesline.png') %>" hint="Clothesline" class="medium_thumb clothesline" app="<%= $a %>">
					</span>
				</div>
				<% my $template = $gb::pos->{$appts->{$a}->{'setting'}->{'pos'}}->{'template'}; %>
				<% if ($template) { %>
					<div class="cfg-scroll"><%= include $template, appts => $appts, a => $a %></div>
				<% } %>
				<% my $mab_template = $gb::pos->{$appts->{$a}->{'setting'}->{'mab'}}->{'template'}; %>
				<% if ($mab_template) { %>
					<div class="cfg-scroll"><%= include $mab_template, appts => $appts, a => $a %></div>
				<% } %>
				<div>
					<div class="app_block_meta">
						<span class="colour_field">
							<label>Colour</label>
							<input type="color" setting="colour" class="colour timed_input configure_input" app="<%= $a %>" value="<%= $appts->{$a}->{'setting'}->{'colour'} %>">
						</span>
						<span class="colour_field">
							<label>Dark Colour</label>
							<input type="color" setting="dark_colour" class="colour timed_input configure_input" app="<%= $a %>" hint="Dark theme colour" value="<%= $appts->{$a}->{'setting'}->{'dark_colour'} || &subs::dark_colour_for($appts->{$a}->{'setting'}->{'colour'}) %>">
						</span>
						<span class="theme_field">
							<label>Theme</label>
							<%# the desktop wears this while a start appointment for the app runs;
							    blank follows the Misc manager colour. A theme carries its icon set,
							    material and face too, so one name dresses the whole room. %>
							<% my $theme_registry = &subs::theme_registry(); %>
							<% my @theme_names = sort { lc($theme_registry->{$a}->{'name'} // $a) cmp lc($theme_registry->{$b}->{'name'} // $b) } keys %{$theme_registry}; %>
							<select setting="theme" class="configure_input" app="<%= $a %>" hint="Theme while running">
								<option value="" <% if (!length($app_themes->{$a} || '')) { %>selected="selected"<% } %>>Follow system</option>
								<optgroup label="<%= &subs::lang('configure.themes') %>">
									<% foreach my $theme_name ( @theme_names ) { %>
										<option value="<%= $theme_name %>" <% if (&subs::theme_canonical($app_themes->{$a}) eq $theme_name) { %>selected="selected"<% } %>><%= $theme_registry->{$theme_name}->{'name'} // &subs::format_name($theme_name) %></option>
									<% } %>
								</optgroup>
								<optgroup label="<%= &subs::ui('Colour schemes') %>">
									<% foreach my $scheme ( @subs::colour_scheme_order ) { %>
										<option value="<%= $scheme %>" <% if (($app_themes->{$a} || '') eq $scheme) { %>selected="selected"<% } %>><%= $scheme %></option>
									<% } %>
								</optgroup>
							</select>
						</span>
						<span class="app_checks">
							<span class="app_visibility_field" hint="<%= &subs::ui('New apps are Public. Public is shown as usual; Dangerous is also kept open during a lockdown. Private is a lock: the app and its appointments are hidden everywhere, even at home, never appear on the timeline, and can only be found in a private place with no Enemy present after a fingerprint (Security, Private apps). An appointment also inherits the strictest level of every social construct it belongs to (team, project, club, community, institution, government, corporation, place, vendor, event, account).') %>">
								<label><%= &subs::ui('Visibility') %></label>
								<% my $vis = &subs::visibility_normalize($appts->{$a}->{'setting'}->{'visible'}); %>
								<select app="<%= $a %>" class="configure_visibility" setting="visible">
									<% foreach my $opt ( qw/private public dangerous/ ) { %>
										<option value="<%= $opt %>" <% if ($vis eq $opt) { %>selected="selected"<% } %>><%= &subs::ui(ucfirst($opt)) %></option>
									<% } %>
								</select>
							</span>
							<% foreach my $check_set ( qw/unique permanent/ ) { %>
								<span>
									<input app="<%= $a %>" class="configure_checkbox" value="checked" type="checkbox" 
										<% if ($appts->{$a}->{'setting'}->{$check_set} eq "checked") { %> checked="checked" <% } %> setting="<%= $check_set %>" id="configure_visibility_<%= $a %>"></input> <%= &subs::format_name($check_set) %>
								</span>
							<% } %>
						</span>
					</div>

					<div class="cfg-grid">
						<div class="cfg-row">
							<label>Part of Speech</label>
							<span>
								<select class='pos' app='<%= $a %>' id="<%= $a %>_pos" setting="pos">
									<% foreach my $o (sort keys %{$gb::pos}) { %>
										<option <% if ( $appts->{$a}->{'setting'}->{'pos'} eq $o ){ %>selected="selected"<% } %>
										value="<%= $o %>"><%= &subs::format_name($o) %></option>
									<% } %>
								</select>
							</span>
						</div>
						<div class="cfg-row">
							<label>Might Also Be</label>
							<span>
								<select class='mab' app='<%= $a %>' id="<%= $a %>_mab" setting="mab">
									<option <% if ( $appts->{$a}->{'setting'}->{'mab'} eq '' ){ %>selected="selected"<% } %>
									<% foreach my $o (sort keys %{$gb::pos}) { %>
										<option <% if ( $appts->{$a}->{'setting'}->{'mab'} eq $o ){ %>selected="selected"<% } %>
										value="<%= $o %>"><%= &subs::format_name($o) %></option>
									<% } %>
								</select>
							</span>
						</div>
					</div>
					<% if ($appts->{$a}->{'setting'}->{'main_image'}) { %>
						<span class="main_image_config" app="<%= $a %>">
							<% my $main_image = &subs::main_icon_maker({ app => $a, timestamp => $timestamp, settings => $appts->{$a}->{'setting'}, size => 'huge' }); %>
							<br>
							<%== $main_image %>
							<img src="<%= &subs::icon_for('/icons/trash.png') %>" hint="Delete" class="little_thumb" onClick="settingDeleter({ 'app': '<%= $a %>', 'setting': 'main_image' });$('.main_image_config[app=<%= $a %>]').remove()"
						</span>
					<% } %>
					<div class="app_abilities">
						<h4 class="app_abilities_title">Abilities</h4>
						<% foreach my $b (sort keys %{$abilities}) { %>
							<%# the tender type only means something on an account %>
							<% next if $b eq 'payment_type' && !(($appts->{$a}->{'setting'}->{'pos'} || '') eq 'account' || ($appts->{$a}->{'setting'}->{'mab'} || '') eq 'account'); %>
							<span class="configuration_ability_container" setting="<%= $b %>">
								<button app="<%= $a %>" formatted_setting="<%= &subs::format_name($b) %>" setting="<%= $b %>" class="app_configure_toggle"><img class="ability_icon" alt="" hint="<%= &subs::format_name($b) %>" src="<%= &subs::icon_path($ability_icon{$b} || $b, $b eq 'birthday' ? '/images/decipherable/cake.png' : '/images/decipherable/gear.png') %>"><span class="ability_label">
									<% if ($b eq 'evaluation') { %>
										<b>Evaluation:</b> <%= do { my $c = &subs::evaluation_cadence($a); $c eq 'off' ? 'on demand' : ($c eq 'each_run' ? 'every run' : $c) } %>
									<% } elsif ($b eq 'birthday') { %>
										<b>Birthday:</b> <%= $appts->{$a}->{'setting'}->{'birthday'} || 'not set' %>
									<% } elsif ($b eq 'phones' || $b eq 'emails') { %>
										<b><%= &subs::format_name($b) %>:</b> <%= do {
											my $kind = $b eq 'phones' ? 'phone' : 'email';
											my $list = eval { decode_json $appts->{$a}->{'setting'}->{$b} } || [];
											$list = [ $list ] if ref $list eq 'HASH';
											$list = [] unless ref $list eq 'ARRAY';
											my $primary = $appts->{$a}->{'setting'}->{$kind};
											my @all = grep { $_ && $_->{'value'} } ( ($primary ? { value => $primary } : ()), @{$list} );
											if (!scalar @all) { 'none' }
											elsif (scalar @all == 1) { $all[0]->{'value'} }
											else { scalar(@all) . ' kept' }
										} %>
									<% } else { %>
										<b><%= &subs::format_name($b) %>:</b> <%= &subs::shorthand_name($appts->{$a}->{'setting'}->{$b},20) %>
									<% } %>
								</span></button>
								<div style="display:none;" class="app_configure_input" setting="<%= $b %>" app="<%= $a %>">
									<% if ($b eq 'birthday') { %>
										<div class="cfg-row">
											<label>Birthday</label>
											<span app="<%= $a %>"><input setting="birthday" class="configure_input" app="<%= $a %>" value="<%= $appts->{$a}->{'setting'}->{'birthday'} %>" placeholder="e.g. February 12 1809"></span>
										</div>
									<% } elsif ($b eq 'evaluation') { %>
										<%= include 'apps/evaluation_controls', app => $a %>
										<% my $app_evaluation = &subs::evaluation_report_for($a); %>
										<% if (($app_evaluation->{'text'} || '') ne '') { %>
											<%= include 'apps/evaluation_report', report => $app_evaluation, app => $a, controls => 0 %>
										<% } %>
									<% } elsif ($b eq 'notifications') { %>
										<div class="app_notification_configurator" app="<%= $a %>">
											<h4><%= &subs::lang('alarm_for_future_appointments') %></h4>
											<div class="cfg-row">
												<label><%= &subs::ui('Set a Clock alarm for future appointments') %></label>
												<span app="<%= $a %>"><input type="checkbox" app="<%= $a %>" setting="alarm" class="configure_input" value="on" <% if ($appts->{$a}->{'setting'}->{'alarm'} eq 'on') { %> checked="checked" <% } %>></span>
											</div>
											<div class="cfg-note" style="margin-bottom:10px;"><%= &subs::ui('A future appointment with this on adds its time to the Clock as an alarm, linked back to this appointment.') %></div>
											<% foreach my $when ( ('','start_','stop_','budget_')) { %>
												<h4><%= &subs::format_name($when || 'default') %></h4>
												<select class="app_notification_sound_selector configure_input" setting="<%= $when %>notification_sound" when="<%= $when %>" app="<%= $a %>">
													<option value="">(default)</option>
													<% foreach my $sound ( sort split /\n/, `ls ./public/sounds/notifications/*.mp3 2>/dev/null` ) { %>
														<% 
															my @fs = split '/', $sound;
															my @t = split '\.', $fs[-1];
														%>
														<option value="<%= $sound %>" <% if ($sound eq $appts->{$a}->{'setting'}->{$when . 'notification_sound'}) { %>selected<% } %>><%= &subs::format_name($t[0]) %></option>
													<% } %>
												</select>

												<textarea app="<%= $a %>" setting="<%= $when %>notification_text" class="configure_input"  style="height: 60px; width: 97%;" type="text" value="<%= $appts->{$a}->{'setting'}->{$when . 'notification_text'} %>" placeholder="<%= &subs::format_name($when . 'text') %>"><%= $appts->{$a}->{'setting'}->{$when . 'notification_text'} %></textarea>
											<% } %>
											<%# your own sound: the file lands beside the shipped ones, so it
											    appears in all four selects above (and on every other app's) %>
											<div class="cfg-row">
												<label>Add your own sound</label>
												<input type="file" class="app_notification_sound_upload" app="<%= $a %>" accept="audio/*" hint="Add sound">
												<span class="app_notification_sound_status" app="<%= $a %>"></span>
											</div>
										</div>
									<% } elsif ($b eq 'measures') { %>
										<div class="app_measures_configurator" app="<%= $a %>">
											<%= include 'configure/app_measures', settings => $appts->{$a}->{'setting'}, a => $a %>
										</div>
									<% } elsif ($b eq 'packaging') { %>
										<div class="app_packaging_configurator" app="<%= $a %>">
											<%= include 'configure/packaging', settings => $appts->{$a}->{'setting'}, a => $a %>
										</div>
									<% } elsif ($b eq 'budget' || $b eq 'goals') { %>
										<div class="budget_goals_configurator" app="<%= $a %>">
											<%= include 'configure/budget_goals', settings => $appts->{$a}->{'setting'}, a => $a, setting => $b %>
										</div>
									<% } elsif ($b eq 'web') { %>
										<div class="cfg-row">
											<label>URL</label>
											<textarea app="<%= $a %>" setting="<%= $b %>" class="configure_input"  style="height: 60px;" type="text" value="<%= $appts->{$a}->{'setting'}->{$b} %>" placeholder="<%= $b %>"><%= $appts->{$a}->{'setting'}->{$b} %></textarea>
										</div>
										<div class="cfg-row">
											<label>Format</label>
											<select app="<%= $a %>" setting="<%= $b %>_format" class="configure_input" value="<%= $appts->{$a}->{'setting'}->{'web_format'} %>">
												<% if ($appts->{$a}->{'setting'}->{'web_format'} eq '' || !$appts->{$a}->{'setting'}->{'web_format'}) { $appts->{$a}->{'setting'}->{'web_format'} = 'html'; } %>
												<% foreach my $f ( qw/html json/ ) { %>
													<option value="<%= $f %>" <% if ( $appts->{$a}->{'setting'}->{'web_format'} eq $f ) { %>selected<% } %>><%= $f %></option>
												<% } %>
											</select>
										</div>
										<div class="cfg-row">
											<label>Recurring</label>
											<input app="<%= $a %>" setting="web_recurring" class="configure_input" value="<%= $appts->{$a}->{'setting'}->{'web_recurring'} %>">
										</div>
										<div class="cfg-row">
											<label>Archives</label>
											<select app="<%= $a %>" setting="web_archives" class="configure_input" value="<%= $appts->{$a}->{'setting'}->{'web_archives'} %>">
												<option value="1" <% if (!$appts->{$a}->{'setting'}->{'web_archives'} || $appts->{$a}->{'setting'}->{'web_archives'} == 1) { %>selected<% } %>>1</option>
												<% for ( my $n = 2; $n <= 100; $n++ ) { %>
													<option value="<%= $n %>" <% if ($appts->{$a}->{'setting'}->{'web_archives'} == $n) { %>selected<% } %>><%= $n %></option>
												<% } %>	
											</select>
										</div>
										<div class="cfg-row">
											<label>Device</label>
											<select app="<%= $a %>" setting="web_headless_device" value="<%= $appts->{$a}->{'setting'}->{'web_headless_device'} %>" class="configure_input">
												<% foreach my $d (qw/none all mobile computer server/) { %>
													<option value="<%= $d %>" <% if ($appts->{$a}->{'setting'}->{'web_headless_device'} eq $d) { %>selected<% } %>><%= &subs::format_name($d) %></option>
												<% } %>
												<option value="<%= $signatorial %>" <% if ($appts->{$a}->{'setting'}->{'web_headless_device'} eq $signatorial) { %>selected<% } %>>Me</option>
												<% foreach my $rc ( @{&subs::remote_machine_lister()} ) { %>
													<option value="<%= $rc->{'signatorial'} %>" <% if ($appts->{$a}->{'setting'}->{'web_headless_device'} eq $rc->{'signatorial'}) { %>selected<% } %>><%= $rc->{'lan_ip'} || $rc->{'ip'} %></option>
												<% } %>
											</select>
										</div>
										<% my $web_measures = &subs::db_query('select * from settings where app = ? and setting = ? and device = ?', $a, 'web_measure_data', &subs::device_setter())->hashes; %>
										<% if (scalar @{$web_measures} > 0) { %>
											<div class="cfg-scroll app_web_measures">
												<table>
													<thead>
														<th>Meas</th><th>Sel</th><th>Count</th><th>Del</th>
													</thead>
													<tbody>
														<% foreach my $wm ( @{$web_measures} ) { %>
															<% my $wd = eval { return decode_json $wm->{'value'} } || {}; %>
															<tr>
																<td data-label="Meas"><%= &subs::format_name($wd->{'measure'}) %></td>
																<td data-label="Sel"><%= $wd->{'selector'} %></td>
																<td data-label="Count"><%= $wd->{'count'} %></td>
																<td data-label="Del"><img class="little_thumb hover web_measure_delete" app="<%= $a %>" measure="<%= $wd->{'measure'} %>" src="<%= &subs::icon_for('/icons/trash.png') %>" hint="Delete">
															</tr>											
														<% } %>
													</tbody>
												</table>
											</div>
										<% } %>
									<% } elsif ($b eq 'home_plate') { %>
										<div class="home_plate_configuration" app="<%= $a %>">
											<%= include 'configure/home_plate', settings => $appts->{$a}->{'setting'}, app => $a %>
										</div>
									<% } elsif ($b eq 'nfc') { %>
										<% 
											my $nfc = eval { return decode_json $appts->{$a}->{'setting'}->{'nfc'} } || [];
											my $new_uuid = &subs::random_string_creator(100);
											push @{$nfc}, { uuid => $new_uuid };
											foreach my $n ( @{$nfc} ) {
												my $is_new = ($n->{'uuid'} eq $new_uuid) ? 1 : 0; %>
												<div class="nfc_settings<%= $is_new ? ' nfc_new' : '' %>" uuid="<%= $n->{'uuid'} %>" app="<%= $a %>">
													<div class="nfc_top">
														<span class="nfc_title"><%= $is_new ? &subs::lang('nfc_add_tag') : &subs::lang('nfc_tag') %></span>
														<% if (!$is_new) { %>
															<span class="nfc_taps" title="<%= &subs::lang('nfc_taps') %>"><%= &subs::lang('nfc_taps') %>: <%= $n->{'taps'} || 0 %></span>
														<% } %>
													</div>
													<label class="nfc_field">
														<span><%= &subs::lang('nfc_when_tapped') %></span>
														<select class="nfc_setting" setting="control">
															<option value=""<% if (!length($n->{'control'} // '')) { %> selected<% } %>><%= &subs::lang('nfc_choose_action') %></option>
															<% foreach my $control ( sort qw/start record command usual/ ) { %>
																<option value="<%= $control %>"<% if (($n->{'control'} // '') eq $control) { %> selected<% } %>><%= &subs::format_name($control) %></option>
															<% } %>
														</select>
													</label>
													<% if ($is_new) { %>
														<p class="nfc_help"><%= &subs::ui('Choose an action to add this app to a tag; writing the tag needs the phone app.') %></p>
													<% } else { %>
														<p class="nfc_help"><%= &subs::ui('Tap this tag on a phone to start or stop this app.') %></p>
														<div class="nfc_buttons">
															<% if (&subs::device_setter() eq 'mobile') { %>
																<button type="button" class="nfc_btn nfc_appt_writer" app="<%= $a %>" uuid="<%= $n->{'uuid'} %>"><%= &subs::lang('nfc_write_tag') %></button>
															<% } %>
															<button type="button" class="nfc_btn danger nfc_deleter" app="<%= $a %>" uuid="<%= $n->{'uuid'} %>"><%= &subs::lang('delete') %></button>
														</div>
														<span class="nfc_write_status" role="status" aria-live="polite"></span>
													<% } %>
												</div>
										<% } %>
									<% } elsif ($b eq 'phones' || $b eq 'emails') { %>
										<% my $kind = $b eq 'phones' ? 'phone' : 'email'; %>
										<% my $primary = $appts->{$a}->{'setting'}->{$kind}; %>
										<div class="contact_list" list="<%= $b %>" kind="<%= $kind %>" app="<%= $a %>">
											<p class="contact_hint"><% if ($kind eq 'phone') { %>The app's own <b>phone</b> row is the line calls and texts route on<% } else { %>The app's own <b>email</b> row is the address mail routes on<% } %><% if ($primary) { %> (<%= $primary %>)<% } %>. Any other number or address goes here, with a type.</p>
											<div class="contact_rows">
												<% my $list = eval { decode_json $appts->{$a}->{'setting'}->{$b} } || []; %>
												<% $list = [ $list ] if ref $list eq 'HASH'; %>
												<% $list = [] unless ref $list eq 'ARRAY'; %>
												<% foreach my $row ( @{$list} ) { next unless ref $row eq 'HASH'; %>
													<div class="contact_row" uuid="<%= $row->{'uuid'} %>">
														<select class="contact_field" field="type">
															<% foreach my $t ( qw/mobile home work custom/ ) { %>
																<option value="<%= $t %>" <% if (($row->{'type'} || '') eq $t) { %>selected<% } %>><%= &subs::format_name($t) %></option>
															<% } %>
														</select>
														<input class="contact_field contact_label" field="label" placeholder="label" value="<%= $row->{'label'} %>"<% if (($row->{'type'} || '') ne 'custom') { %> style="display:none;"<% } %>>
														<input class="contact_field contact_value" field="value" placeholder="<%= $kind %>" value="<%= $row->{'value'} %>">
														<img src="<%= &subs::icon_for('/icons/trash.png') %>" hint="Delete" class="little_thumb contact_delete hover">
													</div>
												<% } %>
											</div>
											<button type="button" class="contact_add" list="<%= $b %>" kind="<%= $kind %>" app="<%= $a %>">Add <%= &subs::format_name($kind) %></button>
										</div>
									<% } elsif ($gb::abilities->{$b}->{'config'} eq 'select') { %>
										<select app="<%= $a %>" setting="<%= $b %>" class="configure_input" style="height: 33px; width: 99%;" type="text" value="<%= $appts->{$a}->{'setting'}->{$b} %>" placeholder="<%= $b %>">
											<% foreach my $o ( @{$gb::abilities->{$b}->{'options'}}) { %>
												<option <% if ($o eq $appts->{$a}->{'setting'}->{$b}) { %>selected <% } %> value="<%= $o %>"><% if ($gb::abilities->{$b}->{'formatted'} eq 'yes') { %><%= &subs::format_name($o) %><% } else { %><%= $o %><% } %></option>
											<% } %>
										</select>

									<% } else { %>									
										<textarea app="<%= $a %>" setting="<%= $b %>" class="configure_input"  style="height: 60px; width: 97%;" type="text" value="<%= $appts->{$a}->{'setting'}->{$b} %>" placeholder="<%= $b %>"><%= $appts->{$a}->{'setting'}->{$b} %></textarea>
									<% } %>
								</div>
							</span>
						<% } %>
					</div>
					<% if (lc($appts->{$a}->{'setting'}->{'payment_type'} || '') eq 'crypto') { %>
						<% my $wa = &subs::crypto_asset($appts->{$a}->{'setting'}->{'crypto_asset'}) || &subs::crypto_asset('BTC'); %>
						<% my @wlist = @{ &subs::crypto_enabled_assets() }; push @wlist, $wa->{'code'} unless grep { $_ eq $wa->{'code'} } @wlist; %>
						<div class="cfg-card crypto_wallet_card" app="<%= $a %>" style="margin-top:10px;">
							<h4 style="margin-top:0;">Wallet</h4>
							<p class="cfg-note">JawnOS keeps a public address, never a key or a seed phrase. It can read what the wallet holds, but it cannot spend from it — nothing here asks for a phrase that could.</p>
							<div class="cfg-grid">
								<div class="cfg-row">
									<label>Coin</label>
									<select class="crypto_wallet_input" setting="crypto_asset" app="<%= $a %>">
										<% foreach my $code ( @wlist ) { my $as = &subs::crypto_asset($code); next unless $as; %>
											<option value="<%= $as->{'code'} %>" <% if ($as->{'code'} eq $wa->{'code'}) { %>selected<% } %>><%= $as->{'code'} %> — <%= $as->{'name'} %></option>
										<% } %>
									</select>
								</div>
								<div class="cfg-row">
									<label>Network</label>
									<select class="crypto_wallet_input" setting="crypto_network" app="<%= $a %>">
										<% my $wnet = $appts->{$a}->{'setting'}->{'crypto_network'} || $wa->{'network'}; %>
										<% foreach my $net ( qw/bitcoin ethereum tron litecoin solana dogecoin xrpl cardano bnb avalanche polkadot bitcoin-cash stellar cosmos ton other/ ) { %>
											<option value="<%= $net %>" <% if ($net eq $wnet) { %>selected<% } %>><%= &subs::format_name($net) %></option>
										<% } %>
									</select>
								</div>
							</div>
							<div class="cfg-row">
								<label>Address</label>
								<input type="text" class="crypto_wallet_input crypto_wallet_address" setting="wallet_address" app="<%= $a %>" value="<%= $appts->{$a}->{'setting'}->{'wallet_address'} %>" placeholder="public address only" autocomplete="off" spellcheck="false">
								<button type="button" class="crypto_wallet_copy" app="<%= $a %>">Copy</button>
							</div>
							<p class="cfg-note" style="margin:0 0 8px;"><%= &subs::ui('Recommended: a hardware wallet you control, never an exchange deposit address. For the widest coin coverage, Ledger Nano S Plus or Flex; for open-source firmware, Trezor Safe 3/5 or BitBox02; Bitcoin only, Coldcard or Blockstream Jade. Buy direct from the maker, never a reseller, confirm the address on the device\'s own screen, and send a small test amount first. Without an account xpub below, JawnOS keeps this one address and reuses it on every invoice.') %></p>
							<div class="cfg-row">
								<label><%= &subs::ui('Account xpub') %></label>
								<% my $wallet_xpub = &subs::crypto_wallet_setting($a, 'wallet_xpub') || ''; %>
								<input type="text" class="crypto_wallet_input crypto_wallet_xpub" setting="wallet_xpub" app="<%= $a %>" value="<%= $wallet_xpub %>" placeholder="zpub / ypub / xpub" autocomplete="off" spellcheck="false">
							</div>
							<p class="cfg-note" style="margin:0 0 8px;"><%= &subs::ui('Optional, Bitcoin only. Paste the account xpub from the wallet to give every invoice its own receiving address. It is public: it derives addresses and cannot spend. Never paste a private key or a seed phrase.') %></p>
							<div class="cfg-row">
								<label>Label</label>
								<input type="text" class="crypto_wallet_input" setting="wallet_label" app="<%= $a %>" value="<%= $appts->{$a}->{'setting'}->{'wallet_label'} %>" placeholder="house cold wallet">
							</div>
							<span class="cfg-note crypto_wallet_status" app="<%= $a %>" style="margin:0;"></span>
						</div>
					<% } %>
				</div>
			</div>
		<% } %>
	<% } %>				
</div>
