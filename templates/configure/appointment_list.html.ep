<% use Mojo::JSON qw/decode_json encode_json/; %>
<% no warnings 'uninitialized'; %>
<%
	# ability -> icon name; &subs::icon_path picks the current icon set's tile by
	# that name, or the fallback image when the name has no tile (build.js renders
	# one tile per set). Keeps the App panel's ability grid recognisable at a glance.
	my %ability_icon = (
		notifications => 'bell', category => 'category', description => 'note',
		duration => 'metronome', warranty => 'badge', schedule => 'title',
		phone => 'phone_sms', notes => 'note', email => 'envelope', web => 'web_button',
		logo => 'gallery', address => 'place', specs => 'list', command => 'code',
		position => 'marker', formulas => 'calculator', kill => 'scraper', cost => 'cash',
		worth => 'chart', minimum => 'down', aka => 'person', budget => 'chart',
		goals => 'bullseye', measures => 'measures', packaging => 'inventory',
		record => 'record', currency => 'cash', unit => 'ruler',
		manufacturer => 'manufacturer', inventory_method => 'inventory',
		quantity => 'calculator', home_plate => 'home', nfc => 'key',
		navigation => 'gps', evaluation => 'checkmark',
	);
%>
<div id="configuration_container" class="cfg">
	<style>
	/* The App panel is the largest Configure tab: one card per app. The card's
	   head holds the window/actions, the name, the colour and the three flags;
	   Part of Speech and Might Also Be sit side by side (stacking under 560px
	   through .cfg-grid). The abilities sit in a grid of icon tiles; opening one
	   spans the whole card, so its panel - measures, packaging, budgets, a web
	   table - has the room it needs. */
	#configuration_container .app_block_head { display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin:0 0 8px; }
	#configuration_container .app_block_head .navbar_buttons { position:static; right:auto; display:inline-flex; flex-wrap:wrap; gap:6px; align-items:center; }
	#configuration_container .app_block_head .navbar_buttons img,
	#configuration_container .app_block_head > a img { height:38px; }
	#configuration_container .app_block_name { margin:0 0 6px; }
	#configuration_container .app_block_name span { display:flex; }
	#configuration_container .cfg-row > span { flex:1 1 220px; min-width:0; display:flex; }
	#configuration_container .cfg-row > span > select,
	#configuration_container .cfg-row > span > input { flex:1 1 auto; width:100%; min-width:0; box-sizing:border-box; padding:7px 9px; border-radius:7px; border:1px solid var(--line); background:var(--panel); color:var(--ink); font:inherit; }
	#configuration_container .cfg-row > span > input.colour,
	#configuration_container .cfg-row > span:has(> input.colour) { flex:0 0 auto; }
	#configuration_container .cfg-row > span > input.colour { width:auto; }
	#configuration_container .app_block_name .name_change { width:100%; font-weight:600; }
	#configuration_container .app_checks { display:flex; flex-wrap:wrap; gap:14px; align-items:center; margin:8px 0; font-size:13px; }
	#configuration_container .app_checks > span { display:inline-flex; align-items:center; gap:5px; }
	#configuration_container .app_abilities { display:grid; grid-template-columns:repeat(auto-fill, minmax(150px, 1fr)); gap:6px; margin-top:10px; align-items:start; }
	#configuration_container .configuration_ability_container { display:block; min-width:0; }
	/* an opened ability takes the whole card - its panel is a measures table, a
	   budget list, a web table - so it spans every column of the grid */
	#configuration_container .configuration_ability_container.open { grid-column:1 / -1; }
	/* a <button> is not a reliable flex container in every browser/WebView, so the
	   tile stacks with plain block layout: the icon on its own line, the label
	   beneath it. height:auto overrides the shell's global button height (34px),
	   which would otherwise clip the tile to a band behind the icon */
	#configuration_container .configuration_ability_container .app_configure_toggle { width:100%; height:auto; text-align:center; min-width:0; }
	#configuration_container .app_configure_toggle .ability_icon { display:block; margin:0 auto 4px; width:34px; height:34px; }
	#configuration_container .app_configure_toggle .ability_label { display:block; min-width:0; max-width:100%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
	#configuration_container .app_configure_input { padding:10px; margin:2px 0 4px; border:1px solid var(--line); border-radius:8px; background:var(--panel); overflow-x:auto; }
	#configuration_container .app_configure_input .configure_input,
	#configuration_container .app_configure_input .app_measure_configuration,
	#configuration_container .app_configure_input .app_measure_configuration_matcher,
	#configuration_container .app_configure_input .home_plate_setting,
	#configuration_container .app_configure_input .budget_goals_value,
	#configuration_container .app_configure_input .budget_goals_count { box-sizing:border-box; max-width:100%; }
	#configuration_container .app_measure_configuration_matcher_container,
	#configuration_container .budget_goals_row,
	#configuration_container .packaging_config_container,
	#configuration_container .home_plate_setting_container { display:flex; flex-wrap:wrap; gap:6px; align-items:center; margin:6px 0; }
	#configuration_container .packaging_config_container,
	#configuration_container .home_plate_setting_container { padding:6px; border:1px solid var(--line); border-radius:8px; background:var(--panel-2, var(--panel)); }
	#configuration_container .nfc_settings { border:1px solid var(--line); border-radius:8px; padding:8px; margin:6px 0; }
	#configuration_container .app_web_measures { margin-top:8px; }
	@media (max-width:640px) {
		#configuration_container .app_web_measures table,
		#configuration_container .app_web_measures thead,
		#configuration_container .app_web_measures tbody,
		#configuration_container .app_web_measures tr,
		#configuration_container .app_web_measures td { display:block; width:100%; box-sizing:border-box; }
		#configuration_container .app_web_measures thead { display:none; }
		#configuration_container .app_web_measures tr { border:1px solid var(--line); border-radius:8px; margin:8px 0; padding:6px; }
		#configuration_container .app_web_measures td { border:0; padding:3px 2px; }
		#configuration_container .app_web_measures td[data-label]::before { content: attr(data-label) ": "; opacity:.65; }
	}
	@media (max-width:560px) {
		/* the row is a column here, so a flex-basis meant for width would become a
		   height (the tall box that used to swallow the Part-of-Speech dropdown) */
		#configuration_container .cfg-row > span { flex:0 0 auto; width:100%; }
	}
	</style>
	<% &subs::manufacturer_grabber(); %>
	<% my $signatorial = &subs::signatorial_designer(); %>
	<% foreach my $a (sort keys %{$appts}) { %>
		<% if ($appts->{$a}->{'formatted_name'}) { %>
			<div class="cfg-card app_block" app="<%= $a %>">
				<div class="app_block_head">
					<a href="/manager?app=<%= $a %>&timestamp=<%= $timestamp %>" target="_blank" timestamp="<%= $timestamp %>"><img src="<%= &subs::icon_for('/images/decipherable/windows.png') %>" hint="Window" class="medium_thumb" app="<%= $a %>"></a>
					<span class="navbar_buttons" style="right:7px;">
						<img src="<%= &subs::icon_for('/images/decipherable/vacuum.png') %>" hint="Vacuum" class="vacuum_app medium_thumb" app="<%= $a %>">
						<img src="<%= &subs::icon_for('/images/decipherable/adopt.png') %>" hint="Adopt" class="adopt_app medium_thumb" app="<%= $a %>">
						<img src="<%= &subs::icon_for('/images/decipherable/home.png') %>" hint="Home" class="medium_thumb" onClick="appointmentGrabber('<%= $a %>','<%= $timestamp %>')">
						<img src="<%= &subs::icon_for('/images/decipherable/clothesline.png') %>" hint="Clothesline" class="medium_thumb clothesline" app="<%= $a %>">
					</span>
				</div>
				<% my $template = $gb::pos->{$appts->{$a}->{'setting'}->{'pos'}}->{'template'}; %>
				<% if ($template) { %>
					<div class="cfg-scroll"><%= include $template, appts => $appts, a => $a %></div>
				<% } %>
				<% my $mab_template = $gb::pos->{$appts->{$a}->{'setting'}->{'mab'}}->{'template'}; %>
				<% if ($mab_template) { %>
					<div class="cfg-scroll"><%= include $mab_template, appts => $appts, a => $a %></div>
				<% } %>
				<div>
					<div class="app_block_name">
						<span app="<%= $a %>"><input setting="name_change" class="name_change timed_input configure_input" app="<%= $a %>" value="<%= $appts->{$a}->{'formatted_name'} %>"></span>
					</div>
					<div class="cfg-row">
						<label>Colour</label>
						<span app="<%= $a %>"><input type="color" setting="colour" class="colour timed_input configure_input" app="<%= $a %>" value="<%= $appts->{$a}->{'setting'}->{'colour'} %>"></span>
					</div>
					<%# a thing that is a person (the app named for them) can carry their
					    birthday here; the time machine reads it before asking the guide %>
					<div class="cfg-row">
						<label>Birthday</label>
						<span app="<%= $a %>"><input setting="birthday" class="configure_input" app="<%= $a %>" value="<%= $appts->{$a}->{'setting'}->{'birthday'} %>" placeholder="e.g. February 12 1809"></span>
					</div>
					<div class="app_checks">
						<% foreach my $check_set ( qw/visible unique permanent/ ) { %>
							<span>
								<input app="<%= $a %>" class="configure_checkbox" value="checked" type="checkbox" 
									<% if ($appts->{$a}->{'setting'}->{$check_set} eq "checked") { %> checked="checked" <% } %> setting="<%= $check_set %>" id="configure_visibility_<%= $a %>"></input> <%= &subs::format_name($check_set) %>
							</span>
						<% } %>
					</div>

					<div class="cfg-grid">
						<div class="cfg-row">
							<label>Part of Speech</label>
							<span>
								<select class='pos' app='<%= $a %>' id="<%= $a %>_pos" setting="pos">
									<% foreach my $o (sort keys %{$gb::pos}) { %>
										<option <% if ( $appts->{$a}->{'setting'}->{'pos'} eq $o ){ %>selected="selected"<% } %>
										value="<%= $o %>"><%= &subs::format_name($o) %></option>
									<% } %>
								</select>
							</span>
						</div>
						<div class="cfg-row">
							<label>Might Also Be</label>
							<span>
								<select class='mab' app='<%= $a %>' id="<%= $a %>_mab" setting="mab">
									<option <% if ( $appts->{$a}->{'setting'}->{'mab'} eq '' ){ %>selected="selected"<% } %>
									<% foreach my $o (sort keys %{$gb::pos}) { %>
										<option <% if ( $appts->{$a}->{'setting'}->{'mab'} eq $o ){ %>selected="selected"<% } %>
										value="<%= $o %>"><%= &subs::format_name($o) %></option>
									<% } %>
								</select>
							</span>
						</div>
					</div>
					<% if ($appts->{$a}->{'setting'}->{'main_image'}) { %>
						<span class="main_image_config" app="<%= $a %>">
							<% my $main_image = &subs::main_icon_maker({ app => $a, timestamp => $timestamp, settings => $appts->{$a}->{'setting'}, size => 'huge' }); %>
							<br>
							<%== $main_image %>
							<img src="<%= &subs::icon_for('/icons/trash.png') %>" hint="Delete" class="little_thumb" onClick="settingDeleter({ 'app': '<%= $a %>', 'setting': 'main_image' });$('.main_image_config[app=<%= $a %>]').remove()"
						</span>
					<% } %>
					<div class="app_abilities">
						<% foreach my $b (sort keys %{$abilities}) { %>
							<span class="configuration_ability_container" setting="<%= $b %>">
								<button app="<%= $a %>" formatted_setting="<%= &subs::format_name($b) %>" setting="<%= $b %>" class="app_configure_toggle"><img class="ability_icon" alt="" hint="<%= &subs::format_name($b) %>" src="<%= &subs::icon_path($ability_icon{$b} || $b, '/images/decipherable/gear.png') %>"><span class="ability_label"><b><%= &subs::format_name($b) %>:</b> <%= &subs::shorthand_name($appts->{$a}->{'setting'}->{$b},20) %></span></button>
								<div style="display:none;" class="app_configure_input" setting="<%= $b %>" app="<%= $a %>">
									<% if ($b eq 'notifications') { %>
										<div class="app_notification_configurator" app="<%= $a %>">
											<% foreach my $when ( ('','start_','stop_','budget_')) { %>
												<h4><%= &subs::format_name($when || 'default') %></h4>
												<select class="app_notification_sound_selector configure_input" setting="<%= $when %>notification_sound" when="<%= $when %>" app="<%= $a %>">
													<% foreach my $sound ( split /\n/, `ls ./public/sounds/notifications/*.mp3` ) { %>
														<% 
															my @fs = split '/', $sound;
															my @t = split '\.', $fs[-1];
														%>
														<option value="<%= $sound %>" <% if ($sound eq $appts->{$a}->{'setting'}->{$when . 'notification_sound'}) { %>selected<% } %>><%= &subs::format_name($t[0]) %></option>
													<% } %>
												</select>

												<textarea app="<%= $a %>" setting="<%= $when %>notification_text" class="configure_input"  style="height: 60px; width: 97%;" type="text" value="<%= $appts->{$a}->{'setting'}->{$when . 'notification_text'} %>" placeholder="<%= &subs::format_name($when . 'text') %>"><%= $appts->{$a}->{'setting'}->{$when . 'notification_text'} %></textarea>
											<% } %>
										</div>
									<% } elsif ($b eq 'measures') { %>
										<div class="app_measures_configurator" app="<%= $a %>">
											<%= include 'configure/app_measures', settings => $appts->{$a}->{'setting'}, a => $a %>
										</div>
									<% } elsif ($b eq 'packaging') { %>
										<div class="app_packaging_configurator" app="<%= $a %>">
											<%= include 'configure/packaging', settings => $appts->{$a}->{'setting'}, a => $a %>
										</div>
									<% } elsif ($b eq 'budget' || $b eq 'goals') { %>
										<div class="budget_goals_configurator" app="<%= $a %>">
											<%= include 'configure/budget_goals', settings => $appts->{$a}->{'setting'}, a => $a, setting => $b %>
										</div>
									<% } elsif ($b eq 'web') { %>
										<div class="cfg-row">
											<label>URL</label>
											<textarea app="<%= $a %>" setting="<%= $b %>" class="configure_input"  style="height: 60px;" type="text" value="<%= $appts->{$a}->{'setting'}->{$b} %>" placeholder="<%= $b %>"><%= $appts->{$a}->{'setting'}->{$b} %></textarea>
										</div>
										<div class="cfg-row">
											<label>Format</label>
											<select app="<%= $a %>" setting="<%= $b %>_format" class="configure_input" value="<%= $appts->{$a}->{'setting'}->{'web_format'} %>">
												<% if ($appts->{$a}->{'setting'}->{'web_format'} eq '' || !$appts->{$a}->{'setting'}->{'web_format'}) { $appts->{$a}->{'setting'}->{'web_format'} = 'html'; } %>
												<% foreach my $f ( qw/html json/ ) { %>
													<option value="<%= $f %>" <% if ( $appts->{$a}->{'setting'}->{'web_format'} eq $f ) { %>selected<% } %>><%= $f %></option>
												<% } %>
											</select>
										</div>
										<div class="cfg-row">
											<label>Recurring</label>
											<input app="<%= $a %>" setting="web_recurring" class="configure_input" value="<%= $appts->{$a}->{'setting'}->{'web_recurring'} %>">
										</div>
										<div class="cfg-row">
											<label>Archives</label>
											<select app="<%= $a %>" setting="web_archives" class="configure_input" value="<%= $appts->{$a}->{'setting'}->{'web_archives'} %>">
												<option value="1" <% if (!$appts->{$a}->{'setting'}->{'web_archives'} || $appts->{$a}->{'setting'}->{'web_archives'} == 1) { %>selected<% } %>>1</option>
												<% for ( my $n = 2; $n <= 100; $n++ ) { %>
													<option value="<%= $n %>" <% if ($appts->{$a}->{'setting'}->{'web_archives'} == $n) { %>selected<% } %>><%= $n %></option>
												<% } %>	
											</select>
										</div>
										<div class="cfg-row">
											<label>Device</label>
											<select app="<%= $a %>" setting="web_headless_device" value="<%= $appts->{$a}->{'setting'}->{'web_headless_device'} %>" class="configure_input">
												<% foreach my $d (qw/none all mobile computer server/) { %>
													<option value="<%= $d %>" <% if ($appts->{$a}->{'setting'}->{'web_headless_device'} eq $d) { %>selected<% } %>><%= &subs::format_name($d) %></option>
												<% } %>
												<option value="<%= $signatorial %>" <% if ($appts->{$a}->{'setting'}->{'web_headless_device'} eq $signatorial) { %>selected<% } %>>Me</option>
												<% foreach my $rc ( @{&subs::remote_machine_lister()} ) { %>
													<option value="<%= $rc->{'signatorial'} %>" <% if ($appts->{$a}->{'setting'}->{'web_headless_device'} eq $rc->{'signatorial'}) { %>selected<% } %>><%= $rc->{'ip'} %></option>
												<% } %>
											</select>
										</div>
										<% my $web_measures = &subs::db_query('select * from settings where app = ? and setting = ? and device = ?', $a, 'web_measure_data', &subs::device_setter())->hashes; %>
										<% if (scalar @{$web_measures} > 0) { %>
											<div class="cfg-scroll app_web_measures">
												<table>
													<thead>
														<th>Meas</th><th>Sel</th><th>Count</th><th>Del</th>
													</thead>
													<tbody>
														<% foreach my $wm ( @{$web_measures} ) { %>
															<% my $wd = eval { return decode_json $wm->{'value'} } || {}; %>
															<tr>
																<td data-label="Meas"><%= &subs::format_name($wd->{'measure'}) %></td>
																<td data-label="Sel"><%= $wd->{'selector'} %></td>
																<td data-label="Count"><%= $wd->{'count'} %></td>
																<td data-label="Del"><img class="little_thumb hover web_measure_delete" app="<%= $a %>" measure="<%= $wd->{'measure'} %>" src="<%= &subs::icon_for('/icons/trash.png') %>" hint="Delete">
															</tr>											
														<% } %>
													</tbody>
												</table>
											</div>
										<% } %>
									<% } elsif ($b eq 'home_plate') { %>
										<div class="home_plate_configuration" app="<%= $a %>">
											<%= include 'configure/home_plate', settings => $appts->{$a}->{'setting'}, app => $a %>
										</div>
									<% } elsif ($b eq 'nfc') { %>
										<% 
											my $nfc = eval { return decode_json $appts->{$a}->{'setting'}->{'nfc'} } || [];
											my $new_uuid = &subs::random_string_creator(100);
											push @{$nfc}, { uuid => $new_uuid };
											foreach my $n ( @{$nfc} ) { %>
												<div class="nfc_settings" uuid="<%= $n->{'uuid'} %>" app="<%= $a %>" style="width:100%;">
													<label>Control</label>
													<select class="nfc_setting" setting="control" value="<%= $n->{'control'} %>">
														<option value="" <% if ($n->{'control'} || $n->{'control'} eq '') { %>selected<% } %>></option>
														<% foreach my $control ( sort qw/start record command usual/ ) { %>
															<option value="<%= $control %>" <% if ($n->{'control'} eq $control) { %>selected<% } %>><%= &subs::format_name($control) %></option>
														<% } %>
													</select>
													<% if (&subs::device_setter() eq 'mobile' && $n->{'uuid'} ne $new_uuid) { %>
														<img src="<%= &subs::icon_for('/images/decipherable/diskette.png') %>" hint="Save" class="little_thumb nfc_appt_writer hover" app="<%= $a %>" uuid="<%= $n->{'uuid'} %>">
													<% } %>
													<% if ($n->{'uuid'} ne $new_uuid) { %>
														<img src="<%= &subs::icon_for('/icons/trash.png') %>" hint="Delete" class="little_thumb nfc_deleter hover" app="<%= $a %>" uuid="<%= $n->{'uuid'} %>">
													<% } %>
													<% if ($n->{'uuid'} ne $new_uuid) { %>
														<br><label>Taps: </label> <%= $n->{'taps'} || 0 %>

													<% } %>
												</div>
											<% } %>
									<% } elsif ($gb::abilities->{$b}->{'config'} eq 'select') { %>
										<select app="<%= $a %>" setting="<%= $b %>" class="configure_input" style="height: 33px; width: 99%;" type="text" value="<%= $appts->{$a}->{'setting'}->{$b} %>" placeholder="<%= $b %>">
											<% foreach my $o ( @{$gb::abilities->{$b}->{'options'}}) { %>
												<option <% if ($o eq $appts->{$a}->{'setting'}->{$b}) { %>selected <% } %> value="<%= $o %>"><% if ($gb::abilities->{$b}->{'formatted'} eq 'yes') { %><%= &subs::format_name($o) %><% } else { %><%= $o %><% } %></option>
											<% } %>
										</select>

									<% } else { %>									
										<textarea app="<%= $a %>" setting="<%= $b %>" class="configure_input"  style="height: 60px; width: 97%;" type="text" value="<%= $appts->{$a}->{'setting'}->{$b} %>" placeholder="<%= $b %>"><%= $appts->{$a}->{'setting'}->{$b} %></textarea>
									<% } %>
								</div>
							</span>
						<% } %>
						<%# the evaluation wears the shape of an ability too: the toggle opens
						    the controls that run one and the report it last left, so an app's
						    evaluation is configured where the app is %>
						<span class="configuration_ability_container" setting="evaluation">
							<button app="<%= $a %>" formatted_setting="Evaluation" setting="evaluation" class="app_configure_toggle"><img class="ability_icon" alt="" hint="Evaluation" src="<%= &subs::icon_path($ability_icon{'evaluation'}, '/images/decipherable/gear.png') %>"><span class="ability_label"><b>Evaluation:</b> <%= do { my $c = &subs::evaluation_cadence($a); $c eq 'off' ? 'on demand' : ($c eq 'each_run' ? 'every run' : $c) } %></span></button>
							<div style="display:none;" class="app_configure_input" setting="evaluation" app="<%= $a %>">
								<%= include 'apps/evaluation_controls', app => $a %>
								<%# the report the app last produced; a run that could not reach the
								    model is not shown as one (the controls keep the durable note) %>
								<% my $app_evaluation = &subs::evaluation_report_for($a); %>
								<% if (($app_evaluation->{'text'} || '') ne '') { %>
									<%= include 'apps/evaluation_report', report => $app_evaluation, app => $a %>
								<% } %>
							</div>
						</span>
					</div>
				</div>
			</div>
		<% } %>
	<% } %>				
</div>
