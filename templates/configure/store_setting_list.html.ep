<div class="cfg">
	<h2>Store</h2>
	<p class="cfg-note">Your shop's details, kept per device. Change one device's setting, or tick Anchor to copy a change to every device at once.</p>

	<div class="cfg-row">
		<label>Anchor</label>
		<span><input type="checkbox" class="anchor_all_settings" setting_type="me"></span>
	</div>

	<% foreach my $d ( @gb::device_types ) { %>
		<div class="cfg-card">
			<h3><%= $d %></h3>
			<% foreach my $m ( sort keys %{$store->{$d}} ) { %>

				<% unless ($m eq 'logo' || $m eq 'doc_notes' ) { %>
					<div class="cfg-row">
						<label><%= &subs::format_name($m) %></label>
						<input type="text" name="name" class="me_setting" device="<%= $d %>" setting="<%= $m %>" value="<%= $store->{$d}->{$m} %>">
					</div>
				<% } elsif ($m eq 'doc_notes' ) { %>
					<div class="cfg-row">
						<label><%= &subs::format_name($m) %></label>
						<textarea type="text" name="name" class="me_setting" device="<%= $d %>" setting="<%= $m %>"><%= $store->{$d}->{$m} %></textarea>
					</div>
				<% } elsif ($m eq 'logo') { %>
					<div class="cfg-row">
						<label><%= &subs::format_name($m) %></label>
						<img src="<%= $store->{$d}->{$m} || '/images/make believe/poppy.png' %>" class="large_thumb me_setting logo_upload_button"
							device="<%= $d %>" setting="<%= $m %>">
					</div>
					<div class="logo_upload_container" device="<%= $d %>">
						<form class="logo_upload" device="<%= $d %>" setting="<%= $m %>" style="display:none;">
							<input class="logo_upload_input" device="<%= $d %>" setting="<%= $m %>" type="file" name="fileupload" />
							<input type="submit" />
						</form>
					</div>
				<% } %>

			<% } %>
		</div>
	<% } %>
</div>
