<%# Configure -> Plat -> QA. The house's nightly suite runs on one machine;
    this panel names it and says whether that machine can actually run it.
    Only a computer or a server is offered: a phone or tablet can hold the
    roster but has neither the checkout nor the fence the suite needs. %>
<% no warnings 'uninitialized'; %>
<%
	my $qa_machines = &subs::qa_target_machines();
	my $qa_chosen = &subs::qa_nightly_device();
	my $qa_note_limit = &subs::qa_note_limit();
	my ($qa_note_min, $qa_note_max) = &subs::qa_note_limit_bounds();
	my %qa_lane_on = map { $_ => 1 } &subs::qa_coding_lanes();
	my %qa_lane_label = (
		notes      => 'Notes',
		security   => 'Security findings',
		installers => 'Installer gaps',
	);
	my $qa_times = &subs::qa_times_read();
	my $qa_warden_report = &subs::setting_grabber({ app => '__president', setting => 'qa_warden_report', device => 'all' });
	my $qa_local_ok = &subs::qa_device_kind_eligible(&subs::device_setter());
	my $qa_label = sub {
		my ($rm) = @_;
		my $name = $rm->{'hostname'} || $rm->{'fqdn'} || $rm->{'signatorial'} || '';
		return $name eq 'me' ? &subs::lang('configure.qa_this_machine') : $name;
	};
%>
	<p class="cfg-note"><%= &subs::ui('The QA suite runs once a night from one machine: per-route checks, the database contracts and the regression tests, all in a fenced copy of the house. Choose the machine here. Only a computer or a server is offered, because the suite needs a JawnOS checkout, perl and prove, and a private namespace to run in. The choice is a house setting, so every machine reads the same answer: the nightly timer on each machine asks this panel\'s setting whether that machine is the chosen one and skips its run when it is not. With no choice, each machine keeps the local fallback and runs its own suite. Choose Off to stop the whole nightly system - the QA suite, the UX loop and the coding night - on every machine; nothing is deleted and the times are kept for when you turn it back on.') %></p>
	<p class="cfg-note"><%= &subs::ui('Notes per night sets how many of the open JawnOS notes the 06:00 coding night works through, one at a time, and is also the default for the 05:30 UX loop. Pick 1 to 25; the default is 3. It is a house setting, so every machine reads the same number.') %></p>
	<p class="cfg-note"><%= &subs::ui('What the coding night works on chooses the sources it draws from. Notes are the open JawnOS notes. Security findings are the new high findings in the nightly security audit; the night fixes at most two of them. Installer gaps are the packages the installer check reports missing upstream; it fixes at most two. A report item has no note to close - the next report is what says whether it is still there. Choose at least one source.') %></p>
<div class="cfg-card">
	<h3 style="margin-top:0;"><%= &subs::lang('configure.qa_nightly') %></h3>
	<div class="cfg-row">
		<label><%= &subs::lang('configure.qa_nightly_device') %></label>
		<select id="qa_nightly_device" class="qa_nightly_device">
			<option value="none" <%= $qa_chosen eq 'none' ? 'selected' : '' %>><%= &subs::lang('configure.qa_off') %></option>
			<option value="" <%= $qa_local_ok ? '' : 'disabled' %> <%= $qa_chosen eq '' ? 'selected' : '' %>><%= &subs::lang('configure.qa_this_machine') %></option>
			<% foreach my $rm ( @{$qa_machines} ) { %>
				<option value="<%= $rm->{'signatorial'} %>" data-device="<%= $rm->{'device'} %>" <%= $qa_chosen eq $rm->{'signatorial'} ? 'selected' : '' %>><%= $qa_label->($rm) %> (<%= $rm->{'device'} %>)</option>
			<% } %>
		</select>
	</div>
	<div class="cfg-row">
		<label for="qa_note_limit"><%= &subs::lang('configure.qa_note_limit') %></label>
		<select id="qa_note_limit" class="qa_note_limit">
			<% for my $qa_n ( $qa_note_min .. $qa_note_max ) { %>
				<option value="<%= $qa_n %>" <%= $qa_n == $qa_note_limit ? 'selected' : '' %>><%= $qa_n %></option>
			<% } %>
		</select>
		<span id="qa_note_limit_status" class="cfg-note" style="margin:0 0 0 8px;"></span>
	</div>
	<div class="cfg-row" style="align-items:flex-start;">
		<label><%= &subs::ui('What the coding night works on') %></label>
		<span class="qa_coding_lanes">
			<% foreach my $qa_lane ( &subs::qa_coding_lanes_known() ) { %>
				<label style="margin-right:14px;white-space:nowrap;">
					<input type="checkbox" class="qa_coding_lane" value="<%= $qa_lane %>" <%= $qa_lane_on{$qa_lane} ? 'checked' : '' %>>
					<%= &subs::ui($qa_lane_label{$qa_lane} // $qa_lane) %>
				</label>
			<% } %>
		</span>
		<span id="qa_coding_lanes_status" class="cfg-note" style="margin:0 0 0 8px;"></span>
	</div>
	<div class="cfg-row">
		<label style="display:block;"><input type="checkbox" id="qa_warden_report" <% unless (defined $qa_warden_report && $qa_warden_report eq 'off') { %>checked="checked"<% } %>> <%= &subs::ui('Report warden results in the Handbook') %></label>
		<span id="qa_warden_report_status" class="cfg-note" style="margin:0 0 0 8px;"></span>
	</div>
	<p class="cfg-note" style="margin:6px 0 0;">
		<%= &subs::ui('The land warden rescues refused tickets the coordinator leaves; ticked, it files one Handbook note when a ticket needs a person - a conflict, a red suite, a timeout or a missing commit.') %>
	</p>
	<p class="cfg-note" style="margin:6px 0 0;">
		<%= &subs::ui('The nightly systemd timer reads this setting through qa/device_target.pl. The unit must be installed on every machine that might be chosen; the machine that is not chosen skips its run, and the chosen one runs it. The weekly artefact build stays wherever its toolchain is (mkosi, qemu, a full JDK) - it does not follow this choice.') %>
	</p>
</div>
<div class="cfg-card">
	<h3 style="margin-top:0;"><%= &subs::lang('configure.qa_schedule') %></h3>
	<div class="cfg-row">
		<label for="qa_suite_time"><%= &subs::lang('configure.qa_suite_time') %></label>
		<input type="text" id="qa_suite_time" class="qa_time" size="6" maxlength="5" placeholder="HH:MM" inputmode="numeric" autocomplete="off" value="<%= $qa_times->{'suite'} %>">
		<button type="button" class="button qa_run_now" data-run="suite"><%= &subs::lang('configure.qa_run_now') %></button>
		<span id="qa_suite_state" class="cfg-note" style="margin:0;"></span>
	</div>
	<div class="cfg-note" id="qa_suite_effective" style="margin:0 0 8px;"></div>
	<div class="cfg-row">
		<label for="qa_ux_time"><%= &subs::lang('configure.qa_ux_time') %></label>
		<input type="text" id="qa_ux_time" class="qa_time" size="6" maxlength="5" placeholder="HH:MM" inputmode="numeric" autocomplete="off" value="<%= $qa_times->{'ux'} %>">
		<button type="button" class="button qa_run_now" data-run="ux"><%= &subs::lang('configure.qa_run_now') %></button>
		<span id="qa_ux_state" class="cfg-note" style="margin:0;"></span>
	</div>
	<div class="cfg-note" id="qa_ux_effective" style="margin:0 0 8px;"></div>
	<div class="cfg-row">
		<label for="qa_coding_time"><%= &subs::lang('configure.qa_coding_time') %></label>
		<input type="text" id="qa_coding_time" class="qa_time" size="6" maxlength="5" placeholder="HH:MM" inputmode="numeric" autocomplete="off" value="<%= $qa_times->{'coding'} %>">
		<button type="button" class="button qa_run_now" data-run="coding"><%= &subs::lang('configure.qa_run_now') %></button>
		<span id="qa_coding_state" class="cfg-note" style="margin:0;"></span>
	</div>
	<div class="cfg-note" id="qa_coding_effective" style="margin:0 0 8px;"></div>
	<div class="cfg-row">
		<button type="button" id="qa_schedule_save" class="button"><%= &subs::lang('configure.qa_save_times') %></button>
		<span id="qa_schedule_status" class="cfg-note" style="margin:0 0 0 8px;white-space:pre-wrap;"></span>
	</div>
	<p class="cfg-note" style="margin:6px 0 0;">
		<%= &subs::ui('Each run has an HH:MM time and its systemd timer is retimed to match: saving writes a small drop-in beside the unit (50-jawn-schedule.conf), reloads systemd and restarts the timer on the chosen machine, and every run reports whether its timer was retimed, is not installed there, or failed. The line under each field is the schedule the timer actually holds, so a field and the unit cannot drift apart unseen. Run now starts that run on the chosen machine at once, refuses while it is already running, and shows the job state until it finishes. The drop-in, the reload and the start are root work: that machine needs passwordless sudo for install and systemctl, and the timer units installed under /etc/systemd/system.') %>
	</p>
</div>
<div class="cfg-card">
	<div class="cfg-row" style="justify-content:space-between;">
		<h3 style="margin:0;"><%= &subs::ui('Nightly reports') %></h3>
		<div class="cfg-actions" style="margin:0;">
			<button type="button" id="qa_reports_refresh" class="button"><%= &subs::ui('Refresh') %></button>
		</div>
	</div>
	<p class="cfg-note" style="margin:6px 0 8px;">
		<%= &subs::ui('The last 14 days of QA runs, newest first: the nightly installer check, the weekly build and the emulator run. Each drawer says which cadence it was and opens to a table per section - the Perl modules, the Debian and Arch packages, the Android SDK, the build steps, the emulator measurements. A run that found nothing wrong says so; one that stopped early says where. The reports stay on the machine that ran the job, so this list is the same from any machine you open the panel on.') %>
	</p>
	<div id="qa_reports" class="qa_reports"><%= &subs::ui('Loading…') %></div>
</div>
<div class="cfg-card">
	<div class="cfg-row" style="justify-content:space-between;">
		<h3 style="margin:0;"><%= &subs::lang('configure.qa_ready') %></h3>
		<div class="cfg-actions" style="margin:0;">
			<button type="button" id="qa_refresh" class="button"><%= &subs::lang('configure.qa_check') %></button>
			<button type="button" id="qa_install" class="button"><%= &subs::lang('configure.qa_install') %></button>
		</div>
	</div>
	<div id="qa_readiness" style="margin-top:8px;opacity:.85;font-size:13px;"><%= &subs::lang('configure.qa_checking') %></div>
	<div id="qa_install_status" class="cfg-note" style="margin-top:8px;white-space:pre-wrap;"></div>
</div>
