<% use Mojo::JSON qw/encode_json/; %>
<br>
Anchor <input type="checkbox" class="anchor_all_settings" setting_type="misc">
<br>

<% my $signatorial = &subs::signatorial_designer(); %>
<% my $dev = &subs::device_setter(); %>
<% my @devices = ( $signatorial, @gb::device_types ); %>
<%# the person's own row, which the device tabs inherit from (the manager reads
    a device's row first, then this one, then its own default) %>
<% my $me_row = $settings->{$signatorial} || {}; %>
<% my @fonts = (
	'system-ui, sans-serif',
	'Arial, sans-serif',
	'Helvetica, sans-serif',
	'Georgia, serif',
	'Times New Roman, serif',
	'Courier New, monospace',
	'Verdana, sans-serif',
	'Trebuchet MS, sans-serif',
	'Comic Sans MS, cursive',
	'Impact, sans-serif'
); %>

<%# ---- colour schemes: 20 light + 10 dark, each with hue drift + a lightness ramp -- %>
<% my $hsl = sub {
	my ($h, $s, $l) = @_;
	$h = (($h % 360) + 360) % 360;
	my $c = (1 - abs(2 * $l - 1)) * $s;
	my $x = $c * (1 - abs((($h / 60) % 2) - 1));
	my $m = $l - $c / 2;
	my ($r, $g, $b);
	if ($h < 60) { ($r, $g, $b) = ($c, $x, 0); }
	elsif ($h < 120) { ($r, $g, $b) = ($x, $c, 0); }
	elsif ($h < 180) { ($r, $g, $b) = (0, $c, $x); }
	elsif ($h < 240) { ($r, $g, $b) = (0, $x, $c); }
	elsif ($h < 300) { ($r, $g, $b) = ($x, 0, $c); }
	else { ($r, $g, $b) = ($c, 0, $x); }
	return sprintf('#%02X%02X%02X', map { int(($_ + $m) * 255 + 0.5) } ($r, $g, $b));
}; %>
<% my @hues = (
	[ 0, 'Red' ], [ 18, 'Vermilion' ], [ 36, 'Orange' ], [ 54, 'Amber' ], [ 72, 'Yellow' ],
	[ 90, 'Lime' ], [ 108, 'Green' ], [ 126, 'Emerald' ], [ 144, 'Teal' ], [ 162, 'Cyan' ],
	[ 180, 'Azure' ], [ 198, 'Sky' ], [ 216, 'Blue' ], [ 234, 'Indigo' ], [ 252, 'Violet' ],
	[ 270, 'Purple' ], [ 288, 'Magenta' ], [ 306, 'Pink' ], [ 324, 'Rose' ], [ 342, 'Crimson' ]
); %>
<% my @light_h = (-18, -6, 0, 10, 20, 30); %>
<% my @light_l = (0.86, 0.78, 0.70, 0.60, 0.50, 0.42); %>
<% my @light_s = (0.62, 0.58, 0.55, 0.52, 0.50, 0.50); %>
<% my @dark_h = (-14, -4, 4, 12, 20, 28); %>
<% my @dark_l = (0.34, 0.28, 0.23, 0.19, 0.15, 0.12); %>
<% my @dark_s = (0.52, 0.50, 0.48, 0.46, 0.45, 0.45); %>
<% my %schemes; my @scheme_order; %>
<% my %has_dark = map { $_ => 1 } qw/Red Orange Yellow Green Teal Azure Blue Violet Magenta Rose/; %>
<% foreach my $hu (@hues) {
	my ($h, $name) = @{$hu};
	push @scheme_order, $name;
	$schemes{$name} = [ map { $hsl->($h + $light_h[$_], $light_s[$_], $light_l[$_]) } (0 .. 5) ];
	if ($has_dark{$name}) {
		my $dname = $name . ' Dark';
		push @scheme_order, $dname;
		$schemes{$dname} = [ map { $hsl->($h + $dark_h[$_], $dark_s[$_], $dark_l[$_]) } (0 .. 5) ];
	}
} %>

<style>
	.misc_device_tab { padding:10px 24px; cursor:pointer; border-radius:8px; border:solid 2px; background:transparent; font-size:22px; }
	.misc_device_tab.selected { background:yellow; font-weight:bold; }
	.misc_device_block { display:none; }
	.misc_colour_chip { display:flex; flex-direction:column; align-items:center; width:104px; font-size:13px; text-align:center; }
	.misc_colour_chip input[type=color] { width:96px; height:30px; }
</style>

<div class="misc_device_tabs" style="display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:center;margin:10px 0;">
	<% foreach my $dt (@devices) { %>
		<% my $name = $dt eq $signatorial ? 'Me' : &subs::format_name($dt); %>
		<button class="misc_device_tab" device="<%= $dt %>"><%= $name %></button>
	<% } %>
</div>

<div class="misc_section" style="border:solid;border-radius:5px;padding:6px;margin:6px 0;">
	<h1 style="margin:0;">Appearance</h1>
	<div style="display:flex;flex-wrap:wrap;gap:16px;align-items:flex-end;margin-top:6px;">
		<label style="display:flex;flex-direction:column;max-width:260px;">
			<b>Font</b>
			<select class="misc_setting" setting="title_font" device="<%= $dev %>">
				<% my $current_font = &subs::setting_grabber({ app => 'misc', setting => 'title_font', device => $dev }) || ''; %>
				<% foreach my $f ( @fonts ) { %>
					<option value="<%= $f %>" style="font-family:<%= $f %>;" <% if ($current_font eq $f) { %>selected="selected"<% } %>><%= $f %></option>
				<% } %>
			</select>
		</label>
		<label style="display:flex;flex-direction:column;">
			<b>Colour Scheme</b>
			<select id="colour_scheme">
				<option value="">&mdash; choose &mdash;</option>
				<% foreach my $name (@scheme_order) { %>
					<option value="<%= $name %>"><%= $name %></option>
				<% } %>
			</select>
		</label>
		<label style="display:flex;flex-direction:column;max-width:260px;">
			<b>Icon Set</b>
			<% my $current_icon_set = &subs::setting_grabber({ app => 'misc', setting => 'icon_set', device => $dev }) || ''; %>
			<select class="misc_setting" setting="icon_set" device="<%= $dev %>">
				<option value="" <% if (!$current_icon_set) { %>selected="selected"<% } %>>Default</option>
				<% foreach my $s ( @gb::icon_sets ) { %>
					<option value="<%= $s %>" <% if ($current_icon_set eq $s) { %>selected="selected"<% } %>><%= $gb::icon_set_labels{$s} %></option>
				<% } %>
			</select>
		</label>
		<div class="icon_set_preview hover" style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;"></div>
		<label style="display:flex;flex-direction:column;">
			<b>Appointment Colours</b>
			<button id="appt_colour_update" class="hover">Re-theme appointments</button>
			<span id="appt_colour_update_status" style="font-size:13px;"></span>
		</label>
	</div>
</div>

<% foreach my $dt (@devices) { %>
	<% my $device_name = $dt eq $signatorial ? 'Me' : &subs::format_name($dt); %>
	<div class="misc_section misc_device_block" device="<%= $dt %>" style="border:solid;border-radius:5px;padding:6px;margin:6px 0;">
		<h1 style="margin:0;"><%= $device_name %></h1>

		<div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:6px;">
			<% my @general = (
				[ 'max_files', 'Max Files', [ 0..5000 ] ],
				[ 'photo_size', 'Photo Size', [ '', @{$photo_sizes} ] ],
				[ 'scan_size', 'Scan Size', [ '', @{$photo_sizes} ] ],
				[ 'thumbnail_size', 'Thumb Size', [ '', @{$thumbnail_sizes} ] ],
				[ 'encryption_standard', 'Encryption Standard', [ '', @{$encryption_standards} ] ],
				[ 'max_backups', 'Max Backups', [ 0..100 ] ],
			); %>
			<% foreach my $g ( @general ) { %>
				<% my ($key, $label, $opts) = @{$g}; %>
				<% my $chosen = (defined $settings->{$dt}->{$key} && length $settings->{$dt}->{$key}) ? $settings->{$dt}->{$key} : $me_row->{$key}; %>
				<label style="display:flex;flex-direction:column;">
					<b><%= $label %></b>
					<select id="<%= $key %>" class="misc_setting" device="<%= $dt %>" setting="<%= $key %>">
						<% foreach my $o ( @{$opts} ) { %>
							<option <% if ($chosen eq $o) { %>selected="selected"<% } %>><%= $o %></option>
						<% } %>
					</select>
				</label>
			<% } %>
		</div>

		<h4>Bars</h4>
		<div style="display:flex;flex-wrap:wrap;gap:10px;">
			<% my @bars = (
				[ 'dock_position', 'Dock', [ 'bottom', 'top', 'left', 'right', 'hidden' ] ],
				[ 'taskbar_position', 'Taskbar', [ 'bottom', 'top', 'hidden' ] ],
				[ 'search_placement', 'Search Bar', [ 'dock', 'taskbar' ] ],
				[ 'start_button_side', 'Start Button', [ 'right', 'left' ] ],
				[ 'dock_icons', 'Dock Icons', [ 'shown', 'hidden' ] ],
				[ 'clock_format', 'Clock', [ '24', '12' ] ],
			); %>
			<% foreach my $g ( @bars ) { %>
				<% my ($key, $label, $opts) = @{$g}; %>
				<%# the bars are read straight from the settings table: the list this template
				    is handed does not carry them, and the lying dropdown showed the first
				    option rather than what was stored. Falls back to Me, then nothing. %>
				<% my $chosen = &subs::misc_setting($key, $dt); %>
				<label style="display:flex;flex-direction:column;">
					<b><%= $label %></b>
					<select id="<%= $key %>" class="misc_setting" device="<%= $dt %>" setting="<%= $key %>">
						<% foreach my $o ( @{$opts} ) { %>
							<option <% if ($chosen eq $o) { %>selected="selected"<% } %>><%= $o %></option>
						<% } %>
					</select>
				</label>
			<% } %>
		</div>

		<% my @locations = &subs::location_types(); %>
		<% my $remote_machines = &subs::remote_machine_lister({ archive => 'yes' }); %>
		<h4>Locations</h4>
		<div style="display:flex;flex-wrap:wrap;gap:10px;">
			<% foreach my $l (@locations) { %>
				<div style="display:flex;flex-direction:column;border:solid;border-radius:5px;padding:4px;min-width:180px;">
					<b><%= &subs::format_name($l) %></b>
					<select id="<%= $l %>_location" class="misc_setting" device="<%= $dt %>" setting="<%= $l %>_location">
						<% foreach my $s ( '', @{$folders}) { %>
							<option <% if ($settings->{$dt}->{$l . '_location'} eq $s ){ %>selected="selected"<% } %>><%= $s %></option>
						<% } %>
					</select>
					<b style="font-size:13px;">Archive</b>
					<select id="<%= $l %>_archive" class="misc_setting" device="<%= $dt %>" setting="<%= $l %>_archive">
						<option value="">None</option>
						<% foreach my $rm ( @{$remote_machines} ) { %>
							<option value="<%= $rm->{'signatorial'} %>" <% if ($rm->{'signatorial'} eq $settings->{$dt}->{$l . '_archive'}) { %>selected<% } %>><%= $rm->{'hostname'} %></option>
						<% } %>
					</select>
				</div>
			<% } %>
		</div>

		<h4>Archive Root</h4>
		<div style="display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end;">
			<label style="display:flex;flex-direction:column;min-width:180px;">
				<b>archive_dir</b>
				<% my $current_archive_dir = $settings->{$dt}->{'archive_dir'} || ''; %>
				<select id="archive_dir" class="misc_setting" device="<%= $dt %>" setting="archive_dir">
					<% foreach my $s ( '', @{$folders} ) { %>
						<option <% if ($current_archive_dir eq $s) { %>selected="selected"<% } %>><%= $s %></option>
					<% } %>
				</select>
			</label>
			<span style="font-size:13px;max-width:340px;">The drive this machine archives to, out of the folders in config.json. Blank means it is not an archive.</span>
		</div>

		<h4>Colours</h4>
		<div style="display:flex;flex-wrap:wrap;gap:8px;">
			<% my @colours = @gb::misc_settings; %>
			<% foreach my $k ( @colours ) { %>
				<label class="misc_colour_chip">
					<%= $k %>
					<input type="color" object="<%= $k %>" id="<%= $k %>_background_colour" app="appearance" device="<%= $dt %>" class="misc_setting" setting="<%= $k %>_background_colour" value="<%= $config->{$dt}->{$k}->{'background_colour'} %>">
				</label>
			<% } %>
		</div>
	</div>
<% } %>

<script>
	var jawnos_colour_schemes = <%== encode_json \%schemes %>;
	var jawnos_colour_keys = <%== encode_json \@gb::misc_settings %>;
	(function () {
		var applying_scheme = false;

		function currentDevice() {
			return $('.misc_device_tab.selected').attr('device');
		}
		function deviceColours(device) {
			return $.map(jawnos_colour_keys, function (k) {
				var v = $('.misc_setting[setting="' + k + '_background_colour"][device="' + device + '"]').val();
				return ('' + (v === undefined ? '' : v)).toLowerCase();
			});
		}
		// Which scheme, if any, do these colours correspond to? Blank once hand-edited.
		function detectScheme(device) {
			var colours = deviceColours(device);
			var found = '';
			$.each(jawnos_colour_schemes, function (name, palette) {
				var matches = true;
				for (var i = 0; i < colours.length; i++) {
					if (colours[i] !== palette[i % palette.length].toLowerCase()) { matches = false; break; }
				}
				if (matches) { found = name; return false; }
			});
			return found;
		}
		function syncSchemeDropdown() {
			if (applying_scheme) { return; }
			var device = currentDevice();
			if (!device) { return; }
			$('#colour_scheme').val(detectScheme(device));
		}

		function showDevice(dev) {
			$('.misc_device_tab').removeClass('selected');
			$('.misc_device_tab[device="' + dev + '"]').addClass('selected');
			$('.misc_device_block').hide();
			$('.misc_device_block[device="' + dev + '"]').show();
			syncSchemeDropdown();
		}
		$(document).on('click', '.misc_device_tab', function () {
			var picked = $(this).attr('device');
			localStorage.setItem('misc_device', picked);
			showDevice(picked);
		});
		var remembered = localStorage.getItem('misc_device');
		var initial = (remembered && $('.misc_device_tab[device="' + remembered + '"]').length) ? remembered : $('.misc_device_tab').first().attr('device');
		if (initial) { showDevice(initial); }

		// A hand-edit to any colour swatch drops the scheme name if it no longer lines up.
		$(document).on('change', '.misc_colour_chip .misc_setting', function () {
			if ($(this).attr('device') == currentDevice()) { syncSchemeDropdown(); }
		});

		$(document).on('change', '#colour_scheme', function () {
			var name = $(this).val();
			var palette = jawnos_colour_schemes[name];
			if (!palette) { return; }
			var device = currentDevice();
			if (!device) { return; }
			// don't let the "Anchor" toggle copy the scheme to every device
			var anchor = $('.anchor_all_settings[setting_type="misc"]');
			var anchor_was = anchor.prop('checked');
			anchor.prop('checked', false);
			applying_scheme = true;
			$.each(jawnos_colour_keys, function (i, k) {
				var colour = palette[i % palette.length];
				$('.misc_setting[setting="' + k + '_background_colour"][device="' + device + '"]').val(colour).trigger('change');
			});
			applying_scheme = false;
			anchor.prop('checked', anchor_was);
			$('#colour_scheme').val(name);
		});

		// Changing the scheme leaves the appointments alone now; this is how they are
		// brought into line with it, on purpose.
		$(document).on('click', '#appt_colour_update', function () {
			var device = currentDevice();
			if (!device) { return; }
			$('#appt_colour_update_status').text('Re-theming...');
			$.ajax({
				url: '/manager/configure/colour_update',
				type: 'POST',
				data: { device: device },
				success: function (response) {
					$('#appt_colour_update_status').text(response.updated + ' appointment colour' + (response.updated == 1 ? '' : 's') + ' changed');
				},
				error: function () {
					$('#appt_colour_update_status').text('Could not update the colours');
				}
			});
		});
	})();

	// Icon set preview
	var jawnos_icon_preview = ['record', 'play', 'camera', 'bell', 'key', 'heart', 'envelope', 'marker'];
	var jawnos_handdrawn_preview = [
		'/icons/original/images/decipherable/folder.png',
		'/icons/original/images/decipherable/chart.png',
		'/icons/original/images/make believe/music.png',
		'/icons/original/images/decipherable/gallery.png',
		'/icons/original/images/decipherable/marker.png',
		'/icons/original/images/decipherable/measures.png',
		'/icons/original/images/decipherable/wrench.png',
		'/icons/original/images/decipherable/envelope.png'
	];
	function jawnosPreviewIcons(set) {
		var box = $('.icon_set_preview').empty();
		var urls = [];
		if (set == 'handdrawn') {
			urls = jawnos_handdrawn_preview;
		}
		else if (set) {
			$.each(jawnos_icon_preview, function (i, n) { urls.push('/icons/sets/' + set + '/' + n + '.svg'); });
		}
		else {
			box.html('<i>Using the default icons.</i>');
			return;
		}
		$.each(urls, function (i, u) {
			$('<img>').attr('src', u).css({ width: '40px', height: '40px' }).appendTo(box);
		});
	}
	jawnosPreviewIcons($('.misc_setting[setting="icon_set"]').val());
	$(document).on('change', '.misc_setting[setting="icon_set"]', function () { jawnosPreviewIcons($(this).val()); });
</script>
