<% use Mojo::JSON qw/encode_json/; %>
<div class="cfg">
	<h2>Misc</h2>
	<p class="cfg-note">Appearance, storage and per-device bars, locations and colours. Changes save as you make them; the Anchor toggle copies a change to every device.</p>
	<div class="cfg-card">
		<div class="cfg-row">
			<label><input type="checkbox" class="anchor_all_settings" setting_type="misc"> Anchor to all devices</label>
		</div>
	</div>

<% my $signatorial = &subs::signatorial_designer(); %>
<% my $dev = &subs::device_setter(); %>
<% my @devices = ( $signatorial, @gb::device_types ); %>
<%# the person's own row, which the device tabs inherit from (the manager reads
    a device's row first, then this one, then its own default) %>
<% my $me_row = $settings->{$signatorial} || {}; %>
<%# the interface language is one choice for the whole house, so it is stored on
    the "all" row and every machine and device tab follows it; the install writes
    the same value into config.json and the database. %>
<% my $current_language = ($settings->{'all'} || {})->{'language'} || $me_row->{'language'} || ($settings->{$dev} || {})->{'language'} || $config->{'language'} || 'en'; %>
<details class="cfg-acc" data-acc="misc-language" open>
	<summary><%= &subs::lang('configure.language') %></summary>
<div class="misc_section cfg-card">
	<div class="cfg-row">
		<label><b><%= &subs::lang('configure.language') %></b></label>
		<select id="language" class="misc_setting" setting="language" device="all">
			<% foreach my $l ( &subs::language_list() ) { %>
				<option value="<%= $l->{'code'} %>" <% if ($current_language eq $l->{'code'}) { %>selected="selected"<% } %>><%= $l->{'native'} %> — <%= $l->{'name'} %></option>
			<% } %>
		</select>
	</div>
	<p class="cfg-note"><%= &subs::lang('configure.language_note') %></p>
	<% my @tl = @{ $translation_languages || [] }; %>
	<% my $default_tr = &subs::language() ne 'en' ? &subs::language() : 'fr'; %>
	<details class="cfg-details">
		<summary>Translate this window</summary>
		<div class="cfg-row">
			<label><b>Target language</b></label>
			<select id="translate_target">
				<% foreach my $l ( @tl ) { %>
					<option value="<%= $l->{'code'} %>" <% if ($l->{'code'} eq $default_tr) { %>selected="selected"<% } %>><%= $l->{'native'} %> — <%= $l->{'name'} %></option>
				<% } %>
			</select>
		</div>
		<div class="cfg-actions">
			<button type="button" id="translate_window">Translate this window</button>
			<button type="button" id="translate_clear">Show original language</button>
			<span id="translate_status" style="font-size:13px;"></span>
		</div>
		<p class="cfg-note">Uses the Guide's model<% if ($translation_model) { %> (<b><%= $translation_model %></b><% if ($translation_model_fallback) { %>; fallback <b><%= $translation_model_fallback %></b><% } %>)<% } else { %> (no model is set under Plat)<% } %>. The visible labels, buttons and help text are translated on demand and cached; the saved interface language above is not changed.</p>
	</details>
	<details class="cfg-details">
		<summary>Languages the Guide can translate (<%= scalar @tl %>)</summary>
		<p class="cfg-note">The engine offers these; the model above does the translating, so quality varies by language.</p>
		<div style="columns:2;column-gap:18px;font-size:13px;">
			<% foreach my $l ( @tl ) { %>
				<div><%= $l->{'native'} %> <span style="opacity:.65;">— <%= $l->{'name'} %></span></div>
			<% } %>
		</div>
	</details>
</div>
</details>
<% my @fonts = (
	'system-ui, sans-serif',
	'Arial, sans-serif',
	'Helvetica, sans-serif',
	'Georgia, serif',
	'Times New Roman, serif',
	'Courier New, monospace',
	'Verdana, sans-serif',
	'Trebuchet MS, sans-serif',
	'Comic Sans MS, cursive',
	'Impact, sans-serif'
); %>

<%# ---- colour schemes: desktop looks in a light and a dark cut, named for
    their colour. Hand-picked and muted:
      Blue     - Windows 11   (#0078d4 / dark #4cc2ff accent)
      Graphite - macOS        (#6e6e73 chrome)
      Green    - Manjaro      (#35bf8b accent)
      Indigo   - GNOME        (#3584e4 Adwaita accent)
      Steel    - XFCE         (#3b6ea5 Greybird accent)
      Amber    - Ubuntu       (#e67e22 Yaru accent)
      Teal     - Mint         (#0e837e accent)
      Plum     - Pop!_OS      (#8b5cf6 accent)
      Rose     - elementary   (#d64570 accent)
    Each palette is a ramp the window surfaces cycle through. The dark cuts
    matter more than the light ones: the chrome (--panel/--ink) is derived from
    the *manager* surface, and theme_panel_css forces near-white panels (L 0.88)
    for any light manager colour - so only a dark manager gives dark windows. %>
<%# the table itself lives in subroutines.pl so the appointment theme dropdown
    and the Misc panel read the same schemes; see @subs::colour_scheme_order %>
<% my %schemes = %subs::colour_schemes; %>
<% my @scheme_order = @subs::colour_scheme_order; %>

<style>
	/* Device tabs and the two blocks the JS toggles. The grid extends the house
	   .cfg system to the panel's stacked label+control cells. */
	.misc_device_tabs { justify-content:center; }
	.misc_device_tab.selected { background:var(--line); font-weight:bold; }
	.misc_device_block { display:none; }
	.misc_grid { grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); }
	.misc_grid label { display:flex; flex-direction:column; gap:3px; }
	.misc_grid label > b { font-size:13px; opacity:.85; }
	.misc_grid label > select, .misc_grid label > input:not([type=color]) { width:100%; box-sizing:border-box; padding:7px 9px; border-radius:calc(var(--jawnos-corner, 12px) * .6); border:1px solid var(--line); background:var(--panel); color:var(--ink); font:inherit; }
	.misc_colour_chip { display:flex; flex-direction:column; align-items:center; width:118px; font-size:13px; text-align:center; }
	.misc_colour_chip input[type=color] { width:110px; height:34px; }
	/* ---- named themes: a gallery of whole dressings ---------------------- */
	.theme_gallery { display:grid; grid-template-columns:repeat(auto-fill,minmax(152px,1fr)); gap:10px; margin:4px 0 10px; }
	.theme_card { position:relative; display:flex; flex-direction:column; gap:7px; padding:10px; border:1px solid var(--line); border-radius:var(--jawnos-corner, 14px); background:var(--panel); cursor:pointer; text-align:left; color:var(--ink); box-shadow:0 1px 2px rgba(0,0,0,.06); transition:border-color .15s ease, box-shadow .15s ease, transform .15s ease; }
	.theme_card:hover { border-color:var(--accent, #3b7ddd); box-shadow:0 8px 20px rgba(0,0,0,.14); transform:translateY(-1px); }
	.theme_card.selected { border-color:var(--accent, #3b7ddd); box-shadow:0 0 0 2px var(--accent-soft, #e6effb); }
	.theme_card.selected::after { content:'\2713'; position:absolute; top:6px; right:9px; color:var(--accent, #3b7ddd); font-weight:bold; }
	.theme_swatches { display:flex; height:26px; border-radius:calc(var(--jawnos-corner, 12px) * .65); overflow:hidden; border:1px solid rgba(0,0,0,.12); }
	.theme_swatches span { flex:1 1 0; }
	.theme_card_name { font-weight:600; font-size:14px; line-height:1.2; }
	.theme_card_meta { font-size:12px; color:var(--ink-muted, #666); }
	.theme_edit { position:absolute; bottom:6px; right:6px; height:20px; min-width:0; padding:0 7px; font-size:11px; border-width:1px !important; border-radius:calc(var(--jawnos-corner, 12px) * .5); }
	.theme_form { display:grid; grid-template-columns:repeat(auto-fit,minmax(170px,1fr)); gap:12px; }
	.theme_form label { display:flex; flex-direction:column; gap:4px; font-size:13px; }
	.theme_form input[type=text], .theme_form select { width:100%; box-sizing:border-box; font-size:14px; min-height:32px; padding:4px 8px; }
	.theme_form input[type=number] { width:90px; }
	.theme_form input[type=color] { width:100%; height:32px; }
</style>

<div class="cfg-actions misc_device_tabs">
	<% foreach my $dt (@devices) { %>
		<% my $name = $dt eq $signatorial ? 'Me' : &subs::format_name($dt); %>
		<button class="misc_device_tab" device="<%= $dt %>"><%= $name %></button>
	<% } %>
</div>

<details class="cfg-acc" data-acc="misc-appearance" open>
	<summary>Appearance</summary>
<div class="misc_section cfg-card">
	<div class="cfg-row">
		<label><b>Zoom <span id="ui_zoom_value"><%= &subs::misc_setting('ui_zoom') || 100 %></span>%</b></label>
		<input type="range" class="misc_setting" setting="ui_zoom" device="<%= $dev %>" min="20" max="200" step="10" value="<%= &subs::misc_setting('ui_zoom') || 100 %>" oninput="jawnosZoomApply(this.value); document.getElementById('ui_zoom_value').textContent = this.value;">
	</div>
	<div class="cfg-row">
		<label><b><%= &subs::lang('configure.screensaver_timeout') %></b></label>
		<%# a bare number is minutes, so "3" is three minutes; the lock screen keeps
		    its own fifteen seconds and a playing video keeps the screensaver away %>
		<input type="text" class="misc_setting" setting="screensaver_timeout" device="<%= $dev %>"
			value="<%= &subs::setting_grabber({ app => 'misc', setting => 'screensaver_timeout', device => $dev }) || '' %>"
			placeholder="2m">
	</div>
	<p class="cfg-note"><%= &subs::ui('How long the manager waits before its screensaver starts. Type a number of minutes (3 is three minutes), or a length such as 30s or 3m. Leave it blank for two minutes. The lock screen still shows its screensaver after fifteen seconds, and a playing video keeps it away.') %></p>
	<div class="cfg-row">
		<label><b><%= &subs::lang('configure.screensaver_style') %></b></label>
		<% my $screensaver_style = &subs::setting_grabber({ app => 'misc', setting => 'screensaver_style', device => $dev }) || 'cartoon'; %>
		<select class="misc_setting" setting="screensaver_style" device="<%= $dev %>">
			<option value="cartoon" <% if ($screensaver_style eq 'cartoon') { %>selected="selected"<% } %>><%= &subs::lang('screensaver.cartoon') %></option>
			<option value="art" <% if ($screensaver_style eq 'art') { %>selected="selected"<% } %>><%= &subs::lang('screensaver.art') %></option>
		</select>
	</div>
	<div class="cfg-row">
		<label><b>Font</b></label>
		<select class="misc_setting" setting="title_font" device="<%= $dev %>">
			<% my $current_font = &subs::setting_grabber({ app => 'misc', setting => 'title_font', device => $dev }) || ''; %>
			<% foreach my $f ( @fonts ) { %>
				<option value="<%= $f %>" style="font-family:<%= $f %>;" <% if ($current_font eq $f) { %>selected="selected"<% } %>><%= $f %></option>
			<% } %>
		</select>
	</div>
	<% my $active_bundle = &subs::active_theme_bundle(); %>
	<% my $active_theme = $active_bundle->{'slug'} // ''; %>
	<%# A theme carries its own corner: with one in charge the slider is an
	    override on top of it (and Follow theme clears it); with none it is the
	    desk's own value. %>
	<% my $corner_setting = $active_theme ? 'corner_override' : 'corner_radius'; %>
	<% my $corner_stored = &subs::setting_grabber({ app => 'misc', setting => $corner_setting, device => $dev }) || ''; %>
	<% my $corner_value = ($corner_stored =~ /^\s*(\d{1,2})/) ? $1 : &subs::corner_radius(); %>
	<%# the desk's own corner, for the moment a theme is deselected while this
	    panel is open: the slider then becomes the Misc one again %>
	<% my $corner_misc = ((&subs::misc_setting('corner_radius') || '') =~ /^\s*(\d{1,2})/) ? $1 : 12; %>
	<div class="cfg-row">
		<label><b>Corner Radius <span id="<%= $corner_setting %>_value_<%= $dev %>"><%= $corner_value %></span>px</b></label>
		<input type="range" class="misc_setting" setting="<%= $corner_setting %>" device="<%= $dev %>"
			data-misc-corner="<%= $corner_misc %>"
			min="0" max="28" step="1" value="<%= $corner_value %>" oninput="jawnosMiscRangeInput(this);">
		<% if (length $active_theme) { %>
			<button type="button" id="corner_follow_theme" device="<%= $dev %>" theme_corner="<%= $active_bundle->{'corner'} || '12px' %>"><%= &subs::lang('configure.follow_theme') %></button>
		<% } %>
	</div>
	<p class="cfg-note"><%= &subs::ui('Corner Radius rounds every surface: window frames and their title bars, inputs, dropdowns, textareas, buttons, checkboxes, and the desk\'s panels and cards. 0 is square and 28 is the softest; a theme carries its own corner, and Follow theme returns to it.') %></p>
	<div class="cfg-row">
		<label><b>Texture</b></label>
		<% my $current_texture = $active_theme
			? (&subs::setting_grabber({ app => 'misc', setting => 'texture_override', device => $dev }) || '')
			: &subs::texture_name(); %>
		<select class="misc_setting" setting="<%= $active_theme ? 'texture_override' : 'texture' %>" device="<%= $dev %>">
			<% if ($active_theme) { %>
				<% my $theme_texture = $gb::texture_labels{ $active_bundle->{'texture'} } || ''; %>
				<option value="" <% if (!length $current_texture) { %>selected="selected"<% } %>><%= &subs::lang('configure.follow_theme') %><% if (length $theme_texture) { %> — <%= $theme_texture %><% } %></option>
			<% } %>
			<% foreach my $t ( @gb::textures ) { %>
				<option value="<%= $t %>" <% if ($current_texture eq $t) { %>selected="selected"<% } %>><%= $gb::texture_labels{$t} %></option>
			<% } %>
		</select>
	</div>
	<div class="cfg-row">
		<label><b>Colour Scheme</b></label>
		<select id="colour_scheme">
			<option value="">&mdash; choose &mdash;</option>
			<% foreach my $name (@scheme_order) { %>
				<option value="<%= $name %>"><%= $name %></option>
			<% } %>
		</select>
	</div>
	<div class="cfg-row">
		<label><b>Icon Set</b></label>
		<% my $current_icon_set = $active_theme
			? (&subs::setting_grabber({ app => 'misc', setting => 'icon_set_override', device => $dev }) || '')
			: (&subs::setting_grabber({ app => 'misc', setting => 'icon_set', device => $dev }) || ''); %>
		<select class="misc_setting" setting="<%= $active_theme ? 'icon_set_override' : 'icon_set' %>" device="<%= $dev %>">
			<% if ($active_theme) { %>
				<% my $theme_icon_label = $gb::icon_set_labels{ $active_bundle->{'icon_set'} } || ''; %>
				<option value="" <% if (!length $current_icon_set) { %>selected="selected"<% } %>><%= &subs::lang('configure.follow_theme') %><% if (length $theme_icon_label) { %> — <%= $theme_icon_label %><% } %></option>
			<% } else { %>
				<option value="" <% if (!length $current_icon_set) { %>selected="selected"<% } %>>Default</option>
			<% } %>
			<% foreach my $s ( @gb::icon_sets ) { %>
				<option value="<%= $s %>" <% if ($current_icon_set eq $s) { %>selected="selected"<% } %>><%= $gb::icon_set_labels{$s} %></option>
			<% } %>
		</select>
		<div class="icon_set_preview hover" style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;"></div>
	</div>
	<div class="cfg-row">
		<label><b>Start Button</b></label>
		<%# the start button's picture: any file in the jbuttons folder; the icon
		    set may carry a variant and icon_for() prefers it, so this is a theme
		    choice as much as a face %>
		<% my $current_start_icon = &subs::misc_setting('start_menu_icon') || '/images/jbuttons/logo1.png'; %>
		<% my @jbuttons = map { my $f = $_; $f =~ s|.*/||; $f } grep { /\.(png|svg|jpe?g)$/i } glob './public/images/jbuttons/*'; %>
		<select class="misc_setting" setting="start_menu_icon" device="<%= $dev %>">
			<% foreach my $f ( sort @jbuttons ) { %>
				<option value="/images/jbuttons/<%= $f %>" <% if ($current_start_icon eq "/images/jbuttons/$f") { %>selected="selected"<% } %>><%= $f %></option>
			<% } %>
		</select>
	</div>
	<p class="cfg-note"><%= &subs::ui('A theme carries its own icon set and material. Follow theme uses those; another choice overrides them for this machine while the theme is active. With no theme active, the choices here are the desk\'s own.') %></p>
	<div class="cfg-row">
		<label><b>Appointment Colours</b></label>
		<button id="appt_colour_update" class="hover">Re-theme appointments</button>
		<span id="appt_colour_update_status" style="font-size:13px;"></span>
	</div>
</div>
</details>

<%# ---- named themes ------------------------------------------------------
    A theme is the whole dressing, not just the paint. The gallery applies one
    to this device; the editor saves a named bundle that an appointment can
    wear later. Presets are read-only (builtin), custom ones are settings rows. %>
<% my $theme_registry = &subs::theme_registry(); %>
<% my $current_theme = &subs::setting_grabber({ app => 'misc', setting => 'appearance_theme', device => $dev }) || ''; %>
<% my @theme_order = grep { $theme_registry->{$_} && $theme_registry->{$_}->{'builtin'} } @subs::theme_preset_order; %>
<% my @custom_order = sort { lc($theme_registry->{$a}->{'name'} // $a) cmp lc($theme_registry->{$b}->{'name'} // $b) } grep { $theme_registry->{$_} && !$theme_registry->{$_}->{'builtin'} } keys %{$theme_registry}; %>
<% push @theme_order, @custom_order; %>
<% my @current_palette = &subs::theme_palette(); %>
<details class="cfg-acc" data-acc="misc-themes" open>
	<summary><%= &subs::lang('configure.themes') %></summary>
<div class="misc_section cfg-card" id="theme_gallery_card">
	<p class="cfg-note"><%= &subs::ui('A theme dresses the whole desktop: its colours, its icon set, its material, its face and its corner. Pick one for this machine, or save one of your own; an appointment can then wear it while it runs.') %></p>
	<div class="theme_gallery">
		<div class="theme_card<% if (!length $current_theme) { %> selected<% } %>" theme_slug="" role="button" tabindex="0">
			<span class="theme_swatches">
				<% my @system_chips = @current_palette ? @current_palette : @{ $subs::colour_schemes{'Graphite'} }; %>
				<% foreach my $c ( @system_chips ) { %><span style="background:<%= $c %>"></span><% } %>
			</span>
			<span class="theme_card_name"><%= &subs::lang('configure.follow_system') %></span>
			<span class="theme_card_meta"><%= &subs::ui('The Misc choices below') %></span>
		</div>
		<% foreach my $slug ( @theme_order ) { %>
			<% my $b = &subs::theme_bundle($slug); %>
			<% my $ramp = $subs::colour_schemes{ $b->{'scheme'} } || []; %>
			<div class="theme_card<% if ($current_theme eq $slug) { %> selected<% } %>" theme_slug="<%= $slug %>" data-builtin="<%= $b->{'builtin'} ? 1 : 0 %>" role="button" tabindex="0">
				<span class="theme_swatches"><% foreach my $c ( @{$ramp} ) { %><span style="background:<%= $c %>"></span><% } %></span>
				<span class="theme_card_name"><%= $b->{'name'} %></span>
				<span class="theme_card_meta"><%= join ' · ', grep { length } ( $b->{'scheme'}, $gb::texture_labels{ $b->{'texture'} }, $b->{'corner'} ) %></span>
				<% if (!$b->{'builtin'}) { %><button type="button" class="theme_edit" theme_slug="<%= $slug %>"><%= &subs::lang('configure.edit_theme') %></button><% } %>
			</div>
		<% } %>
	</div>
	<div class="cfg-actions">
		<button type="button" id="theme_new"><%= &subs::lang('configure.new_theme') %></button>
	</div>
</div>
</details>

<div class="misc_section cfg-card" id="theme_editor" style="display:none;">
	<h3><%= &subs::lang('configure.edit_theme') %></h3>
	<input type="hidden" id="theme_slug" value="">
	<div class="theme_form">
		<label><%= &subs::ui('Name') %>
			<input type="text" id="theme_name" maxlength="60" placeholder="<%= &subs::ui('A name for this theme') %>">
		</label>
		<label><%= &subs::ui('Colour scheme') %>
			<select id="theme_scheme">
				<% foreach my $scheme ( @subs::colour_scheme_order ) { %><option value="<%= $scheme %>"><%= $scheme %></option><% } %>
			</select>
		</label>
		<label><%= &subs::ui('Icon set') %>
			<select id="theme_icon_set">
				<option value=""><%= &subs::ui('System') %></option>
				<% foreach my $s ( @gb::icon_sets ) { %><option value="<%= $s %>"><%= $gb::icon_set_labels{$s} %></option><% } %>
			</select>
		</label>
		<label><%= &subs::ui('Texture') %>
			<select id="theme_texture">
				<option value=""><%= &subs::ui('System') %></option>
				<% foreach my $t ( @gb::textures ) { %><option value="<%= $t %>"><%= $gb::texture_labels{$t} %></option><% } %>
			</select>
		</label>
		<label><%= &subs::ui('Font') %>
			<select id="theme_font">
				<option value=""><%= &subs::ui('System') %></option>
				<% foreach my $f ( @gb::theme_fonts ) { %><option value="<%= $f->{'value'} %>"><%= $f->{'label'} %></option><% } %>
			</select>
		</label>
		<label><%= &subs::ui('Corner') %>
			<input type="number" id="theme_corner" min="0" max="28" step="1" value="10">
		</label>
		<label><%= &subs::ui('Accent') %>
			<input type="color" id="theme_accent" value="#3b7ddd">
		</label>
		<label style="flex-direction:row;align-items:center;gap:6px;">
			<input type="checkbox" id="theme_accent_auto" checked="checked"> <%= &subs::ui('Take the accent from the scheme') %>
		</label>
	</div>
	<div class="cfg-actions">
		<button type="button" id="theme_save"><%= &subs::ui('Save theme') %></button>
		<button type="button" id="theme_cancel"><%= &subs::ui('Cancel') %></button>
		<button type="button" id="theme_delete" style="display:none;"><%= &subs::ui('Delete theme') %></button>
		<span id="theme_status" style="font-size:13px;"></span>
	</div>
</div>

<% foreach my $dt (@devices) { %>
	<% my $device_name = $dt eq $signatorial ? 'Me' : &subs::format_name($dt); %>
	<div class="misc_section misc_device_block cfg-card" device="<%= $dt %>">
		<h3><%= $device_name %></h3>

		<details class="cfg-acc cfg-acc-sub" data-acc="misc-<%= &subs::html_name($dt) %>-general" open>
			<summary>General</summary>
			<div class="cfg-grid misc_grid">
			<% my @general = (
				[ 'max_files', 'Max Files', [ 0..5000 ] ],
				[ 'photo_size', 'Photo Size', [ '', @{$photo_sizes} ] ],
				[ 'scan_size', 'Scan Size', [ '', @{$photo_sizes} ] ],
				[ 'thumbnail_size', 'Thumb Size', [ '', @{$thumbnail_sizes} ] ],
				[ 'encryption_standard', 'Encryption Standard', [ '', @{$encryption_standards} ] ],
				[ 'max_backups', 'Max Backups', [ 0..100 ] ],
			); %>
			<% foreach my $g ( @general ) { %>
				<% my ($key, $label, $opts) = @{$g}; %>
				<% my $chosen = (defined $settings->{$dt}->{$key} && length $settings->{$dt}->{$key}) ? $settings->{$dt}->{$key} : ($me_row->{$key} // ''); %>
				<label>
					<b><%= $label %></b>
					<select id="<%= $key %>" class="misc_setting" device="<%= $dt %>" setting="<%= $key %>">
						<%# the list is the standards this machine can seal and open; a value
						    stored elsewhere is shown but not re-offered, so the panel never
						    silently looks as if it changed it %>
						<% if ($key eq 'encryption_standard' && length $chosen && !grep { $_ eq $chosen } @{$opts}) { %>
							<option selected="selected" disabled="disabled"><%= $chosen %> (not supported on this machine)</option>
						<% } %>
						<% foreach my $o ( @{$opts} ) { %>
							<option <% if ($chosen eq $o) { %>selected="selected"<% } %>><%= $o %></option>
						<% } %>
					</select>
				</label>
			<% } %>
		</div>
	</details>

	<details class="cfg-acc cfg-acc-sub" data-acc="misc-<%= &subs::html_name($dt) %>-bars">
		<summary>Bars</summary>
		<div class="cfg-grid misc_grid">
			<% my @bars = (
				[ 'dock_position', 'Dock', [ 'bottom', 'top', 'left', 'right', 'hidden' ] ],
				[ 'taskbar_position', 'Taskbar', [ 'bottom', 'top', 'hidden' ] ],
				[ 'search_placement', 'Search Bar', [ 'dock', 'taskbar', 'start_menu' ] ],
				[ 'dock_icons', 'Dock Icons', [ 'shown', 'hidden' ] ],
				[ 'clock_format', 'Clock', [ '24', '12' ] ],
				# a range rather than a list: [ key, label, 'range', min, max, step, default ]
				[ 'taskbar_height', 'Taskbar Height', 'range', 24, 72, 4, 44 ],
				[ 'navbar_height', 'Navbar Height', 'range', 28, 64, 4, 36 ],
				[ 'window_border', 'Window Border', 'range', 0, 8, 1, 1 ],
				# the edge on buttons, image buttons, icons and the clothesline
				[ 'button_border', 'Button Border', 'range', 0, 8, 1, 1 ],
				# the frame's colour, on its own: blank follows the theme (--line)
				[ 'window_border_colour', 'Window Border Colour', 'colour' ],
				# the colour of the edge on those same pressed surfaces and the rail
				[ 'button_border_colour', 'Button Border Colour', 'colour' ],
				[ 'clothesline_height', 'Clothesline Height', 'range', 20, 120, 4, 40 ],
			); %>
			<%# the colour picker starts on the theme's own line colour when the setting
			    is blank, so opening the panel never changes the look by itself %>
			<% my $theme_css = eval { &subs::theme_panel_css($config->{&subs::signatorial_designer()}->{'manager'}->{'background_colour'}) } || ''; %>
			<% my ($theme_line) = $theme_css =~ /--line:(#[0-9a-fA-F]{6})/; %>
			<% $theme_line ||= '#c9c9c9'; %>
			<% foreach my $g ( @bars ) { %>
				<% my ($key, $label, $opts) = @{$g}; %>
				<%# the bars are read straight from the settings table: the list this template
				    is handed does not carry them, and the lying dropdown showed the first
				    option rather than what was stored. Falls back to Me, then nothing. %>
				<% my $chosen = &subs::misc_setting($key, $dt) // ''; %>
				<% if (ref $opts eq 'ARRAY') { %>
					<label>
						<b><%= $label %></b>
						<select id="<%= $key %>" class="misc_setting" device="<%= $dt %>" setting="<%= $key %>">
							<% foreach my $o ( @{$opts} ) { %>
								<option <% if ($chosen eq $o) { %>selected="selected"<% } %>><%= $o %></option>
							<% } %>
						</select>
					</label>
				<% } elsif ($opts eq 'colour') { %>
					<% my $value = (defined $chosen && $chosen =~ /^#/) ? $chosen : $theme_line; %>
					<label style="align-items:center;">
						<b><%= $label %></b>
						<input type="color" id="<%= $key %>" class="misc_setting" device="<%= $dt %>" setting="<%= $key %>"
							value="<%= $value %>" style="width:110px;height:34px;"
							oninput="jawnosMiscColourInput(this);">
					</label>
				<% } else { %>
					<% my ($tag, $min, $max, $step, $def) = @{$g}[2 .. 6]; %>
					<% my $value = (defined $chosen && length $chosen) ? $chosen : $def; %>
					<%# a range's value rides a readout beside the label; the input event previews
					    the change on the live screen and the usual change handler writes it away --%>
					<label>
						<b><%= $label %> <span id="<%= $key %>_value_<%= $dt %>"><%= $value %></span>px</b>
						<input type="range" id="<%= $key %>" class="misc_setting" device="<%= $dt %>" setting="<%= $key %>"
							min="<%= $min %>" max="<%= $max %>" step="<%= $step %>" value="<%= $value %>"
							oninput="jawnosMiscRangeInput(this);">
					</label>
				<% } %>
			<% } %>
		</div>
	</details>

	<details class="cfg-acc cfg-acc-sub" data-acc="misc-<%= &subs::html_name($dt) %>-speech" open>
		<summary>Speech</summary>
		<div class="cfg-grid misc_grid">
			<%# say_it's voice for this device. The piper choices read neural models
			    staged under voices/; the eSpeak choices need nothing installed. %>
			<% my $say_chosen = &subs::misc_setting('say_voice', $dt) || &subs::say_default_voice(); %>
			<label>
				<b>Say voice</b>
				<select id="say_voice" class="misc_setting" device="<%= $dt %>" setting="say_voice">
					<% foreach my $v ( &subs::say_voices() ) { %>
						<option value="<%= $v->{'value'} %>" <% if ($say_chosen eq $v->{'value'}) { %>selected="selected"<% } %>><%= $v->{'label'} %></option>
					<% } %>
				</select>
			</label>
			<label style="align-items:center;">
				<b>Preview</b>
				<button type="button" class="hover say_voice_test" device="<%= $dt %>">Say test phrase</button>
			</label>
		</div>
		</details>

		<% my @locations = &subs::location_types(); %>
		<% my $remote_machines = &subs::remote_machine_lister({ archive => 'yes' }); %>
		<details class="cfg-acc cfg-acc-sub" data-acc="misc-<%= &subs::html_name($dt) %>-locations">
			<summary>Locations</summary>
			<div class="cfg-grid misc_grid">
			<% foreach my $l (@locations) { %>
				<%# these two come straight out of the settings table, which may not carry
				    the key at all; an unset one compares as blank rather than undef %>
				<% my $chosen_location = $settings->{$dt}->{$l . '_location'} // ''; %>
				<% my $chosen_archive = $settings->{$dt}->{$l . '_archive'} // ''; %>
				<div class="cfg-card">
					<b><%= &subs::format_name($l) %></b>
					<label>Location
						<select id="<%= $l %>_location" class="misc_setting" device="<%= $dt %>" setting="<%= $l %>_location">
							<% foreach my $s ( '', @{$folders}) { %>
								<option <% if ($chosen_location eq $s ){ %>selected="selected"<% } %>><%= $s %></option>
							<% } %>
						</select>
					</label>
					<label>Archive
						<select id="<%= $l %>_archive" class="misc_setting" device="<%= $dt %>" setting="<%= $l %>_archive">
							<option value="">None</option>
							<% foreach my $rm ( @{$remote_machines} ) { %>
								<option value="<%= $rm->{'signatorial'} %>" <% if ($rm->{'signatorial'} eq $chosen_archive) { %>selected<% } %>><%= $rm->{'hostname'} %></option>
							<% } %>
						</select>
					</label>
				</div>
			<% } %>
			</div>
		</details>

		<details class="cfg-acc cfg-acc-sub" data-acc="misc-<%= &subs::html_name($dt) %>-archive">
			<summary>Archive Root</summary>
			<div class="cfg-row">
			<label><b>archive_dir</b></label>
			<% my $current_archive_dir = $settings->{$dt}->{'archive_dir'} || ''; %>
			<select id="archive_dir" class="misc_setting" device="<%= $dt %>" setting="archive_dir">
				<% foreach my $s ( '', @{$folders} ) { %>
					<option <% if ($current_archive_dir eq $s) { %>selected="selected"<% } %>><%= $s %></option>
				<% } %>
			</select>
		</div>
		<p class="cfg-note">The drive this machine archives to, out of the folders in config.json. Blank means it is not an archive.</p>
		</details>

		<details class="cfg-acc cfg-acc-sub" data-acc="misc-<%= &subs::html_name($dt) %>-colours">
			<summary>Colours</summary>
			<div class="cfg-actions" style="flex-wrap:wrap;gap:8px;">
			<% my @colours = @gb::misc_settings; %>
			<% foreach my $k ( @colours ) { %>
				<label class="misc_colour_chip">
					<%= $k %>
					<input type="color" object="<%= $k %>" id="<%= $k %>_background_colour" app="appearance" device="<%= $dt %>" class="misc_setting" setting="<%= $k %>_background_colour" value="<%= $config->{$dt}->{$k}->{'background_colour'} %>">
				</label>
			<% } %>
		</div>
		</details>
	</div>
<% } %>
</div>

<script>
	var jawnos_colour_schemes = <%== encode_json \%schemes %>;
	var jawnos_colour_keys = <%== encode_json \@gb::misc_settings %>;
	(function () {
		var applying_scheme = false;

		function currentDevice() {
			return $('.misc_device_tab.selected').attr('device');
		}
		function deviceColours(device) {
			return $.map(jawnos_colour_keys, function (k) {
				var v = $('.misc_setting[setting="' + k + '_background_colour"][device="' + device + '"]').val();
				return ('' + (v === undefined ? '' : v)).toLowerCase();
			});
		}
		// Which scheme, if any, do these colours correspond to? Blank once hand-edited.
		function detectScheme(device) {
			var colours = deviceColours(device);
			var found = '';
			$.each(jawnos_colour_schemes, function (name, palette) {
				var matches = true;
				for (var i = 0; i < colours.length; i++) {
					if (colours[i] !== palette[i % palette.length].toLowerCase()) { matches = false; break; }
				}
				if (matches) { found = name; return false; }
			});
			return found;
		}
		function syncSchemeDropdown() {
			if (applying_scheme) { return; }
			var device = currentDevice();
			if (!device) { return; }
			$('#colour_scheme').val(detectScheme(device));
		}

		function showDevice(dev) {
			$('.misc_device_tab').removeClass('selected');
			$('.misc_device_tab[device="' + dev + '"]').addClass('selected');
			$('.misc_device_block').hide();
			$('.misc_device_block[device="' + dev + '"]').show();
			syncSchemeDropdown();
		}
		$(document).on('click', '.misc_device_tab', function () {
			var picked = $(this).attr('device');
			localStorage.setItem('misc_device', picked);
			showDevice(picked);
		});
		var remembered = localStorage.getItem('misc_device');
		var initial = (remembered && $('.misc_device_tab[device="' + remembered + '"]').length) ? remembered : $('.misc_device_tab').first().attr('device');
		if (initial) { showDevice(initial); }

		// A hand-edit to any colour swatch drops the scheme name if it no longer lines up.
		$(document).on('change', '.misc_colour_chip .misc_setting', function () {
			if ($(this).attr('device') == currentDevice()) { syncSchemeDropdown(); }
		});

		$(document).on('change', '#colour_scheme', function () {
			var name = $(this).val();
			var palette = jawnos_colour_schemes[name];
			if (!palette) { return; }
			var device = currentDevice();
			if (!device) { return; }
			var dark_before = $('body').hasClass('dark_theme');
			// One batch, not one change event per swatch: the old loop posted ~23
			// requests and repainted the desktop on each response, which held the
			// WebKitGTK process at full tilt for tens of seconds.
			var changes = {};
			applying_scheme = true;
			$.each(jawnos_colour_keys, function (i, k) {
				var colour = palette[i % palette.length];
				$('.misc_setting[setting="' + k + '_background_colour"][device="' + device + '"]').val(colour);
				changes[k + '_background_colour'] = colour;
			});
			applying_scheme = false;
			$('#colour_scheme').val(name);
			// paint the swatches' own panels once, from the values just set
			$.each(jawnos_colour_keys, function (i, k) {
				var colour = changes[k + '_background_colour'];
				if ($('#' + k).length) { $('#' + k).css('background-color', colour); }
				if ($('.' + k).length) { $('.' + k).css('background-color', colour); }
			});
			// give the person the change before the request returns; an appointment
			// theme that is running still owns the body
			if (changes['manager_background_colour'] && $('body').attr('data-appt-theme') != 'yes' && typeof jawnosThemeApply == 'function') {
				jawnosThemeApply(changes['manager_background_colour'], false);
			}
			if (changes['configure_background_colour']) {
				$('#configure').css('background-color', changes['configure_background_colour']);
			}
			$.ajax({
				url: '/manager/configure/misc_settings',
				type: 'POST',
				data: { device: device, timestamp: Date.now(), settings: JSON.stringify(changes) },
				error: function () { $('#colour_scheme').val(detectScheme(device)); }
			}).done(function () {
				// the icon sets ship a dark cut; once the scheme is stored, ask for the
				// paths again so the buttons cross the light/dark line with it
				if (dark_before !== $('body').hasClass('dark_theme') && typeof jawnosReloadIcons === 'function') {
					jawnosReloadIcons();
				}
			});
		});

		// Changing the scheme leaves the appointments alone now; this is how they are
		// brought into line with it, on purpose.
		$(document).on('click', '#appt_colour_update', function () {
			var device = currentDevice();
			if (!device) { return; }
			$('#appt_colour_update_status').text('Re-theming...');
			$.ajax({
				url: '/manager/configure/colour_update',
				type: 'POST',
				data: { device: device },
				success: function (response) {
					$('#appt_colour_update_status').text(response.updated + ' appointment colour' + (response.updated == 1 ? '' : 's') + ' changed');
				},
				error: function () {
					$('#appt_colour_update_status').text('Could not update the colours');
				}
			});
		});
	})();

	// Icon set preview
	var jawnos_icon_preview = ['record', 'play', 'camera', 'bell', 'key', 'heart', 'envelope', 'marker'];
	var jawnos_handdrawn_preview = [
		'/icons/original/images/decipherable/folder.png',
		'/icons/original/images/decipherable/chart.png',
		'/icons/original/images/make believe/music.png',
		'/icons/original/images/decipherable/gallery.png',
		'/icons/original/images/decipherable/marker.png',
		'/icons/original/images/decipherable/measures.png',
		'/icons/original/images/decipherable/wrench.png',
		'/icons/original/images/decipherable/envelope.png'
	];
	function jawnosPreviewIcons(set) {
		var box = $('.icon_set_preview').empty();
		var urls = [];
		if (set == 'handdrawn') {
			urls = jawnos_handdrawn_preview;
		}
		else if (set) {
			// on a dark desktop the buttons wear the set's dark cut
			var dark = $('body').hasClass('dark_theme') && set != 'handdrawn';
			$.each(jawnos_icon_preview, function (i, n) { urls.push('/icons/sets/' + set + (dark ? '_dark' : '') + '/' + n + '.svg'); });
		}
		else {
			box.html('<i>Using the default icons.</i>');
			return;
		}
		$.each(urls, function (i, u) {
			$('<img>').attr('src', u).css({ width: '40px', height: '40px' }).appendTo(box);
		});
	}
	var jawnos_theme_icon_set = <%== encode_json($active_bundle->{'icon_set'} || '') %>;
	function iconSetPreviewValue() {
		var override = $('.misc_setting[setting="icon_set_override"]').val();
		var system = $('.misc_setting[setting="icon_set"]').val();
		return override || system || jawnos_theme_icon_set || '';
	}
	jawnosPreviewIcons(iconSetPreviewValue());
	$(document).on('change', '.misc_setting[setting="icon_set"], .misc_setting[setting="icon_set_override"]', function () { jawnosPreviewIcons(iconSetPreviewValue()); });

	// ---- named theme gallery --------------------------------------------
	// A card is applied with one write (the Misc setting appearance_theme); the
	// editor saves a named bundle. Both handlers are namespaced because this
	// panel is re-injected when Configure re-opens.
	var jawnos_themes = <%== encode_json($theme_registry) %>;
	var jawnos_theme_labels = { new_theme: <%== encode_json(&subs::lang('configure.new_theme')) %>, edit_theme: <%== encode_json(&subs::lang('configure.edit_theme')) %> };
	function themePanelDevice() {
		// The gallery is about the machine in front of you: the manager reads its
		// own device's row, not whichever device tab happens to be open.
		return '<%= $dev %>';
	}
	function themeCardRender(slug, theme) {
		var card = $('<div class="theme_card"></div>').attr({ role: 'button', tabindex: '0' }).attr('theme_slug', slug || '');
		if (theme) { card.attr('data-builtin', theme.builtin ? '1' : '0'); }
		var sw = $('<span class="theme_swatches"></span>');
		var palette = theme && jawnos_colour_schemes[theme.scheme];
		if (palette && palette.length) {
			$.each(palette, function (i, c) { sw.append($('<span></span>').css('background-color', c)); });
		}
		else {
			$('.misc_colour_chip .misc_setting[device="' + themePanelDevice() + '"]').slice(0, 6).each(function () {
				sw.append($('<span></span>').css('background-color', $(this).val()));
			});
		}
		card.append(sw);
		card.append($('<span class="theme_card_name"></span>').text(theme ? (theme.name || slug) : <%== encode_json(&subs::lang('configure.follow_system')) %>));
		var meta = [];
		if (theme && theme.scheme) { meta.push(theme.scheme); }
		if (theme && theme.texture) { meta.push(theme.texture); }
		if (theme && theme.corner) { meta.push(('' + theme.corner).replace('px', '') + 'px'); }
		card.append($('<span class="theme_card_meta"></span>').text(meta.join(' \u00b7 ')));
		if (theme && !theme.builtin && slug) {
			card.append($('<button type="button" class="theme_edit"></button>').attr('theme_slug', slug).text(<%== encode_json(&subs::lang('configure.edit_theme')) %>));
		}
		return card;
	}
	function themeEditorOpen(slug) {
		var t = jawnos_themes[slug] || {};
		var dev = themePanelDevice();
		$('#theme_slug').val(t.builtin ? '' : (slug || ''));
		$('#theme_name').val(t.name || '');
		$('#theme_scheme').val(t.scheme || (slug ? 'Blue' : ($('#colour_scheme').val() || 'Blue')));
		$('#theme_icon_set').val(t.icon_set || (slug ? '' : ($('.misc_setting[setting="icon_set"][device="' + dev + '"]').val() || '')));
		$('#theme_texture').val(t.texture || (slug ? '' : ($('.misc_setting[setting="texture"][device="' + dev + '"]').val() || '')));
		$('#theme_font').val(t.font || (slug ? '' : ($('.misc_setting[setting="title_font"][device="' + dev + '"]').val() || '')));
		$('#theme_corner').val(parseInt(t.corner, 10) || 10);
		var accent = (t.accent || '').replace(/^#/, '');
		$('#theme_accent_auto').prop('checked', !accent);
		if (accent) { $('#theme_accent').val('#' + accent); }
		$('#theme_delete').toggle(!!slug && !t.builtin);
		$('#theme_editor h3').text(slug && !t.builtin ? jawnos_theme_labels.edit_theme : jawnos_theme_labels.new_theme);
		$('#theme_status').text('');
		$('#theme_editor').show();
		$('#theme_name').trigger('focus');
	}
	// A card carries the theme's own corner, and the server hands the corner back
	// to the theme when one is picked (an older override no longer masks it). Paint
	// it at once and move this panel's slider with it, rather than waiting on the
	// websocket push. System (no theme) hands the slider back to the Misc value,
	// which is what the push falls back to as well.
	function jawnosThemeCornerPanel(slug) {
		var t = jawnos_themes[slug];
		var corner = t ? parseInt(t.corner, 10) : NaN;
		var dev = themePanelDevice();
		var slider = $('.misc_setting[setting="corner_radius"], .misc_setting[setting="corner_override"]').first();
		if (!slider.length) { return; }
		var readout = document.getElementById('corner_radius_value_' + dev) || document.getElementById('corner_override_value_' + dev);
		var follow = $('#corner_follow_theme');
		if (isNaN(corner)) {
			// System: the Misc slider is the desk's own value again
			corner = parseInt(slider.attr('data-misc-corner'), 10);
			if (isNaN(corner)) { corner = 12; }
			slider.attr('setting', 'corner_radius').val(corner);
			if (readout) { readout.id = 'corner_radius_value_' + dev; readout.textContent = corner; }
			follow.hide();
			if (typeof jawnosBars !== 'undefined' && jawnosBars) { jawnosBars.corner_theme = ''; }
			if (typeof jawnosCornerApply == 'function') { jawnosCornerApply(corner, false); }
			return;
		}
		slider.attr('setting', 'corner_override').val(corner);
		if (readout) { readout.id = 'corner_override_value_' + dev; readout.textContent = corner; }
		follow.attr('theme_corner', corner + 'px').show();
		if (typeof jawnosBars !== 'undefined' && jawnosBars) { jawnosBars.corner_theme = corner + 'px'; }
		if (typeof jawnosCornerApply == 'function') { jawnosCornerApply(corner, true); }
	}
	$(document).off('click.themeui').on('click.themeui', '.theme_card[theme_slug]', function (e) {
		if ($(e.target).closest('.theme_edit').length) { return; }
		var slug = $(this).attr('theme_slug') || '';
		$('.theme_card').removeClass('selected');
		$(this).addClass('selected');
		$.post('/manager/configure/misc_setting', {
			setting: 'appearance_theme', value: slug, device: themePanelDevice(), timestamp: Date.now()
		}, function () {
			jawnosThemeCornerPanel(slug);
		});
	});
	$(document).off('keydown.themeui').on('keydown.themeui', '.theme_card[theme_slug]', function (e) {
		if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); $(this).trigger('click'); }
	});
	$(document).off('click.themeui-edit').on('click.themeui-edit', '.theme_edit', function (e) {
		e.stopPropagation();
		themeEditorOpen($(this).attr('theme_slug'));
	});
	$('#theme_new').off('click.themeui').on('click.themeui', function () { themeEditorOpen(''); });
	$('#theme_cancel').off('click.themeui').on('click.themeui', function () { $('#theme_editor').hide(); });
	$('#theme_save').off('click.themeui').on('click.themeui', function () {
		var name = $.trim($('#theme_name').val());
		if (!name) { $('#theme_status').text(<%== encode_json(&subs::ui('Give the theme a name')) %>); return; }
		$('#theme_status').text(<%== encode_json(&subs::ui('Saving...')) %>);
		$.post('/manager/configure/theme_save', {
			slug: $('#theme_slug').val(),
			name: name,
			scheme: $('#theme_scheme').val(),
			icon_set: $('#theme_icon_set').val(),
			texture: $('#theme_texture').val(),
			font: $('#theme_font').val(),
			corner: $('#theme_corner').val(),
			accent: $('#theme_accent_auto').is(':checked') ? '' : $('#theme_accent').val()
		}, function (r) {
			if (!r || r.error) { $('#theme_status').text((r && r.error) || <%== encode_json(&subs::ui('Could not save')) %>); return; }
			jawnos_themes[r.slug] = $.extend({}, jawnos_themes[r.slug] || {}, {
				name: r.name, builtin: 0, scheme: r.bundle.scheme,
				icon_set: r.bundle.icon_set, texture: r.bundle.texture,
				font: r.bundle.font, corner: ('' + (r.bundle.corner || '')).replace('px', ''),
				accent: r.bundle.accent || ''
			});
			var card = themeCardRender(r.slug, jawnos_themes[r.slug]);
			var old = $('.theme_card[theme_slug="' + r.slug + '"]');
			if (old.length) { old.replaceWith(card); } else { $('.theme_gallery').append(card); }
			// saving a theme is also choosing it; a running appointment theme still
			// owns the desk, and the server's push keeps that rule
			$('.theme_card').removeClass('selected');
			card.addClass('selected');
			$.post('/manager/configure/misc_setting', {
				setting: 'appearance_theme', value: r.slug, device: themePanelDevice(), timestamp: Date.now()
			});
			$('#theme_status').text(<%== encode_json(&subs::ui('Saved')) %>);
			$('#theme_editor').hide();
		}).fail(function () { $('#theme_status').text(<%== encode_json(&subs::ui('Could not save')) %>); });
	});
	$('#theme_delete').off('click.themeui').on('click.themeui', function () {
		var slug = $('#theme_slug').val();
		if (!slug) { return; }
		$.post('/manager/configure/theme_delete', { slug: slug }, function (r) {
			if (!r || !r.deleted) { $('#theme_status').text((r && r.error) || <%== encode_json(&subs::ui('Could not delete')) %>); return; }
			$('.theme_card[theme_slug="' + slug + '"]').remove();
			delete jawnos_themes[slug];
			if ($('.theme_card.selected').attr('theme_slug') === slug) {
				$('.theme_card').removeClass('selected');
				$('.theme_card[theme_slug=""]').addClass('selected');
			}
			$('#theme_editor').hide();
		});
	});
</script>
