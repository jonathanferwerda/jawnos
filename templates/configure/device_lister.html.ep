<% no warnings 'uninitialized'; %>
<% my $signatorial = &subs::signatorial_designer(); %>
<% my $topology = &subs::setting_grabber({ app => 'sync', setting => 'topology', device => 'all' })
	|| &subs::setting_grabber({ app => 'sync', setting => 'topology' }) || 'auto'; %>
<%# the lister as networks: a toolbar, the machines (each named and removable
    once), then one section per network the house is on - the subnet, the
    interfaces that reach it, and a neighbour table of the devices found there.
    Styled from the house's own theme tokens so it wears the light or dark set. %>
<style>
#device_listings { display:flex; flex-direction:column; gap:10px; }
#device_listings .device_card { border:1px solid var(--line); border-radius:8px; background:var(--panel-2); }
#device_listings .device_head { display:flex; gap:8px; align-items:center; flex-wrap:wrap; padding:8px 10px; background:var(--panel); border-bottom:1px solid var(--line); }
#device_listings .network_cidr { font-family:var(--mono-font, monospace); font-weight:700; font-size:15px; }
#device_listings .network_who { display:flex; gap:6px; flex-wrap:wrap; align-items:center; }
#device_listings .device_when { opacity:.6; font-size:85%; white-space:nowrap; }
#device_listings .device_nic { padding:8px 10px; }
#device_listings .network_card .device + .device { border-top:1px solid var(--line); }
#device_listings .nic_head { display:flex; gap:8px; align-items:center; flex-wrap:wrap; font-weight:700; margin-bottom:6px; }
#device_listings .remote_ip { font-family:var(--mono-font, monospace); font-weight:400; }
#device_listings table { width:100%; border-collapse:collapse; }
#device_listings th, #device_listings td { border:1px solid var(--line); padding:5px 7px; text-align:left; vertical-align:top; }
#device_listings th { background:var(--panel); font-size:88%; }
#device_listings tbody tr:nth-child(2n) { background:var(--panel); }
#device_listings .remote_machine td:first-child { font-size:92%; }
#device_listings .device_actions { display:flex; gap:6px; align-items:center; flex-wrap:wrap; }
#device_listings button { font:inherit; font-size:90%; padding:2px 10px; margin:2px 0; }
#device_listings .pill { display:inline-block; padding:1px 8px; border-radius:10px; border:1px solid var(--line); background:var(--panel); font-size:85%; }
#device_listings .device_machines { border:1px solid var(--line); border-radius:8px; background:var(--panel); padding:4px 10px; }
#device_listings .machine_row { display:flex; gap:8px; align-items:center; flex-wrap:wrap; padding:5px 0; }
#device_listings .machine_row + .machine_row { border-top:1px solid var(--line); }
#device_listings .machine_row .device_domain { flex:1 1 200px; min-width:140px; margin:0; }
#device_listings .printer_ink { display:flex; flex-direction:column; gap:4px; min-width:150px; }
#device_listings .inker { display:flex; gap:6px; align-items:center; font-size:85%; }
#device_listings .ink_name { flex:0 0 auto; min-width:58px; opacity:.85; }
#device_listings .ink_bar { flex:1 1 70px; height:9px; border:1px solid var(--line); border-radius:5px; background:var(--panel); overflow:hidden; }
#device_listings .ink_fill { display:block; height:100%; }
#device_listings .ink_pct { flex:0 0 auto; font-variant-numeric:tabular-nums; opacity:.8; }
#device_listings .inker.ink_low .ink_pct { color:#c0392b; font-weight:700; }
#device_listings .printer_state { font-size:80%; opacity:.7; }
/* On a phone the neighbour table becomes a stack of cards, so the purpose
   controls (lock, mirror, scan, delete) are never off the right edge. */
@media (max-width:640px) {
	#device_listings .device_nic table, #device_listings .device_nic thead, #device_listings .device_nic tbody, #device_listings .device_nic tr, #device_listings .device_nic td { display:block; width:100%; box-sizing:border-box; }
	#device_listings .device_nic thead { display:none; }
	#device_listings .device_nic tr { border:1px solid var(--line); border-radius:8px; margin:8px 0; padding:6px; background:var(--panel); }
	#device_listings .device_nic td { border:0; padding:3px 2px; }
	#device_listings .device_head { justify-content:center; text-align:center; }
	#device_listings .nic_head { justify-content:center; text-align:center; }
	#device_listings .device_nic td, #device_listings .remote_machine td:first-child { text-align:center; }
	#device_listings .device_actions { justify-content:center; }
	#device_listings .device_actions .device_purpose { flex:1 1 100%; }
	#device_listings .machine_row { justify-content:center; text-align:center; }
}
</style>
<div class="cfg" style="width:100%;height:100%;">
	<div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:8px;">
		<input type="text" value="<%= $ping %>" class="ping_host" placeholder="host" style="flex:1 1 110px;min-width:90px;margin:0;">
		<button class="ping">Ping</button>
		<button class="device_scan" load_type="scan">Scan</button>
		<span id="ping_results" style="opacity:.85;"></span>
	</div>
	<div id="device_listings">
		<%# The mesh's own switch. It lives here because the Dev panel is where the
		    machines are, and the value is a house setting: every machine's next
		    settings pull carries it, and the reconnector reads it each pass. %>
		<div class="device_card" id="sync_topology_card">
			<div class="device_head">
				<span class="network_cidr">Sync topology</span>
				<span class="device_when">house-wide · each machine applies it on its next tick</span>
			</div>
			<div class="device_nic" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
				<label for="sync_topology_select">Peers</label>
				<select id="sync_topology_select" class="sync_topology_select" setting="topology">
					<option value="auto" <% if ($topology eq 'auto') { %>selected<% } %>>Auto — hub while the server is live</option>
					<option value="mesh" <% if ($topology eq 'mesh') { %>selected<% } %>>Mesh — every peer directly</option>
					<option value="hub" <% if ($topology eq 'hub') { %>selected<% } %>>Hub only — spokes dial the server</option>
				</select>
				<span id="sync_topology_status" class="device_when"></span>
			</div>
		</div>
		<% if (scalar @{$devices || []}) { %>
			<%# the machines: one row each, so a machine's name and its removal are asked once, not once per network it appears on %>
			<div class="device_machines">
				<% foreach my $d ( reverse @{$devices} ) { %>
					<div class="machine_row" uuid="<%= $d->{'uuid'} %>">
						<input type="text" name="device_domain" uuid="<%= $d->{'uuid'} %>" device="<%= $d->{'hostname'} %>" value="<%= $d->{'domain'} %>" class="device_domain" timestamp="<%= $d->{'timestamp'} %>">
						<span class="device_when"><%= $d->{'hostname'} %> · <%= $d->{'formatted_time'} %></span>
						<button type="button" class="delete_device" timestamp="<%= $d->{'timestamp'} %>" device="<%= $d->{'hostname'} %>" uuid="<%= $d->{'uuid'} %>">✕ Remove</button>
					</div>
				<% } %>
			</div>
		<% } %>
		<% if (scalar @{$ble_devices || []}) { %>
			<%# the fleet's radios: a BLE-only device off its access point sits in no machine's neighbour table, so it is listed here from the bridge's own sightings %>
			<div class="device_card">
				<div class="device_head">
					<span class="network_cidr">Bluetooth</span>
					<span class="device_when">radios the bridge has seen</span>
					<button type="button" class="ble_adopt_scan">Scan now</button>
				</div>
				<div class="device_nic">
					<div class="cfg-scroll">
					<table>
						<thead>
							<tr><th>device</th><th>purpose</th><th>bluetooth</th><th>seen</th></tr>
						</thead>
						<tbody>
						<% foreach my $b ( @{$ble_devices} ) { %>
							<tr class="ble_device" chip_id="<%= $b->{'id'} %>" purpose="<%= $b->{'purpose'} %>">
								<td>
									<b><%= $b->{'name'} || $b->{'id'} %></b><br>
									<span class="remote_ip" style="opacity:.6;font-size:88%;"><%= $b->{'id'} %></span>
								</td>
								<td><%= &subs::format_name($b->{'purpose'} || '') %></td>
								<td><span class="remote_ip"><%= $b->{'bluetooth'} %></span></td>
								<td><span class="device_when"><%= $b->{'seen_display'} || '' %><% if ($b->{'hostname'}) { %> · <%= $b->{'hostname'} %><% } %></span></td>
							</tr>
						<% } %>
						</tbody>
					</table>
					</div>
				</div>
			</div>
		<% } %>
		<% foreach my $g ( @{$networks || []} ) { %>
			<div class="device_card network_card" cidr="<%= $g->{'cidr'} %>">
				<div class="device_head">
					<span class="network_cidr"><%= $g->{'cidr'} %></span>
					<span class="network_who">
						<% foreach my $m ( @{$g->{'members'}} ) { %>
							<span class="pill"><%= $m->{'hostname'} %><% if ($m->{'domain'}) { %> · <%= $m->{'domain'} %><% } %> · <%= $m->{'nic'} %></span>
						<% } %>
					</span>
				</div>
				<% foreach my $m ( @{$g->{'members'}} ) { %>
					<div class="device" uuid="<%= $m->{'uuid'} %>">
						<div remote_address="<%= $m->{'ip'} %>" nic="<%= $m->{'nic'} %>" class="network_interface device_nic">
							<div class="nic_head">
								<span class="device_control" ip="<%= $m->{'ip'} %>" mac="<%= $m->{'mac'} %>"><%= $m->{'nic'} %>: <span class="clip remote_ip"><%= $m->{'ip'} %></span> <%= $m->{'mac'} %></span>
								<% if ($m->{'gw'}) { %><span class="device_when">via <%= $m->{'gw'} %></span><% } %>
							</div>
							<% if (scalar @{$m->{'neigh'} || []} > 0) { %>
								<div class="cfg-scroll">
								<table>
									<thead>
										<tr><th>devices</th><th>manager</th><th>purpose</th></tr>
									</thead>
									<tbody>
									<% foreach my $n ( sort { $a->{'ip'} cmp $b->{'ip'} } @{$m->{'neigh'} || []} ) { %>
										<% my $rm = &subs::db_query('select uuid,buttons from remote_machines where signatorial = ?', $n->{'signatorial'})->hash; %>
										<% if ($n->{'mac'}) { %>
											<tr class="remote_machine" ip="<%= $n->{'ip'} %>" mac="<%= $n->{'mac'} %>" tunnel="<%= $n->{'tunnel'} %>" uuid="<%= $n->{'uuid'} %>" signatorial="<%= $n->{'signatorial'} %>">
												<td>
													<% if ($n->{'name'}) { %><b><%= $n->{'name'} %></b><br><% } %>
													<% if ($n->{'fqdn'}) { %><span style="opacity:.7;"><%= $n->{'fqdn'} %></span><br><% } %>
													<span class="remote_ip"><%= $n->{'ip'} %></span><br><span style="opacity:.6;"><%= $n->{'mac'} %></span>
													<% if ($n->{'chip_id'}) { %><br><span style="opacity:.6;font-size:88%;"><%= $n->{'chip_id'} %></span><% } %>
													<% if ($n->{'model'}) { %><br><span class="pill"><%= $n->{'model'} %></span><% } %>
													<% if ($n->{'capabilities'}) { %><br><span class="pill" hint="abilities"><%= $n->{'capabilities'} %></span><% } %>
													<% if ($n->{'tunnel'}) { %><br><span class="pill">Tunnel</span><% } %>
												</td>
												<td class="remote_manager" id="<%= $m->{'nic'} %>_<%= $m->{'machine_timestamp'} %>">
													<% if ( $n->{'restore_list'} ) { %>
														<span class="remote_restore_list" manager="<%= $n->{'manager'} %>" id="<%= $m->{'nic'} %>_<%= $m->{'machine_timestamp'} %>"><%= $n->{'restore_list'} %></span>
														<br>
														<span class="remote_machine_buttons"><%== $rm->{'buttons'} %></span>
													<% } elsif ($n->{'purpose'} eq 'mobile' || $n->{'purpose'} eq 'computer') { %>
														<span style="opacity:.7;">Lost</span>
													<% } %>
													<% if ($n->{'purpose'} eq 'teletype') { %>
														<button class="teletype_backup" ip="<%= $n->{'ip'} %>" mac="<%= $n->{'mac'} %>">Backup</button>
													<% } %>
													<% if ($n->{'purpose'} eq 'printer') { %>
														<span class="printer_ink" ip="<%= $n->{'ip'} %>" title="ink and toner"><span class="printer_ink_body">reading…</span></span>
													<% } %>
												</td>
												<td>
													<div class="device_actions">
														<select class="device_purpose">
															<% foreach my $o (@gb::all_device_types) { %>
																<option <% if ($n->{'purpose'} eq $o) { %>selected<% } %> value="<%= $o %>"><%= &subs::format_name($o) %></option>
															<% } %>
														</select>
														<% if ($n->{'locked'} eq 'yes') { %>
															<img src="/images/jbuttons/padlock lock.png" hint="Lock" class="little_thumb remote_device_locker hover" style="background-color:red" status="locked" nic="<%= $m->{'nic'} %>" ip="<%= $n->{'ip'} %>" uuid="<%= $m->{'uuid'} %>">
														<% } else { %>
															<img src="/images/jbuttons/padlock unlock.png" hint="Unlock" class="little_thumb remote_device_locker hover" style="background-color:lightgreen" status="unlocked" nic="<%= $m->{'nic'} %>" ip="<%= $n->{'ip'} %>" uuid="<%= $m->{'uuid'} %>">
														<% } %>
														<% if ($n->{'purpose'} eq 'server') { %>
															<img src="<%= &subs::icon_for('/images/decipherable/tunnel.png') %>" hint="Mirror" class="little_thumb hover neighbour_tunnel" nic="<%= $m->{'nic'} %>" status="<%= $n->{'tunnel'} %>" uuid="<%= $m->{'uuid'} %>" signatorial="<%= $n->{'signatorial'} %>" ip="<%= $n->{'ip'} %>">
														<% } %>
														<button class="delete_neighbour_device" rm_uuid="<%= $rm->{'uuid'} %>" uuid="<%= $n->{'uuid'} %>">Delete</button>
														<button class="device_scan ping_scan" load_type="ping_scan" ip_address="<%= $n->{'ip'} %>">Scan</button>
														<% if ($n->{'signatorial'}) { %>
															<button class="remote_migrate" signatorial="<%= $n->{'signatorial'} %>" ip="<%= $n->{'ip'} %>" hostname="<%= $n->{'name'} || '' %>" hint="Pull the whole house from here onto that device">Migrate</button>
														<% } %>
													</div>
												</td>
											</tr>
										<% } %>
									<% } %>
									</tbody>
								</table>
								</div>
							<% } %>
						</div>
					</div>
				<% } %>
			</div>
		<% } %>
	</div>
</div>
