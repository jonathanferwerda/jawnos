% no warnings 'uninitialized';
<% my $packages = $settings->{'app_packaging'}; %>
<% $packages->{'new'} = { name => '', quantity => '', each => '', uuid => &subs::random_string_creator(20) }; %>
<!-- 'a' is the app name in this template's stash, and Mojo::Template extracts stash keys into lexicals,
     so a sort { $a->{'app'} } block here would sort the app name instead of the rows. Sort the names instead. -->
<% my $places = &subs::db_query('select app from settings where (setting = ? or setting = ?) and value = ? and device = ?', 'pos', 'mab', 'place', &subs::device_setter())->hashes; %>
<% my %place_row = map { $_->{'app'} => $_ } @{$places}; %>
<datalist id="warehouse_place_options">
	<% foreach my $pl ( map { $place_row{$_} } sort keys %place_row ) { %>
		<option value="<%= $pl->{'app'} %>"><%= &subs::format_name($pl->{'app'}) %></option>
	<% } %>
</datalist>
<style>
/* One row per package: the fields share the width and wrap, so a phone sees
   two or three per line instead of a clipped strip. */
.packaging_config_container .packaging_config { flex:1 1 100px; min-width:80px; box-sizing:border-box; padding:7px 9px; border-radius:7px; border:1px solid var(--line); background:var(--panel); color:var(--ink); font:inherit; }
.packaging_config_container input[name="name"] { flex:2 1 160px; }
.packaging_config_container input[name="default_place"] { flex:1 1 150px; }
.packaging_config_container .delete_packaging { align-self:center; }
</style>

<% foreach my $p ( keys %{$packages} ) { %>
	<% my $packaging = $packages->{$p}; %>
	<div class="packaging_config_container" uuid="<%= $packaging->{'uuid'} || $p %>">
		<input class="packaging_config" uuid="<%= $p %>" name="name" value="<%= $packaging->{'name'} %>" placeholder="Name">
		<% foreach my $pc ( qw/quantity each length width height weight expires/ ) { %>
			<input class="packaging_config" uuid="<%= $p %>" name="<%= $pc %>" value="<%= $packaging->{$pc} %>" placeholder="<%= &subs::format_name($pc) %>">
		<% } %>
		<input class="packaging_config" uuid="<%= $p %>" name="default_place" list="warehouse_place_options" value="<%= $packaging->{'default_place'} %>" placeholder="Default Place">
		<% if ($p ne 'new') { %>
			<img src="<%= &subs::icon_for('/images/make believe/cancel_button.png') %>" hint="Close" class="delete_packaging little_thumb" uuid="<%= $p %>" style="vertical-align:bottom;">
		<% } %>
	</div>
<% } %>