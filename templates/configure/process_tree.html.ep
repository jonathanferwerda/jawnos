% my $subprocess_writer;
% use Data::Dumper;
<% if ( scalar %{$subprocesses} > 0) { %>

	<% $subprocess_writer = begin %>
		% my ($subprocess) = @_;
		<% if (eval {keys %{$subprocess} }) { %>

			<% foreach my $p ( sort keys %{$subprocess->{'subprocesses'}} ) { %>
				<tr style="width:100%;">

					% my $proc = $subprocess->{'subprocesses'}->{$p};
					<% if ($proc->{'htop'}) { %>
						<td><%= $proc->{'htop'}->{'p_total'} %>%</td>
					<% } else { %><td></td><% } %>
					<td><%= $p %></td>
					<td><%= $proc->{'parent'} %></td>
					<td><b><%= &subs::format_name($proc->{'name'}) %></b></td>
					<td><span class="time" timestamp="<%= $proc->{'start_timestamp'} %>"></span></td>
					<td><span class="time" timestamp="<%= $proc->{'timestamp'} %>"></span></td>
					<% if ($subprocess->{'stop_timestamp'}) { %>
						<td><span class="time" timestamp="<%= $proc->{'stop_timestamp'} %>"></span> <% } %></td>

					<% if ($proc->{'subprocesses'}) { %>
						<%= $subprocess_writer->($proc) %>
					<% } %>
				</tr>
			<% } %>
		<% } %>
	<% end %>

	<div id="subprocess_tree" style="background-color:lightblue;width:100%;">
		<h2>Subprocesses</h2>
		<table style="width:100%;">
			<% foreach my $pid ( sort keys %{$subprocesses} ) { %>
				<thead><b><%= $pid %></b><br></thead>
				<% if (eval { keys %{$subprocesses->{$pid}} }) { %>
					<tbody>
						<%= $subprocess_writer->($subprocesses->{$pid}) %>
					</tbody>
				<% } %>
			<% } %> 

		</table>
	</div>
<% } %>
