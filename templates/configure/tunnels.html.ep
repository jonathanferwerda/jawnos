<% my $tunnels = &subs::db_query('select * from tunnels where status=?', 'active')->hashes; %>
<% no warnings 'uninitialized'; %>
<% if (@{$tunnels} > 0) { %>
	<h4>Tunnels:</h4>
	<table style="background-color:lightgrey;width:100%;">
		<thead>
			<th>F</th><th>Host</th><th>Dir</th><th>Name</th><th>IP</th><th>In</th><th>Out</th><th>Time</th><th>ST</th>
		</thead>
		<tbody>
			<% foreach my $tun ( @{$tunnels} ) { %>
				<% if ($tun->{'server_time'} < &subs::rightNow() - ( 60 * 5 * 1000)) { %>
					<% &subs::db_delete('tunnels', { uuid => $tun->{'uuid'} });
					<% next; %>
				<% } %>
				<tr>
					<td><img class="tiny_thumb" src="
						<% if ($tun->{'failures'} == 0) { %>
							/images/make believe/good.png
						<% } elsif ($tun->{'failures'} >- 1) { %>
							/images/make believe/bad.png
						<% } else { %>
							/images/decipherable/question.png
						<% } %>
						">
					</td>
					<td><%= $tun->{'host'} %></td>
					<td><%= &subs::format_name($tun->{'direction'}) %></td>
					<td><%= $tun->{'name'} %></td> 
					<td><%= $tun->{'ip'} %></td> 
					<td><%= $tun->{'in_port'} %></td>
					<td><%= $tun->{'out_port'} %></td>
					<td><span class="time" timestamp="<%= $tun->{'timestamp'} %>"></span></td>
					<td><span class="time" timestamp="<%= $tun->{'server_time'} %>"></span></td>
				</tr>
			<% } %>
		</tbody>
	</table>
	<script>appointment_chron();</script>
<% } %>