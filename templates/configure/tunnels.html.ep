<% my $tunnels = &subs::db_query('select * from tunnels where status=?', 'active')->hashes; %>
<% no warnings 'uninitialized'; %>
<style>
/* One card per live tunnel: a head with the health dot, the peer and the
   direction, then the addresses as a wrapping field grid. */
#tunnel_list .tun_list { display:flex; flex-direction:column; gap:10px; }
#tunnel_list .tun_card { margin:0; }
#tunnel_list .tun_head { display:flex; flex-wrap:wrap; align-items:center; gap:8px 10px; margin:0 0 8px; }
#tunnel_list .tun_head .tiny_thumb { flex:0 0 auto; }
#tunnel_list .tun_name { flex:1 1 130px; min-width:0; font-weight:600; word-break:break-all; }
#tunnel_list .tun_dir { font-size:12px; opacity:.75; }
#tunnel_list .tun_grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(120px, 1fr)); gap:6px 10px; }
#tunnel_list .tun_field { display:flex; flex-direction:column; gap:2px; min-width:0; font-size:12.5px; }
#tunnel_list .tun_field > span:first-child { opacity:.55; font-size:11px; text-transform:uppercase; letter-spacing:.04em; }
#tunnel_list .tun_field > span:last-child { word-break:break-all; }
</style>
<div class="cfg">
	<h2>Tunnels</h2>
	<% if (scalar @{$tunnels} > 0) { %>
		<p class="cfg-note">Live tunnels between this machine and its peers.</p>
		<div class="tun_list">
			<% foreach my $tun ( @{$tunnels} ) { %>
				<% if ($tun->{'server_time'} < &subs::rightNow() - ( 60 * 5 * 1000)) { %>
					<% &subs::db_delete('tunnels', { uuid => $tun->{'uuid'} }); %>
					<% next; %>
				<% } %>
				<% my $health = ($tun->{'failures'} == 0) ? 'good' : 'bad'; %>
				<div class="cfg-card tun_card">
					<div class="tun_head">
						<img class="tiny_thumb" hint="Health" src="/images/make believe/<%= $health %>.png">
						<span class="tun_name"><%= $tun->{'host'} %> · <%= $tun->{'name'} %></span>
						<span class="tun_dir"><%= &subs::format_name($tun->{'direction'}) %></span>
					</div>
					<div class="tun_grid">
						<div class="tun_field"><span>IP</span><span><%= $tun->{'ip'} %></span></div>
						<div class="tun_field"><span>In</span><span><%= $tun->{'in_port'} %></span></div>
						<div class="tun_field"><span>Out</span><span><%= $tun->{'out_port'} %></span></div>
						<div class="tun_field"><span>Seen</span><span class="time" timestamp="<%= $tun->{'timestamp'} %>"></span></div>
						<div class="tun_field"><span>Server</span><span class="time" timestamp="<%= $tun->{'server_time'} %>"></span></div>
					</div>
				</div>
			<% } %>
		</div>
		<script>appointment_chron();</script>
	<% } else { %>
		<p class="cfg-note">No active tunnels right now.</p>
	<% } %>
</div>
