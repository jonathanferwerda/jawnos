<% use Mojo::JSON qw/decode_json encode_json/; %>
<% no warnings 'uninitialized'; %>
<style>
/* The home plate: one map for the selected flag, then one card per flag - where
   a device is placed relative to the flag, its action and its device. The area
   itself lives on the map (circle, box, path or polygon); the card only carries
   the behaviour. Each field stacks its label over its control so the card wraps
   on a phone. */
.home_plate_setting_container .hp_field { display:flex; flex-direction:column; gap:2px; flex:0 1 auto; min-width:0; }
.home_plate_setting_container .hp_field > label { font-size:11.5px; opacity:.7; }
.home_plate_setting_container .hp_field .home_plate_setting { box-sizing:border-box; max-width:100%; padding:6px 8px; border-radius:7px; border:1px solid var(--line); background:var(--panel); color:var(--ink); font:inherit; }
.home_plate_setting_container .hp_field.hp_inline { flex-direction:row; align-items:center; gap:5px; }
.home_plate_setting_container .hp_field.hp_inline > label { font-size:13px; opacity:.85; }
.home_plate_setting_container .hp_actions { display:flex; align-items:flex-end; gap:6px; }
.home_plate_setting_container .home_plate_edit { padding:5px 8px; border-radius:7px; border:1px solid var(--line); background:var(--panel); color:var(--ink); font:inherit; font-size:12px; cursor:var(--jawnos-cursor-pointer, pointer); }
.home_plate_base_card { border-style:dashed; }
</style>
<% my $base = $settings->{'app_home_plate'} || {}; %>
<% my $home_plate_duties = eval { return decode_json $settings->{'home_plate_duties'} } || []; %>
<%= include 'configure/home_plate_map', app => $app, device => '', base => $base, flags => $home_plate_duties %>
<div class="home_plate_flags">
	<div class="home_plate_setting_container home_plate_base_card" uuid="" app="<%= $app %>">
		<span class="hp_field">
			<label><%= &subs::ui('Default place') %></label>
			<span class="home_plate_summary" summary="base"></span>
		</span>
		<span class="hp_actions">
			<button type="button" class="home_plate_edit" uuid=""><%= &subs::ui('Edit on map') %></button>
		</span>
	</div>
	<% foreach my $hpd ( sort { ($b->{'timestamp'} || 0) <=> ($a->{'timestamp'} || 0) } @{$home_plate_duties} ) { %>
		<div class="home_plate_setting_container" uuid="<%= $hpd->{'uuid'} %>" app="<%= $app %>">
			<span class="hp_field">
				<label><%= &subs::ui('Placement') %></label>
				<select class="home_plate_setting" setting="placement" uuid="<%= $hpd->{'uuid'} %>">
					<% my $stored_placement = $hpd->{'placement'} || ''; %>
					<% foreach my $dir ( qw/within without/ ) { %>
						<option value="<%= $dir %>" <% if ($stored_placement eq $dir) { %>selected<% } %>><%= &subs::format_name($dir) %></option>
					<% } %>
					<% if (length $stored_placement && $stored_placement ne 'within' && $stored_placement ne 'without') { %>
						<option value="<%= $stored_placement %>" selected><%= &subs::format_name($stored_placement) %></option>
					<% } %>
				</select>
			</span>
			<span class="hp_field">
				<label><%= &subs::ui('Action') %></label>
				<select class="home_plate_setting" setting="action" uuid="<%= $hpd->{'uuid'} %>">
					<% my $stored_action = $hpd->{'action'} || ''; %>
					<% foreach my $o ( qw/none start record stop command kill/ ) { %>
						<option value="<%= $o %>" <% if ($stored_action eq $o) { %>selected<% } %>><%= &subs::format_name($o) %></option>
					<% } %>
					<% if (length $stored_action && !grep { $_ eq $stored_action } qw/none start record stop command kill/) { %>
						<option value="<%= $stored_action %>" selected><%= &subs::format_name($stored_action) %></option>
					<% } %>
				</select>
			</span>
			<span class="hp_field">
				<label><%= &subs::ui('Device') %></label>
				<select class="home_plate_setting" setting="device" uuid="<%= $hpd->{'uuid'} %>">
					% my $devices = &subs::remote_machine_lister();
					% my $stored_device = $hpd->{'device'} || '';
					% my $device_found = 0;
					<option value=""><%= &subs::ui('None') %></option>
					<% foreach my $d ( @{$devices} ) { %>
						% $device_found = 1 if $stored_device eq ($d->{'signatorial'} || '');
						<option value="<%= $d->{'signatorial'} %>" <% if ($stored_device eq $d->{'signatorial'}) { %>selected<% } %>><%= &subs::format_name($d->{'hostname'}) %></option>
					<% } %>
					<%# A flag bound to a machine the current list no longer carries (this
					    machine itself, or a peer that left) must keep its value: rendering
					    None and posting it back would unbind the flag. %>
					<% if (length $stored_device && !$device_found) { %>
						<option value="<%= $stored_device %>" selected><%= &subs::format_name($stored_device) %></option>
					<% } %>
				</select>
			</span>
			<span class="hp_field">
				<label><%= &subs::ui('Areas') %></label>
				<span class="home_plate_summary" summary="<%= $hpd->{'uuid'} %>"></span>
			</span>
			<span class="hp_actions">
				<button type="button" class="home_plate_edit" uuid="<%= $hpd->{'uuid'} %>"><%= &subs::ui('Edit on map') %></button>
				<img src="<%= &subs::icon_for('/images/decipherable/diskette.png') %>" hint="Save" class="little_thumb home_plate_setting_save hover" app="<%= $app %>" uuid="<%= $hpd->{'uuid'} %>" style="vertical-align:bottom;">
				<img src="<%= &subs::icon_for('/icons/trash.png') %>" hint="Delete" class="little_thumb hover home_plate_setting_deleter" app="<%= $app %>" uuid="<%= $hpd->{'uuid'} %>" style="vertical-align:bottom;">
			</span>
		</div>
	<% } %>
</div>
