<div class="cfg">
	<h2>System</h2>
	<p class="cfg-note">Database totals, the utility controller, and where the settings list is read from.</p>

	<div class="cfg-card">
		<% if ($c->stash('pl_time')) { %><p class="cfg-note" style="margin:0 0 6px;">PL TIME: <span class="time" timestamp="<%= $c->stash('pl_time') %>"></span></p><% } %>
		<p class="cfg-note" style="margin:0;">Uptime: <span class="time" timestamp="<%= $last_restart %>"></span></p>
		<details class="cfg-details">
			<summary><%= sprintf(&subs::lang('configure.database_totals'), scalar @{$stats}) %></summary>
			<div id="stats" class="cfg-actions">
				<% foreach my $s ( @{$stats} ) { %>
					<span class="stat" id="<%= $s->{'table'} %>_stat"><b><%= $s->{'formatted_table'} %>:</b> <%= $s->{'count'} %></span>
				<% } %>
			</div>
		</details>
	</div>

	<%# The house ledger, always shown (not behind the source toggle): which machines
	    can take AI work, when each was last seen, and what today has cost. Reads the
	    synced ai_house and ai_budget rows, so every machine shows the same picture. %>
	<% my $machines = &subs::remote_machine_lister({ self => 'yes', mirrors => 'none' }); %>
	<% my %machine_name; foreach my $m ( @{$machines} ) { $machine_name{$m->{'signatorial'}} = ((($m->{'hostname'} || '') eq 'me') ? 'me (this machine)' : ($m->{'hostname'} || $m->{'signatorial'})); } %>
	<details class="cfg-acc" data-acc="sys-house">
		<summary><%= &subs::lang('configure.the_house') %></summary>
		<div class="cfg-card">
			<p class="cfg-note">
			<b><%= $ai_house->{'members'} %></b> <%= ($ai_house->{'members'} == 1 ? 'machine' : 'machines') %> can take AI work ·
			today <%= $ai_house->{'spent'} %> tokens<%= ($ai_house->{'budget'} ? ' of ' . $ai_house->{'budget'} : ' (no cap)') %>.
			Each job runs once for the house; a machine that goes quiet hands its job on.
		</p>
		<div class="cfg-scroll">
			<table>
				<thead>
					<tr><th>Machine</th><th>Has model</th><th>Last seen</th><th>Tokens today</th></tr>
				</thead>
				<tbody>
					<% foreach my $r ( @{ $ai_house->{'rows'} } ) { %>
						<tr>
							<td style="text-align:left;"><%= ($r->{'self'} ? 'me (this machine)' : ($machine_name{$r->{'machine'}} || $r->{'machine'})) %></td>
							<td><%= ($r->{'has_model'} ? 'yes' : 'no') %></td>
							<td><% if ($r->{'seen'}) { %><span class="time" timestamp="<%= $r->{'seen'} %>"></span><% } else { %>—<% } %></td>
							<td><%= $r->{'tokens'} %></td>
						</tr>
					<% } %>
				</tbody>
			</table>
		</div>
	</div>
</details>

	<%# The provider balances: only an account on file is a row, and only a couple
	   of those publish a balance, so the rest read — %>
	<details class="cfg-acc" data-acc="sys-balances">
		<summary><%= &subs::lang('configure.api_balances') %></summary>
		<div class="cfg-card">
			<p class="cfg-note">
			<%= &subs::ui('What is left on each provider account you have registered, where the provider reports it.') %>
			<% if (!$ai_balance->{'at'}) { %>Not read yet — this fills in a moment after boot.<% } %>
		</p>
		<% my $balance_keys = &subs::settings_grabber({ app => 'mail', settings => [ &subs::ai_key_settings() ] }); %>
		<% my %balance_cached = map { ($_->{'provider'} || '') => $_ } @{ $ai_balance->{'rows'} || [] }; %>
		<% my @balance_rows; foreach my $p ( @{ &subs::ai_providers() } ) { next unless &subs::ai_provider_registered($p, $balance_keys); push @balance_rows, ($balance_cached{ $p->{'id'} } || { label => $p->{'label'}, available => undef, note => &subs::ui('not read yet') }); } %>
		<div class="cfg-scroll">
			<table>
				<thead>
					<tr><th>Provider</th><th>Available</th><th>Read</th></tr>
				</thead>
				<tbody>
					<% if (@balance_rows) { %>
						<% foreach my $b ( @balance_rows ) { %>
							<tr>
								<td style="text-align:left;"><%= $b->{'label'} %></td>
								<td><%= (defined $b->{'available'} ? (sprintf('%.2f', $b->{'available'}) . ' ' . ($b->{'currency'} || '')) : ($b->{'note'} || '—')) %></td>
								<td><% if ($ai_balance->{'at'}) { %><span class="time" timestamp="<%= $ai_balance->{'at'} %>"></span><% } else { %>—<% } %></td>
							</tr>
						<% } %>
					<% } else { %>
						<tr><td colspan="3" style="text-align:left;"><%= &subs::ui('No provider accounts registered yet — add a key under Configure → Plat, under Provider access.') %></td></tr>
					<% } %>
				</tbody>
			</table>
		</div>

		<%# How fast the balance is falling. The ai balance job keeps a rolling
		   week of samples; both windows are drawn from it, so switching a
		   window never waits on a provider. %>
		<% my $balance_chart = &subs::ai_balance_chart($ai_balance); %>
		<div class="balance_chart">
			<div class="balance_chart_head">
				<b><%= &subs::lang('configure.balance_drop') %></b>
				<span class="balance_windows">
					<button type="button" class="balance_window" window="24h" status="active"><%= &subs::lang('configure.last_24h') %></button>
					<button type="button" class="balance_window" window="7d"><%= &subs::lang('configure.last_7d') %></button>
				</span>
			</div>
			<% if (@{ $balance_chart->{'unconverted'} || [] }) { %>
				<p class="cfg-note"><%= &subs::lang('configure.balance_no_rate', $balance_chart->{'base'}, join(', ', @{ $balance_chart->{'unconverted'} })) %></p>
			<% } elsif ($balance_chart->{'converted'}) { %>
				<p class="cfg-note"><%= &subs::lang('configure.balance_in_currency', $balance_chart->{'base'}) %></p>
			<% } %>
			<% if (scalar @{ $balance_chart->{'series'} }) { %>
				<% foreach my $series ( @{ $balance_chart->{'series'} } ) { %>
					<div class="balance_series">
						<div class="balance_series_head">
							<b><%= $series->{'label'} %></b>
							<% if (defined $series->{'available'}) { %>
								<span class="balance_now"><%= &subs::ai_balance_money($series->{'available'}) . ' ' . ($series->{'currency'} || '') %></span>
							<% } %>
						</div>
						<% foreach my $window ( qw/24h 7d/ ) { %>
							<% my $w = $series->{'windows'}->{$window}; %>
							<div class="balance_plot" window="<%= $window %>"<% if ($window ne '24h') { %> style="display:none;"<% } %>>
								<% if (!$w->{'points'} || scalar @{ $w->{'points'} } < 2) { %>
									<p class="cfg-note"><%= &subs::lang('configure.balance_collecting') %></p>
								<% } else { %>
									<%== &subs::ai_balance_sparkline($w->{'points'}, $w->{'start'}, $w->{'now'}, 320, 80) %>
									<p class="cfg-note balance_rate">
										<% my $money = &subs::ai_balance_money(abs($w->{'per_day'} // 0)) . ' ' . ($series->{'currency'} || ''); %>
										<% if (defined $w->{'per_day'} && $w->{'per_day'} > 0.005) { %>
											<%= &subs::lang('configure.drop_per_day', $money) %>
										<% } elsif (defined $w->{'per_day'} && $w->{'per_day'} < -0.005) { %>
											<%= &subs::lang('configure.rise_per_day', $money) %>
										<% } else { %>
											<%= &subs::lang('configure.balance_flat') %>
										<% } %>
										· <%= &subs::ai_balance_span_label($w->{'hours'}) %>
									</p>
								<% } %>
							</div>
						<% } %>
					</div>
				<% } %>
			<% } else { %>
				<p class="cfg-note"><%= &subs::lang('configure.balance_collecting') %></p>
			<% } %>
		</div>
	</div>
</details>

<details class="cfg-acc" data-acc="sys-pph">
	<summary><%= &subs::ui('PPH comparator') %></summary>
	<p class="cfg-note"><%= &subs::ui('Discharging drain grouped by the lock that produced each sample. Needs a few hours in each state; it fills in as the phone runs.') %></p>
	<% my $pph = &subs::pph_compare_report(); %>
	<div class="cfg-scroll">
		<table>
			<thead><tr><th style="text-align:left;"><%= &subs::ui('State') %></th><th hint="Discharging samples"><%= &subs::ui('Points') %></th><th><%= &subs::ui('Hours') %></th><th hint="percent per hour while discharging"><%= &subs::ui('PPH') %></th></tr></thead>
			<tbody>
				<% foreach my $row ( @{$pph->{'rows'}} ) { %>
					<tr>
						<td style="text-align:left;"><%= &subs::ui($row->{'label'}) %></td>
						<td><%= $row->{'points'} %></td>
						<td><% if ($row->{'hours'}) { %><%= sprintf('%.1f', $row->{'hours'}) %><% } else { %>—<% } %></td>
						<td><% if (defined $row->{'pph'}) { %><%= sprintf('%.2f', $row->{'pph'}) %><% } else { %>—<% } %></td>
					</tr>
				<% } %>
			</tbody>
		</table>
	</div>
		<% if ($pph->{'note'}) { %><p class="cfg-note"><%= $pph->{'note'} %></p><% } %>
	</details>

	<details class="cfg-acc" data-acc="sys-wake" open>
		<summary><%= &subs::ui('Wake schedule') %></summary>
		<% my $wake_schedule = &subs::setting_grabber({ app => '__president', setting => 'wake_schedule' }); %>
		<% $wake_schedule = 'on' unless defined $wake_schedule && $wake_schedule =~ /\S/; %>
		<p class="cfg-note"><%= &subs::ui('The Android app wakes the CPU briefly for each utility beat and lets it sleep in between. Off restores the old permanent wake lock; music still holds it while playing.') %></p>
	<div class="cfg-actions">
		<label hint="Keep the scheduled wake"><input type="checkbox" class="appointment_setting" app="__president" setting="wake_schedule" <% if ($wake_schedule eq 'on') { %>checked="checked"<% } %>> <%= &subs::ui('Keep the scheduled wake') %></label>
	</div>
	</details>

	<details class="cfg-acc" data-acc="sys-utility" open>
		<summary><%= &subs::lang('configure.utility_controller') %></summary>
		<p class="cfg-note">Toggle each background job, set how often it runs, and watch its last result. Changes apply as you make them.</p>
		<div id="utility_controls_container" class="cfg-card">
			<%= include 'configure/utility_controller' %>
		</div>
	</details>

	<details class="cfg-acc" data-acc="sys-settings-source">
		<summary><%= &subs::lang('configure.settings_source') %></summary>
		<p class="cfg-note">Which copy of the settings list this browser reads.</p>
		<div class="cfg-actions">
			<% foreach my $b ( qw/none localstorage cache eval/ ) { %>
				<button class="sys_setting_option" onclick="settingSetter({'app': '__president', 'setting': 'system_settings_list_view', 'value': '<%= $b %>' });" 
					option="<%= $b %>" style="<% if ($b eq $settings->{$device}->{'system_settings_list_view'}) { %>background-color:yellow;<% } %>"><%= &subs::format_name($b) %></button>
			<% } %>
		</div>

	<% if ($settings->{$device}->{'system_settings_list_view'} eq 'localstorage') { %>
		<div class="cfg-scroll">
			<table>
				<thead>
					<tr><th>Cxl</th><th>Key</th><th>Value</th></tr>
				</thead>
				<tbody>
					<% foreach my $ls ( sort keys %{$local_storage} ) { %>
						<tr class="system_localstorage" key="<%= $ls %>">
							<td><img class="localstorage_delete little_thumb" key="<%= $ls %>" src="<%= &subs::icon_for('/images/make believe/cancel_button.png') %>" hint="Close"></td>
							<td><b><%= $ls %></b></td>
							<td style="text-align:left;"><%= $local_storage->{$ls} %></td>
						</tr>
					<% } %>
				</tbody>
			</table>
		</div>
	<% } elsif ($settings->{$device}->{'system_settings_list_view'} eq 'eval') { %>

		<%# the whole house's own evaluation controls sit here, where the global
		    report already lives %>
		<div class="cfg-card">
			<%= include 'apps/evaluation_controls', app => '' %>
			<%= include 'apps/evaluation', evaluation => $evaluation, app => undef, controls => 0 %>
		</div>
		<%# every machine keeps its own queue, so the house has to say where the
		    nightly evaluations happen; remote_machine_lister (above) names the machines %>
		<%# a preference among the workers, not a pin: the server dispatches the
		    scheduled runs, and this names the worker to prefer when it is ready %>
		<div class="cfg-row">
			<label>Nightly machine</label>
			<select class="evaluation_machine" app="__president" setting="evaluation_machine" hint="The worker the server prefers for scheduled evaluations when it is ready; otherwise the server chooses another ready worker. With no server, the house elects by quorum">
				<option value=""><%= &subs::ui('Any worker') %></option>
				<% foreach my $m ( @{$machines} ) { %>
					<% next unless $m->{'signatorial'}; %>
					<option value="<%= $m->{'signatorial'} %>" <% if (($settings->{$device}->{'evaluation_machine'} || '') eq $m->{'signatorial'}) { %>selected<% } %>><%= ((($m->{'hostname'} || '') eq 'me') ? 'me (this machine)' : ($m->{'hostname'} || $m->{'signatorial'})) %></option>
				<% } %>
			</select>
		</div>
	<% } elsif ($settings->{$device}->{'system_settings_list_view'} eq 'cache') { %>

		<div class="cfg-card">
			<div class="cfg-row">
				<label><input type="checkbox" class="anchor_all_settings" setting_type="sys"> Anchor to all devices</label>
			</div>
		</div>
		<% foreach my $dt ( @gb::device_types ) { %>
			<div class="cfg-card">
				<h3><%= $dt %></h3>
				<div class="cfg-row">
					<label>Cache Folders</label>
					<textarea class="sys_setting" setting="cache_folders" device="<%= $dt %>"><%= $settings->{$dt}->{'cache_folders'} %></textarea>
				</div>
			</div>
		<% } %>
		<% } %>
	</details>
</div>
