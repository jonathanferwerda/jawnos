<div class="cfg">
	<h2>System</h2>
	<p class="cfg-note">Database totals, the utility controller, and where the settings list is read from.</p>

	<div class="cfg-card">
		<% if ($c->stash('pl_time')) { %><p class="cfg-note" style="margin:0 0 6px;">PL TIME: <span class="time" timestamp="<%= $c->stash('pl_time') %>"></span></p><% } %>
		<p class="cfg-note" style="margin:0;">Uptime: <span class="time" timestamp="<%= $last_restart %>"></span></p>
		<details class="cfg-details">
			<summary><%= sprintf(&subs::lang('configure.database_totals'), scalar @{$stats}) %></summary>
			<div id="stats" class="cfg-actions">
				<% foreach my $s ( @{$stats} ) { %>
					<span class="stat" id="<%= $s->{'table'} %>_stat"><b><%= $s->{'formatted_table'} %>:</b> <%= $s->{'count'} %></span>
				<% } %>
			</div>
		</details>
	</div>

	<%# The house ledger, always shown (not behind the source toggle): which machines
	    can take AI work, when each was last seen, and what today has cost. Reads the
	    synced ai_house and ai_budget rows, so every machine shows the same picture. %>
	<% my $machines = &subs::remote_machine_lister({ self => 'yes', mirrors => 'none' }); %>
	<% my %machine_name; foreach my $m ( @{$machines} ) { $machine_name{$m->{'signatorial'}} = ((($m->{'hostname'} || '') eq 'me') ? 'me (this machine)' : ($m->{'hostname'} || $m->{'signatorial'})); } %>
	<details class="cfg-acc" data-acc="sys-house">
		<summary><%= &subs::lang('configure.the_house') %></summary>
		<div class="cfg-card">
			<p class="cfg-note">
			<b><%= $ai_house->{'members'} %></b> <%= ($ai_house->{'members'} == 1 ? 'machine' : 'machines') %> can take AI work ·
			today <%= $ai_house->{'spent'} %> tokens<%= ($ai_house->{'budget'} ? ' of ' . $ai_house->{'budget'} : ' (no cap)') %>.
			Each job runs once for the house; a machine that goes quiet hands its job on.
		</p>
		<div class="cfg-scroll">
			<table>
				<thead>
					<tr><th>Machine</th><th>Has model</th><th>Last seen</th><th>Tokens today</th></tr>
				</thead>
				<tbody>
					<% foreach my $r ( @{ $ai_house->{'rows'} } ) { %>
						<tr>
							<td style="text-align:left;"><%= ($r->{'self'} ? 'me (this machine)' : ($machine_name{$r->{'machine'}} || $r->{'machine'})) %></td>
							<td><%= ($r->{'has_model'} ? 'yes' : 'no') %></td>
							<td><% if ($r->{'seen'}) { %><span class="time" timestamp="<%= $r->{'seen'} %>"></span><% } else { %>—<% } %></td>
							<td><%= $r->{'tokens'} %></td>
						</tr>
					<% } %>
				</tbody>
			</table>
		</div>
	</div>
</details>

	<%# The provider balances: only an account on file is a row, and only a couple
	   of those publish a balance, so the rest read — %>
	<details class="cfg-acc" data-acc="sys-balances">
		<summary><%= &subs::lang('configure.api_balances') %></summary>
		<div class="cfg-card">
			<p class="cfg-note">
			<%= &subs::ui('What is left on each provider account you have registered, where the provider reports it.') %>
			<% if (!$ai_balance->{'at'}) { %>Not read yet — this fills in a moment after boot.<% } %>
		</p>
		<% my $balance_keys = &subs::settings_grabber({ app => 'mail', settings => [ &subs::ai_key_settings() ] }); %>
		<% my %balance_cached = map { ($_->{'provider'} || '') => $_ } @{ $ai_balance->{'rows'} || [] }; %>
		<% my @balance_rows; foreach my $p ( @{ &subs::ai_providers() } ) { next unless &subs::ai_provider_registered($p, $balance_keys); push @balance_rows, ($balance_cached{ $p->{'id'} } || { label => $p->{'label'}, available => undef, note => &subs::ui('not read yet') }); } %>
		<div class="cfg-scroll">
			<table>
				<thead>
					<tr><th>Provider</th><th>Available</th><th>Read</th></tr>
				</thead>
				<tbody>
					<% if (@balance_rows) { %>
						<% foreach my $b ( @balance_rows ) { %>
							<tr>
								<td style="text-align:left;"><%= $b->{'label'} %></td>
								<td style="text-align:left;"><% if (defined $b->{'available'}) { %><%= include 'configure/currency_amount', amount => $b->{'available'}, from => ($b->{'currency'} || 'USD') %><% } else { %><%= $b->{'note'} || '—' %><% } %></td>
								<td><% if ($ai_balance->{'at'}) { %><span class="time" timestamp="<%= $ai_balance->{'at'} %>"></span><% } else { %>—<% } %></td>
							</tr>
						<% } %>
					<% } else { %>
						<tr><td colspan="3" style="text-align:left;"><%= &subs::ui('No provider accounts registered yet — add a key under Configure → Plat, under Provider access.') %></td></tr>
					<% } %>
				</tbody>
			</table>
		</div>

		<%# How fast the balance is falling. The ai balance job keeps a rolling
		   month of samples (thinned as they age), and every window is drawn from
		   what is already stored, so switching a window never waits on a
		   provider. The provider picker chooses which account's bars and detail
		   are shown; each line carries its own currency picker. %>
		<% my $balance_chart = &subs::ai_balance_chart($ai_balance); %>
		<% my @balance_series = @{ $balance_chart->{'series'} }; %>
		<% my @balance_windows = @{ $balance_chart->{'windows'} }; %>
		<% my %window_label = ('1h' => 'configure.last_hour', '1d' => 'configure.last_day', '1w' => 'configure.last_week', '1m' => 'configure.last_month'); %>
		<div class="balance_chart">
			<div class="balance_chart_head">
				<span class="balance_title">
					<b><%= &subs::lang('configure.balance_drop') %></b>
					<% if ($balance_chart->{'tz'}) { %><span class="cfg-note" hint="Times are in this machine's zone"><%= $balance_chart->{'tz'} %></span><% } %>
					<% if (@balance_series) { %>
						<select class="balance_provider" aria-label="<%= &subs::lang('configure.provider') %>">
							<% foreach my $series ( @balance_series ) { %>
								<option value="<%= $series->{'provider'} %>"><%= $series->{'label'} %></option>
							<% } %>
						</select>
					<% } %>
				</span>
				<span class="balance_windows">
					<% foreach my $window ( @balance_windows ) { %>
						<button type="button" class="balance_window" window="<%= $window %>"<% if ($window eq '1d') { %> status="active"<% } %>><%= &subs::lang($window_label{$window} || 'configure.last_day') %></button>
					<% } %>
				</span>
			</div>
			<% if (@balance_series) { %>
				<% my $first = 1; %>
				<% foreach my $series ( @balance_series ) { %>
					<% my $series_currency = $series->{'currency'} || $balance_chart->{'base'} || ''; %>
					<div class="balance_series" data-provider="<%= $series->{'provider'} %>" data-currency="<%= $series_currency %>"<% if (!$first) { %> style="display:none;"<% } %>>
						<div class="balance_series_head">
							<% if (defined $series->{'source_available'}) { %>
								<%= include 'configure/currency_amount', amount => $series->{'source_available'}, from => $series->{'source_currency'} %>
							<% } %>
							<% if ($series->{'converted'}) { %>
								<span class="cfg-note balance_currency_note" data-template="<%= &subs::lang('configure.balance_in_currency', '{0}') %>"><%= &subs::lang('configure.balance_in_currency', $balance_chart->{'base'}) %></span>
							<% } elsif (($series->{'source_currency'} || '') ne $balance_chart->{'base'}) { %>
								<span class="cfg-note balance_currency_note"><%= &subs::lang('configure.balance_no_rate', $balance_chart->{'base'}, $series->{'source_currency'}) %></span>
							<% } %>
						</div>
						<% foreach my $window ( @balance_windows ) { %>
							<% my $wd = $series->{'windows'}->{$window}; %>
							<% my $line = $wd->{'line'}; %>
							<% my $bars = $wd->{'bars'}; %>
							<div class="balance_plot" window="<%= $window %>"<% if ($window ne '1d') { %> style="display:none;"<% } %>>
								<% if (!$line->{'points'} || scalar @{ $line->{'points'} } < 2) { %>
									<p class="cfg-note"><%= &subs::lang('configure.balance_collecting') %></p>
								<% } else { %>
									<%== &subs::ai_balance_sparkline($line->{'points'}, $line->{'start'}, $line->{'now'}, 320, 80) %>
									<% my $span = &subs::ai_balance_span_label($line->{'hours'}); %>
									<% my ($rate_template, $rate_money);
									   # per_day is consumption-based, so a top-up inside the window cannot
									   # turn this line into a "rise" or hide the spending.
									   if (defined $line->{'per_day'} && $line->{'per_day'} > 0.005) {
									       $rate_template = &subs::lang('configure.drop_per_day', '{0}');
									       $rate_money = &subs::currency_money($line->{'per_day'}) . ' ' . $series_currency;
									   } else {
									       $rate_template = &subs::lang('configure.balance_flat');
									   }
									   my $rate_text = $rate_template;
									   $rate_text =~ s/\{0\}/$rate_money/ if defined $rate_money;
									   $rate_text .= ' · ' . $span;
									%>
									<p class="cfg-note balance_rate" data-base-per-day="<%= defined $line->{'per_day'} ? sprintf('%.6f', $line->{'per_day'}) : '' %>" data-template="<%= $rate_template %>" data-span="<%= $span %>"><%= $rate_text %></p>
									<%# The same burn read two ways: how long the balance lasts at this
									   rate, and what that rate costs. Both carry their own data so the
									   currency picker can convert them in place, like the rate line. %>
									<%# A balance that is not falling never runs out, and an already spent
									   one has no time left to report, so the line is absent in both cases
									   rather than reading "0 min". %>
									<% if (defined $line->{'runway_hours'} && $line->{'runway_hours'} > 0) { %>
										<% my $runway = &subs::ai_balance_span_label($line->{'runway_hours'}); %>
										<p class="cfg-note balance_runway"><%= &subs::lang('configure.balance_runway', $runway) %></p>
									<% } %>
									<% if (defined $line->{'expense_day'} && $line->{'expense_day'} > 0.005) { %>
										<% my $expense_template = &subs::lang('configure.balance_expense', '{0}', '{1}', '{2}'); %>
										<p class="cfg-note balance_expense" data-base-per-day="<%= sprintf('%.6f', $line->{'expense_day'}) %>" data-template="<%= $expense_template %>"><%= &subs::lang('configure.balance_expense', &subs::currency_money($line->{'expense_day'}) . ' ' . $series_currency, &subs::currency_money($line->{'expense_week'}) . ' ' . $series_currency, &subs::currency_money($line->{'expense_month'}) . ' ' . $series_currency) %></p>
									<% } %>
									<%# What the traffic behind that fall cost per thousand tokens,
									   when the ledger has counted any. %>
									<% if (defined $wd->{'per_k'} && $wd->{'per_k'} > 0) { %>
										<p class="cfg-note balance_per_k" data-base-amount="<%= sprintf('%.6f', $wd->{'per_k'}) %>" data-template="<%= &subs::lang('configure.cost_per_1k', '{0}') %>"><%= &subs::lang('configure.cost_per_1k', &subs::currency_money($wd->{'per_k'}) . ' ' . $series_currency) %></p>
									<% } %>
									<% if (@{ $line->{'topups'} || [] }) { %>
										<p class="cfg-note balance_topups"><% my $n = 0; %><% foreach my $topup ( @{ $line->{'topups'} } ) { %><% if ($n++) { %> · <% } %><span class="balance_topup" data-base-amount="<%= sprintf('%.6f', $topup->{'amount'}) %>" data-time="<%= $topup->{'label'} %>" data-template="<%= &subs::lang('configure.topup_marker', '{0}', '{1}') %>"><%= &subs::lang('configure.topup_marker', &subs::currency_money($topup->{'amount'}) . ' ' . $series_currency, $topup->{'label'}) %></span><% } %></p>
									<% } %>
								<% } %>
								<%# The same samples as bars: one per clock unit of this window,
								   pressed for the drop, the share, the tokens and the roles. %>
								<div class="balance_hours">
									<div class="balance_hours_head">
										<b><%= &subs::lang($window_label{$window} || 'configure.last_day') %></b>
										<% if (($bars->{'samples'} || 0) >= 2 && ($bars->{'total'} || 0) > 0.005) { %>
											<span class="cfg-note"><%= &subs::lang('configure.period_hint') %></span>
										<% } %>
									</div>
									<% if (($bars->{'samples'} || 0) < 2) { %>
										<p class="cfg-note"><%= &subs::lang('configure.balance_collecting') %></p>
									<% } elsif (($bars->{'total'} || 0) <= 0.005) { %>
										<p class="cfg-note"><%= &subs::lang('configure.balance_flat_period') %></p>
									<% } else { %>
										<%== &subs::ai_balance_bars($bars, 320, 48, {
											detail    => &subs::lang('configure.bucket_detail', '{0}', '{1}', '{2}', '{3}', '{4}'),
											untracked => &subs::lang('configure.bucket_detail_untracked', '{0}', '{1}', '{2}'),
											model     => &subs::lang('configure.bucket_model', '{0}'),
											models    => &subs::lang('configure.bucket_models', '{0}'),
										}) %>
										<p class="cfg-note balance_bucket_detail" style="display:none;"></p>
										<% my $peak = $bars->{'peak'}; %>
										<% if ($peak) { %>
											<p class="cfg-note balance_bucket_peak"
											   data-base-amount="<%= sprintf('%.6f', $peak->{'spend'}) %>"
											   data-label="<%= $peak->{'label'} %>"
											   data-template="<%= &subs::lang('configure.balance_peak', '{0}', '{1}') %>"><%= &subs::lang('configure.balance_peak', $peak->{'label'}, &subs::currency_money($peak->{'spend'}) . ' ' . $series_currency) %></p>
										<% } %>
									<% } %>
									<% if (@{ $wd->{'roles'} || [] }) { %>
										<p class="cfg-note balance_roles"><%= &subs::lang('configure.spend_by_role', join(' · ', map { $_->{'label'} . ' ' . sprintf('%.0f%%', $_->{'share'}) } @{ $wd->{'roles'} })) %></p>
									<% } %>
									<% if (($wd->{'house_tokens'} || 0) > 0) { %>
										<p class="cfg-note balance_house_tokens"><%= &subs::lang('configure.house_tokens', $wd->{'house_tokens'}) %></p>
									<% } %>
									<%# The same window for every account, side by side. Two balances
									   with different sizes share no useful axis, so the comparison is
									   each one's pace rather than two lines drawn over each other. %>
									<% my @compare = grep { defined $_->{'per_day'} && $_->{'per_day'} > 0.005 } @{ $wd->{'compare'} || [] }; %>
									<% if (scalar @compare > 1) { %>
										<p class="cfg-note balance_compare"><%= join(' · ', map { &subs::lang('configure.provider_pace', $_->{'label'}, &subs::currency_money($_->{'per_day'}) . ' ' . ($_->{'currency'} || '')) } @compare) %></p>
									<% } %>
								</div>
							</div>
						<% } %>
					</div>
					<% $first = 0; %>
				<% } %>
			<% } else { %>
				<p class="cfg-note"><%= &subs::lang('configure.balance_collecting') %></p>
			<% } %>
		</div>
		<%# Two thresholds a person sets from the chart that shows them: an hour that
		   costs more than this, or a runway shorter than this many days. The balance
		   watch reads them on its own turn; a blank box is off. %>
		<% my $alert_hour = &subs::setting_grabber({ app => '__president', setting => 'ai_alert_hour' }); %>
		<% my $alert_runway = &subs::setting_grabber({ app => '__president', setting => 'ai_alert_runway' }); %>
		<details class="cfg-acc cfg-acc-sub" data-acc="sys-balance-alerts">
			<summary><%= &subs::lang('configure.balance_alerts') %></summary>
			<div class="cfg-actions">
				<label hint="<%= &subs::lang('configure.alert_hour_label') %>"><%= &subs::lang('configure.alert_hour_label') %>
					<input type="text" class="appointment_setting" app="__president" setting="ai_alert_hour" value="<%= defined $alert_hour ? $alert_hour : '' %>" size="8">
				</label>
				<label hint="<%= &subs::lang('configure.alert_runway_label') %>"><%= &subs::lang('configure.alert_runway_label') %>
					<input type="text" class="appointment_setting" app="__president" setting="ai_alert_runway" value="<%= defined $alert_runway ? $alert_runway : '' %>" size="5">
				</label>
			</div>
		</details>
	</div>
</details>

<details class="cfg-acc" data-acc="sys-pph">
	<summary><%= &subs::ui('PPH comparator') %></summary>
	<p class="cfg-note"><%= &subs::ui('Discharging drain grouped by the lock that produced each sample. Needs a few hours in each state; it fills in as the phone runs.') %></p>
	<% my $pph = &subs::pph_compare_report(); %>
	<div class="cfg-scroll">
		<table>
			<thead><tr><th style="text-align:left;"><%= &subs::ui('State') %></th><th hint="Discharging samples"><%= &subs::ui('Points') %></th><th><%= &subs::ui('Hours') %></th><th hint="percent per hour while discharging"><%= &subs::ui('PPH') %></th></tr></thead>
			<tbody>
				<% foreach my $row ( @{$pph->{'rows'}} ) { %>
					<tr>
						<td style="text-align:left;"><%= &subs::ui($row->{'label'}) %></td>
						<td><%= $row->{'points'} %></td>
						<td><% if ($row->{'hours'}) { %><%= sprintf('%.1f', $row->{'hours'}) %><% } else { %>—<% } %></td>
						<td><% if (defined $row->{'pph'}) { %><%= sprintf('%.2f', $row->{'pph'}) %><% } else { %>—<% } %></td>
					</tr>
				<% } %>
			</tbody>
		</table>
	</div>
		<% if ($pph->{'note'}) { %><p class="cfg-note"><%= $pph->{'note'} %></p><% } %>
	</details>

	<details class="cfg-acc" data-acc="sys-wake" open>
		<summary><%= &subs::ui('Wake schedule') %></summary>
		<% my $wake_schedule = &subs::setting_grabber({ app => '__president', setting => 'wake_schedule' }); %>
		<% $wake_schedule = 'on' unless defined $wake_schedule && $wake_schedule =~ /\S/; %>
		<p class="cfg-note"><%= &subs::ui('The Android app wakes the CPU briefly for each utility beat and lets it sleep in between. Off restores the old permanent wake lock; music still holds it while playing.') %></p>
	<div class="cfg-actions">
		<label hint="Keep the scheduled wake"><input type="checkbox" class="appointment_setting" app="__president" setting="wake_schedule" <% if ($wake_schedule eq 'on') { %>checked="checked"<% } %>> <%= &subs::ui('Keep the scheduled wake') %></label>
	</div>
	</details>

	<details class="cfg-acc" data-acc="sys-utility" open>
		<summary><%= &subs::lang('configure.utility_controller') %></summary>
		<p class="cfg-note">Toggle each background job, set how often it runs, and watch its last result. Changes apply as you make them.</p>
		<div id="utility_controls_container" class="cfg-card">
			<%= include 'configure/utility_controller' %>
		</div>
	</details>

	<details class="cfg-acc" data-acc="sys-settings-source">
		<summary><%= &subs::lang('configure.settings_source') %></summary>
		<p class="cfg-note">Which copy of the settings list this browser reads.</p>
		<div class="cfg-actions">
			<% foreach my $b ( qw/none localstorage cache eval/ ) { %>
				<button class="sys_setting_option" onclick="settingSetter({'app': '__president', 'setting': 'system_settings_list_view', 'value': '<%= $b %>' });" 
					option="<%= $b %>" style="<% if ($b eq $settings->{$device}->{'system_settings_list_view'}) { %>background-color:yellow;<% } %>"><%= &subs::format_name($b) %></button>
			<% } %>
		</div>

	<% if ($settings->{$device}->{'system_settings_list_view'} eq 'localstorage') { %>
		<div class="cfg-scroll">
			<table>
				<thead>
					<tr><th>Cxl</th><th>Key</th><th>Value</th></tr>
				</thead>
				<tbody>
					<% foreach my $ls ( sort keys %{$local_storage} ) { %>
						<tr class="system_localstorage" key="<%= $ls %>">
							<td><img class="localstorage_delete little_thumb" key="<%= $ls %>" src="<%= &subs::icon_for('/images/make believe/cancel_button.png') %>" hint="Close"></td>
							<td><b><%= $ls %></b></td>
							<td style="text-align:left;"><%= $local_storage->{$ls} %></td>
						</tr>
					<% } %>
				</tbody>
			</table>
		</div>
	<% } elsif ($settings->{$device}->{'system_settings_list_view'} eq 'eval') { %>

		<%# the whole house's own evaluation controls sit here, where the global
		    report already lives %>
		<div class="cfg-card">
			<%= include 'apps/evaluation_controls', app => '' %>
			<%= include 'apps/evaluation', evaluation => $evaluation, app => undef, controls => 0 %>
		</div>
		<%# every machine keeps its own queue, so the house has to say where the
		    nightly evaluations happen; remote_machine_lister (above) names the machines %>
		<%# a preference among the workers, not a pin: the server dispatches the
		    scheduled runs, and this names the worker to prefer when it is ready %>
		<div class="cfg-row">
			<label>Nightly machine</label>
			<select class="evaluation_machine" app="__president" setting="evaluation_machine" hint="The worker the server prefers for scheduled evaluations when it is ready; otherwise the server chooses another ready worker. With no server, the house elects by quorum">
				<option value=""><%= &subs::ui('Any worker') %></option>
				<% foreach my $m ( @{$machines} ) { %>
					<% next unless $m->{'signatorial'}; %>
					<option value="<%= $m->{'signatorial'} %>" <% if (($settings->{$device}->{'evaluation_machine'} || '') eq $m->{'signatorial'}) { %>selected<% } %>><%= ((($m->{'hostname'} || '') eq 'me') ? 'me (this machine)' : ($m->{'hostname'} || $m->{'signatorial'})) %></option>
				<% } %>
			</select>
		</div>
	<% } elsif ($settings->{$device}->{'system_settings_list_view'} eq 'cache') { %>

		<div class="cfg-card">
			<div class="cfg-row">
				<label><input type="checkbox" class="anchor_all_settings" setting_type="sys"> Anchor to all devices</label>
			</div>
		</div>
		<% foreach my $dt ( @gb::device_types ) { %>
			<div class="cfg-card">
				<h3><%= $dt %></h3>
				<div class="cfg-row">
					<label>Cache Folders</label>
					<textarea class="sys_setting" setting="cache_folders" device="<%= $dt %>"><%= $settings->{$dt}->{'cache_folders'} %></textarea>
				</div>
			</div>
		<% } %>
		<% } %>
	</details>
</div>
