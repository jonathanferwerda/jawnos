<%
	# A budget or a goal is a list of entries, not a blob of text: each is an
	# amount, the measure it is about (a measure of the appointment's, money, or a
	# plain count), the scope it runs over - a rate - or none, which makes it a
	# fixed level like a weight to hold at, and which way it runs: a floor to
	# reach or a ceiling to stay under. The list is written back as the string the
	# rest of the house already reads - "amount measure/scope", comma separated,
	# with a leading "<=" on a ceiling - so nothing downstream changes form.
	# The measure picker offers everything the appointment can measure: its own
	# app_measures (the config panel hands it decoded, older callers a JSON string)
	# plus the measures its part of speech and second reading carry in gb.pl, so a
	# global measure like volition sits beside an app's own steps and weight. A
	# name none of the sources know still gets an option of its own below.
	my $am = $settings->{'app_measures'};
	$am = eval { return decode_json $am } unless ref $am eq 'HASH';
	$am = {} unless ref $am eq 'HASH';
	my %measure_names = map { $_ => 1 } keys %{$am};
	foreach my $reading ( $settings->{'pos'}, $settings->{'mab'} ) {
		next unless $reading;
		my $global = $gb::pos->{$reading}->{'app_measures'} || {};
		$measure_names{$_} = 1 for keys %{$global};
	}
	my @measure_names = sort keys %measure_names;
	my @units = qw/minute hour day week month year/;
	my $row = sub {
		my ($dir, $value, $measure, $scount, $sunit) = @_;
		$dir = 'floor' unless defined $dir && length $dir;
		$value = '' unless defined $value;
		$measure = '' unless defined $measure;
		$scount = '' unless defined $scount;
		$sunit = '' unless defined $sunit;
		# keep every measure the appointment carries, plus money and the plain
		# quantity it holds (a stream of amounts), in the list; a measure the picker
		# does not know (a time amount in a duration budget) still gets an option of
		# its own so a round trip never drops it
		my @known = ('', '$', 'quantity', @measure_names);
		my @extra = (length($measure) && !grep { $_ eq $measure } @known) ? ($measure) : ();
		my $o = '<div class="budget_goals_row">';
		$o .= '<select class="budget_goals_direction">';
		$o .= '<option value="floor"' . ($dir eq 'floor' ? ' selected' : '') . '>reach at least</option>';
		$o .= '<option value="ceiling"' . ($dir eq 'ceiling' ? ' selected' : '') . '>stay under</option>';
		$o .= '</select>';
		$o .= '<input class="budget_goals_value" type="text" placeholder="amount" value="' . $value . '">';
		$o .= '<select class="budget_goals_measure">';
		$o .= '<option value=""' . ($measure eq '' ? ' selected' : '') . '>occurrences (count)</option>';
		$o .= '<option value="$"' . ($measure eq '$' ? ' selected' : '') . '>total (money)</option>';
		$o .= '<option value="quantity"' . ($measure eq 'quantity' ? ' selected' : '') . '>quantity</option>';
		# a base mode's name may also be an app's own measure (beer carries a
		# 'quantity' measure), so the mode is offered once here and skipped below
		foreach my $m ( grep { $_ ne 'quantity' } @measure_names ) {
			$o .= '<option value="' . $m . '"' . ($measure eq $m ? ' selected' : '') . '>' . &subs::format_name($m) . '</option>';
		}
		foreach my $m ( @extra ) {
			$o .= '<option value="' . $m . '" selected>' . &subs::format_name($m) . '</option>';
		}
		$o .= '</select>';
		$o .= '<input class="budget_goals_count" type="number" min="1" placeholder="1" value="' . $scount . '">';
		$o .= '<select class="budget_goals_unit">';
		$o .= '<option value=""' . ($sunit eq '' ? ' selected' : '') . '>fixed</option>';
		foreach my $u ( @units ) {
			$o .= '<option value="' . $u . '"' . ($sunit eq $u ? ' selected' : '') . '>' . &subs::format_name($u) . '</option>';
		}
		$o .= '</select>';
		$o .= '<img class="little_thumb hover budget_goals_remover" src="' . &subs::icon_for('/icons/trash.png') . '" hint="Remove">';
		$o .= '</div>';
		return $o;
	};
%>
<style>
/* A budget/goal entry reads as one sentence: reach at least / stay under this
   amount of this measure, per count unit - the row wraps on a narrow screen. */
.budget_goals .budget_goals_row select,
.budget_goals .budget_goals_row input { flex:1 1 auto; min-width:0; max-width:100%; box-sizing:border-box; padding:7px 9px; border-radius:7px; border:1px solid var(--line); background:var(--panel); color:var(--ink); font:inherit; }
.budget_goals .budget_goals_direction { flex:0 1 auto; }
.budget_goals .budget_goals_value { flex:0 1 110px; }
.budget_goals .budget_goals_count { flex:0 1 72px; }
</style>
<p class="cfg-note">Each line is one rule: an amount of a measure, held at a floor to reach or a ceiling to stay under - optionally per hour, day, week, month or year.</p>
<div class="budget_goals" app="<%= $a %>" setting="<%= $setting %>">
	<% foreach my $e ( grep { length } split ',', ($settings->{$setting} || '') ) { %>
		<% my $dir = 'floor'; my $body = $e; $dir = 'ceiling' if $body =~ s/^<=//; $body =~ s/^>=//; %>
		<% my ($valpart, $scope) = split '/', $body, 2; %>
		<% my ($value, $measure); if ($valpart =~ /^\$(.*)$/) { $measure = '$'; $value = $1; } else { ($value, $measure) = $valpart =~ /^([0-9.\-]+)([a-zA-Z_]*)$/; $value = $valpart unless defined $value; $measure = '' unless defined $measure; } %>
		<% my ($scount, $sunit) = ('', ''); if (defined $scope && $scope =~ /^([0-9]*)([a-zA-Z]+)$/) { $scount = $1; $sunit = $2; } %>
		<%== $row->($dir, $value, $measure, $scount, $sunit) %>
	<% } %>
	<div class="budget_goals_template" style="display:none;"><%== $row->('floor', '', '', '', '') %></div>
	<img class="little_thumb hover budget_goals_adder" src="<%= &subs::icon_for('/images/studio/plus.png') %>" hint="Add" style="vertical-align:bottom;">
</div>