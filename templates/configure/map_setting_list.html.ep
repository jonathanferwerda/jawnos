<%# Configure -> Plat -> Maps. The keys for the tile services Travel offers.
    A service is only listed here when its tiles are a plain {z}/{x}/{y} URL;
    Google Maps is not, because its Tiles API mints a session token first. %>
<% no warnings 'uninitialized'; %>
<%
	my @services = (
		[ 'maptiler',     'MapTiler',     'https://cloud.maptiler.com/account/keys/' ],
		[ 'mapbox',       'Mapbox',       'https://account.mapbox.com/access-tokens/' ],
		[ 'stadia',       'Stadia Maps',  'https://client.stadiamaps.com/dashboard/' ],
		[ 'thunderforest','Thunderforest','https://manage.thunderforest.com/' ],
		[ 'carto',        'Carto',        'https://carto.com/basemaps/apikey' ],
		[ 'mapillary',    'Mapillary (street view)', 'https://www.mapillary.com/dashboard/developers' ],
		[ 'google',       'Google Street View (Static API)', 'https://console.cloud.google.com/google/maps-apis/credentials' ],
	);
%>
<p class="cfg-note">Map services that issue a key. Travel's Map picker reads these, so a key is typed once here and the map service can be chosen in any window, on any machine the settings reach. A service with no key stays unlisted in Travel until its key is saved. The free services (OpenStreetMap, OpenTopoMap, OSM Humanitarian, CyclOSM and the Esri basemaps) need no key and are not listed. The Mapillary token is free and powers the street-view preview; the Google key is a paid Google Cloud key (billing on, Street View Static API enabled) and is used when Mapillary has no photo of the ground.</p>
<div class="cfg-card">
	<h3 style="margin-top:0;">Tile service keys</h3>
	<% foreach my $service ( @services ) {
		my ($id, $name, $url) = @{$service};
		my $value = &subs::setting_grabber({ app => '__president', setting => 'map_key_' . $id });
	%>
		<div class="cfg-row">
			<label><%= $name %></label>
			<input type="password" class="map_key_input" app="__president" setting="map_key_<%= $id %>" value="<%= $value %>" placeholder="paste the key" autocomplete="off" spellcheck="false" style="flex:1;min-width:14em;">
			<a href="<%= $url %>" target="_blank" rel="noopener" style="font-size:12px;">get a key</a>
		</div>
	<% } %>
	<p class="cfg-note" id="map_keys_status" style="font-size:12px;"></p>
</div>
<div class="cfg-card">
	<h3><%= &subs::lang('configure.movement') %></h3>
	<p class="cfg-note">One device files an appointment's movement. Two machines carried together would each write the trip down and the appointment's distance would be counted twice, so the others keep their own current place and still run their home plates, they just do not file the appointment's fixes. <b>Automatic</b> takes the device that has actually covered ground in the last hour, preferring the one that has been recording longest — a tablet left in the house never wins a trip from the phone that went for the walk — and hands the trip over if that device goes quiet for a quarter of an hour. <b>Every device</b> is the old behaviour: each machine records and the distances double.</p>
	<% my $movement_pick = &subs::setting_grabber({ app => '__president', setting => 'movement_device', device => 'all' }) || 'auto';
		my $labels = &subs::device_labels();
		my @movement_devices;
		my %movement_seen;
		foreach my $d ( @{ &subs::remote_machine_lister({ self => 'yes', mirrors => 'none' }) } ) {
			my $sig = $d->{'signatorial'} || '';
			next unless length $sig && !$movement_seen{$sig}++;
			push @movement_devices, [ $sig, $labels->{$sig} || $d->{'hostname'} || substr($sig, 0, 8) ];
		}
		push @movement_devices, [ $movement_pick, $labels->{$movement_pick} || &subs::ui('a device this house no longer lists') ]
			if $movement_pick !~ /^(?:auto|every)$/ && !$movement_seen{$movement_pick};
	%>
	<div class="cfg-row">
		<label><%= &subs::ui('Recorded by') %></label>
		<select class="movement_device_input" app="__president" setting="movement_device">
			<option value="auto"<% if ($movement_pick eq 'auto') { %> selected<% } %>><%= &subs::lang('common.automatic') %></option>
			<option value="every"<% if ($movement_pick eq 'every') { %> selected<% } %>><%= &subs::lang('common.every_device') %></option>
			<% foreach my $d ( @movement_devices ) { %>
				<option value="<%= $d->[0] %>"<% if ($movement_pick eq $d->[0]) { %> selected<% } %>><%= $d->[1] %></option>
			<% } %>
		</select>
	</div>
	<p class="cfg-note" id="movement_device_status" style="font-size:12px;"></p>
</div>
<div class="cfg-card">
	<h3>Google Maps and Street View</h3>
	<p class="cfg-note"><b>Not OAuth2:</b> a Google Maps or Street View key is a Google Cloud <b>API key</b> with billing switched on, not an OAuth2 client. Enable <b>Street View Static API</b> for the street-level still above. The key can be restricted to this house's web addresses in the Google Cloud console. Google's <b>Map Tiles API</b> (a pannable basemap) needs a session token minted per session, so the Map picker does not offer it; the still image and the street-level photo are what this key serves.</p>
</div>
