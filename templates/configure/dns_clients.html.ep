<%# Configure -> Plat -> DNS. The DNS credentials a certificate is issued
    through, plus the last run's state. Rendered inside the Plat page's DNS tab
    and refetched on its own (/manager/configure/dns_panel) after a change.

    A wildcard certificate can only be validated by DNS-01, and DNS-01 needs no
    inbound connection - which is what makes it work on a machine behind NAT.
    The token is sealed with the house key, exactly like an OAuth client secret.
%>
<% no warnings 'uninitialized'; %>
<%
	my $clients = &tls::dns_clients();
	my $providers = &tls::dns_providers();
	my $config = &subs::config_reader() || {};
	my $domain = $config->{'domain'} || '';
	my $email = $config->{'email'} || '';
	my $status = &tls::tls_status_read();
	my $sig = &subs::signatorial_designer();
	my $house = &subs::house_domain();
	my $hosts = &subs::device_hosts();
	my $rms = &subs::db_select('remote_machines')->hashes;
	my $dock = $ENV{'PORT_DOCK'} || 3000;
	my $my_name = &subs::setting_grabber({ app => 'me', setting => 'my_name' }) || 'this machine';
	# The system certbot owns renewal on a machine that already has it. Offering
	# a second issue there would only create a parallel lineage inside
	# ~/.jawnos_tls and spend a Let's Encrypt attempt for nothing.
	my $system_timer = `systemctl is-active certbot-renew.timer 2>/dev/null`;
	chomp $system_timer;
	$system_timer = ($system_timer eq 'active') ? 1 : 0;
	my %pname = map { $_->{'id'} => $_->{'label'} } @{$providers};
%>
<p class="cfg-note">A wildcard certificate (<b>*.<%= length($house) ? $house : 'example.com' %></b>) can only be proved through a DNS TXT record, so the house writes that record and removes it again. No inbound port is opened, so a machine behind NAT can still renew. The token is sealed with the house key and is never shown again after it is saved. On a server that already runs the system <b>certbot-renew.timer</b>, that timer owns the renewal; this page's issuer is for a machine that has none. The certificate lands in <b>server/fullchain.pem</b> and <b>server/privkey.pem</b>, which the dock server already reads.</p>
<div class="cfg-card">
	<h3 style="margin-top:0;">Public IP check</h3>
	<p class="cfg-note">The remote_control panel asks an outside service for this machine's public address, so the Me view can show whether the VPN is carrying its traffic. Pick the service to ask, or None to stop asking and hide the line on every machine and on Me. None still shows a server's own public address when one of its interfaces carries it; a server behind NAT has none to show.</p>
	<div class="cfg-row">
		<label>Service</label>
		<% my $public_ip_choice = &subs::public_ip_check_choice(); %>
		<select id="public_ip_check_select">
			<option value="all" <% if ($public_ip_choice eq 'all') { %>selected<% } %>>All (Cloudflare, then ipify, then icanhazip)</option>
			<option value="cloudflare" <% if ($public_ip_choice eq 'cloudflare') { %>selected<% } %>>Cloudflare (1.1.1.1)</option>
			<option value="ipify" <% if ($public_ip_choice eq 'ipify') { %>selected<% } %>>ipify</option>
			<option value="icanhazip" <% if ($public_ip_choice eq 'icanhazip') { %>selected<% } %>>icanhazip</option>
			<option value="none" <% if ($public_ip_choice eq 'none') { %>selected<% } %>>None — hide public addresses</option>
		</select>
		<span class="cfg-note" id="public_ip_check_status" style="margin:0;"></span>
	</div>
</div>
<div class="cfg-card">
	<h3 style="margin-top:0;">House name</h3>
	<p class="cfg-note">config.json's <b>domain</b> stays <b><%= $domain %></b> &mdash; it is the loopback the house calls itself on, not a public name. The public side is here: the house domain is the wildcard's zone and the WebAuthn RP ID, and each machine's name must sit under it. A machine reads its own entry, so one machine can name all of them.</p>
	<div class="cfg-row">
		<label>House domain</label>
		<input type="text" id="house_domain_input" value="<%= $house %>" placeholder="example.com" autocomplete="off" spellcheck="false">
		<span class="cfg-note" id="house_domain_status" style="margin:0;"></span>
	</div>
	<div class="cfg-row">
		<label>This machine</label>
		<span class="cfg-note" style="margin:0;">
			<% if (length &subs::public_host()) { %>
				<b><%= &subs::public_host() %></b> &middot; https://<%= &subs::public_host() %>:<%= $dock %>
			<% } else { %>
				not named yet
			<% } %>
			&middot; email <b><%= length($email) ? $email : 'not set' %></b> (config.json)
		</span>
	</div>
	<table style="width:100%;border-collapse:collapse;margin:6px 0;">
		<tr><th style="text-align:left;">Machine</th><th style="text-align:left;">Answers on</th></tr>
		<tr><td>This machine (<%= $my_name %>)</td><td><input type="text" class="device_host_input" signatorial="<%= $sig %>" value="<%= $hosts->{$sig} || '' %>" placeholder="laptop.<%= $house %>" autocomplete="off" spellcheck="false"></td></tr>
		<% foreach my $rm ( @{$rms} ) { my $rsig = $rm->{'signatorial'} || ''; next unless length $rsig; %>
			<tr><td><%= $rm->{'hostname'} || $rm->{'fqdn'} || $rsig %></td><td><input type="text" class="device_host_input" signatorial="<%= $rsig %>" value="<%= $hosts->{$rsig} || '' %>" placeholder="phone.<%= $house %>" autocomplete="off" spellcheck="false"></td></tr>
		<% } %>
	</table>
	<p class="cfg-note" style="margin:0;">Names save when the field loses focus. Leave a field empty to drop that machine's name.</p>
</div>
<div id="dns_client_list">
	<% if (!scalar @{$clients}) { %>
		<p class="cfg-note">No DNS credentials yet. Press <b>Add provider</b>.</p>
	<% } %>
	<% foreach my $dc ( @{$clients} ) { %>
		<% my $pid = $dc->{'provider'} || 'cloudflare'; my $prov = &tls::dns_provider($pid); %>
		<div class="cfg-card dns_client" uuid="<%= $dc->{'uuid'} %>">
			<div class="cfg-row">
				<label>Name</label>
				<input type="text" class="dns_client_field" field="name" uuid="<%= $dc->{'uuid'} %>" value="<%= $dc->{'name'} %>" placeholder="House DNS">
			</div>
			<div class="cfg-row">
				<label>Provider</label>
				<select class="dns_client_field" field="provider" uuid="<%= $dc->{'uuid'} %>">
					<% foreach my $p ( @{$providers} ) { %>
						<option value="<%= $p->{'id'} %>" <% if ($p->{'id'} eq $pid) { %>selected<% } %>><%= $p->{'label'} %></option>
					<% } %>
				</select>
			</div>
			<div class="cfg-row">
				<label>Zone</label>
				<input type="text" class="dns_client_field" field="zone" uuid="<%= $dc->{'uuid'} %>" value="<%= $dc->{'zone'} %>" placeholder="example.com">
			</div>
			<% foreach my $f ( @{ $prov ? $prov->{'fields'} : [] } ) { %>
				<% my ($key, $label) = @{$f}; my $set = length($dc->{$key} || '') ? 1 : 0; %>
				<div class="cfg-row">
					<label><%= $label %></label>
					<span class="cfg-inline">
						<input type="password" class="dns_client_field" field="<%= $key %>" uuid="<%= $dc->{'uuid'} %>" value="" placeholder="<%= $set ? '••• set — type to replace' : 'paste the credential' %>" autocomplete="off" spellcheck="false">
						<% if ($set) { %><span class="cfg-note" style="margin:0;white-space:nowrap;">✔ set</span><% } %>
					</span>
				</div>
			<% } %>
			<% if ($pid eq 'manual') { %>
				<p class="cfg-note" style="margin:0;">Manual mode writes nothing. An issue run prints the exact TXT record to add, then waits for the person to press Enter. It cannot run from the timer.</p>
			<% } %>
			<% if ($pid eq 'cloudflare') { %>
				<p class="cfg-note" style="margin:0;">The same Cloudflare token can serve the AI provider (<b>Cloudflare Workers AI</b>) under Plat &rarr; AI. Either direction copies it, sealed.</p>
			<% } %>
			<div class="cfg-row" style="flex-wrap:wrap;gap:8px;">
				<button class="button dns_client_test" uuid="<%= $dc->{'uuid'} %>">Test</button>
				<% if ($pid eq 'cloudflare') { %>
					<button class="button dns_client_from_ai" uuid="<%= $dc->{'uuid'} %>">Use the AI token</button>
					<button class="button dns_client_to_ai" uuid="<%= $dc->{'uuid'} %>">Use for AI</button>
				<% } %>
				<button class="button dns_client_remove" uuid="<%= $dc->{'uuid'} %>" style="border-color:#e5484d;">Remove</button>
				<span class="cfg-note dns_client_status" uuid="<%= $dc->{'uuid'} %>" style="margin:0;"></span>
			</div>
		</div>
	<% } %>
</div>
<div class="cfg-row" style="flex-wrap:wrap;gap:8px;">
	<button id="dns_client_add" class="button" style="padding:6px 12px;border-radius:8px;border:2px solid var(--line);cursor:pointer;font-weight:bold;">+ Add provider</button>
	<% if ($system_timer) { %>
		<span class="cfg-note" style="margin:0;">Renewal is owned by this machine's system <b>certbot-renew.timer</b>; no second certificate is issued from here.</span>
	<% } else { %>
		<button id="tls_issue_now" class="button" signatorial="<%= $sig %>" style="padding:6px 12px;border-radius:8px;border:2px solid var(--line);cursor:pointer;font-weight:bold;">Issue / renew now</button>
	<% } %>
	<span id="tls_issue_status" class="cfg-note" style="margin:0;">
		<% if ($status->{'at'}) { %>
			Last run <b><%= $status->{'at'} %></b>: <%= $status->{'ok'} ? 'ok' : 'failed' %> — <%= $status->{'message'} || '' %>
		<% } else { %>
			No run yet on this machine.
		<% } %>
	</span>
</div>
