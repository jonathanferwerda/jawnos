<% use Mojo::JSON qw/decode_json/; %>
<% no warnings 'uninitialized'; %>
<%
	# Configure -> Plat -> Crypto. A wallet is an account app, so the panel lists
	# them but the App tab is where one is made. This page owns the assets that
	# are allowed, the live rate snapshot and how a holding is valued. It stores
	# public addresses only: there is deliberately no field here for a key.
	my $enabled = &subs::crypto_enabled();
	my $assets = &subs::crypto_assets();
	my $on = &subs::crypto_enabled_assets();
	my %on = map { $_ => 1 } @{$on};
	my $rates = &subs::crypto_rates_read();
	my $base = &subs::crypto_report_currency();
	my $valuation = lc(&subs::setting_grabber({ app => 'crypto', setting => 'valuation', device => 'all' }) || 'cost');
	$valuation = 'market' if $valuation eq 'market';
	$valuation = 'cost' unless $valuation eq 'market';
	my $wallets = &subs::crypto_wallets_report();
	my $tracking = &subs::crypto_tracking_on();
	my $tracking_app = &subs::crypto_tracking_app();
	my $tracked_at = &subs::setting_grabber({ app => 'crypto', setting => 'tracked_at', device => 'all' });
	my $money = sub {
		my ($v) = @_;
		return '—' unless defined $v;
		return sprintf('%.2f', $v) if $v >= 0.01;
		return sprintf('%.6f', $v);
	};
	my %rate_of;
	my $to_base = $rates->{'rates'}->{$base};
	foreach my $a ( @{$assets} ) {
		my $v = $rates->{'rates'}->{ $a->{'code'} };
		$rate_of{ $a->{'code'} } = (defined $v && defined $to_base && $to_base > 0) ? $v / $to_base : undef;
	}
%>
<div class="cfg crypto_panel" style="max-width:none;padding:0;">
	<h2>Crypto</h2>
	<p class="cfg-note">A wallet is an account that holds a coin. JawnOS keeps its public address and reads what it holds at the shared rate — it never holds a key, cannot spend, and will refuse anything that looks like a seed phrase. Every conversion in the app (including a currency measure typed as <b>x USD to CAD</b>) reads the same live snapshot below.</p>

	<div class="cfg-card">
		<div class="cfg-row">
			<label>Crypto payments</label>
			<input type="checkbox" class="crypto_setting" app="crypto" setting="enabled" value="on" <% if ($enabled) { %>checked<% } %>>
			<span class="cfg-note" style="margin:0;">Off hides the wallet fields and stops the rate refresh. Addresses already saved are kept.</span>
		</div>
		<div class="cfg-row">
			<label>Valuation</label>
			<select class="crypto_setting" app="crypto" setting="valuation">
				<option value="cost" <% if ($valuation eq 'cost') { %>selected<% } %>>Cost — the money recorded when it was received</option>
				<option value="market" <% if ($valuation eq 'market') { %>selected<% } %>>Market — native holding × today's rate</option>
			</select>
			<span class="cfg-note" style="margin:0;">Cost is the safe default for statements. Market is for reading a wallet at today's price; it moves.</span>
		</div>
		<div class="cfg-row">
			<label>Currency tracking</label>
			<input type="checkbox" class="crypto_setting" app="crypto" setting="tracking" value="on" <% if ($tracking) { %>checked<% } %>>
			<span class="cfg-note" style="margin:0;">Record a rate history point every six hours, in place of the appointment that used to update measures. The Measures app charts it and shows each currency and coin as a present value. Stop that old appointment once this is on.<% if ($tracked_at) { %> Last point <span class="time" mode="fixed" timestamp="<%= $tracked_at %>"></span>.<% } %></span>
		</div>
		<div class="cfg-row">
			<label>History app</label>
			<span class="crypto_tracking_app_picker" style="position:relative;flex:1 1 240px;min-width:0;">
				<input type="text" id="crypto_tracking_app" class="crypto_tracking_app_input" value="<%= &subs::format_name($tracking_app) %>" placeholder="type part of a name…" autocomplete="off" spellcheck="false" style="width:100%;box-sizing:border-box;">
				<div class="crypto_tracking_app_results" style="display:none;position:absolute;z-index:60;left:0;right:0;top:100%;background:var(--panel);border:1px solid var(--line);border-radius:8px;max-height:220px;overflow:auto;box-shadow:0 8px 24px rgba(0,0,0,.25);"></div>
			</span>
			<span class="cfg-note crypto_tracking_app_status" style="margin:0;">The app whose measures hold the history. Type part of a name; pick a match, or type a new name to make one.</span>
		</div>
	</div>

	<h3>Assets</h3>
	<p class="cfg-note">Only ticked coins appear when a wallet or a transaction picks one. Bitcoin, Ethereum and the two stable units are on by default.</p>
	<div class="cfg-card">
		<% foreach my $a ( @{$assets} ) { %>
			<div class="cfg-row">
				<label style="min-width:190px;"><input type="checkbox" class="crypto_asset_toggle" value="<%= $a->{'code'} %>" <% if ($on{ $a->{'code'} }) { %>checked<% } %>> <b><%= $a->{'code'} %></b> — <%= $a->{'name'} %></label>
				<span class="cfg-note" style="margin:0;"><%= $a->{'decimals'} %> decimal places · <%= $a->{'network'} %></span>
			</div>
		<% } %>
	</div>

	<h3>Rates</h3>
	<p class="cfg-note">One public, keyless call gives every fiat code and every coin. The house's reporting currency is <b><%= $base %></b>; the loop refreshes every half hour. The request goes to Coinbase, which sees this machine's address; nothing about your wallets is sent.</p>
	<div class="cfg-card">
		<div class="cfg-scroll" style="max-height:320px;overflow:auto;">
			<table>
				<thead><tr><th>Code</th><th>Name</th><th><%= $base %> per 1</th></tr></thead>
				<tbody>
					<% foreach my $a ( @{$assets} ) { %>
						<tr>
							<td><b><%= $a->{'code'} %></b></td>
							<td><%= $a->{'name'} %></td>
							<td><%= $money->($rate_of{ $a->{'code'} }) %></td>
						</tr>
					<% } %>
					<% foreach my $f ( @{ &subs::crypto_fiat_table() } ) { %>
						<% next if $f->{'code'} eq $base; %>
						<% my $v = $rates->{'rates'}->{ $f->{'code'} }; next unless defined $v && defined $to_base && $to_base > 0; %>
						<tr>
							<td><b><%= $f->{'code'} %></b></td>
							<td><%= $f->{'name'} %></td>
							<td><%= $money->($v / $to_base) %></td>
						</tr>
					<% } %>
				</tbody>
			</table>
		</div>
		<div class="cfg-actions">
			<span class="cfg-note" style="margin:0;">Last read: <b class="time" mode="fixed" timestamp="<%= $rates->{'at'} %>"><%= $rates->{'at'} ? do { my @t = localtime($rates->{'at'} / 1000); sprintf('%04d-%02d-%02d %02d:%02d', $t[5] + 1900, $t[4] + 1, $t[3], $t[2], $t[1]) } : 'never' %></b><%= $rates->{'source'} ? ' · ' . $rates->{'source'} : '' %></span>
			<button type="button" id="crypto_refresh">Refresh now</button>
			<span id="crypto_refresh_status" class="cfg-note" style="margin:0;"></span>
		</div>
	</div>

	<h3>Wallets</h3>
	<% if (scalar @{$wallets}) { %>
		<div class="cfg-scroll">
			<table>
				<thead><tr><th>Wallet</th><th>Coin</th><th>Address</th><th>Addresses</th><th>Holding</th><th>Cost</th><th>Market</th></tr></thead>
				<tbody>
					<% foreach my $w ( @{$wallets} ) { %>
						<tr class="crypto_wallet_row" app="<%= $w->{'app'} %>">
							<td><b><%= $w->{'formatted_name'} %></b><% if ($w->{'label'}) { %><div class="cfg-note" style="margin:0;"><%= $w->{'label'} %></div><% } %></td>
							<td><%= $w->{'asset'} %></td>
							<td style="font-family:monospace;font-size:12px;"><% if ($w->{'address'}) { %><%= $w->{'address_short'} %><% } else { %><span style="opacity:.6;">no address yet</span><% } %></td>
							<td><% if ($w->{'per_invoice'}) { %><%= &subs::ui('new per invoice') %><% } else { %><%= &subs::ui('one') %><% } %></td>
							<td><%= $w->{'native_display'} %></td>
							<td><%= &subs::price_formatter($w->{'book'}) %></td>
							<td><%= defined $w->{'market'} ? &subs::price_formatter($w->{'market'}) : '—' %></td>
						</tr>
					<% } %>
				</tbody>
			</table>
		</div>
		<p class="cfg-note">The two money columns are the same holding seen two ways: Cost is the money recorded when it arrived, Market is the native amount at today's rate.</p>
		<p class="cfg-note"><b>Addresses</b> shows whether the wallet issues a fresh address for every invoice (it has an account xpub) or keeps the one saved address. An xpub is public: it derives addresses and cannot spend. The address column is the fallback, used when no invoice address has been issued yet.</p>
	<% } else { %>
		<p class="cfg-note">No wallets yet. Make an app an <b>account</b> in the App tab, turn on <b>Payment Type</b> and set it to <b>crypto</b> — the wallet fields appear on that app's card.</p>
	<% } %>
	<div class="cfg-actions">
		<span class="cfg-note" style="margin:0;">A wallet is an ordinary account: make or edit one in the App tab (Part of Speech = account, Payment Type = crypto), and its card holds the address. It records transactions, transfers and statements like any other account.</span>
	</div>

	<details class="cfg-details" style="margin-top:14px;">
		<summary>Make a payment proof</summary>
		<p class="cfg-note">Sign a statement of what this house sent, naming the seller's crest. The seller's crypto panel shows their crest uuid; paste it here, or paste their CREST1Z code. The seller verifies and countersigns the same bytes.</p>
		<div class="cfg-grid">
			<div class="cfg-row"><label>Seller crest</label><input id="crypto_proof_payee" placeholder="crest uuid or CREST1Z:…" autocomplete="off" spellcheck="false" style="width:100%;"></div>
			<div class="cfg-row"><label>Invoice ref</label><input id="crypto_proof_ref" placeholder="2026-21-2026-3abc" style="width:100%;"></div>
			<div class="cfg-row"><label>Coin</label><select id="crypto_proof_asset"><% foreach my $code ( @{$assets} ) { my $a = &subs::crypto_asset($code); next unless $a; %><option value="<%= $a->{'code'} %>"><%= $a->{'code'} %> — <%= $a->{'name'} %></option><% } %></select></div>
			<div class="cfg-row"><label>Amount sent</label><input id="crypto_proof_amount" inputmode="decimal" placeholder="0.00120000" style="width:100%;"></div>
			<div class="cfg-row"><label>Address</label><input id="crypto_proof_address" placeholder="the seller's address" style="width:100%;"></div>
			<div class="cfg-row"><label>txid</label><input id="crypto_proof_txid" placeholder="transaction id" style="width:100%;"></div>
			<div class="cfg-row"><label>Memo</label><input id="crypto_proof_memo" placeholder="optional" style="width:100%;"></div>
		</div>
		<div class="cfg-actions">
			<button type="button" id="crypto_proof_build">Sign with this house's crest</button>
			<span id="crypto_proof_status" class="cfg-note" style="margin:0;"></span>
		</div>
		<textarea id="crypto_proof_code" readonly spellcheck="false" placeholder="the PAY1Z code appears here" style="width:100%;box-sizing:border-box;min-height:90px;font-family:monospace;font-size:12px;display:none;"></textarea>
		<div class="cfg-actions" id="crypto_proof_actions" style="display:none;">
			<button type="button" id="crypto_proof_copy">Copy code</button>
			<span id="crypto_proof_result" class="cfg-note" style="margin:0;"></span>
		</div>
		<div style="text-align:center;"><img id="crypto_proof_qr" alt="proof QR" style="display:none;width:180px;height:180px;background:#fff;padding:4px;border-radius:8px;"></div>
	</details>
</div>
