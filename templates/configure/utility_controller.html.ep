<% use Mojo::JSON qw/encode_json decode_json/; %>
<% no warnings 'uninitialized'; %>
<% my $signatorial = &subs::signatorial_designer(); %>

<% my $controls = eval { return decode_json &subs::setting_grabber({ app => '__president', setting => 'utility_controller' }) } || {}; %>
<% if (scalar keys %{$controls} == 0) { %>
	<p class="cfg-note">Never seen this</p>
	<% foreach my $dt ( ( $signatorial, @gb::device_types ) ) { %>
		<p class="cfg-note">writing for <%= $dt %></p>
		<% $controls->{$dt} = $gb::timeouts; %>
	<% } %>
<% } %>

<style>
/* One card per machine, one row per background job: a job's name on the left,
   its controls on the right, wrapping under the name on a phone. No wide table,
   so nothing is hidden off the right edge. */
#utility_machines { display:flex; flex-direction:column; gap:10px; }
#utility_machines .utility_machine_name { margin:0 0 6px; }
#utility_machines .utility_jobs { display:flex; flex-direction:column; }
#utility_machines .utility_job { display:flex; flex-wrap:wrap; align-items:center; gap:6px 10px; padding:6px 0; border-top:1px solid var(--line); }
#utility_machines .utility_job:first-child { border-top:0; }
#utility_machines .utility_job_name { flex:1 1 150px; min-width:0; font-size:13px; }
#utility_machines .utility_job_controls { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
#utility_machines .utility_controller_timeout { width:78px; box-sizing:border-box; padding:4px 6px; border-radius:6px; border:1px solid var(--line); background:var(--panel); color:var(--ink); font:inherit; }
#utility_machines .utility_job_when { opacity:.6; font-size:85%; white-space:nowrap; }
#utility_machines .utility_job_effect { flex:1 1 100%; opacity:.7; font-size:82%; font-style:italic; }
@media (max-width:560px) {
	#utility_machines .utility_job_name { flex:1 1 100%; }
}
</style>

<div id="utility_controls">
	% my $batch = $controls->{$signatorial}->{'__batch_groups'} || {};
	<div class="cfg-card" id="utility_batch_groups" hint="Batch groups">
		<h4 class="utility_machine_name" hint="<%= &subs::ui('Batch groups') %>"><%= &subs::ui('Batch groups') %></h4>
		<p class="cfg-note"><%= &subs::ui("Set a group's pace; every job in it takes that interval, so they wake together and the device naps between.") %></p>
		<div class="utility_jobs">
			<% foreach my $g ( qw/navigation fast slow daily/ ) { %>
				% my $def = $gb::batch_groups->{$g} || {};
				% my @members = grep { (($gb::timeouts->{$_}->{'group'} || '') eq $g) } sort keys %{$gb::timeouts};
				<div class="utility_job">
					<span class="utility_job_name"><%= &subs::ui($def->{'label'} || $g) %> <span class="utility_job_when"><%= join ', ', map { &subs::format_name($_) } @members %></span></span>
					<div class="utility_job_controls">
						<input class="utility_batch_group utility_controller_timeout" group="<%= $g %>" hint="<%= &subs::ui($def->{'hint'} || 'Pace for this group') %>" value="<%= &subs::duration_sayer($batch->{$g} || $def->{'seconds'}) %>">
					</div>
				</div>
			<% } %>
		</div>
	</div>
	% my @machine_keys = grep { $_ eq $signatorial || $_ =~ /^[0-9a-f]{32}$/ } keys %{$controls};
	% my %machine_name;
	% foreach my $mk ( @machine_keys ) {
	% 	next if $mk eq $signatorial;
	% 	my $rm = &subs::db_select('remote_machines', ['hostname'], { signatorial => $mk })->hashes->[0];
	% 	$machine_name{$mk} = $rm->{'hostname'} if $rm && $rm->{'hostname'};
	% }
	<div id="utility_machines">
	% my @ordered_keys = sort { ($a eq $signatorial ? 0 : 1) <=> ($b eq $signatorial ? 0 : 1) || $a cmp $b } @machine_keys;
	<% foreach my $dt ( @ordered_keys ) { %>
		<div class="cfg-card utility_machine">
			<h4 class="utility_machine_name"><%= $signatorial eq $dt ? 'Me' : ($machine_name{$dt} || $dt) %></h4>
			<div class="utility_jobs">
				<% foreach my $t ( sort keys %{$gb::timeouts} ) { %>
					% next unless $controls->{$dt}->{$t};
					<div class="utility_job">
						<span class="utility_job_name"><%= &subs::format_name($t) %></span>
						<div class="utility_job_controls">
							<input type="checkbox" class="utility_controller" control="<%= $t %>" device="<%= $dt %>" setting="toggle" hint="Run this job" <% if ($controls->{$dt}->{$t}->{'toggle'} eq 'on') { %>checked="checked"<% } %>>
							<input class="utility_controller utility_controller_timeout" control="<%= $t %>" setting="interval" device="<%= $dt %>" hint="How often" value="<%= &subs::duration_sayer($controls->{$dt}->{$t}->{'interval'}) %>">
							<% if ($controls->{$dt}->{$t}->{'status'} eq 'good') { %>
								<img class="good_status little_thumb circular_thumb" src="<%= &subs::icon_for('/images/make believe/good.png') %>" hint="Good">
							<% } elsif ($controls->{$dt}->{$t}->{'status'} eq 'bad') { %>
								<img class="good_status little_thumb circular_thumb" src="<%= &subs::icon_for('/images/make believe/bad.png') %>" hint="Bad">
							<% } %>
							<% if ($controls->{$dt}->{$t}->{'last_run'}) { %>
								<span class="time utility_job_when" timestamp="<%= $controls->{$dt}->{$t}->{'last_run'} %>"></span>
							<% } %>
							<% if ($controls->{$dt}->{$t}->{'last_effect'}) { %>
								<span class="utility_job_effect" hint="what the last run did"><%= $controls->{$dt}->{$t}->{'last_effect'} %></span>
							<% } %>
						</div>
					</div>
				<% } %>
			</div>
		</div>
	<% } %>
	</div>
</div>
