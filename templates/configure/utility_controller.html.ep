<% use Mojo::JSON qw/encode_json decode_json/; %>
<% no warnings 'uninitialized'; %>
<% my $signatorial = &subs::signatorial_designer(); %>

<% my $controls = eval { return decode_json &subs::setting_grabber({ app => '__president', setting => 'utility_controller' }) } || {}; %>
<% if (scalar keys %{$controls} == 0) { %>
	<p class="cfg-note">Never seen this</p>
	<% foreach my $dt ( ( $signatorial, @gb::device_types ) ) { %>
		<p class="cfg-note">writing for <%= $dt %></p>
		<% $controls->{$dt} = $gb::timeouts; %>
	<% } %>
<% } %>

<style>
/* One card per machine, one row per background job: a job's name on the left,
   its controls on the right, wrapping under the name on a phone. No wide table,
   so nothing is hidden off the right edge. */
#utility_machines { display:flex; flex-direction:column; gap:10px; }
#utility_machines .utility_machine_name { margin:0 0 6px; }
#utility_machines .utility_jobs { display:flex; flex-direction:column; }
#utility_machines .utility_job { display:flex; flex-wrap:wrap; align-items:center; gap:6px 10px; padding:6px 0; border-top:1px solid var(--line); }
#utility_machines .utility_job:first-child { border-top:0; }
#utility_machines .utility_job_name { flex:1 1 150px; min-width:0; font-size:13px; }
#utility_machines .utility_job_controls { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
#utility_machines .utility_controller_timeout { width:78px; box-sizing:border-box; padding:4px 6px; border-radius:6px; border:1px solid var(--line); background:var(--panel); color:var(--ink); font:inherit; }
#utility_machines .utility_job_when { opacity:.6; font-size:85%; white-space:nowrap; }
#utility_machines .utility_job_effect { flex:1 1 100%; opacity:.7; font-size:82%; font-style:italic; }
/* The batch pools: one card per pool in a responsive grid, and a grid of job
   tiles inside each, so the functions line up and read as a set. A tile is the
   job's whole row in miniature - switch, name, dot, last run - so a pooled job
   needs no second copy in the flat list below. */
#utility_pools { display:grid; grid-template-columns:repeat(auto-fit, minmax(min(360px, 100%), 1fr)); gap:10px; align-items:start; }
#utility_pools .utility_pool { min-width:0; border:1px solid var(--line); border-radius:10px; padding:8px 10px; background:var(--panel); }
#utility_pools .utility_pool_regular { grid-column:1 / -1; border-style:dashed; }
#utility_pools .utility_pool_head { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
#utility_pools .utility_pool_label { flex:1 1 110px; min-width:0; padding:4px 6px; border-radius:6px; border:1px solid transparent; background:transparent; color:var(--ink); font:inherit; font-weight:600; }
#utility_pools .utility_pool_label:hover,
#utility_pools .utility_pool_label:focus { border-color:var(--line); background:var(--field, var(--panel)); }
#utility_pools .utility_pool_seconds { width:76px; box-sizing:border-box; padding:4px 6px; border-radius:6px; border:1px solid var(--line); background:var(--panel); color:var(--ink); font:inherit; }
#utility_pools .utility_pool_remove { border:0; background:transparent; color:inherit; opacity:.55; font-size:18px; line-height:1; padding:2px 6px; cursor:pointer; }
#utility_pools .utility_pool_remove:hover { opacity:1; }
#utility_pools .utility_pool_members { display:grid; grid-template-columns:repeat(auto-fill, minmax(min(150px, 100%), 1fr)); gap:6px; align-content:start; min-height:36px; padding:6px 0 0; }
#utility_pools .utility_pool_members.utility_pool_over { outline:2px dashed var(--accent, #7aa7ff); outline-offset:2px; border-radius:8px; }
#utility_pools .utility_pool_empty { grid-column:1 / -1; opacity:.5; font-size:85%; font-style:italic; padding:6px 2px; }
#utility_pools .utility_chip { display:flex; flex-wrap:wrap; align-items:center; gap:4px 6px; min-width:0; padding:6px 8px; border-radius:8px; border:1px solid var(--line); background:var(--panel); font-size:13px; cursor:grab; touch-action:none; user-select:none; }
#utility_pools .utility_chip:hover { border-color:var(--accent, #7aa7ff); }
#utility_pools .utility_chip.utility_chip_dragging { opacity:.45; }
#utility_pools .utility_chip_name { flex:1 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-weight:500; }
#utility_pools .utility_chip_interval { width:64px; box-sizing:border-box; padding:2px 5px; border-radius:6px; border:1px solid var(--line); background:var(--panel); color:var(--ink); font:inherit; font-size:12px; }
#utility_pools .utility_chip_meta { flex:1 1 100%; display:flex; align-items:center; gap:6px; min-height:16px; }
#utility_pools .utility_chip_meta .utility_job_when { margin-left:auto; opacity:.6; font-size:82%; white-space:nowrap; }
#utility_batch_groups .utility_pool_add { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:10px; }
#utility_batch_groups .utility_pool_new_name { flex:1 1 160px; min-width:0; padding:5px 8px; border-radius:6px; border:1px solid var(--line); background:var(--panel); color:var(--ink); font:inherit; }
#utility_machines .utility_pool_group { border-top:1px solid var(--line); padding-top:4px; }
#utility_machines .utility_pool_group_head { font-size:85%; opacity:.7; padding:4px 0 0; }
/* The Crew: this machine's abilities and each peer's advert as chips, so a
   machine's contribution to the house reads at a glance. The accordion frame
   itself (.cfg-acc) is shared and defined elsewhere. */
#crew_self .crew_chips, #crew_peers .crew_chips { display:flex; flex-wrap:wrap; gap:6px; }
.crew_chip { display:inline-flex; align-items:center; gap:4px; padding:3px 8px; border:1px solid var(--line); border-radius:999px; background:var(--panel); font-size:12px; white-space:nowrap; }
.crew_chip_dim { opacity:.5; }
.crew_peer { display:flex; flex-wrap:wrap; align-items:center; gap:6px 10px; padding:7px 0; border-top:1px solid var(--line); }
.crew_peer:first-of-type { border-top:0; }
.crew_peer_name { flex:0 1 170px; min-width:0; font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.crew_peer_meta { opacity:.7; font-size:85%; white-space:nowrap; }
.crew_advertise { padding:5px 10px; border-radius:6px; border:1px solid var(--line); background:var(--panel); color:var(--ink); font:inherit; cursor:pointer; }
.crew_advertise:hover { border-color:var(--accent, #7aa7ff); }
.crew_advertise:disabled { opacity:.5; cursor:default; }
@media (max-width:560px) {
	#utility_machines .utility_job_name { flex:1 1 100%; }
}
</style>

<div id="utility_controls">
	<% my $crew_abilities = eval { &crew::abilities() } || {}; %>
	<% my $crew_peers = eval { &crew::advert_list() } || []; %>
	<% my $crew_now = &subs::rightNow(); %>
	<details class="cfg-acc" data-acc="crew-abilities" open>
		<summary hint="Crew"><%= &subs::ui('Crew') %></summary>
		<div class="cfg-card" id="crew_self">
			<h4 class="utility_machine_name" hint="This machine"><%= &subs::ui('This machine') %> — <%= $crew_abilities->{'hostname'} || &subs::ui('unknown') %></h4>
			<p class="cfg-note"><%= &subs::ui('What this machine contributes to the house. The Crew places a job on a machine that can run it, so a device never calls a model it does not hold or cannot pay for.') %></p>
			<div class="crew_chips">
				<span class="crew_chip" hint="Processor cores"><%= &subs::ui('Cores') %>: <%= $crew_abilities->{'cores'} || '?' %></span>
				<span class="crew_chip" hint="One-minute load average"><%= &subs::ui('Load') %>: <%= defined $crew_abilities->{'load1'} ? sprintf('%.2f', $crew_abilities->{'load1'}) : '?' %></span>
				<span class="crew_chip" hint="Free and total memory"><%= &subs::ui('Memory') %>: <%= $crew_abilities->{'ram_free_mb'} || 0 %> / <%= $crew_abilities->{'ram_mb'} || 0 %> MB</span>
				<span class="crew_chip" hint="Free disk space"><%= &subs::ui('Disk') %>: <%= $crew_abilities->{'disk_free_mb'} || 0 %> MB <%= &subs::ui('free') %></span>
				<% if (defined $crew_abilities->{'battery_percent'}) { %>
					<span class="crew_chip" hint="Battery"><%= &subs::ui('Battery') %>: <%= $crew_abilities->{'battery_percent'} %>%<%= $crew_abilities->{'on_ac'} ? ' · ' . &subs::ui('on AC') : '' %></span>
				<% } %>
				<span class="crew_chip" hint="Operating system"><%= $crew_abilities->{'os'} || '?' %> · <%= $crew_abilities->{'arch'} || '?' %></span>
				<span class="crew_chip" hint="Device type"><%= $crew_abilities->{'device_type'} || '?' %></span>
				<span class="crew_chip<%= $crew_abilities->{'ollama'} ? '' : ' crew_chip_dim' %>" hint="Local AI models">Ollama: <%= $crew_abilities->{'ollama'} ? scalar(@{ $crew_abilities->{'ollama_models'} || [] }) . ' ' . &subs::ui('models') : &subs::ui('none') %></span>
				<% my $crew_models = $crew_abilities->{'ollama_models'} || []; %>
				<% foreach my $crew_model ( @{ $crew_models }[0 .. ($#{$crew_models} > 7 ? 7 : $#{$crew_models})] ) { %>
					<% next unless defined $crew_model; %>
					<span class="crew_chip" hint="AI model"><%= $crew_model %></span>
				<% } %>
				<% if (scalar @{$crew_models} > 8) { %><span class="crew_chip" hint="More models">+<%= scalar(@{$crew_models}) - 8 %></span><% } %>
				<% my $crew_tools = $crew_abilities->{'tools'} || {}; %>
				<% foreach my $crew_tool ( sort keys %{$crew_tools} ) { %>
					<span class="crew_chip<%= $crew_tools->{$crew_tool} ? '' : ' crew_chip_dim' %>" hint="Tool"><%= $crew_tool %></span>
				<% } %>
				<% my $crew_kinds = eval { &crew::kinds_for($crew_abilities) } || []; %>
				<% if (scalar @{$crew_kinds}) { %><span class="crew_chip" hint="Job kinds this machine can run"><%= &subs::ui('Job kinds') %>: <%= join ', ', @{$crew_kinds} %></span><% } %>
			</div>
		</div>
		<div class="cfg-card" id="crew_peers">
			<h4 class="utility_machine_name" hint="Peers"><%= &subs::ui('Peers') %></h4>
			<% if (scalar @{$crew_peers}) { %>
				<% foreach my $crew_peer ( sort { ($b->{'read_at'} || 0) <=> ($a->{'read_at'} || 0) } @{$crew_peers} ) { %>
					<% my $crew_a = $crew_peer->{'abilities'} || {}; %>
					<% my $crew_age = $crew_now - ($crew_peer->{'read_at'} || $crew_now); %>
					<% my $crew_peer_kinds = eval { &crew::kinds_for($crew_a) } || []; %>
					<div class="crew_peer">
						<span class="crew_peer_name" hint="Peer machine"><%= $crew_a->{'hostname'} || $crew_peer->{'signatorial'} %></span>
						<span class="crew_peer_meta" hint="How long ago this peer advertised"><%= &subs::ui('last heard') %> <%= $crew_age > 120000 ? int($crew_age / 60000) . ' ' . &subs::ui('min ago') : int($crew_age / 1000) . ' ' . &subs::ui('sec ago') %></span>
						<span class="crew_peer_meta" hint="Peer load"><%= &subs::ui('Load') %>: <%= defined $crew_a->{'load1'} ? sprintf('%.2f', $crew_a->{'load1'}) : '?' %></span>
						<span class="crew_chip" hint="Peer AI models">Ollama: <%= scalar(@{ $crew_a->{'ollama_models'} || [] }) %> <%= &subs::ui('models') %></span>
						<% if (scalar @{$crew_peer_kinds}) { %><span class="crew_chip" hint="Job kinds this peer can run"><%= join ', ', @{$crew_peer_kinds} %></span><% } else { %><span class="crew_chip crew_chip_dim" hint="No job kind fits this peer"><%= &subs::ui('no job kind fits') %></span><% } %>
					</div>
				<% } %>
			<% } else { %>
				<p class="cfg-note"><%= &subs::ui('No peer has advertised yet. Each machine is asked every five minutes, and Advertise now asks at once.') %></p>
			<% } %>
			<p class="cfg-note">
				<button type="button" class="crew_advertise" hint="Advertise now" onclick="var b=this;b.disabled=true;fetch('/manager/crew/advertise',{method:'POST'}).then(function(r){return r.json();}).then(function(){if(typeof utilityControllerReloader==='function'){utilityControllerReloader();}else{location.reload();}}).catch(function(){b.disabled=false;});"><%= &subs::ui('Advertise now') %></button>
			</p>
		</div>
	</details>
	<% my $my_pools = &subs::batch_pools($controls->{$signatorial}); %>
	<% my %my_pool = map { $_->{'id'} => $_ } @{$my_pools}; %>
	<% my $my_member = sub { my $job = shift; my $group = $controls->{$signatorial}->{$job}->{'group'} || ''; return ($group ne '' && $my_pool{$group}) ? $my_pool{$group} : undef; }; %>
	<div class="cfg-card" id="utility_batch_groups" hint="Batch groups">
		<h4 class="utility_machine_name" hint="Batch pools"><%= &subs::ui('Batch pools') %></h4>
		<p class="cfg-note"><%= &subs::ui('Drop a job into a pool and it runs on that pool\'s pace, so the whole pool wakes together and the device naps between. A job outside every pool keeps its own interval, further down.') %></p>
		<div class="utility_pool_add">
			<input class="utility_pool_new_name" hint="New pool name" placeholder="<%= &subs::ui('New pool name') %>">
			<button type="button" class="utility_pool_add_button" hint="Add a pool"><%= &subs::ui('Add a pool') %></button>
		</div>
		<div id="utility_pools">
			<% foreach my $pool ( @{$my_pools} ) { %>
				<% my @members = grep { $controls->{$signatorial}->{$_} && ($my_member->($_) || {})->{'id'} eq $pool->{'id'} } sort keys %{$gb::timeouts}; %>
				<div class="utility_pool" data-pool="<%= $pool->{'id'} %>">
					<div class="utility_pool_head">
						<input class="utility_pool_label" data-pool="<%= $pool->{'id'} %>" hint="Pool name" value="<%= $pool->{'label'} %>">
						<input class="utility_pool_seconds" data-pool="<%= $pool->{'id'} %>" hint="Pace for this pool" value="<%= &subs::duration_sayer($pool->{'seconds'}) %>">
						<button type="button" class="utility_pool_remove" data-pool="<%= $pool->{'id'} %>" hint="Remove this pool">&times;</button>
					</div>
					<div class="utility_pool_members" data-pool="<%= $pool->{'id'} %>" hint="Drop jobs here">
						<% if (scalar @members) { %>
							<% foreach my $t ( @members ) { %><%= include 'configure/utility_chip', job => $t, device => $signatorial, row => $controls->{$signatorial}->{$t}, show_interval => 0 %><% } %>
						<% } else { %>
							<span class="utility_pool_empty"><%= &subs::ui('Drop jobs here') %></span>
						<% } %>
					</div>
				</div>
			<% } %>
			<% my @loose = sort {
				(($controls->{$signatorial}->{$a}->{'toggle'} || 'off') eq 'on' ? 0 : 1)
					<=> (($controls->{$signatorial}->{$b}->{'toggle'} || 'off') eq 'on' ? 0 : 1)
					|| $a cmp $b
			} grep { $controls->{$signatorial}->{$_} && !$my_member->($_) } keys %{$gb::timeouts}; %>
			<div class="utility_pool utility_pool_regular">
				<div class="utility_pool_head"><span class="utility_pool_label" hint="Not in a pool"><%= &subs::ui('Not in a pool') %></span></div>
				<div class="utility_pool_members" data-pool="" hint="Drop jobs here">
					<% if (scalar @loose) { %>
						<% foreach my $t ( @loose ) { %><%= include 'configure/utility_chip', job => $t, device => $signatorial, row => $controls->{$signatorial}->{$t}, show_interval => 1 %><% } %>
					<% } else { %>
						<span class="utility_pool_empty"><%= &subs::ui('Everything is in a pool') %></span>
					<% } %>
				</div>
			</div>
		</div>
	</div>
	% my @machine_keys = grep { $_ eq $signatorial || $_ =~ /^[0-9a-f]{32}$/ } keys %{$controls};
	% my %machine_name;
	% foreach my $mk ( @machine_keys ) {
	% 	next if $mk eq $signatorial;
	% 	my $rm = &subs::db_select('remote_machines', ['hostname'], { signatorial => $mk })->hashes->[0];
	% 	$machine_name{$mk} = $rm->{'hostname'} if $rm && $rm->{'hostname'};
	% }
	<div id="utility_machines">
	% my @ordered_keys = sort { $a cmp $b } @machine_keys;
	<% foreach my $dt ( @ordered_keys ) { %>
		% next if $dt eq $signatorial;
		<div class="cfg-card utility_machine">
			<h4 class="utility_machine_name"><%= $machine_name{$dt} || $dt %></h4>
			<div class="utility_jobs">
				<% foreach my $t ( sort keys %{$gb::timeouts} ) { %>
					% next unless $controls->{$dt}->{$t};
					% next if &subs::batch_pool_of($controls->{$dt}, $t);
					<div class="utility_job">
						<span class="utility_job_name"><%= &subs::format_name($t) %></span>
						<div class="utility_job_controls">
							<input type="checkbox" class="utility_controller" control="<%= $t %>" device="<%= $dt %>" setting="toggle" hint="Run this job" <% if ($controls->{$dt}->{$t}->{'toggle'} eq 'on') { %>checked="checked"<% } %>>
							<input class="utility_controller utility_controller_timeout" control="<%= $t %>" setting="interval" device="<%= $dt %>" hint="How often" value="<%= &subs::duration_sayer($controls->{$dt}->{$t}->{'interval'}) %>">
							<% if ($controls->{$dt}->{$t}->{'status'} eq 'good') { %>
								<img class="good_status little_thumb circular_thumb" src="<%= &subs::icon_for('/images/make believe/good.png') %>" hint="Good">
							<% } elsif ($controls->{$dt}->{$t}->{'status'} eq 'bad') { %>
								<img class="good_status little_thumb circular_thumb" src="<%= &subs::icon_for('/images/make believe/bad.png') %>" hint="Bad">
							<% } %>
							<% if ($controls->{$dt}->{$t}->{'last_run'}) { %>
								<span class="time utility_job_when" timestamp="<%= $controls->{$dt}->{$t}->{'last_run'} %>"></span>
							<% } %>
							<% if ($controls->{$dt}->{$t}->{'last_effect'}) { %>
								<span class="utility_job_effect" hint="what the last run did"><%= $controls->{$dt}->{$t}->{'last_effect'} %></span>
							<% } %>
						</div>
					</div>
				<% } %>
			</div>
			<% foreach my $pool ( @{ &subs::batch_pools($controls->{$dt}) } ) { %>
				<% my @members = grep { my $p = &subs::batch_pool_of($controls->{$dt}, $_); $p && $p->{'id'} eq $pool->{'id'} } sort keys %{$gb::timeouts}; %>
				<% next unless scalar @members; %>
				<div class="utility_pool_group">
					<div class="utility_pool_group_head"><%= &subs::ui($pool->{'label'}) %> · <%= &subs::duration_sayer($pool->{'seconds'}) %></div>
					<div class="utility_jobs">
						<% foreach my $t ( @members ) { %>
							<div class="utility_job">
								<span class="utility_job_name"><%= &subs::format_name($t) %></span>
								<div class="utility_job_controls">
									<input type="checkbox" class="utility_controller" control="<%= $t %>" device="<%= $dt %>" setting="toggle" hint="Run this job" <% if ($controls->{$dt}->{$t}->{'toggle'} eq 'on') { %>checked="checked"<% } %>>
									<% if ($controls->{$dt}->{$t}->{'status'} eq 'good') { %>
										<img class="good_status little_thumb circular_thumb" src="<%= &subs::icon_for('/images/make believe/good.png') %>" hint="Good">
									<% } elsif ($controls->{$dt}->{$t}->{'status'} eq 'bad') { %>
										<img class="good_status little_thumb circular_thumb" src="<%= &subs::icon_for('/images/make believe/bad.png') %>" hint="Bad">
									<% } %>
									<% if ($controls->{$dt}->{$t}->{'last_run'}) { %>
										<span class="time utility_job_when" timestamp="<%= $controls->{$dt}->{$t}->{'last_run'} %>"></span>
									<% } %>
									<% if ($controls->{$dt}->{$t}->{'last_effect'}) { %>
										<span class="utility_job_effect" hint="what the last run did"><%= $controls->{$dt}->{$t}->{'last_effect'} %></span>
									<% } %>
								</div>
							</div>
						<% } %>
					</div>
				</div>
			<% } %>
		</div>
	<% } %>
	</div>
</div>
