<% no warnings 'uninitialized'; %>
<% my $pseudonyms; %>
<%# the house's tickets by name, newest first, so an appointment's Chat button
    can name the road: the ticket thread when one is open in the person's name,
    else their phone %>
<% my $ticket_rows = &subs::db_query('select uuid, name from tickets order by server_time desc')->hashes; %>
<% my %ticket_uuid_by_name; %>
<% foreach my $t (@{$ticket_rows}) { $ticket_uuid_by_name{lc($t->{'name'} || '')} ||= $t->{'uuid'}; } %>
<%# The machines a media button may be pointed at. One lister call for the whole
    wrapper; the old per-appointment query was narrow and repeated per row. The
    synthetic 'me' row and mirrors are local views, not targets. %>
<% my $media_machine_rows = &subs::remote_machine_lister({ connection => 'active' }); %>
<% my @media_machines = grep { ($_->{'mirror'} || '') ne 'yes' && ($_->{'hostname'} || '') ne 'me' } @{$media_machine_rows}; %>
<% my %media_default = map { $_ => (&subs::setting_grabber({ app => 'me', setting => 'media_machine_' . $_ }) || '') } qw/camera record scan/; %>

<span timestamp="<%= $timestamp %>" id="<%= $timestamp %>" class="appointment_contents" app="<%= $appointments->[0] %>" style="overflow:scroll; background-color:var(--panel);">
	<% foreach my $a (@{$appointments}) { %>
		<% if ($from eq 'store') { %>
			<% $pseudonyms = &Manager::pseudonym_maker('store',$a); %>
		<% } else { %>
			<% $pseudonyms = &Manager::pseudonym_maker('viewer',$a); %>
		<% } %>
		<div class="appointment" formatted_name="<%= $appts->{$a}->{'formatted_name'} %>" warranty="<%= $appts->{$a}->{'warranty'} %>" app="<%= $a %>" last="<%= $appts->{$a}->{'last_event'} %>" 
			id="app_<%= $appts->{$a}->{'html_name'} %>" style="text-align:center;" navigation="<%= &subs::time_abbrev_translator($appts->{$a}->{'setting'}->{'navigation'}) %>">
			<% if ($appts->{'__stash'}->{'header'} eq 'yes') { %>
				<span style="" class="appointment_cell" id="<%= $appts->{$a}->{'html_name'} %>_cell" app="<%= $a %>">
					<% my $label_colour = $appts->{$a}->{'setting'}->{'colour'} || 'yellow'; %>
					<% my $label_dark = $appts->{$a}->{'setting'}->{'dark_colour'} || &subs::dark_colour_for($label_colour); %>
					<% my $label_ink = &subs::contrast_ink($label_colour); %>
					<% my $label_dark_ink = &subs::contrast_ink($label_dark); %>
					<div data-appt-tint="yes" style="--appt-dark:<%= $label_dark %>;--appt-dark-ink:<%= $label_dark_ink %>;font-size: 20px; background-color:<%= $label_colour %>; color:<%= $label_ink %>;" 
						class="appointment_name" app="<%= $a %>" >
						<span class="name_text" data-appt-tint="yes" app="<%= $a %>" style="--appt-dark:<%= $label_dark %>;--appt-dark-ink:<%= $label_dark_ink %>;border-radius: 7%; border-width: 3px; border: solid; padding: 7px; background-color:<%= $label_colour %>; color:<%= $label_ink %>;"><%= $appts->{$a}->{'formatted_name'} %></span>
					</div>
				</span>
			<% } %>

			<%== $header || $appts->{$a}->{'header'}  %>
			<div class="budget_current_information" app="<%= $a %>" circumstance="<%= $appts->{$a}->{'setting'}->{'ci'} %>" style="border:solid;border-radius:5px;border-width:3px;width:100%;display:none;">

			</div>
			<span class="walkman_controls">
				<video class="video_monitor" style="display:none;"></video>					
				<% foreach my $p ( @{$pseudonyms} ) { %>
					<% if ($p->{'classmates'}) { %>
						<% if ($p->{'place'} eq 'top') { %>
							<%# the transport row has no plate of its own; a list built before
							    that change is still cached (keyed by icon set) with the old
							    yellow, so drop that one legacy value here rather than showing
							    white glyphs on yellow until the cache is rebuilt %>
							<% my $plate = $p->{'colour'} || ''; %>
							<% $plate = '' if lc($plate) eq '#ffec1f'; %>
							<img class="<%= $p->{'classmates'} %>"<% if (length $plate) { %> style="background-color:<%= $plate %>;"<% } %> onClick="<%= $p->{'click'} %>" name="<%= $p->{'name'} %>" hint="<%= &subs::format_name($p->{'name'}) %>" type="<%= $p->{'name'} %>" app="<%= $a %>" timestamp="<%= $appts->{$a}->{'timestamp'} %>" src="<%= $p->{'icon'} %>"
							>
						<% } %>

					<% } %>

				<% } %>

			</span><br>
			<%# the appointment's own controls, on the row right under the record /
			    play / stop / note buttons above %>
			<img app="<%= $a %>" class="app_act measures little_thumb" src="<%= &subs::icon_path('measures', '/images/decipherable/measures.png') %>" hint="Measures" />
			<img app="<%= $a %>" class="app_act tasks little_thumb" src="<%= &subs::icon_path('checkmark', '/images/decipherable/checkmark.png') %>" hint="Tasks" />
			<img app="<%= $a %>" class="app_act little_thumb reset" src="<%= &subs::icon_path('cash', '/images/decipherable/cash.png') %>" hint="<%= &subs::ui('Transaction') %>" />
			<img app="<%= $a %>" class="app_act little_thumb appointment_configuration_grabber" src="<%= &subs::icon_path('gear', '/images/decipherable/gear.png') %>" hint="Configure" />
			<img app="<%= $a %>" class="app_act little_thumb inventory" src="<%= &subs::icon_path('spreadsheet', '/images/decipherable/spreadsheet.png') %>" hint="Inventory" />
			<img app="<%= $a %>" class="app_act det little_thumb" src="<%= &subs::icon_path('list', '/images/decipherable/list.png') %>" hint="Details" />
			<img app="<%= $a %>" class="app_act little_thumb register" src="<%= &subs::icon_path('register', '/images/decipherable/register.png') %>" hint="Register" />
			<br>
			<%# the appointment's own action buttons, tucked behind Media / Extra /
			    Connect so the row under the record/play/stop/note buttons stays short %>
			<% if ($from ne 'store') { %>
				<% my $remote_machines = &subs::db_query('select device from remote_machines where connection = ?', 'active')->hashes; %>
				<span class="group_toggles" app="<%= $a %>">
					<img class="little_thumb group_toggle" group="media" hint="Media" src="<%= &subs::icon_path('media', '/images/make believe/camera.png') %>" app="<%= $a %>">
					<img class="little_thumb group_toggle" group="extra" hint="Extra" src="<%= &subs::icon_path('extra', '/images/make believe/burger.png') %>" app="<%= $a %>">
					<img class="little_thumb group_toggle" group="connect" hint="Connect" src="<%= &subs::icon_path('connect', '/images/make believe/web_button.png') %>" app="<%= $a %>">
				</span><br>
				<div class="group_contents media_group_contents" app="<%= $a %>" style="display:none;">
					<span class="media_row">
						<% foreach my $p ( @{$pseudonyms} ) { %>
							<% if ($p->{'classmates'} && ($p->{'group'} || '') eq 'media') { %>
								<img class="<%= $p->{'classmates'} %>" style="background-color:<%= $p->{'colour'} %>;" onClick="<%= $p->{'click'} %>" name="<%= $p->{'name'} %>" hint="<%= &subs::format_name($p->{'name'}) %>" type="<%= $p->{'name'} %>" <% if ($p->{'name'} =~ /^(?:video|audio|screen)$/) { %>media_group="record" <% } %>app="<%= $a %>" timestamp="<%= $appts->{$a}->{'timestamp'} %>" src="<%= $p->{'icon'} %>" />
							<% } %>
						<% } %>
						<%# video / audio / screen: which machine records (it runs jp there) %>
						<select class="media_machine" group="record" app="<%= $a %>" hint="<%= &subs::ui('Which machine records this') %>">
							<option value="" <% if (!length($media_default{'record'})) { %>selected<% } %>><%= &subs::lang('network.this_machine') %></option>
							<% foreach my $rm ( @media_machines ) { next unless ($rm->{'device'} || '') =~ /^(?:mobile|computer)$/; %>
								<option value="<%= $rm->{'uuid'} %>" data-signatorial="<%= $rm->{'signatorial'} %>" <% if ($media_default{'record'} eq $rm->{'uuid'}) { %>selected<% } %>><%= $rm->{'hostname'} || $rm->{'fqdn'} || $rm->{'ip'} %></option>
							<% } %>
						</select>
					</span>
					<span class="media_row">
						<% if ($device eq 'mobile' || grep { $_->{'device'} eq 'mobile' } @{$remote_machines} ) { %>
							<img class="little_thumb save_appointment row_gap" camera="0" type="camera" media_group="camera" app="<%= $a %>" src="<%= &subs::icon_path('camera_back', '/images/decipherable/camera back.png') %>" hint="Camera (rear)">
							<img class="little_thumb save_appointment" camera="1" type="camera" media_group="camera" app="<%= $a %>" src="<%= &subs::icon_path('camera_front', '/images/decipherable/camera front.png') %>" hint="Camera (front)">
							<select class="media_machine" group="camera" app="<%= $a %>" hint="<%= &subs::ui('Where the picture is taken') %>">
								<option value="" <% if (!length($media_default{'camera'})) { %>selected<% } %>><%= &subs::lang('network.this_machine') %></option>
								<% foreach my $rm ( grep { ($_->{'device'} || '') eq 'mobile' } @media_machines ) { %>
									<option value="<%= $rm->{'uuid'} %>" data-signatorial="<%= $rm->{'signatorial'} %>" <% if ($media_default{'camera'} eq $rm->{'uuid'}) { %>selected<% } %>><%= $rm->{'hostname'} || $rm->{'fqdn'} || $rm->{'ip'} %></option>
								<% } %>
							</select>
						<% } %>
						<%# the app's own camera: opens the OS camera or the OS video recorder
						    (window.JawnCamera) - a viewfinder you can see, and the camera's own
						    processing. Shown only in the app (the rules at the foot of this
						    template key off the html.jawn-app class manager.js sets). %>
						<img class="little_thumb native_capture" capture="0" type="camera" app="<%= $a %>" src="<%= &subs::icon_path('camera_back', '/images/decipherable/camera back.png') %>" hint="Camera (native)">
						<img class="little_thumb native_video" type="video" app="<%= $a %>" src="<%= &subs::icon_path('media', '/images/make believe/camera.png') %>" hint="Video (native)">
					</span>
					<% if ($device eq 'computer' || $device eq 'server' || grep { $_->{'device'} eq 'computer' || $_->{'device'} eq 'server' } @{$remote_machines} ) { %>
					<span class="media_row">
						<img class="little_thumb save_appointment row_gap" type="scan" feed="flatbed" media_group="scan" app="<%= $a %>" src="<%= &subs::icon_path('flatbed', '/images/decipherable/flatbed.png') %>" hint="Scan (flatbed)">
						<img class="little_thumb save_appointment" type="scan" feed="adf" media_group="scan" app="<%= $a %>" src="<%= &subs::icon_path('feeder', '/images/decipherable/feeder.png') %>" hint="Scan (feeder)">
						<img class="little_thumb save_appointment" camera="webcam" type="camera" media_group="scan" app="<%= $a %>" src="<%= &subs::icon_path('eye', '/images/make believe/eye.png') %>" hint="Webcam">
						<select class="media_machine" group="scan" app="<%= $a %>" hint="<%= &subs::ui('Which machine scans') %>">
							<option value="" <% if (!length($media_default{'scan'})) { %>selected<% } %>><%= &subs::lang('network.this_machine') %></option>
							<% foreach my $rm ( grep { ($_->{'device'} || '') eq 'computer' } @media_machines ) { %>
								<option value="<%= $rm->{'uuid'} %>" data-signatorial="<%= $rm->{'signatorial'} %>" <% if ($media_default{'scan'} eq $rm->{'uuid'}) { %>selected<% } %>><%= $rm->{'hostname'} || $rm->{'fqdn'} || $rm->{'ip'} %></option>
							<% } %>
						</select>
					</span>
					<% } %>
				</div>
				<div class="group_contents extra_group_contents" app="<%= $a %>" style="display:none;">
					<% foreach my $p ( @{$pseudonyms} ) { %>
						<% if ($p->{'classmates'} && ($p->{'group'} || '') eq 'extra') { %>
							<img class="<%= $p->{'classmates'} %>" style="background-color:<%= $p->{'colour'} %>;" onClick="<%= $p->{'click'} %>" name="<%= $p->{'name'} %>" hint="<%= &subs::format_name($p->{'name'}) %>" type="<%= $p->{'name'} %>" app="<%= $a %>" timestamp="<%= $appts->{$a}->{'timestamp'} %>" src="<%= $p->{'icon'} %>" />
						<% } %>
					<% } %>
					<% if ($appts->{$a}->{'setting'}->{'command'}) { %>
						<img app="<%= $a %>" type="command" class="little_thumb app_act save_appointment run_command shell" src="<%= &subs::icon_path('code', '/images/decipherable/code.png') %>" hint="Run command" />
					<% } %>
					<% if ($appts->{$a}->{'setting'}->{'kill'}) { %>
						<img app="<%= $a %>" type="kill" class="little_thumb app_act kill save_appointment shell" src="<%= &subs::icon_path('scraper', '/images/make believe/Scarapy.png') %>" hint="Kill" />
					<% } %>
				</div>
				<div class="group_contents connect_group_contents" app="<%= $a %>" style="display:none;">
					<img app="<%= $a %>" web="<%= $appts->{$a}->{'setting'}->{'wiki'} %>" class="little_thumb app_act web" src="<%= &subs::icon_path('wiki', '/images/make believe/wiki.png') %>" hint="Wiki" />
					<img app="<%= $a %>" type="web" web="<%= $appts->{$a}->{'setting'}->{'web'} %>" class="little_thumb web app_act" src="<%= &subs::icon_path('web_button', '/images/make believe/web_button.png') %>" hint="Web"
						style="<% if (!$appts->{$a}->{'setting'}->{'web'}) { %>display:none;<% } %>"/>
					<% foreach my $p ( @{$pseudonyms} ) { %>
						<% if ($p->{'classmates'} && ($p->{'group'} || '') eq 'connect') { %>
							<img class="<%= $p->{'classmates'} %>" style="background-color:<%= $p->{'colour'} %>;" onClick="<%= $p->{'click'} %>" name="<%= $p->{'name'} %>" hint="<%= &subs::format_name($p->{'name'}) %>" type="<%= $p->{'name'} %>" app="<%= $a %>" timestamp="<%= $appts->{$a}->{'timestamp'} %>" src="<%= $p->{'icon'} %>" />
						<% } %>
					<% } %>
					<% if ($appts->{$a}->{'setting'}->{'phone'} || $ticket_uuid_by_name{lc($a)}) { %>
						<%# Chat: the person the appointment belongs to is the conversation, and
						    it opens right in this window (see chat.js .chat_launcher) - the
						    ticket thread when one is open in their name, else their phone %>
						<img app="<%= $a %>" uuid="<%= $ticket_uuid_by_name{lc($a)} || '' %>" phone="<%= $appts->{$a}->{'setting'}->{'phone'} || '' %>" class="little_thumb app_act chat_launcher" src="<%= &subs::icon_path('phone_sms', '/images/make believe/phone_sms.png') %>" hint="Chat">
					<% } %>
				</div>
			<% } %>
			<div class="main_inputs_row" app="<%= $a %>">
				<span class="main_input_field">
					<input type="text" class="ago main_input" app="<%= $a %>" text="ago" placeholder="<%= &subs::ui('Ago') %>" />
					<span class="main_input_preview ago_preview" app="<%= $a %>"></span>
				</span>
				<span class="main_input_field">
					<input type="text" class="duration main_input" app="<%= $a %>" text="duration" placeholder="<%= &subs::ui('Duration') %>" />
					<span class="main_input_preview duration_preview" app="<%= $a %>"></span>
				</span>
				<span class="main_input_field">
					<input type="text" class="quantity main_input" app="<%= $a %>" text="quantity" placeholder="<%= &subs::ui('Quantity') %>">
					<span class="main_input_preview quantity_preview" app="<%= $a %>"></span>
				</span>
			</div>
			<div class="main_inputs_row" app="<%= $a %>">
				<span class="main_input_field">
					<input type="text" class="schedule main_input" app="<%= $a %>" text="schedule" placeholder="<%= &subs::ui('Schedule') %>" hint="Repeat in an interval or plain words: 1d for -2w is every day for two weeks; every third Saturday, the next 5 full moons." />
					<span class="main_input_preview schedule_preview" app="<%= $a %>"></span>
				</span>
				<span class="main_input_field">
					<input type="text" class="warranty main_input" app="<%= $a %>" text="warranty" placeholder="<%= &subs::ui('Warranty') %>" />
					<span class="main_input_preview warranty_preview" app="<%= $a %>"></span>
				</span>
			</div>
			<textarea class="timed_input notes" rows="1" app="<%= $a %>" text="notes" placeholder="<%= &subs::ui('Note') %>" upgradeable="yes" magic_vars="appointment:<%= $a %>"></textarea>
			<br>
			<div class="re_measures" app="<%= $a %>" style="display:none;vertical-align:top;width:100%">
				<%# fetched by appSectionGrabber() the first time the measures are opened %>
				<span class="app_section_placeholder" app="<%= $a %>" section="measures"></span>
			</div>


			<% my $template = $gb::pos->{$appts->{$a}->{'setting'}->{'pos'}}->{'app_template'}; %>
			<% if ($template) { %>
				<%= include $template, appts => $appts, a => $a %>
			<% } else { %>
			<% } %>
			<span class="re_tasks" app="<%= $a %>" style="display:none;width:100%;"></span>
			<span class="re_register" app="<%= $a %>" style="display:none;width:100%;">
			</span>
			<span class="re_details" app="<%= $a %>" style="display:none;">
				<div class="detail_area" app="<%= $a %>" style="overflow:scroll;">
					<span style="display:none;" class="detail_json" app="<%= $a %>">{}</span>
				</div>
			</span>
			<span class="inventory_details" style="display:none;">
				<b>Loading Inventory Details...</b><br>
			</span>
			<%# the details form is 11 KB of a 42 KB window and hidden until a person
			    asks for it: appSectionGrabber() fetches it on the first open %>
			<span class="app_section_placeholder" app="<%= $a %>" section="details"></span>
			<div app="<%= $a %>" style="display:none;" class="appointment_details"></div>
			<span class="media_out vid"></span>
			<span class="media_out snd" style="width:100%;"><audio autoplay="true" controls style="width:100%;display:none;" id="<%= $a %>_snd"></audio></span>
			<span class="media_out scr"><video autoplay="true" controls id="<%= $a %>_scr" style="display:none;"></video></span>
			<% if ($from ne 'store') { %>
				<canvas id="visualizer_<%= $a %>" class="visualizer" app="<%= $a %>" style="display:none;"></canvas>
				<span class="enablers">
					<img class="public_button little_thumb enabler" type="public" app="<%= $a %>" off_colour="black" on_colour="green" 
						<% if ( $appts->{$a}->{'setting'}->{'public'} eq 'on' ) { %>status="on" style="background-color:green"<% } else { %>
							status="off" style="background-color:black;" <% } %>
						src="<%= &subs::icon_path('public', '/icons/public.png') %>" hint="Public"
					/>
					<img class="enc_button little_thumb enabler" type="enc" app="<%= $a %>" off_colour="black" on_colour="red" 
						<% if ( $appts->{$a}->{'setting'}->{'enc'} eq 'on' ) { %>status="on" style="background-color:red"<% } else { %>
							status="off" style="background-color:black;" <% } %>
						src="<%= &subs::icon_path('enc_button', '/icons/enc_button.png') %>" hint="Encrypt"
					/>
					<img app="<%= $a %>" class="app_act little_thumb enabler" type="notification" dim="yes" off_colour="#555555" on_colour="green" 
						<% if ( $appts->{$a}->{'setting'}->{'notification'} eq 'on' ) { %>status="on" style="background-color:green;border-color:green;box-shadow:0 0 8px 2px green;"<% } else { %>
							status="off" style="background-color:#555555;border-color:#555555;opacity:0.45;filter:grayscale(1);" <% } %>
						 src="<%= &subs::icon_path('bell', '/images/decipherable/bell.png') %>" hint="Notifications" />

					<img app="<%= $a %>" class="app_act little_thumb enabler toggle" type="toggle" dim="yes" off_colour="#555555" on_colour="green" 
						<% if ( $appts->{$a}->{'setting'}->{'toggle'} eq 'on' ) { %>src="<%= &subs::icon_path('on', '/images/decipherable/on.png') %>" hint="Toggle" status="on" style="background-color:green;border-color:green;box-shadow:0 0 8px 2px green;"<% } else { %>
							src="<%= &subs::icon_path('off', '/images/decipherable/off.png') %>" hint="Toggle" status="off" style="background-color:#555555;border-color:#555555;opacity:0.45;filter:grayscale(1);" <% } %> />
					<img src="<%= &subs::icon_path('burger', '/images/make believe/burger.png') %>" hint="Lock" class="little_thumb appointment_locking_mechanism">
				</span><br>
			<% } %>

			<% if ($from ne 'store') { %>
			<%# the appointment's bottom line: the evaluation it last left, and the
			    shelf and the day/week/month/year readings behind the other headers.
			    The headers are one row; only the chosen panel is open, the
			    evaluation is drawn with the window, and the rest are fetched the
			    first time a header asks for one %>
			<% my $app_evaluation = &subs::evaluation_report_for($a); %>
			<div class="appointment_stats" app="<%= $a %>">
				<div class="appointment_stats_headers" role="tablist">
					<button type="button" class="appointment_stats_header selected" stat="evaluation" role="tab" aria-selected="true"><%= &subs::ui('Evaluation') %></button>
					<button type="button" class="appointment_stats_header" stat="inv" role="tab" aria-selected="false"><%= &subs::ui('Inv') %></button>
					<button type="button" class="appointment_stats_header" stat="time" role="tab" aria-selected="false"><%= &subs::ui('Time') %></button>
					<button type="button" class="appointment_stats_header" stat="count" role="tab" aria-selected="false"><%= &subs::ui('Count') %></button>
					<button type="button" class="appointment_stats_header" stat="money" role="tab" aria-selected="false">$</button>
					<button type="button" class="appointment_stats_header" stat="meas" role="tab" aria-selected="false"><%= &subs::ui('Meas') %></button>
				</div>
				<div class="appointment_stats_panel appointment_evaluation_zone" stat="evaluation">
					<%= include 'apps/evaluation', evaluation => $app_evaluation, app => $a, controls => 1 %>
				</div>
				<div class="app_section_placeholder" app="<%= $a %>" section="stats"></div>
			</div>
			<% } %>
		</div>
	<% } %>
</span>
<style>
	/* The wrapper is the window's whole content. Without a flex basis it kept its
	   content width and sat against the left edge, leaving the rest of a widened
	   window empty. It now takes the room and scrolls inside it. */
	.appointment_contents {
		display: block;
		flex: 1 1 auto;
		width: 100%;
		min-width: 0;
		height: 100%;
		box-sizing: border-box;
	}
	/* the app's own camera buttons (window.JawnCamera) show only inside the app:
	   manager.js puts jawn-app on <html> when the bridge answers, so a browser
	   (public view, web) never sees them */
	.native_capture, .native_video { display: none; }
	html.jawn-app .native_capture, html.jawn-app .native_video { display: inline-block; }
	/* The media group is three short rows (record / camera / scan); each row keeps
	   its buttons and its machine picker together and wraps on a narrow window. */
	.media_group_contents { display: flex; flex-direction: column; align-items: stretch; gap: 6px; }
	.media_group_contents .media_row { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; width: 100%; }
	.media_group_contents .media_row > * { flex: 0 0 auto; }
	.media_group_contents .media_machine { max-width: 100%; min-height: 0; height: 30px; padding: 2px 7px;
		border: 1px solid var(--line); border-radius: 6px; background: var(--panel);
		color: var(--ink); font: inherit; font-size: 13px; }
	/* The bottom line's headers share one row: six equal columns that never wrap,
	   each keeping its own word (the panel below is the room for detail). */
	.appointment_stats { margin-top: 6px; width: 100%; text-align: left; }
	.appointment_stats_headers { display: flex; flex-wrap: nowrap; gap: 2px; width: 100%; }
	.appointment_stats_header { flex: 1 1 0; min-width: 0; padding: 2px 1px; font: inherit; font-size: 11px;
		line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; cursor: var(--jawnos-cursor-pointer, pointer);
		border: 1px solid var(--line); border-radius: 6px; background: var(--panel-2, #ffffff); color: var(--ink); }
	.appointment_stats_header.selected { background-color: var(--line); font-weight: bold; }
	.appointment_stats_panel { margin-top: 3px; width: 100%; box-sizing: border-box; }
	.appointment_stats_table { width: 100%; border-collapse: collapse; font-size: 90%; }
	.appointment_stats_table th, .appointment_stats_table td { padding: 1px 3px; text-align: right; }
	.appointment_stats_table th:first-child, .appointment_stats_table td:first-child { text-align: left; }
	.appointment_stats_table th { font-weight: normal; opacity: .7; }
	.appointment_stats_calc { font-size: 85%; opacity: .6; }
	.appointment_stats_empty { font-style: italic; opacity: .6; }
	/* The readings are fetched on the first press: the placeholder says so while
	   it waits, in the person's own language, and the answer replaces the words. */
	.app_section_placeholder[section="stats"][loading="yes"]::before {
		content: attr(data-loading-text);
		display: block;
		padding: 2px 3px;
		font-style: italic;
		opacity: .65;
	}
</style>
