<%# The Synth surface's styles. Scoped under #synth so the Studio panel inherits
   exactly the standalone window's look without leaking into other Studio UI. %>
<style>
	#synth { padding: 8px; max-width: 100%; box-sizing: border-box; }
	#synth .synth_toolbar {
		display: flex;
		align-items: center;
		gap: 8px;
		flex-wrap: wrap;
		margin-bottom: 8px;
	}
	#synth .synth_toolbar label { opacity: .7; }
	#synth .synth_select {
		font-size: 15px;
		border: solid 1px var(--line);
		border-radius: 5px;
		background: var(--panel);
		color: inherit;
		padding: 3px 5px;
	}
	#synth .synth_midi_connect {
		font-size: 14px;
		border: solid 1px var(--line);
		border-radius: 5px;
		background: var(--panel);
		color: inherit;
		padding: 3px 8px;
		cursor: var(--jawnos-cursor-pointer, pointer);
	}
	#synth .synth_voices { opacity: .55; margin-left: auto; font-size: 13px; }

	#synth .synth_keys {
		position: relative;
		width: 100%;
		box-sizing: border-box;
		height: 124px;
		overflow-x: auto;
		overflow-y: hidden;
		padding-bottom: 4px;
		border-radius: 4px;
	}
	#synth .synth_keys_inner {
		position: relative;
		height: 118px;
		white-space: nowrap;
	}
	#synth .piano_key {
		cursor: var(--jawnos-cursor-pointer, pointer);
		user-select: none;
		border: solid;
		border-width: 1px;
		box-sizing: border-box;
	}
	#synth .piano_key.white {
		display: inline-block;
		vertical-align: top;
		width: 26px;
		height: 118px;
		background: #fdfdfa;
		color: #666;
		font-size: 9px;
		text-align: center;
		padding-top: 100px;
		border-radius: 0 0 4px 4px;
		position: relative;
		z-index: 1;
	}
	#synth .piano_key.black {
		position: absolute;
		top: 0;
		width: 16px;
		height: 74px;
		background: #141414;
		border-color: #000;
		border-radius: 0 0 3px 3px;
		z-index: 2;
	}
	#synth .piano_key.white.piano_key_on { background: #ffd21e; }
	#synth .piano_key.black.piano_key_on { background: #b8860b; }

	#synth .synth_controls {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 10px;
	}
	#synth .synth_knob {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 74px;
	}
	#synth .synth_knob label { font-size: 12px; opacity: .7; margin-bottom: 2px; }
	#synth .synth_knob input[type=range] { width: 68px; }

	#synth .synth_hint { margin-top: 10px; opacity: .6; font-size: 13px; max-width: 640px; }

	#synth .synth_seq_toolbar { display: flex; align-items: center; gap: 8px; margin-top: 12px; flex-wrap: wrap; }
	#synth .synth_seq { margin-top: 6px; overflow-x: auto; padding-bottom: 4px; }
	#synth .synth_seq_row { display: flex; align-items: center; height: 16px; }
	#synth .synth_seq_label { width: 36px; font-size: 10px; opacity: .6; flex: none; }
	#synth .synth_seq_cell { width: 16px; height: 14px; margin-right: 2px; border: 1px solid var(--line); border-radius: 2px; background: var(--panel); flex: none; cursor: var(--jawnos-cursor-pointer, pointer); }
	#synth .synth_seq_cell.on { background: #4caf50; }
	#synth .synth_seq_cell.synth_seq_playing { outline: 2px solid #ffd21e; }
</style>
