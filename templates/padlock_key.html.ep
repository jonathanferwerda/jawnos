% title 'Unlock';
<div id="padlock_key_wrap">
	<div id="padlock_key_spinner"></div>
	<div id="padlock_key_note">
		<% if ($has_padlock) { %>
			Unlocking...
		<% } else { %>
			No padlock is set on this house.
		<% } %>
	</div>
	<button id="padlock_key_retry" type="button" style="display:none;">Try again</button>
</div>

<style>
	#padlock_key_wrap {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
	}
	#padlock_key_spinner {
		width: 64px;
		height: 64px;
		border: 6px solid rgba(255,255,255,0.15);
		border-top-color: #f4f4f4;
		border-radius: 50%;
		animation: padlock_key_turn 900ms linear infinite;
	}
	#padlock_key_spinner.done {
		animation: none;
		border-color: #6f6;
	}
	#padlock_key_note {
		margin-top: 24px;
		text-align: center;
		font-size: 19px;
		line-height: 1.35;
		padding: 0 18px;
	}
	#padlock_key_retry {
		margin-top: 22px;
		font-size: 17px;
		padding: 10px 18px;
		border-radius: 8px;
		border: 1px solid #666;
		background-color: #222;
		color: #f4f4f4;
	}
	@keyframes padlock_key_turn {
		to { transform: rotate(360deg); }
	}
</style>

<script>
	var padlockKeyMode = 'locker';
	try {
		var pk = (location.search || '').match(/[?&]mode=([^&]+)/);
		if (pk) {
			var pm = decodeURIComponent(pk[1]);
			if (/^(locker|gallery|music|folders|general)$/.test(pm)) { padlockKeyMode = pm; }
		}
	} catch (e) { }

	function padlockKeyB64(buf) {
		var bytes = new Uint8Array(buf);
		var s = '';
		for (var i = 0; i < bytes.length; i++) { s += String.fromCharCode(bytes[i]); }
		return btoa(s);
	}
	function padlockKeyIdbGet(key) {
		return new Promise(function (res, rej) {
			var r = indexedDB.open('jawn_device', 1);
			r.onupgradeneeded = function () { r.result.createObjectStore('keys'); };
			r.onsuccess = function () {
				var db = r.result;
				var tx = db.transaction('keys', 'readonly');
				var q = tx.objectStore('keys').get(key);
				q.onsuccess = function () { res(q.result); };
				q.onerror = function () { rej(q.error); };
			};
			r.onerror = function () { rej(r.error); };
		});
	}

	var padlockKeyDone = false;
	function padlockKeySay(text, done) {
		$('#padlock_key_note').text(text);
		if (done) {
			padlockKeyDone = true;
			$('#padlock_key_spinner').addClass('done');
			$('#padlock_key_retry').hide();
		}
	}
	function padlockKeyRetry() {
		if (padlockKeyDone) { return; }
		$('#padlock_key_retry').hide();
		padlockKeySay('Unlocking...', false);
		padlockKeyDeviceUnlock();
	}

	function padlockKeyDeviceUnlock() {
		if (padlockKeyDone) { return; }
		if (!(window.crypto && crypto.subtle && crypto.subtle.importKey)) {
			padlockKeySay('This browser cannot sign the unlock.', false);
			return;
		}
		var uuid = localStorage.getItem('device_uuid');
		if (!uuid) {
			padlockKeySay('This phone is not paired.', false);
			$('#padlock_key_retry').show();
			return;
		}
		padlockKeyIdbGet('device_key').then(function (key) {
			if (!key) {
				padlockKeySay('This phone is not paired.', false);
				$('#padlock_key_retry').show();
				return;
			}
			return fetch('/manager/security/padlock_challenge', {
				method: 'POST',
				headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
				body: new URLSearchParams({ device_uuid: uuid })
			}).then(function (r) { return r.json(); }).then(function (ch) {
				if (!ch || !ch.ok || !ch.nonce) {
					padlockKeySay('This phone is not paired.', false);
					$('#padlock_key_retry').show();
					return;
				}
				var msg = 'padlock-unlock\n' + uuid + '\n' + ch.nonce;
				return crypto.subtle.sign('Ed25519', key, new TextEncoder().encode(msg)).then(function (sig) {
					return fetch('/manager/security/padlock_unlock', {
						method: 'POST',
						headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
						body: new URLSearchParams({ device_uuid: uuid, nonce: ch.nonce, signature: padlockKeyB64(sig), mode: padlockKeyMode })
					});
				}).then(function (r) { return r.json(); }).then(function (res) {
					if (res && res.ok) {
						padlockKeySay('Unlocked.', true);
					}
					else {
						padlockKeySay('That key was not accepted.', false);
						$('#padlock_key_retry').show();
					}
				});
			});
		}).catch(function () {
			padlockKeySay('Could not reach the house.', false);
			$('#padlock_key_retry').show();
		});
	}

	$(function () {
		$('#padlock_key_retry').on('click', padlockKeyRetry);
		<% if ($has_padlock) { %>padlockKeyDeviceUnlock();<% } else { %>$('#padlock_key_spinner').addClass('done');<% } %>
	});
</script>
