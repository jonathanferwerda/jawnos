% title 'Unlock';
<div id="padlock_key_wrap">
	<div id="padlock_key_spinner" style="display:none;"></div>
	<div id="padlock_key_note">
		<% if ($has_padlock) { %>
			The screen is locked.
		<% } else { %>
			No padlock is set on this house.
		<% } %>
	</div>
	<div id="padlock_key_targets" style="display:none;"></div>
	<button id="padlock_key_unlock" type="button"<% unless ($has_padlock) { %> style="display:none;"<% } %>>Unlock</button>
	<button id="padlock_key_retry" type="button" style="display:none;">Try again</button>
</div>

<style>
	#padlock_key_wrap {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
	}
	#padlock_key_spinner {
		width: 64px;
		height: 64px;
		border: 6px solid rgba(255,255,255,0.15);
		border-top-color: #f4f4f4;
		border-radius: 50%;
		animation: padlock_key_turn 900ms linear infinite;
	}
	#padlock_key_spinner.done {
		animation: none;
		border-color: #6f6;
	}
	#padlock_key_note {
		margin-top: 24px;
		text-align: center;
		font-size: 19px;
		line-height: 1.35;
		padding: 0 18px;
	}
	#padlock_key_targets {
		margin-top: 18px;
		display: flex;
		flex-direction: column;
		gap: 10px;
		width: 80%;
		max-width: 320px;
	}
	#padlock_key_targets button,
	#padlock_key_unlock,
	#padlock_key_retry {
		font-size: 18px;
		padding: 12px 28px;
		border-radius: 10px;
		border: 1px solid #666;
		background-color: #222;
		color: #f4f4f4;
		cursor: pointer;
	}
	#padlock_key_targets button {
		width: 100%;
	}
	#padlock_key_unlock {
		margin-top: 22px;
		background-color: #2b6;
		border-color: #2b6;
		color: #08110a;
		font-weight: bold;
	}
	#padlock_key_retry {
		margin-top: 22px;
	}
	@keyframes padlock_key_turn {
		to { transform: rotate(360deg); }
	}
</style>

<script>
	var padlockKeyMode = 'locker';
	var padlockKeyTarget = '';
	// show=1 is an explicit ask (the locked screen's Send, or a late-join push),
	// so the page offers Unlock even when this machine has not pulled the lock
	// row yet - its state would otherwise say "no screen is locked".
	var padlockKeyForced = /[?&]show=1/.test(location.search);
	try {
		var pk = (location.search || '').match(/[?&]mode=([^&]+)/);
		if (pk) {
			var pm = decodeURIComponent(pk[1]);
			if (/^(locker|gallery|music|folders|general)$/.test(pm)) { padlockKeyMode = pm; }
		}
		var pt = (location.search || '').match(/[?&]target=([^&]+)/);
		if (pt) { padlockKeyTarget = decodeURIComponent(pt[1]); }
	} catch (e) { }

	function padlockKeyB64(buf) {
		var bytes = new Uint8Array(buf);
		var s = '';
		for (var i = 0; i < bytes.length; i++) { s += String.fromCharCode(bytes[i]); }
		return btoa(s);
	}
	function padlockKeyIdbGet(key) {
		return new Promise(function (res, rej) {
			var r = indexedDB.open('jawn_device', 1);
			r.onupgradeneeded = function () { r.result.createObjectStore('keys'); };
			r.onsuccess = function () {
				var db = r.result;
				var tx = db.transaction('keys', 'readonly');
				var q = tx.objectStore('keys').get(key);
				q.onsuccess = function () { res(q.result); };
				q.onerror = function () { rej(q.error); };
			};
			r.onerror = function () { rej(r.error); };
		});
	}

	// The page opens when a screen locks, but it does not sign by itself: the
	// person presses Unlock when they are ready. A target names one screen; no
	// target is the house-wide timeout lock.
	var padlockKeyBusy = false;
	var padlockKeyDone = false;

	function padlockKeySay(text, done) {
		$('#padlock_key_note').text(text);
		if (done) {
			padlockKeyDone = true;
			padlockKeyBusy = false;
			$('#padlock_key_spinner').addClass('done');
			$('#padlock_key_unlock, #padlock_key_retry, #padlock_key_targets').hide();
		}
	}
	function padlockKeyFail(text) {
		padlockKeyBusy = false;
		$('#padlock_key_spinner').hide();
		padlockKeySay(text, false);
		$('#padlock_key_retry').show();
	}
	function padlockKeyStart(target) {
		if (padlockKeyBusy || padlockKeyDone) { return; }
		if (typeof target === 'string') { padlockKeyTarget = target; }
		padlockKeyBusy = true;
		$('#padlock_key_unlock, #padlock_key_retry, #padlock_key_targets').hide();
		$('#padlock_key_spinner').show().removeClass('done');
		var native = padlockKeyNativeBio();
		var bio = native || padlockKeyBioUsable();
		padlockKeySay(bio ? 'Confirm with your fingerprint...' : 'Unlocking...', false);
		(native || padlockKeyBioConfirm()).then(function (ok) {
			if (!ok) { padlockKeyFail('Unlock cancelled.'); return; }
			padlockKeySay('Unlocking...', false);
			padlockKeyDeviceUnlock();
		});
	}
	function padlockKeyTargets(targets) {
		var box = $('#padlock_key_targets').empty();
		$.each(targets || [], function (i, t) {
			$('<button type="button"></button>').text(t.name || 'Locked screen')
				.on('click', function () { padlockKeyStart(t.uuid || ''); }).appendTo(box);
		});
		if (box.children().length) {
			$('#padlock_key_unlock').hide();
			box.show();
		}
	}
	function padlockKeyLook() {
		if (padlockKeyBusy || padlockKeyDone || padlockKeyTarget) { return; }
		if (padlockKeyForced) {
			$('#padlock_key_note').text('The screen is locked.');
			$('#padlock_key_unlock').show();
			$('#padlock_key_targets').hide();
			return;
		}
		$.getJSON('/manager/security/padlock_state', { device_uuid: localStorage.getItem('device_uuid') || '' }, function (s) {
			if (!s || !s.ok) { return; }
			// s.locked is this screen's own answer: false when this device has
			// its own open stamp, even while the rest of the house is locked.
			// Checking global_locked first left an already-open phone on a page
			// that said the whole house was locked and hid Unlock.
			if (!s.locked) {
				$('#padlock_key_note').text('No screen is locked.');
				$('#padlock_key_unlock').hide();
				$('#padlock_key_targets').hide();
				return;
			}
			if (s.targets && s.targets.length > 1) {
				$('#padlock_key_note').text('Which screen do you want to unlock?');
				padlockKeyTargets(s.targets);
				return;
			}
			if (s.targets && s.targets.length == 1) {
				padlockKeyTarget = s.targets[0].uuid || '';
				$('#padlock_key_note').text('The screen is locked.');
				$('#padlock_key_unlock').show();
				$('#padlock_key_targets').hide();
				return;
			}
			if (s.device) {
				padlockKeyTarget = s.device;
				$('#padlock_key_note').text('This screen is locked.');
				$('#padlock_key_unlock').show();
				$('#padlock_key_targets').hide();
				return;
			}
			$('#padlock_key_note').text('The whole house is locked. Open the screen you are at and press Send the unlock page to my phone.');
			$('#padlock_key_unlock').hide();
			$('#padlock_key_targets').hide();
		});
	}

	// A local biometric confirmation. The phone's key still signs the nonce on
	// the server; this only makes the phone ask for the person before it does.
	// Over an IP address WebAuthn has no RP ID, so the tap is the confirmation.
	function padlockKeyNativeBio() {
		if (!window.JawnBiometric || typeof window.JawnBiometric.confirm !== 'function') { return null; }
		return new Promise(function (resolve) {
			window.jawnBiometricResult = function (ok) {
				window.jawnBiometricResult = null;
				resolve(ok === 'unavailable' ? true : !!ok);
			};
			try { window.JawnBiometric.confirm('Unlock the house'); }
			catch (e) { window.jawnBiometricResult = null; resolve(true); }
		});
	}
	function padlockKeyBioUsable() {
		var h = location.hostname || '';
		return !!(window.PublicKeyCredential && navigator.credentials && window.isSecureContext && !/^\d{1,3}(\.\d{1,3}){3}$/.test(h));
	}
	function padlockKeyBioId() { return localStorage.getItem('jawn_padlock_cred') || ''; }
	function padlockKeyRandom(n) {
		var a = new Uint8Array(n);
		crypto.getRandomValues(a);
		return a;
	}
	function padlockKeyBufFromB64(b64) {
		var s = atob(b64);
		var a = new Uint8Array(s.length);
		for (var i = 0; i < s.length; i++) { a[i] = s.charCodeAt(i); }
		return a;
	}
	function padlockKeyBioEnroll() {
		return navigator.credentials.create({ publicKey: {
			challenge: padlockKeyRandom(32),
			rp: { name: 'JawnOS', id: location.hostname },
			user: { id: padlockKeyRandom(16), name: 'jawnos-unlock', displayName: 'JawnOS unlock' },
			pubKeyCredParams: [{ type: 'public-key', alg: -7 }, { type: 'public-key', alg: -257 }],
			authenticatorSelection: { authenticatorAttachment: 'platform', userVerification: 'required', residentKey: 'discouraged' },
			timeout: 60000,
			attestation: 'none'
		} }).then(function (cred) {
			if (!cred || !cred.rawId) { return true; }
			localStorage.setItem('jawn_padlock_cred', padlockKeyB64(cred.rawId));
			return true;
		}).catch(function (e) {
			if (e && (e.name === 'NotAllowedError' || e.name === 'AbortError')) { return false; }
			return true;
		});
	}
	function padlockKeyBioConfirm() {
		if (!padlockKeyBioUsable()) { return Promise.resolve(true); }
		var id = padlockKeyBioId();
		if (!id) { return padlockKeyBioEnroll(); }
		return navigator.credentials.get({ publicKey: {
			challenge: padlockKeyRandom(32),
			allowCredentials: [{ type: 'public-key', id: padlockKeyBufFromB64(id) }],
			userVerification: 'required',
			timeout: 60000
		} }).then(function (a) { return !!a; }).catch(function (e) {
			if (e && (e.name === 'NotAllowedError' || e.name === 'AbortError')) { return false; }
			return true;
		});
	}

	function padlockKeyDeviceUnlock() {
		if (!(window.crypto && crypto.subtle && crypto.subtle.importKey)) {
			padlockKeyFail('This browser cannot sign the unlock.');
			return;
		}
		var uuid = localStorage.getItem('device_uuid');
		if (!uuid) {
			padlockKeyFail('This phone is not paired.');
			return;
		}
		padlockKeyIdbGet('device_key').then(function (key) {
			if (!key) {
				padlockKeyFail('This phone is not paired.');
				return;
			}
			return fetch('/manager/security/padlock_challenge', {
				method: 'POST',
				headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
				body: new URLSearchParams({ device_uuid: uuid })
			}).then(function (r) { return r.json(); }).then(function (ch) {
				if (!ch || !ch.ok || !ch.nonce) {
					padlockKeyFail('This phone is not paired.');
					return;
				}
				var msg = 'padlock-unlock\n' + uuid + '\n';
				if (padlockKeyTarget) { msg += padlockKeyTarget + '\n'; }
				msg += ch.nonce;
				return crypto.subtle.sign('Ed25519', key, new TextEncoder().encode(msg)).then(function (sig) {
					var body = new URLSearchParams({ device_uuid: uuid, nonce: ch.nonce, signature: padlockKeyB64(sig), mode: padlockKeyMode });
					if (padlockKeyTarget) { body.set('target', padlockKeyTarget); }
					return fetch('/manager/security/padlock_unlock', {
						method: 'POST',
						headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
						body: body
					});
				}).then(function (r) { return r.json(); }).then(function (res) {
					if (res && res.ok) {
						padlockKeySay(res.already ? 'That screen was already open.' : 'Unlocked.', true);
						// the unlock page was a detour: the phone opened it to sign the
						// screen open, so return to the manager instead of sitting here.
						// If this phone is still locked the gate shows its locked page.
						setTimeout(function () { window.location.replace('/manager'); }, 900);
					}
					else if (res && res.error === 'local') {
						padlockKeyFail('Open this page on your phone, not on the locked computer.');
					}
					else {
						padlockKeyFail('That key was not accepted.');
					}
				});
			});
		}).catch(function () {
			padlockKeyFail('Could not reach the house.');
		});
	}

	$(function () {
		$('#padlock_key_unlock').on('click', function () { padlockKeyStart(); });
		$('#padlock_key_retry').on('click', function () { padlockKeyStart(); });
		<% if ($has_padlock) { %>padlockKeyLook(); setInterval(padlockKeyLook, 3000);<% } %>
	});
</script>
