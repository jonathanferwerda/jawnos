% title 'Locked';
<style>
	html, body {
		width: 100%;
		height: 100%;
		margin: 0;
		padding: 0;
		background-color: #101010;
		color: #f4f4f4;
		font-family: sans-serif;
		overflow: hidden;
	}
	#locked_heading {
		position: fixed;
		top: 2%;
		left: 0;
		right: 0;
		text-align: center;
		font-size: 20px;
		z-index: 60002;
	}
	#locked_help {
		position: fixed;
		bottom: 1%;
		left: 0;
		right: 0;
		text-align: center;
		font-size: 15px;
		line-height: 1.35;
		padding: 0 8px;
		z-index: 60002;
	}
	#locked_send_phone,
	#locked_fingerprint {
		margin-top: 6px;
		font-size: 15px;
		padding: 6px 12px;
		border-radius: 8px;
		border: 1px solid #666;
		background-color: #222;
		color: #f4f4f4;
	}
	#locked_fingerprint {
		background-color: #2b6;
		border-color: #2b6;
		color: #08110a;
		font-weight: bold;
	}
	#locked_phone_status {
		margin-top: 4px;
		color: #ffd;
	}
	#locked_padlock {
		position: fixed;
		left: 50%;
		top: 50%;
		transform: translate(-50%, -50%);
		width: 300px;
	}
	#locked_padlock .padlock_frame {
		position: relative;
		left: auto;
		top: auto;
		transform: none;
		width: 100%;
	}
	#locked_recovery {
		position: fixed;
		right: 1%;
		top: 1%;
		width: 290px;
		z-index: 60003;
		background-color: rgba(28, 28, 34, 0.95);
		border-radius: 8px;
		padding: 10px;
		font-size: 14px;
	}
	#locked_recovery input {
		width: 100%;
		font-size: 16px;
		padding: 6px;
		box-sizing: border-box;
	}
	#locked_recovery button {
		font-size: 16px;
		padding: 6px 12px;
		margin-top: 6px;
	}
	#locked_status {
		margin-top: 6px;
		color: #ffd;
	}
</style>

<% my $target = defined $target ? $target : ''; %>
<div id="locked_heading"><%= $target ? 'This screen is locked.' : 'The house is locked.' %></div>

<div id="locked_padlock">
	<%= include 'padlock', mode => 'locker', target => $target, phone_button => 0, fingerprint_button => 0 %>
</div>

<div id="locked_help">
	Unlock on your phone, or use the recovery code.
	<button id="locked_send_phone" type="button">Send the unlock page to my phone</button>
	<% if ($fingerprint) { %>
		<button id="locked_fingerprint" type="button">Use this computer's fingerprint</button>
	<% } %>
	<div id="locked_phone_status"></div>
</div>

<details id="locked_recovery">
	<summary>Recovery code</summary>
	<input id="locked_recovery_code" autocomplete="off" spellcheck="false" placeholder="paper code">
	<button id="locked_recovery_go">Unlock</button>
	<div id="locked_status"></div>
</details>

<script>
(function () {
	function b64(buf) {
		var bytes = new Uint8Array(buf);
		var s = '';
		for (var i = 0; i < bytes.length; i++) { s += String.fromCharCode(bytes[i]); }
		return btoa(s);
	}
	function status(text) {
		var el = document.getElementById('locked_status');
		if (el) { el.textContent = text || ''; }
	}
	var go = document.getElementById('locked_recovery_go');
	if (go) {
		go.addEventListener('click', function () {
			var code = (document.getElementById('locked_recovery_code').value || '').trim();
			if (!code) { status('Type the code first.'); return; }
			if (!(window.crypto && crypto.subtle && crypto.subtle.generateKey)) {
				status('This browser cannot hold a device key.');
				return;
			}
			status('Checking...');
			crypto.subtle.generateKey({ name: 'Ed25519' }, false, ['sign', 'verify']).then(function (pair) {
				return crypto.subtle.exportKey('spki', pair.publicKey).then(function (spki) {
					var body = new URLSearchParams({ code: code, pubkey: b64(spki), name: 'Recovered Device' });
					return fetch('/manager/device/recover', {
						method: 'POST',
						headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
						body: body
					});
				}).then(function (r) { return r.json(); }).then(function (res) {
					if (res && res.ok) {
						status('Unlocked. Loading...');
						window.location.reload();
					}
					else {
						status(res && res.error === 'too many' ? 'Too many tries. Wait a while.' : 'That code was not accepted.');
					}
				});
			}).catch(function () { status('That code was not accepted.'); });
		});
	}
	var sendPhone = document.getElementById('locked_send_phone');
	var lockedTarget = '<%= $target %>';
	if (sendPhone) {
		sendPhone.addEventListener('click', function () {
			var note = document.getElementById('locked_phone_status');
			if (typeof padlockAskPhone === 'function') { padlockAskPhone('locker', lockedTarget); }
			if (note) { note.textContent = 'Sent. Open the unlock page on your phone.'; }
		});
	}
	var fp = document.getElementById('locked_fingerprint');
	if (fp) {
		fp.addEventListener('click', function () {
			var note = document.getElementById('locked_phone_status');
			fp.disabled = true;
			if (note) { note.textContent = 'Touch the fingerprint reader...'; }
			fetch('/manager/security/fingerprint_unlock', {
				method: 'POST',
				headers: { 'X-Requested-With': 'XMLHttpRequest' }
			}).then(function (r) { return r.json(); }).then(function (res) {
				if (res && res.ok) {
					if (note) { note.textContent = 'Unlocked. Loading...'; }
					window.location.reload();
					return;
				}
				fp.disabled = false;
				if (note) {
					note.textContent = (res && res.error === 'busy') ? 'A fingerprint is already being read.' : 'Fingerprint not accepted.';
				}
			}).catch(function () {
				fp.disabled = false;
				if (note) { note.textContent = 'Fingerprint not available.'; }
			});
		});
	}
	// the phone signs this machine open in the background; this page follows
	setInterval(function () {
		fetch('/manager/security/padlock_state', { cache: 'no-store' }).then(function (r) {
			return r.json();
		}).then(function (s) {
			if (s && s.ok && !s.locked) { window.location.reload(); }
		}).catch(function () {});
	}, 2500);
})();
</script>
