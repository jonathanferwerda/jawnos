<div id="security" device_uuid="<%= $device_uuid || '' %>" style="background-color:var(--panel);width:100%;height:100%;box-sizing:border-box;">
	<div class="security_locked" style="padding:48px 24px;text-align:center;max-width:640px;margin:0 auto;">
		<h2 style="margin:0 0 10px;">Security is locked</h2>
		<p style="line-height:1.5;margin:0 0 18px;">
			This app can rotate the house key, replace the recovery code and release the shares, so it opens only
			after a fingerprint confirms it is you.
		</p>
		<button class="button security_unlock" type="button">Unlock with a fingerprint</button>
		<div class="security_unlock_status" style="min-height:22px;margin-top:12px;font-size:14px;opacity:.75;"></div>
		<p style="font-size:13px;opacity:.65;line-height:1.5;margin-top:16px;">
			<% if ($reader) { %>
				Touch the fingerprint reader on this machine, or confirm on a paired phone or tablet.
			<% } else { %>
				Confirm on a paired phone or tablet - the one holding your fingerprint.
			<% } %>
			Closing this app forgets the unlock; the key actions inside ask again anyway.
		</p>
		<details style="text-align:left;margin-top:10px;font-size:13px;">
			<summary style="cursor:pointer;opacity:.7;">Lost the phone? Use the paper code</summary>
			<div style="margin-top:10px;">
				<textarea class="security_code" placeholder="The paper recovery code, or three shares on separate lines" style="width:100%;min-height:70px;font-family:ui-monospace,Menlo,monospace;font-size:13px;"></textarea>
				<button class="button security_code_go" type="button" style="margin-top:8px;">Confirm with the code</button>
				<div class="security_code_status" style="min-height:20px;margin-top:8px;opacity:.75;"></div>
			</div>
		</details>
	</div>
</div>
