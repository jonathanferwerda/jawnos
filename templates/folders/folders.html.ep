<div id="folders" style="background-color:white;width:100%;height:100%;" folder="<%= $fo->{'folder'} %>">
	<div id="folders_toolbar" style="height:35px;width:100%;border:solid;background-color:lightgrey;">
		<img src="/images/decipherable/home.png" class="little_thumb hover folders_command" command="home">
		<img src="/images/make believe/up.png" class="little_thumb hover folders_command" command="up">

		<input value="<%= $fo->{'folder'} %>" style="vertical-align:top;width:50%;" id="folders_address">
	</div>
	<div id="folders_mainview" style="height:90%;width:100%;border:solid;padding-bottom:22px;">
		<div id="folders_contents" class="folders_contents" style="padding-top:5px;height:100%;width:100%;overflow-y:scroll;display:grid;grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));gap:5px; align-content: start; align-items: start;">
			<% foreach my $f ( @{$fo->{'files'}} ) { %>
				<table class="folders_file hover" path="<%= $f->{'path'} %>" type="<%= $f->{'type'} %>" style="text-align:center;padding-left:5px;padding-right:5px;padding-top:5px;padding-bottom:5px;">
					<tr><td>
						<% if ($f->{'icon'}) { %>
							<img class="medium_thumb" style="max-width:100%;" src="<%= $f->{'icon'} %>">
						<% } %>
						<br>
						<span style="overflow-wrap: break-word;word-break: break-word;"><%= &subs::format_name($f->{'name'}) %></span>
					</td></tr>
				</table>
			<% } %>
		</div>
	</div>
	% my $disk = $fo->{'disk'};
	<div id="folders_bottom_bar" style="background-color:lightgrey;width:100%;height:25px;border:solid;font-size:24px;position:absolute;bottom:-5px;">
		<span class="folders_selected_info"></span>
		<% if ($disk->{'files'} > 0) { %>
			<img src="/images/decipherable/file.png" class="miniscule_thumb"><span style="vertical-align:top;"><%= $disk->{'files'} %> </span>
		<% } %>
		<% if ($disk->{'folders'} > 0) { %>
			<img src="/images/decipherable/folder.png" class="miniscule_thumb"><span style="vertical-align:top;"><%= $disk->{'folders'} %> </span>
		<% } %>
		<% if ($disk->{'total_size'} > 0) { %>
			<span style="vertical-align:top;"><%= $disk->{'total_size'} %></span>
		<% } %>
		<span style="vertical-align:top;float:right;padding-right:3px;"><%= $disk->{'Use%'} %> <%= $disk->{'Used'} %>/<%= $disk->{'Size'} %></span>
	</div>
</div>