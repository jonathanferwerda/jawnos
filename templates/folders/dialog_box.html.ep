<%# One dialog shape for every Folders job and question: a title bar with a
    close, a scrolling body, and the actions at the foot. %>
<div class="dialog_box folders_dialog" command="<%= $box->{'command'} %>" job="<%= $box->{'job'} %>" folder="<%= $folders->{'folder'} %>" uuid="<%= $uuid %>" data-dialog-icon="<%= &subs::icon_for('/images/decipherable/folder.png') %>" style="height:<%= $box->{'height'} || 'auto' %>;width:<%= $box->{'width'} || 'min(520px, 94vw)' %>;">
	<div class="header folders_dialog_header">
		<span class="folders_dialog_title"><%= $box->{'name'} || &subs::ui('Dialog Box') %></span>
		<button type="button" class="cancel folders_dialog_close" uuid="<%= $uuid %>" onclick="$('[uuid=\'<%= $uuid %>\']').remove()" hint="<%= &subs::ui('Close') %>" aria-label="<%= &subs::ui('Close') %>">✕</button>
	</div>
	<div class="body folders_dialog_body">
		<% if ($box->{'text'}) { %>
			<div class="folders_dialog_text"><%= $box->{'text'} %></div>
		<% } %>
		<% if ($box->{'content'}) { %>
			<div class="folders_dialog_content"><%== $box->{'content'} %></div>
		<% } %>
		<% if ($box->{'inputs'}) { %>
			<% foreach my $i ( @{$box->{'inputs'}} ) { %>
				<input class="folders_dialog_input" type="<%= $i->{'type'} %>" placeholder="<%= $i->{'placeholder'} %>" value="<%= $i->{'value'} %>" name="<%= $i->{'name'} %>">
			<% } %>
		<% } %>
		<% if ($box->{'job'}) { %>
			<div class="job_progress folders_dialog_progress"><%= $box->{'progress'} || &subs::ui('starting') %></div>
		<% } %>
	</div>
	<div class="bottom_buttons folders_dialog_footer">
		<% if ($box->{'job'}) { %>
			<button type="button" class="job_stop" job="<%= $box->{'job'} %>"><%= &subs::ui('Stop') %></button>
		<% } %>
		<% unless (($box->{'cancel'} || '') eq 'no') { %>
			<button type="button" class="cancel" uuid="<%= $uuid %>" onclick="$('[uuid=\'<%= $uuid %>\']').remove()"><%= $box->{'cancel_label'} || &subs::ui('Cancel') %></button>
		<% } %>
		<% unless (($box->{'ok'} || '') eq 'no') { %>
			<button type="button" class="ok" uuid="<%= $uuid %>" onclick="foldersCommandConfirm('<%= $uuid %>')"><%= $box->{'ok_label'} || &subs::ui('OK') %></button>
		<% } %>
	</div>
</div>
