
<div class="folders_context" style="font-size:20px;width:200px;position:fixed;background-color:var(--panel-2);" uuid="<%= $uuid %>">
	<% my $selected = $folders->{'selected'} || []; %>
	<% my $has_folder = scalar grep { ($_->{'type'} || '') eq 'folder' } @{$selected}; %>
	<% my $sealed = scalar grep { (defined $_->{'path'}) && $_->{'path'} =~ /\.enc$/i } @{$selected}; %>
	<% my $plain = scalar grep { (defined $_->{'path'}) && $_->{'path'} !~ /\.enc$/i } @{$selected}; %>
	<%# a folder can hold either kind, so both the sealing and the opening are offered for one %>
	<% my $encrypt_visible = ($plain || $has_folder) ? 'yes' : 'no'; %>
	<% my $decrypt_visible = ($sealed || $has_folder) ? 'yes' : 'no'; %>
	<% my $contexts = {
		file => [
			{ 'open' => {} },
			{ 'open_with' => {} },
			{ 'archive' => {} },
			{ 'fetch_home' => { visible => $folders->{'remote_uuid'} ? 'yes' : 'no' } },
			{ 'cut' => {} },
			{ 'copy' => {} },
			{ 'paste' => { visible => scalar @{$folders->{'clipboard'}} > 0 ? 'yes' : 'no' } },
			{ 'encrypt' => { visible => $encrypt_visible } },
			{ 'decrypt' => { visible => $decrypt_visible } },
			{ 'delete' => {} },
			{ 'shred' => {} },
			{ 'select_all' => {} },
			{ 'rename' => {} },
			{ 'properties' => {} }
		],
		folder => [
			{ 'open' => {} },
			{ 'archive' => {} },
			{ 'fetch_home' => { visible => $folders->{'remote_uuid'} ? 'yes' : 'no' } },
			{ 'cut' => {} },
			{ 'copy' => {} },
			{ 'paste' => { visible => scalar @{$folders->{'clipboard'}} > 0 ? 1 : 0 } },
			{ 'encrypt' => { visible => $encrypt_visible } },
			{ 'decrypt' => { visible => $decrypt_visible } },
			{ 'delete' => {} },
			{ 'shred' => {} },
			{ 'select_all' => {} },
			{ 'rename' => {} },
			{ 'properties' => {} }
		],
		folder_background => [
			{ 'new_file' => {} },
			{ 'new_folder' => {} },
			{ 'archive' => {} },
			{ 'fetch_home' => { visible => $folders->{'remote_uuid'} ? 'yes' : 'no' } },
			{ 'select_all' => {} },
			{ 'paste' => { visible => scalar @{$folders->{'clipboard'}} > 0 ? 1 : 0 } },
			{ 'properties' => {} }
		]
	}; %>
	<% foreach my $co ( @{$contexts->{$context}} ) { %>
		<% foreach my $o ( keys %{$co} ) { %>
			% unless ($co->{$o}->{'visible'} eq 'no') {
				<div class="folders_context_selection hover_showing" command="<%= $o %>">
					<% if ($gb::known_icons->{$o}) { %>
						<img src="<%= $gb::known_icons->{$o} %>" class="miniscule_thumb">
					<% } %>
					<span style="vertical-align:top;"><%= &subs::format_name($o) %></span>
				</div>
			% }
		% }
	% }

</div>