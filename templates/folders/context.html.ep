
<div class="folders_context" style="font-size:20px;width:200px;position:fixed;background-color:var(--panel-2);" uuid="<%= $uuid %>">
	<% my $selected = $folders->{'selected'} || []; %>
	<% my $count = scalar @{$selected}; $count = 1 if (!$count && ($folders->{'path'} || '') ne ''); %>
	<% my $single = ($count <= 1) ? 'yes' : 'no'; %>
	<% my $has_folder = scalar grep { ($_->{'type'} || '') eq 'folder' } @{$selected}; %>
	<% my $sealed = scalar grep { (defined $_->{'path'}) && $_->{'path'} =~ /\.enc$/i } @{$selected}; %>
	<% my $plain = scalar grep { (defined $_->{'path'}) && $_->{'path'} !~ /\.enc$/i } @{$selected}; %>
	<%# a folder can hold either kind, so both the sealing and the opening are offered for one %>
	<% my $encrypt_visible = ($plain || $has_folder) ? 'yes' : 'no'; %>
	<% my $decrypt_visible = ($sealed || $has_folder) ? 'yes' : 'no'; %>
	<% my $in_trash = &Manager::folders_in_trash($folders->{'folder'}) ? 'yes' : 'no'; %>
	<% my $on_desk = (($folders->{'surface'} || '') eq 'desk') ? 'yes' : 'no'; %>
	<% my $contexts = {
		file => [
			{ 'open' => { visible => $single } },
			{ 'open_with' => { visible => $single } },
			{ 'open_tab' => { visible => $single } },
			{ 'open_window' => { visible => $single } },
			{ 'archive' => {} },
			{ 'fetch_home' => { visible => $folders->{'remote_uuid'} ? 'yes' : 'no' } },
			{ 'cut' => {} },
			{ 'copy' => {} },
			{ 'paste' => { visible => scalar @{$folders->{'clipboard'}} > 0 ? 'yes' : 'no' } },
			{ 'encrypt' => { visible => $encrypt_visible } },
			{ 'decrypt' => { visible => $decrypt_visible } },
			{ 'delete' => { visible => $in_trash eq 'yes' ? 'no' : 'yes' } },
			{ 'shred' => {} },
			{ 'select_all' => {} },
			{ 'rename' => { visible => $single } },
			{ 'restore_trash' => { visible => $in_trash } },
			{ 'properties' => {} }
		],
		folder => [
			{ 'open' => { visible => $single } },
			{ 'open_tab' => { visible => $single } },
			{ 'open_window' => { visible => $single } },
			{ 'archive' => {} },
			{ 'fetch_home' => { visible => $folders->{'remote_uuid'} ? 'yes' : 'no' } },
			{ 'cut' => {} },
			{ 'copy' => {} },
			{ 'paste' => { visible => scalar @{$folders->{'clipboard'}} > 0 ? 1 : 0 } },
			{ 'encrypt' => { visible => $encrypt_visible } },
			{ 'decrypt' => { visible => $decrypt_visible } },
			{ 'delete' => { visible => $in_trash eq 'yes' ? 'no' : 'yes' } },
			{ 'shred' => {} },
			{ 'select_all' => {} },
			{ 'rename' => { visible => $single } },
			{ 'restore_trash' => { visible => $in_trash } },
			{ 'properties' => {} },
			{ 'desk_folder' => {} }
		],
		folder_background => [
			{ 'new_file' => {} },
			{ 'new_folder' => {} },
			{ 'pin_app' => {} },
			{ 'desk_folder' => {} },
			{ 'desk_folder_reset' => {} },
			{ 'open_tab' => {} },
			{ 'open_window' => {} },
			{ 'toggle_hidden' => { visible => $on_desk eq 'yes' ? 'no' : 'yes' } },
			{ 'open_trash' => { visible => $on_desk } },
			{ 'empty_trash' => { visible => ($in_trash eq 'yes' || $on_desk eq 'yes') ? 'yes' : 'no' } },
			{ 'archive' => {} },
			{ 'fetch_home' => { visible => $folders->{'remote_uuid'} ? 'yes' : 'no' } },
			{ 'select_all' => {} },
			{ 'paste' => { visible => scalar @{$folders->{'clipboard'}} > 0 ? 1 : 0 } },
			{ 'browser_back' => { visible => (($folders->{'surface'} || '') eq 'desk') ? 'yes' : 'no' } },
			{ 'browser_refresh' => { visible => (($folders->{'surface'} || '') eq 'desk') ? 'yes' : 'no' } },
			{ 'properties' => {} }
		]
	}; %>
	<% my %command_labels = (
		pin_app => &subs::ui('Pin apps to the desk'),
		desk_folder => &subs::ui('Use as desk folder'),
		desk_folder_reset => &subs::ui('Reset desk folder'),
		browser_back => &subs::ui('Back'),
		browser_refresh => &subs::ui('Refresh'),
		open_tab => &subs::ui('Open in new tab'),
		open_window => &subs::ui('Open in new window'),
		open_trash => &subs::ui('Open Recycle Bin'),
		restore_trash => &subs::ui('Restore'),
		empty_trash => &subs::ui('Empty Recycle Bin'),
		toggle_hidden => ($folders->{'show_hidden'} ? &subs::lang('folders.hide_hidden') : &subs::lang('folders.show_hidden')),
	); %>
	<% foreach my $co ( @{$contexts->{$context}} ) { %>
		<% foreach my $o ( keys %{$co} ) { %>
			% unless (($co->{$o}->{'visible'} || 'yes') eq 'no') {
				<div class="folders_context_selection hover_showing" command="<%= $o %>">
					<% if ($gb::known_icons->{$o}) { %>
						<img src="<%= $gb::known_icons->{$o} %>" class="miniscule_thumb">
					<% } %>
					<span style="vertical-align:top;"><%= $command_labels{$o} || &subs::format_name($o) %></span>
				</div>
			% }
		% }
	% }

</div>