<!DOCTYPE html>
<html lang="<%= &subs::language() %>" dir="<%= &subs::language_dir() %>">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title><%= &subs::lang('privacy.title') %> — <%= $controller %></title>
	<style>
		:root {
			--page: #f7f8fa;
			--card: #ffffff;
			--ink: #171a1f;
			--muted: #5a6472;
			--line: #d8dde5;
			--accent: #2b5fd9;
		}
		@media (prefers-color-scheme: dark) {
			:root {
				--page: #101418;
				--card: #171c22;
				--ink: #e8eaed;
				--muted: #aab4c0;
				--line: #2a3038;
				--accent: #8ab4f8;
			}
		}
		* { box-sizing: border-box; }
		body {
			margin: 0;
			background: var(--page);
			color: var(--ink);
			font: 16px/1.6 system-ui, -apple-system, "Segoe UI", sans-serif;
		}
		.wrap { max-width: 820px; margin: 0 auto; padding: 34px 20px 90px; }
		header { margin-bottom: 22px; }
		h1 { margin: 0 0 6px; font-size: 30px; line-height: 1.2; }
		.updated { color: var(--muted); font-size: 14px; }
		section {
			background: var(--card);
			border: 1px solid var(--line);
			border-radius: 12px;
			padding: 18px 20px;
			margin: 14px 0;
		}
		h2 { margin: 0 0 8px; font-size: 18px; }
		p { margin: 0 0 10px; }
		p:last-child { margin-bottom: 0; }
		a { color: var(--accent); }
		.back { display: inline-block; margin-top: 18px; }
		.contact { font-weight: 600; }
	</style>
</head>
<body>
	<div class="wrap">
		<header>
			<h1><%= &subs::lang('privacy.title') %></h1>
			<div class="updated"><%= &subs::lang('privacy.updated', $updated) %></div>
		</header>

		<section>
			<h2><%= &subs::lang('privacy.controller_h') %></h2>
			<p><%= &subs::lang('privacy.controller', $controller, $contact || '—') %></p>
			<p class="contact"><%= $controller %><% if ($contact) { %> — <a href="mailto:<%= $contact %>"><%= $contact %></a><% } %></p>
		</section>

		<section>
			<h2><%= &subs::lang('privacy.data_h') %></h2>
			<p><%= &subs::lang('privacy.data') %></p>
			<p><%= &subs::lang('privacy.voluntary') %></p>
		</section>

		<section>
			<h2><%= &subs::lang('privacy.purpose_h') %></h2>
			<p><%= &subs::lang('privacy.purpose') %></p>
		</section>

		<section>
			<h2><%= &subs::lang('privacy.legal_h') %></h2>
			<p><%= &subs::lang('privacy.legal') %></p>
		</section>

		<section>
			<h2><%= &subs::lang('privacy.retention_h') %></h2>
			<p><%= &subs::lang('privacy.retention') %></p>
		</section>

		<section>
			<h2><%= &subs::lang('privacy.sharing_h') %></h2>
			<p><%= &subs::lang('privacy.sharing') %></p>
		</section>

		<section>
			<h2><%= &subs::lang('privacy.cookies_h') %></h2>
			<p><%= &subs::lang('privacy.cookies') %></p>
		</section>

		<section>
			<h2><%= &subs::lang('privacy.rights_h') %></h2>
			<p><%= &subs::lang('privacy.rights', $contact || $controller) %></p>
		</section>

		<section>
			<h2><%= &subs::lang('privacy.security_h') %></h2>
			<p><%= &subs::lang('privacy.security') %></p>
		</section>

		<% if ($store_name) { %>
			<section>
				<h2><%= &subs::lang('privacy.store_h') %></h2>
				<p><%= &subs::lang('privacy.store_notice') %></p>
			</section>
		<% } %>

		<a class="back" href="/"><%= &subs::lang('privacy.back') %></a>
	</div>
</body>
</html>
