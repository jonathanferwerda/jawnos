<%# The Chat app's section panels - sms, tickets, dial and list - shared between
    the Chat app (which carries only these) and the Mailbox umbrella (which still
    carries every section until it retires). The panels are one if/elsif chain
    keyed on the active subsection, so a panel renders only for its own section.
    Expects the same stash mail_checker hands the panel: settings, mail_phone,
    mail_contact, contacts, sc, list, public_channels, channel_key, channel_public. %>
<%# a construct kind is a core label under construct.<name>; fall back to its key %>
<% my $construct_label = sub {
	my ($name) = @_;
	my $key = 'construct.' . $name;
	my $label = &subs::lang($key);
	return (defined $label && length $label && $label ne $key) ? $label : &subs::format_name($name);
}; %>
<% if ($settings->{'subsection'} eq 'sms') { %>
	<% my $phone_numbers = &subs::db_select('settings', undef, { setting => 'phone', device => &subs::device_setter() })->hashes; %>
	<div id="mail_phone_picker mail_list_picker">
		<table style="font-size:20px;width:100%;text-align:center;">
			<thead>
				<th></th>
			</thead>
			<tbody>
				<% foreach my $phone ( sort { $a->{'app'} cmp $b->{'app'} } @{$phone_numbers} ) { %>
					<% $phone->{'value'} =~ s/\S\d(?=\d{10})//; %>
					<tr type="phone" phone="<%= $phone->{'value'} %>" class="mail_phone hover <% if ($mail_phone eq $phone->{'value'}) { %>active <% } %>">
						<td class="" colspan="3"><%= &subs::format_name($phone->{'app'}) %></td>
						<td class="" colspan="3"><%= &subs::format_name($phone->{'value'}) %></td>
					</tr>
				<% } %>
			</tbody>
		</table>
	</div>
<% } elsif ($settings->{'subsection'} eq 'tickets') { %>
	<div id="mail_contacts_list" style="height:100px;font-size:20px;max-height:100px;text-align:center;">
		<% foreach my $contact ( sort { $a->{'timestamp'} <=> $b->{'timestamp'} } @{$contacts} ) { %>
			<div class="<% if ($mail_contact eq $contact->{'uuid'}) {%>active <% } %>mail_contact hover" uuid="<%= $contact->{'uuid'} %>"
				name="<%= &subs::unformat_name($contact->{'name'}) %>"
				contact_name="<%= &subs::unformat_name($contact->{'contact_name'}) %>"><% my $mcrest = ($privilege eq 'citizen') ? &subs::crest_contact_entry($contact->{'app'}) : undef; %><% my $msrc = ''; if ($mcrest) { $msrc = $mcrest->{'image_data'} || (&subs::crest_peer_image_file($mcrest) ? '/manager/people/crest_image?peer=' . $mcrest->{'crest'}->{'uuid'} . '&stamp=' . &subs::rightNow() : ''); } %><% if ($msrc ne '') { %><img src="<%= $msrc %>" style="width:20px;height:20px;object-fit:cover;border-radius:50%;vertical-align:middle;margin-right:4px;" alt=""><% } %><%= &subs::format_name($contact->{'contact_name'}) %></div>
		<% } %>

	</div>
<% } elsif ($settings->{'subsection'} eq 'dial') { %>
	<% if ($privilege eq 'citizen') { %>
		<button id="mail_picker_default" style="float:right;">Default</button>
		<button id="mail_public_toggle" public="<%= $channel_public ? 'yes' : 'no' %>" style="float:right;margin-right:5px;" hint="Advertise this dial to guests"><%= $channel_public ? 'Advertised' : 'Advertise' %></button><br>
		<% foreach my $group ( sort { $a->{'order'} <=> $b->{'order'} } values %{$sc} ) { %>
			<b><%= $construct_label->($group->{'name'}) %></b><br>
			<% if (scalar @{$group->{'list'}} >= 0) { %>
				<select class="mail_picker" group="<%= $group->{'name'} %>" id="mail_<%= $group->{'sing'} %>_picker">
					<option value="<%= $group->{'def'} %>" default="yes" <% if ($group->{'def'} eq $group->{'value'}) { %>selected<% } %>><%= &subs::ui(&subs::format_name($group->{'def'})) %></option>
					<% foreach my $list ( @{$group->{'list'}} ) { %>
						<% if ($list->{'app'} ne $group->{'def'}) { %>
							<option value="<%= $list->{'app'} %>" <% if ($group->{'value'} eq $list->{'app'}) { %>selected<% } %>><%= &subs::format_name($list->{'app'}) %></option>
						<% } %>
					<% } %>
				</select><br>
			<% } %>
		<% } %>
	<% } else { %>
		<div style="font-size:14px;opacity:.8;">Tune a set the house advertises. You hear a channel while tuned to it; a visitor's words are heard, not kept.</div>
		<table id="mail_public_channel_list" style="width:100%;font-size:18px;text-align:center;">
			<% foreach my $ch ( @{$public_channels} ) { %>
				<tr class="mail_public_channel hover <% if ($channel_key && $channel_key eq $ch->{'key'}) { %>active <% } %>" picker="<%= $ch->{'picker'} %>" key="<%= $ch->{'key'} %>">
					<td><%= $ch->{'label'} %></td>
				</tr>
			<% } %>
		</table>
		<% if (scalar @{$public_channels} == 0) { %><div style="font-size:14px;opacity:.8;">Nothing is advertised right now.</div><% } %>
	<% } %>
<% } elsif ($settings->{'subsection'} eq 'list') { %>
	<div class="mail_list_picker" style="width:100%;">
		<table style="width:100%;text-align:center;">
			<thead>
				<th></th>
				<% foreach my $sc ( sort keys %{$sc} ) { %>
					<th><%= $construct_label->($sc) %></th>
				<% } %>
			</thead>
			<tbody>
				<% foreach my $ls ( @{$list} ) { %>
					<% my $uuid = $ls->{'uuid'}; %>
					<tr class="mail_list hover  <% if ($uuid eq $settings->{'mail_list'}) { %>active " chosen="yes<% } %>" uuid="<%= $uuid %>">
						<td><img src="<%= &subs::icon_for('/images/decipherable/gear.png') %>" hint="Configure" class="tiny_thumb mail_config_toggle hover" uuid="<%= $uuid %>"></td>
						<% if ($ls->{'config'}->{'room'}) { %>
							<td class="mail_list_selection" type="room" colspan="<%= scalar(keys %{$sc}) || 1 %>" uuid="<%= $uuid %>"><%= &subs::format_name($ls->{'config'}->{'room'}) %></td>
						<% } else { %>
							<% foreach my $sc ( sort { $a->{'order'} <=> $b->{'order'} } values %{$sc} ) { %>
								<td class="mail_list_selection" type="ticket" uuid="<%= $uuid %>" group="<%= $sc->{'name'} %>" sc="<%= $ls->{$sc->{'sing'}} %>" ><%= &subs::format_name($ls->{$sc->{'sing'}}) %></td>
							<% } %>
						<% } %>
					</tr>
					<tr style="display:none;"><td colspan="<%= (scalar(keys %{$sc}) || 1) + 1 %>" class="mail_config_container" uuid="<%= $uuid %>"></td></tr>
				<% } %>
			</tbody>
		</table>
	</div>
<% } elsif ($settings->{'subsection'} eq 'lora') { %>
	<% my $lw = $lorawan || {}; %>
	<% my @bands = qw/EU433 EU868 US915 AU915 AS923 AS923_2 AS923_3 AS923_4 KR920 IN865 CN470/; %>
	<div id="chat_lora_panel" class="chat_lora_panel">
		<div class="chat_lora_head">
			<b>LoRa mode</b>
			<span id="chat_lora_state" class="chat_lora_state" data-state="unknown">checking</span>
		</div>
		<p class="chat_lora_hint"><%= &subs::ui('Send and receive through a LoRaWAN network using the T-Deck SX1262 radio. A network server must forward uplinks to the webhook below.') %></p>
		<details class="chat_lora_settings">
			<summary><%= &subs::ui('Network and credentials') %></summary>
			<label><input type="checkbox" id="lorawan_enabled" <% if (($lw->{'enabled'} // '') eq 'on') { %>checked<% } %>> <%= &subs::ui('Enable LoRaWAN') %></label>
			<label><%= &subs::ui('Band') %>
				<select id="lorawan_band">
					<% foreach my $b ( @bands ) { %>
						<option value="<%= $b %>" <% if (($lw->{'band'} || 'EU433') eq $b) { %>selected<% } %>><%= $b %></option>
					<% } %>
				</select>
			</label>
			<label><%= &subs::ui('Sub-band') %> <input id="lorawan_subband" type="number" min="1" max="8" value="<%= $lw->{'subband'} || 1 %>"></label>
			<label><%= &subs::ui('Join EUI') %> <input id="lorawan_join_eui" value="<%= $lw->{'join_eui'} || '' %>" placeholder="16 hex"></label>
			<label><%= &subs::ui('Dev EUI') %> <input id="lorawan_dev_eui" value="<%= $lw->{'dev_eui'} || '' %>" placeholder="16 hex"></label>
			<label><%= &subs::ui('App key') %> <input id="lorawan_app_key" type="password" value="" placeholder="<%= $lw->{'has_app_key'} ? 'saved - leave blank to keep' : '32 hex' %>"></label>
			<label><%= &subs::ui('Port') %> <input id="lorawan_fport" type="number" min="1" max="223" value="<%= $lw->{'fport'} || 1 %>"></label>
			<label><input type="checkbox" id="lorawan_confirmed" <% if (($lw->{'confirmed'} // '') eq 'on') { %>checked<% } %>> <%= &subs::ui('Confirmed uplinks') %></label>
			<div class="chat_lora_buttons">
				<button type="button" id="lorawan_save"><%= &subs::ui('Save and configure') %></button>
				<button type="button" id="lorawan_join"><%= &subs::ui('Join network') %></button>
				<button type="button" id="lorawan_test"><%= &subs::ui('Send test') %></button>
			</div>
			<span id="lorawan_status"></span>
		</details>
		<div class="chat_lora_webhook">
			<label><%= &subs::ui('Network server webhook') %></label>
			<input id="lorawan_webhook" readonly value="<%= $lw->{'webhook_url'} || '' %>">
			<button type="button" id="lorawan_copy_webhook"><%= &subs::ui('Copy') %></button>
		</div>
	</div>
<% } %>
