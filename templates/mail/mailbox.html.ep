<% use Mojo::JSON qw/encode_json decode_json/; %>
<%	no warnings 'uninitialized'; %>
<style>
	.mailbox_message[ephemeral="yes"] > span { border-style: dashed; }
</style>
<div id="mail" style="width:100%;background-color:pink;">
	<img src="<%= &subs::icon_for('/images/make believe/burger.png') %>" hint="Menu" class="little_thumb hover" id="mail_hamburger">
	<% if ($settings->{'subsection'} eq 'email') { %>
		<img src="<%= &subs::icon_for('/images/decipherable/file.png') %>" hint="New file" class="little_thumb hover" id="email_compose" style="">
		<img src="<%= &subs::icon_for('/images/decipherable/gear.png') %>" hint="Configure" class="little_thumb email_config_toggle hover" style="">
	<% } %>
	<span style="font-size:20px;"><%= $main_title %></span>
	<%= include 'mail/conversation', mail => $mail, incoming_data => $incoming_data %>
	<% my $privilege = $c->session('privilege'); %>
	<% if ($privilege eq 'citizen' || $privilege eq 'resident' || $privilege eq 'guest') { %>
		<div id="mail_sidebar" style="width:100%;height:100%;<% if ($incoming_data->{'sidebar'} != 1) { %>display:none;<% } %>background-color:<%= $config->{$device}->{'mail_sidebar_container'}->{'background_colour'} || 'var(--panel)' %>;border:solid;border-radius:20px;border-width:3px;overflow:scroll;"">
			<%# an app shows its own sections here and nothing else: Mailbox (no
			    scope) lists every section, chat lists the five it owns, and an app
			    that owns a single section shows no switcher at all %>
			<% my @scope_list = @{ $scope_sections || [] }; %>
			<% my @sections_listed = @scope_list ? @scope_list : qw/sms email lora list dial pen tickets/; %>
			<% if (!$scope || scalar(@sections_listed) > 1) { %>
				<% if ($privilege eq 'citizen') { %>
					<% foreach my $ss ( @sections_listed ) { %>
						<button class="mail_subsection <% if ( $ss eq $settings->{'subsection'} ) { %>active <% } %>" section="<%= $ss %>"><%= &subs::format_name($ss) %></button>
					<% } %>
					<img src="<%= &subs::icon_for('/images/make believe/telephone line.png') %>" hint="Telephone" class="little_thumb hover" id="mailbox_lora_toggle" toggle="<%= $settings->{'lora_toggle'} %>" style="vertical-align:bottom;">
				<% } else { %>
					<button class="mail_subsection active" section="dial" disabled>Dial</button>
				<% } %>
			<% } %>
			<br><br><br>

			<% if (grep { $_ eq $settings->{'subsection'} } qw/sms tickets dial list/) { %>
				<%= include 'mail/chat_sections', settings => $settings, mail_phone => $mail_phone, mail_contact => $mail_contact, contacts => $contacts, sc => $sc, list => $list, public_channels => $public_channels, channel_key => $channel_key, channel_public => $channel_public, privilege => $privilege %>
			<% } elsif ($settings->{'subsection'} eq 'email') { %>

				<div id="email_main_buttons">
					<% foreach my $b ( qw/contacts inbox drafts outbox sent/ ) { %>
						<button class="email_folder_button <% if ($settings->{'email_folder_selection'} eq $b) { %>selected<% } %>" button="<%= $b %>"
							onclick="settingSetter({ 'app': 'mail', 'setting': 'email_folder_selection', 'value': '<%= $b %>' });setTimeout(function() { mailMaker(); },50);"><%= &subs::format_name($b) %></button>
					<% } %>
				</div>
				<% if (!$settings->{'email_folder_selection'} || $settings->{'email_folder_selection'} eq 'contacts') { %>
					<% my $email_addresses = &subs::db_select('settings', undef, { setting => 'email', device => &subs::device_setter() })->hashes; %>
					<div id="mail_email_picker mail_list_picker">
						<table style="font-size:20px;width:100%;text-align:center;">
							<thead>
								<th></th>
							</thead>
							<tbody>
								<% foreach my $email ( sort { $a->{'app'} cmp $b->{'app'} } @{$email_addresses} ) { %>
									<% $email->{'value'} =~ s/\S\d(?=\d{10})//; %>
									<tr type="email" email="<%= $email->{'value'} %>" class="mail_email hover <% if ($mail_email eq $email->{'value'}) { %>active <% } %>">
										<td class="" colspan="3"><%= &subs::format_name($email->{'app'}) %></td>
										<td class="" colspan="3"><%= $email->{'value'} %></td>
									</tr>
								<% } %>
							</tbody>
						</table>
					</div>
				<% } else { %>
					<%= include 'mail/email_folder', settings => $settings %>
				<% } %>
			<% } elsif ($settings->{'subsection'} eq 'pen') { %>
				% my $conversations = eval { return decode_json $settings->{'chatbot_conversations' } } || {};
				% my $new_uuid = &subs::random_string_creator(35);
				% unshift @{$chatbot_models}, {};
				% $conversations->{$new_uuid} = { uuid => $new_uuid, model => $settings->{'chatbot_model'}, system_message => $settings->{'chatbot_system_message'}, server_time => &subs::rightNow() };
				<% foreach my $uuid ( sort { $conversations->{$a}{'chatbot_conversation_name'} cmp $conversations->{$b}{'chatbot_conversation_name'} } keys %{$conversations} ) { %>
					% next unless $conversations->{$uuid};
					% my $con = $conversations->{$uuid};

					<div class="chatbot_configure <% if ($uuid eq $settings->{'chatbot_conversation'}) { %> selected<% }%>" uuid="<%= $uuid %>">
						<input class="pen_settings" setting="chatbot_conversation_name" value="<%= &subs::format_name($con->{'chatbot_conversation_name'}) %>">
						<% if ($uuid ne $new_uuid) { %>
							<input class="chatbot_conversation_select" type="checkbox" <% if ($uuid eq $settings->{'chatbot_conversation'}) { %>checked="checked"<% } %> style="vertical-align:bottom;">
							<img src="<%= &subs::icon_for('/icons/trash.png') %>" hint="Delete" class="chatbot_conversation_delete little_thumb hover" style="vertical-align:bottom;">
						<% } %>
				    <select class="pen_settings" setting="chatbot_model" value="<%= $con->{'chatbot_model'} %>">
				      <% foreach my $cm ( @{$chatbot_models}) { %>
				        <option value="<%= $cm->{'model'} %>" <% if ($con->{'chatbot_model'} eq $cm->{'model'}) { %>selected<% } %>><%= $cm->{'name'} %><% if ($cm->{'price'}) { %> <%= $cm->{'price'} %><% } %></option>
				      <% } %>
				    </select>
						<br>
						<textarea style="width:98%;" class="pen_settings" setting="chatbot_system_message"><%= $con->{'chatbot_system_message'} %></textarea>
					</div>
				<% } %>
				<div id="pen_chatbot_data" style="display:none;"><%= $settings->{'chatbot_conversations'} || '{}' %></div>
				<div style="font-size:12px;opacity:.75;border:solid;border-radius:6px;padding:8px;margin-top:8px;line-height:1.4;">
					Model choices and provider keys have moved to <b>Configure → Plat</b>, so every assistant is set in one place.
				</div>

			<% } %>
		</div>
	<% } %>
</div>
<script>
	last_mail_message = Date.now();
</script>
