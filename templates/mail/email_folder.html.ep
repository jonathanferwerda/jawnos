<%# The message list for the folder the settings name: the account picker under
    Contacts, otherwise the folder's threads. Only the first page (50) is
    rendered; the sentinel below the table carries the folder, the offset and
    whether more wait, and the app appends the next page as the list is scrolled.
    Expects `$settings->{'email_folder_selection'}` and `$mail_email`. %>
<%
	use Mojo::JSON qw/decode_json encode_json/;
	my $sel = $settings->{'email_folder_selection'};
	my $limit = 50;
	my $threads = [];
	my $more = 0;
	my $sql = ($sel && $sel ne 'contacts') ? &Manager::email_folder_sql($sel) : undef;
	if ($sql) {
		my $all = &Manager::email_threads(&subs::db_query($sql)->hashes);
		$more = scalar @{$all} > $limit ? 1 : 0;
		my @first = @{$all}[0 .. ($limit - 1)];
		@first = grep { defined } @first;
		&Manager::email_thread_annotate(\@first, &subs::suds_grabber());
		$threads = \@first;
	}
	$settings->{'email_server'} = eval { return decode_json &subs::setting_grabber({ app => 'mailbox', setting => 'email_config' }) } || [];
%>
<% if (!$sel || $sel eq 'contacts') { %>
	<% my $email_addresses = &subs::db_select('settings', undef, { setting => 'email', device => &subs::device_setter() })->hashes; %>
	<div id="mail_email_picker" class="mail_list_picker email_accounts">
		<% foreach my $email ( sort { $a->{'app'} cmp $b->{'app'} } @{$email_addresses} ) { %>
			<% $email->{'value'} =~ s/\S\d(?=\d{10})//; %>
			<div type="email" email="<%= $email->{'value'} %>" class="email_account_row <% if ($mail_email eq $email->{'value'}) { %>active <% } %>">
				<span class="email_account_app"><%= &subs::format_name($email->{'app'}) %></span>
				<span class="email_account_addr"><%= $email->{'value'} %></span>
			</div>
		<% } %>
	</div>
<% } else { %>
	<table class="email_message_table" style="width:100%;">
		<thead>
			<th>Time</th><th><%= ($sel eq 'inbox') ? 'From' : 'To' %></th><th>Subject</th><th></th>
		</thead>
		<tbody id="email_list_body">
			<%= include 'mail/email_rows', threads => $threads %>
		</tbody>
	</table>
	<div id="email_list_more" class="email_list_more" data-folder="<%= $sel %>" data-offset="<%= scalar @{$threads} %>" data-more="<%= $more %>"><% if ($more) { %>Loading more&hellip;<% } %></div>
<% } %>
