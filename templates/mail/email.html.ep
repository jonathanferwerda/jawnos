<% 
	use Mojo::JSON qw/decode_json encode_json/;
	my $es = eval { return decode_json &subs::setting_grabber({ app => 'mailbox', setting => 'email_config' }) } || [];
	my $suds = &subs::suds_grabber();
	my @messages = @{ $messages || [] };
%>
<div class="mail_thread">
	<% foreach my $m ( @messages ) {
		my $attachments = eval { return decode_json $m->{'attachments'} } || [];
		my $subject = &subs::note_decrypter($suds, $m->{'subject'} || '');
		my $body = &subs::note_decrypter($suds, $m->{'body'} || '');
		# who it is from and to: an inbox row carries the sender in `email` and names
		# the server that received it in `email_server`; a sent or outbox row carries
		# the recipient in `email` and our own server in `from_email`.
		my ($email_server) = grep { $_->{'uuid'} eq $m->{'from_email'} } @{$es};
		my ($to, $from) = ($email_server->{'email'}, $m->{'email'});
		if ($m->{'status'} eq 'outbox' || $m->{'status'} eq 'sent') {
			my $tf = $from; $from = $to; $to = $tf;
		} elsif ($m->{'status'} eq 'inbox') {
			($email_server) = grep { $_->{'uuid'} eq $m->{'email_server'} } @{$es};
			$to = $email_server->{'email'};
		}
		my $cc = $m->{'cc'} || '';
		my $editable = ($m->{'status'} eq 'outbox' || $m->{'status'} eq 'draft');
		my $starred = ($m->{'starred'} || '') eq 'yes';
	%>
		<div class="mail_reader_message" uuid="<%= $m->{'uuid'} %>" folder="<%= $m->{'status'} %>">
			<div class="mail_reader_actions">
				<button class="mail_action" mail_action="reply" uuid="<%= $m->{'uuid'} %>" hint="Reply">Reply</button>
				<button class="mail_action" mail_action="reply_all" uuid="<%= $m->{'uuid'} %>" hint="Reply to the sender and everyone copied">Reply all</button>
				<button class="mail_action" mail_action="forward" uuid="<%= $m->{'uuid'} %>" hint="Forward">Forward</button>
				<button class="mail_action" mail_action="star" uuid="<%= $m->{'uuid'} %>" starred="<%= $starred ? 'yes' : 'no' %>" hint="Star this message"><%= $starred ? "\x{2605}" : "\x{2606}" %></button>
				<button class="mail_action" mail_action="unread" uuid="<%= $m->{'uuid'} %>" hint="Mark unread">Unread</button>
				<% if ($editable) { %>
					<button class="mail_action" mail_action="edit" uuid="<%= $m->{'uuid'} %>" hint="Edit this draft">Edit</button>
				<% } %>
				<% if (($m->{'status'} || '') eq 'trash') { %>
					<button class="mail_action" mail_action="restore" uuid="<%= $m->{'uuid'} %>" hint="Put this letter back in the inbox">Restore</button>
				<% } %>
				<% if (($m->{'status'} || '') eq 'inbox' && $from && !&subs::db_query('select app from settings where setting = ? and value = ?', 'email', $from)->hashes->[0]) { %>
					<button class="mail_action" mail_action="sender_app" uuid="<%= $m->{'uuid'} %>" email="<%= $from %>" hint="Make an appointment for this sender, and file their attachments there">New sender</button>
				<% } %>
				<span class="mail_reader_actions_right">
					<button class="mail_action" mail_action="move" uuid="<%= $m->{'uuid'} %>" hint="Move to a folder">Move</button>
					<img class="little_thumb email_deleter hover" hint="Delete" uuid="<%= $m->{'uuid'} %>" src="<%= &subs::icon_for('/icons/trash.png') %>">
				</span>
			</div>
			<h2 class="mail_reader_subject"><%= $subject %></h2>
			<table class="mail_reader_meta">
				<tbody>
					<tr><td>From</td><td><%= $from %></td></tr>
					<tr><td>To</td><td><%= $to %></td></tr>
					<% if ($cc) { %>
						<tr><td>Cc</td><td><%= $cc %></td></tr>
					<% } %>
					<tr><td>Date</td><td class="time" timestamp="<%= $m->{'timestamp'} %>"></td></tr>
					<% if (scalar @{$attachments} > 0) { %>
						<tr><td>Attachments</td><td>
							<% foreach my $a ( @{$attachments} ) {
								my $afile = $a->{'f'} || ($a->{'file'} ? $a->{'file'}->{'f'} : '');
								my $asrc = $a->{'src'} || '';
								my $aname = $a->{'of'} || $a->{'name'} || ($a->{'file'} ? $a->{'file'}->{'of'} : '') || ($afile =~ m{([^/]+)$} ? $1 : 'attachment');
								my $ahref = $asrc ? $asrc : ($afile ? '/file_open?file=' . $afile . ($a->{'uuid'} ? '&uuid=' . $a->{'uuid'} : '') : '');
							%>
								<% if ($ahref) { %>
									<a class="mail_reader_att" href="<%= $ahref %>" download="<%= $aname %>" target="_blank" title="Download <%= $aname %>"><%= $aname %></a>
								<% } else { %>
									<span class="mail_reader_att"><%= $aname %></span>
								<% } %>
							<% } %>
						</td></tr>
					<% } %>
				</tbody>
			</table>
			<div class="mail_reader_body"><%== $body %></div>
		</div>
	<% } %>
</div>
