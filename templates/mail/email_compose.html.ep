<% use Mojo::JSON qw/decode_json encode_json/; %>
<% my $settings = &subs::settings_grabber({ app => 'mailbox' }); %>
<% my $subject_variables = &Manager::text_editor_variables(&Manager::text_area_context($magic_vars)); %>
<div class="email_compose_form" uuid="<%= $draft->{'uuid'} %>">
	<% my $email_servers = eval { return decode_json $settings->{'email_config'} } || []; %>
	<% @{$email_servers} = grep { $_->{'active'} eq 'on' } @{$email_servers}; %>
	<% if (scalar @{$email_servers} > 0) { %>
		<div class="email_compose_bar">
			<button class="email_discard" hint="Close without sending">Cancel</button>
			<% if (scalar @{$drafts} > 1) { %>
				<button class="email_draft_change" direction="prev" hint="Previous draft">&lsaquo;</button>
				<button class="email_draft_change" direction="next" hint="Next draft">&rsaquo;</button>
			<% } %>
			<button class="email_send" hint="Send this message now">Send</button>
		</div>
		<div class="email_compose_fields">
			<div class="email_compose_row">
				<span class="email_compose_label">From</span>
				<select class="email_compose_input email_compose_from" id="email_compose_from" value="<%= $draft->{'from_email'} %>">
					<% foreach my $es ( @{$email_servers} ) { %>
						<option value="<%= $es->{'uuid'} %>" <% if ($es->{'email'} eq $draft->{'from_email'}) { %>selected<% } %>><%= $es->{'email'} %></option>
					<% } %>
				</select>
			</div>
			<div class="email_compose_row">
				<span class="email_compose_label">To</span>
				<input type="email" id="email_compose_to" class="email_compose_input email_compose_to" value="<%= $email %>" placeholder="name@example.com">
			</div>
			<div class="email_compose_row">
				<span class="email_compose_label">Cc</span>
				<input type="text" id="email_compose_cc" class="email_compose_input email_compose_cc" value="<%= $draft->{'cc'} %>" placeholder="name@example.com">
			</div>
			<div class="email_compose_row">
				<span class="email_compose_label">Bcc</span>
				<input type="text" id="email_compose_bcc" class="email_compose_input email_compose_bcc" value="<%= $draft->{'bcc'} %>" placeholder="name@example.com">
			</div>
			<div class="email_compose_row">
				<span class="email_compose_label">Subject</span>
				<input type="text" id="email_compose_subject" class="email_compose_input email_compose_subject" value="<%= $draft->{'subject'} %>" magic_vars="<%= $magic_vars %>">
				<%= include 'text_editor_legend', variables => $subject_variables, source_id => '', target => 'email_compose_subject' %>
			</div>
			<% my $email_templates = eval { return decode_json $settings->{'email_templates'} } || []; %>
			<% if (scalar @{$email_templates} > 0) { %>
				<div class="email_compose_row">
					<span class="email_compose_label">Template</span>
					<select class="email_template_select">
						<option value=""></option>
						<% foreach my $et ( @{$email_templates} ) { %>
							<option value="<%= $et->{'uuid'} %>"><%= &subs::format_name($et->{'name'}) %></option>
						<% } %>
					</select>
				</div>
			<% } %>
			<div class="email_compose_row">
				<span class="email_compose_label">Attach</span>
				<table class="email_attachments"><tbody><tr>
					<% my @seen; %>
					<% foreach my $att ( @{$attachments}, @{$draft->{'attachments'}} ) { %>
						<% next if grep { $att->{'uuid'} eq $_ } @seen; %>
						<% push @seen, $att->{'uuid'}; %>
						<%= include 'mail/email_attachment_preparer', att => $att %>
					<% } %>
					<button class="email_attachment_toggle" hint="Attach a file">Add</button>
					<div style="display:none;width:100%;max-width:100%;overflow-x:scroll;" class="email_attachment_dialog"></div>
				</tr></tbody></table>
			</div>
		</div>
		<input type="hidden" value="<%= $draft->{'uuid'} %>" id="email_compose_uuid" class="email_compose_input email_compose_uuid">
		<input type="hidden" value="<%= $draft->{'in_reply_to_uuid'} %>" id="email_compose_in_reply_to_uuid" class="email_compose_input email_compose_in_reply_to_uuid">
		<input type="hidden" timestamp="<%= $timestamp %>" id="email_compose_timestamp" class="email_compose_input email_compose_timestamp time">
		<textarea id="email_compose_body" class="email_compose_input email_compose_body" placeholder="Write your message" upgradeable="yes" magic_vars="<%= $magic_vars %>"><%= $draft->{'body'} %></textarea>
		<% foreach my $att ( @{$attachments}, @{$draft->{'attachments'}} ) { %>
			<% if ($att->{'html'}) { %>
				<div class="email_attachment_embed" uuid="<%= $att->{'uuid'} %>">
					<embed style="width:200px;height:300px;">
						<%== $att->{'html'} %>
					</embed>
				</div>
			<% } %>
		<% } %>
	<% } else { %>
		<p class="email_compose_noserver">No mail server is set up yet. Open the gear and add one.</p>
	<% } %>
</div>
