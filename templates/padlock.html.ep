<div class="padlock_frame" mode="<%= $mode %>" style="background-color:<%= &subs::random_colour_grabber() %>;">
	<h1 id="padlock_taunts"></h1>
	<div class="padlock_message">The house is locked.<br>Unlock on your phone or with the recovery code.</div>
	<%= include 'denial_image' %>
	<% if ($mode ne 'security') { %>
		<a href="/manager/security/padlock_key?mode=<%= $mode %>" class="padlock_phone_key">Open the unlock page on this phone</a>
	<% } %>

	<style>
		.padlock_frame {
			width: 300px;
			bottom: 20%;
			position:absolute;
			text-align:center;
		}
		.padlock_frame .denial_image {
			width: 100%;
			display: block;
		}
		.padlock_message {
			font-size: 18px;
			line-height: 1.4;
			color: #111;
			margin: 8px 0;
		}
		.padlock_phone_key {
			display:none;
			margin: 10px auto 0 auto;
			font-size: 16px;
			padding: 8px 14px;
			border-radius: 8px;
			background-color: rgba(255,255,255,0.9);
			color: #000;
			text-decoration: none;
		}
		@media screen and (max-width:900px) {
			.padlock_phone_key { display:block; }
		}
	</style>

</div>
