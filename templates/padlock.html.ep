<%# every value is read from the stash: a template compiled without a given
    local leaves a bare variable undeclared under strict, which is what made
    /manager/lock_session answer 500 %>
<% my $frame_mode = $c->stash('mode') || 'locker'; %>
<% my $frame_target = $c->stash('target') || ''; %>
<% my $show_phone = defined $c->stash('phone_button') ? $c->stash('phone_button') : 1; %>
<% my $show_fingerprint = ($c->stash('fingerprint') && (defined $c->stash('fingerprint_button') ? $c->stash('fingerprint_button') : 1)) ? 1 : 0; %>
<% my $show_phone_key = defined $c->stash('phone_key') ? $c->stash('phone_key') : 1; %>
<% my $show_biometric = (&subs::device_setter() eq 'mobile' && (defined $c->stash('biometric_button') ? $c->stash('biometric_button') : 1)) ? 1 : 0; %>
<% my $logo = &subs::setting_grabber({ app => 'me', setting => 'logo' }) || '/images/jbuttons/logo1.png'; %>
<%# How long a padlock living in Manager waits before its screensaver starts.
    The lock screen keeps its own fifteen seconds; this covers the in-app
    padlocks (music, folders, gallery). A bare number is minutes, so "3" is
    three minutes (see subs::time_abbrev_translator). %>
<% my $manager_screensaver_delay = 120000; %>
<% my $manager_screensaver_setting = &subs::setting_grabber({ app => 'misc', setting => 'screensaver_timeout' }); %>
<% if (defined $manager_screensaver_setting && !ref($manager_screensaver_setting) && $manager_screensaver_setting =~ /[0-9]/) { %>
<%   my $translated = eval { &subs::time_abbrev_translator($manager_screensaver_setting, &subs::rightNow()) }; %>
<%   $manager_screensaver_delay = int($translated) if defined $translated && $translated =~ /^[0-9]+$/ && $translated > 0; %>
<% } %>
<%# Cartoon world is the new look; art is the older drifting logo. %>
<% my $screensaver_style = &subs::setting_grabber({ app => 'misc', setting => 'screensaver_style' }) || 'cartoon'; %>
<% $screensaver_style = 'cartoon' unless $screensaver_style =~ /^(?:cartoon|art)$/; %>
<div class="padlock_frame" mode="<%= $frame_mode %>" target="<%= $frame_target %>" style="background-color:<%= &subs::random_colour_grabber() %>;">
	<h1 id="padlock_taunts"></h1>
	<% my $scope = $frame_mode eq 'private' ? 'Private apps are locked.' : $frame_mode =~ /^(?:gallery|music|folders)$/ ? 'This app is locked.' : ($frame_target ? 'This screen is locked.' : 'The house is locked.'); %>
	<div class="padlock_message"><%= $scope %><br><%= &subs::ui('Unlock on your phone, with a fingerprint, or with the recovery code.') %></div>
	<div class="padlock_emblem">
		<%= include 'denial_image' %>
		<div class="padlock_lock_art" style="display:none;">
			<img class="padlock_locked" src="<%= &subs::icon_drawn('/images/jbuttons/padlock lock.png') %>" alt="Locked">
			<img class="padlock_unlocked" src="<%= &subs::icon_drawn('/images/jbuttons/padlock unlock.png') %>" alt="Unlocked">
		</div>
	</div>
	<% if ($frame_mode ne 'security' && $show_phone) { %>
		<button type="button" class="padlock_ask_phone"><%= &subs::ui('Unlock on my phone or laptop') %></button>
	<% } %>
	<% if ($show_fingerprint) { %>
		<button type="button" class="padlock_fingerprint">Use this computer's fingerprint</button>
		<div class="padlock_fingerprint_status"></div>
	<% } %>
	<% if ($show_biometric) { %>
		<button type="button" class="padlock_biometric">Use this phone's fingerprint</button>
		<div class="padlock_fingerprint_status"></div>
	<% } %>
	<% if ($frame_mode ne 'security' && $show_phone_key) { %>
		<a href="/manager/security/padlock_key?mode=<%= $frame_mode %>" class="padlock_phone_key">Open the unlock page on this phone</a>
	<% } %>

	<div class="padlock_screensaver"
		data-style="<%= $screensaver_style %>"
		data-manager-delay="<%= $manager_screensaver_delay %>"
		data-logo="<%= $logo %>">
		<canvas class="padlock_screensaver_canvas"></canvas>
	</div>

	<style>
		.padlock_frame {
			position: absolute;
			left: 50%;
			top: 50%;
			transform: translate(-50%, -50%);
			width: 300px;
			text-align: center;
		}
		/* a short window (a phone, or a small tablet) cannot fit the emblem
		   and the buttons: cap the picture so the ways in stay on screen */
		@media screen and (max-height: 760px) {
			.padlock_emblem .denial_image { max-height: 32vh; width: auto; margin: 0 auto; }
			.padlock_message { font-size: 15px; margin: 4px 0; }
		}
		.padlock_frame .denial_image {
			width: 100%;
			display: block;
		}
		.padlock_emblem {
			position: relative;
		}
		/* the hand-drawn padlock over the denial picture while a fingerprint is
		   being read: the denial image keeps the frame's height, so the art can
		   sit on top and the panel does not jump */
		.padlock_lock_art {
			position: absolute;
			inset: 0;
		}
		.padlock_lock_art img {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: contain;
			transition: opacity 550ms ease, transform 550ms ease;
		}
		.padlock_lock_art .padlock_unlocked {
			opacity: 0;
			transform: translateY(-8px) rotate(-4deg);
		}
		.padlock_lock_art.unlocking .padlock_locked {
			opacity: 0;
		}
		.padlock_lock_art.unlocking .padlock_unlocked {
			opacity: 1;
			transform: none;
		}
		.padlock_lock_art.snap img {
			transition: none;
		}
		.padlock_message {
			font-size: 18px;
			line-height: 1.4;
			color: #111;
			margin: 8px 0;
		}
		.padlock_ask_phone,
		.padlock_fingerprint,
		.padlock_biometric {
			display: block;
			margin: 10px auto 0 auto;
			font-size: 16px;
			padding: 8px 14px;
			border-radius: 8px;
			border: 1px solid #333;
			background-color: rgba(255,255,255,0.9);
			color: #000;
			cursor: pointer;
		}
		.padlock_fingerprint,
		.padlock_biometric {
			background-color: #2b6;
			border-color: #2b6;
			color: #08110a;
			font-weight: bold;
		}
		<%# the local reader belongs to the browser's own machine, not the one
		    that may have rendered a remote listing, so the manager layout says
		    whether it is here %>
		.no_local_fingerprint .padlock_fingerprint { display: none !important; }
		.padlock_fingerprint_status {
			min-height: 18px;
			margin-top: 4px;
			font-size: 14px;
			color: #111;
		}
		.padlock_phone_key {
			display: none;
			margin: 18px auto 10px auto;
			font-size: 16px;
			padding: 8px 14px;
			border-radius: 8px;
			background-color: rgba(255,255,255,0.9);
			color: #000;
			text-decoration: none;
		}
		@media screen and (max-width:900px) {
			.padlock_fingerprint { display: none; }
			/* the peer button stays: a tablet with no reader of its own has no
			   other way in, and the phone-key page would be a dead end there */
			.padlock_phone_key { display: block; }
		}
		.padlock_screensaver {
			display: none;
			position: fixed;
			inset: 0;
			z-index: 70000;
			background-color: #08080d;
		}
		.padlock_screensaver_canvas {
			width: 100%;
			height: 100%;
			display: block;
		}
	</style>


</div>
