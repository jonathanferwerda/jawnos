<%# every value is read from the stash: a template compiled without a given
    local leaves a bare variable undeclared under strict, which is what made
    /manager/lock_session answer 500 %>
<% my $frame_mode = $c->stash('mode') || 'locker'; %>
<% my $frame_target = $c->stash('target') || ''; %>
<% my $show_phone = defined $c->stash('phone_button') ? $c->stash('phone_button') : 1; %>
<% my $show_fingerprint = ($c->stash('fingerprint') && (defined $c->stash('fingerprint_button') ? $c->stash('fingerprint_button') : 1)) ? 1 : 0; %>
<% my $show_phone_key = defined $c->stash('phone_key') ? $c->stash('phone_key') : 1; %>
<% my $show_biometric = (&subs::device_setter() eq 'mobile' && (defined $c->stash('biometric_button') ? $c->stash('biometric_button') : 1)) ? 1 : 0; %>
<% my $logo = &subs::setting_grabber({ app => 'me', setting => 'logo' }) || '/images/jbuttons/logo1.png'; %>
<div class="padlock_frame" mode="<%= $frame_mode %>" target="<%= $frame_target %>" style="background-color:<%= &subs::random_colour_grabber() %>;">
	<h1 id="padlock_taunts"></h1>
	<% my $scope = $frame_target ? 'This screen is locked.' : 'The house is locked.'; %>
	<div class="padlock_message"><%= $scope %><br>Unlock on your phone or with the recovery code.</div>
	<div class="padlock_emblem">
		<%= include 'denial_image' %>
		<div class="padlock_lock_art" style="display:none;">
			<img class="padlock_locked" src="<%= &subs::icon_drawn('/images/jbuttons/padlock lock.png') %>" alt="Locked">
			<img class="padlock_unlocked" src="<%= &subs::icon_drawn('/images/jbuttons/padlock unlock.png') %>" alt="Unlocked">
		</div>
	</div>
	<% if ($frame_mode ne 'security' && $show_phone) { %>
		<button type="button" class="padlock_ask_phone"><%= &subs::ui('Unlock on my phone or laptop') %></button>
	<% } %>
	<% if ($show_fingerprint) { %>
		<button type="button" class="padlock_fingerprint">Use this computer's fingerprint</button>
		<div class="padlock_fingerprint_status"></div>
	<% } %>
	<% if ($show_biometric) { %>
		<button type="button" class="padlock_biometric">Use this phone's fingerprint</button>
		<div class="padlock_fingerprint_status"></div>
	<% } %>
	<% if ($frame_mode ne 'security' && $show_phone_key) { %>
		<a href="/manager/security/padlock_key?mode=<%= $frame_mode %>" class="padlock_phone_key">Open the unlock page on this phone</a>
	<% } %>

	<div class="padlock_screensaver">
		<canvas class="padlock_screensaver_canvas"></canvas>
	</div>

	<style>
		.padlock_frame {
			position: absolute;
			left: 50%;
			top: 50%;
			transform: translate(-50%, -50%);
			width: 300px;
			text-align: center;
		}
		.padlock_frame .denial_image {
			width: 100%;
			display: block;
		}
		.padlock_emblem {
			position: relative;
		}
		/* the hand-drawn padlock over the denial picture while a fingerprint is
		   being read: the denial image keeps the frame's height, so the art can
		   sit on top and the panel does not jump */
		.padlock_lock_art {
			position: absolute;
			inset: 0;
		}
		.padlock_lock_art img {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: contain;
			transition: opacity 550ms ease, transform 550ms ease;
		}
		.padlock_lock_art .padlock_unlocked {
			opacity: 0;
			transform: translateY(-8px) rotate(-4deg);
		}
		.padlock_lock_art.unlocking .padlock_locked {
			opacity: 0;
		}
		.padlock_lock_art.unlocking .padlock_unlocked {
			opacity: 1;
			transform: none;
		}
		.padlock_lock_art.snap img {
			transition: none;
		}
		.padlock_message {
			font-size: 18px;
			line-height: 1.4;
			color: #111;
			margin: 8px 0;
		}
		.padlock_ask_phone,
		.padlock_fingerprint,
		.padlock_biometric {
			display: block;
			margin: 10px auto 0 auto;
			font-size: 16px;
			padding: 8px 14px;
			border-radius: 8px;
			border: 1px solid #333;
			background-color: rgba(255,255,255,0.9);
			color: #000;
			cursor: pointer;
		}
		.padlock_fingerprint,
		.padlock_biometric {
			background-color: #2b6;
			border-color: #2b6;
			color: #08110a;
			font-weight: bold;
		}
		.padlock_fingerprint_status {
			min-height: 18px;
			margin-top: 4px;
			font-size: 14px;
			color: #111;
		}
		.padlock_phone_key {
			display: none;
			margin: 18px auto 10px auto;
			font-size: 16px;
			padding: 8px 14px;
			border-radius: 8px;
			background-color: rgba(255,255,255,0.9);
			color: #000;
			text-decoration: none;
		}
		@media screen and (max-width:900px) {
			.padlock_ask_phone,
			.padlock_fingerprint { display: none; }
			.padlock_phone_key { display: block; }
		}
		.padlock_screensaver {
			display: none;
			position: fixed;
			inset: 0;
			z-index: 70000;
			background-color: #08080d;
		}
		.padlock_screensaver_canvas {
			width: 100%;
			height: 100%;
			display: block;
		}
	</style>

	<script>
	(function () {
		var frame = document.currentScript ? document.currentScript.closest('.padlock_frame') : null;
		if (!frame) { frame = document.querySelector('.padlock_frame'); }
		if (!frame) { return; }
		var layer = frame.querySelector('.padlock_screensaver');
		if (!layer) { return; }
		var canvas = layer.querySelector('canvas');
		var ctx = canvas.getContext('2d');
		var logo = new Image();
		// a stored logo is a data URI and can carry line breaks; a JSON string
		// keeps them escaped instead of ending the JS string at the first one
		logo.src = <%== &subs::json_chars($logo) %>;
		var timer = null, raf = null, active = false, started = 0, last = 0;
		var blobs = [];
		var logoEvent = null, nextLogoAt = 0;

		function resize() {
			canvas.width = Math.max(1, window.innerWidth);
			canvas.height = Math.max(1, window.innerHeight);
		}
		function newArt() {
			var palette = [];
			for (var i = 0; i < 7; i++) {
				palette.push('hsl(' + Math.floor(Math.random() * 360) + ',' + (45 + Math.floor(Math.random() * 40)) + '%,' + (45 + Math.floor(Math.random() * 20)) + '%)');
			}
			blobs = [];
			for (var j = 0; j < 10; j++) {
				blobs.push({
					x: Math.random(), y: Math.random(),
					r: 0.05 + Math.random() * 0.22,
					dx: (Math.random() - 0.5) * 0.02,
					dy: (Math.random() - 0.5) * 0.02,
					c: palette[j % palette.length]
				});
			}
		}
		// One logo at a time, at a fresh spot, easing in and out. The pause and
		// the run length are both random so it never settles into a rhythm.
		function startLogo(now) {
			if (!logo.complete || !logo.naturalWidth) { return; }
			var w = canvas.width, h = canvas.height;
			var size = Math.min(w, h) * (0.10 + Math.random() * 0.16);
			var scale = Math.min(size / logo.naturalWidth, size / logo.naturalHeight);
			var lw = logo.naturalWidth * scale, lh = logo.naturalHeight * scale;
			var margin = Math.min(w, h) * 0.08;
			var roomX = Math.max(1, w - lw - margin * 2);
			var roomY = Math.max(1, h - lh - margin * 2);
			logoEvent = {
				start: now,
				duration: 4200 + Math.random() * 4200,
				x: margin + Math.random() * roomX + lw / 2,
				y: margin + Math.random() * roomY + lh / 2,
				w: lw, h: lh,
				rot: (Math.random() - 0.5) * 0.35
			};
		}
		function drawLogo(now) {
			if (!logo.complete || !logo.naturalWidth) { return; }
			if (!logoEvent) {
				if (!nextLogoAt) { nextLogoAt = now + 1000 + Math.random() * 2600; }
				if (now < nextLogoAt) { return; }
				startLogo(now);
				if (!logoEvent) { return; }
			}
			var p = (now - logoEvent.start) / logoEvent.duration;
			if (p >= 1) {
				logoEvent = null;
				nextLogoAt = now + 1800 + Math.random() * 6500;
				return;
			}
			var alpha = 0.9 * (p < 0.25 ? p / 0.25 : (p > 0.75 ? (1 - p) / 0.25 : 1));
			ctx.save();
			ctx.globalAlpha = alpha;
			ctx.shadowColor = 'rgba(255,255,255,0.55)';
			ctx.shadowBlur = 26;
			ctx.translate(logoEvent.x, logoEvent.y);
			ctx.rotate(logoEvent.rot);
			ctx.drawImage(logo, -logoEvent.w / 2, -logoEvent.h / 2, logoEvent.w, logoEvent.h);
			ctx.restore();
		}
		function draw(now) {
			if (!active) { return; }
			if (!document.body.contains(frame)) { active = false; return; }
			raf = requestAnimationFrame(draw);
			if (now - last < 33) { return; }
			last = now;
			var t = (now - started) / 1000;
			var w = canvas.width, h = canvas.height;
			ctx.globalCompositeOperation = 'source-over';
			ctx.fillStyle = '#08080d';
			ctx.fillRect(0, 0, w, h);
			ctx.globalCompositeOperation = 'lighter';
			for (var i = 0; i < blobs.length; i++) {
				var b = blobs[i];
				var x = (b.x + Math.sin(t * 0.08 + i) * 0.06 + b.dx * t) % 1;
				var y = (b.y + Math.cos(t * 0.07 + i) * 0.06 + b.dy * t) % 1;
				if (x < 0) { x += 1; }
				if (y < 0) { y += 1; }
				var r = b.r * Math.min(w, h);
				var g = ctx.createRadialGradient(x * w, y * h, 0, x * w, y * h, r);
				g.addColorStop(0, b.c);
				g.addColorStop(1, 'rgba(0,0,0,0)');
				ctx.fillStyle = g;
				ctx.fillRect(0, 0, w, h);
			}
			ctx.globalCompositeOperation = 'source-over';
			ctx.strokeStyle = 'rgba(255,255,255,0.10)';
			ctx.lineWidth = 1;
			for (var k = 0; k < 4; k++) {
				ctx.beginPath();
				ctx.arc(w * (0.2 + k * 0.2), h * 0.5, Math.min(w, h) * (0.2 + 0.1 * Math.sin(t * 0.1 + k)), 0, Math.PI * 2);
				ctx.stroke();
			}
			drawLogo(now);
		}
		function show() {
			if (active) { return; }
			if (!document.body.contains(frame)) { return; }
			active = true;
			// The layer is inside .padlock_frame, which is transformed; a fixed
			// child of a transformed box is sized to that box, not the window.
			// Move it to the body so it covers the whole screen, and drop any
			// layer left behind by an earlier overlay.
			var oldLayers = document.querySelectorAll('body > .padlock_screensaver');
			for (var oi = 0; oi < oldLayers.length; oi++) {
				if (oldLayers[oi] !== layer) { oldLayers[oi].parentNode.removeChild(oldLayers[oi]); }
			}
			if (layer.parentNode !== document.body) { document.body.appendChild(layer); }
			newArt();
			resize();
			logoEvent = null;
			nextLogoAt = 0;
			layer.style.display = 'block';
			started = performance.now();
			last = 0;
			if (raf) { cancelAnimationFrame(raf); }
			raf = requestAnimationFrame(draw);
		}
		function hide() {
			active = false;
			layer.style.display = 'none';
			if (raf) { cancelAnimationFrame(raf); raf = null; }
			restart();
		}
		function restart() {
			if (timer) { clearTimeout(timer); }
			timer = setTimeout(show, 15000);
		}
		['mousemove', 'mousedown', 'keydown', 'touchstart', 'wheel'].forEach(function (ev) {
			document.addEventListener(ev, function () {
				if (active) { hide(); }
				else { restart(); }
			}, { passive: true });
		});
		window.addEventListener('resize', function () { if (active) { resize(); } });
		restart();
	})();
	</script>

</div>
