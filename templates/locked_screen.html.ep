<% my $target = defined $target ? $target : ''; %>
<% my $bio_enrolled = defined $c->stash('biometric') ? $c->stash('biometric') : 0; %>
<script>
	// The page's own device, for a browser that reached the lock through a
	// ticket and has no localStorage entry yet. universal.js prefers
	// localStorage and falls back to this.
	if (!window.jawnLockedDevice && '<%= $target %>') {
		window.jawnLockedDevice = '<%= $target %>';
	}
</script>
<div id="locked_screen">
	<div id="locked_heading"><%= $target ? 'This screen is locked.' : 'The house is locked.' %></div>

	<div id="locked_padlock">
		<%= include 'padlock', mode => 'locker', target => $target, phone_button => 0, fingerprint_button => 0, biometric_button => 0, phone_key => 0 %>
	</div>

	<div id="locked_help">
		<%= &subs::ui('Press Unlock to ask your phone or laptop, or use the recovery code.') %>
		<div id="locked_actions">
			<button id="locked_unlock_request" type="button" hint="Unlock on my phone or laptop" aria-label="<%= &subs::ui('Unlock on my phone or laptop') %>"><%= &subs::ui('Unlock') %></button>
			<% if ($fingerprint && &subs::device_setter() ne 'mobile') { %>
				<button id="locked_fingerprint" type="button" hint="Use this computer's fingerprint" aria-label="Use this computer's fingerprint"><img src="<%= &subs::icon_for('/images/decipherable/fingerprint.svg') %>" alt=""></button>
			<% } %>
			<button id="locked_biometric" type="button" data-enrolled="<%= $bio_enrolled ? 1 : 0 %>" hint="Use this phone's fingerprint" aria-label="Use this phone's fingerprint" style="display:none;"><img src="<%= &subs::icon_for('/images/decipherable/fingerprint.svg') %>" alt=""></button>
		</div>
		<div id="locked_phone_status"></div>
	</div>

	<details id="locked_recovery">
		<summary><%= &subs::ui('Recovery code or house password') %></summary>
		<input id="locked_recovery_code" autocomplete="off" spellcheck="false" placeholder="<%= &subs::ui('paper code or house password') %>">
		<button id="locked_recovery_go">Unlock</button>
		<div id="locked_status"></div>
	</details>
</div>

<style>
	#locked_screen {
		position: fixed;
		inset: 0;
		background-color: #101010;
		color: #f4f4f4;
		font-family: sans-serif;
		overflow: hidden;
	}
	#locked_heading {
		position: fixed;
		top: 2%;
		left: 0;
		right: 0;
		text-align: center;
		font-size: 20px;
		z-index: 60002;
	}
	#locked_help {
		position: fixed;
		bottom: 1%;
		left: 0;
		right: 0;
		text-align: center;
		font-size: 15px;
		line-height: 1.35;
		padding: 0 8px;
		z-index: 60002;
	}
	/* the actions: Unlock asks another device, a fingerprint uses this reader */
	#locked_actions {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 14px;
		margin-top: 8px;
	}
	#locked_actions button {
		width: 64px;
		height: 64px;
		margin: 0;
		padding: 7px;
		box-sizing: border-box;
		border-radius: 14px;
		border: 1px solid #555;
		background-color: #1a1a1a;
		cursor: pointer;
		line-height: 0;
	}
	#locked_actions img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}
	/* the one explicit ask: a word, not only a picture, so it reads as the way
	   to unlock from the table it is on */
	#locked_actions #locked_unlock_request {
		width: auto;
		height: auto;
		padding: 12px 30px;
		font-size: 17px;
		line-height: 1.1;
		border-color: #2b6;
		background-color: #2b6;
		color: #08110a;
		font-weight: bold;
	}
	#locked_fingerprint,
	#locked_biometric {
		background-color: #101a12;
		border-color: #2b6;
	}
	/* ready to be scanned: the fingerprint control breathes a green glow */
	@keyframes locked_fingerprint_glow {
		0%, 100% { box-shadow: 0 0 0 0 rgba(43, 187, 102, 0.10); }
		50% { box-shadow: 0 0 16px 5px rgba(43, 187, 102, 0.65); }
	}
	#locked_fingerprint:not(:disabled),
	#locked_biometric:not(:disabled) {
		animation: locked_fingerprint_glow 1.8s ease-in-out infinite;
	}
	#locked_fingerprint:disabled,
	#locked_biometric:disabled {
		animation: none;
		opacity: 0.55;
	}
	#locked_phone_status {
		margin-top: 4px;
		color: #ffd;
	}
	#locked_padlock {
		position: fixed;
		left: 50%;
		top: 50%;
		transform: translate(-50%, -50%);
		width: 300px;
	}
	#locked_padlock .padlock_frame {
		position: relative;
		left: auto;
		top: auto;
		transform: none;
		width: 100%;
	}
	#locked_recovery {
		position: fixed;
		right: 1%;
		top: 1%;
		width: 290px;
		z-index: 60003;
		background-color: rgba(28, 28, 34, 0.95);
		border-radius: 8px;
		padding: 10px;
		font-size: 14px;
	}
	#locked_recovery input {
		width: 100%;
		font-size: 16px;
		padding: 6px;
		box-sizing: border-box;
		/* this page has no universal.css and is always dark, so the field
		   follows its own surface instead of the browser's white default */
		background-color: #222;
		color: #f4f4f4;
		border: 1px solid #666;
		border-radius: 6px;
	}
	#locked_recovery button {
		font-size: 16px;
		padding: 6px 12px;
		margin-top: 6px;
	}
	#locked_status {
		margin-top: 6px;
		color: #ffd;
	}
</style>

<script>
(function () {
	function b64(buf) {
		var bytes = new Uint8Array(buf);
		var s = '';
		for (var i = 0; i < bytes.length; i++) { s += String.fromCharCode(bytes[i]); }
		return btoa(s);
	}
	function status(text) {
		var el = document.getElementById('locked_status');
		if (el) { el.textContent = text || ''; }
	}
	// the phone's fingerprint button belongs to the Android app; the computer's
	// belongs to the machine with the reader
	var bio = document.getElementById('locked_biometric');
	// show it when the native Keystore bridge is here, or when the house says
	// this phone has an enrolled fingerprint (the click then explains if the
	// page is a plain browser without the app's bridge)
	if (bio && (window.JawnBiometricKey || bio.getAttribute('data-enrolled') === '1')) { bio.style.display = ''; }
	var localfp = document.getElementById('locked_fingerprint');
	// the reader belongs to the machine it is attached to; hide it on a phone
	// even when the shared lock HTML was rendered by a computer
	function hideLocalFingerprint() {
		if (localfp && typeof jawnMobileHere === 'function' && jawnMobileHere()) { localfp.style.display = 'none'; }
	}
	hideLocalFingerprint();
	document.addEventListener('DOMContentLoaded', hideLocalFingerprint);
	setTimeout(hideLocalFingerprint, 0);
	var go = document.getElementById('locked_recovery_go');
	if (go) {
		go.addEventListener('click', function () {
			var code = (document.getElementById('locked_recovery_code').value || '').trim();
			if (!code) { status('Type the code first.'); return; }
			if (!(window.crypto && crypto.subtle && crypto.subtle.generateKey)) {
				status('This browser cannot hold a device key.');
				return;
			}
			status('Checking...');
			crypto.subtle.generateKey({ name: 'Ed25519' }, false, ['sign', 'verify']).then(function (pair) {
				return crypto.subtle.exportKey('spki', pair.publicKey).then(function (spki) {
					var body = new URLSearchParams({ code: code, password: code, pubkey: b64(spki), name: 'Recovered Device' });
					return fetch('/manager/device/recover', {
						method: 'POST',
						headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
						body: body
					});
				}).then(function (r) { return r.json(); }).then(function (res) {
					if (res && res.ok) {
						status('Unlocked. Loading...');
						window.location.reload();
					}
					else {
						status(res && res.error === 'too many' ? 'Too many tries. Wait a while.' : 'That code was not accepted.');
					}
				});
			}).catch(function () { status('That code was not accepted.'); });
		});
	}
	var sendPhone = document.getElementById('locked_unlock_request');
	var lockedTarget = '<%= $target %>';
	if (sendPhone) {
		sendPhone.addEventListener('click', function () {
			var note = document.getElementById('locked_phone_status');
			if (typeof padlockAskPhone === 'function') { padlockAskPhone('locker', lockedTarget); }
			if (note) { note.textContent = <%== &subs::json_chars(&subs::ui('Sent. Confirm the fingerprint on your phone or laptop.')) %>; }
		});
	}
	var fp = document.getElementById('locked_fingerprint');
	if (fp) {
		var note = document.getElementById('locked_phone_status');
		var t = function (text) {
			return (typeof jawnosT === 'function') ? jawnosT(text) : text;
		};
		var finish = function (res) {
			if (res && res.ok) {
				// the print was accepted: the shackle opens, then the page follows
				if (typeof jawnPadlockArtUnlocking === 'function') { jawnPadlockArtUnlocking(fp); }
				if (note) { note.textContent = t('Unlocked. Loading...'); }
				setTimeout(function () { window.location.reload(); }, 700);
				return;
			}
			fp.disabled = false;
			if (typeof jawnPadlockArtLocked === 'function') { jawnPadlockArtLocked(true, fp); }
			if (note) {
				var e = (res && res.error) || '';
				note.textContent = (e === 'busy') ? t('A fingerprint is already being read.')
					: (e === 'timeout') ? t('No fingerprint was read. Try again.')
					: (e === 'local only') ? t('This reader only works on the computer it is attached to.')
					: (e === 'no fingerprint') ? t('No fingerprint is enrolled on this computer.')
					: (e === 'not signed in') ? t('Sign in again, then use the fingerprint.')
					: t('Fingerprint not accepted.');
			}
		};
		var poll = function (token, tries) {
			tries = tries || 0;
			fetch('/manager/security/fingerprint_unlock_status?token=' + encodeURIComponent(token), { cache: 'no-store' })
				.then(function (r) { return r.json(); })
				.then(function (res) {
					if (res && res.pending) {
						if (tries > 30) { finish({ ok: 0, error: 'timeout' }); return; }
						setTimeout(function () { poll(token, tries + 1); }, 700);
						return;
					}
					finish(res);
				})
				.catch(function () { finish({ ok: 0, error: 'unavailable' }); });
		};
		fp.addEventListener('click', function () {
			fp.disabled = true;
			if (typeof jawnPadlockArtLocked === 'function') { jawnPadlockArtLocked(false, fp); }
			if (note) { note.textContent = t('Touch the fingerprint reader now...'); }
			fetch('/manager/security/fingerprint_unlock', {
				method: 'POST',
				headers: { 'X-Requested-With': 'XMLHttpRequest' }
			}).then(function (r) { return r.json(); }).then(function (res) {
				if (res && res.pending && res.token) { poll(res.token, 0); return; }
				finish(res);
			}).catch(function () { finish({ ok: 0, error: 'unavailable' }); });
		});
	}
	// the phone signs this machine open in the background; this page follows it.
	// The websocket padlock_open stops this loop when it arrives first; the loop
	// is the fallback when a handheld's worker is not listening.
	if (typeof jawnPadlockKeyCheck === 'function') { jawnPadlockKeyCheck(true); }
	if (!window.jawnLockedPoller) {
		window.jawnLockedPoller = setInterval(function () {
			// a request for another screen arrives while this one is showing its
			// own lock; the locked page has no websocket, so this is its poll
			if (typeof jawnPadlockKeyCheck === 'function') { jawnPadlockKeyCheck(true); }
			fetch('/manager/security/padlock_state', { cache: 'no-store' }).then(function (r) {
				return r.json();
			}).then(function (s) {
				if (s && s.ok && !s.locked) { window.location.reload(); }
			}).catch(function () {});
		}, 2500);
	}
})();
</script>
