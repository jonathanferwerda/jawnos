<html>
	<style>
		html, body { margin: 0; height: 100%; background: #000; overflow: hidden; }
		/* the mark, front and centre, with a warm glow behind it - no pause, the
		   destination loads right after */
		#stage {
			position: fixed; inset: 0;
			display: flex; align-items: center; justify-content: center;
			background: radial-gradient(circle at 50% 46%,
				rgba(255, 204, 0, .17) 0%, rgba(255, 204, 0, .05) 36%, #000 68%);
			animation: jawn_in .18s ease-out both;
		}
		#jawn_mark {
			height: 46vh; max-width: 46vw;
			filter: drop-shadow(0 0 46px rgba(255, 204, 0, .42));
		}
		@keyframes jawn_in { from { opacity: 0; } to { opacity: 1; } }
	</style>
	<div id="stage">
		<img id="jawn_mark" src="<%= $logo || &subs::icon_for('/images/jbuttons/logo1.png') %>">
	</div>
	<div id="box_office_stash" style="display:none;">
		<%= $js %>
	</div>
	<div id="box_office_dump"></div>
	<script>
			var js = $('#box_office_stash').text();
			var jso = JSON.parse(js);
			try { gateKeeper(jso); } catch (e) { console.log(e); }
			setTimeout(function () { window.location = jso['redirector']; }, 350);
	</script>
</html>
