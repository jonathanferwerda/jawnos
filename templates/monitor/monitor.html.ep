<style>
#monitor { flex: 1 1 auto; min-width: 0; height: 100%; display: flex; flex-direction: column; overflow: hidden; font-size: 20px; }
#monitor .monitor_health { flex: 0 0 auto; padding: 6px 12px; border-bottom: solid 1px rgba(0,0,0,0.25); font-size: 16px; line-height: 1.6; }
#monitor .monitor_health .monitor_health_item { display: inline-block; margin-right: 14px; white-space: nowrap; }
#monitor .monitor_health b { opacity: 0.55; font-weight: normal; margin-right: 4px; }
#monitor .monitor_gauges { flex: 0 0 auto; padding: 9px 12px 6px; border-bottom: solid 1px rgba(0,0,0,0.25); }
#monitor .monitor_graph_label { font-size: 15px; opacity: 0.8; margin-bottom: 5px; }
#monitor .monitor_cores { display: flex; flex-wrap: wrap; gap: 6px; }
#monitor .monitor_core { border: solid; border-width: 1px; border-radius: 4px; padding: 2px 3px 0; }
#monitor .monitor_core canvas { display: block; width: 72px; height: 39px; }
#monitor .monitor_core .monitor_core_label { display: block; font-size: 14px; text-align: center; line-height: 15px; }
#monitor .monitor_core_wide { flex: 1 1 100%; }
#monitor .monitor_core_wide canvas { width: 100%; height: 60px; }
#monitor .monitor_mem { margin-top: 8px; }
#monitor .monitor_mem canvas { display: block; width: 100%; height: 45px; }
#monitor .monitor_list { flex: 1 1 auto; overflow: auto; }
#monitor table { width: 100%; border-collapse: collapse; }
#monitor thead th { position: sticky; top: 0; background: var(--panel-2, #eee); cursor: pointer; -webkit-user-select: none; user-select: none; text-align: left; padding: 3px 6px; font-size: 18px; white-space: nowrap; }
#monitor td { padding: 2px 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#monitor td.monitor_name { max-width: 0; width: 100%; }
#monitor tr:nth-child(even) td { background: rgba(0,0,0,0.04); }
</style>
<div id="monitor" app="process_monitor">
	<div class="monitor_health" id="monitor_health">
		<span class="monitor_health_item"><b>jawn</b><span data-h="processes">&mdash;</span></span>
		<span class="monitor_health_item"><b>battery</b><span data-h="battery">&mdash;</span></span>
		<span class="monitor_health_item"><b>state</b><span data-h="state">&mdash;</span></span>
		<span class="monitor_health_item"><b>temp</b><span data-h="temp">&mdash;</span></span>
		<span class="monitor_health_item"><b>voltage</b><span data-h="voltage">&mdash;</span></span>
		<span class="monitor_health_item"><b>current</b><span data-h="current">&mdash;</span></span>
		<span class="monitor_health_item"><b>health</b><span data-h="health">&mdash;</span></span>
		<span class="monitor_health_item"><b>load</b><span data-h="load">&mdash;</span></span>
		<span class="monitor_health_item"><b>uptime</b><span data-h="uptime">&mdash;</span></span>
		<span class="monitor_health_item"><b>sync</b><span data-h="sync">&mdash;</span></span>
		<span class="monitor_health_item"><b>peers</b><span data-h="peers">&mdash;</span></span>
		<span class="monitor_health_item"><b>db</b><span data-h="db">&mdash;</span></span>
		<span class="monitor_health_item"><b>wal</b><span data-h="wal">&mdash;</span></span>
		<span class="monitor_health_item"><b>v</b><span data-h="version">&mdash;</span></span>
	</div>
	<div class="monitor_gauges">
		<div class="monitor_graph_label">CPU <span id="monitor_cpu_total">&mdash;</span> &nbsp; MEM <span id="monitor_mem_pct">&mdash;</span></div>
		<div class="monitor_cores" id="monitor_cores"></div>
		<div class="monitor_mem"><canvas id="monitor_mem_canvas" height="45"></canvas></div>
	</div>
	<div class="monitor_list">
		<table>
			<thead>
				<tr>
					<th class="monitor_sort" data-key="cpu" style="text-align:right;">CPU %</th>
					<th class="monitor_sort" data-key="mem" style="text-align:right;">MEM %</th>
					<th class="monitor_sort" data-key="age" style="text-align:right;">AGE</th>
					<th class="monitor_sort" data-key="pid" style="text-align:right;">PID</th>
					<th class="monitor_sort" data-key="name">COMMAND</th>
				</tr>
			</thead>
			<tbody id="monitor_body">
				<tr><td colspan="5">sampling&hellip;</td></tr>
			</tbody>
		</table>
	</div>
</div>
