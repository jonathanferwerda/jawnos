<div id="editor" class="editor_surface">
	<div class="editor_head">
		<select id="editor_article_picker" aria-label="<%= &subs::ui('Article') %>" hint="<%= &subs::ui('Article') %>">
			<option value="none" <% if (!($current->{'uuid'} // '') || ($current->{'uuid'} // '') eq 'none') { %>selected<% } %>><%= &subs::ui('New article') %></option>
			<% foreach my $a ( @{$articles} ) { %>
				<option <% if (($a->{'uuid'} // '') eq ($current->{'uuid'} // '')) { %>selected <% } %> value="<%= $a->{'uuid'} %>"><%= $a->{'title'} || &subs::ui('Untitled') %></option>
			<% } %>
		</select>
		<button type="button" id="editor_new" class="editor_button" hint="<%= &subs::ui('New article') %>"><%= &subs::ui('New') %></button>
		<button type="button" id="editor_save" class="editor_button editor_button_primary" hint="<%= &subs::lang('save') %>"><%= &subs::lang('save') %></button>
		<button type="button" id="editor_delete" class="editor_button editor_button_quiet" hint="<%= &subs::ui('Delete this article') %>"><%= &subs::ui('Delete') %></button>
		<span id="editor_save_state" class="editor_save_state" aria-live="polite"></span>
	</div>

	<div class="editor_bar editor_bar_blocks" role="toolbar" aria-label="<%= &subs::ui('Text style') %>">
		<% foreach my $style ( [ 'h1', &subs::ui('Headline') ], [ 'h2', &subs::ui('Subhead') ], [ 'p', &subs::ui('Body') ], [ 'blockquote', &subs::ui('Quote') ], [ 'figcaption', &subs::ui('Caption') ] ) { %>
			<button type="button" class="editor_style_button" data-block="<%= $style->[0] %>" hint="<%= $style->[1] %>"><%= $style->[1] %></button>
		<% } %>
		<span class="editor_bar_separator"></span>
		<button type="button" id="editor_add_text" class="editor_button" hint="<%= &subs::ui('Add a paragraph at the end') %>">+ <%= &subs::ui('Text') %></button>
		<button type="button" id="editor_add_media" class="editor_button" hint="<%= &subs::ui('Add a picture, a track or a video') %>">+ <%= &subs::ui('Media') %></button>
		<button type="button" id="editor_add_divider" class="editor_button editor_button_quiet" hint="<%= &subs::ui('Add a dividing rule') %>"><%= &subs::ui('Rule') %></button>
		<input type="file" id="editor_file_picker" class="editor_file_picker" multiple accept="image/*,video/*,audio/*">
	</div>

	<div id="editor_content_parent" class="editor_content_parent">
		<div id="editor_content_area" class="editor_content_area" contenteditable="true" role="textbox" aria-multiline="true" aria-label="<%= &subs::ui('Article body') %>" spellcheck="true" data-placeholder="<%= &subs::ui('Write the article here, or drop a picture, a track or a video onto the page.') %>"></div>
		<div id="editor_block_grip" class="editor_block_grip" draggable="true" aria-hidden="true" hint="<%= &subs::ui('Drag to move this block') %>">&#8942;&#8942;</div>
	</div>

	<div class="editor_bar editor_bar_fields">
		<label class="editor_field" for="editor_text_colour"><%= &subs::ui('Text colour') %>
			<input value="<%= $current->{'text_colour'} || '#000000' %>" type="color" class="editor_colour_picker" id="editor_text_colour">
		</label>
		<label class="editor_field" for="editor_background_colour"><%= &subs::ui('Background colour') %>
			<input value="<%= $current->{'background_colour'} || '#ffffff' %>" type="color" class="editor_colour_picker" id="editor_background_colour">
		</label>
		<label class="editor_field" for="editor_category_picker"><%= &subs::ui('Category') %>
			<select id="editor_category_picker">
				<option <% if (($current->{'category'} // '') eq 'promo') { %>selected<% } %> value="promo">Promo</option>
				<% foreach my $cat ( @{$magazine_categories} ) { %>
					<option <% if (($current->{'category'} // '') eq lc($cat->{'app'} // '')) { %>selected<% } %> value="<%= lc($cat->{'app'} // '') %>"><%= &subs::format_name($cat->{'app'}) %></option>
				<% } %>
			</select>
		</label>
		<label class="editor_field" for="editor_status_picker"><%= &subs::ui('Status') %>
			<select id="editor_status_picker">
				<% foreach my $status ( qw/draft review publish recanted/ ) { %>
					<option <% if (($current->{'status'} // 'draft') eq $status) { %>selected<% } %> value="<%= $status %>"><%= &subs::format_name($status) %></option>
				<% } %>
			</select>
		</label>
		<label class="editor_field" for="editor_timestamp"><%= &subs::ui('Time') %>
			<input type="text" id="editor_timestamp" class="time" timestamp="<%= $current->{'timestamp'} || (time() * 1000) %>" value="<%= $current->{'timestamp'} %>">
		</label>
		<label class="editor_field" for="editor_warranty"><%= &subs::ui('Warranty') %>
			<input type="text" id="editor_warranty" class="time" timestamp="<%= $current->{'warranty'} || (time() * 1000) %>" value="<%= $current->{'warranty'} %>">
		</label>
	</div>

	<div id="editor_stored_content" class="editor_stored_content" hidden><%= $current->{'content'} || '' %></div>
</div>
