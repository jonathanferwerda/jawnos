<% my @day_letters = qw/S M T W T F S/; %>

<div id="clock_app" class="clock_app" data-clock-tab="<%= $tab %>">
	<div class="clock_tabbar" role="tablist">
		<button type="button" class="clock_tab <%= $tab eq 'alarm' ? 'selected' : '' %>" data-clock-tab="alarm" role="tab" aria-selected="<%= $tab eq 'alarm' ? 'true' : 'false' %>">
			<img src="<%= &subs::icon_path('alarm', '/icons/alarm.svg') %>" alt=""><span><%= &subs::lang('alarm') %></span>
		</button>
		<button type="button" class="clock_tab <%= $tab eq 'stopwatch' ? 'selected' : '' %>" data-clock-tab="stopwatch" role="tab" aria-selected="<%= $tab eq 'stopwatch' ? 'true' : 'false' %>">
			<img src="<%= &subs::icon_path('stopwatch', '/icons/stopwatch.svg') %>" alt=""><span><%= &subs::lang('stopwatch') %></span>
		</button>
		<button type="button" class="clock_tab <%= $tab eq 'timer' ? 'selected' : '' %>" data-clock-tab="timer" role="tab" aria-selected="<%= $tab eq 'timer' ? 'true' : 'false' %>">
			<img src="<%= &subs::icon_path('timer', '/icons/timer.svg') %>" alt=""><span><%= &subs::lang('timer') %></span>
		</button>
		<button type="button" class="clock_tab <%= $tab eq 'world' ? 'selected' : '' %>" data-clock-tab="world" role="tab" aria-selected="<%= $tab eq 'world' ? 'true' : 'false' %>">
			<img src="<%= &subs::icon_path('world_clock', '/icons/world_clock.svg') %>" alt=""><span><%= &subs::lang('world_clock') %></span>
		</button>
	</div>

	<div class="clock_panels">
		<section class="clock_panel <%= $tab eq 'alarm' ? 'selected' : '' %>" data-clock-panel="alarm" role="tabpanel">
			<div class="clock_panel_head">
				<span class="clock_count"><%= scalar @{$alarms} %>/<%= $max %></span>
				<button type="button" class="clock_add clock_add_alarm"<%= scalar @{$alarms} >= $max ? ' disabled' : '' %>><%= &subs::lang('add_alarm') %></button>
			</div>
			<div class="clock_alarm_list">
				<% foreach my $alarm ( @{$alarms} ) { %>
					<% my $is_on = $alarm->{'enabled'} ? 1 : 0; %>
					<% my %on_machine = map { $_ => 1 } @{ $alarm->{'machines'} || [] }; %>
					<div class="clock_alarm<%= $is_on ? '' : ' off' %>" data-uuid="<%= $alarm->{'uuid'} %>" data-enabled="<%= $is_on %>">
						<div class="clock_alarm_head" role="button" tabindex="0" aria-expanded="false">
							<button type="button" class="clock_alarm_caret" tabindex="-1" aria-hidden="true"></button>
							<span class="clock_alarm_head_time"><%= sprintf('%02d:%02d', $alarm->{'hour'}, $alarm->{'minute'}) %></span>
							<span class="clock_alarm_head_label"><%= $alarm->{'label'} %></span>
							<span class="clock_alarm_head_devices">
								<% foreach my $m ( @{$machines} ) { %>
									<% next unless $on_machine{$m->{'value'}}; %>
									<% my $ack = $alarm->{'delivered'} ? $alarm->{'delivered'}{$m->{'value'}} : undef; %>
									<% my $ack_time = (defined $ack && $ack) ? sprintf('%02d:%02d', (localtime($ack / 1000))[2], (localtime($ack / 1000))[1]) : ''; %>
									<span class="clock_machine_pill<%= $ack_time ne '' ? ' confirmed' : '' %>" data-machine="<%= $m->{'value'} %>"<% if ($ack_time ne '') { %> title="<%= &subs::lang('delivered') %> <%= $ack_time %>"<% } %>><%= $m->{'label'} %><%= $ack_time ne '' ? ' ✓' : '' %></span>
								<% } %>
							</span>
							<label class="clock_switch" hint="<%= &subs::lang('alarm') %>"><input type="checkbox" class="clock_alarm_enabled"<%= $is_on ? ' checked' : '' %>></label>
						</div>
						<div class="clock_alarm_body">
						<div class="clock_alarm_line">
							<input type="text" inputmode="numeric" maxlength="5" autocomplete="off" pattern="[0-9:]*" placeholder="HH:MM" class="clock_alarm_time" value="<%= sprintf('%02d:%02d', $alarm->{'hour'}, $alarm->{'minute'}) %>" aria-label="<%= &subs::lang('alarm') %>">
							<input type="text" class="clock_alarm_label" value="<%= $alarm->{'label'} %>" maxlength="20" aria-label="<%= &subs::lang('label') %>">
						</div>
						<div class="clock_alarm_days" role="group" aria-label="<%= &subs::lang('days') %>">
							<% my $has_days = scalar @{ $alarm->{'days'} }; %>
							<% for my $d (0 .. 6) { %>
								<% my $on = grep { $_ == $d } @{ $alarm->{'days'} }; %>
								<button type="button" class="clock_day<%= $on ? ' on' : '' %>" data-day="<%= $d %>" aria-pressed="<%= $on ? 'true' : 'false' %>"><%= $day_letters[$d] %></button>
							<% } %>
							<button type="button" class="clock_day clock_day_once<%= $has_days ? '' : ' on' %>" data-once="yes" aria-pressed="<%= $has_days ? 'false' : 'true' %>"><%= &subs::lang('once') %></button>
						</div>
						<div class="clock_alarm_when">
							<span class="clock_alarm_next" data-next="<%= $alarm->{'next_at'} || 0 %>"></span>
							<button type="button" class="clock_alarm_skip" hint="<%= &subs::lang('skip_today') %>"><%= &subs::lang('skip_today') %></button>
							<button type="button" class="clock_alarm_delete" hint="<%= &subs::lang('delete') %>" aria-label="<%= &subs::lang('delete') %>">✕</button>
						</div>
						<div class="clock_alarm_extra">
							<label class="clock_field">
								<span><%= &subs::lang('link_appointment') %></span>
								<div class="clock_app_picker">
									<input type="text" class="clock_alarm_app" autocomplete="off" data-app="<%= $alarm->{'app'} %>" value="<%= $alarm->{'app'} ? &subs::format_name($alarm->{'app'}) : '' %>" placeholder="<%= &subs::lang('no_appointment') %>">
									<button type="button" class="clock_app_toggle" tabindex="-1" aria-label="<%= &subs::lang('link_appointment') %>">▾</button>
								</div>
							</label>
							<% my $alarm_play = ($alarm->{'play'} || '') eq 'math' ? 'math' : ''; %>
							<% my $alarm_nfc = $alarm->{'nfc'} ? 1 : 0; %>
							<% my $alarm_nfc_action = ($alarm->{'nfc_action'} || '') eq 'dismiss' ? 'dismiss' : 'snooze'; %>
							<% my $alarm_nfc_tag = ($nfc_apps && $alarm->{'app'} && $nfc_apps->{ $alarm->{'app'} }) ? 1 : 0; %>
							<label class="clock_field">
								<span><%= &subs::lang('play_mode') %></span>
								<select class="clock_alarm_play">
									<option value=""<%= $alarm_play eq 'math' ? '' : ' selected' %>><%= &subs::lang('none') %></option>
									<option value="math"<%= $alarm_play eq 'math' ? ' selected' : '' %>><%= &subs::lang('math') %></option>
								</select>
							</label>
							<label class="clock_field clock_alarm_nfc_field"<%== ($alarm_nfc_tag || $alarm_nfc) ? '' : ' style="display:none;"' %>>
								<span><%= &subs::lang('use_nfc_to_snooze') %></span>
								<div class="clock_nfc_row">
									<input type="checkbox" class="clock_alarm_nfc"<%= $alarm_nfc ? ' checked' : '' %><%= ($alarm_nfc_tag || $alarm_nfc) ? '' : ' disabled' %>>
									<select class="clock_alarm_nfc_action" aria-label="<%= &subs::lang('nfc_action') %>"<%== $alarm_nfc ? '' : ' style="display:none;"' %>>
										<option value="snooze"<%= $alarm_nfc_action eq 'dismiss' ? '' : ' selected' %>><%= &subs::lang('snooze') %></option>
										<option value="dismiss"<%= $alarm_nfc_action eq 'dismiss' ? ' selected' : '' %>><%= &subs::lang('dismiss') %></option>
									</select>
								</div>
								<span class="clock_nfc_hint"<%== $alarm_nfc_tag ? ' style="display:none;"' : '' %>><%= &subs::ui('Link an appointment with an NFC start tag to use this.') %></span>
							</label>
							<label class="clock_field clock_alarm_machines">
								<span><%= &subs::lang('shared_with') %></span>
								<div class="clock_machine_list" role="group" aria-label="<%= &subs::lang('shared_with') %>">
									<% foreach my $m ( @{$machines} ) { %>
										<% my $on = $on_machine{$m->{'value'}} ? 1 : 0; %>
										<button type="button" class="clock_machine<%= $on ? ' on' : '' %>" data-machine="<%= $m->{'value'} %>" aria-pressed="<%= $on ? 'true' : 'false' %>"><%= $m->{'label'} %></button>
									<% } %>
								</div>
							</label>
							<label class="clock_field">
								<span><%= &subs::lang('sound') %></span>
								<div class="clock_sound_row">
									<select class="clock_alarm_sound">
										<% foreach my $s ( @{$alarm_sounds} ) { %>
											<option value="<%= $s->{'value'} %>"<%= ($alarm->{'sound'} || '') eq $s->{'value'} ? ' selected' : '' %>><%= $s->{'label'} %></option>
										<% } %>
									</select>
									<button type="button" class="clock_alarm_preview" hint="<%= &subs::lang('preview') %>"><%= &subs::lang('preview') %></button>
								</div>
							</label>
							<label class="clock_field">
								<span><%= &subs::lang('volume') %> · <%= $alarm->{'volume'} %>%</span>
								<input type="range" min="5" max="100" step="5" class="clock_alarm_volume" inputmode="none" data-soft_keyboard="off" aria-label="<%= &subs::lang('volume') %>" value="<%= $alarm->{'volume'} %>">
							</label>
							<label class="clock_field">
								<span><%= &subs::lang('ramp') %> · <%= $alarm->{'ramp'} %>s</span>
								<input type="number" inputmode="numeric" min="0" max="600" step="5" class="clock_alarm_ramp" value="<%= $alarm->{'ramp'} %>">
							</label>
							<label class="clock_field">
								<span><%= &subs::lang('snooze_length') %></span>
								<input type="number" inputmode="numeric" min="1" max="60" step="1" class="clock_alarm_snooze" value="<%= $alarm->{'snooze'} || 5 %>" aria-label="<%= &subs::lang('snooze') %>">
							</label>
						</div>
						</div>
					</div>
				<% } %>
				<% if (!scalar @{$alarms}) { %>
					<div class="clock_empty"><%= &subs::ui('No alarms yet - add one and it will be waiting for you here.') %></div>
				<% } %>
			</div>
		</section>

		<section class="clock_panel <%= $tab eq 'stopwatch' ? 'selected' : '' %>" data-clock-panel="stopwatch" role="tabpanel">
			<div class="clock_stopwatch">
				<div class="clock_sw_display">00:00:00.00</div>
				<div class="clock_sw_buttons">
					<button type="button" class="clock_sw_start"><%= &subs::lang('start') %></button>
					<button type="button" class="clock_sw_lap"><%= &subs::lang('lap') %></button>
					<button type="button" class="clock_sw_reset"><%= &subs::lang('reset') %></button>
				</div>
				<div class="clock_sw_laps"></div>
			</div>
		</section>

		<section class="clock_panel <%= $tab eq 'timer' ? 'selected' : '' %>" data-clock-panel="timer" role="tabpanel">
			<div class="clock_panel_head">
				<span class="clock_count"><%= $running_timers %>/<%= $max %></span>
				<button type="button" class="clock_clear_finished"><%= &subs::lang('clear_finished') %></button>
			</div>
			<div class="clock_timer_new">
				<input type="number" inputmode="numeric" class="clock_timer_hours" min="0" max="99" step="1" placeholder="<%= &subs::lang('hours') %>" aria-label="<%= &subs::lang('hours') %>">
				<input type="number" inputmode="numeric" class="clock_timer_minutes" min="0" max="59" step="1" placeholder="<%= &subs::lang('minutes') %>" aria-label="<%= &subs::lang('minutes') %>">
				<input type="number" inputmode="numeric" class="clock_timer_seconds" min="0" max="59" step="1" placeholder="<%= &subs::lang('seconds') %>" aria-label="<%= &subs::lang('seconds') %>">
				<input type="text" class="clock_timer_label" maxlength="120" placeholder="<%= &subs::lang('label') %>" aria-label="<%= &subs::lang('label') %>">
				<div class="clock_app_picker">
					<input type="text" class="clock_timer_app" autocomplete="off" data-app="" placeholder="<%= &subs::lang('link_appointment') %>" aria-label="<%= &subs::lang('link_appointment') %>">
					<button type="button" class="clock_app_toggle" tabindex="-1" aria-label="<%= &subs::lang('link_appointment') %>">▾</button>
				</div>
				<label class="clock_field clock_timer_volume_field">
					<span><%= &subs::lang('volume') %> · 70%</span>
					<input type="range" min="5" max="100" step="5" class="clock_timer_volume" inputmode="none" data-soft_keyboard="off" aria-label="<%= &subs::lang('volume') %>" value="70">
				</label>
				<button type="button" class="clock_add clock_add_timer"<%= $running_timers >= $max ? ' disabled' : '' %>><%= &subs::lang('add_timer') %></button>
			</div>
			<div class="clock_presets">
				<button type="button" class="clock_preset" data-preset="60"><%= &subs::ui('1 min') %></button>
				<button type="button" class="clock_preset" data-preset="300"><%= &subs::ui('5 min') %></button>
				<button type="button" class="clock_preset" data-preset="600"><%= &subs::ui('10 min') %></button>
				<button type="button" class="clock_preset" data-preset="900"><%= &subs::ui('15 min') %></button>
				<button type="button" class="clock_preset" data-preset="1500"><%= &subs::ui('25 min') %></button>
				<button type="button" class="clock_preset" data-preset="3600"><%= &subs::ui('1 hour') %></button>
			</div>
			<div class="clock_timer_list">
				<% foreach my $timer ( @{$timers} ) { %>
					<% my $state = $timer->{'state'} || 'running'; %>
					<% my $remaining = $state eq 'running' && $timer->{'ends_at'} > $now ? int(($timer->{'ends_at'} - $now) / 1000) : 0; %>
					<div class="clock_timer state_<%= $state %>" data-uuid="<%= $timer->{'uuid'} %>" data-state="<%= $state %>" data-ends="<%= $timer->{'ends_at'} %>">
						<div class="clock_timer_top">
							<span class="clock_timer_countdown"><%= $state eq 'running' ? $fmt_seconds->($remaining) : '00:00' %></span>
							<span class="clock_timer_label_text">
								<%= $timer->{'label'} %>
								<% if ($timer->{'app'}) { %><span class="clock_timer_app_text"><%= &subs::lang('link_appointment') %>: <%= &subs::format_name($timer->{'app'}) %></span><% } %>
							</span>
							<% if ($state eq 'running') { %>
								<button type="button" class="clock_timer_action clock_timer_stop" hint="<%= &subs::lang('stop') %>"><%= &subs::lang('stop') %></button>
							<% } else { %>
								<div class="clock_timer_buttons">
									<button type="button" class="clock_timer_action clock_timer_restore" hint="<%= &subs::lang('restore') %>"><%= &subs::lang('restore') %></button>
									<button type="button" class="clock_timer_action clock_timer_remove" hint="<%= &subs::lang('delete') %>"><%= &subs::lang('delete') %></button>
								</div>
							<% } %>
						</div>
						<% if ($state ne 'running') { %>
							<div class="clock_timer_app_text"><%= $state eq 'done' ? &subs::lang('done') : &subs::lang('cancelled') %></div>
						<% } %>
					</div>
				<% } %>
				<% if (!scalar @{$timers}) { %>
					<div class="clock_empty"><%= &subs::ui('No timers yet - add one above, or press a preset.') %></div>
				<% } %>
			</div>
		</section>

		<section class="clock_panel <%= $tab eq 'world' ? 'selected' : '' %>" data-clock-panel="world" role="tabpanel">
			<div class="clock_world">
				<div class="clock_world_add">
					<input type="text" list="clock_zones" class="clock_world_zone" placeholder="<%= &subs::ui('City or time zone') %>" aria-label="<%= &subs::ui('City or time zone') %>">
					<button type="button" class="clock_world_add_button"><%= &subs::lang('add') %></button>
				</div>
				<div class="clock_world_list"></div>
				<datalist id="clock_zones"></datalist>
			</div>
		</section>
	</div>

</div>
<div id="clock_app_menu" role="listbox" aria-label="<%= &subs::lang('link_appointment') %>"></div>