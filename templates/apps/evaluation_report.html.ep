<%# a report is a headline with the rest folded behind it: the body's text is
    split so the apps it names come back as links, and format_name drops the
    underscores on the way %>
<% my $pieces = &subs::evaluation_report_pieces($report); %>
<% my $linked = $report->{'linked'}; %>
<div class="appointment_evaluation" app="<%= $app %>" style="border:solid;border-radius:5px;border-width:2px;padding:4px;margin-top:4px;text-align:left;font-size:110%;">
	<b class="evaluation_headline hover" hint="Tap to open the whole report" style="display:block;"><%= $pieces->{'headline'} || 'Evaluation' %></b>
	<div class="evaluation_body" style="display:none;white-space:pre-wrap;"><% foreach my $chunk (@{$pieces->{'chunks'}}) { %><% if ($chunk->{'app'}) { %><span class="evaluation_app_link hover" app="<%= $chunk->{'app'} %>" hint="Open <%= $chunk->{'text'} %>" style="text-decoration:underline;"><%= $chunk->{'text'} %></span><% } else { %><%= $chunk->{'text'} %><% } %><% } %><% if ($report->{'model'} || ($linked && $linked->{'construct'})) { %><i style="font-size:80%;"><% if ($linked && $linked->{'app'} && $linked->{'construct'}) { %><br>related to <span class="evaluation_app_link hover" app="<%= $linked->{'app'} %>" hint="Open <%= &subs::format_name($linked->{'app'}) %>" style="text-decoration:underline;"><%= &subs::format_name($linked->{'app'}) %></span> as <%= &subs::format_name($linked->{'construct'}) %><% } %><% if ($report->{'model'}) { %><br><%= $report->{'model'} %><% if ($report->{'machine'}) { %> on <%= $report->{'machine'} %><% } %> <span class="time" timestamp="<%= $report->{'timestamp'} %>"></span><% } %></i><% } %></div>
</div>
