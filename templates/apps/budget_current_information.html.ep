<% my $scope = &subs::format_name($budget->{'scope_name'} // ''); %>
<% my $status_colour = $budget->{'colour'} || 'yellow'; %>
<%# the report's percentages carry three decimals from percent_formatter; one is
    plenty to read, so they are trimmed for the panel only %>
<% my $trim = sub { my $s = shift; $s =~ s/(\d+\.\d)\d+/$1/g; return $s; }; %>
<%# the difference is in the budget's own measure (ms for a duration budget, a
    count, money, or a measure like 8681.139steps), so it wears the same
    formatting the budget does - precomputed server-side so the lookup never
    writes a measure's key into %{$gb::budget_modes} %>
<% my $diff = $improvement->{'formatted_difference'} || sprintf('%.3f', $improvement->{'difference'}); %>
<div data-budget-running="<%= ($running || 0) ? 1 : 0 %>" style="min-width:280px;font-size:95%;line-height:1.45;">
	<div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:6px;">
		<strong style="font-size:115%;"><%= $scope %> budget</strong>
		<span style="background-color:<%= $status_colour %>;color:<%= &subs::contrast_ink($status_colour) %>;border-radius:9px;padding:1px 9px;font-weight:700;white-space:nowrap;"><%= &subs::format_name($budget->{'status'}) %></span>
	</div>
	<table style="border-collapse:collapse;width:100%;">
		<tr>
			<td style="opacity:.6;white-space:nowrap;padding-right:8px;">This <%= $scope %></td>
			<td style="text-align:right;font-weight:700;white-space:nowrap;"><% if ($circumstance eq 'duration') { %><%== &subs::duration_readout($budget->{'value'} || 0) %><% } else { %><%= $budget->{'formatted_value'} %><% } %></td>
			<td style="opacity:.55;padding-left:6px;white-space:nowrap;">of <% if ($circumstance eq 'duration' && defined $budget->{'budgeted_display_ms'}) { %><%== &subs::duration_readout($budget->{'budgeted_display_ms'}) %>/<%= $budget->{'scope_name'} %><% } else { %><%= $budget->{'formatted_budgeted'} %><% } %></td>
		</tr>
		<%# the autocalc's own reading for this scope is the budget it would suggest.
		    Shown only when the set budget is the thing out of step with the actual
		    (over budget), and clickable - the value is the budget it would set. The
		    autocalc string is "<value>/<scope>"; the button carries the amount, the
		    measure, the scope and the direction apart, so the row editor and the
		    stored entry agree, and names the entry it replaces exactly. A fixed level
		    stays fixed - a weight is not a rate. %>
		<% my $over_budget = defined $budget->{'budgeted'} && $budget->{'budgeted'} > 0 && defined $budget->{'value'} && $budget->{'value'} > $budget->{'budgeted'}; %>
		<% my $suggested = $autocalc->{($budget->{'scope_name'} // '')}->{'formatted_result'}; %>
		<% if ($over_budget && defined $suggested) { %>
		<% $suggested =~ s{/[^/]*$}{}; %>
		<%# the row editor wants the amount and the measure apart, the entry it writes
		    wants them together - so the button carries both. The scope and the
		    direction ride along, or a recommended entry would save as a fixed level. %>
		<% my $form_measure = ($circumstance eq 'occurences') ? '' : (($circumstance eq 'total') ? '$' : $circumstance); %>
		<% my $form_amount = $suggested; %>
		<% if ($form_measure eq '$') { $form_amount =~ s/^\$//; } elsif ($form_measure ne '' && $form_measure ne 'duration') { $form_amount =~ s/\Q$form_measure\E$//; } %>
		<% my $form_scope = $budget->{'fixed'} ? '' : ($budget->{'scope_name'} // ''); %>
		<tr>
			<td style="opacity:.6;white-space:nowrap;padding-right:8px;">Recommended</td>
			<td style="text-align:right;white-space:nowrap;">
				<button class="budget_autocalc_accept" app="<%= $autocalc->{'data'}->{'app'} %>" circumstance="<%= $circumstance %>" amount="<%= $form_amount %>" measure="<%= $form_measure %>" scope="<%= $form_scope %>" direction="<%= $budget->{'direction'} || 'floor' %>" previous="<%= $budget->{'budget'} %>" title="Set this budget" style="font:inherit;font-weight:700;color:#b8860b;background:rgba(184,134,11,.12);border:1px solid rgba(184,134,11,.5);border-radius:6px;padding:1px 8px;cursor:pointer;white-space:nowrap;"><% if ($circumstance eq 'duration') { %><%== &subs::duration_readout($autocalc->{$budget->{'scope_name'}}->{'result'} || 0) %><% } else { %><%= $suggested %><% } %></button>
			</td>
			<td style="opacity:.55;padding-left:6px;white-space:nowrap;">your typical <%= lc $scope %></td>
		</tr>
		<% } %>
	</table>
	<%# a budget locked to the calendar is only part-run early in its period; the
	    pace is what says whether that part is on track before the period is done %>
	<% if (defined $budget->{'elapsed'} && $budget->{'elapsed'} < 1) { %>
		<div style="border-top:1px solid rgba(128,128,128,.35);margin:6px 0;"></div>
		<div>
			<b>On track:</b> <span style="color:<%= ($budget->{'on_track'} || '') eq 'yes' ? 'green' : '#b8860b' %>;font-weight:700;"><%= ($budget->{'on_track'} || '') eq 'yes' ? 'yes' : 'no' %></span><span style="opacity:.75;">
			<% if ($budget->{'early'}) { %> - nothing due yet, <%= $budget->{'progress'} %>% into the <%= $scope %>; the pace projects <b><% if ($circumstance eq 'duration') { %><%== &subs::duration_readout($budget->{'projected'} || 0) %><% } else { %><%= $budget->{'formatted_projected'} %><% } %></b>
			<% } else { %> - <%= $budget->{'progress'} %>% into the <%= $scope %>, so <b><% if ($circumstance eq 'duration') { %><%== &subs::duration_readout($budget->{'on_target'} || 0) %><% } else { %><%= $budget->{'formatted_on_target'} %><% } %></b> is due; the pace projects <b><% if ($circumstance eq 'duration') { %><%== &subs::duration_readout($budget->{'projected'} || 0) %><% } else { %><%= $budget->{'formatted_projected'} %><% } %></b>
			<% } %></span>
		</div>
	<% } %>
	<div style="border-top:1px solid rgba(128,128,128,.35);margin:6px 0;"></div>
	<table style="border-collapse:collapse;width:100%;opacity:.9;">
		<tr>
			<td style="white-space:nowrap;padding-right:8px;">Budget vs typical<%= ($improvement->{'share'} // 1) < 1 ? ' so far' : '' %></td>
			<td style="text-align:right;font-weight:600;white-space:nowrap;"><% if ($circumstance eq 'duration') { %><%== &subs::duration_readout($improvement->{'overall_value'} || 0) %><% } else { %><%= $improvement->{'overall'} %><% } %></td>
			<td style="opacity:.55;padding-left:6px;white-space:nowrap;"><%= $trim->($improvement->{'overall_percentage'}) %></td>
		</tr>
		<tr>
			<td style="white-space:nowrap;padding-right:8px;">This <%= $scope %> vs budget<%= ($improvement->{'share'} // 1) < 1 ? ' so far' : '' %></td>
			<td style="text-align:right;font-weight:600;white-space:nowrap;"><% if ($circumstance eq 'duration') { %><%== &subs::duration_readout($improvement->{'difference'} || 0) %><% } else { %><%= $diff %><% } %></td>
			<td style="opacity:.55;padding-left:6px;white-space:nowrap;"><%= $trim->($improvement->{'percentage'}) %></td>
		</tr>
	</table>
	<%# The scopes around the budget's own, never the smaller ones: a per-hour
	    budget reads as a day and a week, not as a per-minute figure. The budget
	    converted to each scope sits beside the app's own typical amount there. %>
	<% my @scope_order = qw/minute hour day week month year/; %>
	<% my %scope_at; @scope_at{@scope_order} = (0 .. $#scope_order); %>
	<% my @near_scopes = (); %>
	<% my $scope_amount = sub {
		my ($value) = @_;
		return '-' unless defined $value;
		return &subs::duration_readout($value) if $circumstance eq 'duration';
		return &subs::price_formatter($value) if $circumstance eq 'total';
		return sprintf("%.3f", $value) if $circumstance eq 'occurences';
		return sprintf("%.3f", $value) . $circumstance;
	}; %>
	<% my $scope_start = $scope_at{$budget->{'scope_name'} // ''}; %>
	<% if (!$budget->{'fixed'} && defined $scope_start && $budget->{'duration'} && $budget->{'budgeted'}) { %>
		<% my $last = $scope_start + 2; $last = $#scope_order if $last > $#scope_order; %>
		<% my $rate = defined $budget->{'full_expected'} ? $budget->{'full_expected'} : ($budget->{'budgeted'} / $budget->{'duration'}); %>
		<% foreach my $ts ( @scope_order[$scope_start .. $last] ) { %>
			<% my $ac = $autocalc->{$ts}; next unless $ac; %>
			<% my $width = $ac->{'duration'} || &subs::time_abbrev_translator(1 . $ts, &subs::rightNow()); %>
			<% push @near_scopes, { scope => $ts, budget => $rate * $width, typical => $ac->{'result'} }; %>
		<% } %>
	<% } %>
	<% if (scalar @near_scopes) { %>
		<div style="border-top:1px solid rgba(128,128,128,.35);margin:6px 0;"></div>
		<table style="border-collapse:collapse;width:100%;opacity:.9;">
			<tr style="opacity:.6;font-size:90%;">
				<td style="white-space:nowrap;padding-right:8px;">Scopes</td>
				<td style="text-align:right;white-space:nowrap;">budget</td>
				<td style="text-align:right;white-space:nowrap;padding-left:8px;">typical</td>
			</tr>
			<% foreach my $ns ( @near_scopes ) { %>
				<tr>
					<td style="white-space:nowrap;padding-right:8px;"><%= &subs::format_name($ns->{'scope'}) %></td>
					<td style="text-align:right;font-weight:600;white-space:nowrap;"><%== $scope_amount->($ns->{'budget'}) %></td>
					<td style="text-align:right;white-space:nowrap;padding-left:8px;opacity:.8;"><%== $scope_amount->($ns->{'typical'}) %></td>
				</tr>
			<% } %>
		</table>
	<% } %>
	<%# a goal is the long target, and for a fixed level it is the only thing
	    that can give a pace: read the measure's own trend and name the day the
	    current pace carries it to the goal. The autocalc needs the value known,
	    so it sits here in the panel and waits on nothing. %>
	<% if ($goal) { %>
		<div style="border-top:1px solid rgba(128,128,128,.35);margin:6px 0;"></div>
		<div>
			<% my $gt = $goal->{'target'}; my $gc; if (defined $gt) { $gc = $gt; $gc =~ s/(\d+\.\d)\d+/$1/g; } %>
			<b>Goal:</b> <%= defined $gc ? $gc . $circumstance : '-' %>
			<% if (defined $goal->{'eta_text'}) { %>
				<span style="opacity:.75;"> - at the current pace, by <b><%= $goal->{'eta_text'} %></b></span>
			<% } elsif ($goal->{'samples'}) { %>
				<span style="opacity:.6;"> - not trending toward it</span>
			<% } %>
		</div>
	<% } %>
	<div style="opacity:.5;font-size:88%;margin-top:6px;">
		Autocalc <span class="time" timestamp="<%= $autocalc->{'data'}->{'timestamp'} %>"></span> - budget set <span class="time" timestamp="<%= $budget->{'timestamp'} %>"></span>
	</div>
</div>
