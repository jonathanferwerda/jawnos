<% no warnings 'uninitialized'; %>
<table class="gallery_home_album hover" app="<%= $app %>" style="display:inline-block;border:solid;">
	<thead><th><%= &subs::format_name($app) %> - <%= scalar @{$ghome->{$app}} %></th></thead>
	<tbody>
		<tr><td>
			<% my $main_img = $aset->{'main_image'}; %>
			<% my $cover = $ghome->{$app}->[-1]; my $cover_thumb = ($cover->{'thumb'} && -e $cover->{'thumb'}) ? $cover->{'thumb'} : ''; %>
			<%# a sealed cover is not shown while the gallery's padlock is shut %>
			<% $main_img = '' if (!$permissive && ($main_img || '') =~ /\.enc$/i); %>
			<%# the shared rule: a path this machine can open as it stands, a path
			    another machine wrote mapped onto this one, or a snapshot's data URI %>
			<% my $main_src = $main_img ? &subs::main_image_src($main_img, $app) : ''; %>
			<% if ($main_src =~ /\Adata:image\//i) { %>
				<img src="<%= $main_src %>" loading="lazy" decoding="async" class="gigantic_thumb">
			<% } elsif (length $main_src) { %>
				<img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-src="<%= $main_src %>&thumb=ya" loading="lazy" decoding="async" fetchpriority="low" class="gallery_lazy gigantic_thumb">
			<% } elsif ($ghome->{$app}->[-1]->{'type'} eq 'image') { %>
				<img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-src="/file_open?file=<%= $cover_thumb || $cover->{f} %>&remote_uuid=<%= $cover->{remote_uuid} || q{} %><%= $cover_thumb ? '' : '&thumb=ya' %>&app_uuid=<%= $ghome->{$app}->[-1]->{'app_uuid'} %>&timestamp=<%= $ghome->{$app}->[-1]->{'server_time'} %>&app=<%= $app %>" loading="lazy" decoding="async" fetchpriority="low" class="gallery_lazy gigantic_thumb">
			<% } else { %>
				<% my $brother = &subs::random_string_creator(); %>
				<img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" data-src="/file_open?file=<%= $cover_thumb || $cover->{f} %>&remote_uuid=<%= $cover->{remote_uuid} || q{} %><%= $cover_thumb ? '' : '&thumb=ya' %>&app_uuid=<%= $ghome->{$app}->[-1]->{'app_uuid'} %>&timestamp=<%= $ghome->{$app}->[-1]->{'timestamp'} %>&app=<%= $app %>" id="<%= &subs::random_string_creator(20) %>" file_uuid="<%= $ghome->{$app}->[-1]->{'uuid'} %>" type="<%= $ghome->{$app}->[-1]->{'type'} %>" isa="img" loading="lazy" decoding="async" fetchpriority="low" class="gallery_lazy video_preview_thumb gigantic_thumb" style="border-color:yellow;" brother="<%= $brother %>"></img>
				<video autoplay loop muted potential_src="/file_open?file=<%= $ghome->{$app}->[-1]->{f} %>&remote_uuid=<%= $ghome->{$app}->[-1]->{remote_uuid} || q{} %>&timestamp=<%= $ghome->{$app}->[-1]->{'app_timestamp'} %>&app=<%= $app %>&app_uuid=<%= $ghome->{$app}->[-1]->{'app_uuid'} %>"  duration="<%= $ghome->{$app}->[-1]->{'info'}->{'duration'} %>" id="<%= &subs::random_string_creator(20) %>" id="<%= &subs::random_string_creator(20) %>" file_uuid="<%= $ghome->{$app}->[-1]->{'uuid'} %>" isa="video" brother="<%= $brother %>" type="<%= $ghome->{$app}->[-1]->{'type'} %>" loading="lazy" decoding="async" fetchpriority="low" class="gallery_lazy video_preview_thumb gigantic_thumb" style="min-width:110px;border-color:yellow;display:none;"></video>
			<% } %>
		</td></tr>
	</tbody>
</table>