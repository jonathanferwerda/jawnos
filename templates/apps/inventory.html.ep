<%
	# the headline numbers as cards, so the shape of the app reads at a glance
	# before any scrolling
	my @inventory_cards = (
		[ 'Occurrences', $returner->{'total_occurences'} ],
		[ 'Average Duration', &subs::duration_sayer($returner->{'average_duration'} / 1000) ],
		[ 'Total Duration', &subs::duration_sayer($returner->{'total_duration'} / 1000) ],
		[ 'Average Between', &subs::duration_sayer($returner->{'between_average'} / 1000) ],
		[ 'Total Between', &subs::duration_sayer($returner->{'between_total'} / 1000) ],
	);
%>
<div class="statistic_cards" style="display:flex;flex-wrap:wrap;gap:8px;margin:6px 0 10px;">
	<% foreach my $card ( @inventory_cards ) { %>
		<span class="statistic_card" style="flex:1 1 120px;min-width:110px;border:solid 1px;border-radius:6px;padding:6px 10px;">
			<span style="opacity:.55;font-size:85%;display:block;white-space:nowrap;"><%= $card->[0] %></span>
			<b style="font-size:150%;"><%= $card->[1] %></b>
		</span>
	<% } %>
</div>
<% my @cols = @{$time_lengths}; #qw/minute hour day week month year/; %>
<% my @rows = @{$time_scopes}; %>
<% my $s_display = $settings->{'s_display'}; %>
<% my $s_calc = $settings->{'s_calc'}; %>
<% my $s_visual = $settings->{'s_visual'}; %>
<% my $s_lock = $settings->{'s_lock'}; %>
<% my $s_count = $settings->{'s_scope_count'}; %>
<% my $s_movement = $settings->{'s_movement'}; %>
<% my $ctl = 'display:flex;flex-direction:column;gap:2px;font-size:85%;'; %>
<div class="inventory_controls" style="display:flex;flex-wrap:wrap;gap:12px;align-items:flex-start;margin:6px 0;">
	<label style="<%= $ctl %>">Movements
		<select multiple class="statistic_movement" style="height:70px;min-width:132px;">
			<% foreach my $m ( @{$movements} ) { %>
				<option value="<%= $m %>" <% if (grep { $_ eq $m } @{$s_movement}) { %>selected<% } %>><%= &subs::format_name($m) %></option>
			<% } %>
		</select>
	</label>
	<label style="<%= $ctl %>">View
		<select class="statistic_visual">
			<% foreach my $v ( qw/historical allocation/ ) { %>
				<option value="<%= $v %>" <% if ($s_visual eq $v) { %>selected<% } %>><%= &subs::format_name($v) %></option>
			<% } %>
		</select>
	</label>
	<label style="<%= $ctl %>">Calc
		<select class="statistic_calc" data-measure_calc="<%= $measure_calc_json || '{}' %>">
			<% foreach my $cal ( qw/sum average high low/ ) { %>
				<option value="<%= $cal %>" <% if ($s_calc eq $cal) { %>selected<% } %>><%= &subs::format_name($cal) %></option>
			<% } %>
		</select>
	</label>
	<label style="<%= $ctl %>">Display
		<select class="statistic_display">
			<% foreach my $o (@{$display_options}) { %>
				<option value="<%= $o->{'name'} %>" <% if ($o->{'name'} eq $s_display) { %>selected<% } %>><%= $o->{'formatted_name'} %></option>
			<% } %>
		</select>
	</label>
	<label style="<%= $ctl %>">Count
		<select class="statistic_scope_count" app="<%= $app %>">
			<% foreach my $count (1..30) { %>
				<option value="<%= $count %>" <% if ($count == $s_count) { %>selected<% } %>><%= $count %></option>
			<% } %>
		</select>
	</label>
	<label style="<%= $ctl %>">Lock
		<img src="<%= &subs::icon_for('/images/make believe/key.png') %>" hint="Lock" class="statistic_lock little_thumb hover" app="<%= $app %>" locked="<%= $s_lock %>">
	</label>
	<label style="<%= $ctl %>">&nbsp;
		<img class="little_thumb budget_autocalc hover" app="<%= $app %>" circumstance="<%= $s_display %>" src="<%= &subs::icon_for('/images/decipherable/calculator.png') %>" hint="Calculator">
	</label>
</div>
<% if (scalar @{$appts} > 0) { %>
	<% my $scope_page = $returner->{'scope_page'} || 0; %>
	<% my $page_letter = ''; %>
	<% if ($scope_page != 0 && $returner->{'page_scope'}) { my $fl = uc substr($returner->{'page_scope'}, 0, 1); $page_letter = $returner->{'page_scope'} eq 'minute' ? lc($fl) : $fl; } %>
	<% my $page_icon = $scope_page == 0 ? 'now' : ($scope_page > 0 ? 'back' : 'forward'); %>
	<% my $page_colours = &subs::icon_plate_colours($page_icon); %>
	<%# the page button wears where a scroll or a swipe has walked - N at now,
	    2P two pages back, 1F one page forward - and then the unit of the canvas
	    that was walked, as in 1FD; it stays wide enough for 99FY, and tapping
	    it returns to now while its tile follows the walk %>
	<button class="statistic_page little_thumb hover" style="min-width:68px;<% if ($page_colours->{'plate'}) { %>background-color:<%= $page_colours->{'plate'} %>;color:<%= $page_colours->{'ink'} %>;<% } %>" hint="<%= $scope_page == 0 ? 'Scroll a graph sideways to walk through the periods' : 'Tap to return to now' %>"><%= $scope_page == 0 ? 'N' : abs($scope_page) . ($scope_page > 0 ? 'P' : 'F') . $page_letter %></button>
	<div class="statistic_graphs" app="<%= $app %>" style="display:inline-block;max-height:300px;height:300px;overflow-x:scroll;">
		<% foreach my $col ( @cols ) { %>
			<span id="<%= $app %>_<%= $col %>_statistic_graph_span">
				<%= &subs::format_name($col) %>
				<canvas id="<%= $app %>_<%= $col %>_statistic_graph" scope="<%= $col %>" class="statistic_graph" style="width:100%;height:250px;"></canvas>
			</span>
		<% } %>
	</div>
	<div class="statistic_graph_information" style="display:none;position:fixed;background-color:white;border:solid;border-radius:5px;padding:2px;"></div>
	<%# the same periods as bars (easier to compare) and as shares (a pie), so
	    the shape is read three ways from one page of data %>
	<div class="statistic_bars_pie" style="display:flex;flex-wrap:wrap;gap:12px;margin:8px 0;align-items:flex-start;">
		<div style="flex:3 1 340px;min-width:240px;">
			<div style="display:flex;justify-content:space-between;align-items:baseline;">
				<b style="font-size:90%;opacity:.6;">By period</b>
				<select class="statistic_bar_unit" style="font-size:85%;">
					<% foreach my $col ( @cols ) { %>
						<option value="<%= $col %>"><%= &subs::format_name($col) %></option>
					<% } %>
				</select>
			</div>
			<canvas id="<%= $app %>_bars_graph" class="statistic_bars" style="width:100%;height:160px;"></canvas>
		</div>
		<div style="flex:2 1 260px;min-width:220px;">
			<div style="display:flex;justify-content:space-between;align-items:baseline;">
				<b style="font-size:90%;opacity:.6;">Share</b>
				<select class="statistic_pie_by" style="font-size:85%;">
					<option value="period">by period</option>
					<option value="hour">by hour</option>
					<option value="weekday">by weekday</option>
				</select>
			</div>
			<canvas id="<%= $app %>_pie_graph" class="statistic_pie" style="width:100%;height:200px;"></canvas>
		</div>
	</div>
	<div class="statistic_table_scroll" style="max-height:360px;overflow:auto;border:solid 1px;border-radius:6px;">
	<table id="<%= $app %>_inventory_table" style="width:100%;">
		<thead style="position:sticky;top:0;background:var(--panel);z-index:1;">
			<th></th>
			<% foreach my $ty ( @cols ) { %>
				<th><%= &subs::format_name($ty) %></th>
			<% } %>

		</thead>
		<tbody>
			<% foreach my $rw ( @rows ) { %>
				<tr>
					<td><%= &subs::format_name($rw) %></td>
					<% foreach my $ry ( @cols ) { %>
						<td>
							<% if ($returner->{$rw}->{$ry}) {
								<% if ( $returner->{$rw}->{$ry} =~ /[A-Za-z0-9]/gi ) { %>
									<% my $end_seen = $returner->{$rw}->{$ry}->{'end_timestamp'} ? $returner->{$rw}->{$ry}->{'end_timestamp'} - 1000 : ''; %>
									<span class="statistic_entry hover" inventory_timestamp="<%= $returner->{'timestamp'} %>" start_timestamp="<%= $returner->{$rw}->{$ry}->{'start_timestamp'} %>" end_timestamp="<%= $end_seen %>"
										timestamp="<%= $returner->{$rw}->{$ry}->{'timestamp'} %>" zone="<%= $rw %>" scope="<%= $ry %>"
										style="
										<% if ($returner->{$rw}->{$ry}->{'budget'}) { %>
											background-color:
											<%= $returner->{$rw}->{$ry}->{'budget'}->{'colour'} %>;
											% if ($returner->{$rw}->{$ry}->{'budget'}->{'text-colour'}) {
												color:<%= $returner->{$rw}->{$ry}->{'budget'}->{'text-colour'} %>;
											% }
										<% } %>
										<% if ($returner->{$rw}->{$ry}->{'budget'}->{'is_scope'} && $returner->{$rw}->{$ry}->{'budget'}->{'is_scope'} eq 'yes') { %>
											border:solid;border-radius:2px;
										<% } %>
										"
										>
										<% if ($s_display eq 'occurences') { %>
											<%= $returner->{$rw}->{$ry}->{$s_display} %>
										<% } elsif ($s_display eq 'duration') { %>
											<%= &subs::duration_sayer($returner->{$rw}->{$ry}->{$s_display} / 1000) %>
										<% } elsif ($s_display eq 'amount' || $s_display eq 'total') { %>
											<%= &subs::price_formatter($returner->{$rw}->{$ry}->{$s_display}) %>
										<% } else { %>
											<%= $returner->{$rw}->{$ry}->{$s_display} %>
										<% } %>
									<% } elsif ($rw eq 'average' || $rw eq 'total') { %>
										<% if ($s_display eq 'occurences') { %>
											<%= $returner->{$rw}->{$ry} %>
										<% } elsif ($s_display eq 'duration') { %>
											<%= &subs::duration_sayer($returner->{$rw}->{$ry} / 1000) %>
										<% } elsif ($s_display eq 'amount' || $s_display eq 'total') { %>
											<%= &subs::price_formatter($returner->{$rw}->{$ry}) %>
										<% } else { %>
											<%= $returner->{$rw}->{$ry} %>
										<% } %>
									</span>
								<% } %>

							</td>
						<% } %>
					<% } %>
				</tr>
			<% } %>
			<tr>

			</tr>
		</tbody>
	</table>
	</div>
	<br>
	<% if (keys %{$returner->{'budgets'}}) { %>
		<% foreach my $b (keys %{$returner->{'budgets'}}) { %>
			<b><%= &subs::format_name($b) %>:</b> <%= $returner->{'budgets'}->{$b} %><br>
		<% } %>
	<% } %>
	<%# a way to run the evaluation on demand without waiting for the night; the
	    button shares the report's own block, so the answer lands in place %>
	<button class="system_evaluation hover" app="<%= $app %>" hint="Run the evaluation now with the chosen model">Evaluate</button>
	<%= include 'apps/evaluation', evaluation => $evaluation, app => $app %>
	<span class="statistic_information_container" app="<%= $app %>"></span>
<% } else { %>
	<h4>None</h4>
<% } %>

