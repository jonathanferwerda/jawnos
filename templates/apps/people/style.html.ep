<style>
	#people_app { width:100%; height:100%; box-sizing:border-box; padding:14px; overflow:auto; }
	.people_tabs { display:flex; gap:6px; overflow-x:auto; white-space:nowrap; padding-bottom:8px;
		margin-bottom:10px; border-bottom:1px solid var(--line); scrollbar-width:thin; }
	.people_tab { flex:0 0 auto; padding:6px 13px; border:1px solid var(--line); border-radius:999px;
		background:var(--panel); cursor:pointer; font-size:13px; color:inherit; }
	.people_tab:hover { background:var(--line); }
	.people_tab.active { background:var(--line); font-weight:bold; }
	.people_tab_count { opacity:.6; font-size:11px; }
	.people_panel { display:none; }
	.people_panel.active { display:block; }
	.people_head { display:flex; gap:18px; align-items:flex-start; flex-wrap:wrap; }
	.people_house { display:flex; gap:14px; align-items:center; flex:1 1 420px; min-width:280px; }
	.people_crest_frame { width:160px; height:160px; flex:0 0 160px; border:1px solid var(--line); border-radius:10px;
		background:var(--panel); display:flex; align-items:center; justify-content:center; overflow:hidden; }
	.people_crest_frame img { max-width:100%; max-height:100%; object-fit:contain; }
	.people_crest_empty { color:var(--muted,#8e8e8e); font-size:13px; text-align:center; padding:12px; }
	.people_meta { min-width:0; }
	.people_meta h2 { margin:0 0 6px; font-size:22px; }
	.people_fp { font-family:monospace; font-size:12px; letter-spacing:1px; color:var(--muted,#8e8e8e);
		overflow-wrap:anywhere; }
	.people_note { font-size:12px; color:var(--muted,#8e8e8e); margin-top:6px; }
	.people_actions { display:flex; gap:8px; flex-wrap:wrap; align-items:center; margin:12px 0; }
	.people_actions button, .people_actions a.people_button, .people_name_row button { padding:7px 12px; border:1px solid var(--line);
		border-radius:8px; background:var(--panel); cursor:pointer; font-size:13px; text-decoration:none; color:inherit; }
	.people_actions button:hover, .people_actions a.people_button:hover, .people_name_row button:hover { background:var(--line); }
	.people_peer_thumb { width:56px; height:56px; flex:0 0 56px; object-fit:contain; border:1px solid var(--line);
		border-radius:8px; background:var(--panel); }
	.people_peer_thumb_empty { display:flex; align-items:center; justify-content:center; border-style:dashed;
		background:transparent; font-size:18px; font-weight:bold; opacity:.55; color:var(--muted,#8e8e8e); }
	.people_peer_vouch { padding:6px 10px; border:1px solid var(--line); border-radius:8px;
		background:var(--panel); cursor:pointer; font-size:12px; }
	.people_publish_toggle { padding:6px 10px; border:1px solid var(--line); border-radius:8px;
		background:var(--panel); cursor:pointer; font-size:12px; }
	.people_publish_toggle.on { background:var(--line); font-weight:bold; }
	.people_construct_crest { display:flex; gap:8px; align-items:center; flex-wrap:wrap;
		margin:0 0 6px 28px; padding:8px 4px; border-left:1px solid var(--line); padding-left:8px; }
	.people_construct_crest_thumb { width:44px; height:44px; object-fit:contain; border:1px solid var(--line);
		border-radius:8px; background:var(--panel); }
	.people_construct_crest button { padding:5px 9px; border:1px solid var(--line); border-radius:8px;
		background:var(--panel); cursor:pointer; font-size:12px; }
	.people_construct_qr { width:100%; text-align:center; }
	.people_construct_qr img { width:180px; height:180px; image-rendering:pixelated; background:#fff;
		padding:6px; border-radius:8px; }
	.people_construct_qr textarea { width:100%; box-sizing:border-box; font-family:monospace;
		font-size:10px; min-height:34px; border:1px solid var(--line); border-radius:8px; background:var(--panel); }
	.people_qr_box { text-align:center; margin:8px 0; }
	.people_qr_box img { width:220px; height:220px; image-rendering:pixelated; background:#fff; padding:6px; border-radius:8px; }
	.people_qr_box textarea { width:100%; box-sizing:border-box; font-family:monospace; font-size:11px;
		border:1px solid var(--line); border-radius:8px; background:var(--panel); margin-top:6px; }
	.people_code_row { display:flex; gap:8px; align-items:flex-end; flex-wrap:wrap; margin:8px 0; }
	.people_code_row textarea { flex:1 1 320px; min-height:38px; font-family:monospace; font-size:11px;
		border:1px solid var(--line); border-radius:8px; background:var(--panel); padding:6px; }
	.people_code_row button { padding:7px 12px; border:1px solid var(--line); border-radius:8px;
		background:var(--panel); cursor:pointer; font-size:13px; }
	.people_nfc_status { display:block; min-height:18px; font-size:12px; color:var(--muted,#8e8e8e); }
	.people_detail { display:none; position:relative; border:1px solid var(--line); border-radius:10px;
		padding:12px; margin:10px 0; background:var(--panel); overflow:auto; }
	.people_detail_close { position:absolute; top:6px; right:8px; border:0; background:transparent;
		font-size:20px; cursor:pointer; color:inherit; }
	.people_detail_image { width:140px; height:140px; object-fit:contain; float:left; margin:0 12px 8px 0;
		border-radius:8px; background:var(--panel); }
	.people_detail h3 { margin:0 0 4px; }
	.people_detail .people_actions { clear:both; }
	.people_contact_link { padding:6px 8px; border:1px solid var(--line); border-radius:8px;
		background:var(--panel); font-size:13px; max-width:260px; }
	.people_person_card { display:none; position:relative; border:1px solid var(--line); border-radius:10px;
		padding:12px; margin:0 0 12px; background:var(--panel); overflow:auto; }
	.people_person_card .people_crest_frame { width:120px; height:120px; flex:0 0 120px; }
	.people_person_card .people_portraits { display:flex; gap:8px; align-items:center; flex:0 0 auto; }
	.people_person_card .people_portrait_frame { width:150px; height:150px; flex:0 0 150px; }
	.people_person_card .people_crest_side { width:76px; height:76px; flex:0 0 76px; }
	.people_person_card .people_portrait_frame img,
	.people_person_card .people_crest_side img { max-width:100%; max-height:100%; object-fit:contain; }
	.people_person_card .people_detail_close { position:static; float:right; }
	.people_crest_row { cursor:pointer; }
	.people_name_row { display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin:8px 0; }
	.people_name_row input { min-width:180px; padding:6px 8px; border:1px solid var(--line);
		border-radius:8px; background:var(--panel); font-size:14px; }
	#people_status, #people_verify_result { min-height:20px; font-size:13px; color:var(--muted,#8e8e8e); margin:6px 0; }
	.people_section { border-top:1px solid var(--line); margin-top:16px; padding-top:12px; }
	.people_section h3 { margin:0 0 8px; font-size:16px; }
	.people_list { max-height:60vh; overflow:auto; }
	.people_row { display:flex; align-items:center; gap:10px; padding:8px 6px; border-bottom:1px solid var(--line); }
	.people_row_name { flex:1 1 auto; font-size:14px; min-width:0; }
	.people_row_sub { font-size:12px; color:var(--muted,#8e8e8e); }
	.people_empty { color:var(--muted,#8e8e8e); font-size:13px; padding:10px 0; }
	.people_person_row { cursor:pointer; }
	.people_person_row:hover, .people_construct_row:hover, .people_member_row:hover { background:var(--line); }
	.people_relationship { display:inline-block; margin-top:4px; padding:2px 8px; border:1px solid var(--line); border-radius:999px;
		font-size:11px; background:var(--panel); }
	.people_relationship[data-rating="1"] { border-color:#3f8f5f; }
	.people_relationship[data-rating="2"] { opacity:.75; }
	.people_relationship[data-rating="3"] { border-color:#b0342e; color:#b0342e; }
	.people_relationship_row { display:flex; align-items:center; gap:8px; margin-top:8px; font-size:13px; }
	.people_relationship_row select { padding:5px 8px; border:1px solid var(--line); border-radius:8px; background:var(--panel); color:inherit; font:inherit; }
	.people_relationship_rating { font-family:monospace; opacity:.65; }
	.people_chips { display:flex; flex-wrap:wrap; gap:3px; margin-top:4px; }
	.people_chip { display:inline-block; padding:2px 8px; border:1px solid var(--line); border-radius:999px;
		font-size:11px; cursor:pointer; background:var(--panel); }
	.people_chip:hover { background:var(--line); }
	.people_construct_row { cursor:pointer; }
	.people_chevron { font-size:12px; color:var(--muted,#8e8e8e); padding:0 4px; }
	.people_construct_row.open .people_chevron { transform:rotate(90deg); }
	.people_member_list { display:none; margin:0 0 6px 28px; border-left:1px solid var(--line); padding-left:8px; }
	.people_construct_row.open + .people_member_list { display:block; }
	.people_member_row { cursor:pointer; padding:5px 4px; }
	.people_crest_select { padding:6px 8px; border:1px solid var(--line); border-radius:8px;
		background:var(--panel); font-size:13px; max-width:240px; }
	.people_aka { display:flex; flex-wrap:wrap; align-items:center; gap:4px; margin-top:6px; }
	.people_aka_chip { display:inline-flex; align-items:center; gap:3px; padding:2px 5px 2px 8px;
		border:1px solid var(--line); border-radius:999px; font-size:11px; background:var(--panel); }
	.people_aka_remove { border:0; background:transparent; color:var(--muted,#8e8e8e); cursor:pointer;
		font-size:13px; line-height:1; padding:0 2px; }
	.people_aka_remove:hover { color:var(--text); }
	.people_aka_add { border:1px dashed var(--line); border-radius:999px; background:transparent;
		color:var(--text); font-size:11px; padding:2px 8px; min-width:100px; }
	.people_aka_label { font-size:11px; color:var(--muted,#8e8e8e); }
</style>
