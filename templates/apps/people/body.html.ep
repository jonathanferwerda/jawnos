<div id="people_app" class="people_app">
	<div class="people_tabs">
		<button class="people_tab active" data-tab="me"><%= &subs::lang('people.me') %></button>
		<button class="people_tab" data-tab="people"><%= &subs::lang('people') %> <span class="people_tab_count"><%= scalar @{$people} %></span></button>
		<% foreach my $construct ( @{$constructs} ) { %>
			<button class="people_tab" data-tab="<%= $construct->{'name'} %>"><%= &subs::lang('construct.' . $construct->{'name'}) %> <span class="people_tab_count"><%= scalar @{$construct->{'rows'}} %></span></button>
		<% } %>
	</div>

	<div id="people_status"></div>
	<span class="nfc_read_status people_nfc_status"></span>

	<div class="people_panel active" data-panel="me">
		<div class="people_head">
			<div class="people_house">
				<div class="people_crest_frame">
					<% if ($crest->{'uuid'} && $has_image) { %>
						<img id="people_crest_image" src="/manager/people/crest_image?kind=image&stamp=<%= &subs::rightNow() %>" alt="<%= &subs::lang('people') %>">
					<% } elsif ($crest->{'uuid'}) { %>
						<div class="people_crest_empty"><%= &subs::ui('The drawing is on another machine. Capture it here to copy it.') %></div>
					<% } else { %>
						<div class="people_crest_empty"><%= &subs::ui('No crest yet') %></div>
					<% } %>
				</div>
				<div class="people_meta">
					<h2><%= $crest->{'name'} || &subs::crest_house_name_read() %></h2>
					<% if ($crest->{'fingerprint'}) { %>
						<div class="people_fp"><%= $crest->{'fingerprint'} %></div>
					<% } %>
					<div class="people_note">
						<% if ($crest->{'uuid'}) { %>
							<%= &subs::ui($signed ? 'Signed by this house' : 'Not signed yet') %>
							<% if ($crest->{'version'}) { %> &middot; v<%= $crest->{'version'} %><% } %>
							<% if ($introduced_by) { %> &middot; <%= &subs::ui('Introduced by') %> <%= $introduced_by %><% } %>
						<% } else { %>
							<%= &subs::ui('Scan the drawing you want the house to be known by.') %>
						<% } %>
					</div>
					<% my $house_origin = $crest->{'origin'} || &subs::crest_origin(); %>
					<% if (length $house_origin) { %>
						<div class="people_note"><%= &subs::ui('Other houses can reach this one at') %> <span class="people_fp"><%= $house_origin %></span></div>
					<% } else { %>
						<div class="people_note"><%= &subs::ui('This house has no address other houses can reach yet.') %></div>
					<% } %>
					<% if (@{$backers}) { %>
						<div class="people_note"><%= &subs::ui('Also backed by') %> <%= join(', ', map { $_->{'hostname'} || $_->{'signatorial'} } @{$backers}) %></div>
					<% } else { %>
						<div class="people_note"><%= &subs::ui('No other machine has confirmed this crest yet.') %></div>
					<% } %>
				</div>
			</div>
			<div class="people_actions">
				<% if ($scanner) { %>
					<button id="people_crest_scan" hint="Scan my crest"><%= &subs::ui('Scan my crest') %></button>
				<% } %>
				<% if ($camera) { %>
					<button id="people_crest_capture" hint="Take picture"><%= &subs::ui('Take picture') %></button>
				<% } %>
				<button id="people_crest_upload_button" hint="Upload a photo"><%= &subs::ui('Upload a photo') %></button>
				<input type="file" id="people_crest_file" accept="image/*" style="display:none">
				<% if ($crest->{'uuid'}) { %>
					<button id="people_crest_card" hint="Download card"><%= &subs::ui('Download card') %></button>
					<button id="people_crest_card_save" hint="Save card here"><%= &subs::ui('Save card here') %></button>
					<button id="people_crest_qr_button" hint="Show QR"><%= &subs::ui('Show QR') %></button>
					<% if ($nfc) { %>
						<button id="people_crest_nfc_write" hint="Write to NFC tag"><%= &subs::ui('Write to NFC tag') %></button>
					<% } %>
				<% } %>
				<button id="people_refresh" hint="Refresh"><%= &subs::ui('Refresh') %></button>
			</div>
		</div>

		<div id="people_crest_detail" class="people_detail"></div>
		<div id="people_crest_qr" class="people_qr_box"></div>

		<div class="people_name_row">
			<label for="people_house_name"><%= &subs::ui('House name') %></label>
			<input id="people_house_name" value="<%= $crest->{'name'} || &subs::crest_house_name_read() %>">
			<button id="people_house_name_save" hint="Save name"><%= &subs::ui('Save name') %></button>
		</div>

		<% if ($crest->{'uuid'}) { %>
			<div class="people_actions">
				<button id="people_crest_verify_button" hint="Verify a photo"><%= &subs::ui('Verify a photo') %></button>
				<input type="file" id="people_crest_verify_file" accept="image/*" style="display:none">
			</div>
			<div id="people_verify_result"></div>
		<% } %>

		<div class="people_section">
			<h3><%= &subs::ui('Other houses') %></h3>
			<div class="people_actions">
				<button id="people_crest_import_button" hint="Import a crest card"><%= &subs::ui('Import a crest card') %></button>
				<input type="file" id="people_crest_import_file" accept=".json,application/json" style="display:none">
			</div>
			<div class="people_code_row">
				<textarea id="people_crest_code" rows="2" placeholder="CREST1Z:..."></textarea>
				<button id="people_crest_code_import" hint="Import a crest code"><%= &subs::ui('Import a crest code') %></button>
			</div>
			<% if (@{$peers}) { %>
				<div class="people_list">
					<% foreach my $peer ( @{$peers} ) { %>
						<div class="people_row peer_crest people_crest_row" uuid="<%= $peer->{'uuid'} %>">
							<% if ($peer->{'has_image'}) { %>
								<img class="people_peer_thumb" src="<%= $peer->{'image_src'} %>" alt="<%= $peer->{'name'} %>">
							<% } else { %>
								<span class="people_peer_thumb people_peer_thumb_empty"><%= substr($peer->{'name'} || '?', 0, 1) %></span>
							<% } %>
							<span class="people_row_name"><%= $peer->{'name'} %><br><span class="people_fp"><%= $peer->{'fingerprint'} %></span></span>
							<span class="people_row_sub">
								<% if ($peer->{'met'}) { %>
									<%= &subs::ui('Met in person') %>
									<% if ($peer->{'met_at'}) { %> <span class="time" timestamp="<%= $peer->{'met_at'} %>"></span><% } %>
								<% } elsif ($peer->{'introduced_by'}) { %>
									<%= &subs::ui('Introduced by') %> <%= $peer->{'introduced_by'} %>
								<% } else { %>
									<%= &subs::ui('Imported, not met') %>
								<% } %>
							</span>
							<% unless ($peer->{'met'}) { %>
								<button class="people_peer_vouch" uuid="<%= $peer->{'uuid'} %>" hint="I have met this crest"><%= &subs::ui('I have met this crest') %></button>
							<% } %>
						</div>
					<% } %>
				</div>
			<% } else { %>
				<div class="people_empty"><%= &subs::ui('No other houses yet. Import the card they give you.') %></div>
			<% } %>
		</div>
	</div>

	<div class="people_panel" data-panel="people">
		<div id="people_person_card" class="people_person_card"></div>
		<% if (@{$people}) { %>
			<div class="people_list">
				<% foreach my $person ( @{$people} ) { %>
					<div class="people_row people_person_row" uuid="<%= $person->{'uuid'} %>" app="<%= $person->{'app'} %>">
						<% if ($person->{'image'}) { %>
							<img class="people_peer_thumb" src="<%= $person->{'image'} %>" alt="<%= $person->{'name'} %>">
						<% } else { %>
							<span class="people_peer_thumb people_peer_thumb_empty"><%= substr($person->{'name'} || '?', 0, 1) %></span>
						<% } %>
						<span class="people_row_name">
							<%= $person->{'name'} %>
							<div class="people_row_sub"><%= $person->{'formatted_name'} %> &middot; <span class="people_fp"><%= $person->{'app'} %></span></div>
							<% if ($person->{'relationship'}) { %>
								<span class="people_relationship" data-rating="<%= $person->{'relationship_rating'} %>"><%= &subs::relationship_label($person->{'relationship'}) %></span>
							<% } %>
							<% if (@{$person->{'chips'}}) { %>
								<div class="people_chips">
									<% foreach my $chip ( @{$person->{'chips'}} ) { %>
										<span class="people_chip" construct-tab="<%= $chip->{'construct'} %>" construct-app="<%= $chip->{'app'} %>"><%= $chip->{'label'} %>: <%= $chip->{'name'} %></span>
									<% } %>
								</div>
							<% } %>
						</span>
					</div>
				<% } %>
			</div>
		<% } else { %>
			<div class="people_empty"><%= &subs::ui('No people yet. Add a person in Relational.') %></div>
		<% } %>
	</div>

	<% foreach my $construct ( @{$constructs} ) { %>
		<div class="people_panel" data-panel="<%= $construct->{'name'} %>">
			<% if (@{$construct->{'rows'}}) { %>
				<div class="people_list">
					<% foreach my $row ( @{$construct->{'rows'}} ) { %>
						<div class="people_row people_construct_row" app="<%= $row->{'app'} %>">
							<% if ($row->{'crest_image'}) { %>
								<img class="people_peer_thumb" src="<%= $row->{'crest_image'} %>" alt="<%= $row->{'name'} %>">
							<% } elsif ($row->{'image'}) { %>
								<img class="people_peer_thumb" src="<%= $row->{'image'} %>" alt="<%= $row->{'name'} %>">
							<% } else { %>
								<span class="people_peer_thumb people_peer_thumb_empty"><%= substr($row->{'name'} || '?', 0, 1) %></span>
							<% } %>
							<span class="people_row_name"><%= $row->{'name'} %><br><span class="people_fp"><%= $row->{'app'} %></span></span>
							<span class="people_row_sub"><%= $row->{'member_count'} %></span>
							<% unless ($row->{'foreign'}) { %>
								<% if ($row->{'public'}) { %>
									<button class="people_publish_toggle on" app="<%= $row->{'app'} %>" value="off" hint="Published"><%= &subs::ui('Published') %></button>
								<% } else { %>
									<button class="people_publish_toggle" app="<%= $row->{'app'} %>" value="on" hint="Publish"><%= &subs::ui('Publish') %></button>
								<% } %>
							<% } %>
							<span class="people_chevron">&#9656;</span>
						</div>
						<div class="people_member_list">
							<div class="people_construct_crest">
								<% if ($row->{'foreign'}) { %>
									<span class="people_row_sub"><%= &subs::ui('From') %> <%= $row->{'house_name'} || &subs::ui('another house') %></span>
									<% if ($row->{'web'}) { %>
										<button class="people_construct_web" web="<%= $row->{'web'} %>" hint="Open their page"><%= &subs::ui('Open their page') %></button>
									<% } %>
								<% } else { %>
									<% if ($row->{'crest_image'}) { %>
										<img class="people_construct_crest_thumb" src="<%= $row->{'crest_image'} %>" alt="<%= $row->{'name'} %>">
									<% } %>
									<button class="people_construct_crest_upload" app="<%= $row->{'app'} %>" hint="Upload a logo"><%= &subs::ui('Upload a logo') %></button>
									<input type="file" class="people_construct_crest_file" app="<%= $row->{'app'} %>" accept="image/*" style="display:none">
									<% if ($row->{'crest_uuid'}) { %>
										<button class="people_construct_crest_card" app="<%= $row->{'app'} %>" hint="Download card"><%= &subs::ui('Download card') %></button>
										<button class="people_construct_crest_qr" app="<%= $row->{'app'} %>" hint="Show QR"><%= &subs::ui('Show QR') %></button>
										<% if ($nfc) { %>
											<button class="people_construct_crest_nfc" app="<%= $row->{'app'} %>" hint="Write to NFC tag"><%= &subs::ui('Write to NFC tag') %></button>
										<% } %>
									<% } %>
									<div class="people_construct_qr" app="<%= $row->{'app'} %>"></div>
									<div class="people_aka" app="<%= $row->{'app'} %>">
										<% if (@{ $row->{'aka'} || [] }) { %>
											<span class="people_aka_label"><%= &subs::lang('people.aka') %></span>
											<% foreach my $aka ( @{ $row->{'aka'} } ) { %>
												<span class="people_aka_chip" app="<%= $row->{'app'} %>" name="<%= $aka %>"><%= $aka %><button class="people_aka_remove" app="<%= $row->{'app'} %>" name="<%= $aka %>" hint="Forget this name">&times;</button></span>
											<% } %>
										<% } %>
										<input class="people_aka_add" app="<%= $row->{'app'} %>" placeholder="<%= &subs::lang('people.aka_add') %>" hint="Add another name">
									</div>
								<% } %>
							</div>
							<% if ($row->{'foreign'}) { %>
								<div class="people_empty"><%= &subs::ui('Their members are kept by their house.') %></div>
							<% } elsif (@{$row->{'members'}}) { %>
								<% foreach my $member ( @{$row->{'members'}} ) { %>
									<div class="people_row people_member_row" uuid="<%= $member->{'uuid'} %>" app="<%= $member->{'app'} %>">
										<% if ($member->{'image'}) { %>
											<img class="people_peer_thumb" src="<%= $member->{'image'} %>" alt="<%= $member->{'name'} %>">
										<% } else { %>
											<span class="people_peer_thumb people_peer_thumb_empty"><%= substr($member->{'name'} || '?', 0, 1) %></span>
										<% } %>
										<span class="people_row_name"><%= $member->{'name'} %></span>
									</div>
								<% } %>
							<% } else { %>
								<div class="people_empty"><%= &subs::ui('No members yet.') %></div>
							<% } %>
						</div>
					<% } %>
				</div>
			<% } else { %>
				<div class="people_empty"><%= &subs::ui('Nothing here yet. Add one in Relational.') %></div>
			<% } %>
		</div>
	<% } %>
</div>
