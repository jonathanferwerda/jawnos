<% my $outputs = (ref($status) eq 'HASH' && ref($status->{'outputs'}) eq 'ARRAY') ? $status->{'outputs'} : []; %>
<% my $inputs = (ref($status) eq 'HASH' && ref($status->{'inputs'}) eq 'ARRAY') ? $status->{'inputs'} : []; %>
<% my $output = (ref($status) eq 'HASH' && ref($status->{'output'}) eq 'HASH') ? $status->{'output'} : {}; %>
<% my $input = (ref($status) eq 'HASH' && ref($status->{'input'}) eq 'HASH') ? $status->{'input'} : {}; %>
<% my $output_volume = defined $output->{'volume'} ? $output->{'volume'} : 0; %>
<% my $input_volume = defined $input->{'volume'} ? $input->{'volume'} : 0; %>
<% my $input_supported = (ref($status) eq 'HASH' && exists $status->{'input_supported'}) ? $status->{'input_supported'} : 1; %>
<style>
#sound { flex: 1 1 auto; min-width: 0; min-height: 0; display: flex; flex-direction: column; gap: 14px; padding: 14px; overflow: hidden; font-size: 16px; }
#sound .sound_note { min-height: 1.2em; opacity: .78; }
#sound .sound_columns { display: flex; flex-wrap: wrap; gap: 14px; align-items: flex-start; }
#sound .sound_section { flex: 1 1 100%; min-width: 0; padding: 0; border: 1px solid var(--line); border-radius: calc(var(--jawnos-corner, 12px) * .8); overflow: hidden; display: none; }
#sound .sound_section_head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding: 8px 12px; border-bottom: 1px solid var(--line); background: var(--panel-2, var(--panel)); }
#sound .sound_section_tabs { display: flex; gap: 8px; flex: 0 0 auto; overflow-x: scroll; overflow-y: hidden; padding-bottom: 4px; scrollbar-width: thin; -webkit-overflow-scrolling: touch; }
#sound .sound_section_pill { flex: 0 0 auto; padding: 5px 14px; border: 1px solid var(--line); border-radius: 999px; background: var(--panel-2, var(--panel)); color: inherit; font: inherit; cursor: var(--jawnos-cursor-pointer, pointer); white-space: nowrap; opacity: .85; }
#sound .sound_section_pill.is-active { background: var(--accent, #3b7ddd); border-color: var(--accent, #3b7ddd); color: #fff; opacity: 1; }
#sound .sound_section.is-active { flex: 1 1 auto; display: flex; flex-direction: column; min-height: 0; }
#sound .sound_section_head h3 { margin: 0; font-size: 16px; }
#sound .sound_section_body { padding: 12px 16px; flex: 1 1 auto; min-height: 0; overflow: auto; }
#sound .sound_subsection { flex: 1 1 300px; min-width: 0; }
#sound .sound_subsection h4 { margin: 0 0 8px; font-size: 15px; }
#sound .sound_profiles_body > .sound_subsection + .sound_subsection { margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--line); }
#sound .sound_media_section { flex: 1 1 100%; }
#sound .sound_media_row { display:flex; align-items:center; gap:8px; }
#sound .sound_media_row img { width:28px; height:28px; object-fit:contain; }
#sound .sound_browser { font-size: 14px; opacity: .72; margin-bottom: 10px; }
#sound .sound_devices { display: flex; flex-direction: column; gap: 6px; margin-bottom: 12px; }
#sound .sound_device { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 6px 8px; border: 1px solid transparent; border-radius: calc(var(--jawnos-corner, 12px) * .5); }
#sound .sound_device[data-default="1"] { border-color: var(--accent, #3b7ddd); background: color-mix(in srgb, var(--accent, #3b7ddd) 10%, transparent); }
#sound .sound_device_name { flex: 1 1 140px; min-width: 0; overflow-wrap: anywhere; }
#sound .sound_device_level { opacity: .72; }
#sound .sound_badge { font-size: 13px; padding: 1px 7px; border-radius: 999px; background: var(--accent, #3b7ddd); color: #fff; }
#sound .sound_default { font-size: 13px; }
#sound .sound_empty { opacity: .7; margin: 4px 0 12px; }
#sound .sound_control { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
#sound .sound_control label { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; flex: 1 1 220px; }
#sound .sound_control input[type=range] { flex: 1 1 120px; min-width: 0; }
#sound .sound_control button[disabled], #sound .sound_control input[disabled] { opacity: .45; }
#sound .sound_level_row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
#sound .sound_level_now { opacity: .78; }
#sound .sound_level_hint { margin: 8px 0 0; font-size: 14px; opacity: .72; }
#sound .sound_profile_row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 5px 0; border-bottom: 1px solid var(--line); }
#sound .sound_profile_app { flex: 1 1 140px; min-width: 0; overflow-wrap: anywhere; }
#sound .sound_profile_add { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 10px; }
#sound .sound_patch_manage { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-bottom: 8px; }
#sound .sound_patch_device { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin: 8px 0 4px; }
#sound .sound_patch_device select { max-width: 280px; }
#sound .sound_patch_group { margin: 10px 0; }
#sound .sound_patch_group h4 { margin: 0 0 4px; font-size: 15px; }
#sound .sound_patch_node { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 4px 0; border-bottom: 1px solid var(--line); }
#sound .sound_patch_node_id { flex: 1 1 130px; min-width: 0; overflow-wrap: anywhere; }
#sound .sound_patch_node_kind { opacity: .78; font-size: 13px; }
#sound .sound_patch_routes { width: 100%; border-collapse: collapse; font-size: 14px; }
#sound .sound_patch_routes th, #sound .sound_patch_routes td { text-align: left; padding: 4px 6px; border-bottom: 1px solid var(--line); }
#sound .sound_patch_routes select { max-width: 150px; }
#sound .sound_patch_routes input[type=range] { width: 90px; }
#sound .sound_patch_add { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 8px; }
#sound .sound_patch_add input[type=text], #sound .sound_patch_add input[type=number] { width: 110px; }
#sound .sound_patch_save { margin-top: 10px; }
#sound .sound_apps_body > .sound_subsection + .sound_subsection { margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--line); }
#sound .sound_apps_row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 6px 0; border-bottom: 1px solid var(--line); }
#sound .sound_apps_head { flex: 1 1 220px; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
#sound .sound_apps_name { overflow-wrap: anywhere; }
#sound .sound_apps_detail { font-size: 13px; opacity: .72; overflow-wrap: anywhere; }
#sound .sound_apps_row .sound_control { flex: 1 1 240px; }
#sound .sound_apps_value { min-width: 4.5em; text-align: right; opacity: .78; }
#sound .sound_apps_rows { max-height: 240px; overflow-y: auto; }
</style>
<div id="sound" app="sound">
	<div class="sound_note" id="sound_note"></div>
	<div class="sound_section_tabs" role="tablist" aria-label="<%= &subs::ui('Sound sections') %>">
		<button type="button" class="sound_section_pill is-active" role="tab" data-section="patchbay" aria-selected="true" aria-controls="sound_section_patchbay" hint="<%= &subs::ui('Show this section') %>"><%= &subs::ui('Patchbay') %></button>
		<button type="button" class="sound_section_pill" role="tab" data-section="io" aria-selected="false" aria-controls="sound_section_io" hint="<%= &subs::ui('Show this section') %>"><%= &subs::ui('IO') %></button>
		<button type="button" class="sound_section_pill" role="tab" data-section="profiles" aria-selected="false" aria-controls="sound_section_profiles" hint="<%= &subs::ui('Show this section') %>"><%= &subs::lang('sound_profiles') %></button>
		<button type="button" class="sound_section_pill" role="tab" data-section="apps" aria-selected="false" aria-controls="sound_section_apps" hint="<%= &subs::ui('Show this section') %>"><%= &subs::lang('sound_apps') %></button>
	</div>
% my $level = (ref($status) eq 'HASH' && $status->{'level'}) ? $status->{'level'} : 'sound';
% my $house_level = (ref($status) eq 'HASH' && $status->{'house_level'}) ? $status->{'house_level'} : $level;
% my $app_choices = (ref($status) eq 'HASH' && ref($status->{'apps'}) eq 'ARRAY') ? $status->{'apps'} : [];
	<section id="sound_section_patchbay" class="sound_section sound_patchbay_section is-active" data-section="patchbay" role="tabpanel">
		<div class="sound_section_head"><h3><%= &subs::ui('Patchbay') %></h3></div>
		<div class="sound_section_body">
			<p class="sound_level_hint"><%= &subs::ui('One routing table for every input and output in the house. A source makes samples, a bus mixes them, and a sink plays them. The switch lets this machine\'s engine own the audio, so the plan is what is heard.') %></p>
			<div class="sound_patch_manage">
				<label><input type="checkbox" id="sound_manage" hint="<%= &subs::ui('Let the audio engine own this machine\'s inputs and outputs') %>"> <%= &subs::ui('The engine owns this machine\'s audio') %></label>
				<span class="sound_level_now" id="sound_engine_state"></span>
			</div>

			<div class="sound_patch_device">
				<label for="sound_engine_device"><%= &subs::ui('Engine device') %></label>
				<select id="sound_engine_device" hint="<%= &subs::ui('Choose the audio interface the engine opens') %>"></select>
				<button type="button" id="sound_engine_device_apply" hint="<%= &subs::ui('Use this device and restart the engine') %>"><%= &subs::ui('Use this device') %></button>
				<span class="sound_level_now" id="sound_engine_device_note"></span>
			</div>
			<div class="sound_note" id="sound_patch_note"></div>
			<div id="sound_patch_matrix"></div>
			<div class="sound_patch_add">
				<input type="text" id="sound_source_id" placeholder="<%= &subs::ui('source name') %>">
				<select id="sound_source_kind">
					<option value="input">input</option>
					<option value="player">player</option>
					<option value="peer">peer</option>
					<option value="handset">handset</option>
					<option value="device">device</option>
				</select>
				<input type="number" id="sound_source_channel" min="0" value="0" hint="<%= &subs::ui('device input channel') %>">
				<input type="text" id="sound_source_machine" placeholder="<%= &subs::ui('machine') %>" hint="<%= &subs::ui('The machine this source runs on; leave blank for this machine') %>">
				<button type="button" id="sound_source_add"><%= &subs::ui('Add source') %></button>
				<input type="text" id="sound_sink_id" placeholder="<%= &subs::ui('sink name') %>">
				<select id="sound_sink_kind">
					<option value="interface">interface</option>
					<option value="speakers">speakers</option>
					<option value="zone">zone</option>
					<option value="peer">peer</option>
				</select>
				<input type="number" id="sound_sink_channel" min="0" value="0" hint="<%= &subs::ui('device output channel') %>">
				<input type="text" id="sound_sink_machine" placeholder="<%= &subs::ui('machine') %>" hint="<%= &subs::ui('The machine this sink plays on; leave blank for this machine') %>">
				<button type="button" id="sound_sink_add"><%= &subs::ui('Add sink') %></button>
				<input type="text" id="sound_bus_id" placeholder="<%= &subs::ui('bus name') %>">
				<button type="button" id="sound_bus_add"><%= &subs::ui('Add bus') %></button>
			</div>
			<div class="sound_patch_add">
				<select id="sound_route_from" hint="<%= &subs::ui('where the samples come from') %>"></select>
				<select id="sound_route_to" hint="<%= &subs::ui('where they go') %>"></select>
				<button type="button" id="sound_route_add"><%= &subs::ui('Add route') %></button>
			</div>
			<button type="button" class="sound_patch_save" id="sound_patch_save" hint="<%= &subs::ui('Save the plan for the whole house') %>"><%= &subs::ui('Save plan') %></button>
		</div>
	</section>
	<section id="sound_section_io" class="sound_section sound_io_section" data-section="io" role="tabpanel">
		<div class="sound_section_head"><h3><%= &subs::ui('IO') %></h3></div>
		<div class="sound_section_body">
			<div class="sound_columns">
				<section class="sound_subsection" data-kind="output">
					<h4><%= &subs::lang('sound_output') %></h4>
					<div class="sound_browser"><%= &subs::lang('sound_speaker') %>: <span id="sound_browser_output">—</span></div>
					<div class="sound_devices" id="sound_output_list">
% foreach my $device (@{$outputs}) {
						<div class="sound_device" data-kind="output" data-id="<%= $device->{'id'} %>"<% if ($device->{'default'}) { %> data-default="1"<% } %>>
							<span class="sound_device_name"><%= $device->{'name'} || $device->{'id'} %></span>
							<span class="sound_device_level"><%= $device->{'volume'} %>%</span>
% if ($device->{'default'}) {
							<span class="sound_badge"><%= &subs::lang('sound_default') %></span>
% } else {
							<button type="button" class="sound_default" data-kind="output" hint="<%= &subs::ui('Make this output the default speaker') %>" data-id="<%= $device->{'id'} %>"><%= &subs::lang('sound_set_default') %></button>
% }
						</div>
% }
% if (!@{$outputs}) {
						<p class="sound_empty"><%= &subs::lang('sound_no_devices') %></p>
% }
					</div>
					<div class="sound_control">
						<label><%= &subs::lang('sound_volume') %>
							<input type="range" id="sound_output_volume" hint="<%= &subs::ui('Drag to set the default speaker volume') %>" min="0" max="100" step="1" value="<%= $output_volume %>"<% if (!$output->{'id'}) { %> disabled<% } %>>
							<span id="sound_output_volume_value"><%= $output_volume %>%</span>
						</label>
						<button type="button" id="sound_output_mute" hint="<%= &subs::ui('Mute the default speaker') %>" data-kind="output"<% if (!$output->{'id'}) { %> disabled<% } %>><%= &subs::lang('sound_mute') %></button>
					</div>
				</section>
				<section class="sound_subsection" data-kind="input"<% if (!$input_supported) { %> data-unsupported="1"<% } %>>
					<h4><%= &subs::lang('sound_input') %></h4>
					<div class="sound_browser"><%= &subs::lang('sound_microphone') %>: <span id="sound_browser_input">—</span></div>
					<div class="sound_devices" id="sound_input_list">
% foreach my $device (@{$inputs}) {
						<div class="sound_device" data-kind="input" data-id="<%= $device->{'id'} %>"<% if ($device->{'default'}) { %> data-default="1"<% } %>>
							<span class="sound_device_name"><%= $device->{'name'} || $device->{'id'} %></span>
							<span class="sound_device_level"><%= $device->{'volume'} %>%</span>
% if ($device->{'default'}) {
							<span class="sound_badge"><%= &subs::lang('sound_default') %></span>
% } else {
							<button type="button" class="sound_default" data-kind="input" hint="<%= &subs::ui('Make this input the default microphone') %>" data-id="<%= $device->{'id'} %>"><%= &subs::lang('sound_set_default') %></button>
% }
						</div>
% }
% if (!@{$inputs}) {
						<p class="sound_empty" id="sound_input_empty"><%= &subs::lang('sound_not_available') %></p>
% }
					</div>
					<div class="sound_control">
						<label><%= &subs::lang('sound_volume') %>
							<input type="range" id="sound_input_volume" hint="<%= &subs::ui('Drag to set the default microphone volume, when the mixer exposes it') %>" min="0" max="100" step="1" value="<%= $input_volume %>"<% if (!$input_supported || !$input->{'id'}) { %> disabled<% } %>>
							<span id="sound_input_volume_value"><%= $input_volume %>%</span>
						</label>
						<button type="button" id="sound_input_mute" hint="<%= &subs::ui('Mute the default microphone') %>" data-kind="input"<% if (!$input_supported || !$input->{'id'}) { %> disabled<% } %>><%= &subs::lang('sound_mute') %></button>
					</div>
				</section>
				<%= include 'apps/sound/media' %>
			</div>
		</div>
	</section>
	<section id="sound_section_profiles" class="sound_section sound_profiles_section" data-section="profiles" role="tabpanel">
		<div class="sound_section_head"><h3><%= &subs::lang('sound_profiles') %></h3></div>
		<div class="sound_section_body sound_profiles_body">
			<div class="sound_subsection sound_level_section">
				<h4><%= &subs::lang('sound_level') %></h4>
				<div class="sound_level_row">
					<select id="sound_level" hint="<%= &subs::ui('Set the house level: Sound, Quiet, Mute or Silence') %>">
% foreach my $opt ( grep { $_ ne 'passive' } @subs::SOUND_LEVELS ) {
						<option value="<%= $opt %>"<% if ($level eq $opt) { %> selected="selected"<% } %>><%= &subs::sound_level_label($opt) %></option>
% }
					</select>
					<span class="sound_level_now"><%= &subs::ui('The house is at') %> <b id="sound_house_level"><%= &subs::sound_level_label($house_level) %></b></span>
				</div>
				<p class="sound_level_hint"><%= &subs::ui('Sound is normal. Quiet softens the non-essential sounds. Mute silences media, speech and notifications but leaves alarms and a ringing call. Silence takes everything, alarms included, and sends every call to the receptionist.') %></p>
			</div>
			<div class="sound_subsection">
				<h4><%= &subs::ui('App profiles') %></h4>
				<p class="sound_level_hint"><%= &subs::ui('An app\'s own profile wins for its sounds while one of its appointments runs. Passive inherits the house level, and the most recently started running app with a profile takes the house.') %></p>
				<div id="sound_profiles_list"></div>
				<div class="sound_profile_add">
					<input type="text" id="sound_profile_app" list="sound_profile_apps" placeholder="<%= &subs::lang('sound_add_profile') %>">
					<datalist id="sound_profile_apps">
% foreach my $name ( @{$app_choices} ) {
						<option value="<%= $name %>"></option>
% }
					</datalist>
					<select id="sound_profile_new_level">
% foreach my $opt ( @subs::SOUND_LEVELS ) {
						<option value="<%= $opt %>"><%= &subs::sound_level_label($opt) %></option>
% }
					</select>
					<button type="button" id="sound_profile_add"><%= &subs::ui('Save') %></button>
				</div>
			</div>
		</div>
	</section>
	<section id="sound_section_apps" class="sound_section sound_apps_section" data-section="apps" role="tabpanel">
		<div class="sound_section_head"><h3><%= &subs::lang('sound_apps') %></h3></div>
		<div class="sound_section_body sound_apps_body">
			<div class="sound_subsection">
				<h4><%= &subs::lang('sound_house_channels') %></h4>
				<div id="sound_apps_channels"></div>
			</div>
			<div class="sound_subsection">
				<h4><%= &subs::lang('sound_jawnos_apps') %></h4>
				<div id="sound_apps_apps" class="sound_apps_rows" tabindex="0" aria-label="<%= &subs::ui('Apps with a window open on this machine') %>"></div>
			</div>
			<div class="sound_subsection">
				<h4><%= &subs::lang('sound_playing_now') %></h4>
				<p class="sound_level_hint"><%= &subs::ui('Each row is one stream as the sound system lists it. Chromium and Firefox appear by the media they are playing; the operating system exposes no finer per-tab control.') %></p>
				<div id="sound_apps_playback" class="sound_apps_rows" tabindex="0" aria-label="<%= &subs::lang('sound_playing_now') %>"></div>
			</div>
			<div class="sound_subsection">
				<h4><%= &subs::lang('sound_recording_now') %></h4>
				<div id="sound_apps_recording" class="sound_apps_rows" tabindex="0" aria-label="<%= &subs::lang('sound_recording_now') %>"></div>
			</div>
			<div class="sound_note" id="sound_apps_note"></div>
		</div>
	</section>
</div>
