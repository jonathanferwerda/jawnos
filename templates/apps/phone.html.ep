<%# The Phone app: the house's numbers - the people it knows (Known) and the
    numbers that are only numbers (All) - the calls it has logged (Recent), the
    desk's blocked numbers (Blocked), and a dial pad. On a phone the dial pad
    places a call through /manager/phone/dial (termux-telephony-call); in the app
    it also shows live call state from window.__jawnPhoneEvent and reads the
    device's own contacts from window.JawnContacts. %>
<style>
	/* the panel is the window's only child and the window's contents are a flex
	   box, so this div has to claim the space itself: without it the flex parent
	   shrink-wraps it to its widest row and the whole app sits off to the left. */
	#phone_app { width:100%; height:100%; box-sizing:border-box; }
	.phone_app_tabs { display:flex; gap:6px; justify-content:center; flex-wrap:wrap; margin-bottom:10px; }
	.phone_app_tab { padding:6px 14px; border:1px solid var(--line); border-radius:999px;
		background:var(--panel); cursor:pointer; font-size:13px; user-select:none; }
	.phone_app_tab.on { background:var(--accent,#4a90d9); color:#fff; border-color:transparent; }
	.phone_app_status { text-align:center; min-height:20px; color:var(--muted,#8e8e8e); font-size:13px; margin-bottom:10px; }
	.phone_app_pane { display:none; }
	.phone_app_pane.on { display:block; }
	.phone_app_list { max-height:340px; overflow:auto; }
	.phone_app_row { display:flex; align-items:center; gap:10px; padding:9px 10px;
		border-bottom:1px solid var(--line); cursor:pointer; border-radius:8px; }
	.phone_app_row:hover { background:var(--line); }
	.phone_app_avatar { width:34px; height:34px; border-radius:50%; background:var(--line);
		display:flex; align-items:center; justify-content:center; flex:0 0 auto; overflow:hidden; }
	.phone_app_avatar img { width:100%; height:100%; object-fit:cover; }
	.phone_app_name { flex:1 1 auto; font-size:15px; }
	.phone_app_sub { font-size:12px; color:var(--muted,#8e8e8e); }
	.phone_app_line { text-decoration:underline dotted; text-underline-offset:2px; cursor:pointer; }
	.phone_app_line:hover { color:var(--accent,#4a90d9); }
	.phone_app_missed .phone_app_name { color:#e0444e; }
	.phone_app_block { flex:0 0 auto; opacity:0.55; cursor:pointer; }
	.phone_app_block:hover { opacity:1; }
	.phone_app_row_call { flex:0 0 auto; opacity:0.7; cursor:pointer; }
	.phone_app_row_call:hover { opacity:1; }
	.phone_app_ivr { max-width:420px; margin:0 auto; display:flex; flex-direction:column; gap:10px; }
	.phone_app_ivr label { display:flex; flex-direction:column; gap:4px; font-size:13px; }
	.phone_app_ivr textarea, .phone_app_ivr select { width:100%; box-sizing:border-box; font:inherit; padding:7px;
		border:1px solid var(--line); border-radius:8px; background:var(--panel); color:inherit; }
	.phone_app_ivr textarea { resize:vertical; }
	.phone_app_ivr .phone_app_ivr_toggle { flex-direction:row; align-items:center; gap:8px; }
	.phone_app_ivr_save { align-self:flex-start; padding:7px 18px; border-radius:999px;
		border:1px solid var(--line); background:var(--panel); color:inherit; cursor:pointer; }
	.phone_app_ivr_status { min-height:18px; color:var(--muted,#8e8e8e); font-size:12px; }
	.phone_app_stranger .phone_app_name { font-variant-numeric:tabular-nums; letter-spacing:1px; }
	.phone_app_stranger .phone_app_avatar { opacity:0.6; }
	.phone_app_unblock { flex:0 0 auto; font-size:12px; padding:3px 10px; border-radius:999px;
		border:1px solid var(--line); background:var(--panel); cursor:pointer; }
	.phone_app_unblock[armed="yes"] { background:#b0342e; color:#fff; border-color:transparent; }
	.phone_app_dial { max-width:300px; margin:0 auto; }
	.phone_app_display { min-height:40px; font-size:27px; text-align:center; letter-spacing:2px; }
	.phone_app_keys { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin-top:10px; }
	.phone_app_key { padding:15px 0; font-size:21px; text-align:center; border:1px solid var(--line);
		border-radius:12px; background:var(--panel); cursor:pointer; user-select:none; }
	.phone_app_key:active { background:var(--line); }
	.phone_app_call { margin-top:14px; text-align:center; }
	.phone_app_empty { color:var(--muted,#8e8e8e); font-size:13px; text-align:center; padding:18px; }
</style>

<div id="phone_app" class="phone_app" style="padding:14px;">
	<div class="phone_app_tabs">
		<span class="phone_app_tab on" pane="known" hint="Known">Known</span>
		<span class="phone_app_tab" pane="recent" hint="Recent">Recent</span>
		<span class="phone_app_tab" pane="blocked" hint="Blocked">Blocked</span>
		<span class="phone_app_tab" pane="ivr" hint="IVR">IVR</span>
		<span class="phone_app_tab" pane="all" hint="All">All</span>
		<span class="phone_app_tab" pane="dial" hint="Dial">Dial</span>
	</div>
	<div class="phone_app_status" id="phone_app_status">Idle</div>
	<div class="phone_app_callerid_row" style="text-align:center;margin-bottom:10px;">
		<span class="phone_app_callerid_state" style="color:var(--muted,#8e8e8e);font-size:12px;"></span>
		<button class="phone_app_callerid" hint="Caller ID" style="display:none;">Turn on Caller ID</button>
	</div>

	<%# Known: the people the house knows - their numbers, and nothing else %>
	<div class="phone_app_pane on" pane="known">
		<% if (@{$known}) { %>
			<div class="phone_app_list">
			<% foreach my $contact (@{$known}) { %>
				<% my @lines = grep { $_->{'value'} } @{ $contact->{'numbers'} || [] }; %>
				<div class="phone_app_row" number="<%= $contact->{'value'} %>" app="<%= $contact->{'app'} %>">
					<span class="phone_app_avatar"><img src="<%= &subs::icon_for('/images/decipherable/phone.png') %>"></span>
					<span class="phone_app_name"><%= &subs::format_name($contact->{'app'}) %></span>
					<span class="phone_app_sub"><% my $sep = ''; foreach my $l (@lines) { %><%== $sep %><span class="phone_app_line" dial="<%= $l->{'value'} %>"><%= $l->{'display'} || $l->{'value'} %></span><% $sep = ' · '; } %></span>
				</div>
			<% } %>
			</div>
		<% } else { %>
			<div class="phone_app_empty">No contacts here yet.</div>
		<% } %>
	</div>

	<%# Recent: the calls themselves, newest first, each able to be blocked %>
	<div class="phone_app_pane" pane="recent">
		<% if (@{$calls}) { %>
			<div class="phone_app_list">
			<% foreach my $call (@{$calls}) { %>
				<% my $name = &subs::format_name($call->{'app'} || 'phone'); %>
				<div class="phone_app_row <% if (($call->{'type'} || '') eq 'cancel') { %>phone_app_missed<% } %>"
					app="<%= $call->{'app'} %>" uuid="<%= $call->{'uuid'} %>" number="<%= defined $call->{'account'} ? $call->{'account'} : '' %>" timestamp="<%= $call->{'timestamp'} %>">
					<span class="phone_app_avatar"><img src="<%= &subs::icon_for('/images/decipherable/phone.png') %>"></span>
					<span class="phone_app_name"><%= $name %></span>
					<span class="phone_app_sub" duration="<%= $call->{'duration'} %>"><%= &subs::formatted_time($call->{'timestamp'}) %></span>
					<% if (defined $call->{'account'} && length $call->{'account'}) { %>
						<img class="little_thumb phone_app_row_call" hint="Call" number="<%= $call->{'account'} %>" src="<%= &subs::icon_path('phone', '/images/decipherable/phone.png') %>">
					<% } %>
					<img class="little_thumb phone_app_block" hint="Block" src="<%= &subs::icon_path('ne pas', '/images/decipherable/padlock.png') %>">
				</div>
			<% } %>
			</div>
		<% } else { %>
			<div class="phone_app_empty">No calls yet.</div>
		<% } %>
	</div>

	<%# Blocked: the desk's list, as calls. A number here never rings %>
	<div class="phone_app_pane" pane="blocked">
		<% if (@{$blocked}) { %>
			<div class="phone_app_list">
			<% foreach my $b (@{$blocked}) { %>
				<div class="phone_app_row">
					<span class="phone_app_avatar"><img src="<%= &subs::icon_path('ne pas', '/images/decipherable/padlock.png') %>"></span>
					<span class="phone_app_name"><%= $b->{'name'} ? &subs::format_name($b->{'name'}) . ' · ' : '' %><%= $b->{'number'} %></span>
					<span class="phone_app_sub"><%= $b->{'note'} %></span>
					<button class="phone_app_unblock" hint="Unblock" number="<%= $b->{'number'} %>" stamp="<%= $b->{'stamp'} %>">Unblock</button>
				</div>
			<% } %>
			</div>
		<% } else { %>
			<div class="phone_app_empty">Nothing is blocked.</div>
		<% } %>
	</div>

	<%# IVR: the reception settings. The machine list is the house's remote_machines,
	    online first; the chosen one runs the audio gateway. The prompts are the
	    words the gateway speaks, and the voice is the Piper voice it renders. %>
	<div class="phone_app_pane" pane="ivr">
		<div class="phone_app_ivr">
			<label class="phone_app_ivr_toggle"><input type="checkbox" id="phone_ivr_enabled" <%= (($ivr->{'enabled'} || '') eq 'yes') ? 'checked' : '' %>> Enable IVR</label>
			<label>Remote machine
				<select id="phone_ivr_machine">
					<option value="">— No gateway —</option>
					<% foreach my $m (@{$ivr_machines || []}) { %>
						<option value="<%= $m->{'key'} %>" <%= (($ivr->{'machine'} || '') eq $m->{'key'}) ? 'selected' : '' %>><%= $m->{'hostname'} %> — <%= $m->{'available'} ? 'online' : 'offline' %></option>
					<% } %>
				</select>
			</label>
			<div class="phone_app_ivr_status">
				<% if ($ivr->{'machine'}) { %>
					Gateway: <%= $ivr->{'machine_label'} || $ivr->{'machine'} %> — <%= $ivr->{'machine_available'} ? 'online' : 'offline' %>
				<% } else { %>
					No IVR gateway selected.
				<% } %>
			</div>
			<label>Call routing
				<select id="phone_ivr_route">
					<option value="unknown" <%= (($ivr->{'route'} || '') eq 'unknown') ? 'selected' : '' %>>Strangers only</option>
					<option value="all" <%= (($ivr->{'route'} || '') eq 'all') ? 'selected' : '' %>>Everyone</option>
					<option value="off" <%= (($ivr->{'route'} || '') eq 'off') ? 'selected' : '' %>>Off</option>
				</select>
			</label>
			<label>Voice
				<select id="phone_ivr_voice">
					<% foreach my $v (@{$ivr_voices || []}) { %>
						<option value="<%= $v->{'value'} %>" <%= (($ivr->{'voice'} || '') eq $v->{'value'}) ? 'selected' : '' %>><%= $v->{'label'} %></option>
					<% } %>
				</select>
			</label>
			<label>Greeting<textarea id="phone_ivr_greeting" rows="2"><%= $ivr->{'greeting'} %></textarea></label>
			<label>Name prompt<textarea id="phone_ivr_prompt" rows="2"><%= $ivr->{'prompt'} %></textarea></label>
			<label>Voicemail greeting<textarea id="phone_ivr_voicemail" rows="2"><%= $ivr->{'voicemail'} %></textarea></label>
			<button class="phone_app_ivr_save" id="phone_ivr_save" hint="Save">Save</button>
			<div class="phone_app_ivr_status" id="phone_ivr_status"></div>
		</div>
	</div>

	<%# All: every number the house holds - the people, and the numbers a caller
	    left behind that no name has claimed yet %>
	<div class="phone_app_pane" pane="all">
		<div class="phone_app_list">
		<% foreach my $contact (@{$known}) { %>
			<% my @lines = grep { $_->{'value'} } @{ $contact->{'numbers'} || [] }; %>
			<div class="phone_app_row" number="<%= $contact->{'value'} %>" app="<%= $contact->{'app'} %>">
				<span class="phone_app_avatar"><img src="<%= &subs::icon_for('/images/decipherable/phone.png') %>"></span>
				<span class="phone_app_name"><%= &subs::format_name($contact->{'app'}) %></span>
				<span class="phone_app_sub"><% my $sep = ''; foreach my $l (@lines) { %><%== $sep %><span class="phone_app_line" dial="<%= $l->{'value'} %>"><%= $l->{'display'} || $l->{'value'} %></span><% $sep = ' · '; } %></span>
			</div>
		<% } %>
		<% foreach my $stranger (@{$numbers}) { %>
			<div class="phone_app_row phone_app_stranger" number="<%= $stranger->{'value'} %>" app="<%= $stranger->{'app'} %>">
				<span class="phone_app_avatar"><img src="<%= &subs::icon_for('/images/decipherable/question mark.png') %>"></span>
				<span class="phone_app_name"><%= $stranger->{'value'} %></span>
				<span class="phone_app_sub">unnamed<%= $stranger->{'blocked'} ? ' · blocked' : '' %></span>
			</div>
		<% } %>
		<% if (!scalar @{$known} && !scalar @{$numbers}) { %>
			<div class="phone_app_empty">No numbers here yet.</div>
		<% } %>
		</div>
	</div>

	<div class="phone_app_pane" pane="dial">
		<div class="phone_app_dial">
			<div class="phone_app_display" id="phone_app_display"></div>
			<div class="phone_app_keys">
				<% foreach my $k ( (1 .. 9), '*', 0, '#' ) { %>
					<div class="phone_app_key" key="<%= $k %>"><%= $k %></div>
				<% } %>
			</div>
			<div class="phone_app_call">
				<img class="medium_thumb phone_app_dial_btn" hint="Call" src="<%= &subs::icon_path('phone', '/images/decipherable/phone.png') %>">
			</div>
		</div>
	</div>
</div>
