<%# The Phone app: the house's numbers - the people it knows (Known) and the
    numbers that are only numbers (All) - the calls it has logged (Recent), the
    desk's blocked numbers (Blocked), and a dial pad. On a phone the dial pad
    places a call through /manager/phone/dial (termux-telephony-call); in the app
    it also shows live call state from window.__jawnPhoneEvent and reads the
    device's own contacts from window.JawnContacts. %>
<% use Mojo::JSON qw/encode_json/; %>
<style>
	/* the panel is the window's only child and the window's contents are a flex
	   box, so this div has to claim the space itself: without it the flex parent
	   shrink-wraps it to its widest row and the whole app sits off to the left. */
	#phone_app { width:100%; height:100%; box-sizing:border-box; display:flex; flex-direction:column; }
	/* a pane keeps its own room and scrolls inside the window: the IVR page is
	   taller than the window on a phone, and it used to hang out of it */
	.phone_app_tabs, .phone_app_status, .phone_app_callerid_row { flex:0 0 auto; }
	.phone_app_pane.on { display:block; flex:1 1 auto; min-height:0; overflow-y:auto; }
	.phone_app_tabs { display:flex; gap:6px; justify-content:center; flex-wrap:wrap; margin-bottom:10px; }
	.phone_app_tab { padding:6px 14px; border:1px solid var(--line); border-radius:999px;
		background:var(--panel); cursor:pointer; font-size:13px; user-select:none; }
	.phone_app_tab.on { background:var(--accent,#4a90d9); color:#fff; border-color:transparent; }
	.phone_app_status { text-align:center; min-height:20px; color:var(--muted,#8e8e8e); font-size:13px; margin-bottom:10px; }
	.phone_app_pane { display:none; }
	.phone_app_pane.on { display:block; }
	.phone_app_list { max-height:340px; overflow:auto; }
	.phone_app_row { display:flex; align-items:center; gap:10px; padding:9px 10px;
		border-bottom:1px solid var(--line); cursor:pointer; border-radius:8px; }
	.phone_app_row:hover { background:var(--line); }
	.phone_app_avatar { width:34px; height:34px; border-radius:50%; background:var(--line);
		display:flex; align-items:center; justify-content:center; flex:0 0 auto; overflow:hidden; }
	.phone_app_avatar img { width:100%; height:100%; object-fit:cover; }
	.phone_app_name { flex:1 1 auto; font-size:15px; }
	.phone_app_sub { font-size:12px; color:var(--muted,#8e8e8e); }
	.phone_app_line { text-decoration:underline dotted; text-underline-offset:2px; cursor:pointer; }
	.phone_app_line:hover { color:var(--accent,#4a90d9); }
	.phone_app_missed .phone_app_name { color:#e0444e; }
	.phone_app_block { flex:0 0 auto; opacity:0.55; cursor:pointer; }
	.phone_app_block:hover { opacity:1; }
	.phone_app_row_call { flex:0 0 auto; opacity:0.7; cursor:pointer; }
	.phone_app_row_call:hover { opacity:1; }
	.phone_app_ivr { max-width:420px; margin:0 auto; display:flex; flex-direction:column; gap:10px; }
	.phone_app_ivr label { display:flex; flex-direction:column; gap:4px; font-size:13px; }
	.phone_app_ivr textarea, .phone_app_ivr select { width:100%; box-sizing:border-box; font:inherit; padding:7px;
		border:1px solid var(--line); border-radius:8px; background:var(--panel); color:inherit; }
	.phone_app_ivr textarea { resize:vertical; }
	.phone_app_ivr .phone_app_ivr_toggle { flex-direction:row; align-items:center; gap:8px; }
	.phone_app_ivr_save { align-self:flex-start; padding:7px 18px; border-radius:999px;
		border:1px solid var(--line); background:var(--panel); color:inherit; cursor:pointer; }
	.phone_app_ivr_status { min-height:18px; color:var(--muted,#8e8e8e); font-size:12px; }
	.phone_app_ivr_flows { display:flex; flex-direction:column; gap:6px; }
	.phone_app_ivr_flow_row { display:flex; align-items:center; gap:8px; }
	.phone_app_ivr_flow_label { flex:1 1 auto; }
	.phone_app_ivr_flow_row select { flex:0 0 150px; }
	/* the named flows: a list of names with their caller counts, each opening
	   into its own words */
	.phone_app_ivr_flows_editor { display:flex; flex-direction:column; gap:8px; }
	.phone_app_ivr_flows_title { font-size:14px; font-weight:600; }
	.phone_app_ivr_flow_list { display:flex; flex-direction:column; gap:6px; }
	.phone_app_ivr_flow_item { border:1px solid var(--line); border-radius:9px; overflow:hidden; }
	.phone_app_ivr_flow_head { display:flex; align-items:center; gap:8px; padding:8px 10px; cursor:pointer; }
	.phone_app_ivr_flow_head:hover { background:var(--line); }
	.phone_app_ivr_flow_item_name { flex:1 1 auto; font-weight:600; }
	.phone_app_ivr_flow_more { transition: transform .15s; }
	.phone_app_ivr_flow_head.on .phone_app_ivr_flow_more { transform: rotate(180deg); }
	.phone_app_ivr_flow_edit { padding:0 10px 10px; display:flex; flex-direction:column; gap:8px; }
	.phone_app_ivr_flow_count { flex:0 0 auto; color:var(--muted,#8e8e8e); font-size:12px; }
	.phone_app_ivr_flow_more { flex:0 0 auto; color:var(--muted,#8e8e8e); }
	.phone_app_ivr_flow_edit { display:flex; flex-direction:column; gap:10px; padding:10px; border-top:1px solid var(--line); }
	.phone_app_ivr_flow_edit label { display:flex; flex-direction:column; gap:4px; font-size:13px; }
	.phone_app_ivr_flow_edit textarea, .phone_app_ivr_flow_edit select, .phone_app_ivr_flow_edit input { width:100%; box-sizing:border-box; font:inherit; padding:7px;
		border:1px solid var(--line); border-radius:8px; background:var(--panel); color:inherit; }
	.phone_app_ivr_flow_edit textarea { resize:vertical; }
	.phone_app_ivr_flow_actions { display:flex; gap:8px; flex-wrap:wrap; }
	.phone_app_ivr_flow_actions button { padding:6px 14px; border-radius:999px; border:1px solid var(--line);
		background:var(--panel); color:inherit; cursor:pointer; font:inherit; }
	.phone_app_ivr_flow_actions button[armed="yes"] { background:#b0342e; color:#fff; border-color:transparent; }
	.phone_app_stranger .phone_app_name { font-variant-numeric:tabular-nums; letter-spacing:1px; }
	.phone_app_stranger .phone_app_avatar { opacity:0.6; }
	.phone_app_unblock { flex:0 0 auto; font-size:12px; padding:3px 10px; border-radius:999px;
		border:1px solid var(--line); background:var(--panel); cursor:pointer; }
	.phone_app_unblock[armed="yes"] { background:#b0342e; color:#fff; border-color:transparent; }
	.phone_app_dial { max-width:300px; margin:0 auto; }
	.phone_app_display { min-height:40px; font-size:27px; text-align:center; letter-spacing:2px; }
	.phone_app_keys { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin-top:10px; }
	.phone_app_key { padding:15px 0; font-size:21px; text-align:center; border:1px solid var(--line);
		border-radius:12px; background:var(--panel); cursor:pointer; user-select:none; }
	.phone_app_key:active { background:var(--line); }
	.phone_app_call { margin-top:14px; text-align:center; }
	.phone_app_row_route { flex:0 0 auto; opacity:0.55; cursor:pointer; }
	.phone_app_row_route:hover { opacity:1; }
	.phone_app_row_route[route] { opacity:0.9; }
	#phone_app { position:relative; }
	.phone_app_sheet { position:absolute; inset:0; background:rgba(0,0,0,0.45); display:flex;
		align-items:center; justify-content:center; z-index:30; padding:14px; box-sizing:border-box; }
	.phone_app_sheet_card { background:var(--panel,#fff); color:inherit; border:1px solid var(--line);
		border-radius:14px; padding:16px; width:100%; max-width:360px; box-shadow:0 10px 40px rgba(0,0,0,0.35); }
	.phone_app_sheet_title { display:flex; align-items:center; justify-content:space-between;
		font-size:16px; margin-bottom:4px; }
	.phone_app_sheet_close { cursor:pointer; font-size:22px; line-height:1; padding:0 4px; opacity:0.7; }
	.phone_app_sheet_who { font-size:14px; margin-bottom:2px; }
	.phone_app_sheet_note { font-size:12px; color:var(--muted,#8e8e8e); min-height:16px; margin-bottom:10px; }
	.phone_app_sheet_choices { display:flex; flex-direction:column; gap:6px; }
	.phone_route_choice { padding:8px 12px; border:1px solid var(--line); border-radius:9px;
		background:var(--panel); color:inherit; cursor:pointer; text-align:left; font:inherit; }
	.phone_route_choice:hover { background:var(--line); }
	.phone_route_choice.on { border-color:var(--accent,#4a90d9); box-shadow:inset 0 0 0 1px var(--accent,#4a90d9); }
	.phone_app_empty { color:var(--muted,#8e8e8e); font-size:13px; text-align:center; padding:18px; }
</style>

<div id="phone_app" class="phone_app" style="padding:14px;">
	<div class="phone_app_tabs">
		<span class="phone_app_tab on" pane="known" hint="Known">Known</span>
		<span class="phone_app_tab" pane="recent" hint="Recent">Recent</span>
		<span class="phone_app_tab" pane="blocked" hint="Blocked">Blocked</span>
		<span class="phone_app_tab" pane="ivr" hint="IVR">IVR</span>
		<span class="phone_app_tab" pane="all" hint="All">All</span>
		<span class="phone_app_tab" pane="dial" hint="Dial">Dial</span>
	</div>
	<div class="phone_app_status" id="phone_app_status">Idle</div>
	<div class="phone_app_callerid_row" style="text-align:center;margin-bottom:10px;">
		<span class="phone_app_callerid_state" style="color:var(--muted,#8e8e8e);font-size:12px;"></span>
		<button class="phone_app_callerid" hint="Caller ID" style="display:none;">Turn on Caller ID</button>
		<button class="phone_app_dialer" hint="Phone app" style="display:none;">Be the phone app</button>
	</div>

	<%# Known: the people the house knows - their numbers, and nothing else %>
	<div class="phone_app_pane on" pane="known">
		<% if (@{$known}) { %>
			<div class="phone_app_list">
			<% foreach my $contact (@{$known}) { %>
				<% my @lines = grep { $_->{'value'} } @{ $contact->{'numbers'} || [] }; %>
				<div class="phone_app_row" number="<%= $contact->{'value'} %>" app="<%= $contact->{'app'} %>">
					<span class="phone_app_avatar"><img src="<%= &subs::icon_for('/images/decipherable/phone.png') %>"></span>
					<span class="phone_app_name"><%= &subs::format_name($contact->{'app'}) %></span>
					<span class="phone_app_sub"><% my $sep = ''; foreach my $l (@lines) { %><%== $sep %><span class="phone_app_line" dial="<%= $l->{'value'} %>"><%= $l->{'display'} || $l->{'value'} %></span><% $sep = ' · '; } %></span>
					<img class="little_thumb phone_app_row_route" hint="Call routing" number="<%= $contact->{'value'} %>" app="<%= $contact->{'app'} %>" route="<%= $contact->{'route'} || '' %>" src="<%= &subs::icon_path('routing', '/images/decipherable/phone.png') %>">
				</div>
			<% } %>
			</div>
		<% } else { %>
			<div class="phone_app_empty">No contacts here yet.</div>
		<% } %>
	</div>

	<%# Recent: the calls themselves, newest first, each able to be blocked %>
	<div class="phone_app_pane" pane="recent">
		<% if (@{$calls}) { %>
			<div class="phone_app_list">
			<% foreach my $call (@{$calls}) { %>
				<% my $name = &subs::format_name($call->{'app'} || 'phone'); %>
				<div class="phone_app_row <% if (($call->{'type'} || '') eq 'cancel') { %>phone_app_missed<% } %>"
					app="<%= $call->{'app'} %>" uuid="<%= $call->{'uuid'} %>" number="<%= defined $call->{'account'} ? $call->{'account'} : '' %>" timestamp="<%= $call->{'timestamp'} %>">
					<span class="phone_app_avatar"><img src="<%= &subs::icon_for('/images/decipherable/phone.png') %>"></span>
					<span class="phone_app_name"><%= $name %></span>
					<span class="phone_app_sub" duration="<%= $call->{'duration'} %>"><%= &subs::formatted_time($call->{'timestamp'}) %></span>
					<% if (defined $call->{'account'} && length $call->{'account'}) { %>
							<img class="little_thumb phone_app_row_route" hint="Call routing" number="<%= $call->{'account'} %>" app="<%= $call->{'app'} %>" route="<%= $call->{'route'} || '' %>" src="<%= &subs::icon_path('routing', '/images/decipherable/phone.png') %>">
					<img class="little_thumb phone_app_row_call" hint="Call" number="<%= $call->{'account'} %>" src="<%= &subs::icon_path('phone', '/images/decipherable/phone.png') %>">
					<% } %>
					<img class="little_thumb phone_app_block" hint="Block" src="<%= &subs::icon_path('ne pas', '/images/decipherable/padlock.png') %>">
				</div>
			<% } %>
			</div>
		<% } else { %>
			<div class="phone_app_empty">No calls yet.</div>
		<% } %>
	</div>

	<%# Blocked: the desk's list, as calls. A number here never rings %>
	<div class="phone_app_pane" pane="blocked">
		<% if (@{$blocked}) { %>
			<div class="phone_app_list">
			<% foreach my $b (@{$blocked}) { %>
				<div class="phone_app_row">
					<span class="phone_app_avatar"><img src="<%= &subs::icon_path('ne pas', '/images/decipherable/padlock.png') %>"></span>
					<span class="phone_app_name"><%= $b->{'name'} ? &subs::format_name($b->{'name'}) . ' · ' : '' %><%= $b->{'number'} %></span>
					<span class="phone_app_sub"><%= $b->{'note'} %></span>
					<button class="phone_app_unblock" hint="Unblock" number="<%= $b->{'number'} %>" stamp="<%= $b->{'stamp'} %>">Unblock</button>
				</div>
			<% } %>
			</div>
		<% } else { %>
			<div class="phone_app_empty">Nothing is blocked.</div>
		<% } %>
	</div>

	<%# IVR: the reception settings. The machine list is the house's remote_machines,
	    online first; the chosen one runs the audio gateway. The prompts are the
	    words the gateway speaks, and the voice is the Piper voice it renders. %>
	<div class="phone_app_pane" pane="ivr">
		<div class="phone_app_ivr">
			<label class="phone_app_ivr_toggle"><input type="checkbox" id="phone_ivr_enabled" <%= (($ivr->{'enabled'} || '') eq 'yes') ? 'checked' : '' %>> <%= &subs::ui('Enable IVR') %></label>
			<label><%= &subs::ui('Gateway Bluetooth name') %>
				<input type="text" id="phone_ivr_bluetooth" value="<%= $ivr->{'bluetooth'} || '' %>" placeholder="jawn-gateway">
			</label>
			<label><%= &subs::ui('Remote machine') %>
				<select id="phone_ivr_machine">
					<option value=""><%= &subs::ui('— No gateway —') %></option>
					<% foreach my $m (@{$ivr_machines || []}) { %>
						<option value="<%= $m->{'key'} %>" <%= (($ivr->{'machine'} || '') eq $m->{'key'}) ? 'selected' : '' %>><%= $m->{'hostname'} %> — <%= $m->{'available'} ? &subs::ui('online') : &subs::ui('offline') %></option>
					<% } %>
				</select>
			</label>
			<div class="phone_app_ivr_status">
				<% if ($ivr->{'machine'}) { %>
					<%= &subs::ui('Gateway:') %> <%= $ivr->{'machine_label'} || $ivr->{'machine'} %> — <%= $ivr->{'machine_available'} ? &subs::ui('online') : &subs::ui('offline') %>
				<% } else { %>
					<%= &subs::ui('No IVR gateway selected.') %>
				<% } %>
			</div>
			<div class="phone_app_ivr_flow_row">
				<span class="phone_app_ivr_flow_label" id="phone_ivr_gateway_state"><%= &subs::ui('Gateway idle') %></span>
				<button class="phone_app_ivr_save" id="phone_ivr_arm" hint="Arm the gateway"><%= &subs::ui('Arm the gateway') %></button>
			</div>
			<%# The caller's words while the call is up. The gateway pushes each line on
			    the phone's websocket and /manager/sco/status carries the ones already
			    said, so a pane opened mid-call catches up. %>
			<div class="phone_transcript" id="phone_transcript" hidden>
				<div class="phone_transcript_head">
					<span class="phone_transcript_title" id="phone_transcript_title"><%= &subs::ui('Live transcript') %></span>
					<span class="phone_transcript_note" id="phone_transcript_note"></span>
					<button class="phone_transcript_connect" id="phone_transcript_connect" hint="Connect me"><%= &subs::ui('Connect me') %></button>
				</div>
				<div class="phone_transcript_lines" id="phone_transcript_lines"></div>
			</div>
			<%# The named flows. Each is one voice and one set of words the gateway
			    speaks, its own hold music, and what happens after the thanks. The list,
			    its editors and the bucket choices are drawn from the JSON here, so
			    adding a flow and opening one are the same code. %>
			<% my $flow_fallback = &subs::phone_ivr_flow_defaults($ivr->{'route'} || 'unknown'); %>
			<% my %flow_fallback_choice = map { $_ => ($flow_fallback->{$_} eq 'ivr' ? 'receptionist' : $flow_fallback->{$_}) } keys %{$flow_fallback}; %>
			<div class="phone_app_ivr_flows_editor" id="phone_ivr_flows_editor"
				data-flow-defs="<%= encode_json($ivr->{'flow_defs'} || {}) %>"
				data-flow-voices="<%= encode_json([ map { { value => $_->{'value'}, label => &subs::ui($_->{'label'}) } } @{ $ivr_voices || [] } ]) %>"
				data-flow-defaults="<%= encode_json(\%flow_fallback_choice) %>">
				<div class="phone_app_ivr_flows_title"><%= &subs::ui('Flows') %></div>
				<div class="phone_app_ivr_flow_list" id="phone_ivr_flow_list"></div>
				<button type="button" class="phone_app_ivr_save" id="phone_ivr_flow_add" hint="Add flow"><%= &subs::ui('Add flow') %></button>
			</div>
			<%# What each kind of caller hears. Ring through and Reject are not flows
			    at all; the rest of the choices are the flows above. %>
			<label><%= &subs::ui('Call routing') %>
				<div class="phone_app_ivr_flows">
					<% my @flow_buckets = (
						[ unknown => &subs::ui('Unknown') ], [ blacklisted => &subs::ui('Blacklisted') ],
						[ self => &subs::ui('Self') ], [ friend => &subs::ui('Friend') ],
						[ stranger => &subs::ui('Stranger') ], [ enemy => &subs::ui('Enemy') ]
					); %>
					<% foreach my $fb (@flow_buckets) { my ($bucket, $label) = @{$fb}; my $action = $ivr->{'flows'}->{$bucket} || 'ring'; $action = 'receptionist' if $action eq 'ivr'; %>
						<span class="phone_app_ivr_flow_row">
							<span class="phone_app_ivr_flow_label"><%= $label %></span>
							<select class="phone_app_ivr_flow" bucket="<%= $bucket %>" id="phone_ivr_flow_<%= $bucket %>">
								<option value="ring" <%= ($action eq 'ring') ? 'selected' : '' %>><%= &subs::ui('Ring') %></option>
								<option value="reject" <%= ($action eq 'reject') ? 'selected' : '' %>><%= &subs::ui('Reject') %></option>
								<% foreach my $flow_key (sort keys %{ $ivr->{'flow_defs'} || {} }) { my $flow = $ivr->{'flow_defs'}->{$flow_key}; %>
									<option value="<%= $flow_key %>" <%= ($action eq $flow_key) ? 'selected' : '' %>><%= $flow->{'builtin'} ? &subs::ui($flow->{'name'}) : $flow->{'name'} %></option>
								<% } %>
							</select>
						</span>
					<% } %>
				</div>
			</label>
			<button class="phone_app_ivr_save" id="phone_ivr_save" hint="Save"><%= &subs::ui('Save') %></button>
			<div class="phone_app_ivr_status" id="phone_ivr_status"></div>
		</div>
	</div>

	<%# All: every number the house holds - the people, and the numbers a caller
	    left behind that no name has claimed yet %>
	<div class="phone_app_pane" pane="all">
		<div class="phone_app_list">
		<% foreach my $contact (@{$known}) { %>
			<% my @lines = grep { $_->{'value'} } @{ $contact->{'numbers'} || [] }; %>
			<div class="phone_app_row" number="<%= $contact->{'value'} %>" app="<%= $contact->{'app'} %>">
				<span class="phone_app_avatar"><img src="<%= &subs::icon_for('/images/decipherable/phone.png') %>"></span>
				<span class="phone_app_name"><%= &subs::format_name($contact->{'app'}) %></span>
				<span class="phone_app_sub"><% my $sep = ''; foreach my $l (@lines) { %><%== $sep %><span class="phone_app_line" dial="<%= $l->{'value'} %>"><%= $l->{'display'} || $l->{'value'} %></span><% $sep = ' · '; } %></span>
			</div>
		<% } %>
		<% foreach my $stranger (@{$numbers}) { %>
			<div class="phone_app_row phone_app_stranger" number="<%= $stranger->{'value'} %>" app="<%= $stranger->{'app'} %>">
				<span class="phone_app_avatar"><img src="<%= &subs::icon_for('/images/decipherable/question mark.png') %>"></span>
				<span class="phone_app_name"><%= $stranger->{'value'} %></span>
				<span class="phone_app_sub">unnamed<%= $stranger->{'blocked'} ? ' · blocked' : '' %></span>
			</div>
		<% } %>
		<% if (!scalar @{$known} && !scalar @{$numbers}) { %>
			<div class="phone_app_empty">No numbers here yet.</div>
		<% } %>
		</div>
	</div>

	<div class="phone_app_pane" pane="dial">
		<div class="phone_app_dial">
			<div class="phone_app_display" id="phone_app_display"></div>
			<div class="phone_app_keys">
				<% foreach my $k ( (1 .. 9), '*', 0, '#' ) { %>
					<div class="phone_app_key" key="<%= $k %>"><%= $k %></div>
				<% } %>
			</div>
			<div class="phone_app_call">
				<img class="medium_thumb phone_app_dial_btn" hint="Call" src="<%= &subs::icon_path('phone', '/images/decipherable/phone.png') %>">
			</div>
		</div>
	</div>

	<%# Call routing: one number's own flow, opened from a person or a number %>
	<div class="phone_app_sheet" id="phone_route_sheet" style="display:none;">
		<div class="phone_app_sheet_card">
			<div class="phone_app_sheet_title"><span hint="Call routing">Call routing</span><span class="phone_app_sheet_close" id="phone_route_close">×</span></div>
			<div class="phone_app_sheet_who" id="phone_route_who"></div>
			<div class="phone_app_sheet_note" id="phone_route_note"></div>
			<div class="phone_app_sheet_choices">
				<button class="phone_route_choice" route="default" hint="Follow the person">Follow the person</button>
				<button class="phone_route_choice" route="ring" hint="Ring through">Ring through</button>
				<button class="phone_route_choice" route="ivr" hint="Receptionist">Receptionist</button>
				<button class="phone_route_choice" route="voicemail" hint="Voicemail">Voicemail</button>
				<button class="phone_route_choice" route="reject" hint="Reject">Reject</button>
			</div>
			<div class="phone_app_status" id="phone_route_status" style="margin-top:8px;"></div>
		</div>
	</div>
</div>
