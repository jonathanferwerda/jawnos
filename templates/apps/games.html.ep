<% use Mojo::JSON qw(encode_json); %>
<%# A second launcher, one press in from the Controller's Games tile. Cards and
    Twirl run inside the house. ?view=emulated is the emulated shelf: the ROMs
    found under ~/roms, a card each, with the two install buttons above them,
    a filter by system, the emulator each system runs on, a cover fetch and a
    way to the controls page. %>
<%
	my $mode = (defined $view && $view eq 'emulated') ? 'emulated' : 'launcher';
	my $games = (ref $library eq 'HASH' && ref $library->{'games'} eq 'ARRAY') ? $library->{'games'} : [];
	my $count = scalar @{ $games };
	# The shelf's own data may come from a scan that is older than this page, so
	# every field is read defensively: a missing system list draws no filter, and
	# a system with no runners draws no picker rather than a dead control.
	my $systems = (ref $library eq 'HASH' && ref $library->{'systems'} eq 'ARRAY') ? $library->{'systems'} : [];
	my @filter_systems = grep {
		ref $_ eq 'HASH' && defined $_->{'id'} && length $_->{'id'}
			&& (!defined $_->{'count'} || $_->{'count'} > 0)
	} @{ $systems };
	my @picker_systems = grep {
		ref $_ eq 'HASH' && defined $_->{'id'} && length $_->{'id'}
			&& ref $_->{'runners'} eq 'ARRAY'
			&& grep { ref $_ eq 'HASH' && defined $_->{'id'} && length $_->{'id'} } @{ $_->{'runners'} }
	} @{ $systems };
%>
<style>
	/* A launcher page of its own, like the controller's: the desk only ever
	   opens the tiles, so this window has the glass to itself. */
	html, body, .wind, .window_contents { background:#2e2e2e !important; color:#f4f4f4 !important; }
	.wind[app="games"] .top_navbar { display:none !important; }
	.wind { left:0 !important; top:0 !important; width:100vw !important; height:100vh !important; }
	.window_contents { width:100% !important; height:100% !important; padding-top:0 !important; }
	#games_shell { display:flex; flex-direction:column; width:100%; height:100%; min-height:0; }
	#games_bar { flex:0 0 auto; display:flex; align-items:center; flex-wrap:wrap; gap:6px; padding:6px 8px 0; }
	#games_home, .games_action { font:inherit; font-size:13px; line-height:1.2; padding:5px 12px;
		border:1px solid #4a4a4a; border-radius:8px; background:#3a3a3a; color:#ffffff;
		text-decoration:none; cursor:var(--jawnos-cursor-pointer, pointer); }
	#games_home:hover, .games_action:hover { border-color:var(--accent, #4a90d9); }
	.games_action:disabled { opacity:.5; cursor:var(--jawnos-cursor-default, default); }
	#games_bar_spacer { flex:1 1 auto; }
	#games_install_note { flex:1 1 100%; font-size:11px; line-height:1.3; min-height:1em; opacity:.85; }
	#games_covers_note { font-size:11px; line-height:1.3; opacity:.85; }
	/* The filter rides above the shelf and scrolls sideways: a system set is
	   wider than a handheld, and wrapping it would eat the shelf's height. */
	#games_shelf { flex:0 0 auto; display:flex; flex-direction:column; gap:2px; padding:6px 8px 0; }
	#games_shelf_row { display:flex; align-items:center; gap:8px; min-width:0; }
	#games_filters { display:flex; overflow-x:auto; white-space:nowrap; gap:6px; flex-wrap:nowrap;
		flex:1 1 auto; min-width:0; padding-bottom:2px; }
	.games_filter { flex:0 0 auto; font:inherit; font-size:12px; line-height:1.2; white-space:nowrap;
		padding:4px 10px; border:1px solid #4a4a4a; border-radius:999px; background:#3a3a3a;
		color:#ffffff; cursor:var(--jawnos-cursor-pointer, pointer); }
	.games_filter:hover { border-color:var(--accent, #4a90d9); }
	.games_filter.is_active { background:var(--accent, #4a90d9); border-color:var(--accent, #4a90d9); }
	.games_filter_count { margin-left:6px; font-size:11px; opacity:.8; }
	/* One row per system, each with the emulator it runs on. The list is folded
	   away by default: there can be more systems than a shelf has room for. */
	#games_emulators { padding:0 2px; font-size:11px; }
	#games_emulators summary { cursor:var(--jawnos-cursor-pointer, pointer); opacity:.85; padding:2px 0; }
	.games_system_row { display:flex; align-items:center; gap:8px; padding:2px 0; }
	.games_system_name { flex:0 0 40%; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
	.games_system_row select { flex:0 1 auto; min-width:0; font:inherit; font-size:11px; padding:2px 4px;
		border:1px solid #4a4a4a; border-radius:6px; background:#3a3a3a; color:#ffffff;
		cursor:var(--jawnos-cursor-pointer, pointer); }
	.games_emulator_note { flex:1 1 auto; min-width:0; opacity:.8; }
	#games_grid { flex:1 1 auto; min-height:0; display:grid; grid-template-columns:repeat(3,1fr);
		gap:10px; padding:8px; box-sizing:border-box; }
	.games_tile { display:flex; flex-direction:column; align-items:center; justify-content:center;
		gap:8px; min-width:0; padding:12px; border:1px solid #4a4a4a; border-radius:14px;
		background:#3a3a3a; color:#ffffff; text-decoration:none; text-align:center; }
	.games_tile:hover { border-color:var(--accent, #4a90d9); }
	.games_tile_icon { width:56px; height:56px; object-fit:contain; }
	.games_tile_label { font-size:16px; font-weight:600; line-height:1.1; }
	.games_tile_note { font-size:11px; line-height:1.3; opacity:.8; }
	/* The shelf: a scrollable grid of ROM cards, the cover over the title. */
	#games_library { flex:1 1 auto; min-height:0; overflow-y:auto; padding:8px;
		display:grid; grid-template-columns:repeat(auto-fill, minmax(104px, 1fr));
		gap:8px; align-content:start; box-sizing:border-box; }
	.game_card { display:flex; flex-direction:column; gap:4px; min-width:0; padding:6px;
		border:1px solid #4a4a4a; border-radius:10px; background:#3a3a3a; color:#ffffff;
		font:inherit; text-align:left; cursor:var(--jawnos-cursor-pointer, pointer); }
	.game_card:hover { border-color:var(--accent, #4a90d9); }
	.game_card[hidden] { display:none; }
	.game_art { display:flex; align-items:center; justify-content:center; width:100%;
		aspect-ratio:3 / 4; overflow:hidden; border-radius:6px; background:#2a2a2a; }
	.game_art img { width:100%; height:100%; object-fit:cover; }
	.game_art_blank { font-size:10px; line-height:1.2; text-align:center; opacity:.7; padding:4px; }
	.game_title { font-size:11px; font-weight:600; line-height:1.2; overflow:hidden; text-overflow:ellipsis; }
	.game_system { font-size:10px; opacity:.7; line-height:1.1; }
	.games_empty { grid-column:1 / -1; font-size:12px; line-height:1.4; opacity:.8; padding:8px; }
</style>
<div id="games_shell">
% if ($mode eq 'launcher') {
	<div id="games_bar"><a id="games_home" href="/manager/controller"><%= &subs::ui('Home') %></a></div>
	<div id="games_grid">
		<a class="games_tile" href="/manager?open=cards&amp;full=1">
			<img class="games_tile_icon" src="/images/decipherable/cards.png" alt="">
			<span class="games_tile_label"><%= &subs::ui('Cards') %></span>
			<span class="games_tile_note"><%= &subs::ui('The card room, solitaire and blackjack') %></span>
		</a>
		<a class="games_tile" href="/manager?open=twirl&amp;full=1">
			<img class="games_tile_icon" src="/images/decipherable/tetris.png" alt="">
			<span class="games_tile_label"><%= &subs::ui('Twirl') %></span>
			<span class="games_tile_note"><%= &subs::ui('The falling-block puzzle: A turns one way and B the other') %></span>
		</a>
		<a class="games_tile" href="/manager/games?view=emulated">
			<img class="games_tile_icon" src="/images/decipherable/diskette.png" alt="">
			<span class="games_tile_label"><%= &subs::ui('Emulated games') %></span>
			<span class="games_tile_note"><%= $count ? ($count . ' ' . &subs::ui('games ready')) : &subs::ui('None installed yet') %></span>
		</a>
	</div>
% } else {
	<div id="games_bar">
		<a id="games_home" href="/manager/games"><%= &subs::ui('Back') %></a>
		<span id="games_bar_spacer"></span>
		<button type="button" class="games_action" id="games_install_emulators"><%= &subs::ui('Install emulators') %></button>
		<button type="button" class="games_action" id="games_install_roms"><%= &subs::ui('Install ROMs') %></button>
		<button type="button" class="games_action" id="games_covers"><%= &subs::ui('Fetch covers') %></button>
		<span id="games_covers_note" aria-live="polite"></span>
		<span id="games_install_note" aria-live="polite"></span>
	</div>
	<div id="games_shelf">
		<div id="games_shelf_row">
			<div id="games_filters" role="group" aria-label="<%= &subs::ui('Filter by system') %>">
				<button type="button" class="games_filter is_active" data-filter="all" aria-pressed="true"><%= &subs::ui('All') %></button>
% for my $sys (@filter_systems) {
				<button type="button" class="games_filter" data-filter="<%= $sys->{'id'} %>" data-system="<%= $sys->{'id'} %>" aria-pressed="false"><%= (defined $sys->{'label'} && length $sys->{'label'}) ? $sys->{'label'} : $sys->{'id'} %><% if (defined $sys->{'count'}) { %><span class="games_filter_count"><%= $sys->{'count'} %></span><% } %></button>
% }
			</div>
			<a id="games_controls" class="games_action" href="/manager/games/mapping"><%= &subs::ui('Controls') %></a>
		</div>
% if (@picker_systems) {
		<details id="games_emulators">
			<summary><%= &subs::ui('Systems') %></summary>
% for my $sys (@picker_systems) {
			<div class="games_system_row">
				<span class="games_system_name"><%= (defined $sys->{'label'} && length $sys->{'label'}) ? $sys->{'label'} : $sys->{'id'} %></span>
				<select data-system-emulator="<%= $sys->{'id'} %>" aria-label="<%= &subs::ui('Emulator for this system') %>">
% for my $runner (grep { ref $_ eq 'HASH' && defined $_->{'id'} && length $_->{'id'} } @{ $sys->{'runners'} }) {
					<option value="<%= $runner->{'id'} %>"<% if (defined $sys->{'chosen'} && $sys->{'chosen'} eq $runner->{'id'}) { %> selected<% } %><% if (defined $runner->{'available'} && !$runner->{'available'}) { %> disabled<% } %>><%= (defined $runner->{'label'} && length $runner->{'label'}) ? $runner->{'label'} : $runner->{'id'} %></option>
% }
				</select>
				<span class="games_emulator_note" aria-live="polite"></span>
			</div>
% }
		</details>
% }
	</div>
	<div id="games_library">
% if (!@{$games}) {
		<p class="games_empty"><%= $emulators ? &subs::ui('No games yet. Copy ROMs in from a USB stick or the emmc.') : &subs::ui('No games yet. Install the emulators, then copy ROMs in from a USB stick or the emmc.') %></p>
% }
% for my $game (@{$games}) {
		<button type="button" class="game_card" data-game="<%= $game->{'id'} %>" data-system="<%= defined $game->{'system'} ? $game->{'system'} : '' %>">
			<span class="game_art">
% if ($game->{'art'}) {
				<img src="/manager/games/art?id=<%= $game->{'id'} %>" alt="" loading="lazy">
% } else {
				<span class="game_art_blank"><%= $game->{'system_label'} %></span>
% }
			</span>
			<span class="game_title"><%= $game->{'title'} %></span>
			<span class="game_system"><%= $game->{'system_label'} %></span>
		</button>
% }
	</div>
% }
</div>
% if ($mode eq 'emulated') {
<script>
/* The install buttons start one helper and read its one status row; a card asks
   the launch route to run the game. The launch stops the kiosk, so that request
   is the last thing this page does. The filter owns which cards are shown, the
   Systems list saves the emulator each system runs on, and Fetch covers starts
   the cover lookup and reads its progress. */
(function () {
	var note = document.getElementById('games_install_note');
	var emulators = document.getElementById('games_install_emulators');
	var roms = document.getElementById('games_install_roms');
	var covers = document.getElementById('games_covers');
	var coversNote = document.getElementById('games_covers_note');
	var controls = document.getElementById('games_controls');
	var filters = document.querySelectorAll('.games_filter');
	var cards = document.querySelectorAll('.game_card');
	var failed = <%== encode_json(&subs::ui('That did not work.')) %>;
	var saved = <%== encode_json(&subs::ui('Saved')) %>;
	var saving = <%== encode_json(&subs::ui('Saving')) %>;
	var fetchingCovers = <%== encode_json(&subs::ui('Fetching covers')) %>;
	var busy = false;
	var reloaded = false;

	function say(text) { if (note) { note.textContent = text || ''; } }
	function coversSay(text) { if (coversNote) { coversNote.textContent = text || ''; } }
	function post(url, body) {
		return fetch(url, {
			method: 'POST', credentials: 'same-origin',
			headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
			body: new URLSearchParams(body)
		}).then(function (answer) { return answer.json(); });
	}
	function buttons(on) {
		if (emulators) { emulators.disabled = !on; }
		if (roms) { roms.disabled = !on; }
	}
	/* One filter at a time: All clears the choice, a system shows only its
	   cards, and Controls follows the choice into its query. */
	function applyFilter(system) {
		var i;
		for (i = 0; i < cards.length; i++) {
			var own = cards[i].getAttribute('data-system') || '';
			cards[i].hidden = !!system && own !== system;
		}
		for (i = 0; i < filters.length; i++) {
			var on = (filters[i].getAttribute('data-filter') || 'all') === (system || 'all');
			filters[i].classList.toggle('is_active', on);
			filters[i].setAttribute('aria-pressed', on ? 'true' : 'false');
		}
		if (controls) {
			controls.href = '/manager/games/mapping' + (system ? '?system=' + encodeURIComponent(system) : '');
		}
	}
	for (var f = 0; f < filters.length; f++) {
		filters[f].addEventListener('click', function () {
			var chosen = this.getAttribute('data-filter') || 'all';
			applyFilter(chosen === 'all' ? '' : chosen);
		});
	}
	applyFilter('');
	/* The picker is drawn only for a system that has a runner to choose; the
	   choice is saved against that one system, and its note reports the answer. */
	var pickers = document.querySelectorAll('select[data-system-emulator]');
	for (var p = 0; p < pickers.length; p++) {
		pickers[p].addEventListener('change', function () {
			var picker = this;
			var system = picker.getAttribute('data-system-emulator');
			var row = picker.closest('.games_system_row');
			var rowNote = row ? row.querySelector('.games_emulator_note') : null;
			if (rowNote) { rowNote.textContent = saving + '…'; }
			post('/manager/games/emulator', { system: system, runner: picker.value }).then(function (answer) {
				if (!answer || !answer.ok) {
					if (rowNote) { rowNote.textContent = (answer && answer.error) || failed; }
					return;
				}
				if (rowNote) { rowNote.textContent = saved; }
			}).catch(function () {
				if (rowNote) { rowNote.textContent = failed; }
			});
		});
	}
	for (var c = 0; c < cards.length; c++) {
		cards[c].addEventListener('click', function () {
			var id = this.getAttribute('data-game');
			say(<%== encode_json(&subs::ui('Starting')) %> + '…');
			post('/manager/games/launch', { id: id }).then(function (answer) {
				if (!answer || !answer.ok) { say((answer && answer.error) || failed); }
			}).catch(function () { say(failed); });
		});
	}
	/* Fetch covers is one helper and one status row: every two seconds while it
	   runs, showing how many of the total are done, then a reload so the cards
	   pick up the new pictures. */
	function coversPoll() {
		fetch('/manager/games/covers/status', { credentials: 'same-origin' })
			.then(function (answer) { return answer.json(); })
			.then(function (status) {
				status = status || {};
				if (status.state === 'running') {
					if (covers) { covers.disabled = true; }
					coversSay(fetchingCovers + ' ' + (status.done || 0) + '/' + (status.total || 0));
					setTimeout(coversPoll, 2000);
					return;
				}
				if (covers) { covers.disabled = false; }
				if (status.state === 'done') {
					coversSay((status.done || 0) + '/' + (status.total || 0));
					setTimeout(function () { location.reload(); }, 900);
				}
				else if (status.state === 'failed') { coversSay(status.error || failed); }
			})
			.catch(function () {
				if (covers) { covers.disabled = false; }
				coversSay(failed);
			});
	}
	function startCovers() {
		if (covers) { covers.disabled = true; }
		coversSay(fetchingCovers + '…');
		post('/manager/games/covers', {}).then(function (answer) {
			if (!answer || !answer.ok) {
				coversSay((answer && answer.error) || failed);
				if (covers) { covers.disabled = false; }
				return;
			}
			coversPoll();
		}).catch(function () {
			coversSay(failed);
			if (covers) { covers.disabled = false; }
		});
	}
	if (covers) { covers.addEventListener('click', startCovers); }
	function poll() {
		fetch('/manager/games/install_status', { credentials: 'same-origin' })
			.then(function (answer) { return answer.json(); })
			.then(function (status) {
				status = status || {};
				if (status.state === 'running') {
					busy = true;
					buttons(false);
					say((status.what === 'roms' ? <%== encode_json(&subs::ui('Copying ROMs')) %>
						: <%== encode_json(&subs::ui('Installing emulators')) %>)
						+ (status.package ? ' — ' + status.package : '…'));
					return;
				}
				busy = false;
				buttons(true);
				if (status.state === 'done') {
					say(status.note || '');
					if (status.what === 'roms' && !reloaded) { reloaded = true; setTimeout(function () { location.reload(); }, 900); }
				}
				else if (status.state === 'failed') { say(status.error || status.note || failed); }
			})
			.catch(function () { });
	}
	function start(what) {
		buttons(false);
		say('');
		post('/manager/games/install', { what: what }).then(function (answer) {
			if (!answer || !answer.ok) { say((answer && answer.error) || failed); buttons(true); return; }
			busy = true;
			setTimeout(poll, 800);
		}).catch(function () { say(failed); buttons(true); });
	}
	if (emulators) { emulators.addEventListener('click', function () { start('emulators'); }); }
	if (roms) { roms.addEventListener('click', function () { start('roms'); }); }
	poll();
	setInterval(poll, 2500);
})();
</script>
% }
