<% my $string = &subs::random_string_creator(25); %>

<span class="statistic_info" id="<%= $string %>" style="position:fixed;left:<%= $x - 200 %>px;top:<%= $y + 20 %>px;width:400px;max-height:700px;border:solid;background-color:var(--panel);border-radius:5px;">
	<img class="close_statistic_info little_thumb hover" style="float:right;" app="<%= $app %>" scope="<%= $scope %>" timestamp="<%= $timestamp %>" src="<%= &subs::icon_for('/images/make believe/cancel_button.png') %>" hint="Close">	
	<img class="statistic_appointments little_thumb"  timestamp="<%= $timestamp %>" scope="<%= $scope %>" src="<%= &subs::icon_for('/images/decipherable/home.png') %>" hint="Home" class="medium_thumb">

	<span class="time" mode="fixed" timestamp="<%= $start_timestamp %>"></span><br>
	<span class="time" mode="fixed" timestamp="<%= $end_timestamp %>"></span><br>
	<%= &subs::format_name($scope) %>

	<canvas id="<%= $string %>_canvas" style="display:block;width:100%;height:200px;"></canvas>
	<%# the message here used to be a placeholder h1; the panel now reads the
	    period back - its value, pace, trend and what made it up - filled in by the
	    summary route once the model has answered %>
	<div class="statistic_summary" style="border-top:solid;padding-top:5px;margin-top:5px;font-size:95%;line-height:1.4;opacity:.9;">Reading this period…</div>
</span>
