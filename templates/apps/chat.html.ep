<%# The Chat app's panel: the house's conversations - sms, the dial, the list,
    ticket threads and LoRa - as an app of its own. Same wrapper id and inner ids
    (#mail, #mail_sidebar, #mailbox, #message, #send_it) so public/js/mailbox.js
    keeps working untouched; the sidebar lists only the five sections chat owns,
    and their panels are the shared partial. The conversation half is the shared
    partial, the same one Mailbox and Email include. %>
<% no warnings 'uninitialized'; %>
<% my $active = $settings->{'subsection'} || 'sms'; %>
<% my $chat_sidebar = defined $incoming_data->{'sidebar'} ? $incoming_data->{'sidebar'} : 1; %>
<% my $avatar = substr($main_title || 'Chat', 0, 1); %>
<% my %chat_section_label = (
	sms => &subs::lang('chat.phone_numbers'),
	dial => &subs::lang('chat.dial'),
	list => &subs::lang('chat.list'),
	tickets => &subs::lang('chat.tickets'),
	lora => &subs::lang('chat.lora'),
); %>
<% my $chat_panel_label = $chat_section_label{$active} || &subs::format_name($active); %>
<div id="mail" class="chat_shell">
	<div class="chat_head">
		<button type="button" id="mail_hamburger" class="chat_icon_button" hint="Show or hide the chat lists" aria-label="<%= &subs::ui('Show or hide the chat lists') %>" aria-controls="mail_sidebar" aria-expanded="true">&#9776;</button>
		<%# back to the appointment this window came from: the in-window chat hides
		    the regular window contents, and this puts them back (chat.js shows it
		    only on a window that swapped in from an appointment) %>
		<button type="button" class="chat_icon_button chat_back_to_appointment" hint="Back to the appointment" aria-label="<%= &subs::ui('Back to the appointment') %>" style="display:none;">&#8592;</button>
		<div class="chat_identity">
			<div class="chat_avatar"><%= $avatar %></div>
			<div class="chat_identity_text">
				<div class="chat_title"><%= $main_title || &subs::ui('Chat') %></div>
				<div class="chat_subtitle"><span id="chat_method_label" data-label="<%= $chat_panel_label %>"><%= $chat_panel_label %></span><% if (($settings->{'lora_toggle'} // '') eq 'on') { %> &middot; LoRa mesh<% } %></div>
			</div>
		</div>
		<div class="chat_head_actions">
			<span class="chat_connection" id="chat_connection" title="<%= &subs::ui('Connected') %>">&#9679;</span>
		</div>
	</div>
	<div class="chat_body">
		<% my $privilege = $c->session('privilege'); %>
		<% if ($privilege eq 'citizen' || $privilege eq 'resident' || $privilege eq 'guest') { %>
			<div id="mail_sidebar" class="chat_rail theme_surface"<% if ($chat_sidebar != 1) { %> style="display:none;"<% } %>>
				<div class="chat_rail_head">
					<span><%= &subs::ui('Chats') %></span>
					<span class="chat_rail_count"><%= scalar @{$friends || []} %></span>
				</div>
				<div class="chat_rail_group">
					<button type="button" class="chat_rail_subhead" data-chat_group="people" aria-expanded="true">
						<span class="chat_rail_subhead_label"><%= &subs::lang('people') %></span>
						<span class="chat_rail_subhead_meta"><span class="chat_rail_chevron" aria-hidden="true">&#9662;</span></span>
					</button>
					<div class="chat_rail_list" data-chat_group_body="people" data-chat-scroll="people">
						<% if (@{$friends || []}) { %>
							<div id="chat_friends">
								<% foreach my $f ( sort { $a->{'contact_name'} cmp $b->{'contact_name'} } @{$friends} ) { %>
									<% my $fname = &subs::format_name($f->{'contact_name'}); %>
									<div class="chat_friend hover <% if ($mail_contact eq $f->{'uuid'}) { %>active <% } %>" uuid="<%= $f->{'uuid'} %>" name="<%= &subs::unformat_name($f->{'contact_name'}) %>" phone="<%= $f->{'phone'} %>">
										<% my $fcrest = ($privilege eq 'citizen') ? &subs::crest_contact_entry($f->{'app'}) : undef; %>
										<% my $fsrc = ''; if ($fcrest) { $fsrc = $fcrest->{'image_data'} || (&subs::crest_peer_image_file($fcrest) ? '/manager/people/crest_image?peer=' . $fcrest->{'crest'}->{'uuid'} . '&stamp=' . &subs::rightNow() : ''); } %>
										<span class="chat_friend_avatar"><% if ($fsrc ne '') { %><img src="<%= $fsrc %>" alt=""><% } else { %><%= substr($fname, 0, 1) %><% } %></span>
										<span class="chat_friend_text">
											<span class="chat_friend_name"><%= $fname %></span>
											<span class="chat_friend_meta"><% if ($f->{'phone'}) { %>sms<% } else { %>chat<% } %><% my @extra = grep { !$_->{'primary'} && $_->{'value'} } @{ $f->{'numbers'} || [] }; %><% if (scalar @extra) { %> &middot; <%= join(' &middot; ', map { &subs::contact_line_label($_) } @extra) %><% } %></span>
										</span>
									</div>
								<% } %>
							</div>
						<% } else { %>
							<div class="chat_rail_empty"><%= &subs::ui('No people yet.') %></div>
						<% } %>
					</div>
				</div>
				<div class="chat_rail_group">
					<button type="button" class="chat_rail_subhead" data-chat_group="sections" aria-expanded="true">
						<span class="chat_rail_subhead_label"><%= &subs::lang('chat.sections') %></span>
						<span class="chat_rail_subhead_meta"><span class="chat_rail_chevron" aria-hidden="true">&#9662;</span></span>
					</button>
					<div class="chat_rail_list" data-chat_group_body="sections" data-chat-scroll="sections">
						<% if ($privilege eq 'citizen') { %>
							<div class="chat_nav">
								<% foreach my $ss ( qw/sms dial list tickets lora/ ) { %>
									<button type="button" class="mail_subsection <% if ( $ss eq $settings->{'subsection'} ) { %>active <% } %>" section="<%= $ss %>"><%= &subs::lang('chat.' . $ss) %></button>
								<% } %>
								<img src="<%= &subs::icon_for('/images/make believe/telephone line.png') %>" hint="LoRa mesh broadcast" class="little_thumb hover" id="mailbox_lora_toggle" toggle="<%= $settings->{'lora_toggle'} %>" style="vertical-align:bottom;">
							</div>
						<% } else { %>
							<button type="button" class="mail_subsection active" section="dial" disabled><%= &subs::lang('chat.dial') %></button>
						<% } %>
					</div>
				</div>
				<div class="chat_rail_group">
					<button type="button" class="chat_rail_subhead" data-chat_group="panel" aria-expanded="true">
						<span class="chat_rail_subhead_label"><%= $chat_panel_label %></span>
						<span class="chat_rail_subhead_meta"><span class="chat_rail_chevron" aria-hidden="true">&#9662;</span></span>
					</button>
					<div class="chat_rail_list" data-chat_group_body="panel" data-chat-scroll="panel">
						<%= include 'mail/chat_sections', chat_rail => 1, settings => $settings, mail_phone => $mail_phone, mail_contact => $mail_contact, contacts => $contacts, sc => $sc, list => $list, public_channels => $public_channels, channel_key => $channel_key, channel_public => $channel_public, privilege => $privilege, lorawan => $lorawan %>
					</div>
				</div>
			</div>
		<% } %>
		<%= include 'mail/conversation', mail => $mail, incoming_data => $incoming_data, chat_ui => 1, sms_lines => $sms_lines %>
	</div>
</div>
<script>
	last_mail_message = Date.now();
	if (typeof chatRailApply === 'function') { chatRailApply(); }
	if (typeof chatTransportOptions === 'function') { chatTransportOptions(); }
	if (typeof chatScrollBottom === 'function') { chatScrollBottom(); }
</script>
