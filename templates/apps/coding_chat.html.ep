<%
	# A Coding-agent chatbox any app can mount: pass a unique mount (also used as
	# the conversation name, so each app keeps its own thread) and an optional
	# label. The panel stays hidden until its .coding_chat_toggle is pressed; the
	# words go to /manager/coding/heal, which edits and ships the repo.
	my $m = $mount // 'app';
	my $l = $label // 'Coding agent';
%>
<div class="coding_chat" id="coding_chat_<%= $m %>" mount="<%= $m %>" conversation="<%= $m %>"
	style="position:absolute;right:10px;bottom:48px;width:360px;max-width:92%;height:340px;display:none;flex-direction:column;background:var(--panel);border:2px solid var(--line);border-radius:8px;box-shadow:0 8px 26px rgba(0,0,0,.35);overflow:hidden;z-index:4000;">
	<div style="display:flex;align-items:center;gap:6px;padding:6px 8px;border-bottom:1px solid var(--line);">
		<span style="flex:1;font-weight:bold;font-size:13px;opacity:.85;"><%= $l %></span>
		<span class="coding_chat_forget hover" hint="Forget this conversation" style="cursor:pointer;font-size:12px;opacity:.6;">forget</span>
		<span class="coding_chat_close hover" hint="Close" style="cursor:pointer;font-size:14px;opacity:.7;padding:0 4px;">✕</span>
	</div>
	<div class="coding_chat_log" style="flex:1;overflow-y:auto;padding:8px;font-size:13px;line-height:1.35;"></div>
	<div style="display:flex;gap:6px;align-items:flex-end;padding:6px;border-top:1px solid var(--line);">
		<textarea class="coding_chat_input" rows="1" placeholder="Tell the coding agent what to change…" style="flex:1;box-sizing:border-box;height:34px;min-height:34px;max-height:34px;resize:none;border-radius:8px;border:1px solid var(--line);background:var(--panel);color:var(--ink);padding:6px 8px;font-size:13px;font-family:inherit;"></textarea>
		<button class="coding_chat_send button" hint="Send to the coding agent" style="padding:7px 12px;border-radius:8px;border:2px solid var(--line);cursor:pointer;font-weight:bold;">Send</button>
	</div>
</div>
