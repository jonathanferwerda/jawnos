<%
	# A Coding-agent chatbox any app can mount: pass a unique mount (also used as
	# the conversation name, so each app keeps its own thread) and an optional
	# label. The panel stays hidden until its .coding_chat_toggle is pressed; the
	# words go to /manager/coding/heal, which edits and ships the repo. Its bar
	# drags the panel (codingChatDraggable) and the + in the bar opens another
	# agent, with its own conversation, so several can sit on screen at once. Its
	# fixes button swaps the chat for the error watch's staging area (staged_fixes):
	# errors caught in the tree's own log, each with the fix the agent proposed,
	# waiting for Apply.
	my $m = $mount // 'app';
	my $l = $label // 'Coding agent';
%>
<div class="coding_chat" id="coding_chat_<%= $m %>" mount="<%= $m %>" conversation="<%= $m %>"
	style="position:absolute;right:10px;bottom:48px;width:360px;max-width:92%;height:340px;display:none;flex-direction:column;background:var(--panel);border:2px solid var(--line);border-radius:8px;box-shadow:0 8px 26px rgba(0,0,0,.35);overflow:hidden;z-index:4000;">
	<div class="coding_chat_header" hint="Drag here to move this panel" style="display:flex;align-items:center;gap:6px;padding:6px 8px;border-bottom:1px solid var(--line);cursor:move;">
		<span class="coding_chat_title" style="flex:1;font-weight:bold;font-size:13px;opacity:.85;"><%= $l %></span>
		<span class="coding_chat_new hover" hint="Open another coding agent, with its own thread" style="cursor:pointer;font-size:16px;font-weight:bold;line-height:1;opacity:.6;padding:0 3px;">+</span>
		<span class="coding_fixes_toggle hover" hint="Errors caught in the tree's log, and fixes staged for your word" style="cursor:pointer;font-size:12px;opacity:.6;">fixes <b class="coding_fixes_count">0</b></span>
		<span class="coding_chat_forget hover" hint="Forget this conversation" style="cursor:pointer;font-size:12px;opacity:.6;">forget</span>
		<span class="coding_chat_close hover" hint="Close" style="cursor:pointer;font-size:14px;opacity:.7;padding:0 4px;">✕</span>
	</div>
	<div class="coding_chat_log" style="flex:1;overflow-y:auto;padding:8px;font-size:13px;line-height:1.35;"></div>
	<div class="coding_fixes_panel" style="display:none;flex:1;flex-direction:column;overflow:hidden;">
		<div style="display:flex;align-items:center;gap:8px;padding:4px 8px;border-bottom:1px solid var(--line);">
			<span class="coding_fixes_back hover" hint="Back to the chat" style="cursor:pointer;font-size:12px;opacity:.7;">&larr; chat</span>
			<span style="flex:1;font-size:12px;opacity:.6;">errors caught &amp; fixes staged</span>
			<span class="coding_fixes_clear hover" hint="Empty the whole list (an applied fix lives in git, and a fault that comes back is caught again)" style="cursor:pointer;font-size:12px;opacity:.7;">clear</span>
			<span class="coding_fixes_restart hover" hint="Restart the tree so applied fixes go live" style="cursor:pointer;font-size:12px;opacity:.7;">restart</span>
		</div>
		<div class="coding_fixes_rows" style="flex:1;overflow-y:auto;padding:8px;font-size:12px;line-height:1.35;"></div>
	</div>
	<div class="coding_chat_composer" style="display:flex;gap:6px;align-items:flex-end;padding:6px;border-top:1px solid var(--line);">
		<textarea class="coding_chat_input" rows="1" placeholder="Tell the coding agent what to change…" style="flex:1;box-sizing:border-box;height:34px;min-height:34px;max-height:34px;resize:none;border-radius:8px;border:1px solid var(--line);background:var(--panel);color:var(--ink);padding:6px 8px;font-size:13px;font-family:inherit;"></textarea>
		<button class="coding_chat_send button" hint="Send to the coding agent" style="padding:7px 12px;border-radius:8px;border:2px solid var(--line);cursor:pointer;font-weight:bold;">Send</button>
	</div>
</div>
