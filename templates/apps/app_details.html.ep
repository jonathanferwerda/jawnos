<% my $random_string = &subs::random_string_creator(10); %>
<% no warnings 'uninitialized'; %>
<span class="app_details" uuid="<%= $random_string %>" app="<%= $a %>" <% unless ($app->{'timestamp'}) { %>style="display:none;" <% } %>><br>

	<label>Type</label>
	<select class="transaction movement app_setting" app="<%= $a %>" attribute="movement">
		<% foreach my $mov (sort keys %{$gb::transaction_types}) { %>
			<option value="<%= $mov %>" <% if ($mov eq ($app->{'movement'} || $appts->{$a}->{'setting'}->{'movement'})) { %>selected<%}%>><%= &subs::format_name($mov) %></option>
		<% } %>
	</select>
	<select class="transaction currency app_setting" app="<%= $a %>" attribute="currency">
		<% foreach my $cur (@{$gb::abilities->{'currency'}->{'options'}}) { %>
			<option value="<%= $cur %>" <% if ($cur eq $appts->{$a}->{'setting'}->{'currency'}) { %>selected<% } %>><%= &subs::format_name($gb::measures->{$cur}->{'name'}) %></option>
		<% } %>
	</select>
	<br>
	<label>Project</label>
	<select class="transaction project app_setting" attribute="project" style="max-width:50%;">
		<option selected="selected" value="<%= $a %>"><%= $appts->{$a}->{'formatted_name'} %></option>
		<% foreach my $ap (@{$appts->{'__projects'}}) { %>
			<option 
				value="<%= $ap->{'app'} %>"
				<% if (($app->{'project'} || $appts->{$a}->{'setting'}->{'project'} || $appts->{$a}->{'last_project'}) eq $ap->{'app'}) { %>
					selected
				<% } %>>
				<%= $ap->{'formatted_name'} %>
			</option>
		<% } %>
	</select>
	<br>
	<br>
	<label><%= &subs::ui('Paid from') %></label>
	<% my $accounts_list = $appts->{'__accounts'} || []; %>
	<% my $current_account = $app->{'account'} || $appts->{$a}->{'setting'}->{'account'} || $appts->{$a}->{'last_account'} || ''; %>
	<% $current_account = '' if length($current_account) && !grep { $_->{'app'} eq $current_account } @{$accounts_list}; %>
	<% $current_account = $accounts_list->[0]->{'app'} if !length($current_account) && scalar @{$accounts_list}; %>
	<% my ($current_wallet) = grep { $_->{'app'} eq $current_account } @{$accounts_list}; %>
	<% my $current_asset = $current_wallet ? ($current_wallet->{'crypto_asset'} || '') : ''; %>
	<select class="transaction account app_setting" app="<%= $a %>" attribute="account" style="max-width:40%;color:var(--ink);">
		<% if (!scalar @{$accounts_list}) { %>
			<option value="" label="No accounts yet">No accounts yet</option>
		<% } %>
		<% foreach my $ap (@{$accounts_list}) { %>
			<option 
				value="<%= $ap->{'app'} %>"
				label="<%= $ap->{'formatted_name'} %>"
				<% if ($ap->{'crypto_asset'}) { %>data-crypto="1" data-asset="<%= $ap->{'crypto_asset'} %>"<% } %>
				<% if ($ap->{'payment_type'}) { %>data-payment="<%= $ap->{'payment_type'} %>"<% } %>
				<% if ($ap->{'app'} eq $current_account) { %>
					selected
				<% } %>
				<%= $ap->{'formatted_name'} %>
			</option>
		<% } %>
	</select>
	<span class="crypto_hint" style="<%= $current_asset ? '' : 'display:none;' %>font-size:13px;margin-left:6px;" data-asset="<%= $current_asset %>">amount in <b class="crypto_asset_name"><%= $current_asset %></b> — <span class="crypto_fiat"></span></span>

	<div class="tx_tender" app="<%= $a %>">
		<span class="tx_field">
			<label for="<%= $random_string %>_tendered"><%= &subs::ui('Cash given') %></label>
			<input id="<%= $random_string %>_tendered" type="text" class="tx_tendered" inputmode="decimal" placeholder="0.00" value="">
		</span>
		<span class="tx_field tx_change_field">
			<label><%= &subs::ui('Change') %></label>
			<span class="tx_change"></span>
		</span>
	</div>



	<span style="display:none;position:fixed;background-color:var(--panel);border:solid;border-radius:2px;font-size:20px;" class="transaction_autocomplete"></span>
	<span class="transaction_movement_container" app="<%= $a %>">
		<span class="purchase_details" uuid="<%= $random_string %>" app="<%= $a %>" style="">
			<%= include 'apps/transaction/' . $appts->{$a}->{'setting'}->{'movement'}, appts => $appts, a => $a, app => {}, source => 'transaction' %>
		</span>
	</span>
	<div class="tx_add_row">
		<button type="button" class="add_transaction_item"><%= &subs::ui('+ Add item') %></button>
	</div>
	<table class="tx_summary">
		<thead>
			<% my @th = qw/amount tax aux total/; %>
			<% my %th_label = ( amount => 'Amount', tax => 'Tax', aux => 'Extra', total => 'Total' ); %>
			<% foreach my $th ( @th ) { %>
				<th><%= &subs::ui($th_label{$th}) %></th>
			<% } %>
		</thead>
		<tbody>
			<tr>
				<% foreach my $td ( @th ) { %>
					<td class="transaction_total" style="font-size:22px;" attribute="<%= $td %>"><%= &subs::price_formatter(0) %></td>
				<% } %>
			</tr>
		</tbody>
	</table>
	<br>

	<div class="tx_actions">
		<button type="button" class="transaction_history_retriever" timestamp="" app="<%= $a %>" title="<%= &subs::ui('Fill the form from the last transaction in this app') %>"><%= &subs::ui('Repeat last') %></button>
		<button type="button" class="cancel_transaction" app="<%= $a %>"><%= &subs::ui('Cancel') %></button>
		<% unless ($app->{'timestamp'}) { %>
			<button type="button" name="record_purchase" class="record_purchase tx_save"><%= &subs::ui('Save') %></button>
		<% } %>
	</div>
	<br>
</span>
<span class="appointment_display" style="display:none;" app="<%= $a %>"></span>
