<div class="media_window" app="<%= $id %>">

	<% my $miss = $misses->{$id} || &subs::random_string_creator(25,"Aa"); %>
	<% my $app = $c->param('app_name'); %>
	<% my $timestamp = &subs::rightNow(); %>
	<div id="neighbour_media"></div>
	<style>
		#<%= $miss %>_speed {
			appearance: none;
			height: 30px;
			width: 130px;
			border: solid;
			border-radius: 5px;
			border-width: 3px;
			background-color:transparent;
			color: black;
			outline: none;
			vertical-align: middle;
			/* the 130x30 ruler strip; an icon-set icon is a full square, and at its
			   natural size only its empty corner would fall inside this box */
			background-image: url('/images/studio/ruler.png');
			background-size: 100% 100%;
			background-repeat: no-repeat;
		}
		#<%= $miss %>_position {
			position:absolute;
			bottom:95px;
			left: 0px;
			width:98%;
			height:20px;
		}
		#<%= $miss %>_position_preview {
			width: 200px;
			height: 120px;
		}
		#<%= $miss %>_back {
			position: absolute;
			left: 220px;
			bottom: 55px;
		}
		#<%= $miss %>_forward {
			position: absolute;
			left: 270px;
			bottom: 55px;
		}
		#<%= $miss %>_full_screen {
			position:absolute;
			left: 56px;
			bottom: 55px;
		}
		#music_list_view {
			position:absolute;
			left: 108px;
			bottom: 55px;
		}
		#music_shuffle {
			bottom:  1px;
			left: 320px;
			position:absolute;
		}
		#music_repeat {
			left: 320px;
			bottom:55px;
			position:absolute;
		}
		#<%= $miss %>_jog_wheel_frame {
			position:absolute;
			right: 10px;
			bottom: 0px;
			height: 90px;
			width: 90px;
		}
		#<%= $miss %>_jog_wheel {
			width: 100%;
			height: 100%;
			border-radius: 50%;
		}
		#<%= $id %>_full_title {
			position:absolute;
			left: 370px;
			right: 130px;
			bottom: 6px;
			max-height: 96px;
			overflow: hidden;
			overflow-wrap: anywhere;
			font-size: 18px;
			line-height: 1.2;
			text-align: center;
			color: yellow;
		}
		#<%= $id %>_time_display {
			position:absolute;
			left: 145px;
			bottom:70px;
			font-size: 24px;
			color: yellow;
		}
		#<%= $id %>_media_information {
			position:absolute;
			left: 85px;
			bottom: 30px;
			font-size: 20px;
			color: yellow;
		}
		#<%= $id %>_mark_information {
			position:absolute;
			left: 150px;
			bottom: 30px;
			font-size: 20px;
			color:yellow;
		}
		#<%= $id %>_subtitle_toggle {
			bottom: 55px;
			left: 160px;
			position: absolute;
		}
		/* the tools toggle and its pop-out: the panel opens above the foot so the
		   grouped controls (speed, snapshot, mark, loop markers) never crowd it */
		#<%= $miss %>_tools_toggle {
			position: absolute;
			bottom: 1px;
			left: 1px;
		}
		.media_tools_toggle.active { background-color: yellow; }
		.media_tools_panel {
			position: absolute;
			bottom: 112px;
			left: 6px;
			display: none;
			flex-wrap: wrap;
			max-width: calc(100% - 12px);
			align-items: center;
			gap: 8px;
			padding: 8px 10px;
			background-color: rgba(20,20,20,.94);
			border: 1px solid #777;
			border-radius: 10px;
			box-shadow: 0 6px 20px rgba(0,0,0,.5);
			z-index: 20;
		}
		.media_tools_panel.shown { display: flex; }
		.media_tools_panel > * { position: static !important; left: auto !important; right: auto !important; top: auto !important; bottom: auto !important; margin: 0; }
		/* the visualiser's drawing surface: it is never shown itself. music.js
		   draws here and hands the canvas' stream to the muted video below, so the
		   sound's picture reaches the player the way a video track's does */
		.media_visualizer {
			position: absolute;
			left: 0px;
			top: 0px;
			width: 100%;
			height: 100%;
			opacity: 0;
			pointer-events: none;
		}
		/* that drawing, as a picture: it wears the player's own picture styles
		   (thumb_style in the corner, big_style in the theatre), put on it by
		   music.js */
		.media_visual_media {
			position: absolute;
			background-color: #000;
		}
		.media_visualization_label {
			color: #ddd;
			font-size: 12px;
			letter-spacing: .3px;
		}
		.media_visualization {
			height: 30px;
			max-width: 150px;
			border: solid 2px #777;
			border-radius: 6px;
			background-color: #111;
			color: #eee;
			font-size: 13px;
		}
		/* the music player's own bar: it wraps to two rows - the full-width seek
		   on top, then the transport, shuffle/repeat, title, theatre and extras.
		   The controls that were absolutely placed in the foot are reset to static
		   so the rows can flow them; the seek previews are kept out of that reset
		   because their JS lays them fixed above the bar. The icon sizes follow the
		   WINDOW, not the screen (the window is a small panel on a big screen):
		   .wind[app=music] is the container, the base sizes are the ones that fit
		   the window's narrowest (~320px) and @container min-width steps enlarge
		   them as it widens. Base = narrow also means a browser without
		   container-query support degrades to a bar that fits. */
		.media_controls.music_player_bar {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			align-content: center;
			gap: 1px;
			padding: 0 4px;
			box-sizing: border-box;
		}
		.music_player_bar > *:not(.media_tools_panel):not(#<%= $miss %>_position_preview):not(#<%= $miss %>_position_preview_info) {
			position: static !important;
			left: auto !important;
			right: auto !important;
			top: auto !important;
			bottom: auto !important;
		}
		.music_player_bar #transport { display: flex; align-items: center; gap: 0; flex: 0 0 auto; }
		.music_player_bar .control { display: inline-block; padding: 1px; border-radius: 10px; transition: background-color .15s; }
		.music_player_bar .control:hover { background-color: rgba(255,255,255,.12); }
		.music_player_bar .medium_thumb { height: 42px; max-width: 48px; border: none; background: transparent; }
		.music_player_bar .music_shuffle,
		.music_player_bar .music_repeat,
		.music_player_bar .little_thumb { height: 34px; border: none; background: transparent; }
		.music_player_bar .music_shuffle,
		.music_player_bar .music_repeat { flex: 0 0 auto; }
		/* the title sits where the seek used to, taking the row's slack and
		   wrapping to at most two lines. The id is needed for specificity: the
		   #<%= $id %>_full_title rule above styles the video overlay and would
		   otherwise win. */
		.music_player_bar #<%= $id %>_full_title {
			flex: 1 1 0;
			min-width: 0;
			overflow: hidden;
			overflow-wrap: anywhere;
			text-align: center;
			color: yellow;
			font-size: 15px;
			line-height: 1.15;
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			white-space: normal;
		}
		/* the seek spans its own full-width row above the buttons. box-sizing is
		   needed because the range input's UA padding would otherwise be added on
		   top of the 100% and push it past the bar's edge. The dark grey backdrop
		   makes the track's extent visible against the black bar. */
		.music_player_bar .music_seek {
			flex: 0 0 100%;
			width: 100%;
			min-width: 0;
			box-sizing: border-box;
			padding: 0;
			margin: 0;
			height: 24px;
			background-color: #333;
			border-radius: 4px;
		}
		.music_player_bar .media_tools_toggle { flex: 0 0 auto; }
		.music_player_bar #<%= $miss %>_jog_wheel_frame { height: 72px; width: 72px; }
		@container (min-width: 380px) {
			.media_controls.music_player_bar { gap: 2px; padding: 0 6px; }
			.music_player_bar .medium_thumb { height: 48px; max-width: 54px; }
			.music_player_bar .music_shuffle,
			.music_player_bar .music_repeat,
			.music_player_bar .little_thumb { height: 40px; }
			.music_player_bar #<%= $id %>_full_title { font-size: 16px; }
		}
		@container (min-width: 560px) {
			.music_player_bar .medium_thumb { height: 54px; max-width: 62px; }
			.music_player_bar .music_shuffle,
			.music_player_bar .music_repeat,
			.music_player_bar .little_thumb { height: 46px; }
			.music_player_bar #<%= $id %>_full_title { font-size: 18px; }
		}
		@container (min-width: 760px) {
			.music_player_bar .medium_thumb { height: 60px; max-width: 68px; }
			.music_player_bar .music_shuffle,
			.music_player_bar .music_repeat,
			.music_player_bar .little_thumb { height: 52px; }
		}
		/* the theatre-mode picture fills the window: the container takes the
		   media window's whole height, so the video's own 100% resolves and the
		   browser's subtitle overlay - drawn at the element's foot - lands at the
		   window's foot instead of hanging below it */
		#<%= $miss %>_container { height: 100%; }
		/* the picture owns a finger's sideways and downward travel: the scrub and
		   volume gestures above, not the page's own panning */
		#<%= $id %>, #<%= $miss %>_visual_media { touch-action: none; background-color: #000; }
	</style>

	<div id="<%= $miss %>_container" class="<%= $id %>_container" style="width:100%;background-color:black;display:block;">
		<% if ($c->param('contents')) { %>
			<%== $c->param('contents') %>
			<script> $('#<%= $id %>').addClass('<%= $miss %>');</script>
		<% } else { %>
			<video autoplay playsinline webkit-playsinline class="media_out <%= $miss %>" id="<%= $id %>" miss="<%= $miss %>" <% if ($source ne 'music') { %> muted <% } %> thumb_style="border:solid;border-radius:7px;border-width:5px;width:30%;right:10px;bottom:120px;position:absolute;" 
				big_style="max-height:<%= $source eq 'music' ? 'calc(100% - 10px)' : '100%' %>;height:<%= $source eq 'music' ? 'calc(100% - 10px)' : '100%' %>;width:100%;object-fit:contain;<% if ($source eq 'music') { %>top:10px;position:absolute;<% } %>" style="max-height:100%;width:100%;<% if ($source eq 'music') { %>top:103px;position:absolute;<% } %>"
				>
				<track src="" id="<%= $id %>_subtitles" kind="subtitles" onerror="this.onerror=null;" srclang="en" label="English" status="<%= $crate->{'settings'}->{'subtitles'} %>" default  />
			</video>
		<% } %>
		<img style="display:none;width:80%;height:80%;top:10%;left:10%;;left:10%;position:absolute;" id="music_album_cover">
		<% if ($source eq 'music') { %>
			<%# the visualisation surface: music.js draws on it and feeds its stream
			    to the video beside it, which is the picture that is actually seen %>
			<canvas id="<%= $miss %>_visualizer" class="media_visualizer" miss="<%= $miss %>"></canvas>
			<%# the sound's picture, played: a muted video fed by the canvas' stream
			    and dressed in the player's own picture styles by music.js %>
			<video id="<%= $miss %>_visual_media" class="media_visual_media" muted playsinline style="display:none;"></video>
		<% } %>
		<div class="media_controls<%= $source eq 'music' ? ' music_player_bar' : '' %>" id="<%= $miss %>_controls" style="background-color:black;opacity:1;position:absolute;bottom:0px;height:110px;width:100%;">
<% if ($source eq 'music') { %>
			<%# the seek spans its own full-width row above the rest %>
			<input id="<%= $miss %>_position" hint="Seek" class="<%= $miss %> hover music_seek" value="0" type="range" step=".1" min="0" max="100">
			<span id="transport">
				<span id="prev" class="hover control"><img id="prev_logo" hint="Previous" class="medium_thumb" src="<%= &subs::icon_path('prev', '/icons/prev.jpg') %>" /></span>
				<span id="play" class="hover control"><img id="play_logo" hint="Play / Pause" play_icon="<%= &subs::icon_path('play', '/icons/play.jpg') %>" pause_icon="<%= &subs::icon_path('pause', '/icons/pause.jpg') %>" class="medium_thumb" src="<%= &subs::icon_path('play', '/icons/play.jpg') %>" /></span>
				<span id="next" class="hover control"><img id="next_logo" hint="Next" class="medium_thumb" src="<%= &subs::icon_path('next', '/icons/next.jpg') %>" /></span>
			</span>
			<img src="<%= &subs::icon_for('/images/decipherable/list.png') %>" hint="Theatre mode" class="little_thumb hover" id="music_list_view">
			<img src="<%= &subs::icon_for('/images/studio/shuffle.png') %>" hint="Shuffle" enabled="<%= $crate->{'settings'}->{'shuffle'} %>" id="music_shuffle" class="little_thumb music_shuffle shuffle hover">
			<img src="<%= &subs::icon_for('/images/studio/repeat.png') %>" hint="Repeat" enabled="<%= $crate->{'settings'}->{'repeat'} %>" id="music_repeat" class="little_thumb music_repeat repeat hover">
			<span id="<%= $id %>_full_title"></span>
			<img id="<%= $miss %>_tools_toggle" hint="More tools" class="little_thumb hover media_tools_toggle" src="<%= &subs::icon_path('wrench', '/images/decipherable/gear.png') %>">
			<span id="<%= $miss %>_tools_panel" class="media_tools_panel">
				<input id="<%= $miss %>_speed" hint="Playback speed" class="<%= $miss %> speed hover" type="range" step=".1" min="0.1" max="4" value="1">
				<img id="<%= $miss %>_snapshot" hint="Save a snapshot" src="<%= &subs::icon_for('/images/decipherable/gallery.png') %>" class="little_thumb <%= $miss %> hover">
				<img id="<%= $miss %>_add" hint="Drop a mark" timestamp="<%= $timestamp %>" class="<%= $miss %> little_thumb hover" src="<%= &subs::icon_for('/images/studio/plus.png') %>">
				<img id="<%= $miss %>_loop_start" hint="Set loop start" timestamp="<%= $timestamp %>" class="<%= $miss %> little_thumb loop_control hover"  loop_control="start" src="<%= &subs::icon_for('/images/make believe/start.png') %>">
				<img id="<%= $miss %>_loop_end" hint="Set loop end" timestamp="<%= $timestamp %>" class="<%= $miss %> little_thumb loop_control hover" loop_control="end" src="<%= &subs::icon_for('/images/make believe/end.png') %>">
				<img id="<%= $miss %>_back" hint="Previous chapter" timestamp="<%= $timestamp %>" class="<%= $miss %> little_thumb hover last_chapter" src="<%= &subs::icon_for('/images/studio/back.png') %>">
				<img id="<%= $miss %>_forward" hint="Next chapter" timestamp="<%= $timestamp %>" class="<%= $miss %> little_thumb hover next_chapter" src="<%= &subs::icon_for('/images/studio/forward.png') %>">
				<%# the sound's own picture, for the tracks that have none: the
				    visualiser's four drawings, plus None for the plain black one %>
				<span class="media_visualization_label">Visualizer</span>
				<select id="<%= $miss %>_visualization" hint="Visualization" class="media_visualization hover">
					<option value="none">None</option>
					<option value="equalizer">Equalizer</option>
					<option value="dots">Dots</option>
					<option value="psychedelic">Psychedelic</option>
					<option value="modern_art">Modern Art</option>
				</select>
				<img id="<%= $id %>_subtitle_toggle" hint="Subtitles" style="" status="<%= ((eval { $crate->{'settings'}->{'subtitles'} } || '') eq 'showing') ? 'showing' : 'hidden' %>" class="little_thumb hover" src="<%= &subs::icon_for('/images/decipherable/love letter.png') %>">
				<img id="<%= $miss %>_full_screen" hint="Fullscreen" timestamp="<%= $timestamp %>" class="<%= $miss %> little_thumb hover" src="<%= &subs::icon_for('/images/studio/green screen.png') %>">
				<span id="<%= $miss %>_jog_wheel_frame" class=" hover">
					<img id="<%= $miss %>_jog_wheel" hint="Jog wheel" class="<%= $miss %> jog_wheel" src="/images/studio/jog wheel.png">
					<span id="<%= $miss %>_jog_wheel_centre" style="width:1px; height: 1px;" ></span>
				</span>
			</span>
			<span id="<%= $id %>_time_display" style="display:none;">0:00</span>
			<img id="<%= $miss %>_position_preview" style="display:none;" class="huge_thumb">
			<span id="<%= $miss %>_position_preview_info" style="display:none;" class=""></span> 
			<span id="<%= $id %>_mark_information" style="display:none;"></span>
			<span id="<%= $id %>_media_information" style="display:none;"></span>
<% } else { %>
			<input id="<%= $miss %>_position" hint="Seek" class="<%= $miss %> hover" value="0" type="range" step=".1" min="0" max="100" width="100%">
			<img id="<%= $miss %>_full_screen" hint="Fullscreen" timestamp="<%= $timestamp %>" class="<%= $miss %> little_thumb hover" src="<%= &subs::icon_for('/images/studio/green screen.png') %>">
			<img id="<%= $miss %>_back" hint="Previous chapter" timestamp="<%= $timestamp %>" class="<%= $miss %> little_thumb hover last_chapter" src="<%= &subs::icon_for('/images/studio/back.png') %>">
			<img id="<%= $miss %>_forward" hint="Next chapter" timestamp="<%= $timestamp %>" class="<%= $miss %> little_thumb hover next_chapter" src="<%= &subs::icon_for('/images/studio/forward.png') %>">
			<img id="<%= $id %>_subtitle_toggle" hint="Subtitles" style="" status="<%= ((eval { $crate->{'settings'}->{'subtitles'} } || '') eq 'showing') ? 'showing' : 'hidden' %>" class="little_thumb hover" src="<%= &subs::icon_for('/images/decipherable/love letter.png') %>">
			<%# the rarely-used tools sit behind one toggle: speed, snapshot, mark, and
			    the two loop markers, which together were most of the crowded foot %>
			<img id="<%= $miss %>_tools_toggle" hint="More tools: speed, snapshot, mark, loop" class="little_thumb hover media_tools_toggle" src="<%= &subs::icon_path('wrench', '/images/decipherable/gear.png') %>">
			<span id="<%= $miss %>_tools_panel" class="media_tools_panel">
				<input id="<%= $miss %>_speed" hint="Playback speed" class="<%= $miss %> speed hover" type="range" step=".1" min="0.1" max="4" value="1">
				<img id="<%= $miss %>_snapshot" hint="Save a snapshot" src="<%= &subs::icon_for('/images/decipherable/gallery.png') %>" class="little_thumb <%= $miss %> hover">
				<img id="<%= $miss %>_add" hint="Drop a mark" timestamp="<%= $timestamp %>" class="<%= $miss %> little_thumb hover" src="<%= &subs::icon_for('/images/studio/plus.png') %>">
				<img id="<%= $miss %>_loop_start" hint="Set loop start" timestamp="<%= $timestamp %>" class="<%= $miss %> little_thumb loop_control hover"  loop_control="start" src="<%= &subs::icon_for('/images/make believe/start.png') %>">
				<img id="<%= $miss %>_loop_end" hint="Set loop end" timestamp="<%= $timestamp %>" class="<%= $miss %> little_thumb loop_control hover" loop_control="end" src="<%= &subs::icon_for('/images/make believe/end.png') %>">
			</span>
			<img id="<%= $miss %>_position_preview" style="display:none;" class="huge_thumb">
			<span id="<%= $miss %>_position_preview_info" style="display:none;" class=""></span> 
			<span id="<%= $miss %>_jog_wheel_frame" style="" class=" hover">
				<img id="<%= $miss %>_jog_wheel" hint="Jog wheel" class="<%= $miss %> jog_wheel" src="/images/studio/jog wheel.png">
				<span id="<%= $miss %>_jog_wheel_centre" style="width:1px; height: 1px;" ></span>
			</span>
			<span id="<%= $id %>_time_display" style="display:none;">
				0:00
			</span>
			<span id="<%= $id %>_mark_information">

			</span>
			<span id="<%= $id %>_media_information">

			</span>
			<span id="<%= $id %>_full_title"></span>
<% } %>
		</div>
	</div>
	<script>

	</script>
	<script>
		var v = document.getElementById('<%= $id %>');
		v.lastPositionPreview = 0;

		if (misses['<%= $id %>'] != '<%= $miss %>') {
			misses['<%= $id %>'] = '<%= $miss %>';
			// Drop the auto-hide timer from the previous render of this window.
			if (window.jawnos_vid_tools && window.jawnos_vid_tools['<%= $id %>'] && window.jawnos_vid_tools['<%= $id %>'].toolbarTimeout) {
				clearInterval(window.jawnos_vid_tools['<%= $id %>'].toolbarTimeout);
			}
			$('#<%= $id %>_script').attr('loaded', 'yes');
			// A re-render (icon-set swap, reopen) must not stack document-level
			// handlers, or every mousemove/tick multiplies work until the browser locks up.
			var jawnos_vid_ns = '.jawnos_vid_<%= $id %>';
			$(document).off(jawnos_vid_ns);
			function vidOn(events, selector, handler) {
				var namespaced = events.split(' ').map(function(e) { return e + jawnos_vid_ns; }).join(' ');
				$(document).on(namespaced, selector, handler);
			}
			// A wheel is a `wheel` event in every engine that has one; `mousewheel`
			// is only for an engine too old for it (binding both doubles the gesture).
			var <%= $miss %>WheelEvent = ('onwheel' in document) ? 'wheel' : 'mousewheel';



			vidOn('change mousemove touchmove', '#<%= $miss %>_speed', function() {
				var speed = numeral($(this).val()).value();
				var v = document.getElementById('<%= $id %>');
				v.playbackRate = speed;
			});
			vidOn('dblclick', '#<%= $miss %>_speed', function() {
				$(this).val(1);
				var v = document.getElementById('<%= $id %>');
				v.playbackRate = 1;
			});
			<%= $miss %>VideoInterval();
			function <%= $miss %>VideoInterval() {
				var <%= $id %>_interval;
				var v = document.getElementById('<%= $id %>');
				if (windowPhoneChecker()) {
					$('#<%= $miss %>_jog_wheel_frame').hide();
				}
				clearInterval(vidControls['<%= $id %>_video_interval']);
				v.fps = { average: 0, instances: [], measure: 3, quality: { instant: 0 } };
				clearInterval(vidControls['<%= $id %>_video_interval']);
				vidControls['<%= $id %>_video_interval'] = setInterval(function() {
					var el = document.getElementById('<%= $id %>');
					if (!el || $('#<%= $id %>').length == 0) { //!$('.<%= $miss %>_container').closest('.wind').is(':visible')) {
						clearInterval(vidControls['<%= $id %>_video_interval']);
						misses['<%= $id %>'] = null;
						return;
					}
					// Skip per-second DOM/layout work while the tab is backgrounded.
					if (document.hidden) { return; }
					var v = el;
					if (v.state == 1) {
						var speed = numeral($('#<%= $miss %>_speed').val()).value();
						var fps = v.fps.quality;
						v.fps.quality = v.getVideoPlaybackQuality();
						v.fps.quality.instant = Date.now();
						var vid = $('#<%= $id %>');
						if (fps.instant != 0) {
							if (v.fps.quality.totalVideoFrames == 0) {
								<% if ($source eq 'music') { %>
								//	$('#music_theatre').hide();
								<% } else { %>
									$('#<%= $id %>').closest('.wind').hide();
								<% } %>
							}
							else {
								var creation = v.fps.quality.instant - fps.instant;
								var frames = v.fps.quality.totalVideoFrames - fps.totalVideoFrames;
								v.fps.instances.unshift(numeral(frames / creation * 1000 / speed).value());
								var fps_total = 0;

								$.each(v.fps.instances, function(i,v) {
									fps_total = v + fps_total;
								});
								if (v.fps.instances.length > v.fps.measure) {
									v.fps.average = numeral(fps_total / v.fps.instances.length).format('0.00');
									$('#<%= $id %>_media_information').html(v.fps.average);
									
									v.fps.instances.pop();
								}
								var wind = $('#<%= $id %>').closest('.wind');
								if (!wind.is(':visible')) { wind.show(); }
							}
						}
						if (vid.length == 0) {
							clearInterval(vidControls['<%= $id %>_video_interval']);
						}
						if (vidControls['<%= $id %>']) {
							var markPosition = 0;
						//	console.log(vidControls['<%= $id %>']);
							$.each(vidControls['<%= $id %>'], function(i,vr) {
						//		console.log(i + ' ' + v.currentTime + ' ' + vr);
								if (v.currentTime >= vr) {
									markPosition = i + 1;
								}
							});
							$('#<%= $id %>_mark_information').html(markPosition + '/' + vidControls['<%= $id %>'].length);
						}
						if (v.currentTime > vid.attr('loop_end')) {
							v.currentTime = vid.attr('loop_start') || 0;
						}
						$('#<%= $miss %>_position').val(v.currentTime / v.duration * 100);
						$('#<%= $id %>_time_display').text(numeral(v.currentTime).format('00:00:00'));
						<% if ($source eq 'music') { %>
						// the title is placed and wrapped by its own css now; sizing it here
						// every tick made it either dwarf the toolbar or duck under the
						// buttons, and it never wrapped
						$('#<%= $id %>_full_title').text($('.playing').find('.full_title').text());
						<% } %>
					}
				}, 1000);
			}
			var <%= $miss %>Tools = { toolbarTimeout: 0, toolbarReset: 0, lastX: 0, lastY: 0 };
			window.jawnos_vid_tools = window.jawnos_vid_tools || {};
			window.jawnos_vid_tools['<%= $id %>'] = <%= $miss %>Tools;
			vidOn('mousemove mouseenter', '#<%= $id %>, #music, #music_album_cover, #<%= $miss %>_container, #<%= $miss %>_controls', function() {

				var controls = $('#<%= $miss %>_controls');
				if (!controls.is(':visible')) { controls.fadeIn(); }
				<% if ($source eq 'music') { %>
					var music_iface = $('#interface');
					if (!music_iface.is(':visible')) {
						// above the theatre picture and the player bar; the configuration
						// sheets are far above both (see music.css)
						music_iface.css({ 'z-index': 40 }).fadeIn();
					}
				<% } %>

				$('#<%= $id %>, #<%= $miss %>_container').css({'cursor': 'auto'});
				// Only rebuild the auto-hide timer a few times a second rather than
				// on every mousemove event.
				var jawnos_now = Date.now();
				if (!<%= $miss %>Tools['toolbarReset'] || (jawnos_now - <%= $miss %>Tools['toolbarReset']) > 250) {
				<%= $miss %>Tools['toolbarReset'] = jawnos_now;
				clearInterval(<%= $miss %>Tools['toolbarTimeout']);
				// A pointer hides the bars quickly once it leaves them; a touch
				// screen has no hover to tell us the finger has gone, so it keeps
				// the old, gentler cadence.
				var hide_after = (window.matchMedia && window.matchMedia('(hover: hover)').matches) ? 1200 : 3000;
				<%= $miss %>Tools['toolbarTimeout'] = setInterval(function() {
					if ($('#<%= $id %>').attr('theatre_mode') == 'on' || document.fullscreenElement || '<%= $id %>' != 'video') {
						var mouse = mouse_position();
						var el = document.elementsFromPoint(mouse.x,mouse.y);	
						var seen = 0;
						$('#<%= $id %>, #<%= $miss %>_container').css({'cursor': 'none'});
						$.each(el, function(i,v) {
							if (<% if ($id eq 'video') { %> $(v).attr('id') == 'interface' || <% } %> $(v).attr('id') == '<%= $miss %>_controls' || $(v).attr('id') == '<%= $miss %>_tools_panel') {
								seen = 1;
							}
							else if ($(v).attr('id') == '<%= $id %>' && seen == 0) {
								if (mouse.lastX == mouse.x && mouse.lastY == mouse.y &&  $(v).attr('id') != '<%= $miss %>_controls') {
									seen = 0;
									$('#<%= $id %>, #<%= $miss %>_container').css({'cursor': 'none'});
								}
								else {
									seen = 1;
								}
							}
						});
						if (seen == 0) {
							$('#<%= $miss %>_controls').fadeOut();
							<% if ($id == 'video') { %>
								$('#interface').fadeOut('slow'); 
							<% } %>
							clearInterval(<%= $miss %>Tools['toolbarTimeout']);
						}
					}
					else {
						clearInterval(<%= $miss %>Tools['toolbarTimeout']);
					}
					}, hide_after);
				}
			});

			vidOn('click', '#<%= $miss %>_snapshot', function() {
				var timestamp = Date.now();
				var v = document.getElementById('<%= $id %>');
				var canvas = document.createElement('canvas');
				var height = $('#<%= $id %>').height();
				var width = $('#<%= $id %>').width();
				canvas.height = height;
				canvas.width = width;
				canvas.getContext('2d').drawImage(v, 0, 0, width, height);
				var snapshot = canvas.toDataURL('image/png');

				var apper = $('.wind')[$('.wind').length - 1];
				var window_app = topWindow('<%= $app || 'video' %>') || $('#search').val();
				var app_name = window_app || <% if (($c->param('app') // '') eq 'video') { %>musicTitleMaker()<% } else { %>"<%= $app %>"<% } %>;

				$.ajax({
					url: '/manager/snapshot_save',
					type: 'POST',
					data: { 
						timestamp: timestamp,
						snapshot: snapshot,
						app: app_name
					},
					success:function(response) {
					}
				});
			});
			// one toggle for the grouped tools (speed, snapshot, mark, loop): the
			// panel opens above the foot, so the rarely-used controls stay out of it
			vidOn('click', '#<%= $miss %>_tools_toggle', function() {
				var panel = $(this).closest('.media_controls').find('.media_tools_panel');
				panel.toggleClass('shown');
				$(this).toggleClass('active', panel.hasClass('shown'));
			});
			if (!windowPhoneChecker()) {
				var <%= $miss %>_jw_deg =  0;
				var <%= $miss %>_last = 'out';
				vidOn('touchmove mousemove', '#<%= $miss %>_jog_wheel', function(e) {
					e.preventDefault();			e.preventDefault();
					var j = $(this);

				//	var jc = $('<%= $miss %>_jog_wheel_centre');
					var jc = j.closest('.jog_wheel_frame').find('.jog_wheel_centre');
					if (e.which === 1 || e.originalEvent.type == 'touchmove') {
						var x = e.originalEvent.clientX;
						var y = e.originalEvent.clientY;
						if (e.originalEvent.targetTouches) {
							x = e.originalEvent.targetTouches[0].clientX;
							y = e.originalEvent.targetTouches[0].clientY;
						}
						var middle_x = numeral(jc.offset().left + (jc.width() / 2)).value();
						var middle_y = numeral(jc.offset().top + (jc.height() / 2)).value();
						var deltaX = middle_x - x;
						var deltaY = middle_y - y;
						var rad = Math.atan2(deltaY, deltaX); 
						var deg = rad * (180 / Math.PI) - 90;
						var diff = 0;
						if (<%= $miss %>_last == 'in') {
							diff = (deg - <%= $miss %>_jw_deg);
							
						}
						<%= $miss %>_jw_deg = (<%= $miss %>_jw_deg + diff);

						$('#<%= $miss %>_jog_wheel').css({'rotate': <%= $miss %>_jw_deg + 'deg' });

						var v = document.getElementById('<%= $id %>');
						v.currentTime = v.currentTime + diff / 10 * $('#<%= $miss %>_speed').val();

					$('<%= $miss %>_time_display').text(numeral(v.currentTime).format('00:00:00.0000'));
						<%= $miss %>_last = 'in';
					}
				});
				vidOn('mouseout touchend mouseup', '#<%= $miss %>_jog_wheel,#<%= $id %>', function() {
					<%= $miss %>_last = 'out';
				});
				vidOn(<%= $miss %>WheelEvent, '#<%= $miss %>_jog_wheel', function(e) {
					var j = $('#<%= $miss %>_jog_wheel');
					var mvmt = numeral(e.originalEvent.wheelDelta).value();
					if (!mvmt || isNaN(mvmt)) { mvmt = (e.originalEvent.deltaY || 0) * -1.2; }

					var diff = numeral(mvmt / 30).value() ;
					<%= $miss %>_jw_deg = (<%= $miss %>_jw_deg + diff);

					$('#<%= $miss %>_jog_wheel').css({'rotate': <%= $miss %>_jw_deg + 'deg' });

					var v = document.getElementById('<%= $id %>');
					var currentTime = v.currentTime + diff / 10 * $(this).closest('.wind').find('.speed').val();
					v.currentTime = currentTime;
					$('#<%= $miss %>_time_display').text(numeral(v.currentTime).format('00:00:00.0000'));
				});
				vidOn('click', '#<%= $miss %>_jog_wheel, #<%= $id %><% if ($source eq 'music') { %>, #<%= $miss %>_visual_media<% } %>', function() {
					// a finger that just scrubbed or set the volume must not also toggle
					// playback on the click the browser ends the touch with
					if (<%= $miss %>Touch.moved) { <%= $miss %>Touch.moved = false; return; }
					var v = document.getElementById('<%= $id %>');
					if (v.state == 0) {
						<% if ($source eq 'music') { %>if (typeof musicVolumeApply == 'function') { musicVolumeApply(); }<% } %>
						v.play();
						v.state = 1;
						$('#play_logo').attr('src', '<%= &subs::icon_path('pause', '/icons/pause.jpg') %>');
					}
					else {
						v.pause();
						v.state = 0;
						$('#play_logo').attr('src', '<%= &subs::icon_path('play', '/icons/play.jpg') %>');
					}
				});
			}
			// The player's own gestures, wherever the picture is: a wheel scrubs it,
			// and so does a horizontal finger drag; a vertical finger drag sets the
			// volume. Bound to the player root rather than the element, so they keep
			// working over the interface that rides along into fullscreen.
			var <%= $miss %>GestureRoot = <% if ($source eq 'music') { %>'#music'<% } else { %>'#<%= $miss %>_container'<% } %>;
			var <%= $miss %>Touch = { active: false, moved: false, x: 0, y: 0, time: 0, volume: 1, axis: '' };
			function <%= $miss %>GestureAllowed(target, mode) {
				var t = $(target);
				if (t.closest('#music_library, #music_configuration, #music_padlock, #search_results, input, select, textarea, button, .jog_wheel').length) { return false; }
				// a finger on the transport belongs to its slider or button, not to a
				// scrub; a wheel over the bars has nothing else to do, so it still scrubs
				if (mode == 'touch' && t.closest('#<%= $miss %>_controls, #interface').length) { return false; }
				return true;
			}
			function <%= $miss %>SeekTo(seconds) {
				var v = document.getElementById('<%= $id %>');
				if (!v) { return; }
				if (v.duration && !isNaN(v.duration)) {
					seconds = Math.max(0, Math.min(v.duration, seconds));
				}
				else {
					seconds = Math.max(0, seconds);
				}
				v.currentTime = seconds;
				$('#<%= $miss %>_time_display').text(numeral(v.currentTime).format('00:00:00.0000'));
			}
			function <%= $miss %>VolumeTo(level) {
				level = Math.max(0, Math.min(1, level));
<% if ($source eq 'music') { %>
				// the interface owns the level: move its slider through the same handler
				// a person would, so the thumb, the mute icon and the element agree
				var slider = $('#music_volume');
				if (slider.length && typeof musicVolumeApply == 'function') {
					slider.val(level).trigger('input');
					return;
				}
<% } %>
				var v = document.getElementById('<%= $id %>');
				if (!v) { return; }
				v.volume = level;
				if (v.volume > 0) { v.muted = false; }
			}
			// Seek at most once a frame: a trackpad or a finger sends a stream of
			// events, and seeking on every one makes the picture strobe while it
			// decodes each frame. The latest target wins.
			var <%= $miss %>ScrubValue = null;
			var <%= $miss %>ScrubRaf = null;
			function <%= $miss %>ScrubTo(seconds) {
				<%= $miss %>ScrubValue = seconds;
				if (<%= $miss %>ScrubRaf) { return; }
				<%= $miss %>ScrubRaf = requestAnimationFrame(function() {
					<%= $miss %>ScrubRaf = null;
					var target = <%= $miss %>ScrubValue;
					<%= $miss %>ScrubValue = null;
					if (target != null) { <%= $miss %>SeekTo(target); }
				});
			}
			function <%= $miss %>ScrubBy(seconds) {
				var v = document.getElementById('<%= $id %>');
				if (!v) { return; }
				var base = (<%= $miss %>ScrubValue == null) ? v.currentTime : <%= $miss %>ScrubValue;
				<%= $miss %>ScrubTo(base + seconds);
			}
			function <%= $miss %>WheelKind(deltaX, deltaY, deltaMode) {
				if (typeof wheelKind == 'function') { return wheelKind(deltaX, deltaY, deltaMode); }
				if (deltaX !== 0) { return 'trackpad'; }
				if (deltaMode !== 0) { return 'mouse'; }
				if (deltaY && !Number.isInteger(deltaY)) { return 'trackpad'; }
				return Math.abs(deltaY) >= 40 ? 'mouse' : 'trackpad';
			}
			function <%= $miss %>VolumeLevel() {
				<% if ($source eq 'music') { %>
					if ($('#music_volume').length && typeof musicVolumeLevel == 'function') {
						return music_muted ? 0 : musicVolumeLevel();
					}
<% } %>
				var v = document.getElementById('<%= $id %>');
				if (!v) { return 0; }
				return v.muted ? 0 : (isNaN(v.volume) ? 1 : v.volume);
			}
			vidOn(<%= $miss %>WheelEvent, <%= $miss %>GestureRoot, function(e) {
				if (!<%= $miss %>GestureAllowed(e.target, 'wheel')) { return; }
				var v = document.getElementById('<%= $id %>');
				if (!v) { return; }
				var ev = e.originalEvent || e;
				var deltaX = ev.deltaX || 0;
				var deltaY = ev.deltaY || 0;
				var speed = numeral($('#<%= $miss %>_speed').val()).value() || 1;
				// A trackpad has two axes: sideways scrubs and up/down sets the
				// volume. A wheel mouse keeps its old vertical scrub.
				if (<%= $miss %>WheelKind(deltaX, deltaY, ev.deltaMode || 0) == 'trackpad') {
					if (Math.abs(deltaX) > Math.abs(deltaY)) {
						if (deltaX) { <%= $miss %>ScrubBy(deltaX * 0.5 * speed); }
					}
					else if (deltaY) {
						<%= $miss %>VolumeTo(<%= $miss %>VolumeLevel() - deltaY * 0.002);
					}
					return;
				}
				// the wheel's own pixels: wheelDelta on the legacy event, deltaY on a
				// plain wheel (the same ~120 a notch)
				var mvmt = (ev.wheelDelta != undefined && ev.wheelDelta != 0) ? ev.wheelDelta : (-deltaY * 1.2);
				if (!mvmt || isNaN(mvmt)) { return; }
				<%= $miss %>ScrubBy((mvmt / 300) * speed);
			});
			vidOn('touchstart', <%= $miss %>GestureRoot, function(e) {
				if (!<%= $miss %>GestureAllowed(e.target, 'touch')) { <%= $miss %>Touch.active = false; return; }
				var t = (e.originalEvent || e).touches;
				var v = document.getElementById('<%= $id %>');
				if (!t || t.length != 1 || !v) { <%= $miss %>Touch.active = false; return; }
				<%= $miss %>Touch.active = true;
				<%= $miss %>Touch.x = t[0].clientX;
				<%= $miss %>Touch.y = t[0].clientY;
				<%= $miss %>Touch.time = v.currentTime || 0;
				<%= $miss %>Touch.volume = <%= $miss %>VolumeLevel();
				<%= $miss %>Touch.axis = '';
				<%= $miss %>Touch.moved = false;
			});
			vidOn('touchmove', <%= $miss %>GestureRoot, function(e) {
				if (!<%= $miss %>Touch.active) { return; }
				var t = (e.originalEvent || e).touches;
				var v = document.getElementById('<%= $id %>');
				if (!t || t.length != 1 || !v) { <%= $miss %>Touch.active = false; return; }
				var dx = t[0].clientX - <%= $miss %>Touch.x;
				var dy = t[0].clientY - <%= $miss %>Touch.y;
				if (!<%= $miss %>Touch.axis) {
					// a few pixels decide the gesture once, so a scrub does not turn
					// into a volume change halfway across the picture
					if (Math.abs(dx) < 6 && Math.abs(dy) < 6) { return; }
					<%= $miss %>Touch.axis = (Math.abs(dx) >= Math.abs(dy)) ? 'x' : 'y';
					<%= $miss %>Touch.moved = true;
				}
				if (e.preventDefault) { e.preventDefault(); }
				var root = $(this);
				if (<%= $miss %>Touch.axis == 'x') {
					// a finger moves the track at a steady rate: half a second a pixel,
					// so a small movement is a small nudge, as a notch of the wheel is
					<%= $miss %>ScrubTo(<%= $miss %>Touch.time + dx * 0.5);
				}
				else {
					var height = root.height() || $(window).height();
					if (!height) { return; }
					<%= $miss %>VolumeTo(<%= $miss %>Touch.volume - (dy / height));
				}
			});
			vidOn('touchend touchcancel', <%= $miss %>GestureRoot, function() {
				<%= $miss %>Touch.active = false;
				<%= $miss %>Touch.axis = '';
				// the click that ends a touch lands just after it; let that one be
				// swallowed, then forget the gesture
				if (<%= $miss %>Touch.moved) {
					setTimeout(function() { <%= $miss %>Touch.moved = false; }, 400);
				}
			});
			vidOn('dblclick', '#<%= $id %><% if ($source eq 'music') { %>, #music_album_cover, #<%= $miss %>_visual_media<% } %>', function() {
				<%= $miss %>Fullscreen();
			});
			// an audio track has no picture, so the whole player goes fullscreen
			// instead of the element - that is what lets the visualisation canvas
			// (which only renders inside the fullscreen element) and the controls,
			// with the dropdown that chooses it, come along. music.js owns the
			// choice; the plain element is the fallback for a render without it.
			function <%= $miss %>Fullscreen() {
<% if ($source eq 'music') { %>
				if (typeof musicPlayerFullscreen == 'function') { musicPlayerFullscreen(); return; }
<% } %>
				var fs = document.fullscreenElement || document.webkitFullscreenElement;
				if (fs) {
					var out = document.exitFullscreen ? document.exitFullscreen()
						: (document.webkitExitFullscreen ? document.webkitExitFullscreen() : null);
					if (out && out.catch) { out.catch(function () {}); }
					return;
				}
				$('#<%= $id %>').show();
				// the container carries the transport, so the fullscreen button can
				// be pressed again to leave
				var target = document.getElementById('<%= $miss %>_container') || document.getElementById('<%= $id %>');
				if (target.requestFullscreen) { target.requestFullscreen(); }
			}

			vidOn('click', '.loop_control', function() {
				var a = $(this);
				var loop_control = a.attr('loop_control');
				var v = document.getElementById('<%= $id %>');
				var vid = $('#' + '<%= $id %>');
				var timestamp = Date.now();
				if (a.attr('timestamp') < timestamp - 100) {
					a.attr('timestamp', timestamp);
					if (a.attr('armed') == 'yes') {
						a.attr('armed','no');
						a.css({'background-color': ''});
						vid.removeAttr('loop_' + loop_control);
					}
					else {
						a.attr('armed', 'yes');
						a.css({'background-color': 'yellow'});
						vid.attr('loop_' + loop_control, v.currentTime);
					}
				}
			});

			vidOn('click','#<%= $miss %>_add', function() {
				var v = document.getElementById('<%= $id %>');
				if(!vidControls['<%= $id %>']) { vidControls['<%= $id %>'] = [] };
				var seen = 0;
				$.each(vidControls['<%= $id %>'], function(ir,vr) {
					if (v.currentTime == vr) {
						seen = ir;
					}
				})
				if (seen == 0) {
					vidControls['<%= $id %>'].push(v.currentTime);
				}
				else {
					vidControls['<%= $id %>'].splice(seen,1);
				}
				vidControls['<%= $id %>'] = vidControls['<%= $id %>'].sort(function(a,b) {
					return a - b;
				});
			});

			vidOn('click', '#<%= $miss %>_back, #<%= $id %>_back', function() {
				var a = $('#<%= $miss %>_back');
				var v = document.getElementById('<%= $id %>');
				var timestamp = Date.now();
				var bestMatch = 0;
				var bestMark = 0;
				if (a.attr('timestamp') < timestamp - 100) {
					a.attr('timestamp',timestamp);
					var seen = 0;
					$.each(vidControls['<%= $id %>'], function(i,vr) {
						vr = numeral(vr).value();
						if (v.currentTime >= (vr + 1.01)) {
							if (vr >= bestMatch) {
								bestMatch = vr;
								bestMark = i;
								seen = 1;
							}

						}
					});
					if (vidControls['<%= $id %>'] && bestMatch >= 0) {
						v.currentTime = bestMatch;
						bestMark = 0;
					}
					else if (seen == 0) {
						v.currentTime = 0;

					}
				}
				$('#<%= $id %>_mark_information').html(bestMark + '/' + vidControls['<%= $id %>'].length);
			});

			vidOn('click', '#<%= $miss %>_forward, <%= $id %>_forward', function() {
				var a = $('#<%= $miss %>_forward');
				var v = document.getElementById('<%= $id %>');
				var timestamp = Date.now();
				var seen = 0;
				var bestMatch = v.duration;
				var bestMark = vidControls['<%= $id %>'].length;
				if (a.attr('timestamp') < timestamp - 100) {
					a.attr('timestamp', timestamp);
					$.each(vidControls['<%= $id %>'], function(i,vr) {
						vr = numeral(vr).value();
						if (v.currentTime <= (vr - .01)) {
							if (vr <= bestMatch) {
								bestMatch = vr;
								bestMark = i;
							}
						}
					});
					if (vidControls['<%= $id %>'] && bestMatch < v.duration) {
						v.currentTime = bestMatch;

					}
				}
				$('#<%= $id %>_mark_information').html(bestMark + '/' + vidControls['<%= $id %>'].length);
			});

			vidOn('click', '#<%= $miss %>_full_screen', function() {
				var a = $(this);
				var timestamp = Date.now();
				if (a.attr('timestamp') < timestamp - 100) {
					a.attr('timestamp', timestamp);
					<%= $miss %>Fullscreen();
				}
			});

			vidOn('change mousedown mouseup touchmove click', '#<%= $miss %>_position', function(e) {
				var movable = 1;
				if (e.type == 'mousemove' && e.buttons == 0) {
					movable = 0;
				}
				if (movable == 1) {
					var val = $(this).val();
					var v = document.getElementById('<%= $id %>');
					v.currentTime = (v.duration * (val / 100));
				}
			});
			<% if ($source eq 'music') { %>
			// A seek preview from the video itself: a second, hidden element takes the
			// same local stream and is seeked to the hovered second, then its frame is
			// drawn into a canvas. The server's ffmpeg frame is the fallback while this
			// one warms up; once it is ready a hover no longer waits for a round trip.
			// A remote track is left to the server preview - pulling the tunnel a second
			// time to preview it would cost more than the wait.
			var <%= $miss %>SeekPreview = { video: null, src: '', want: 0, ready: false, drawn: false, visible: false, raf: 0, timer: 0, lastSeekAt: 0, hideTimer: 0, canvas: null, failed: false };
			function <%= $miss %>SeekPreviewDraw() {
				var p = <%= $miss %>SeekPreview;
				var el = p.video;
				if (!el || !el.videoWidth || !el.videoHeight || el.readyState < 2) { return; }
				var c = p.canvas || (p.canvas = document.createElement('canvas'));
				c.width = 200;
				c.height = 120;
				var g = c.getContext('2d');
				g.drawImage(el, 0, 0, c.width, c.height);
				// An all-black canvas is what a decoder that never produced the frame
				// gives us. Do not let it stand in for a preview: leave drawn false so
				// the caller keeps asking the server for the frame.
				var px = g.getImageData(0, 0, c.width, c.height).data;
				var sum = 0;
				for (var i = 0; i < px.length; i += 4) { sum += px[i] + px[i + 1] + px[i + 2]; }
				if (sum / (px.length / 4) < 1) { p.drawn = false; return; }
				p.drawn = true;
				var img = $('#<%= $miss %>_position_preview');
				img.attr('src', c.toDataURL('image/jpeg', 0.72));
				if (p.visible) { img.show(); }
			}
			function <%= $miss %>SeekPreviewSeek() {
				var p = <%= $miss %>SeekPreview;
				p.raf = 0;
				if (!p.ready || !p.video || !p.visible) { return; }
				// One seek in flight at a time. Issuing the next target before the
				// decoder has answered the last one cancelled every frame until the
				// pointer stopped, which is why the preview looked delayed.
				if (p.video.seeking) { return; }
				var now = Date.now();
				if (now - (p.lastSeekAt || 0) < 200) { return; }
				p.lastSeekAt = now;
				if (Math.abs((p.video.currentTime || 0) - p.want) > 0.05) { p.video.currentTime = p.want; }
				else { <%= $miss %>SeekPreviewDraw(); }
			}
			// A sweep should paint about five frames a second, not wait for the pointer
			// to rest. One seek is issued at most every 200 ms, and a trailing timer
			// catches the position the pointer lands on last.
			function <%= $miss %>SeekPreviewSoon() {
				var p = <%= $miss %>SeekPreview;
				if (!p.ready || !p.video || !p.visible || p.raf || p.timer || p.video.seeking) { return; }
				var wait = Math.max(0, 200 - (Date.now() - (p.lastSeekAt || 0)));
				p.timer = setTimeout(function() {
					p.timer = 0;
					if (!p.visible || !p.ready || !p.video || p.raf) { return; }
					p.raf = requestAnimationFrame(<%= $miss %>SeekPreviewSeek);
				}, wait);
			}
			function <%= $miss %>SeekPreviewShow(time) {
				var p = <%= $miss %>SeekPreview;
				var main = document.getElementById('<%= $id %>');
				var src = main && (main.currentSrc || main.getAttribute('src')) || '';
				clearTimeout(p.hideTimer);
				p.hideTimer = 0;
				p.visible = true;
				if (!src || p.failed || src.indexOf('remote_uuid=') > -1) { return false; }
				p.want = time;
				if (p.video && (p.src !== src || !document.body.contains(p.video))) {
					try { p.video.removeAttribute('src'); p.video.load(); p.video.remove(); } catch (e) {}
					if (p.raf) { cancelAnimationFrame(p.raf); p.raf = 0; }
					p.video = null; p.ready = false; p.drawn = false;
				}
				if (!p.video) {
					var el = document.createElement('video');
					el.muted = true;
					el.playsInline = true;
					el.preload = 'metadata';
					el.setAttribute('muted', '');
					el.setAttribute('playsinline', '');
					// The body, not the media window: a hidden parent (a folded window,
					// a theatre transition) must not stop the decoder from painting.
					el.style.cssText = 'position:fixed;left:-4px;top:-4px;width:2px;height:2px;opacity:0.01;pointer-events:none;z-index:-1;';
					el.setAttribute('data-jawnos-seek-preview', '');
					el.addEventListener('loadedmetadata', function() {
						p.ready = true;
						el.currentTime = p.want;
					});
					el.addEventListener('loadeddata', function() {
						<%= $miss %>SeekPreviewDraw();
					});
					el.addEventListener('seeked', function() {
						if (!el.videoWidth || !el.videoHeight) { return; }
						<%= $miss %>SeekPreviewDraw();
						// the seek was for an older position than want; ask for the newest
						if (Math.abs(el.currentTime - p.want) > 0.2) { <%= $miss %>SeekPreviewSoon(); }
					});
					el.addEventListener('error', function() {
						p.failed = true;
						try { el.removeAttribute('src'); el.load(); el.remove(); } catch (e) {}
						p.video = null;
					});
					document.body.appendChild(el);
					p.video = el;
					p.src = src;
					el.src = src;
				}
				if (!p.ready) { return false; }
				<%= $miss %>SeekPreviewSoon();
				if (p.drawn) { $('#<%= $miss %>_position_preview').show(); }
				return p.drawn;
			}
<% } %>
			vidOn('hover mousemove mouseover touchmove', '#<%= $miss %>_position', function(e) {
				var vid = $('#<%= $id %>');
				var width = $(this).width();
				var val = $(this).val();
				var x = e.originalEvent.offsetX;
				var h = $('#<%= $miss %>_position_preview').height();
				var w = $('#<%= $miss %>_position_preview').width();
				var wl = numeral($(this).closest('.wind').css('left')).value();
				var wr = ($(window).width() - numeral($(this).closest('.wind').css('right')).value());
				var m = mouse_position();
				var left = (m['x'] - (w / 2));
				if ((m['x'] + (w / 2)) > wr) {
					left = (wr - w);
				}
				if ((left) < wl) {
					left = (wl);
				}
				var top = m['y'] - h - 10;
				
				var v = document.getElementById('<%= $id %>');
				clearTimeout(v.positionPreviewHiderTimeout);
				clearTimeout(v.positionPreviewTimeout);
				$('#<%= $miss %>_position_preview').css({ 'position': 'fixed', 'left': left, 'top': top, opacity: 3 });
				$('#<%= $miss %>_position_preview_info').css({ 'position': 'fixed', 'height': '23px', 'background-color':'black', 'color': 'yellow', 'left': left, 'top': (top - 20), opacity: 3 });
				if (vid.attr('type') == 'video') {
					var time = (v.duration * (x / width));
					$('#<%= $miss %>_position_preview_info').text(numeral(time).format('00:00:00')).show();
					var instant = false;
<% if ($source eq 'music') { %>
					instant = <%= $miss %>SeekPreviewShow(time);
<% } %>
					if (instant) { return; }
					// A whole-second bucket: the server runs ffmpeg for every position it
					// has not been asked for, so moving the pointer a pixel must reuse the
					// frame the browser already holds. The first hover asks at once - the
					// old 100ms wait made every hover feel late - and the 120ms trailing
					// call catches the bucket the pointer comes to rest on while a sweep
					// across a long film cannot spawn a frame per pixel.
					var bucket = Math.max(0, Math.round(time));
					var previewKey = v.src + '#' + bucket;
					var paintPreview = function() {
						if (v.lastPositionPreviewKey !== previewKey) {
							v.lastPositionPreviewKey = previewKey;
							$('#<%= $miss %>_position_preview').attr('src', v.src + '&thumb=ya&position=' + bucket);
						}
						$('#<%= $miss %>_position_preview').show();
					};
					var now = Date.now();
					if (v.lastPositionPreviewKey === previewKey) {
						paintPreview();
					}
					else if (now - v.lastPositionPreview >= 120) {
						v.lastPositionPreview = now;
						paintPreview();
					}
					v.positionPreviewTimeout = setTimeout(paintPreview, 120);
				}
			});
			vidOn('mouseout', '#<%= $miss %>_position', function(e) {
				clearInterval(v.positionPreviewTimeout);
<% if ($source eq 'music') { %>
				var sp = <%= $miss %>SeekPreview;
				if (sp.raf) { cancelAnimationFrame(sp.raf); sp.raf = 0; }
				if (sp.timer) { clearTimeout(sp.timer); sp.timer = 0; }
				sp.visible = false;
				// A paused hidden video keeps a Pulse stream open on WebKit. Pause it
				// at once and unload it if the pointer does not come back: a hovered
				// preview is not worth a playback stream that looks like the player.
				if (sp.video) { try { sp.video.pause(); } catch (e) {} }
				clearTimeout(sp.hideTimer);
				sp.hideTimer = setTimeout(function() {
					if (sp.visible || !sp.video) { return; }
					try { sp.video.removeAttribute('src'); sp.video.load(); sp.video.remove(); } catch (e) {}
					sp.video = null; sp.src = ''; sp.ready = false; sp.drawn = false;
				}, 10000);
<% } %>
				$('#<%= $miss %>_position_preview').hide();
				$('#<%= $miss %>_position_preview_info').hide();
			});
			<% if ( $id eq 'video' ) { %>

			<% } %>
		}
		else {
			<%= $miss %>VideoInterval();
		}
	</script>
</div>















