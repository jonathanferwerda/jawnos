<%
	# The Help window's contents. Two regions share the top: the browse shell
	# (rail + topic) and the chat log. Asking a question swaps to the chat; the
	# composer along the foot is always the same box.
	my $raw = $topic // '';
	my $shown = &help::get($raw);
	my $search = $search // '';
	my $results = length $search ? [ &help::search($search) ] : undef;
	my $catalogue = [ &help::catalogue() ];
	my $selected_model = $selected_model // '';
	my %category_label = ( apps => 'Apps', features => 'Features', functions => 'Functions', devices => 'Devices' );
	my %category_icon = (
		apps => '/images/decipherable/folder.png',
		features => '/images/decipherable/gear.png',
		functions => '/images/decipherable/measures.png',
		devices => '/images/decipherable/microchip.png'
	);
	my @category_order = qw/apps features functions devices/;
	my $default_question = $shown ? ('Show me ' . lc($shown->{'title'})) : '';
%>
<div class="help_window" style="display:flex;flex-direction:column;width:100%;height:100%;color:var(--ink);">
	<div class="help_main" style="flex:1;min-height:0;display:flex;width:100%;">
		<div class="help_shell" style="display:flex;flex:1;min-height:0;width:100%;">
			<div class="help_rail" style="width:38%;min-width:150px;max-width:330px;display:flex;flex-direction:column;height:100%;border-right:2px solid var(--line);box-sizing:border-box;">
				<input id="help_search" placeholder="Search help…" value="<%= $search %>"
					style="box-sizing:border-box;margin:8px 6px 6px 10px;padding:6px 8px;border-radius:6px;border:1px solid var(--line);background:var(--panel);color:var(--ink);font-size:14px;">
				<div class="help_rail_list" style="flex:1;overflow-y:auto;padding:0 6px 24px 10px;">
					<% if ($results) { %>
						<div class="help_group_label" style="font-weight:bold;font-size:12px;text-transform:uppercase;letter-spacing:.08em;opacity:.6;padding:4px 2px;">Results</div>
						<% if (!@{$results}) { %>
							<div style="opacity:.7;padding:6px 2px;">Nothing found for “<%= $search %>”.</div>
						<% } %>
						<% foreach my $r ( @{$results} ) { %>
							<span class="help_topic_link hover" topic="<%= $r->{'id'} %>" hint="<%= $r->{'summary'} %>"
								style="display:block;padding:5px 6px;border-radius:6px;cursor:pointer;<% if ($shown && $shown->{'title'} eq $r->{'title'}) { %>background:var(--line);<% } %>">
								<%= $r->{'title'} %>
								<span style="display:block;font-size:11px;opacity:.65;line-height:1.25;"><%= $r->{'summary'} %></span>
							</span>
						<% } %>
					<% } else { %>
						<% foreach my $cat ( @category_order ) { %>
							<% my @items = grep { $_->{'category'} eq $cat } @{$catalogue}; %>
							<% next unless @items; %>
							<div class="help_group_label" style="display:flex;align-items:center;gap:6px;font-weight:bold;font-size:12px;text-transform:uppercase;letter-spacing:.08em;opacity:.6;padding:8px 2px 3px;">
								<img class="little_thumb" style="width:16px;height:16px;" src="<%= &subs::icon_for($category_icon{$cat}) %>">
								<%= $category_label{$cat} %>
							</div>
							<% foreach my $r ( @items ) { %>
								<span class="help_topic_link hover" topic="<%= $r->{'id'} %>" hint="<%= $r->{'summary'} %>"
									style="display:block;padding:5px 6px;border-radius:6px;cursor:pointer;<% if ($shown && $shown->{'title'} eq $r->{'title'}) { %>background:var(--line);<% } %>">
									<%= $r->{'title'} %>
								</span>
							<% } %>
						<% } %>
					<% } %>
				</div>
			</div>
			<div class="help_body" style="flex:1;min-height:0;overflow-y:auto;padding:14px 20px 40px;box-sizing:border-box;">
				<% if ($shown) { %>
					<h2 style="margin:4px 0 2px;font-size:24px;"><%= $shown->{'title'} %></h2>
					<div style="opacity:.7;font-style:italic;margin-bottom:12px;"><%= $shown->{'summary'} %></div>
					<% foreach my $para ( @{ $shown->{'body'} } ) { %>
						<p style="line-height:1.5;margin:0 0 12px;"><%= $para %></p>
					<% } %>
					<% if (@{ $shown->{'steps'} || [] }) { %>
						<div style="margin:4px 0 14px;padding:10px 12px 4px;border:1px solid var(--line);border-radius:8px;">
							<div style="font-weight:bold;margin-bottom:6px;">Step by step</div>
							<ol style="margin:0 0 6px 18px;padding:0;line-height:1.5;">
								<% foreach my $step ( @{ $shown->{'steps'} } ) { %>
									<li style="margin-bottom:5px;"><%= $step %></li>
								<% } %>
							</ol>
						</div>
					<% } %>
					<% if ($shown->{'app'}) { %>
						<span class="help_open_app button hover" app="<%= $shown->{'app'} %>" hint="<%= &subs::ui('Open') %> <%= $shown->{'title'} %>"
							style="display:inline-block;margin:4px 8px 12px 0;padding:7px 14px;border-radius:8px;border:2px solid var(--line);cursor:pointer;font-weight:bold;">
							<%= &subs::ui('Open') %> <%= $shown->{'title'} %>
						</span>
					<% } %>
					<% if (@{ $shown->{'related'} || [] }) { %>
						<div style="margin-top:10px;padding-top:10px;border-top:1px solid var(--line);">
							<span style="opacity:.6;font-size:12px;text-transform:uppercase;letter-spacing:.08em;">See also</span><br>
							<% foreach my $rid ( @{ $shown->{'related'} } ) { %>
								<% my $rel = &help::get($rid); next unless $rel; %>
								<span class="help_topic_link hover" topic="<%= &help::key($rid) %>" hint="<%= $rel->{'summary'} %>"
									style="display:inline-block;margin:6px 8px 0 0;padding:4px 10px;border-radius:14px;border:1px solid var(--line);cursor:pointer;">
									<%= $rel->{'title'} %>
								</span>
							<% } %>
						</div>
					<% } %>
				<% } else { %>
					<h2 style="margin:4px 0 2px;font-size:24px;">Help</h2>
					<p style="line-height:1.5;margin:0 0 12px;">
						Pick a topic on the left, or search for one. Press <b>F1</b> to read about whatever window you are
						focused on, and hover (or long-press) any control for a short hint — the question-mark button in a
						window's title bar opens the topic for that window.
					</p>
					<p style="line-height:1.5;margin:0 0 12px;opacity:.8;">
						Everything is grouped into <b>apps</b> (things you open), <b>features</b> (parts of the desktop
						itself), <b>functions</b> (cross-cutting mechanics) and <b>devices</b> (the watch, deck and Pico).
						Ask the guide below and it will do the thing for you, not just describe it.
					</p>
				<% } %>
			</div>
		</div>
		<div class="help_chat_log" style="display:none;flex:1;min-height:0;overflow-y:auto;padding:12px 14px 24px;box-sizing:border-box;"></div>
	</div>
	<div class="help_agent" style="border-top:2px solid var(--line);padding:8px 12px 10px;box-sizing:border-box;flex:0 0 auto;background:var(--panel);">
		<div class="help_agent_row" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
			<span style="font-weight:bold;font-size:13px;opacity:.8;">Guide</span>
			<select id="help_model" class="help_model_select" value="<%= $selected_model %>"
				style="max-width:210px;padding:3px 6px;border-radius:6px;border:1px solid var(--line);background:var(--panel);color:var(--ink);font-size:13px;">
				<option value="">Choose a model…</option>
				<% if ($models) { foreach my $cm ( @{$models} ) { my $mid = $cm->{'model'} || $cm->{'name'}; next unless $mid; %>
					<option value="<%= $mid %>" <% if ($selected_model eq $mid) { %>selected<% } %>><%= $cm->{'name'} || $mid %></option>
				<% } } %>
			</select>
			<label style="display:flex;align-items:center;gap:4px;font-size:12px;opacity:.8;cursor:pointer;" hint="Switch the composer to the Coding agent, which edits and ships the JawnOS code"><input type="checkbox" id="help_coding"> Coding</label>
			<span id="help_context" style="font-size:12px;opacity:.7;"></span>
			<button id="help_topics_back" class="button" hint="Back to the topics" style="display:none;margin-left:auto;padding:4px 12px;border-radius:8px;border:2px solid var(--line);cursor:pointer;">Topics</button>
		</div>
		<div class="help_agent_row" style="display:flex;gap:8px;align-items:flex-end;margin-top:6px;">
			<textarea id="help_question" rows="1" placeholder="Ask the guide — or tell it what you want to do…" data-default="<%= $default_question %>"
				style="flex:1;box-sizing:border-box;height:36px;min-height:36px;max-height:36px;overflow-y:auto;resize:none;border-radius:8px;border:1px solid var(--line);background:var(--panel);color:var(--ink);padding:7px 9px;font-size:13px;font-family:inherit;"></textarea>
			<button id="help_ask" class="button" hint="Ask, or ask it to do it" style="padding:8px 14px;border-radius:8px;border:2px solid var(--line);cursor:pointer;font-weight:bold;white-space:nowrap;">Guide me</button>
			<button id="help_converse" class="button" hint="Start a spoken conversation: the mic opens again after each answer, so you can just keep talking — press End when you are done, or say “bye jawn”" style="padding:8px 12px;border-radius:8px;border:2px solid var(--line);cursor:pointer;white-space:nowrap;">Converse</button>
		</div>
	</div>
</div>
