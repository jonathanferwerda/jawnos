<%
	my $q = $c->param('q') || '';
%>
<style>
#search_app { display:flex; flex-direction:column; width:100%; height:100%; min-height:0; background:var(--panel); position:relative; }
#search_app_tabs { display:flex; gap:6px; padding:8px 10px; border-bottom:1px solid var(--line); flex:0 0 auto; align-items:center; }
#search_app .search_app_tab { font-size:13px; line-height:1; padding:8px 14px; border:1px solid var(--line); border-radius:8px; background:var(--panel-2); color:inherit; cursor:pointer; }
#search_app .search_app_tab.selected { background:var(--ink, #333); color:var(--panel); border-color:var(--ink, #333); }
#search_app .search_app_gear { margin-left:auto; font-size:17px; line-height:1; padding:7px 10px; border:1px solid var(--line); border-radius:8px; background:var(--panel-2); color:inherit; cursor:pointer; }
#search_app.settings_open .search_app_gear { background:var(--ink, #333); color:var(--panel); border-color:var(--ink, #333); }
#search_app_bar { display:flex; gap:6px; padding:10px; flex:0 0 auto; }
#search_app_input { flex:1 1 auto; min-width:0; box-sizing:border-box; padding:9px 11px; font-size:15px; border:1px solid var(--line); border-radius:8px; background:var(--panel); color:inherit; outline:none; }
#search_app_input:focus { border-color:var(--ink-muted, #888); }
#search_app_body { display:flex; flex:1 1 auto; min-height:0; position:relative; }
#search_app_results { flex:1 1 auto; min-height:0; overflow:auto; padding:0 10px 14px; }
#search_app .search_app_row { display:flex; align-items:center; gap:10px; padding:9px 8px; border-radius:8px; cursor:pointer; text-decoration:none; color:inherit; }
#search_app .search_app_row:hover { background:var(--panel-2); }
#search_app .search_app_icon { width:32px; height:32px; flex:0 0 32px; object-fit:contain; }
#search_app .search_app_text { min-width:0; }
#search_app .search_app_title { font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
#search_app .search_app_url { font-size:11px; color:var(--ink-muted, #888); word-break:break-all; }
#search_app .search_app_snippet { font-size:12px; color:var(--ink-muted, #888); margin-top:2px; }
#search_app .search_app_engine { margin:14px 0 4px; font-size:11px; letter-spacing:0.06em; text-transform:uppercase; color:var(--ink-muted, #888); }
#search_app .search_app_answer { white-space:pre-wrap; line-height:1.55; padding:8px; }
#search_app .search_app_note { padding:16px 8px; color:var(--ink-muted, #888); }
#search_app .search_app_note button { margin-left:6px; }
/* The engine settings ride on the right, over the results, so the window keeps
   its tabs and one row of controls whatever size the screen is. */
#search_app_sidebar { display:none; position:absolute; top:0; right:0; bottom:0; width:min(340px, 92%); z-index:30; flex-direction:column; background:var(--panel); border-left:1px solid var(--line); box-shadow:-8px 0 24px rgba(0,0,0,.18); }
#search_app.settings_open #search_app_sidebar { display:flex; }
#search_app .search_app_sidebar_head { display:flex; align-items:center; gap:6px; padding:10px; border-bottom:1px solid var(--line); font-size:13px; font-weight:600; }
#search_app .search_app_sidebar_head .search_app_refresh { margin-left:auto; font-size:11px; padding:5px 8px; }
#search_app #search_app_engine_filter { margin:8px 10px; box-sizing:border-box; padding:8px 10px; font-size:13px; border:1px solid var(--line); border-radius:8px; background:var(--panel-2); color:inherit; }
#search_app #search_app_engine_list { flex:1 1 auto; min-height:0; overflow:auto; padding:0 6px 10px; }
#search_app .search_app_engine_row { display:flex; align-items:center; gap:8px; padding:7px 8px; border-radius:7px; }
#search_app .search_app_engine_row:hover { background:var(--panel-2); }
#search_app .search_app_engine_row.on { font-weight:600; }
#search_app .search_app_engine_row input { flex:0 0 auto; }
#search_app .search_app_engine_name { flex:1 1 auto; min-width:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
#search_app .search_app_engine_group { font-size:10px; letter-spacing:0.04em; text-transform:uppercase; color:var(--ink-muted, #888); }
#search_app .search_app_engine_remove { flex:0 0 auto; padding:2px 6px; cursor:pointer; opacity:.7; }
#search_app .search_app_engine_remove:hover { opacity:1; }
</style>
<div id="search_app">
	<div id="search_app_tabs">
		<button type="button" class="search_app_tab" data-tab="apps"><%= &subs::lang('search.apps') %></button>
		<button type="button" class="search_app_tab" data-tab="web"><%= &subs::lang('search.web') %></button>
		<button type="button" class="search_app_tab" data-tab="ai"><%= &subs::lang('search.ai') %></button>
		<button type="button" id="search_app_gear" class="search_app_gear" hint="<%= &subs::ui('Search engines') %>">&#9881;</button>
	</div>
	<div id="search_app_bar">
		<input id="search_app_input" type="search" autocomplete="off" spellcheck="false"
			placeholder="<%= &subs::lang('common.search') %>" value="<%= &subs::html_text($q) %>">
	</div>
	<div id="search_app_body">
		<div id="search_app_results"></div>
		<div id="search_app_sidebar">
			<div class="search_app_sidebar_head">
				<span><%= &subs::lang('search.engines') %></span>
				<button type="button" id="search_app_engines_refresh" class="search_app_refresh"><%= &subs::lang('search.refresh') %></button>
			</div>
			<input id="search_app_engine_filter" type="search" autocomplete="off"
				placeholder="<%= &subs::lang('search.find_engine') %>">
			<div id="search_app_engine_list"></div>
		</div>
	</div>
</div>
