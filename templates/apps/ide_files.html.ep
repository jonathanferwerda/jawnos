<% no warnings 'uninitialized'; %>

<%# One level of the IDE's file tree: the root's children on first open, and a
    folder's children when it unfolds (rendered by /manager/ide/folder_open).
    Every row carries the same file/location/root_count the client keys on, so
    indentation and lazy insertion read the same whether the row came from the
    page or from an unfold. %>
<% foreach my $f ( sort { lc $a->{'file'} cmp lc $b->{'file'} } @{$files}) { %>
	<div class="hover ide_file" type="<%= $f->{'type'} %>" status="closed" location="<%= $f->{'location'} %>" file="<%= $f->{'file'} %>">
		<% if ($f->{'type'} eq 'folder') { %>
			<%== '&nbsp;&nbsp;' x $f->{'root_count'} %><b style="width:70%;"><img src="<%= &subs::icon_for('/images/decipherable/folder.png') %>" hint="Folders" class="tiny_thumb"><%= $f->{'short_name'} %></b>
		<% } else { %>
			<%== '&nbsp;&nbsp;' x $f->{'root_count'} %><span style="width:70%;" ><img src="<%= &subs::icon_for('/images/decipherable/file.png') %>" hint="New file" class="tiny_thumb"> <%= $f->{'short_name'} %></span>
		<% } %>
		<img src="<%= &subs::icon_for('/icons/trash.png') %>" hint="Delete" class="tiny_thumb ide_file_delete hover" style="float:right;" type="<%= $f->{'type'} %>" file="<%= $f->{'file'} %>">
	</div>
<% } %>
