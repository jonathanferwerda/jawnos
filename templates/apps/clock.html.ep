<% my $now = &subs::rightNow(); %>
<% my $running_timers = scalar grep { ($_->{'state'} || '') eq 'running' } @{$timers}; %>
<% my $fmt_seconds = sub {
	my $s = shift || 0;
	$s = int($s);
	my $h = int($s / 3600);
	my $m = int(($s % 3600) / 60);
	my $sec = $s % 60;
	return $h > 0 ? sprintf('%02d:%02d:%02d', $h, $m, $sec) : sprintf('%02d:%02d', $m, $sec);
}; %>
<%= include 'apps/clock/style' %>
<%= include 'apps/clock/body', fmt_seconds => $fmt_seconds, now => $now, running_timers => $running_timers %>
