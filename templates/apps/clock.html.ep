<% my $now = &subs::rightNow(); %>
<% my @day_letters = qw/S M T W T F S/; %>
<% my $running_timers = scalar grep { ($_->{'state'} || '') eq 'running' } @{$timers}; %>
<% my $fmt_seconds = sub {
	my $s = shift || 0;
	$s = int($s);
	my $h = int($s / 3600);
	my $m = int(($s % 3600) / 60);
	my $sec = $s % 60;
	return $h > 0 ? sprintf('%02d:%02d:%02d', $h, $m, $sec) : sprintf('%02d:%02d', $m, $sec);
}; %>
<style>
	.clock_app { display:flex; flex-direction:column; width:100%; height:100%; min-width:0; overflow:hidden; color:var(--ink); }
	.clock_tabbar { display:flex; align-items:stretch; gap:3px; padding:7px 8px 0; border-bottom:1px solid var(--line); flex:0 0 auto; }
	.clock_tab { display:flex; align-items:center; gap:5px; flex:1 1 0; min-width:0; justify-content:center;
		padding:7px 4px; border:1px solid transparent; border-bottom:none; border-radius:calc(var(--jawnos-corner, 12px) * .55) calc(var(--jawnos-corner, 12px) * .55) 0 0;
		background:transparent; color:inherit; font:inherit; font-size:12px; cursor:pointer; opacity:.72; }
	.clock_tab img { width:19px; height:19px; object-fit:contain; }
	.clock_tab:hover { opacity:1; background:var(--panel); }
	.clock_tab.selected { opacity:1; border-color:var(--line); background:var(--panel); font-weight:700; }
	.clock_panels { flex:1 1 auto; min-height:0; overflow-y:auto; }
	.clock_panel { display:none; padding:10px 12px 18px; }
	.clock_panel.selected { display:block; }
	.clock_panel_head { display:flex; align-items:center; gap:8px; margin:2px 0 10px; }
	.clock_count { opacity:.65; font-size:12px; }
	.clock_panel_head .clock_add, .clock_panel_head .clock_clear_finished { margin-left:auto; }
	.clock_add, .clock_clear_finished, .clock_save { font:inherit; font-size:12px; padding:5px 10px; cursor:pointer;
		border:1px solid var(--line); border-radius:calc(var(--jawnos-corner, 12px) * .45); background:var(--panel); color:inherit; }
	.clock_add:hover, .clock_clear_finished:hover { background:var(--line); }
	.clock_add[disabled] { opacity:.4; cursor:default; }
	.clock_empty { opacity:.6; font-size:13px; padding:14px 4px; text-align:center; }
	.clock_alarm { border:1px solid var(--line); border-radius:calc(var(--jawnos-corner, 12px) * .55); padding:0; margin-bottom:9px; background:var(--panel); overflow:hidden; }
	.clock_alarm.off { opacity:.58; }
	.clock_alarm_head { display:flex; align-items:center; gap:8px; min-width:0; padding:8px 10px; cursor:pointer; }
	.clock_alarm_head:hover { background:var(--line); }
	.clock_alarm_caret { flex:0 0 auto; width:14px; height:14px; padding:0; border:none; background:transparent; color:inherit; cursor:pointer; font-size:0; line-height:0; }
	.clock_alarm_caret::before { content:''; display:block; width:0; height:0; margin:0 auto; border-left:5px solid currentColor; border-top:4px solid transparent; border-bottom:4px solid transparent; transition:transform .15s; }
	.clock_alarm.open .clock_alarm_caret::before { transform:rotate(90deg); }
	.clock_alarm_head_time { flex:0 0 auto; font-size:19px; font-variant-numeric:tabular-nums; font-weight:600; }
	.clock_alarm_head_label { flex:1 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
	.clock_alarm_head_devices { display:flex; gap:3px; flex-wrap:wrap; justify-content:flex-end; flex:0 1 auto; max-width:42%; }
	.clock_machine_pill { font-size:10px; line-height:1.4; padding:1px 7px; border:1px solid var(--line); border-radius:999px; opacity:.85; white-space:nowrap; }
	.clock_alarm_body { display:none; padding:0 10px 10px; }
	.clock_alarm.open .clock_alarm_body { display:block; }
	.clock_alarm_line { display:flex; align-items:center; gap:7px; }
	.clock_alarm_time { font:inherit; font-size:25px; font-variant-numeric:tabular-nums; flex:0 0 auto; width:11ch; min-width:132px; padding:1px 4px;
		border:1px solid transparent; border-radius:6px; background:transparent; color:inherit; }
	.clock_alarm_time:hover, .clock_alarm_time:focus { border-color:var(--line); }
	.clock_alarm_label { flex:1 1 0; min-width:0; font:inherit; font-size:14px; padding:5px 7px; color:inherit;
		border:1px solid transparent; border-radius:6px; background:transparent; }
	.clock_alarm_label:hover, .clock_alarm_label:focus { border-color:var(--line); }
	.clock_switch { position:relative; display:inline-flex; width:38px; height:21px; flex:0 0 auto; cursor:pointer; }
	.clock_switch input { position:absolute; opacity:0; width:100%; height:100%; margin:0; cursor:pointer; }
	.clock_switch::before { content:''; position:absolute; inset:0; border-radius:999px; background:var(--line); transition:background .15s; }
	.clock_switch::after { content:''; position:absolute; top:3px; left:3px; width:15px; height:15px; border-radius:50%;
		background:var(--panel); transition:transform .15s; }
	.clock_switch:has(input:checked)::before { background-color:#2f8f6d; }
	.clock_switch:has(input:checked)::after { transform:translateX(17px); }
	.clock_alarm_delete { flex:0 0 auto; width:24px; height:24px; border:none; border-radius:50%; cursor:pointer;
		background:transparent; color:inherit; opacity:.5; font-size:15px; line-height:1; }
	.clock_alarm_delete:hover { opacity:1; background:var(--line); }
	.clock_alarm_days { display:flex; align-items:center; gap:3px; margin:7px 0 2px; flex-wrap:wrap; }
	.clock_alarm_when { display:flex; align-items:center; gap:8px; margin-top:7px; }
	.clock_alarm_next { flex:1 1 auto; min-width:0; font-size:11px; opacity:.72; font-variant-numeric:tabular-nums; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
	.clock_alarm_skip { flex:0 0 auto; font:inherit; font-size:11px; padding:3px 9px; cursor:pointer; color:inherit; border:1px solid var(--line); border-radius:999px; background:transparent; }
	.clock_alarm_skip:hover { background:var(--line); }
	.clock_day { font:inherit; font-size:11px; line-height:1; width:24px; height:24px; padding:0; cursor:pointer;
		border:1px solid var(--line); border-radius:50%; background:transparent; color:inherit; opacity:.72; }
	.clock_day.on { background-color:#2f8f6d; color:#fff; border-color:transparent; opacity:1; font-weight:700; }
	.clock_day_once { width:auto; padding:0 8px; border-radius:999px; margin-left:3px; }
	.clock_day_once.on { background-color:#2f8f6d; color:#fff; }
	.clock_alarm_extra { display:grid; grid-template-columns:1fr 1fr; gap:5px 9px; margin-top:6px; font-size:11px; }
	.clock_field { display:flex; flex-direction:column; gap:2px; min-width:0; }
	.clock_field > span { opacity:.65; }
	.clock_field input, .clock_field select { font:inherit; font-size:12px; width:100%; min-width:0; padding:3px 5px; color:inherit;
		border:1px solid var(--line); border-radius:5px; background:var(--window, var(--panel)); }
	.clock_field input[type=range] { padding:0; accent-color:#2f8f6d; }
	.clock_sound_row { display:flex; align-items:center; gap:4px; min-width:0; }
	.clock_sound_row select { flex:1 1 auto; width:auto; min-width:0; }
	.clock_nfc_row { display:flex; align-items:center; gap:5px; min-width:0; }
	.clock_nfc_row input[type=checkbox] { flex:0 0 auto; width:auto; padding:0; accent-color:#2f8f6d; }
	.clock_nfc_row select { flex:1 1 auto; width:auto; min-width:0; }
	.clock_nfc_hint { font-size:10px; opacity:.6; line-height:1.25; }
	.clock_alarm_preview { flex:0 0 auto; font:inherit; font-size:11px; padding:3px 8px; cursor:pointer; color:inherit;
		border:1px solid var(--line); border-radius:5px; background:var(--panel); }
	.clock_alarm_preview:hover { background:var(--line); }
	.clock_alarm_preview[data-playing=yes] { background-color:#2f8f6d; color:#fff; border-color:transparent; }
	.clock_timer_new { display:grid; grid-template-columns:repeat(3, 1fr); gap:6px; border:1px solid var(--line); border-radius:calc(var(--jawnos-corner, 12px) * .55); padding:9px; margin-bottom:10px; background:var(--panel); }
	.clock_timer_new .clock_timer_label, .clock_timer_new .clock_timer_app, .clock_timer_new .clock_app_picker { grid-column:1 / -1; }
	.clock_timer_new .clock_add_timer { grid-column:1 / -1; }
	.clock_timer_new input, .clock_timer_new button { font:inherit; font-size:13px; min-width:0; padding:6px 8px; color:inherit;
		border:1px solid var(--line); border-radius:6px; background:var(--window, var(--panel)); }
	.clock_presets { display:flex; gap:5px; flex-wrap:wrap; margin:-2px 0 10px; }
	.clock_preset { font:inherit; font-size:11px; padding:4px 8px; cursor:pointer; color:inherit; border:1px solid var(--line); border-radius:999px; background:transparent; }
	.clock_preset:hover { background:var(--line); }
	.clock_timer { border:1px solid var(--line); border-radius:calc(var(--jawnos-corner, 12px) * .55); padding:9px 10px; margin-bottom:8px; background:var(--panel); }
	.clock_timer.state_done { opacity:.6; }
	.clock_timer.state_cancelled { opacity:.45; text-decoration:line-through; }
	.clock_timer_top { display:flex; align-items:baseline; gap:9px; }
	.clock_timer_countdown { font-size:25px; font-variant-numeric:tabular-nums; font-weight:600; min-width:7.5ch; }
	.clock_timer_label_text { flex:1 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
	.clock_timer_app_text { display:block; font-size:11px; opacity:.65; margin-top:2px; }
	.clock_timer_action { font:inherit; font-size:11px; padding:4px 9px; cursor:pointer; color:inherit; border:1px solid var(--line); border-radius:6px; background:transparent; }
	.clock_timer_action:hover { background:var(--line); }
	.clock_timer_buttons { display:flex; flex-direction:column; gap:4px; flex:0 0 auto; }
	.clock_alarm_machines { display:flex; flex-direction:column; gap:2px; min-width:0; }
	.clock_alarm_extra .clock_alarm_machines { grid-column:1 / -1; }
	.clock_machine_list { display:flex; flex-wrap:wrap; gap:4px; }
	.clock_machine { font:inherit; font-size:11px; padding:3px 8px; cursor:pointer; color:inherit; border:1px solid var(--line); border-radius:999px; background:transparent; opacity:.75; }
	.clock_machine.on { background-color:#2f8f6d; color:#fff; border-color:transparent; opacity:1; font-weight:700; }
	.clock_app_picker { position:relative; display:flex; align-items:center; gap:3px; }
	.clock_app_picker input { flex:1 1 auto; }
	.clock_app_toggle { flex:0 0 auto; font:inherit; font-size:11px; line-height:1; width:22px; height:22px; padding:0; cursor:pointer; color:inherit; border:1px solid var(--line); border-radius:5px; background:var(--panel); }
	#clock_app_menu { position:fixed; z-index:40000; display:none; max-height:280px; overflow-y:auto; min-width:220px; padding:4px;
		border:1px solid var(--line); border-radius:calc(var(--jawnos-corner, 12px) * .45); background:var(--window, var(--panel)); box-shadow:0 8px 24px rgba(0,0,0,.28); }
	#clock_app_menu.open { display:block; }
	.clock_app_choice { display:flex; align-items:center; gap:7px; width:100%; font:inherit; font-size:12px; text-align:left; padding:4px 7px; cursor:pointer; color:inherit; border:none; border-radius:5px; background:transparent; }
	.clock_app_choice:hover, .clock_app_choice.selected { background:var(--line); }
	.clock_app_choice img, .clock_app_choice .window_icon { width:20px; height:20px; flex:0 0 auto; object-fit:contain; }
	.clock_app_choice .window_icon { display:inline-block !important; font-size:9px; overflow:hidden; text-align:center; }
	.clock_app_choice span { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
	.clock_stopwatch { text-align:center; padding-top:18px; }
	.clock_sw_display { font-size:44px; font-variant-numeric:tabular-nums; font-weight:600; letter-spacing:.5px; padding:14px 0; }
	.clock_sw_buttons { display:flex; gap:8px; justify-content:center; flex-wrap:wrap; }
	.clock_sw_buttons button { font:inherit; font-size:13px; padding:8px 18px; cursor:pointer; color:inherit;
		border:1px solid var(--line); border-radius:calc(var(--jawnos-corner, 12px) * .55); background:var(--panel); }
	.clock_sw_buttons button:hover { background:var(--line); }
	.clock_sw_laps { max-width:360px; margin:16px auto 0; text-align:left; font-size:12px; }
	.clock_sw_lap_row { display:flex; justify-content:space-between; gap:10px; padding:5px 6px; border-bottom:1px solid var(--line); }
	.clock_sw_lap_row span:last-child { font-variant-numeric:tabular-nums; opacity:.8; }
	.clock_world_add { display:flex; gap:6px; margin-bottom:12px; }
	.clock_world_add input { flex:1 1 auto; min-width:0; font:inherit; font-size:13px; padding:7px 9px; color:inherit;
		border:1px solid var(--line); border-radius:6px; background:var(--window, var(--panel)); }
	.clock_world_add button { font:inherit; font-size:13px; padding:7px 13px; cursor:pointer; color:inherit; border:1px solid var(--line); border-radius:6px; background:var(--panel); }
	.clock_world_row { display:flex; align-items:center; gap:10px; border:1px solid var(--line); border-radius:calc(var(--jawnos-corner, 12px) * .55); padding:10px; margin-bottom:8px; background:var(--panel); }
	.clock_world_name { flex:1 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
	.clock_world_name small { display:block; opacity:.6; font-size:11px; }
	.clock_world_time { font-size:24px; font-variant-numeric:tabular-nums; font-weight:600; }
	.clock_world_day { font-size:11px; opacity:.65; text-align:right; }
	.clock_world_delete { flex:0 0 auto; width:24px; height:24px; border:none; border-radius:50%; cursor:pointer; background:transparent; color:inherit; opacity:.5; }
	.clock_world_delete:hover { opacity:1; background:var(--line); }
	@media (max-width:520px) {
		.clock_tab span { display:none; }
		.clock_tab img { width:24px; height:24px; }
		.clock_alarm_extra { grid-template-columns:1fr; }
		.clock_sw_display { font-size:36px; }
	}
</style>

<div id="clock_app" class="clock_app" data-clock-tab="<%= $tab %>">
	<div class="clock_tabbar" role="tablist">
		<button type="button" class="clock_tab <%= $tab eq 'alarm' ? 'selected' : '' %>" data-clock-tab="alarm" role="tab" aria-selected="<%= $tab eq 'alarm' ? 'true' : 'false' %>">
			<img src="<%= &subs::icon_path('alarm', '/icons/alarm.svg') %>" alt=""><span><%= &subs::lang('alarm') %></span>
		</button>
		<button type="button" class="clock_tab <%= $tab eq 'stopwatch' ? 'selected' : '' %>" data-clock-tab="stopwatch" role="tab" aria-selected="<%= $tab eq 'stopwatch' ? 'true' : 'false' %>">
			<img src="<%= &subs::icon_path('stopwatch', '/icons/stopwatch.svg') %>" alt=""><span><%= &subs::lang('stopwatch') %></span>
		</button>
		<button type="button" class="clock_tab <%= $tab eq 'timer' ? 'selected' : '' %>" data-clock-tab="timer" role="tab" aria-selected="<%= $tab eq 'timer' ? 'true' : 'false' %>">
			<img src="<%= &subs::icon_path('timer', '/icons/timer.svg') %>" alt=""><span><%= &subs::lang('timer') %></span>
		</button>
		<button type="button" class="clock_tab <%= $tab eq 'world' ? 'selected' : '' %>" data-clock-tab="world" role="tab" aria-selected="<%= $tab eq 'world' ? 'true' : 'false' %>">
			<img src="<%= &subs::icon_path('world_clock', '/icons/world_clock.svg') %>" alt=""><span><%= &subs::lang('world_clock') %></span>
		</button>
	</div>

	<div class="clock_panels">
		<section class="clock_panel <%= $tab eq 'alarm' ? 'selected' : '' %>" data-clock-panel="alarm" role="tabpanel">
			<div class="clock_panel_head">
				<span class="clock_count"><%= scalar @{$alarms} %>/<%= $max %></span>
				<button type="button" class="clock_add clock_add_alarm"<%= scalar @{$alarms} >= $max ? ' disabled' : '' %>><%= &subs::lang('add_alarm') %></button>
			</div>
			<div class="clock_alarm_list">
				<% foreach my $alarm ( @{$alarms} ) { %>
					<% my $is_on = $alarm->{'enabled'} ? 1 : 0; %>
					<% my %on_machine = map { $_ => 1 } @{ $alarm->{'machines'} || [] }; %>
					<div class="clock_alarm<%= $is_on ? '' : ' off' %>" data-uuid="<%= $alarm->{'uuid'} %>" data-enabled="<%= $is_on %>">
						<div class="clock_alarm_head" role="button" tabindex="0" aria-expanded="false">
							<button type="button" class="clock_alarm_caret" tabindex="-1" aria-hidden="true"></button>
							<span class="clock_alarm_head_time"><%= sprintf('%02d:%02d', $alarm->{'hour'}, $alarm->{'minute'}) %></span>
							<span class="clock_alarm_head_label"><%= $alarm->{'label'} %></span>
							<span class="clock_alarm_head_devices">
								<% foreach my $m ( @{$machines} ) { %>
									<% next unless $on_machine{$m->{'value'}}; %>
									<% my $ack = $alarm->{'delivered'} ? $alarm->{'delivered'}{$m->{'value'}} : undef; %>
									<% my $ack_time = (defined $ack && $ack) ? sprintf('%02d:%02d', (localtime($ack / 1000))[2], (localtime($ack / 1000))[1]) : ''; %>
									<span class="clock_machine_pill<%= $ack_time ne '' ? ' confirmed' : '' %>" data-machine="<%= $m->{'value'} %>"<% if ($ack_time ne '') { %> title="<%= &subs::lang('delivered') %> <%= $ack_time %>"<% } %>><%= $m->{'label'} %><%= $ack_time ne '' ? ' ✓' : '' %></span>
								<% } %>
							</span>
							<label class="clock_switch" hint="<%= &subs::lang('alarm') %>"><input type="checkbox" class="clock_alarm_enabled"<%= $is_on ? ' checked' : '' %>></label>
						</div>
						<div class="clock_alarm_body">
						<div class="clock_alarm_line">
							<input type="text" inputmode="numeric" maxlength="5" autocomplete="off" pattern="[0-9:]*" placeholder="HH:MM" class="clock_alarm_time" value="<%= sprintf('%02d:%02d', $alarm->{'hour'}, $alarm->{'minute'}) %>" aria-label="<%= &subs::lang('alarm') %>">
							<input type="text" class="clock_alarm_label" value="<%= $alarm->{'label'} %>" maxlength="20" aria-label="<%= &subs::lang('label') %>">
						</div>
						<div class="clock_alarm_days" role="group" aria-label="<%= &subs::lang('days') %>">
							<% my $has_days = scalar @{ $alarm->{'days'} }; %>
							<% for my $d (0 .. 6) { %>
								<% my $on = grep { $_ == $d } @{ $alarm->{'days'} }; %>
								<button type="button" class="clock_day<%= $on ? ' on' : '' %>" data-day="<%= $d %>" aria-pressed="<%= $on ? 'true' : 'false' %>"><%= $day_letters[$d] %></button>
							<% } %>
							<button type="button" class="clock_day clock_day_once<%= $has_days ? '' : ' on' %>" data-once="yes" aria-pressed="<%= $has_days ? 'false' : 'true' %>"><%= &subs::lang('once') %></button>
						</div>
						<div class="clock_alarm_when">
							<span class="clock_alarm_next" data-next="<%= $alarm->{'next_at'} || 0 %>"></span>
							<button type="button" class="clock_alarm_skip" hint="<%= &subs::lang('skip_today') %>"><%= &subs::lang('skip_today') %></button>
							<button type="button" class="clock_alarm_delete" hint="<%= &subs::lang('delete') %>" aria-label="<%= &subs::lang('delete') %>">✕</button>
						</div>
						<div class="clock_alarm_extra">
							<label class="clock_field">
								<span><%= &subs::lang('link_appointment') %></span>
								<div class="clock_app_picker">
									<input type="text" class="clock_alarm_app" autocomplete="off" data-app="<%= $alarm->{'app'} %>" value="<%= $alarm->{'app'} ? &subs::format_name($alarm->{'app'}) : '' %>" placeholder="<%= &subs::lang('no_appointment') %>">
									<button type="button" class="clock_app_toggle" tabindex="-1" aria-label="<%= &subs::lang('link_appointment') %>">▾</button>
								</div>
							</label>
							<% my $alarm_play = ($alarm->{'play'} || '') eq 'math' ? 'math' : ''; %>
							<% my $alarm_nfc = $alarm->{'nfc'} ? 1 : 0; %>
							<% my $alarm_nfc_action = ($alarm->{'nfc_action'} || '') eq 'dismiss' ? 'dismiss' : 'snooze'; %>
							<% my $alarm_nfc_tag = ($nfc_apps && $alarm->{'app'} && $nfc_apps->{ $alarm->{'app'} }) ? 1 : 0; %>
							<label class="clock_field">
								<span><%= &subs::lang('play_mode') %></span>
								<select class="clock_alarm_play">
									<option value=""<%= $alarm_play eq 'math' ? '' : ' selected' %>><%= &subs::lang('none') %></option>
									<option value="math"<%= $alarm_play eq 'math' ? ' selected' : '' %>><%= &subs::lang('math') %></option>
								</select>
							</label>
							<label class="clock_field clock_alarm_nfc_field"<%== ($alarm_nfc_tag || $alarm_nfc) ? '' : ' style="display:none;"' %>>
								<span><%= &subs::lang('use_nfc_to_snooze') %></span>
								<div class="clock_nfc_row">
									<input type="checkbox" class="clock_alarm_nfc"<%= $alarm_nfc ? ' checked' : '' %><%= ($alarm_nfc_tag || $alarm_nfc) ? '' : ' disabled' %>>
									<select class="clock_alarm_nfc_action" aria-label="<%= &subs::lang('nfc_action') %>"<%== $alarm_nfc ? '' : ' style="display:none;"' %>>
										<option value="snooze"<%= $alarm_nfc_action eq 'dismiss' ? '' : ' selected' %>><%= &subs::lang('snooze') %></option>
										<option value="dismiss"<%= $alarm_nfc_action eq 'dismiss' ? ' selected' : '' %>><%= &subs::lang('dismiss') %></option>
									</select>
								</div>
								<span class="clock_nfc_hint"<%== $alarm_nfc_tag ? ' style="display:none;"' : '' %>><%= &subs::ui('Link an appointment with an NFC start tag to use this.') %></span>
							</label>
							<label class="clock_field clock_alarm_machines">
								<span><%= &subs::lang('shared_with') %></span>
								<div class="clock_machine_list" role="group" aria-label="<%= &subs::lang('shared_with') %>">
									<% foreach my $m ( @{$machines} ) { %>
										<% my $on = $on_machine{$m->{'value'}} ? 1 : 0; %>
										<button type="button" class="clock_machine<%= $on ? ' on' : '' %>" data-machine="<%= $m->{'value'} %>" aria-pressed="<%= $on ? 'true' : 'false' %>"><%= $m->{'label'} %></button>
									<% } %>
								</div>
							</label>
							<label class="clock_field">
								<span><%= &subs::lang('sound') %></span>
								<div class="clock_sound_row">
									<select class="clock_alarm_sound">
										<% foreach my $s ( @{$alarm_sounds} ) { %>
											<option value="<%= $s->{'value'} %>"<%= ($alarm->{'sound'} || '') eq $s->{'value'} ? ' selected' : '' %>><%= $s->{'label'} %></option>
										<% } %>
									</select>
									<button type="button" class="clock_alarm_preview" hint="<%= &subs::lang('preview') %>"><%= &subs::lang('preview') %></button>
								</div>
							</label>
							<label class="clock_field">
								<span><%= &subs::lang('volume') %> · <%= $alarm->{'volume'} %>%</span>
								<input type="range" min="5" max="100" step="5" class="clock_alarm_volume" inputmode="none" data-soft_keyboard="off" aria-label="<%= &subs::lang('volume') %>" value="<%= $alarm->{'volume'} %>">
							</label>
							<label class="clock_field">
								<span><%= &subs::lang('ramp') %> · <%= $alarm->{'ramp'} %>s</span>
								<input type="number" inputmode="numeric" min="0" max="600" step="5" class="clock_alarm_ramp" value="<%= $alarm->{'ramp'} %>">
							</label>
							<label class="clock_field">
								<span><%= &subs::lang('snooze_length') %></span>
								<input type="number" inputmode="numeric" min="1" max="60" step="1" class="clock_alarm_snooze" value="<%= $alarm->{'snooze'} || 5 %>" aria-label="<%= &subs::lang('snooze') %>">
							</label>
						</div>
						</div>
					</div>
				<% } %>
				<% if (!scalar @{$alarms}) { %>
					<div class="clock_empty"><%= &subs::ui('No alarms yet - add one and it will be waiting for you here.') %></div>
				<% } %>
			</div>
		</section>

		<section class="clock_panel <%= $tab eq 'stopwatch' ? 'selected' : '' %>" data-clock-panel="stopwatch" role="tabpanel">
			<div class="clock_stopwatch">
				<div class="clock_sw_display">00:00:00.00</div>
				<div class="clock_sw_buttons">
					<button type="button" class="clock_sw_start"><%= &subs::lang('start') %></button>
					<button type="button" class="clock_sw_lap"><%= &subs::lang('lap') %></button>
					<button type="button" class="clock_sw_reset"><%= &subs::lang('reset') %></button>
				</div>
				<div class="clock_sw_laps"></div>
			</div>
		</section>

		<section class="clock_panel <%= $tab eq 'timer' ? 'selected' : '' %>" data-clock-panel="timer" role="tabpanel">
			<div class="clock_panel_head">
				<span class="clock_count"><%= $running_timers %>/<%= $max %></span>
				<button type="button" class="clock_clear_finished"><%= &subs::lang('clear_finished') %></button>
			</div>
			<div class="clock_timer_new">
				<input type="number" inputmode="numeric" class="clock_timer_hours" min="0" max="99" step="1" placeholder="<%= &subs::lang('hours') %>" aria-label="<%= &subs::lang('hours') %>">
				<input type="number" inputmode="numeric" class="clock_timer_minutes" min="0" max="59" step="1" placeholder="<%= &subs::lang('minutes') %>" aria-label="<%= &subs::lang('minutes') %>">
				<input type="number" inputmode="numeric" class="clock_timer_seconds" min="0" max="59" step="1" placeholder="<%= &subs::lang('seconds') %>" aria-label="<%= &subs::lang('seconds') %>">
				<input type="text" class="clock_timer_label" maxlength="120" placeholder="<%= &subs::lang('label') %>" aria-label="<%= &subs::lang('label') %>">
				<div class="clock_app_picker">
					<input type="text" class="clock_timer_app" autocomplete="off" data-app="" placeholder="<%= &subs::lang('link_appointment') %>" aria-label="<%= &subs::lang('link_appointment') %>">
					<button type="button" class="clock_app_toggle" tabindex="-1" aria-label="<%= &subs::lang('link_appointment') %>">▾</button>
				</div>
				<button type="button" class="clock_add clock_add_timer"<%= $running_timers >= $max ? ' disabled' : '' %>><%= &subs::lang('add_timer') %></button>
			</div>
			<div class="clock_presets">
				<button type="button" class="clock_preset" data-preset="60"><%= &subs::ui('1 min') %></button>
				<button type="button" class="clock_preset" data-preset="300"><%= &subs::ui('5 min') %></button>
				<button type="button" class="clock_preset" data-preset="600"><%= &subs::ui('10 min') %></button>
				<button type="button" class="clock_preset" data-preset="900"><%= &subs::ui('15 min') %></button>
				<button type="button" class="clock_preset" data-preset="1500"><%= &subs::ui('25 min') %></button>
				<button type="button" class="clock_preset" data-preset="3600"><%= &subs::ui('1 hour') %></button>
			</div>
			<div class="clock_timer_list">
				<% foreach my $timer ( @{$timers} ) { %>
					<% my $state = $timer->{'state'} || 'running'; %>
					<% my $remaining = $state eq 'running' && $timer->{'ends_at'} > $now ? int(($timer->{'ends_at'} - $now) / 1000) : 0; %>
					<div class="clock_timer state_<%= $state %>" data-uuid="<%= $timer->{'uuid'} %>" data-state="<%= $state %>" data-ends="<%= $timer->{'ends_at'} %>">
						<div class="clock_timer_top">
							<span class="clock_timer_countdown"><%= $state eq 'running' ? $fmt_seconds->($remaining) : '00:00' %></span>
							<span class="clock_timer_label_text">
								<%= $timer->{'label'} %>
								<% if ($timer->{'app'}) { %><span class="clock_timer_app_text"><%= &subs::lang('link_appointment') %>: <%= &subs::format_name($timer->{'app'}) %></span><% } %>
							</span>
							<% if ($state eq 'running') { %>
								<button type="button" class="clock_timer_action clock_timer_stop" hint="<%= &subs::lang('stop') %>"><%= &subs::lang('stop') %></button>
							<% } else { %>
								<div class="clock_timer_buttons">
									<button type="button" class="clock_timer_action clock_timer_restore" hint="<%= &subs::lang('restore') %>"><%= &subs::lang('restore') %></button>
									<button type="button" class="clock_timer_action clock_timer_remove" hint="<%= &subs::lang('delete') %>"><%= &subs::lang('delete') %></button>
								</div>
							<% } %>
						</div>
						<% if ($state ne 'running') { %>
							<div class="clock_timer_app_text"><%= $state eq 'done' ? &subs::lang('done') : &subs::lang('cancelled') %></div>
						<% } %>
					</div>
				<% } %>
				<% if (!scalar @{$timers}) { %>
					<div class="clock_empty"><%= &subs::ui('No timers yet - add one above, or press a preset.') %></div>
				<% } %>
			</div>
		</section>

		<section class="clock_panel <%= $tab eq 'world' ? 'selected' : '' %>" data-clock-panel="world" role="tabpanel">
			<div class="clock_world">
				<div class="clock_world_add">
					<input type="text" list="clock_zones" class="clock_world_zone" placeholder="<%= &subs::ui('City or time zone') %>" aria-label="<%= &subs::ui('City or time zone') %>">
					<button type="button" class="clock_world_add_button"><%= &subs::lang('add') %></button>
				</div>
				<div class="clock_world_list"></div>
				<datalist id="clock_zones"></datalist>
			</div>
		</section>
	</div>

</div>
<div id="clock_app_menu" role="listbox" aria-label="<%= &subs::lang('link_appointment') %>"></div>
