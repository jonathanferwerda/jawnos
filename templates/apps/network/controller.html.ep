<%# The Controller, moved here from the keyboard's own panel so the sockets the
    page holds read beside the network that carries them. The three sockets that
    carry the page itself - Music, Server and Tab - stay at the top in that
    order; each row shows when it connected, the neighbours sharing it and the
    live detail the heartbeat paints (a tab's open windows, a peer's saved
    buttons, the track now playing and the Marker drawings). The Everything row
    is filled by the same heartbeat with every other socket this page holds, so
    an app that connects or closes appears and disappears without a reload. The
    music receiver strip and websocketStop are the same globals the keyboard
    panel used. %>
<%
    # The page's own sockets, by app. Only the three anchors are drawn from this
    # snapshot; every other app is added to Everything by the heartbeat.
    my %sock_for;
    foreach my $sock ( @{$websockets || []} ) {
        my $app = $sock->{'app'} || '';
        next unless $app eq 'music' || $app eq 'server' || $app eq 'tab';
        $sock_for{$app} ||= $sock;
    }
%>
<div class="network_table_wrap">
	<table class="network_table" id="websocket_list">
		<thead>
			<tr>
				<th><%= &subs::ui('App') %></th>
				<th><%= &subs::ui('Neighbours') %></th>
				<th><%= &subs::ui('Close') %></th>
			</tr>
		</thead>
		<tbody>
			<% foreach my $app ( qw/music server tab/ ) { %>
				<% my $sock = $sock_for{$app}; %>
				<tr class="network_socket_anchor" app="<%= $app %>">
					<td><%= $app %></td>
					<td>
						<% if ($sock) { %><%= &subs::formatted_time($sock->{'connected'}) %><% } else { %>&mdash;<% } %>
						<span class="neighbours" app="<%= $app %>"></span>
					</td>
					<td>
						<button type="button" class="network_button heartbeating" app="<%= $app %>" onClick="websocketStop('<%= $app %>');"><%= &subs::lang('stop') %></button>
					</td>
				</tr>
			<% } %>
			<tr>
				<td><%= &subs::ui('Everything') %></td>
				<td id="everything_socket"></td>
				<td></td>
			</tr>
		</tbody>
	</table>
</div>
<%= include 'keyboard_music' %>
<script>
	// The anchors are drawn when the tab is built. Ask for a beat once it is on
	// screen so the neighbour columns, the anchors' detail and the Everything
	// list are live at once instead of on the next scheduled beat.
	setTimeout(function() {
		if (typeof stayingAliveNow === 'function') { stayingAliveNow('server'); }
	}, 0);
</script>
