<%# The controller's home. A handheld panel is 480x854 and has no desk to lay
    windows on, so it opens on a launcher instead: eight tiles, each one press
    away from the surface it names. Leave is a panel of its own: the action asks
    subs::power_actions() what this machine can do, so the tile draws only the
    buttons that can succeed and never promises a press that does nothing. %>
<style>
	#controller_home { display:grid; grid-template-columns:1fr 1fr; grid-template-rows:repeat(4,1fr);
		gap:10px; width:100%; height:100%; min-height:0; padding:10px; box-sizing:border-box; }
	.controller_tile { display:flex; flex-direction:column; justify-content:center; gap:6px;
		min-width:0; overflow:hidden; padding:14px; border:1px solid var(--line); border-radius:14px;
		background:var(--panel); color:var(--ink); text-decoration:none; }
	.controller_tile:hover { border-color:var(--accent, #4a90d9); }
	.controller_tile_label { font-size:18px; font-weight:600; line-height:1.1; }
	.controller_tile_note { font-size:12px; line-height:1.3; opacity:.72; }
	.controller_tile_leave { border-style:dashed; }
	.controller_leave_actions { display:flex; flex-wrap:wrap; gap:4px; }
	.controller_leave_button { font:inherit; font-size:12px; line-height:1.2; padding:4px 8px;
		border:1px solid var(--line); border-radius:8px; background:transparent; color:var(--ink); cursor:pointer; }
	.controller_leave_button:hover { border-color:var(--accent, #4a90d9); }
	.controller_leave_button:disabled { opacity:.5; cursor:default; }
	.controller_leave_result { font-size:12px; line-height:1.3; opacity:.72; min-height:1em; }
</style>

<%
	my @power_available = ref $power_actions eq 'ARRAY' ? @{ $power_actions } : ();
	my %power_has = map { $_ => 1 } @power_available;
	my @power_order = qw(sleep screen_off restart shutdown logout);
	my %power_label = (
		sleep => 'Sleep',
		screen_off => 'Screen off',
		restart => 'Restart',
		shutdown => 'Shut down',
		logout => 'Log out',
	);
	my %power_ui = map { $_ => &subs::ui($power_label{$_}) } keys %power_label;
%>

<div id="controller_home">
	<a class="controller_tile" href="/manager/music">
		<span class="controller_tile_label"><%= &subs::ui('Music') %></span>
		<span class="controller_tile_note"><%= &subs::ui('Play the house music') %></span>
	</a>
	<a class="controller_tile" href="/manager/gallery">
		<span class="controller_tile_label"><%= &subs::ui('Gallery') %></span>
		<span class="controller_tile_note"><%= &subs::ui('Photos and videos') %></span>
	</a>
	<a class="controller_tile" href="/manager/notifications/list">
		<span class="controller_tile_label"><%= &subs::ui('Notifications') %></span>
		<span class="controller_tile_note"><%= &subs::ui('What the house has told you') %></span>
	</a>
	<a class="controller_tile" href="/manager/twirl">
		<span class="controller_tile_label"><%= &subs::ui('Games') %></span>
		<span class="controller_tile_note"><%= &subs::ui('Twirl, the falling-block puzzle') %></span>
	</a>
	<a class="controller_tile" href="/manager/configure">
		<span class="controller_tile_label"><%= &subs::ui('Configuration') %></span>
		<span class="controller_tile_note"><%= &subs::ui('Settings and system') %></span>
	</a>
	<a class="controller_tile" href="/manager/phone">
		<span class="controller_tile_label"><%= &subs::ui('IVR') %></span>
		<span class="controller_tile_note"><%= &subs::ui('The phone call menu and greeting') %></span>
	</a>
	<a class="controller_tile" href="/manager/embedded">
		<span class="controller_tile_label"><%= &subs::ui('Automation') %></span>
		<span class="controller_tile_note"><%= &subs::ui('Toggles for the house devices') %></span>
	</a>
	<div class="controller_tile controller_tile_leave">
		<span class="controller_tile_label"><%= &subs::ui('Leave') %></span>
% if (@power_available) {
		<div class="controller_leave_actions">
% for my $action (grep { $power_has{$_} } @power_order) {
			<button type="button" class="controller_leave_button" data-power-action="<%= $action %>"><%= &subs::ui($power_label{$action}) %></button>
% }
		</div>
		<span class="controller_leave_result" aria-live="polite"></span>
% } else {
		<span class="controller_tile_note"><%= &subs::ui('This machine cannot power itself.') %></span>
% }
	</div>
</div>

<script>
(function () {
	var tile = document.querySelector('.controller_tile_leave');
	if (!tile) { return; }
	var note = tile.querySelector('.controller_leave_result');
	var labels = <%== encode_json(\%power_ui) %>;
	var asked = <%== encode_json(&subs::ui('Asked to')) %>;
	var failed = <%== encode_json(&subs::ui('That did not work.')) %>;
	tile.addEventListener('click', function (event) {
		var button = event.target.closest('[data-power-action]');
		if (!button) { return; }
		var action = button.getAttribute('data-power-action');
		button.disabled = true;
		if (note) { note.textContent = asked + ': ' + (labels[action] || action); }
		fetch('/manager/power', {
			method: 'POST',
			credentials: 'same-origin',
			headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
			body: new URLSearchParams({ action: action, timestamp: Date.now() })
		}).then(function (response) {
			return response.json();
		}).then(function (result) {
			if (result && result.ok) { return; }
			if (note) { note.textContent = failed; }
			button.disabled = false;
		}).catch(function () {
			if (note) { note.textContent = failed; }
			button.disabled = false;
		});
	});
})();
</script>
