<% use Mojo::JSON qw(encode_json); %>
<%# The controller's home. A handheld panel is 480x854 and has no desk to lay
    windows on, so it opens on a launcher instead: eight tiles, each one press
    away from the surface it names. Leave is a panel of its own: the action asks
    subs::power_actions() what this machine can do, so the tile draws only the
    buttons that can succeed and never promises a press that does nothing. %>
<style>
	/* Four across, two down: the panel is 854x480, and a 2x4 grid was 606px
	   tall - the fourth row sat below the glass. */
	#controller_home { display:grid; grid-template-columns:repeat(4,1fr); grid-template-rows:repeat(2,1fr);
		gap:8px; width:100%; height:100%; min-height:0; padding:8px; box-sizing:border-box; overflow:hidden; }
	/* The launcher is the whole glass: the desk's window bar is furniture a
	   handheld does not need, and the Manager button is the only way out. */
	.wind[app="controller"] .top_navbar { display:none !important; }
	.controller_tile { display:flex; flex-direction:column; justify-content:center; gap:4px;
		min-width:0; overflow:hidden; padding:10px; border:1px solid var(--line); border-radius:12px;
		background:var(--panel); color:var(--ink); text-decoration:none; }
	.controller_tile:hover { border-color:var(--accent, #4a90d9); }
	.controller_tile_label { font-size:15px; font-weight:600; line-height:1.1; }
	.controller_tile_note { font-size:10px; line-height:1.25; opacity:.72; }
	/* The window frame's own icon is drawn at its natural size inside this page
	   (a 1112x1038 gear over the first row); the house's thumbnail rules are not
	   in scope here, so it is pinned. */
	img.window_icon { width:22px; height:22px; object-fit:contain; }
	/* The handheld's own look: dark grey panel, white words, and a picture
	   per tile from the house's decipherable set. Scoped to this page. */
	html, body, .wind, .window_contents { background:#2e2e2e !important; color:#f4f4f4 !important; }
	.controller_tile { background:#3a3a3a !important; border-color:#4a4a4a !important;
		color:#ffffff !important; align-items:center; text-align:center; }
	.controller_tile_label { color:#ffffff !important; }
	.controller_tile_note { color:#d8d8d8 !important; opacity:1; }
	.controller_tile_icon { width:46px; height:46px; object-fit:contain; }

	/* The launcher is the whole panel. The desk remembers a window's size and
	   place per app, and this page arrived at 480x640 from y=100 - two rows
	   below the glass. Scoped to this page, so no other window moves. */
	.wind { left:0 !important; top:0 !important; width:100vw !important; height:100vh !important; }
	.window_contents { width:100% !important; height:100% !important; }
	/* The launcher has no window bar: a slim row holds the one way out to the
	   desk, and the eight tiles take the rest of the glass. */
	#controller_shell { display:flex; flex-direction:column; width:100%; height:100%; min-height:0; }
	#controller_bar { flex:0 0 auto; display:flex; justify-content:flex-end; padding:6px 8px 0; }
	#controller_manager_button { font:inherit; font-size:13px; line-height:1.2; padding:5px 12px;
		border:1px solid #4a4a4a; border-radius:8px; background:#3a3a3a; color:#ffffff;
		text-decoration:none; }
	#controller_manager_button:hover { border-color:var(--accent, #4a90d9); }
	#controller_home { height:auto !important; flex:1 1 auto; min-height:0; }

	.controller_tile_leave { border-style:dashed; }
	.controller_leave_actions { display:flex; flex-wrap:wrap; gap:4px; }
	.controller_leave_button { font:inherit; font-size:12px; line-height:1.2; padding:4px 8px;
		border:1px solid var(--line); border-radius:8px; background:transparent; color:var(--ink); cursor:var(--jawnos-cursor-pointer, pointer); }
	.controller_leave_button:hover { border-color:var(--accent, #4a90d9); }
	.controller_leave_button:disabled { opacity:.5; cursor:var(--jawnos-cursor-default, default); }
	.controller_leave_result { font-size:12px; line-height:1.3; opacity:.72; min-height:1em; }
</style>

<%
	my @power_available = ref $power_actions eq 'ARRAY' ? @{ $power_actions } : ();
	my %power_has = map { $_ => 1 } @power_available;
	my @power_order = qw(sleep screen_off restart shutdown logout);
	my %power_label = (
		sleep => 'Sleep',
		screen_off => 'Screen off',
		restart => 'Restart',
		shutdown => 'Shut down',
		logout => 'Log out',
	);
	my %power_ui = map { $_ => &subs::ui($power_label{$_}) } keys %power_label;
%>

<div id="controller_shell">
	<div id="controller_bar">
		<a id="controller_manager_button" href="/manager?desk=1"><%= &subs::ui('Manager') %></a>
	</div>
	<div id="controller_home">
		<a class="controller_tile" href="/manager?open=music">
			<img class="controller_tile_icon" src="/images/decipherable/headphones.png" alt="">
			<span class="controller_tile_label"><%= &subs::ui('Music') %></span>
			<span class="controller_tile_note"><%= &subs::ui('Play the house music') %></span>
		</a>
		<a class="controller_tile" href="/manager?open=gallery">
			<img class="controller_tile_icon" src="/images/decipherable/gallery.png" alt="">
			<span class="controller_tile_label"><%= &subs::ui('Gallery') %></span>
			<span class="controller_tile_note"><%= &subs::ui('Photos and videos') %></span>
		</a>
		<a class="controller_tile" href="/manager/notifications/list">
			<img class="controller_tile_icon" src="/images/decipherable/bell.png" alt="">
			<span class="controller_tile_label"><%= &subs::ui('Notifications') %></span>
			<span class="controller_tile_note"><%= &subs::ui('What the house has told you') %></span>
		</a>
		<a class="controller_tile" href="/manager?open=twirl">
			<img class="controller_tile_icon" src="/images/decipherable/tetris.png" alt="">
			<span class="controller_tile_label"><%= &subs::ui('Games') %></span>
			<span class="controller_tile_note"><%= &subs::ui('Twirl, the falling-block puzzle') %></span>
		</a>
		<a class="controller_tile" href="/manager?open=configure">
			<img class="controller_tile_icon" src="/images/decipherable/gear.png" alt="">
			<span class="controller_tile_label"><%= &subs::ui('Configuration') %></span>
			<span class="controller_tile_note"><%= &subs::ui('Settings and system') %></span>
		</a>
		<a class="controller_tile" href="/manager?open=phone">
			<img class="controller_tile_icon" src="/images/decipherable/phone.png" alt="">
			<span class="controller_tile_label"><%= &subs::ui('IVR') %></span>
			<span class="controller_tile_note"><%= &subs::ui('The phone call menu and greeting') %></span>
		</a>
		<a class="controller_tile" href="/manager?open=embedded">
			<img class="controller_tile_icon" src="/images/decipherable/on.png" alt="">
			<span class="controller_tile_label"><%= &subs::ui('Automation') %></span>
			<span class="controller_tile_note"><%= &subs::ui('Toggles for the house devices') %></span>
		</a>
		<div class="controller_tile controller_tile_leave">
			<img class="controller_tile_icon" src="/images/decipherable/exit.png" alt="">
			<span class="controller_tile_label"><%= &subs::ui('Leave') %></span>
% if (@power_available) {
			<div class="controller_leave_actions">
% for my $action (grep { $power_has{$_} } @power_order) {
				<button type="button" class="controller_leave_button" data-power-action="<%= $action %>"><%= &subs::ui($power_label{$action}) %></button>
% }
			</div>
			<span class="controller_leave_result" aria-live="polite"></span>
% } else {
			<span class="controller_tile_note"><%= &subs::ui('This machine cannot power itself.') %></span>
% }
		</div>
	</div>
</div>

<script>
(function () {
	var tile = document.querySelector('.controller_tile_leave');
	if (!tile) { return; }
	var note = tile.querySelector('.controller_leave_result');
	var labels = <%== encode_json(\%power_ui) %>;
	var asked = <%== encode_json(&subs::ui('Asked to')) %>;
	var failed = <%== encode_json(&subs::ui('That did not work.')) %>;
	tile.addEventListener('click', function (event) {
		var button = event.target.closest('[data-power-action]');
		if (!button) { return; }
		var action = button.getAttribute('data-power-action');
		button.disabled = true;
		if (note) { note.textContent = asked + ': ' + (labels[action] || action); }
		fetch('/manager/power', {
			method: 'POST',
			credentials: 'same-origin',
			headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
			body: new URLSearchParams({ action: action, timestamp: Date.now() })
		}).then(function (response) {
			return response.json();
		}).then(function (result) {
			if (result && result.ok) { return; }
			if (note) { note.textContent = failed; }
			button.disabled = false;
		}).catch(function () {
			if (note) { note.textContent = failed; }
			button.disabled = false;
		});
	});
})();
</script>
