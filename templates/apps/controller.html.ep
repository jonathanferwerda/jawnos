<% use Mojo::JSON qw(encode_json); %>
<%# The controller's home. A handheld panel is 480x854 and has no desk to lay
    windows on, so it opens on a launcher instead: eight tiles, each one press
    away from the surface it names. Leave is a panel of its own: the action asks
    subs::power_actions() what this machine can do, so the tile draws only the
    buttons that can succeed and never promises a press that does nothing. %>
<%= include 'controller/standalone' %>
<style>
	/* Four across, two down: the panel is 854x480, and a 2x4 grid was 606px
	   tall - the fourth row sat below the glass. */
	#controller_home { display:grid; grid-template-columns:repeat(4,1fr); grid-template-rows:repeat(2,1fr);
		gap:8px; width:100%; height:100%; min-height:0; padding:8px; box-sizing:border-box; overflow:hidden; }
	/* The launcher is the whole glass: the desk's window bar is furniture a
	   handheld does not need, and the Manager button is the only way out. */
	.wind[app="controller"] .top_navbar { display:none !important; }
	.controller_tile { display:flex; flex-direction:column; justify-content:center; gap:4px;
		min-width:0; overflow:hidden; padding:10px; border:1px solid var(--line); border-radius:12px;
		background:var(--panel); color:var(--ink); text-decoration:none; }
	.controller_tile:hover { border-color:var(--accent, #4a90d9); }
	.controller_tile:focus, .controller_tile.is_selected {
		outline:3px solid var(--accent, #4a90d9); outline-offset:-3px; }
	.controller_tile_label { font-size:15px; font-weight:600; line-height:1.1; }
	.controller_tile_note { font-size:10px; line-height:1.25; opacity:.72; }
	/* The window frame's own icon is drawn at its natural size inside this page
	   (a 1112x1038 gear over the first row); the house's thumbnail rules are not
	   in scope here, so it is pinned. */
	img.window_icon { width:22px; height:22px; object-fit:contain; }
	/* The handheld's own look: dark grey panel, white words, and a picture
	   per tile from the house's decipherable set. Scoped to this page. */
	html, body, .wind, .window_contents { background:#2e2e2e !important; color:#f4f4f4 !important; }
	.controller_tile { background:#3a3a3a !important; border-color:#4a4a4a !important;
		color:#ffffff !important; align-items:center; text-align:center; }
	.controller_tile_label { color:#ffffff !important; }
	.controller_tile_note { color:#d8d8d8 !important; opacity:1; }
	/* The picture is how a person finds a tile on a small panel: it gets 80% of
	   the tile, and the two lines of words take the rest. The Leave tile keeps a
	   fixed picture because its buttons need the room. */
	.controller_tile_icon { flex:1 1 auto; width:80%; max-height:80%; min-height:0; object-fit:contain; }
	.controller_tile_leave .controller_tile_icon { flex:0 0 auto; width:56px; height:56px; }
	.controller_clock { min-width:72px; text-align:center; font-variant-numeric:tabular-nums; }

	/* The launcher is the whole panel. The desk remembers a window's size and
	   place per app, and this page arrived at 480x640 from y=100 - two rows
	   below the glass. Scoped to this page, so no other window moves. */
	.wind { left:0 !important; top:0 !important; width:100vw !important; height:100vh !important; }
	.window_contents { width:100% !important; height:100% !important; padding-top:0 !important; }
	/* The launcher has no window bar: a slim row holds the one way out to the
	   desk, and the eight tiles take the rest of the glass. */
	#controller_shell { display:flex; flex-direction:column; width:100%; height:100%; min-height:0; position:relative; }
	#controller_bar { flex:0 0 auto; display:flex; justify-content:flex-end; align-items:center; gap:6px; padding:6px 8px 0; }
	.controller_bar_button { font:inherit; font-size:13px; line-height:1.2; padding:5px 12px;
		border:1px solid #4a4a4a; border-radius:8px; background:#3a3a3a; color:#ffffff;
		text-decoration:none; cursor:var(--jawnos-cursor-pointer, pointer); }
	.controller_bar_button:hover { border-color:var(--accent, #4a90d9); }
	#controller_battery { min-width:72px; }
	#controller_power_panel, #controller_volume_panel, #controller_network_panel { position:absolute; right:8px; top:34px; z-index:50; width:250px;
		padding:10px; border:1px solid #4a4a4a; border-radius:12px; background:#2e2e2e;
		color:#f4f4f4; box-shadow:0 8px 24px rgba(0,0,0,.5); }
	#controller_power_panel[hidden], #controller_volume_panel[hidden], #controller_network_panel[hidden] { display:none; }
	#controller_power_panel h3, #controller_volume_panel h3, #controller_network_panel h3 { margin:0 0 8px; font-size:13px; font-weight:600; }
	.controller_power_row { display:flex; justify-content:space-between; gap:8px; font-size:12px; line-height:1.5; }
	.controller_power_profiles { display:grid; grid-template-columns:1fr 1fr; gap:4px; margin-top:8px; }
	.controller_power_profiles button { font:inherit; font-size:12px; padding:5px 6px; border:1px solid #4a4a4a;
		border-radius:8px; background:#3a3a3a; color:#ffffff; cursor:var(--jawnos-cursor-pointer, pointer); }
	.controller_power_profiles button.active { border-color:var(--accent, #4a90d9); background:#4a90d9; }
	.controller_power_note { margin-top:6px; font-size:11px; line-height:1.3; min-height:1em; opacity:.8; }
	/* The volume panel: a master row and one row per source channel. A channel is
	   a gain its player multiplies in; master is the machine's own mixer. */
	.controller_volume_row { display:grid; grid-template-columns:58px 1fr 30px 44px; align-items:center; gap:6px;
		font-size:12px; line-height:1.6; }
	.controller_volume_row input[type="range"] { width:100%; accent-color:#4a90d9; }
	.controller_volume_value { text-align:right; font-variant-numeric:tabular-nums; }
	.controller_volume_note { font-size:11px; line-height:1.3; min-height:1em; opacity:.8; margin-bottom:4px; }
	.controller_mute_button, .controller_network_row button { font:inherit; font-size:11px; line-height:1.2; padding:3px 6px;
		border:1px solid #4a4a4a; border-radius:6px; background:#3a3a3a; color:#ffffff;
		cursor:var(--jawnos-cursor-pointer, pointer); }
	.controller_mute_button.active, .controller_network_row button.on { border-color:var(--accent, #4a90d9); background:#4a90d9; }
	.controller_mute_button:disabled, .controller_network_row button:disabled { opacity:.5; cursor:var(--jawnos-cursor-default, default); }
	.controller_network_row { display:flex; justify-content:space-between; align-items:center; gap:8px;
		font-size:12px; line-height:1.6; }
	.controller_network_detail { display:block; font-size:11px; opacity:.8; line-height:1.25; min-height:1em; }
	#controller_home { height:auto !important; flex:1 1 auto; min-height:0; }

	.controller_tile_leave { border-style:dashed; }
	.controller_leave_actions { display:flex; flex-wrap:wrap; gap:4px; }
	.controller_leave_button { font:inherit; font-size:12px; line-height:1.2; padding:4px 8px;
		border:1px solid var(--line); border-radius:8px; background:transparent; color:var(--ink); cursor:var(--jawnos-cursor-pointer, pointer); }
	.controller_leave_button:hover { border-color:var(--accent, #4a90d9); }
	.controller_leave_button:disabled { opacity:.5; cursor:var(--jawnos-cursor-default, default); }
	.controller_leave_result { font-size:12px; line-height:1.3; opacity:.72; min-height:1em; }
</style>

<%
	my @power_available = ref $power_actions eq 'ARRAY' ? @{ $power_actions } : ();
	my %power_has = map { $_ => 1 } @power_available;
	my @power_order = qw(sleep screen_off restart shutdown logout);
	my %power_label = (
		sleep => 'Sleep',
		screen_off => 'Screen off',
		restart => 'Restart',
		shutdown => 'Shut down',
		logout => 'Log out',
	);
	my %power_ui = map { $_ => &subs::ui($power_label{$_}) } keys %power_label;
	my $status = ref $power_status eq 'HASH' ? $power_status : {};
	my $battery = ref $status->{'battery'} eq 'HASH' ? $status->{'battery'} : {};
	my $cpu = ref $status->{'cpu'} eq 'HASH' ? $status->{'cpu'} : {};
	my $source = ($status->{'source'} || '') eq 'ac' ? 'ac' : 'battery';
	my $entry = (ref $status->{'config'} eq 'HASH' && ref $status->{'config'}{$source} eq 'HASH')
		? $status->{'config'}{$source} : {};
	my $plan = $entry->{'plan'} || 'balanced';
	my %profile_label = (auto => 'Auto', saver => 'Power saver', balanced => 'Balanced', performance => 'Performance');
	my %profile_ui = map { $_ => &subs::ui($profile_label{$_}) } keys %profile_label;
	my $battery_pct = defined $battery->{'percentage'} ? sprintf('%s%.0f%%', ($battery->{'estimated'} ? '~' : ''), $battery->{'percentage'}) : '—';
	my @battery_bits;
	push @battery_bits, $battery->{'status'} if $battery->{'status'};
	push @battery_bits, &subs::ui('estimated from voltage') if $battery->{'estimated'};
	push @battery_bits, &subs::ui('cable connected') if $battery->{'cable'};
	my $battery_note = $battery->{'present'}
		? (@battery_bits ? join(' · ', @battery_bits) : &subs::ui('Battery'))
		: &subs::ui('No battery sensor');
	my @cpu_bits;
	push @cpu_bits, $cpu->{'governor'} if $cpu->{'governor'};
	push @cpu_bits, $cpu->{'cur_mhz'} . ' GHz' if defined $cpu->{'cur_mhz'};
	my $cpu_note = @cpu_bits ? join(' · ', @cpu_bits) : &subs::ui('Unknown');

	# The sound reading carries the master output and the three source channels.
	# Channels have defaults, so the panel draws even on a machine with no card;
	# only the master row says it is unavailable.
	my $sound = ref $sound_status eq 'HASH' ? $sound_status : {};
	my $channels = ref $sound->{'channels'} eq 'HASH' ? $sound->{'channels'} : {};
	my $master = ref $sound->{'output'} eq 'HASH' ? $sound->{'output'} : {};
	my $master_known = $sound->{'ok'} ? 1 : 0;
	my $master_volume = $master_known && defined $master->{'volume'} ? $master->{'volume'} : 0;
	my %channel_label = (music => 'Music', phone => 'Phone', alarm => 'Alarm');
	my %channel_ui = map { $_ => &subs::ui($channel_label{$_}) } keys %channel_label;
%>

<div id="controller_shell">
	<div id="controller_bar">
		<button type="button" id="controller_network" class="controller_bar_button" aria-expanded="false" aria-controls="controller_network_panel"><%= &subs::ui('Network') %></button>
		<button type="button" id="controller_volume" class="controller_bar_button" aria-expanded="false" aria-controls="controller_volume_panel"><%= &subs::ui('Sound') %></button>
		<button type="button" id="controller_battery" class="controller_bar_button" aria-expanded="false" aria-controls="controller_power_panel"><span id="controller_battery_pct"><%= $battery_pct %></span></button>
		<a id="controller_manager_button" class="controller_bar_button" href="/manager?desk=1"><%= &subs::ui('Manager') %></a>
		<span id="controller_clock" class="controller_bar_button controller_clock" aria-label="<%= &subs::ui('Time') %>">—</span>
	</div>
	<div id="controller_power_panel" hidden>
		<h3><%= &subs::ui('Battery and CPU') %></h3>
		<div class="controller_power_row"><span><%= &subs::ui('Battery') %></span><strong id="controller_power_battery"><%= $battery_note %></strong></div>
		<div class="controller_power_row"><span><%= &subs::ui('CPU') %></span><strong id="controller_power_cpu"><%= $cpu_note %></strong></div>
		<div class="controller_power_profiles" role="group" aria-label="<%= &subs::ui('Power profile') %>">
% for my $profile (qw(auto saver balanced performance)) {
			<button type="button" data-power-plan="<%= $profile %>" aria-pressed="<%= $profile eq $plan ? 'true' : 'false' %>"<%= $profile eq $plan ? ' class="active"' : '' %>><%= $profile_ui{$profile} %></button>
% }
		</div>
		<div class="controller_power_note" id="controller_power_note" aria-live="polite"></div>
	</div>
	<div id="controller_volume_panel" hidden>
		<h3><%= &subs::ui('Sound') %></h3>
		<div class="controller_volume_note" id="controller_volume_note" aria-live="polite"><%= $master_known ? '' : &subs::ui('No sound card') %></div>
		<div class="controller_volume_row" data-volume-channel="master">
			<span><%= &subs::ui('Master') %></span>
			<input type="range" min="0" max="100" step="1" value="<%= $master_volume %>" aria-label="<%= &subs::ui('Master volume') %>"<%= $master_known ? '' : ' disabled' %>>
			<span class="controller_volume_value"><%= $master_volume %></span>
			<button type="button" class="controller_mute_button<%= $master_known && $master->{'muted'} ? ' active' : '' %>" aria-pressed="<%= $master_known && $master->{'muted'} ? 'true' : 'false' %>"<%= $master_known ? '' : ' disabled' %>><%= $master->{'muted'} ? &subs::ui('Unmute') : &subs::ui('Mute') %></button>
		</div>
% for my $channel (qw(music phone alarm)) {
% 	my $state = ref $channels->{$channel} eq 'HASH' ? $channels->{$channel} : {};
% 	my $volume = defined $state->{'volume'} ? $state->{'volume'} : 100;
% 	my $muted = $state->{'muted'} ? 1 : 0;
		<div class="controller_volume_row" data-volume-channel="<%= $channel %>">
			<span><%= $channel_ui{$channel} %></span>
			<input type="range" min="0" max="100" step="1" value="<%= $volume %>" aria-label="<%= $channel_ui{$channel} %>">
			<span class="controller_volume_value"><%= $volume %></span>
			<button type="button" class="controller_mute_button<%= $muted ? ' active' : '' %>" aria-pressed="<%= $muted ? 'true' : 'false' %>"><%= $muted ? &subs::ui('Unmute') : &subs::ui('Mute') %></button>
		</div>
% }
	</div>
	<div id="controller_network_panel" hidden>
		<h3><%= &subs::ui('Network') %></h3>
		<div class="controller_network_row">
			<span>Wi-Fi<span class="controller_network_detail" id="controller_wifi_detail"></span></span>
			<button type="button" id="controller_wifi_toggle" aria-pressed="false"><%= &subs::ui('Off') %></button>
		</div>
		<div class="controller_network_row">
			<span>Bluetooth<span class="controller_network_detail" id="controller_bluetooth_detail"></span></span>
			<button type="button" id="controller_bluetooth_toggle" aria-pressed="false"><%= &subs::ui('Off') %></button>
		</div>
		<div class="controller_power_note" id="controller_network_note" aria-live="polite"></div>
	</div>
	<div id="controller_home">
		<a class="controller_tile" href="/manager?open=music&amp;full=1">
			<img class="controller_tile_icon" src="<%= &subs::icon_for('/images/decipherable/headphones.png') %>" alt="">
			<span class="controller_tile_label"><%= &subs::ui('Music') %></span>
			<span class="controller_tile_note"><%= &subs::ui('Play the house music') %></span>
		</a>
		<a class="controller_tile" href="/manager?open=gallery&amp;full=1">
			<img class="controller_tile_icon" src="<%= &subs::icon_for('/images/decipherable/gallery.png') %>" alt="">
			<span class="controller_tile_label"><%= &subs::ui('Gallery') %></span>
			<span class="controller_tile_note"><%= &subs::ui('Photos and videos') %></span>
		</a>
		<a class="controller_tile" href="/manager?open=notifications&amp;full=1">
			<img class="controller_tile_icon" src="<%= &subs::icon_for('/images/decipherable/bell.png') %>" alt="">
			<span class="controller_tile_label"><%= &subs::ui('Notifications') %></span>
			<span class="controller_tile_note"><%= &subs::ui('What the house has told you') %></span>
		</a>
		<a class="controller_tile" href="/manager/games">
			<img class="controller_tile_icon" src="<%= &subs::icon_for('/images/decipherable/tetris.png') %>" alt="">
			<span class="controller_tile_label"><%= &subs::ui('Games') %></span>
			<span class="controller_tile_note"><%= &subs::ui('Cards, Twirl and emulated games') %></span>
		</a>
		<a class="controller_tile" href="/manager/controller/config">
			<img class="controller_tile_icon" src="<%= &subs::icon_for('/images/decipherable/gear.png') %>" alt="">
			<span class="controller_tile_label"><%= &subs::ui('Configuration') %></span>
			<span class="controller_tile_note"><%= &subs::ui('Wi-Fi, power, time, sound and RetroArch') %></span>
		</a>
		<a class="controller_tile" href="/manager?open=phone&amp;full=1">
			<img class="controller_tile_icon" src="<%= &subs::icon_for('/images/decipherable/phone.png') %>" alt="">
			<span class="controller_tile_label"><%= &subs::ui('IVR') %></span>
			<span class="controller_tile_note"><%= &subs::ui('The phone call menu and greeting') %></span>
		</a>
		<a class="controller_tile" href="/manager?open=embedded&amp;full=1">
			<img class="controller_tile_icon" src="<%= &subs::icon_for('/images/decipherable/on.png') %>" alt="">
			<span class="controller_tile_label"><%= &subs::ui('Automation') %></span>
			<span class="controller_tile_note"><%= &subs::ui('Toggles for the house devices') %></span>
		</a>
		<div class="controller_tile controller_tile_leave" tabindex="0">
			<img class="controller_tile_icon" src="<%= &subs::icon_for('/images/decipherable/exit.png') %>" alt="">
			<span class="controller_tile_label"><%= &subs::ui('Leave') %></span>
% if (@power_available) {
			<div class="controller_leave_actions">
% for my $action (grep { $power_has{$_} } @power_order) {
				<button type="button" class="controller_leave_button" data-power-action="<%= $action %>"><%= &subs::ui($power_label{$action}) %></button>
% }
			</div>
			<span class="controller_leave_result" aria-live="polite"></span>
% } else {
			<span class="controller_tile_note"><%= &subs::ui('This machine cannot power itself.') %></span>
% }
		</div>
	</div>
</div>

<script>
/* One panel at a time: three buttons share one corner of the glass, and a panel
   left open under another would sit on the tiles. */
function closeControllerPanels(except) {
	var pairs = [['controller_battery', 'controller_power_panel'],
		['controller_volume', 'controller_volume_panel'],
		['controller_network', 'controller_network_panel']];
	for (var i = 0; i < pairs.length; i++) {
		var panel = document.getElementById(pairs[i][1]);
		var button = document.getElementById(pairs[i][0]);
		if (!panel || panel === except) { continue; }
		panel.setAttribute('hidden', '');
		if (button) { button.setAttribute('aria-expanded', 'false'); }
	}
}

(function () {
	var tile = document.querySelector('.controller_tile_leave');
	if (!tile) { return; }
	var note = tile.querySelector('.controller_leave_result');
	var labels = <%== encode_json(\%power_ui) %>;
	var asked = <%== encode_json(&subs::ui('Asked to')) %>;
	var failed = <%== encode_json(&subs::ui('That did not work.')) %>;
	tile.addEventListener('click', function (event) {
		var button = event.target.closest('[data-power-action]');
		if (!button) { return; }
		var action = button.getAttribute('data-power-action');
		button.disabled = true;
		if (note) { note.textContent = asked + ': ' + (labels[action] || action); }
		fetch('/manager/power', {
			method: 'POST',
			credentials: 'same-origin',
			headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
			body: new URLSearchParams({ action: action, timestamp: Date.now() })
		}).then(function (response) {
			return response.json();
		}).then(function (result) {
			if (result && result.ok) { return; }
			if (note) { note.textContent = failed + (result && result.error ? ' (' + result.error + ')' : ''); }
			button.disabled = false;
		}).catch(function () {
			if (note) { note.textContent = failed; }
			button.disabled = false;
		});
	});
})();

/* The battery button opens the same reading the Power app uses. A pack with no
   gauge says so instead of showing a false percentage; the profile buttons
   still apply the CPU plan through the saved Power settings. */
(function () {
	var button = document.getElementById('controller_battery');
	var panel = document.getElementById('controller_power_panel');
	if (!button || !panel) { return; }
	var pct = document.getElementById('controller_battery_pct');
	var batt = document.getElementById('controller_power_battery');
	var cpu = document.getElementById('controller_power_cpu');
	var note = document.getElementById('controller_power_note');
	var unavailable = <%== encode_json(&subs::ui('No battery sensor')) %>;
	var unknown = <%== encode_json(&subs::ui('Unknown')) %>;
	var failed = <%== encode_json(&subs::ui('That did not work.')) %>;
	var estimated_label = <%== encode_json(&subs::ui('estimated from voltage')) %>;
	var cable_label = <%== encode_json(&subs::ui('cable connected')) %>;
	var cores_label = <%== encode_json(&subs::ui('cores')) %>;
	var data = null;
	function paint() {
		var s = data || {};
		var b = s.battery || {};
		var c = s.cpu || {};
		var has = b.percentage !== undefined && b.percentage !== null;
		var text = has ? ((b.estimated ? '~' : '') + Math.round(b.percentage) + '%') : '—';
		if (pct) { pct.textContent = text; }
		if (batt) {
			var bits = [];
			if (has) { bits.push(text); }
			if (b.status) { bits.push(b.status); }
			if (b.estimated) { bits.push(estimated_label); }
			if (b.cable) { bits.push(cable_label); }
			batt.textContent = has ? bits.join(' · ') : (b.present ? unknown : unavailable);
		}
		if (cpu) {
			var bits = [];
			if (c.governor) { bits.push(c.governor); }
			if (c.cur_mhz !== undefined && c.cur_mhz !== null) { bits.push(c.cur_mhz + ' GHz'); }
			if (navigator.hardwareConcurrency) { bits.push(navigator.hardwareConcurrency + ' ' + cores_label); }
			cpu.textContent = bits.join(' · ') || unknown;
		}
		var source = s.source || 'battery';
		var plan = (((s.config || {})[source]) || {}).plan || 'balanced';
		var buttons = panel.querySelectorAll('[data-power-plan]');
		for (var i = 0; i < buttons.length; i++) {
			var on = buttons[i].getAttribute('data-power-plan') === plan;
			buttons[i].setAttribute('aria-pressed', on ? 'true' : 'false');
			buttons[i].classList.toggle('active', on);
			buttons[i].disabled = !(s && s.ok);
		}
	}
	function load() {
		fetch('/manager/power_status', { credentials: 'same-origin' })
			.then(function (r) { return r.json(); })
			.then(function (s) { data = s; paint(); })
			.catch(function () { if (note) { note.textContent = failed; } });
	}
	button.addEventListener('click', function () {
		var opening = panel.hasAttribute('hidden');
		closeControllerPanels(panel);
		if (opening) { panel.removeAttribute('hidden'); load(); } else { panel.setAttribute('hidden', ''); }
		button.setAttribute('aria-expanded', opening ? 'true' : 'false');
	});
	panel.addEventListener('click', function (event) {
		var choice = event.target.closest('[data-power-plan]');
		if (!choice || !data) { return; }
		var plan = choice.getAttribute('data-power-plan');
		var source = data.source || 'battery';
		var limit = (((data.config || {})[source]) || {}).limit;
		var buttons = panel.querySelectorAll('[data-power-plan]');
		for (var i = 0; i < buttons.length; i++) { buttons[i].disabled = true; }
		if (note) { note.textContent = ''; }
		fetch('/manager/power/plan', {
			method: 'POST',
			credentials: 'same-origin',
			headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
			body: new URLSearchParams({ source: source, plan: plan, limit: (limit === undefined || limit === null) ? '' : limit })
		}).then(function (r) { return r.json(); }).then(function (result) {
			if (result && result.ok) { load(); return; }
			if (note) { note.textContent = failed + (result && result.error ? ' (' + result.error + ')' : ''); }
			load();
		}).catch(function () { if (note) { note.textContent = failed; } load(); });
	});
	setInterval(load, 30000);
	load();
})();
/* The volume panel. Master is the machine's own mixer, so it is the one row that
   can be unavailable; a channel is a gain the source multiplies into its own
   playback, so it is always settable and the master decides what leaves the
   speaker or the headphones. */
(function () {
	var button = document.getElementById('controller_volume');
	var panel = document.getElementById('controller_volume_panel');
	if (!button || !panel) { return; }
	var note = document.getElementById('controller_volume_note');
	var rows = panel.querySelectorAll('[data-volume-channel]');
	var failed = <%== encode_json(&subs::ui('That did not work.')) %>;
	var unavailable = <%== encode_json(&subs::ui('No sound card')) %>;
	var mute_label = <%== encode_json(&subs::ui('Mute')) %>;
	var unmute_label = <%== encode_json(&subs::ui('Unmute')) %>;
	var state = null;

	function reading(name) {
		if (name === 'master') {
			var s = state || {};
			var out = s.output || {};
			var available = !!(s.ok && s.output);
			return { available: available, volume: available && out.volume !== undefined ? out.volume : 0, muted: available && out.muted ? 1 : 0 };
		}
		var channels = (state && state.channels) || {};
		var c = channels[name] || {};
		return { available: true, volume: c.volume !== undefined ? c.volume : 0, muted: c.muted ? 1 : 0 };
	}
	function paintRow(row) {
		var name = row.getAttribute('data-volume-channel');
		var c = reading(name);
		var range = row.querySelector('input[type="range"]');
		var value = row.querySelector('.controller_volume_value');
		var mute = row.querySelector('.controller_mute_button');
		if (range) { range.value = c.volume; range.disabled = !c.available; }
		if (value) { value.textContent = c.volume; }
		if (mute) {
			mute.classList.toggle('active', !!c.muted);
			mute.setAttribute('aria-pressed', c.muted ? 'true' : 'false');
			mute.textContent = c.muted ? unmute_label : mute_label;
			mute.disabled = !c.available;
		}
	}
	function paint() {
		for (var i = 0; i < rows.length; i++) { paintRow(rows[i]); }
		if (note) { note.textContent = reading('master').available ? '' : unavailable; }
	}
	function load() {
		fetch('/manager/controller/volume', { credentials: 'same-origin' })
			.then(function (r) { return r.json(); })
			.then(function (s) { state = s; paint(); })
			.catch(function () { if (note) { note.textContent = failed; } });
	}
	function write(body) {
		if (note) { note.textContent = ''; }
		fetch('/manager/controller/volume', {
			method: 'POST',
			credentials: 'same-origin',
			headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
			body: new URLSearchParams(body)
		}).then(function (r) { return r.json(); }).then(function (result) {
			if (result && result.ok) { state = result; paint(); return; }
			if (note) { note.textContent = failed + (result && result.error ? ' (' + result.error + ')' : ''); }
			load();
		}).catch(function () { if (note) { note.textContent = failed; } load(); });
	}
	for (var i = 0; i < rows.length; i++) {
		(function (row) {
			var name = row.getAttribute('data-volume-channel');
			var range = row.querySelector('input[type="range"]');
			var value = row.querySelector('.controller_volume_value');
			var mute = row.querySelector('.controller_mute_button');
			if (range) {
				range.addEventListener('input', function () { if (value) { value.textContent = range.value; } });
				range.addEventListener('change', function () { write({ channel: name, volume: range.value }); });
				/* The right stick is a wheel to the browser: with the pointer over a
				   row, it steps that row instead of scrolling the panel. */
				range.addEventListener('wheel', function (event) {
					event.preventDefault();
					var now = parseInt(range.value, 10) || 0;
					var step = ((event.deltaY || event.deltaX) < 0) ? 1 : -1;
					var next = Math.max(0, Math.min(100, now + step));
					if (next === now) { return; }
					range.value = next;
					if (value) { value.textContent = next; }
					if (range._wheelTimer) { clearTimeout(range._wheelTimer); }
					range._wheelTimer = setTimeout(function () { write({ channel: name, volume: next }); }, 180);
				}, { passive: false });
			}
			if (mute) {
				mute.addEventListener('click', function () {
					write({ channel: name, muted: reading(name).muted ? '0' : '1' });
				});
			}
		})(rows[i]);
	}
	button.addEventListener('click', function () {
		var opening = panel.hasAttribute('hidden');
		closeControllerPanels(panel);
		if (opening) { panel.removeAttribute('hidden'); load(); } else { panel.setAttribute('hidden', ''); }
		button.setAttribute('aria-expanded', opening ? 'true' : 'false');
	});
})();

/* The network panel: Wi-Fi's radio and the Bluetooth adapter. Both reads are the
   same ones the desk's taskbar uses; a panel that is open refreshes every
   fifteen seconds, and a closed panel costs nothing. */
(function () {
	var button = document.getElementById('controller_network');
	var panel = document.getElementById('controller_network_panel');
	if (!button || !panel) { return; }
	var wifiDetail = document.getElementById('controller_wifi_detail');
	var wifiToggle = document.getElementById('controller_wifi_toggle');
	var btDetail = document.getElementById('controller_bluetooth_detail');
	var btToggle = document.getElementById('controller_bluetooth_toggle');
	var note = document.getElementById('controller_network_note');
	var failed = <%== encode_json(&subs::ui('That did not work.')) %>;
	var on_label = <%== encode_json(&subs::ui('On')) %>;
	var off_label = <%== encode_json(&subs::ui('Off')) %>;
	var connected_label = <%== encode_json(&subs::ui('Connected')) %>;
	var no_wifi = <%== encode_json(&subs::ui('No Wi-Fi')) %>;
	var no_bluetooth = <%== encode_json(&subs::ui('No Bluetooth')) %>;
	var timer = null;
	var wifiOn = false, btOn = false;

	function paintToggle(el, on) {
		if (!el) { return; }
		el.textContent = on ? on_label : off_label;
		el.classList.toggle('on', !!on);
		el.setAttribute('aria-pressed', on ? 'true' : 'false');
	}
	function paintWifi(s) {
		s = s || {};
		var w = s.wifi || {};
		var list = w.interfaces || [];
		var link = null;
		for (var i = 0; i < list.length; i++) { if (!link || list[i].state === 'connected') { link = list[i]; } }
		var present = !!w.present;
		/* iwd answers with the adapter's powered bit; NetworkManager has no
		   adapter list, so a wireless link that exists is the honest reading. */
		wifiOn = w.iwd ? !!w.radio_powered : present;
		if (wifiDetail) {
			if (!present) { wifiDetail.textContent = no_wifi; }
			else if (link && link.ssid) { wifiDetail.textContent = link.ssid; }
			else if (link && link.state === 'connected') { wifiDetail.textContent = connected_label; }
			else { wifiDetail.textContent = ''; }
		}
		if (wifiToggle) { wifiToggle.disabled = !present; }
		paintToggle(wifiToggle, wifiOn);
	}
	function paintBluetooth(s) {
		s = s || {};
		var adapter = s.adapter || {};
		var present = s.ok !== 0;
		btOn = !!adapter.powered;
		var device = (s.connected || [])[0];
		if (btDetail) {
			if (!present) { btDetail.textContent = no_bluetooth; }
			else if (device && (device.name || device.address)) { btDetail.textContent = device.name || device.address; }
			else { btDetail.textContent = ''; }
		}
		if (btToggle) { btToggle.disabled = !present; }
		paintToggle(btToggle, btOn);
	}
	function load() {
		fetch('/manager/network/status', { credentials: 'same-origin' })
			.then(function (r) { return r.json(); }).then(paintWifi)
			.catch(function () { if (note) { note.textContent = failed; } });
		fetch('/manager/network/bluetooth/status', { credentials: 'same-origin' })
			.then(function (r) { return r.json(); }).then(paintBluetooth)
			.catch(function () {});
	}
	function post(url, body) {
		if (note) { note.textContent = ''; }
		fetch(url, {
			method: 'POST',
			credentials: 'same-origin',
			headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
			body: new URLSearchParams(body)
		}).then(function (r) { return r.json(); }).then(function (result) {
			if (!(result && result.ok) && note) {
				note.textContent = failed + (result && result.error ? ' (' + result.error + ')' : '');
			}
			load();
		}).catch(function () { if (note) { note.textContent = failed; } load(); });
	}
	if (wifiToggle) {
		wifiToggle.addEventListener('click', function () {
			wifiToggle.disabled = true;
			post('/manager/network/radio', { state: wifiOn ? 'off' : 'on' });
		});
	}
	if (btToggle) {
		btToggle.addEventListener('click', function () {
			btToggle.disabled = true;
			post('/manager/network/bluetooth/action', { action: 'power', state: btOn ? 'off' : 'on' });
		});
	}
	button.addEventListener('click', function () {
		var opening = panel.hasAttribute('hidden');
		closeControllerPanels(panel);
		if (opening) {
			panel.removeAttribute('hidden');
			load();
			timer = setInterval(load, 15000);
		} else {
			panel.setAttribute('hidden', '');
			if (timer) { clearInterval(timer); timer = null; }
		}
		button.setAttribute('aria-expanded', opening ? 'true' : 'false');
	});
})();

/* The bar clock. `clock_timezone` is the same house setting the taskbar reads;
   the handheld's box can be on UTC, so the browser is told the zone rather than
   trusting its own. Eastern is the house default. */
(function () {
	var el = document.getElementById('controller_clock');
	if (!el) { return; }
	var zone = <%== encode_json($clock_zone) %>;
	if (!zone || zone === 'local') { zone = undefined; }
	function paint() {
		var now = new Date();
		var text;
		try {
			text = new Intl.DateTimeFormat(undefined, { hour: 'numeric', minute: '2-digit', timeZone: zone }).format(now);
		}
		catch (e) {
			text = now.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
		}
		el.textContent = text;
		el.title = zone ? ('Time · ' + zone) : 'Time';
	}
	paint();
	setInterval(paint, 15000);
})();

/* The D-pad sends the keyboard arrows, so the launcher can be walked without
   moving the pointer. An arrow selects the next tile and outlines it; Enter or
   a click after an arrow opens the selected tile. A click after the pointer
   moved is an ordinary click on whatever it hit. */
(function () {
	var grid = document.getElementById('controller_home');
	if (!grid) { return; }
	var tiles = Array.prototype.slice.call(grid.querySelectorAll('.controller_tile'));
	if (!tiles.length) { return; }
	var selected = -1;
	var keyboardMode = false;
	function paint() {
		for (var i = 0; i < tiles.length; i++) {
			tiles[i].classList.toggle('is_selected', i === selected);
		}
	}
	function select(index) {
		selected = ((index % tiles.length) + tiles.length) % tiles.length;
		paint();
		try { tiles[selected].focus({ preventScroll: true }); }
		catch (e) { tiles[selected].focus(); }
	}
	function activate() {
		var tile = tiles[selected];
		if (!tile) { return; }
		if (tile.tagName === 'A' && tile.getAttribute('href')) {
			location.href = tile.getAttribute('href');
			return;
		}
		var first = tile.querySelector('button, a[href]');
		if (first) { first.focus(); }
	}
	document.addEventListener('keydown', function (e) {
		var key = e.key;
		if (key !== 'ArrowUp' && key !== 'ArrowDown' && key !== 'ArrowLeft'
			&& key !== 'ArrowRight' && key !== 'Enter' && key !== ' ') { return; }
		var target = e.target;
		if (target && (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName))) { return; }
		if (key === 'Enter' || key === ' ') {
			if (selected < 0) { return; }
			e.preventDefault();
			activate();
			return;
		}
		e.preventDefault();
		keyboardMode = true;
		if (selected < 0) {
			select((key === 'ArrowUp' || key === 'ArrowLeft') ? tiles.length - 1 : 0);
			return;
		}
		var delta = key === 'ArrowRight' ? 1 : key === 'ArrowLeft' ? -1 : key === 'ArrowDown' ? 4 : -4;
		select(selected + delta);
	});
	/* The left stick is the pointer. Any real movement hands the click back to
	   it; the D-pad never generates a mousemove. */
	document.addEventListener('mousemove', function (e) {
		if (e.movementX || e.movementY) { keyboardMode = false; }
	});
	/* A is a left click at wherever the pointer was parked. After an arrow that
	   click means the selected tile, not that old spot. The bar and the Leave
	   buttons keep their own clicks. */
	document.addEventListener('click', function (e) {
		if (!keyboardMode) { return; }
		if (e.target.closest('#controller_bar button, #controller_bar a, .controller_leave_actions button, .controller_leave_actions a')) { return; }
		e.preventDefault();
		e.stopPropagation();
		keyboardMode = false;
		activate();
	}, true);
	tiles.forEach(function (tile, i) {
		tile.addEventListener('mouseenter', function () {
			keyboardMode = false;
			if (selected !== i) { selected = i; paint(); }
		});
	});
})();

</script>
