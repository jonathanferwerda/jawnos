<% use Mojo::JSON qw/encode_json/; %>
<%
	# Appointment notifications are an optional backend key: the page still draws
	# the list and its toolbar when the key is absent.
	my $appt_settings   = $notifications->{'appointment_settings'} || {};
	my $appt_enabled    = $appt_settings->{'enabled'} || [];
	my $appt_candidates = $appt_settings->{'candidates'} || [];
	# The autocomplete speaks the formatted name; this map turns the chosen name
	# back into the app it belongs to. Only candidates the backend calls public
	# enough are offered, so nothing here widens what the person may configure.
	my %appt_by_name;
	foreach my $candidate ( @{$appt_candidates} ) {
		next unless $candidate && defined $candidate->{'app'} && defined $candidate->{'formatted_name'};
		next if $candidate->{'formatted_name'} eq '';
		$appt_by_name{$candidate->{'formatted_name'}} = $candidate->{'app'};
	}
	# An enabled appointment is not offered in the add box, but it is still a
	# name the page knows: turning it off and back on in this window must resolve.
	foreach my $entry ( @{$appt_enabled} ) {
		next unless $entry && defined $entry->{'app'} && defined $entry->{'formatted_name'};
		next if $entry->{'formatted_name'} eq '';
		$appt_by_name{$entry->{'formatted_name'}} = $entry->{'app'};
	}
%>
<style>
#notifications_app { flex: 1 1 auto; min-width: 0; min-height: 0; display: flex; flex-direction: column; gap: 10px; padding: 14px; box-sizing: border-box; overflow: hidden; font-size: 15px; }
#notifications_app .notifications_app_tabs { flex: 0 0 auto; min-width: 0; display: flex; align-items: center; gap: 4px; overflow-x: auto; overflow-y: hidden; white-space: nowrap; border-bottom: 1px solid var(--line); -webkit-overflow-scrolling: touch; }
#notifications_app .notifications_app_tab { flex: 0 0 auto; font: inherit; font-size: 13px; padding: 7px 14px; cursor: var(--jawnos-cursor-pointer, pointer); color: inherit; border: 1px solid transparent; border-bottom: 0; border-radius: calc(var(--jawnos-corner, 12px) * .4) calc(var(--jawnos-corner, 12px) * .4) 0 0; background-color: transparent; opacity: .7; }
#notifications_app .notifications_app_tab:hover { background-color: var(--panel); opacity: 1; }
#notifications_app .notifications_app_tab.is-active { background-color: var(--panel); border-color: var(--line); opacity: 1; font-weight: 700; }
#notifications_app .notifications_app_view { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; gap: 10px; }
#notifications_app .notifications_app_view[hidden] { display: none !important; }
#notifications_app .notifications_app_main_view { overflow: hidden; }
#notifications_app .notifications_app_appt_view { overflow-y: auto; padding-right: 4px; }
#notifications_app .notifications_app_toolbar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
#notifications_app .notifications_app_search { flex: 1 1 220px; min-width: 0; padding: 7px 10px; font: inherit; font-size: 14px; color: inherit; background-color: var(--panel); border: 1px solid var(--line); border-radius: calc(var(--jawnos-corner, 12px) * .45); }
#notifications_app .notifications_app_filter { flex: 0 1 200px; padding: 7px 8px; font: inherit; font-size: 14px; color: inherit; background-color: var(--panel); border: 1px solid var(--line); border-radius: calc(var(--jawnos-corner, 12px) * .45); }
#notifications_app .notifications_app_clear { flex: 0 0 auto; }
#notifications_app .notifications_app_list { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; gap: 8px; overflow-y: auto; padding-right: 4px; }
#notifications_app .notification { --notification_icon: 22px; --notification_line: 30px; position: relative; padding: 10px 12px; border: 1px solid var(--line); border-radius: calc(var(--jawnos-corner, 12px) * .6); background-color: var(--panel-2, rgba(127,127,127,.06)); overflow: hidden; line-height: 1.4; cursor: var(--jawnos-cursor-pointer, pointer); flex: 0 0 auto; overflow-wrap: anywhere; }
#notifications_app .notification:hover { border-color: var(--accent-line, var(--line)); }
#notifications_app .notification:focus-visible { outline: 2px solid var(--accent, #3b7ddd); outline-offset: 2px; }
/* The title's line is the picture's line: it clears the icon and its 3px frame
   (22 + 6), so the message starts below the picture instead of being squeezed
   into the narrow column beside it. */
#notifications_app .notification b { font-size: 15px; line-height: var(--notification_line); }
#notifications_app .notification .time { font-size: 12px; opacity: .6; }
/* An app's icon and a phone's image take the same box, and the wrapper adds no
   text line of its own around it. border-box keeps a configured Button Border
   from growing the picture past the line that holds it. */
#notifications_app .notification .hover { line-height: 0; }
#notifications_app .notification img.window_icon,
#notifications_app .notification img.little_thumb { box-sizing: border-box; width: var(--notification_icon); height: var(--notification_icon) !important; max-width: none; object-fit: contain; }
#notifications_app .notifications_app_note { min-height: 1.3em; opacity: .72; font-size: 13px; }
#notifications_app .notifications_app_appt_add { flex: 0 0 auto; width: 100%; box-sizing: border-box; padding: 7px 10px; font: inherit; font-size: 14px; color: inherit; background-color: var(--panel); border: 1px solid var(--line); border-radius: calc(var(--jawnos-corner, 12px) * .45); }
#notifications_app .notifications_app_appt_list { display: flex; flex-direction: column; gap: 10px; }
#notifications_app .notifications_app_appt_card { flex: 0 0 auto; display: flex; flex-direction: column; gap: 8px; padding: 10px 12px; border: 1px solid var(--line); border-radius: calc(var(--jawnos-corner, 12px) * .6); background-color: var(--panel-2, rgba(127,127,127,.06)); overflow-wrap: anywhere; }
#notifications_app .notifications_app_appt_head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; }
#notifications_app .notifications_app_appt_off { flex: 0 0 auto; font: inherit; font-size: 12px; padding: 4px 10px; cursor: var(--jawnos-cursor-pointer, pointer); color: inherit; border: 1px solid var(--line); border-radius: calc(var(--jawnos-corner, 12px) * .4); background-color: var(--panel); }
#notifications_app .notifications_app_appt_off:hover { border-color: var(--accent-line, var(--line)); }
#notifications_app .notifications_app_appt_off[disabled] { opacity: .45; cursor: var(--jawnos-cursor-default, default); }
#notifications_app .notifications_app_appt_empty { opacity: .7; padding: 14px 6px; }
</style>
<div id="notifications_app" app="notifications">
	<div class="notifications_app_tabs" role="tablist" aria-label="<%= &subs::ui('Notification views') %>">
		<button type="button" class="notifications_app_tab is-active" id="notifications_app_tab_main" role="tab" aria-selected="true" aria-controls="notifications_app_view_main" data-notifications-view="main"><%= &subs::ui('Main') %></button>
		<button type="button" class="notifications_app_tab" id="notifications_app_tab_appointments" role="tab" aria-selected="false" aria-controls="notifications_app_view_appointments" data-notifications-view="appointments"><%= &subs::ui('Appointments') %></button>
	</div>
	<div id="notifications_app_view_main" class="notifications_app_view notifications_app_main_view" role="tabpanel" aria-labelledby="notifications_app_tab_main" data-notifications-view-panel="main">
		<div class="notifications_app_toolbar">
			<input type="search" id="notifications_app_search" hint="<%= &subs::ui('Type to filter the list') %>" class="notifications_app_search" placeholder="<%= &subs::ui('Search notifications') %>" value="<%= $notifications->{'settings'}->{'search'} // '' %>">
			<select id="notifications_app_filter" hint="<%= &subs::ui('Show only one app in the list') %>" class="notifications_app_filter" aria-label="<%= &subs::ui('Filter by app') %>">
				<option value="all"<%== (($notifications->{'settings'}->{'filter'} || '') eq '' || $notifications->{'settings'}->{'filter'} eq 'all') ? ' selected' : '' %>><%= &subs::ui('All apps') %></option>
				<% foreach my $app ( sort @{ $notifications->{'apps'} || [] } ) { %>
					<option value="<%= $app %>"<%== (($notifications->{'settings'}->{'filter'} || '') eq $app) ? ' selected' : '' %>><%= &subs::format_name($app) %></option>
				<% } %>
			</select>
			<button type="button" class="notification_remove notifications_app_clear" hint="<%= &subs::ui('Clear every notice the filter shows') %>" scope="all" uuid=""><%= &subs::ui('Remove all') %></button>
		</div>
		<div id="notifications_app_list" class="notifications_app_list"><%== $notifications->{'content'} %></div>
		<div id="notifications_app_note" class="notifications_app_note"></div>
	</div>
	<div id="notifications_app_view_appointments" class="notifications_app_view notifications_app_appt_view" role="tabpanel" aria-labelledby="notifications_app_tab_appointments" data-notifications-view-panel="appointments" hidden>
		<input type="text" id="notifications_app_appt_add" class="notifications_app_appt_add" list="notifications_app_appt_candidates" autocomplete="off" placeholder="<%= &subs::ui('Add an appointment') %>" hint="<%= &subs::ui('Type an appointment name and press Enter to let it announce notifications') %>">
		<datalist id="notifications_app_appt_candidates">
			<% foreach my $candidate ( @{$appt_candidates} ) { %>
				<% next unless $candidate && defined $candidate->{'formatted_name'} && $candidate->{'formatted_name'} ne ''; %>
				<option value="<%= $candidate->{'formatted_name'} %>"></option>
			<% } %>
		</datalist>
		<div id="notifications_app_appt_note" class="notifications_app_note"></div>
		<div id="notifications_app_appt_list" class="notifications_app_appt_list">
			<% if (!@{$appt_enabled}) { %>
				<div class="notifications_app_appt_empty"><%= &subs::ui('No appointments are announcing notifications yet.') %></div>
			<% } %>
			<% foreach my $entry ( @{$appt_enabled} ) { %>
				<% next unless $entry && defined $entry->{'app'} && $entry->{'app'} ne ''; %>
				<% my $app = $entry->{'app'}; my $settings = $entry->{'settings'} || {}; %>
				<div class="notifications_app_appt_card" data-app="<%= $app %>">
					<div class="notifications_app_appt_head">
						<b><%= defined $entry->{'formatted_name'} && $entry->{'formatted_name'} ne '' ? $entry->{'formatted_name'} : &subs::format_name($app) %></b>
						<button type="button" class="notifications_app_appt_off" data-app="<%= $app %>" hint="<%= &subs::ui('Stop this appointment from announcing notifications') %>"><%= &subs::ui('Turn off notifications') %></button>
					</div>
					<%= include 'configure/app_notification', a => $app, settings => $settings %>
				</div>
			<% } %>
		</div>
	</div>
</div>
<script>
window.jawnos_notification_appt_by_name = <%== encode_json(\%appt_by_name) %>;
</script>
