App: <input attribute="app" value="<%= &subs::format_name($app->{'app'}) %>"><br>
Timestamp: <input attribute="timestamp" class="time" timestamp="<%= $app->{'timestamp'} %>"><br>
Duration: <input attribute="duration" value="<% if ($app->{'duration'} < 0) { %>-<% } %><%= &subs::duration_sayer($app->{'duration'} / 1000) %>"><br>
Warranty: <input attribute="warranty" class="time" timestamp="<%= $app->{'warranty'} %>"><br>
<img src="<%= &subs::icon_for('/images/decipherable/diskette.png') %>" hint="Save" class="medium_thumb edit_app_submit hover" uuid="<%= $app->{'uuid'} %>" app="<%= $app->{'app'} %>">
<span class="edit_app_extras" style="display:inline-flex;flex-wrap:wrap;gap:6px;align-items:center;margin-left:12px;">
	<input attribute="clone_name" placeholder="<%= &subs::ui('New name for a clone') %>" style="min-width:150px;">
	<img src="<%= &subs::icon_for('/images/decipherable/adopt.png') %>" hint="Clone" class="medium_thumb edit_app_clone hover" uuid="<%= $app->{'uuid'} %>" app="<%= $app->{'app'} %>">
	<img src="<%= &subs::icon_for('/icons/trash.png') %>" hint="Delete app" class="medium_thumb edit_app_delete hover" uuid="<%= $app->{'uuid'} %>" app="<%= $app->{'app'} %>" timestamp="<%= $app->{'timestamp'} %>" type="<%= $app->{'type'} %>">
	<span class="edit_app_status" style="font-size:12px;opacity:.75;"></span>
</span>
<%= include 'apps/app_details', appts => $appts, a => $app->{'app'}, app => $app %>
<br>
<% foreach my $note_type ( qw/start_notes notes end_notes/ ) { %>
	<%= &subs::format_name($note_type) %><br>
	<textarea attribute="<%= $note_type %>"><%= $app->{$note_type} %></textarea><br>
<% } %><br>

