<%# the report the evaluation last left for this scope; the controls that run
    one live with the app's configuration now, and with the system settings for
    the whole house %>
<% my $report_app = $app || '__president'; %>
<%# the setting is what the whole house can read; the cache is the fallback the
    machines kept before the report travelled %>
<% my $report = &subs::evaluation_report_for($report_app); %>
<% if (($report->{'text'} || '') ne '') { %>
	<%= include 'apps/evaluation_report', report => $report, app => $report_app %>
<% } else { %>
	<%# the block lives even with nothing to say, because a run fills it in place %>
	<div class="appointment_evaluation evaluation_report" app="<%= $report_app %>" style="border:solid;border-radius:5px;border-width:2px;padding:4px;margin-top:4px;text-align:left;font-size:110%;"><b class="evaluation_headline" style="display:block;">No report yet</b></div>
<% } %>
