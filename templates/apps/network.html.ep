<% my $t = sub { &subs::lang($_[0]) }; %>
<% my $devices = eval { &subs::device_lister(&subs::rightNow(), 'list') } || []; %>
<% my $groups = eval { &subs::network_groups($devices) } || []; %>
<style>
	.network_app { display:flex; flex-direction:column; gap:10px; width:100%; height:100%; min-width:0; padding:10px 12px 18px; box-sizing:border-box; overflow-y:auto; color:var(--ink); }
	.network_bar { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
	.network_title { font-size:18px; font-weight:700; }
	.network_status { opacity:.7; font-size:12px; }
	.network_section { border:1px solid var(--line); border-radius:calc(var(--jawnos-corner, 12px) * .55); background:var(--panel); padding:0; overflow:hidden; }
	.network_section_head { display:flex; align-items:center; gap:8px; flex-wrap:wrap; padding:8px 10px; border-bottom:1px solid var(--line); background:var(--panel-2, var(--panel)); }
	.network_section_head h3, .network_section_head h4 { margin:0; font-size:14px; }
	.network_section_head .network_button { margin-left:auto; }
	.network_section_head .network_button + .network_button { margin-left:0; }
	.network_section_body { padding:8px 10px 10px; }
	.network_button { font:inherit; font-size:12px; padding:4px 10px; cursor:pointer; color:inherit; border:1px solid var(--line); border-radius:calc(var(--jawnos-corner, 12px) * .4); background:var(--panel); }
	.network_button:hover { background:var(--line); }
	.network_button[disabled] { opacity:.45; cursor:default; }
	.network_button.network_off { color:#a33; }
	.network_table_wrap { width:100%; overflow-x:auto; }
	.network_table { width:100%; border-collapse:collapse; font-size:12px; }
	.network_table th, .network_table td { border:1px solid var(--line); padding:5px 7px; text-align:left; vertical-align:top; }
	.network_table th { background:var(--panel-2, var(--panel)); font-size:11px; white-space:nowrap; }
	.network_table tr:nth-child(2n) td { background:var(--panel-2, var(--panel)); }
	.network_table .network_button { padding:1px 6px; font-size:11px; margin-left:5px; }
	.network_mono { font-family:var(--mono-font, monospace); }
	.network_pill { display:inline-block; padding:1px 8px; border-radius:10px; border:1px solid var(--line); background:var(--panel-2, var(--panel)); font-size:11px; white-space:nowrap; }
	.network_pill.network_up { color:#2f8f6d; border-color:#2f8f6d; }
	.network_pill.network_down { opacity:.65; }
	.network_empty { opacity:.6; font-size:12px; padding:10px 4px; text-align:center; }
	.network_list { display:flex; flex-direction:column; gap:6px; margin:8px 0 0; }
	.network_wifi_row, .network_vpn_card, .network_android_row { display:flex; align-items:center; gap:8px; flex-wrap:wrap; border:1px solid var(--line); border-radius:calc(var(--jawnos-corner, 12px) * .45); padding:7px 9px; background:var(--panel); }
	.network_wifi_name, .network_vpn_name { font-weight:700; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; flex:1 1 120px; }
	.network_signal { flex:0 0 auto; font-family:var(--mono-font, monospace); letter-spacing:1px; }
	.network_wifi_pass { flex:1 1 120px; min-width:100px; font:inherit; font-size:12px; padding:3px 6px; color:inherit; border:1px solid var(--line); border-radius:6px; background:var(--panel); }
	.network_wifi_msg { flex:1 1 100%; font-size:11px; opacity:.75; }
	.network_vpn_card { align-items:flex-start; }
	.network_vpn_card h5 { margin:0 0 2px; font-size:13px; }
	.network_vpn_line { font-size:12px; opacity:.85; }
	.network_dev_note { font-size:11px; opacity:.7; margin:8px 0 0; }
	.network_android_list { display:flex; flex-direction:column; gap:6px; margin:8px 0 0; }
	@media (max-width:640px) {
		#network_interfaces_section .network_table th:nth-child(3), #network_interfaces_section .network_table td:nth-child(3),
		#network_interfaces_section .network_table th:nth-child(6), #network_interfaces_section .network_table td:nth-child(6),
		#network_interfaces_section .network_table th:nth-child(7), #network_interfaces_section .network_table td:nth-child(7) { display:none; }
	}
</style>
<div class="network_app" id="network_app"
	data-connect="<%= $t->('network.connect') %>"
	data-disconnect="<%= $t->('network.disconnect') %>"
	data-forget="<%= $t->('network.forget') %>"
	data-scan="<%= $t->('network.scan') %>"
	data-passphrase="<%= $t->('network.passphrase') %>"
	data-refresh="<%= $t->('network.refresh') %>">

	<div class="network_bar">
		<span class="network_title"><%= $t->('network') %></span>
		<span id="network_status_line" class="network_status"></span>
		<button type="button" id="network_refresh" class="network_button" data-label="<%= $t->('network.refresh') %>"><%= $t->('network.refresh') %></button>
	</div>

	<section class="network_section" id="network_interfaces_section">
		<div class="network_section_head"><h3><%= $t->('network.interfaces') %></h3></div>
		<div class="network_section_body">
			<div class="network_table_wrap">
				<table class="network_table">
					<thead>
						<tr>
							<th><%= $t->('network.interface') %></th>
							<th><%= $t->('network.state') %></th>
							<th><%= $t->('network.mac') %></th>
							<th><%= $t->('network.ipv4') %></th>
							<th><%= $t->('network.ipv6') %></th>
							<th><%= $t->('network.method') %></th>
							<th><%= $t->('network.rx') %> / <%= $t->('network.tx') %></th>
						</tr>
					</thead>
					<tbody id="network_interfaces_body">
						<tr><td colspan="7" class="network_empty"><%= $t->('network.no_interfaces') %></td></tr>
					</tbody>
				</table>
			</div>
		</div>
	</section>

	<section class="network_section" id="network_wifi_section">
		<div class="network_section_head">
			<h3><%= $t->('network.wifi') %></h3>
			<button type="button" id="network_radio_toggle" class="network_button" aria-pressed="false"><%= $t->('network.radio') %></button>
			<button type="button" id="network_wifi_scan" class="network_button" data-label="<%= $t->('network.scan') %>"><%= $t->('network.scan') %></button>
			<button type="button" id="network_wifi_disconnect" class="network_button" data-label="<%= $t->('network.disconnect') %>"><%= $t->('network.disconnect') %></button>
		</div>
		<div class="network_section_body">
			<span id="network_wifi_hint" class="network_status"></span>
			<div id="network_wifi_state" class="network_list"></div>
			<div id="network_wifi_list" class="network_list">
				<div class="network_empty"><%= $t->('network.no_wifi') %></div>
			</div>
			<h4 style="margin:12px 0 0;font-size:13px;"><%= $t->('network.saved') %></h4>
			<div id="network_saved_list" class="network_list">
				<div class="network_empty"><%= $t->('network.no_saved') %></div>
			</div>
		</div>
	</section>

	<section class="network_section" id="network_vpn_section">
		<div class="network_section_head"><h3><%= &subs::lang('vpn') %></h3></div>
		<div class="network_section_body">
			<div id="network_vpn_content" class="network_list">
				<div class="network_empty"><%= $t->('network.no_vpn') %></div>
			</div>
		</div>
	</section>

	<section class="network_section" id="network_devices_section">
		<div class="network_section_head">
			<h3><%= $t->('network.devices') %></h3>
			<button type="button" id="network_open_dev" class="network_button" data-label="<%= $t->('network.open_dev') %>"><%= $t->('network.open_dev') %></button>
		</div>
		<div class="network_section_body">
			<div class="network_table_wrap">
				<table class="network_table">
					<thead>
						<tr><th><%= $t->('network.peers') %></th><th><%= $t->('network.address') %></th><th><%= $t->('network.interface') %></th></tr>
					</thead>
					<tbody>
						<% my $seen = 0; %>
						<% foreach my $group ( @{$groups} ) { %>
							<% next unless ref $group eq 'HASH'; %>
							<% foreach my $member ( @{ $group->{'members'} || [] } ) { %>
								<% next unless ref $member eq 'HASH'; %>
								<% $seen++; %>
								<tr>
									<td>
										<% if ($member->{'hostname'}) { %><%= &subs::format_name($member->{'hostname'}) %><% } %>
										<% if ($member->{'domain'}) { %><br><span style="opacity:.65;font-size:11px;"><%= $member->{'domain'} %></span><% } %>
									</td>
									<td class="network_mono"><%= $member->{'ip'} || '' %></td>
									<td><%= $member->{'nic'} || '' %></td>
								</tr>
							<% } %>
						<% } %>
						<% unless ($seen) { %>
							<tr><td colspan="3" class="network_empty"><%= $t->('network.no_peers') %></td></tr>
						<% } %>
					</tbody>
				</table>
			</div>
			<p class="network_dev_note"><%= $t->('network.dev_note') %></p>
		</div>
	</section>

	<section class="network_section" id="network_android_section" style="display:none;">
		<div class="network_section_head"><h3><%= $t->('network.android') %></h3></div>
		<div class="network_section_body">
			<div id="network_android_status" class="network_list"></div>
			<div class="network_row" style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px;">
				<button type="button" id="network_android_scan" class="network_button" data-label="<%= $t->('network.scan') %>"><%= $t->('network.scan') %></button>
				<button type="button" id="network_android_disconnect" class="network_button" data-label="<%= $t->('network.disconnect') %>"><%= $t->('network.disconnect') %></button>
				<button type="button" id="network_android_wifi_settings" class="network_button" data-label="<%= $t->('network.wifi_settings') %>"><%= $t->('network.wifi_settings') %></button>
				<button type="button" id="network_android_vpn_settings" class="network_button" data-label="<%= $t->('network.vpn_settings') %>"><%= $t->('network.vpn_settings') %></button>
			</div>
			<div id="network_android_networks" class="network_android_list"></div>
		</div>
	</section>
</div>
