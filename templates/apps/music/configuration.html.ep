<% my $remote_machines = &subs::remote_machine_lister(); %>
<% my @machines; my %seen_machine; my $self_signatorial = &subs::signatorial_designer(); %>
<% foreach my $rm ( @{$remote_machines} ) {
	# remote_machine_lister puts a synthetic 'me' row (hostname me, ip
	# 127.0.0.1) first for the machine pickers. The local output is the real
	# Me button above; this row is not a peer, and its 127.0.0.1 key can be
	# the same key as a peer reached over loopback - on the phone that made a
	# second 'me' button whose output actually went to the laptop. Leave it out.
	next if ($rm->{'hostname'} || '') eq 'me' && ($rm->{'ip'} || '') eq '127.0.0.1';
	next if $self_signatorial && ($rm->{'signatorial'} || '') eq $self_signatorial;
	my $key = $rm->{'uuid'} || $rm->{'signatorial'} || $rm->{'ip'};
	next if !$key || $seen_machine{$key};
	$seen_machine{$key} = 1;
	push @machines, $rm;
} %>
<% my $remote_listed = 0; %>
<% if ($crate->{'remote_uuid'}) { foreach my $rm ( @machines ) { $remote_listed = 1 if $rm->{'uuid'} && $rm->{'uuid'} eq $crate->{'remote_uuid'}; } } %>
<% my $layout = $crate->{'settings'}->{'layout'} || 'list'; %>
<% my $library = $crate->{'settings'}->{'library'} || 'local'; %>
<% my $normalize = $crate->{'settings'}->{'normalize'} || 'off'; %>
<button type="button" id="music_configuration_close" class="music_cfg_close hover" hint="Close" aria-label="Close">&times;</button>
<div class="music_cfg_section">
	<h4 class="music_cfg_heading"><%= &subs::lang('music.folders') %></h4>
	<div id="music_folders" class="music_cfg_chips">
		<% foreach my $f ( sort keys %{$folders->{$device}} ) { %>
			<% next unless $f =~ /location$/gi; %>
			<% my $n = $f; $n =~ s/_location//gi; %>
			<% my $status = &subs::setting_grabber({ app => 'music_folder_toggle', setting => $f }) // ''; %>
			<button type="button" location="<%= $f %>" status="<%= $status %>" class="button music_folder_toggle hover"><%= &subs::format_name($n) %></button>
		<% } %>
		<% my $archive_status = &subs::setting_grabber({ app => 'music', setting => 'archive' }) // ''; %>
		<button type="button" status="<%= $archive_status %>" class="button music_archive_toggle hover"><%= &subs::ui('Archives') %></button>
	</div>
</div>
<div class="music_cfg_section">
	<h4 class="music_cfg_heading"><%= &subs::lang('music.output') %></h4>
	<div id="music_audio_output" class="music_cfg_chips">
		<% foreach my $ma ( qw/me srv/ ) { %>
			<button class="music_audio_output_select hover" state="<%= $mao->{$ma} %>" value="<%= $ma %>"><%= &subs::format_name($ma) %></button>
		<% } %>
		<% foreach my $rm ( @machines ) { %>
			<button class="music_audio_output_select hover" state="<%= $mao->{$rm->{'fqdn'} || $rm->{'ip'}} %>" value="<%= $rm->{'fqdn'} || $rm->{'ip'} %>"><%= $rm->{'hostname'} || $rm->{'fqdn'} || $rm->{'ip'} %></button>
		<% } %>
	</div>
</div>
<div class="music_cfg_section">
	<h4 class="music_cfg_heading"><%= &subs::lang('music.playback') %></h4>
	<div class="music_cfg_fields">
		<div class="music_cfg_field">
			<label class="music_cfg_label" for="music_layout_select"><%= &subs::lang('music.layout') %></label>
			<select id="music_layout_select" value="<%= $layout %>">
				<% foreach my $lay ( qw/list icons/ ) { %>
					<option value="<%= $lay %>" <% if ($lay eq $layout) { %>selected<% } %>><%= &subs::format_name($lay) %></option>
				<% } %>
			</select>
		</div>
		<div class="music_cfg_field">
			<label class="music_cfg_label" for="music_library_select"><%= &subs::lang('music.library') %></label>
			<select id="music_library_select" value="<%= $library %>">
				<% if ($crate->{'remote_uuid'} && !$remote_listed) { %>
					<option value="<%= $crate->{'remote_uuid'} %>" <% if ($library eq $crate->{'remote_uuid'}) { %>selected<% } %>><%= $crate->{'remote_hostname'} || $crate->{'remote_uuid'} %></option>
				<% } %>
				<option value="none"><%= &subs::ui('None') %></option>
				<option value="local" <% if ($library eq 'local' || $library eq '') { %>selected<% } %>><%= &subs::ui('Local') %></option>
				<% foreach my $rm ( @machines ) { %>
					<option value="<%= $rm->{'uuid'} %>" <% if ($library eq $rm->{'uuid'}) { %>selected<% } %>><%= $rm->{'hostname'} %></option>
				<% } %>
			</select>
		</div>
		<div class="music_cfg_field music_cfg_field_wide">
			<label class="music_cfg_label" for="music_normalize_select" hint="Volume normalization"><%= &subs::lang('music.normalize') %></label>
			<select id="music_normalize_select" hint="Make quiet and loud tracks play at a similar level">
				<% foreach my $level ( qw/off slight mild aggressive/ ) { %>
					<option value="<%= $level %>" <% if ($level eq $normalize) { %>selected<% } %>><%= &subs::lang('music.normalize_' . $level) %></option>
				<% } %>
			</select>
		</div>
	</div>
</div>
<div class="music_cfg_section">
	<h4 class="music_cfg_heading"><%= &subs::lang('music.device_volume') %></h4>
	<div class="music_cfg_device_volume">
		<span id="device_volume_control"></span>
	</div>
</div>
<script>
	volumeChecker();
	clearInterval(volumeInterval);
	volumeInterval = setInterval(function() {
		if ($('#device_volume_control').is(':visible')) {
			volumeChecker();
		}
	},15000);
</script>
