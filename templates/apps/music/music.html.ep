% title 'Music Player';
<% use Mojo::JSON qw/encode_json decode_json/; %>
<% my $padlock_sighting = eval { return decode_json &subs::setting_grabber({app => '__president', setting => 'padlock_contexts' }) } || [];
	@{$padlock_sighting} = grep { $_ eq 'music' } @{$padlock_sighting};
%>
<% my $background_colour = &subs::setting_grabber({ app => 'misc', setting => 'manager_background_colour'}); %>
<%# the shelf heights the last resize left behind; the template wears them so a
    search render comes back the size it went out (see musicWindowResizes) %>
<% my $shelf_height = eval { $resizes->{'music_albums'}->{'height'} } || 125; %>
<%# a phone draws its own window: the two shelves become one-line strips and
    the list runs the whole way down to the player (apps/music/files draws the
    list for it; music.css dresses both). The mark rides on #music because the
    window's own script has to leave this geometry alone on a phone -
    musicInit otherwise lays the desktop's saved shelf sizes over it. The
    navbar-relative tops answer to the navbar height setting, the same way the
    window's own contents do. %>
<% my $phone_layout = (($device // '') eq 'mobile') ? 1 : 0; %>
<div id="music" class="theme_surface" background_colour="<%= $background_colour %>" current_track="<%= $crate->{'current_track'} %>" phone_layout="<%= $phone_layout ? 'yes' : 'no' %>" normalize="<%= $crate->{'settings'}->{'normalize'} || 'off' %>" lip_sync="<%= $crate->{'settings'}->{'lip_sync'} || 'off' %>" stream_codec="<%= $crate->{'settings'}->{'stream_codec'} || 'pcm' %>" style="max-height:100%;width:100%;background-color:<%= $background_colour %>" unlock="<%= $crate->{'unlock'} || '' %>">
	<%# left empty on purpose: the player is restored from the live cache, not a
	    snapshot frozen into this cached window (see musicContentCache in music.js) %>
	<div id="music_player_data" style="display:none;"></div>
	<div id="interface" class="theme_surface" style="position:absolute;top:0px;background-color:<%= $background_colour %>; width:100%;	<% unless ($window_maker ne 'yes') { %>position:sticky;<% } %>">

		<div id="audio_controls">
			<span id="music_search_wrap">
				<input id="music_search" value="<%= $search %>" placeholder="Search">
				<span id="music_library_name" hint="<%= &subs::ui('The library this Music window is showing') %>"><%= &subs::ui('Library') %>: <%= $crate->{'library_name'} || &subs::ui('Local') %></span>
			</span>
			<span id="progress_readout"><span id="elapsed_progress"></span>/<span id="total_progress"></span></span>
			<span id="music_volume_group">
				<img id="music_mute" hint="Mute" class="hover little_thumb music_mute" muted="no"
					speaker_icon="<%= &subs::icon_for('/images/decipherable/speaker.png') %>"
					mute_icon="<%= &subs::icon_path('mute', '/images/studio/mute.png') %>"
					src="<%= &subs::icon_for('/images/decipherable/speaker.png') %>" />
				<input id="music_volume" class="music_volume" type="range" min="0" max="1" step="0.01" value="1" hint="Volume">
			</span>
			<span id="music_interface_options">
				<% if (scalar @{$padlock_sighting} > 0) { %>
					<img src="<%= &subs::icon_for("/images/jbuttons/padlock unlock.png") %>" hint="Lock" class="hover little_thumb music music_lock" id="music_padlock_toggle" style="<% if ($crate->{'unlocked'}) { %>background-color:red;<% } %>">
				<% } %>
				<img src="<%= &subs::icon_path('equalizer', '/images/decipherable/equalizer.svg') %>" hint="<%= &subs::lang('music.audio') %>" class="little_thumb hover" id="music_audio_toggle">
				<img src="<%= &subs::icon_path('gear', '/images/decipherable/gear.png') %>" hint="Configure" class="little_thumb hover" id="music_configuration_toggle">
			</span>

			<span style="display:none;">
				<span style="float:left;width:70%;">
					<progress value="0" id="progress_bar" data-label="Progress"></progress>
				</span>
			</span>

		</div>
	</div>
	<div id="music_library">
		<div id="music_artists" style="<% if ($phone_layout) { %>width:100%;height:34px;top:calc(var(--navbar_h, 36px) + 60px);position:absolute;overflow-x:auto;overflow-y:hidden;left:0px;background-color:var(--panel);<% } else { %>width:50%;height:<%= $shelf_height %>px;top:100px;position:absolute;overflow:scroll;left:0px;background-color:var(--panel);<% } %>">
			<button id="all_music_artists" class="all_music" library="artists" style="<% if ($phone_layout) { %>margin:0px 3px;vertical-align:middle;<% } else { %>position:absolute;right:20px;top:1px;<% } %>" enabled="<% if ($crate->{'settings'}->{'all_artists'} eq 'yes') { %>yes<% } else { %>no<% } %>">All</button>
			<% foreach my $art ( sort keys %{$crate->{'artists'}} ) { %>
				<% if ($crate->{'artists'}->{$art}->{'path'}) { %>
					<span class="hover music_artist" path="<%= $crate->{'artists'}->{$art}->{'path'} %>" artist="<%= $art %>" active="<% if ( grep { $_->{'artist'} eq $art } @{$crate->{'artist'}} ) { %>yes<% } else { %>no<% } %>"> 
						<%= &subs::format_name($art) %>
					</span>
					<br>
				<% } %>
			<% } %>
		</div>
		<div id="music_albums" style="<% if ($phone_layout) { %>width:100%;height:34px;top:calc(var(--navbar_h, 36px) + 96px);position:absolute;overflow-x:auto;overflow-y:hidden;left:0px;background-color:var(--panel);<% } else { %>width:50%;height:<%= $shelf_height %>px;top:100px;position:absolute;overflow:scroll;left:50%;background-color:var(--panel);<% } %>">
			<button id="all_music_albums" class="all_music" library="albums" style="<% if ($phone_layout) { %>margin:0px 3px;vertical-align:middle;<% } else { %>position:absolute;right:20px;top:1px;<% } %>" enabled="<% if ($crate->{'settings'}->{'all_albums'} eq 'yes') { %>yes<% } else { %>no<% } %>">All</button>
			<% foreach my $alb ( sort keys %{$crate->{'albums'}} ) { %>
				<% if ($crate->{'albums'}->{$alb}->{'path'}) { %>
					<span class="hover music_album" path="<%= $crate->{'albums'}->{$alb}->{'path'} %>" album="<%= $alb %>" active="<% if ( grep { $_->{'album'} eq $alb } @{$crate->{'album'}} ) { %>yes<% } else { %>no<% } %>">
						<%= &subs::format_name($alb) %>
					</span>
					<br>
				<% } %>
			<% } %>
		</div>

		<div id="music_files" style="<% if ($phone_layout) { %>width:100%;bottom:110px;top:calc(var(--navbar_h, 36px) + 134px);position:absolute;overflow:auto;<% } else { %>width:100%;bottom:110px;top:<%= $shelf_height + 100 %>px;position:absolute;overflow:scroll;<% } %>">
			%= include 'apps/music/files', phone => $phone_layout
		</div>

	</div>
	<div id="music_configuration" class="music_cfg_drawer" remote_uuid="<%= $crate->{'remote_uuid'} %>" style="display:none;">
		<% if ($crate->{'remote_uuid'}) { %>
			<%# a remote library is still configured from this machine - the panel is
			    fetched from home when the gear is first opened %>
		<% } else { %>
			<%= include 'apps/music/configuration' %>
		<% } %>
	</div>
	<div id="music_audio_panel" class="music_cfg_drawer" style="display:none;"></div>

	<div id="music_theatre" style="bottom:0px;">
	 <%= include 'apps/video',
			id => 'video',
			source => 'music',
			crate => $crate,
			misses => $misses
	 %>
	</div>

</div>
<div id="music_padlock" style="display:none;width:100%;background-color:black;height:100%;max-height:100%;top:60px;object-fit:contain;">
	<img src="<%= &subs::icon_path('cancel_button', '/images/make believe/cancel_button.png') %>" hint="Close" class="little_thumb" id="music_cancel_padlock" style="position:absolute;top:35px;right:5px;">
	<%= include 'padlock', mode => 'music', fingerprint => 1 %>
</div>

<script>
	mao = JSON.parse('<%== $jmao %>');
</script>

