<% use Mojo::Util qw/term_escape html_unescape url_unescape url_escape/; %>
<% use Mojo::JSON qw/encode_json decode_json/; %>
<%# The whole list is a window over the queue now. The server draws only the
    slice it was asked for (crate->{songs}) and describes the rest of the queue
    in #music_queue_data. music.js renders a slice near the viewport and asks
    /music/window for the next one; the player's queue comes from the manifest,
    not from whichever cards happen to be mounted.

    Five thousand rows drawn at once measured 17.4 MB of HTML, 365,008 elements
    and 3.1-3.8 s of parse+DOM build in this WebEngine. The same 5,000 without
    the inlined details panel is 9.3 MB and 80,008; only the window keeps that
    bounded no matter how long the queue is. %>
<% my $layout = $crate->{'settings'}->{'layout'} || 'list'; %>
<% my $phone_layout = $phone ? 1 : 0; %>
<% my $songs = $crate->{'songs'} || []; %>
<% my $manifest = $crate->{'manifest'} || []; %>
<% my $total = defined $crate->{'queue_total'} ? $crate->{'queue_total'} : scalar @{$songs}; %>
<% my $offset = $crate->{'window_offset'} || 0; %>
<% my $limit = $crate->{'window_limit'} || scalar @{$songs}; %>
<% my $queue_json = &subs::json_chars({ total => $total, offset => $offset, limit => $limit, songs => $manifest }); %>
<%# a filename may carry anything, including the bytes that would close the
    script element; the JSON is HTML-safe once a '<' can never begin an end tag %>
<% $queue_json =~ s{</}{<\\/}g; %>
<div id="files" style="background-color:var(--panel); width:100%; max-width:100%; text-align:left;<% if ($phone_layout) { %> overflow:visible; border:none; border-radius:0;<% } else { %> overflow:auto;<% } %>">
	<% if (scalar @{$songs} > 0) { %>
		<div id="music_window" class="<%= ($layout eq 'icons') ? 'music_grid' : 'music_list' %>" data-total="<%= $total %>" data-offset="<%= $offset %>" data-limit="<%= $limit %>">
			<%= include 'apps/music/track_rows', songs => $songs, crate => $crate, offset => $offset %>
		</div>
	<% } %>
</div>
<script type="application/json" id="music_queue_data" token="<%= $crate->{'queue_token'} || '' %>"><%== $queue_json %></script>
