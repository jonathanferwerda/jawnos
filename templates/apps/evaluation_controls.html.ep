<% use Mojo::JSON qw/decode_json/; %>
<%# the evaluation's controls, kept apart from its report: the button that runs
    one now, the cadence it runs on its own (hourly..yearly, or every run, with
    the days for daily and weekly), and the durable note of what the last run
    did. They sit folded beneath the report at the foot of the app, and in the
    system settings for the whole house. %>
<button class="system_evaluation" app="<%= $app %>" >Evaluate</button>
<%# how much the answer carries: brief is a single headline line (cheap, for a
    daily run), full is the whole report %>
<% my $eval_depth = (&subs::setting_grabber({ app => $app || '__president', setting => 'evaluation_depth' }) || 'full'); %>
<select class="evaluation_depth" app="<%= $app || '__president' %>" hint="brief: a single headline line (cheap, for a daily run); full: the whole report" style="vertical-align:bottom;">
	<% foreach my $d ( qw/full brief/ ) { %>
		<option value="<%= $d %>" <% if ($eval_depth eq $d) { %>selected<% } %>><%= &subs::format_name($d) %></option>
	<% } %>
</select>
<%# the setting is the wish and the schedule is the mechanism: the worker puts the
    schedule back from the setting at boot, so the cadence survives a restart.
    The timed cadences (hourly..yearly) become a cron; each_run queues a run
    whenever the appointment itself runs. The old nightly checkbox reads as daily
    through evaluation_cadence %>
<% my $run_scope = $app || '__president'; %>
<% my $cadence = &subs::evaluation_cadence($run_scope); %>
<select class="evaluation_cadence" app="<%= $run_scope %>" hint="How often the evaluation runs on its own; Every Run queues one whenever the appointment runs" style="vertical-align:bottom;">
	<% foreach my $c ( qw/off hourly daily weekly monthly yearly each_run/ ) { %>
		<option value="<%= $c %>" <% if ($cadence eq $c) { %>selected<% } %>><%= $c eq 'each_run' ? 'Every Run' : &subs::format_name($c) %></option>
	<% } %>
</select>
<%# the days it runs on when the cadence is daily or weekly. All is the wish to
    run every day; a blank legacy value also reads as All, because that is what a
    blank meant before the change. "none" (written by clearing All) stops the
    scheduled runs without turning the cadence off. %>
<% my $days_setting = &subs::setting_grabber({ app => $run_scope, setting => 'nightly_evaluation_days' }); %>
<% my $days_none = (defined $days_setting && $days_setting =~ /^\s*none\s*$/i) ? 1 : 0; %>
<% my @nightly_days = $days_none ? () : @{ &subs::nightly_evaluation_days($run_scope) }; %>
<% my $days_all = (!$days_none && (!scalar @nightly_days || scalar(@nightly_days) == 7)) ? 1 : 0; %>
<% my @days_shown = $days_all ? (0 .. 6) : @nightly_days; %>
<label class="nightly_evaluation_days_all_label" style="font-size:80%;vertical-align:bottom;margin-right:4px;white-space:nowrap;" hint="Run every day; clear it to pick particular days, or to stop the scheduled runs"><input type="checkbox" class="nightly_evaluation_days_all" app="<%= $run_scope %>"<% if ($days_all) { %> checked<% } %>> <%= &subs::lang('common.all') %></label>
<select multiple class="nightly_evaluation_days" app="<%= $run_scope %>" hint="The days the evaluation runs on, for daily or weekly. All runs every day; clear it and pick days to narrow it, or leave the list empty to stop the scheduled runs" style="vertical-align:bottom;height:70px;">
	<% my @day_names = qw/sunday monday tuesday wednesday thursday friday saturday/; %>
	<% foreach my $d ( 0 .. 6 ) { %>
		<option value="<%= $d %>" <% if (grep { $_ == $d } @days_shown) { %>selected<% } %>><%= &subs::format_name($day_names[$d]) %></option>
	<% } %>
</select>
<%# when the next scheduled run is due, so the cadence is easy to read at a glance %>
<% my $eval_schedule = &subs::nightly_evaluation_schedule($run_scope); %>
<% if ($eval_schedule && $eval_schedule->{'next_run'}) { %>
	<span class="evaluation_next_run" style="font-size:80%;vertical-align:bottom;">Next run <b class="time" timestamp="<%= $eval_schedule->{'next_run'} * 1000 %>"></b></span>
<% } %>
<%# how much history the evaluation reads is no longer chosen: every run weighs
    day, week, month, year and all time together, since a change of pace only
    shows across the spans %>
<% my $run_app = $app || '__president'; %>
<% my $runs = eval { return decode_json(&subs::setting_grabber({ app => $run_app, setting => 'evaluation_runs' }) || '') } || []; %>
<% my $last_run = $runs->[0] || {}; %>
<% if ($last_run->{'timestamp'}) { %>
	<div class="evaluation_last_run" app="<%= $run_app %>" style="font-size:80%;margin-top:2px;">
		Last run: <b><%= $last_run->{'machine'} || 'a machine' %></b> <%= $last_run->{'outcome'} || '' %>
		<span class="time" timestamp="<%= $last_run->{'timestamp'} %>"></span><% if ($last_run->{'model'}) { %> (<%= $last_run->{'model'} %>)<% } %><% if ($last_run->{'note'}) { %> &mdash; <%= $last_run->{'note'} %><% } %>
	</div>
<% } %>
