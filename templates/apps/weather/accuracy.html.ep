<div id="weather_accuracy_panel" class="weather_panel" style="display:none;">
	<div class="weather_controls">
		<label for="weather_accuracy_source"><%= &subs::ui('History source') %></label>
		<select id="weather_accuracy_source"></select>
		<label for="weather_accuracy_range"><%= &subs::ui('Range') %></label>
		<select id="weather_accuracy_range">
			<option value="7"><%= &subs::ui('7 days') %></option>
			<option value="30" selected><%= &subs::ui('30 days') %></option>
			<option value="90"><%= &subs::ui('90 days') %></option>
			<option value="365"><%= &subs::ui('1 year') %></option>
			<option value="all"><%= &subs::ui('All') %></option>
		</select>
		<label for="weather_accuracy_lead"><%= &subs::ui('Lead') %></label>
		<select id="weather_accuracy_lead">
			<option value="1">1 <%= &subs::ui('day') %></option>
			<option value="2">2 <%= &subs::ui('days') %></option>
			<option value="3">3 <%= &subs::ui('days') %></option>
			<option value="4">4 <%= &subs::ui('days') %></option>
			<option value="5">5 <%= &subs::ui('days') %></option>
			<option value="6">6 <%= &subs::ui('days') %></option>
			<option value="7">7 <%= &subs::ui('days') %></option>
		</select>
		<span id="weather_accuracy_status" class="weather_muted"></span>
	</div>
	<div id="weather_accuracy_note" class="weather_muted"></div>
	<div id="weather_accuracy_summary" class="weather_table_wrap"></div>
	<div id="weather_accuracy_detail" class="weather_table_wrap"></div>
</div>
