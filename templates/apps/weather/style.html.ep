<style>
.wind[app="weather"] #weather {
	box-sizing: border-box;
	width: 100%;
	height: 100%;
	display: flex;
	flex-direction: column;
	gap: 9px;
	padding: 9px;
	background-color: var(--panel);
	overflow-y: auto;
}
.wind[app="weather"] #weather_toolbar,
.wind[app="weather"] #weather_actions {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	gap: 7px;
	font-size: 14px;
}
.wind[app="weather"] #weather_toolbar {
	position: sticky;
	top: 0;
	z-index: 3;
	background: var(--panel);
}
.wind[app="weather"] #weather_toolbar label { opacity: .75; }
.wind[app="weather"] #weather_device { max-width: 100%; }
.wind[app="weather"] #weather_status { opacity: .68; font-size: 12px; }
.wind[app="weather"] .weather_card {
	border: 1px solid var(--line);
	border-radius: 10px;
	padding: 10px;
	background-color: var(--panel);
}
.wind[app="weather"] #weather_now {
	display: flex;
	flex-wrap: wrap;
	align-items: flex-start;
	gap: 12px;
}
.wind[app="weather"] #weather_now_main { flex: 1 1 240px; min-width: 0; }
.wind[app="weather"] #weather_place { font-size: 15px; opacity: .78; }
.wind[app="weather"] #weather_temp { font-size: 54px; font-weight: 700; line-height: 1; margin: 2px 0; }
.wind[app="weather"] #weather_cond { font-size: 18px; }
.wind[app="weather"] #weather_glyph { font-size: 58px; line-height: 1; }
.wind[app="weather"] #weather_stats {
	flex: 1 1 240px;
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(105px, 1fr));
	gap: 5px 12px;
	font-size: 13px;
}
.wind[app="weather"] .weather_stat b { display: block; font-size: 11px; font-weight: 500; opacity: .58; text-transform: uppercase; letter-spacing: .04em; }
.wind[app="weather"] #weather_hourly_title, .wind[app="weather"] #weather_daily_title {
	font-size: 12px;
	text-transform: uppercase;
	letter-spacing: .06em;
	opacity: .62;
	padding-top: 2px;
}
.wind[app="weather"] #weather > * { flex: 0 0 auto; }
.wind[app="weather"] #weather_hourly {
	display: flex;
	gap: 6px;
	overflow-x: auto;
	overscroll-behavior-x: contain;
	-webkit-overflow-scrolling: touch;
	scrollbar-width: thin;
	min-height: 96px;
	padding-bottom: 5px;
}
.wind[app="weather"] .weather_hour {
	flex: 0 0 auto;
	min-width: 62px;
	text-align: center;
	border: 1px solid var(--line);
	border-radius: 9px;
	padding: 6px 4px;
	font-size: 12px;
}
.wind[app="weather"] .weather_hour .weather_hour_glyph { font-size: 24px; line-height: 1.1; }
.wind[app="weather"] .weather_hour .weather_hour_temp { font-size: 15px; font-weight: 600; }
.wind[app="weather"] .weather_hour .weather_hour_precip { opacity: .62; font-size: 11px; }
.wind[app="weather"] #weather_daily { display: flex; flex-direction: column; gap: 4px; }
.wind[app="weather"] .weather_day_wrap { display: flex; flex-direction: column; }
.wind[app="weather"] .weather_day {
	display: grid;
	grid-template-columns: minmax(94px, 1.1fr) 30px minmax(62px, .7fr) 1fr;
	align-items: center;
	gap: 8px;
	border-top: 1px solid var(--line);
	padding: 6px 2px;
	font-size: 13px;
}
.wind[app="weather"] .weather_day_wrap:first-child .weather_day { border-top: 0; }
.wind[app="weather"] .weather_day.weather_day_toggle { cursor: var(--jawnos-cursor-pointer, pointer); position: relative; padding-right: 18px; }
.wind[app="weather"] .weather_day.weather_day_toggle::after {
	content: '▸';
	position: absolute;
	right: 3px;
	top: 50%;
	transform: translateY(-50%);
	font-size: 11px;
	opacity: .45;
}
.wind[app="weather"] .weather_day.weather_day_toggle[aria-expanded="true"]::after { transform: translateY(-50%) rotate(90deg); }
.wind[app="weather"] .weather_day.weather_day_toggle[aria-expanded="true"] { background-color: rgba(127, 127, 127, .06); }
.wind[app="weather"] .weather_day.weather_day_toggle:focus-visible { outline: 2px solid var(--accent, currentColor); outline-offset: 2px; border-radius: 6px; }
.wind[app="weather"] .weather_day_detail { display: none; flex-direction: column; gap: 7px; padding: 3px 2px 10px; }
.wind[app="weather"] .weather_day_detail.open { display: flex; }
.wind[app="weather"] .weather_day_chart svg { width: 100%; height: 120px; display: block; }
.wind[app="weather"] .weather_day_summary { display: flex; flex-direction: column; gap: 3px; font-size: 12px; opacity: .8; }
.wind[app="weather"] .weather_day_hours { display: flex; gap: 6px; overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: thin; padding-bottom: 3px; }
.wind[app="weather"] .weather_day_hours .weather_hour_wet { border-color: var(--accent, currentColor); }
.wind[app="weather"] .weather_day_hours .weather_hour_wet .weather_hour_precip { opacity: 1; font-weight: 600; }
.wind[app="weather"] .weather_day_meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(105px, 1fr)); gap: 5px 12px; font-size: 13px; }
.wind[app="weather"] .weather_day .weather_day_label { display: flex; flex-direction: column; line-height: 1.15; min-width: 0; }
.wind[app="weather"] .weather_day .weather_day_stamp { font-size: 11px; opacity: .62; font-variant-numeric: tabular-nums; }
.wind[app="weather"] .weather_day .weather_day_glyph { font-size: 22px; text-align: center; }
.wind[app="weather"] .weather_day .weather_day_temps { font-weight: 600; white-space: nowrap; }
.wind[app="weather"] .weather_day .weather_day_text { opacity: .72; min-width: 0; }
.wind[app="weather"] #weather_alerts { display: flex; flex-direction: column; gap: 4px; }
.wind[app="weather"] .weather_alert { border: 1px solid var(--danger, #c0392b); border-radius: 8px; padding: 7px 9px; font-size: 13px; }
.wind[app="weather"] .weather_alert b { display: block; margin-bottom: 2px; }
.wind[app="weather"] #weather_error { border: 1px solid var(--line); border-radius: 9px; padding: 10px; opacity: .82; }
.wind[app="weather"] .weather_muted { opacity: .6; font-size: 12px; }

.wind[app="weather"] #weather_tabs {
	display: flex;
	gap: 4px;
	border-bottom: 1px solid var(--line);
	padding-bottom: 4px;
}
.wind[app="weather"] .weather_tab {
	border: 1px solid var(--line);
	border-bottom: 0;
	border-radius: 8px 8px 0 0;
	background: transparent;
	color: inherit;
	padding: 4px 11px;
	font-size: 13px;
	cursor: var(--jawnos-cursor-pointer, pointer);
	opacity: .68;
}
.wind[app="weather"] .weather_tab.active { opacity: 1; font-weight: 600; background: var(--panel); }
.wind[app="weather"] .weather_panel { display: flex; flex-direction: column; gap: 9px; min-height: 0; }
.wind[app="weather"] .weather_controls { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-size: 13px; }
.wind[app="weather"] .weather_controls label { opacity: .72; }
.wind[app="weather"] #weather_history_chart { padding: 6px; }
.wind[app="weather"] #weather_history_chart svg { width: 100%; height: 170px; display: block; }
.wind[app="weather"] .weather_table_wrap {
	max-height: 380px;
	overflow: auto;
	border: 1px solid var(--line);
	border-radius: 9px;
}
.wind[app="weather"] .weather_table_wrap table,
.wind[app="weather"] #weather_accuracy_summary table,
.wind[app="weather"] #weather_accuracy_detail table {
	width: 100%;
	border-collapse: collapse;
	font-size: 12px;
}
.wind[app="weather"] .weather_table_wrap th,
.wind[app="weather"] #weather_accuracy_summary th,
.wind[app="weather"] #weather_accuracy_detail th {
	text-align: left;
	padding: 5px 6px;
	border-bottom: 1px solid var(--line);
	position: sticky;
	top: 0;
	background: var(--panel);
	font-weight: 600;
}
.wind[app="weather"] .weather_table_wrap td,
.wind[app="weather"] #weather_accuracy_summary td,
.wind[app="weather"] #weather_accuracy_detail td {
	padding: 4px 6px;
	border-bottom: 1px solid var(--line);
	white-space: nowrap;
}
.wind[app="weather"] .weather_match { color: #2e7d32; font-weight: 600; }
.wind[app="weather"] .weather_miss { color: var(--danger, #c0392b); font-weight: 600; }
.wind[app="weather"] .weather_warn { color: var(--danger, #c0392b); }
.wind[app="weather"] .weather_automation_rule {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	gap: 8px;
	border-top: 1px solid var(--line);
	padding: 6px 2px;
	font-size: 13px;
}
.wind[app="weather"] .weather_automation_rule:first-child { border-top: 0; }
.wind[app="weather"] .weather_automation_rule .weather_automation_text { flex: 1 1 220px; min-width: 0; }
.wind[app="weather"] .weather_automation_rule .weather_automation_actions { display: flex; gap: 4px; }
.wind[app="weather"] #weather_automation_form { border: 1px dashed var(--line); border-radius: 9px; padding: 8px; }
.wind[app="weather"] #weather.weather_choosing > :not(#weather_map_view) { display: none; }
.wind[app="weather"] #weather_map_view { display: none; flex-direction: column; gap: 8px; flex: 1 1 auto; min-height: 0; }
.wind[app="weather"] #weather_map_view.open { display: flex; }
.wind[app="weather"] #weather_map_canvas {
	width: 100%;
	flex: 1 1 auto;
	min-height: 320px;
	border: 1px solid var(--line);
	border-radius: 10px;
}
.wind[app="weather"] #weather_map_name { flex: 1 1 180px; min-width: 120px; }
.wind[app="weather"] #weather_map_save[disabled] { opacity: .45; }
.wind[app="weather"] #weather_measure_section { display: flex; flex-direction: column; gap: 9px; border-top: 1px solid var(--line); padding-top: 9px; }
.wind[app="weather"] #weather_measure_form { border: 1px dashed var(--line); border-radius: 9px; padding: 8px; display: flex; flex-direction: column; gap: 7px; }
.wind[app="weather"] .weather_measure_condition { display: flex; flex-wrap: wrap; gap: 5px; align-items: center; }
.wind[app="weather"] .weather_measure_condition select, .wind[app="weather"] .weather_measure_condition input { max-width: 170px; }
</style>
