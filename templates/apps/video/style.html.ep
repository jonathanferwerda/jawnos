	<style>
		#<%= $miss %>_speed {
			appearance: none;
			height: 30px;
			width: 130px;
			border: solid;
			border-radius: 5px;
			border-width: 3px;
			background-color:transparent;
			color: black;
			outline: none;
			vertical-align: middle;
			/* the 130x30 ruler strip; an icon-set icon is a full square, and at its
			   natural size only its empty corner would fall inside this box */
			background-image: url('/images/studio/ruler.png');
			background-size: 100% 100%;
			background-repeat: no-repeat;
		}
		#<%= $miss %>_position {
			position:absolute;
			bottom:95px;
			left: 0px;
			width:98%;
			height:20px;
		}
		#<%= $miss %>_position_preview {
			width: 200px;
			height: 120px;
			/* the seek preview is drawn over the bar and the chapter strip above
			   it; it is the answer to a hover and must never sit under them */
			z-index: 30;
		}
		#<%= $miss %>_back {
			position: absolute;
			left: 220px;
			bottom: 55px;
		}
		#<%= $miss %>_forward {
			position: absolute;
			left: 270px;
			bottom: 55px;
		}
		#<%= $miss %>_full_screen {
			position:absolute;
			left: 56px;
			bottom: 55px;
		}
		#music_list_view {
			position:absolute;
			left: 108px;
			bottom: 55px;
		}
		#music_shuffle {
			bottom:  1px;
			left: 320px;
			position:absolute;
		}
		#music_repeat {
			left: 320px;
			bottom:55px;
			position:absolute;
		}
		#<%= $miss %>_jog_wheel_frame {
			position:absolute;
			right: 10px;
			bottom: 0px;
			height: 90px;
			width: 90px;
		}
		#<%= $miss %>_jog_wheel {
			width: 100%;
			height: 100%;
			border-radius: 50%;
		}
		#<%= $id %>_full_title {
			position:absolute;
			left: 370px;
			right: 130px;
			bottom: 6px;
			max-height: 96px;
			overflow: hidden;
			overflow-wrap: anywhere;
			font-size: 18px;
			line-height: 1.2;
			text-align: center;
			color: yellow;
		}
		#<%= $id %>_time_display {
			position:absolute;
			left: 145px;
			bottom:70px;
			font-size: 24px;
			color: yellow;
		}
		#<%= $id %>_media_information {
			position:absolute;
			left: 85px;
			bottom: 30px;
			font-size: 20px;
			color: yellow;
		}
		#<%= $id %>_mark_information {
			position:absolute;
			left: 150px;
			bottom: 30px;
			font-size: 20px;
			color:yellow;
		}
		#<%= $id %>_subtitle_toggle {
			bottom: 55px;
			left: 160px;
			position: absolute;
		}
		/* the tools toggle and its pop-out: the panel opens above the foot so the
		   grouped controls (speed, snapshot, mark, loop markers) never crowd it */
		#<%= $miss %>_tools_toggle {
			position: absolute;
			bottom: 1px;
			left: 1px;
		}
		.media_tools_toggle.active { background-color: yellow; }
		.media_tools_panel {
			position: absolute;
			bottom: 112px;
			left: 6px;
			display: none;
			flex-wrap: wrap;
			max-width: calc(100% - 12px);
			align-items: center;
			gap: 8px;
			padding: 8px 10px;
			background-color: rgba(20,20,20,.94);
			border: 1px solid #777;
			border-radius: 10px;
			box-shadow: 0 6px 20px rgba(0,0,0,.5);
			z-index: 20;
		}
		.media_tools_panel.shown { display: flex; }
		.media_tools_panel > * { position: static !important; left: auto !important; right: auto !important; top: auto !important; bottom: auto !important; margin: 0; }
		/* The film's chapters, in the theatre or a fullscreen: a row of cards
		   just above the player bar, each as big as the seek preview thumb.
		   music.js fills it from the queue entry and sets the bottom offset so
		   an open tools panel pushes it up rather than under it. The row scrolls
		   sideways when there are more chapters than the window can show. */
		.music_chapters {
			position: absolute;
			left: 8px;
			right: auto;
			bottom: 112px;
			display: none;
			gap: 8px;
			padding: 8px;
			width: max-content;
			max-width: calc(100% - 16px);
			overflow-x: auto;
			overflow-y: hidden;
			white-space: nowrap;
			box-sizing: border-box;
			/* a finger on the row pans the row; it is not a scrub or a volume drag */
			touch-action: pan-x;
			background-color: rgba(0,0,0,.45);
			border-radius: 12px;
			z-index: 15;
			-webkit-overflow-scrolling: touch;
		}
		.music_chapters.shown { display: flex; }
		.music_chapters .music_chapter_tile {
			position: relative;
			flex: 0 0 auto;
			width: 200px;
			height: 120px;
			border-radius: 12px;
			overflow: hidden;
			cursor: var(--jawnos-cursor-pointer, pointer);
			background-color: rgba(255,255,255,.08);
		}
		.music_chapters .music_chapter_tile img, .music_chapters .music_chapter_tile video {
			display: block;
			width: 100%;
			height: 100%;
			object-fit: cover;
			border: none;
		}
		/* the hidden clip a card plays on hover; it covers the card so the
		   poster and the film are the same size */
		.music_chapters .music_chapter_tile video {
			display: none;
			position: absolute;
			left: 0;
			top: 0;
			background-color: #000;
		}
		.music_chapters .music_chapter_caption {
			position: absolute;
			left: 0;
			right: 0;
			bottom: 0;
			display: flex;
			/* the caption sits over the clip; a pointer on it is still on the
			   card, so the preview must not stop there */
			pointer-events: none;
			justify-content: space-between;
			gap: 6px;
			padding: 3px 6px;
			background-color: rgba(0,0,0,.65);
			color: #fff;
			font-size: 12px;
			line-height: 1.2;
		}
		.music_chapters .music_chapter_title {
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}
		.music_chapters .music_chapter_time {
			flex: 0 0 auto;
			color: #ffcf2e;
			font-variant-numeric: tabular-nums;
		}
		/* the visualiser's drawing surface: it is never shown itself. music.js
		   draws here and hands the canvas' stream to the muted video below, so the
		   sound's picture reaches the player the way a video track's does */
		.media_visualizer {
			position: absolute;
			left: 0px;
			top: 0px;
			width: 100%;
			height: 100%;
			opacity: 0;
			pointer-events: none;
		}
		/* that drawing, as a picture: it wears the player's own picture styles
		   (thumb_style in the corner, big_style in the theatre), put on it by
		   music.js */
		.media_visual_media {
			position: absolute;
			background-color: #000;
		}
		.media_visualization_label {
			color: #ddd;
			font-size: 12px;
			letter-spacing: .3px;
		}
		.media_visualization {
			height: 30px;
			max-width: 150px;
			border: solid 2px #777;
			border-radius: 6px;
			background-color: #111;
			color: #eee;
			font-size: 13px;
		}
		/* a native select popup can be refused in a fullscreen (the Qt view), so
		   the big picture shows the same control as an inline list; the list must
		   keep the rows the dropdown's 30px would hide */
		.media_visualization.media_visualization_list { width: 150px; height: auto; }
		/* the music player's own bar: it wraps to two rows - the full-width seek
		   on top, then the transport, shuffle/repeat, title, theatre and extras.
		   The controls that were absolutely placed in the foot are reset to static
		   so the rows can flow them; the seek previews are kept out of that reset
		   because their JS lays them fixed above the bar. The icon sizes follow the
		   WINDOW, not the screen (the window is a small panel on a big screen):
		   .wind[app=music] is the container, the base sizes are the ones that fit
		   the window's narrowest (~320px) and @container min-width steps enlarge
		   them as it widens. Base = narrow also means a browser without
		   container-query support degrades to a bar that fits. */
		.media_controls.music_player_bar {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			align-content: center;
			gap: 1px;
			padding: 0 4px;
			box-sizing: border-box;
		}
		.music_player_bar > *:not(.media_tools_panel):not(#<%= $miss %>_position_preview):not(#<%= $miss %>_position_preview_info):not(.music_chapters) {
			position: static !important;
			left: auto !important;
			right: auto !important;
			top: auto !important;
			bottom: auto !important;
		}
		.music_player_bar #transport { display: flex; align-items: center; gap: 0; flex: 0 0 auto; }
		.music_player_bar .control { display: inline-block; padding: 1px; border-radius: 10px; transition: background-color .15s; }
		.music_player_bar .control:hover { background-color: rgba(255,255,255,.12); }
		.music_player_bar .medium_thumb { height: 42px; max-width: 48px; border: none; background: transparent; }
		.music_player_bar .music_shuffle,
		.music_player_bar .music_repeat,
		.music_player_bar .little_thumb { height: 34px; border: none; background: transparent; }
		.music_player_bar .music_shuffle,
		.music_player_bar .music_repeat { flex: 0 0 auto; }
		/* the title sits where the seek used to, taking the row's slack and
		   wrapping to at most two lines. The id is needed for specificity: the
		   #<%= $id %>_full_title rule above styles the video overlay and would
		   otherwise win. */
		.music_player_bar #<%= $id %>_full_title {
			flex: 1 1 0;
			min-width: 0;
			overflow: hidden;
			overflow-wrap: anywhere;
			text-align: center;
			color: yellow;
			font-size: 15px;
			line-height: 1.15;
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			white-space: normal;
		}
		/* the seek spans its own full-width row above the buttons. box-sizing is
		   needed because the range input's UA padding would otherwise be added on
		   top of the 100% and push it past the bar's edge. The dark grey backdrop
		   makes the track's extent visible against the black bar. */
		.music_player_bar .music_seek {
			flex: 0 0 100%;
			width: 100%;
			min-width: 0;
			box-sizing: border-box;
			padding: 0;
			margin: 0;
			height: 24px;
			background-color: #333;
			border-radius: 4px;
		}
		.music_player_bar .media_tools_toggle,
		.music_player_bar #<%= $miss %>_full_screen { flex: 0 0 auto; }
		.music_player_bar #<%= $miss %>_jog_wheel_frame { height: 72px; width: 72px; }
		@container (min-width: 380px) {
			.media_controls.music_player_bar { gap: 2px; padding: 0 6px; }
			.music_player_bar .medium_thumb { height: 48px; max-width: 54px; }
			.music_player_bar .music_shuffle,
			.music_player_bar .music_repeat,
			.music_player_bar .little_thumb { height: 40px; }
			.music_player_bar #<%= $id %>_full_title { font-size: 16px; }
		}
		@container (min-width: 560px) {
			.music_player_bar .medium_thumb { height: 54px; max-width: 62px; }
			.music_player_bar .music_shuffle,
			.music_player_bar .music_repeat,
			.music_player_bar .little_thumb { height: 46px; }
			.music_player_bar #<%= $id %>_full_title { font-size: 18px; }
		}
		@container (min-width: 760px) {
			.music_player_bar .medium_thumb { height: 60px; max-width: 68px; }
			.music_player_bar .music_shuffle,
			.music_player_bar .music_repeat,
			.music_player_bar .little_thumb { height: 52px; }
		}
		/* A narrow player - a phone, or a small window - cannot hold the
		   transport, theatre, shuffle, repeat, tools, title and fullscreen once
		   the 380px step has enlarged them: the fullscreen button wrapped to a
		   third row and fell past the bar's foot. This step is last, so it
		   answers the enlargement above as well as the base sizes, and 560px is
		   where the row has room again. */
		@container (max-width: 559px) {
			.media_controls.music_player_bar { gap: 0; padding: 0 4px; }
			.music_player_bar .medium_thumb { height: 36px; max-width: 42px; }
			.music_player_bar .music_shuffle,
			.music_player_bar .music_repeat,
			.music_player_bar .little_thumb { height: 30px; }
			.music_player_bar #<%= $id %>_full_title { font-size: 14px; }
		}
		/* the theatre-mode picture fills the window: the container takes the
		   media window's whole height, so the video's own 100% resolves and the
		   browser's subtitle overlay - drawn at the element's foot - lands at the
		   window's foot instead of hanging below it */
		#<%= $miss %>_container { height: 100%; }
		/* the picture owns a finger's sideways and downward travel: the scrub and
		   volume gestures above, not the page's own panning */
		#<%= $id %>, #<%= $miss %>_visual_media { touch-action: none; background-color: #000; }
	</style>

