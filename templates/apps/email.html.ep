<%# The Email app's panel: Mailbox's email section, moved out of the umbrella and
    into an app of its own. It keeps the wrapper id and the inner ids the shared
    public/js/mailbox.js drives (#mail, #mail_sidebar, #mailbox, #message,
    #send_it) so the shared renderer and socket go on working; what changes here
    is the shape - a mail client.

    Layout: a toolbar (folders, title, search, Compose, settings), then a body
    split into a folder rail on the left and, on the right, the message list. A
    letter opens in the same place, over the list, with a Back button back to it
    (not the window drawer). Reply / Reply all / Forward are in the reading pane.
    Styling lives in public/css/manager.css, scoped to .wind[app="email"], so
    nothing here reaches Mailbox or Chat. The shared conversation partial is kept
    in the DOM (so the socket and the composer still work) but is never shown:
    this window is email only. %>
<% no warnings 'uninitialized'; %>
<style>
	.mailbox_message[ephemeral="yes"] > span { border-style: dashed; }
</style>
<div id="mail" class="email_app">
	<div id="mail_toolbar">
		<img src="<%= &subs::icon_for('/images/make believe/burger.png') %>" hint="Folders" class="little_thumb hover" id="email_rail_toggle">
		<span class="email_title">Email</span>
		<img src="<%= &subs::icon_for('/images/decipherable/now.png') %>" hint="Refresh" class="little_thumb email_tool hover" id="email_refresh">
		<img src="<%= &subs::icon_for('/images/decipherable/checkmark.png') %>" hint="Mark this folder read" class="little_thumb email_tool hover" id="email_mark_read">
		<input type="search" id="email_search" class="email_search" placeholder="Search mail" hint="Search the subject, body, sender and copies">
		<button id="email_compose" class="email_compose_button" hint="Write a new email">Compose</button>
		<img src="<%= &subs::icon_for('/images/decipherable/gear.png') %>" hint="Server settings" class="little_thumb email_config_toggle hover">
	</div>
	<div id="mail_body">
		<% my $privilege = $c->session('privilege'); %>
		<% if ($privilege eq 'citizen' || $privilege eq 'resident' || $privilege eq 'guest') { %>
			<div id="mail_sidebar" class="email_rail">
				<div class="email_rail_title">Folders</div>
				<div id="email_main_buttons">
					<% foreach my $b ( qw/inbox starred drafts sent outbox archive trash contacts/ ) { %>
						<button class="email_folder_button <% if ($settings->{'email_folder_selection'} eq $b) { %>selected<% } %>" button="<%= $b %>"><span class="email_folder_name"><%= &subs::format_name($b) %></span><% if ($email_counts->{$b}) { %> <span class="email_folder_count"><%= $email_counts->{$b} %></span><% } %></button>
					<% } %>
				</div>
				<div class="email_rail_account"><%= $mail_email || 'No address selected' %></div>
				<button id="email_empty_trash" class="email_empty_trash" hint="Delete every letter in Trash for good">Empty Trash</button>
			</div>
			<div id="mail_main">
				<div id="mail_list">
					<% if (!$settings->{'email_folder_selection'} || $settings->{'email_folder_selection'} eq 'contacts') { %>
						<% my $email_addresses = &subs::db_select('settings', undef, { setting => 'email', device => &subs::device_setter() })->hashes; %>
						<div id="mail_email_picker" class="mail_list_picker email_accounts">
							<% foreach my $email ( sort { $a->{'app'} cmp $b->{'app'} } @{$email_addresses} ) { %>
								<% $email->{'value'} =~ s/\S\d(?=\d{10})//; %>
								<div type="email" email="<%= $email->{'value'} %>" class="email_account_row <% if ($mail_email eq $email->{'value'}) { %>active <% } %>">
									<span class="email_account_app"><%= &subs::format_name($email->{'app'}) %></span>
									<span class="email_account_addr"><%= $email->{'value'} %></span>
								</div>
							<% } %>
						</div>
					<% } else { %>
						<%= include 'mail/email_folder', settings => $settings %>
					<% } %>
				</div>
				<div id="mail_reader" style="display:none;">
					<div id="mail_reader_bar">
						<button id="mail_reader_back" hint="Back to the list">&lsaquo; Back</button>
					</div>
					<div id="mail_reader_content"></div>
				</div>
				<%= include 'mail/conversation', mail => $mail, incoming_data => $incoming_data %>
			</div>
		<% } %>
	</div>
</div>
<script>
	last_mail_message = Date.now();
</script>
