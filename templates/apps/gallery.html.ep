<% use Mojo::JSON qw/encode_json decode_json/; %>
<% no warnings 'uninitialized'; %>
<% my $padlock_sighting = eval { return decode_json &subs::setting_grabber({app => '__president', setting => 'padlock_contexts' }) } || [];
	@{$padlock_sighting} = grep { $_ eq 'gallery' } @{$padlock_sighting};
%>
<style>
#gallery { display:flex; flex-direction:column; width:100%; height:100%; min-height:0; background:#0b0b0d; color:#eee; font-family:system-ui,-apple-system,sans-serif; overflow:hidden; }
#gallery * { box-sizing:border-box; }
#gallery_header { display:flex; align-items:center; gap:6px; padding:7px 8px; flex-wrap:wrap; background:#151519; border-bottom:1px solid #2a2a30; flex:0 0 auto; }
#gallery_header .gallery_tab { font-size:13px; line-height:1; padding:8px 11px; border:1px solid #34343c; border-radius:8px; background:#1d1d23; color:#ddd; cursor:pointer; }
#gallery_header .gallery_tab.active { background:#3a3a44; border-color:#5a5a68; color:#fff; }
#gallery_header .gallery_lock { margin-left:auto; }
#gallery_search { flex:1 1 120px; min-width:100px; font-size:14px; padding:8px 10px; border-radius:8px; border:1px solid #34343c; background:#101014; color:#eee; outline:none; }
#gallery_search:focus { border-color:#6a6a7a; }
#gallery_body { flex:1 1 auto; min-height:0; overflow-y:auto; overflow-x:hidden; position:relative; }
#gallery_albums { display:grid; grid-template-columns:repeat(auto-fill,minmax(135px,1fr)); gap:10px; padding:10px; }
.gallery_album_card { position:relative; border-radius:10px; overflow:hidden; background:#1a1a20; cursor:pointer; border:1px solid #26262d; }
.gallery_album_card:hover { border-color:#4a4a56; }
.gallery_album_card img { display:block; width:100%; aspect-ratio:1/1; object-fit:cover; background:#222; }
.gallery_album_meta { padding:6px 8px; }
.gallery_album_name { font-size:13px; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.gallery_album_count { font-size:11px; color:#9a9aa6; margin-top:2px; }
#gallery_grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(104px,1fr)); gap:3px; padding:3px; }
.gallery_tile { position:relative; aspect-ratio:1/1; overflow:hidden; background:#17171c; cursor:pointer; border-radius:3px; }
.gallery_tile img { display:block; width:100%; height:100%; object-fit:cover; }
.gallery_tile:hover img { opacity:.85; }
.gallery_tile_badge { position:absolute; right:4px; bottom:4px; font-size:10px; letter-spacing:.04em; text-transform:uppercase; padding:2px 5px; border-radius:5px; background:#000a; color:#fff; }
.gallery_day { grid-column:1/-1; padding:10px 4px 3px; font-size:12px; letter-spacing:.03em; color:#9a9aa6; text-transform:uppercase; }
#gallery_empty { padding:40px 16px; text-align:center; color:#9a9aa6; font-size:14px; }
#gallery_viewer { position:absolute; inset:0; z-index:60; background:#000; display:flex; align-items:center; justify-content:center; overflow:hidden; }
/* full screen is a class, not the Fullscreen API: the desktop app and the
   Android WebView do not all hand an element the screen, but a fixed panel
   over the taskbar does the same job everywhere. The gallery's own window sits
   in #browser, which is a stacking context below the taskbar, so the browser
   layer is raised too - otherwise the taskbar still paints over the panel. */
.gallery_fullscreen { position:fixed !important; inset:0 !important; width:100vw !important; height:100vh !important; max-height:100vh !important; z-index:50000 !important; border-radius:0 !important; }
#browser.gallery_fullscreen_host { z-index:50001 !important; }
/* the window's title bar floats above its content; a full-screen photo hides it */
.gallery_fullscreen_window .top_navbar { display:none !important; }
/* the window frame ring is painted over the window with a huge z-index (see
   .wind::after in manager.css), so it would draw its border across the photo.
   A full-screen photo has no window around it: no ring, no rounded corners. */
.gallery_fullscreen_window { border-radius:0 !important; }
.gallery_fullscreen_window::after { display:none !important; }
#gallery_viewer_stage { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; }
#gallery_viewer_stage img, #gallery_viewer_stage video { max-width:100%; max-height:100%; object-fit:contain; display:block; }
.gallery_viewer_nav { position:absolute; top:50%; transform:translateY(-50%); z-index:3; width:44px; height:64px; font-size:30px; line-height:1; border:0; border-radius:10px; background:#0008; color:#fff; cursor:pointer; }
#gallery_viewer_prev { left:6px; }
#gallery_viewer_next { right:6px; }
#gallery_viewer_close { position:absolute; top:calc(var(--gallery_viewer_pad,6px) + env(safe-area-inset-top, 0px)); right:6px; z-index:3; width:40px; height:40px; font-size:24px; border:0; border-radius:50%; background:#0008; color:#fff; cursor:pointer; }
#gallery_viewer_full { position:absolute; top:calc(var(--gallery_viewer_pad,6px) + env(safe-area-inset-top, 0px)); right:52px; z-index:3; width:40px; height:40px; font-size:19px; line-height:1; border:0; border-radius:50%; background:#0008; color:#fff; cursor:pointer; }
#gallery_viewer_bar { position:absolute; left:0; right:0; bottom:0; z-index:3; display:flex; align-items:center; gap:6px; padding:9px; flex-wrap:wrap; background:linear-gradient(transparent,#000d); }
#gallery_viewer_label { flex:1 1 130px; min-width:100px; font-size:12px; color:#ddd; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.gallery_viewer_action { font-size:12px; padding:7px 9px; border:1px solid #444; border-radius:8px; background:#191919; color:#eee; cursor:pointer; }
.gallery_viewer_action.armed { background:#7a1d1d; border-color:#b33; }
#gallery_lock { position:absolute; inset:0; z-index:70; background:#0b0b0d; display:flex; align-items:flex-start; justify-content:center; overflow:auto; padding:10px; }
/* margin:auto centres a gate that fits and leaves it scrollable from the top
   when it does not; align-items:center cut the top off a tall one instead */
#gallery_lock .padlock_frame { position:relative !important; inset:auto !important; transform:none !important; margin:auto; }
#gallery_lock .padlock_frame.padlock_compact { margin:8px auto 0 !important; }
</style>
<div id="gallery" unlock="<%= $unlock %>" padlock="<%= scalar @{$padlock_sighting} ? 1 : 0 %>">
	<div id="gallery_header">
		<button type="button" id="gallery_home_tab" class="gallery_tab active" hint="Albums"><%= &subs::ui('Albums') %></button>
		<button type="button" id="gallery_all_tab" class="gallery_tab" hint="All photos"><%= &subs::ui('All photos') %></button>
		<input id="gallery_search" type="search" autocomplete="off" hint="Search" placeholder="<%= &subs::lang('common.search') %>">
		<button type="button" id="gallery_sort" class="gallery_tab" hint="Newest first"><%= &subs::ui('Newest first') %></button>
		<%# shown by the client when the padlock covers the gallery or when an album
		    is hidden by the visibility rule, whichever comes first %>
		<button type="button" id="gallery_lock_button" class="gallery_tab gallery_lock" hint="Unlock" style="display:none;"><%= &subs::ui('Unlock') %></button>
	</div>
	<div id="gallery_body">
		<div id="gallery_albums"></div>
		<div id="gallery_grid" style="display:none;"></div>
		<div id="gallery_empty" style="display:none;"><%= &subs::ui('No photos to show.') %></div>
	</div>
	<div id="gallery_viewer" style="display:none;">
		<button type="button" id="gallery_viewer_close" hint="Close">×</button>
		<button type="button" id="gallery_viewer_full" hint="Full screen">⤢</button>
		<button type="button" id="gallery_viewer_prev" hint="Previous">‹</button>
		<div id="gallery_viewer_stage"></div>
		<button type="button" id="gallery_viewer_next" hint="Next">›</button>
		<div id="gallery_viewer_bar">
			<span id="gallery_viewer_label"></span>
			<button type="button" class="gallery_viewer_action gallery_info" hint="File information"><%= &subs::ui('File information') %></button>
			<button type="button" class="gallery_viewer_action gallery_main" hint="Set as main image"><%= &subs::ui('Set as main image') %></button>
			<button type="button" class="gallery_viewer_action gallery_fetch" hint="Fetch home"><%= &subs::ui('Fetch home') %></button>
			<button type="button" class="gallery_viewer_action gallery_delete" hint="Delete"><%= &subs::lang('common.delete') %></button>
		</div>
	</div>
	<div id="gallery_lock" style="display:none;">
		<button type="button" id="gallery_lock_close" hint="Close" style="position:absolute;top:8px;right:8px;z-index:2;width:38px;height:38px;font-size:22px;border:0;border-radius:50%;background:#222;color:#eee;cursor:pointer;">×</button>
		<% $c->stash('compact' => 1); %>
		<%= include 'padlock', mode => 'gallery', fingerprint => 1 %>
	</div>
	<span id="gallery_info_anchor" class="gallery file_information_grabber" style="display:none;"></span>
	<%# the lock button's label and hint swap with the padlock; the auditor reads
	    the template, so both names live here the way the sort button's do %>
	<span hint="Lock" style="display:none;"></span>
	<span hint="Oldest first" style="display:none;"></span>
</div>
