<%# The appointment window's readings, fetched by appSectionGrabber the first
    time a header asks for one. The evaluation stays in the wrapper, because its
    headline is what the window opens on. %>
<% my $stats = $app_stats || {}; %>
<%# A pace is a rate carried to the end of a period still running, so it usually
    lands between whole numbers; one decimal, and no trailing .0, reads without
    suggesting the count is exact. A period with no rate yet shows a dash. %>
<% my $pace_number = sub {
	my $n = shift;
	return '-' unless defined $n;
	my $s = sprintf('%.1f', $n);
	$s =~ s/\.0$//;
	return $s;
}; %>
<div class="appointment_stats_panel" stat="inv" style="display:none;">
	<% my $inv = $stats->{'inventory'} || {}; %>
	<% if (scalar @{ $inv->{'units'} || [] }) { %>
		<table class="appointment_stats_table">
			<tr>
				<th><%= &subs::format_name($stats->{'item'} || $app) %></th>
				<th><%= &subs::ui('In') %></th>
				<th><%= &subs::ui('Out') %></th>
				<th><%= &subs::ui('On hand') %></th>
			</tr>
			<% foreach my $u ( @{$inv->{'units'}} ) { %>
				<tr>
					<td><%= $u->{'unit'} || &subs::ui('each') %></td>
					<td><%= &subs::numeric_formatter($u->{'in'}) %></td>
					<td><%= &subs::numeric_formatter($u->{'out'}) %></td>
					<td><%= &subs::numeric_formatter($u->{'on_hand'}) %></td>
				</tr>
			<% } %>
		</table>
			<%# What the shelf moved inside each period: the running balance above hides
			    whether today's out is a sip or the month's whole supply, so the same
			    periods the other tables read are shown here per unit, with the out
			    carried to the period's end at the pace so far. %>
			<% foreach my $group ( @{ $inv->{'periods'} || [] } ) { %>
				<table class="appointment_stats_table" style="margin-top:4px;">
					<tr style="opacity:.6;font-size:90%;">
						<th><%= $group->{'unit'} || &subs::ui('each') %></th>
						<th><%= &subs::ui('In') %></th>
						<th><%= &subs::ui('Out') %></th>
						<th title="<%= &subs::ui('Out carried to the end of the period') %>"><%= &subs::ui('Pace') %></th>
					</tr>
					<% foreach my $p ( @{ $group->{'rows'} || [] } ) { %>
						<tr>
							<td><%= $p->{'label'} %></td>
							<td><%= &subs::numeric_formatter($p->{'in'}) %></td>
							<td><%= &subs::numeric_formatter($p->{'out'}) %></td>
							<td><% if (defined $p->{'pace'}) { %><%= $pace_number->($p->{'pace'}) %><% } else { %>-<% } %></td>
						</tr>
					<% } %>
				</table>
			<% } %>
		<% } else { %>
		<div class="appointment_stats_empty"><%= &subs::ui('No stock') %></div>
	<% } %>
</div>
<div class="appointment_stats_panel" stat="time" style="display:none;">
	<table class="appointment_stats_table">
		<tr><th></th><% foreach my $p ( @{$stats->{'periods'} || []} ) { %><th><%= $p->{'label'} %></th><% } %></tr>
		<tr><td><%= &subs::ui('Duration') %></td><% foreach my $p ( @{$stats->{'periods'} || []} ) { %><td><%= &subs::duration_sayer(($p->{'duration'} || 0) / 1000) %></td><% } %></tr>
		<tr class="appointment_stats_pace"><td><%= &subs::ui('Pace') %> <span class="appointment_stats_calc"><%= &subs::ui('by the end') %></span></td><% foreach my $p ( @{$stats->{'periods'} || []} ) { %><td><% if (defined $p->{'projected'}) { %><%= &subs::duration_sayer(($p->{'projected'}->{'duration'} || 0) / 1000) %><% } else { %>-<% } %></td><% } %></tr>
	</table>
</div>
<div class="appointment_stats_panel" stat="count" style="display:none;">
	<table class="appointment_stats_table">
		<tr><th></th><% foreach my $p ( @{$stats->{'periods'} || []} ) { %><th><%= $p->{'label'} %></th><% } %></tr>
		<tr><td><%= &subs::ui('Count') %></td><% foreach my $p ( @{$stats->{'periods'} || []} ) { %><td><%= &subs::numeric_formatter($p->{'count'}) %></td><% } %></tr>
		<tr class="appointment_stats_pace"><td><%= &subs::ui('Pace') %> <span class="appointment_stats_calc"><%= &subs::ui('by the end') %></span></td><% foreach my $p ( @{$stats->{'periods'} || []} ) { %><td><%= $pace_number->($p->{'projected'} ? $p->{'projected'}->{'count'} : undef) %></td><% } %></tr>
	</table>
</div>
<div class="appointment_stats_panel" stat="money" style="display:none;">
	<table class="appointment_stats_table">
		<tr><th></th><% foreach my $p ( @{$stats->{'periods'} || []} ) { %><th><%= $p->{'label'} %></th><% } %></tr>
		<tr><td>$</td><% foreach my $p ( @{$stats->{'periods'} || []} ) { %><td><%= &subs::price_formatter($p->{'money'} || 0) %></td><% } %></tr>
		<tr class="appointment_stats_pace"><td><%= &subs::ui('Pace') %> <span class="appointment_stats_calc"><%= &subs::ui('by the end') %></span></td><% foreach my $p ( @{$stats->{'periods'} || []} ) { %><td><% if ($p->{'projected'}) { %><%= &subs::price_formatter($p->{'projected'}->{'money'} || 0) %><% } else { %>-<% } %></td><% } %></tr>
	</table>
</div>
<div class="appointment_stats_panel" stat="meas" style="display:none;">
	<% my $measure_names = $stats->{'measure_names'} || []; %>
	<% if (scalar @{$measure_names}) { %>
		<table class="appointment_stats_table">
			<tr><th></th><% foreach my $p ( @{$stats->{'periods'} || []} ) { %><th><%= $p->{'label'} %></th><% } %></tr>
			<% foreach my $m ( @{$measure_names} ) { %>
				<tr>
					<td><%= &subs::format_name($m->{'name'}) %> <span class="appointment_stats_calc"><%= &subs::format_name($m->{'calc'}) %></span></td>
					<% foreach my $p ( @{$stats->{'periods'} || []} ) { %>
						<% my $reading = $p->{'measures'}->{$m->{'name'}}; %>
						<td><% if ($reading) { %><%= &subs::numeric_formatter($reading->{'value'}) . ($m->{'unit'} ? ' ' . $m->{'unit'} : '') %><% } else { %>-<% } %></td>
					<% } %>
				</tr>
				<tr class="appointment_stats_pace"><td><%= &subs::ui('Pace') %> <span class="appointment_stats_calc"><%= &subs::ui('by the end') %></span></td><% foreach my $p ( @{$stats->{'periods'} || []} ) { %><% my $one = $p->{'measures'}->{$m->{'name'}}; %><td><% if ($one && defined $one->{'projected'}) { %><%= $pace_number->($one->{'projected'}) . ($m->{'unit'} ? ' ' . $m->{'unit'} : '') %><% } else { %>-<% } %></td><% } %></tr>
			<% } %>
		</table>
	<% } else { %>
		<div class="appointment_stats_empty"><%= &subs::ui('No measures') %></div>
	<% } %>
</div>
