<%
	my $dev = $devices || [];
	my $default = $default_device || 'me';
	my $me_seen = ($me_fix && $me_fix->{'seen'}) ? &subs::formatted_time($me_fix->{'seen'}) : '';
%>
<%= include 'apps/weather/style' %>
<div id="weather">
	<div id="weather_toolbar">
		<label for="weather_device"><%= &subs::ui('Location') %></label>
		<select id="weather_device">
			<option value="me" <% if ($default eq 'me') { %>selected<% } %>>
				<%= &subs::ui('This device') %><% if (length $me_seen) { %> — <%= $me_seen %><% } %>
			</option>
			<% foreach my $d ( @{$dev} ) { %>
				<% my $seen = $d->{'seen'} ? &subs::formatted_time($d->{'seen'}) : ''; %>
				<option value="<%= $d->{'signatorial'} %>" <% if ($default eq $d->{'signatorial'}) { %>selected<% } %>>
					<%= $d->{'label'} %><% if (length $seen) { %> — <%= $seen %><% } %>
				</option>
			<% } %>
		</select>
		<button type="button" id="weather_refresh"><%= &subs::ui('Refresh') %></button>
		<button type="button" id="weather_browser"><%= &subs::ui('Use browser location') %></button>
		<span id="weather_status"></span>
	</div>
	<input type="hidden" id="weather_lat" value="">
	<input type="hidden" id="weather_lon" value="">
	<input type="hidden" id="weather_source" value="">
	<div id="weather_error" style="display:none;"></div>
	<div id="weather_tabs">
		<button type="button" class="weather_tab active" data-tab="now"><%= &subs::ui('Now') %></button>
		<button type="button" class="weather_tab" data-tab="history"><%= &subs::ui('History') %></button>
		<button type="button" class="weather_tab" data-tab="accuracy"><%= &subs::ui('Accuracy') %></button>
		<button type="button" class="weather_tab" data-tab="automations"><%= &subs::ui('Automations') %></button>
	</div>
	<div id="weather_now_panel" class="weather_panel active">
		<%= include 'apps/weather/now' %>
	</div>
	<%= include 'apps/weather/history' %>
	<%= include 'apps/weather/accuracy' %>
	<%= include 'apps/weather/automations' %>
</div>
