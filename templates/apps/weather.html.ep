<%
	my $places = $places || [];
	my $locs = $locations || [];
	my $labels = $location_labels || {};
	my $default = $default_device || 'me';
	my $has_me = grep { $_->{'me'} } @{$places};
	my $home_uuid = $home_uuid || '';
	my ($home_loc) = grep { ($_->{'uuid'} // '') eq $home_uuid } @{$locs};
	my $home_label = $home_loc ? ($labels->{$home_uuid} // $home_loc->{'name'} // '') : '';
	my @other_locs = grep { ($_->{'uuid'} // '') ne $home_uuid } @{$locs};
%>
<%= include 'apps/weather/style' %>
<div id="weather">
	<div id="weather_toolbar">
		<label for="weather_device"><%= &subs::ui('Location') %></label>
		<select id="weather_device">
			<% if ($home_loc) { %>
				<option value="loc:<%= $home_loc->{'uuid'} %>" data-lat="<%= $home_loc->{'lat'} %>" data-lon="<%= $home_loc->{'lon'} %>" data-anchor="<%= $home_loc->{'anchor'} ? 1 : 0 %>" data-home="1" title="<%= &subs::ui('The house\'s home plate, read every hour') %>"><%= length $home_label ? $home_label . ' — ' : '' %><%= &subs::ui('Home, always checked') %></option>
			<% } %>
			<% if (!$has_me) { %>
				<option value="me" data-lat="" data-lon="" <% if ($default eq 'me') { %>selected<% } %>><%= &subs::ui('This device') %></option>
			<% } %>
			<% foreach my $g ( @{$places} ) { %>
				<% my $value = $g->{'me'} ? 'me' : $g->{'signatorial'}; %>
				<% my $seen = $g->{'seen'} ? &subs::weather_stamp_text($g->{'seen'}) : ''; %>
				<option value="<%= $value %>" data-lat="<%= $g->{'lat'} %>" data-lon="<%= $g->{'lon'} %>" data-seen="<%= $seen %>" title="<%= $g->{'devices_text'} %>" <% if ($default eq $value) { %>selected<% } %>><%= $g->{'label'} %><% if (length $seen) { %> — <%= $seen %><% } %></option>
			<% } %>
			<% if (@other_locs) { %>
				<optgroup label="<%= &subs::ui('Places') %>" data-weather-locations="1">
					<% foreach my $loc ( @other_locs ) { %>
						<option value="loc:<%= $loc->{'uuid'} %>" data-lat="<%= $loc->{'lat'} %>" data-lon="<%= $loc->{'lon'} %>" data-anchor="<%= $loc->{'anchor'} ? 1 : 0 %>"><%= $labels->{ $loc->{'uuid'} } // $loc->{'name'} %></option>
					<% } %>
				</optgroup>
			<% } %>
		</select>
		<button type="button" id="weather_location_add"><%= &subs::ui('Add') %></button>
	</div>
	<div id="weather_actions">
		<button type="button" id="weather_location_delete" disabled><%= &subs::ui('Delete') %></button>
		<button type="button" id="weather_location_sources" disabled><%= &subs::ui('Sources') %></button>
		<button type="button" id="weather_location_anchor" disabled><%= &subs::ui('Anchor') %></button>
		<button type="button" id="weather_refresh"><%= &subs::ui('Refresh') %></button>
		<button type="button" id="weather_browser"><%= &subs::ui('Use browser location') %></button>
		<button type="button" id="weather_check_here" style="display:none;"><%= &subs::ui('Check weather here') %></button>
		<span id="weather_status"></span>
	</div>
	<input type="hidden" id="weather_lat" value="">
	<input type="hidden" id="weather_lon" value="">
	<input type="hidden" id="weather_source" value="">
	<div id="weather_sources_view">
		<div class="weather_controls">
			<button type="button" id="weather_sources_back"><%= &subs::ui('Back') %></button>
			<b><%= &subs::ui('Weather sources') %></b>
			<span id="weather_sources_place" class="weather_muted"></span>
			<span id="weather_sources_status" class="weather_muted"></span>
		</div>
		<div id="weather_sources_choices">
			<label class="weather_source_option"><input type="radio" name="weather_source_mode" value="closest"><span><b><%= &subs::ui('Closest') %></b><br><span class="weather_muted"><%= &subs::ui('Barometer from the nearest station; other readings from the next nearest. The forecast still comes from the usual provider.') %></span></span></label>
			<label class="weather_source_option"><input type="radio" name="weather_source_mode" value="ec"><span><b><%= &subs::ui('Environment Canada') %></b><br><span class="weather_muted"><%= &subs::ui('Current conditions and forecast from the nearest Environment Canada city page.') %></span></span></label>
			<label class="weather_source_option"><input type="radio" name="weather_source_mode" value="openmeteo"><span><b><%= &subs::ui('Open-Meteo') %></b><br><span class="weather_muted"><%= &subs::ui('Gridded current conditions and forecast at this coordinate.') %></span></span></label>
			<label class="weather_source_option"><input type="radio" name="weather_source_mode" value="pws"><span><b><%= &subs::ui('Weather Underground station') %></b><br><span class="weather_muted"><%= &subs::ui('Current readings from one station; the forecast still comes from the usual provider.') %></span></span></label>
			<label class="weather_source_option"><input type="radio" name="weather_source_mode" value="nws"><span><b><%= &subs::ui('US National Weather Service') %></b><br><span class="weather_muted"><%= &subs::ui('Current conditions and forecast from the nearest National Weather Service office.') %></span></span></label>
		</div>
		<div id="weather_sources_picked" class="weather_muted"></div>
		<div id="weather_sources_station_row">
			<label for="weather_sources_station"><%= &subs::ui('Station') %></label>
			<input id="weather_sources_station" placeholder="IWARWI84" autocomplete="off">
			<span class="weather_muted"><%= &subs::ui('Type a Weather Underground station ID.') %></span>
		</div>
		<div id="weather_sources_nearby"></div>
		<div id="weather_sources_key_row">
			<label for="weather_sources_key"><%= &subs::ui('Weather Underground API key') %></label>
			<input type="password" id="weather_sources_key" autocomplete="off" placeholder="<%= &subs::ui('Paste a free key') %>">
			<button type="button" id="weather_sources_key_clear"><%= &subs::ui('Clear key') %></button>
			<span id="weather_sources_key_state" class="weather_muted"></span>
		</div>
		<div class="weather_controls">
			<button type="button" id="weather_sources_save"><%= &subs::ui('Save') %></button>
			<button type="button" id="weather_sources_cancel"><%= &subs::ui('Cancel') %></button>
		</div>
	</div>
	<div id="weather_error" style="display:none;"></div>
	<div id="weather_tabs">
		<button type="button" class="weather_tab active" data-tab="now"><%= &subs::ui('Now') %></button>
		<button type="button" class="weather_tab" data-tab="history"><%= &subs::ui('History') %></button>
		<button type="button" class="weather_tab" data-tab="accuracy"><%= &subs::ui('Accuracy') %></button>
		<button type="button" class="weather_tab" data-tab="automations"><%= &subs::ui('Automations') %></button>
	</div>
	<div id="weather_now_panel" class="weather_panel active">
		<%= include 'apps/weather/now' %>
	</div>
	<%= include 'apps/weather/history' %>
	<%= include 'apps/weather/accuracy' %>
	<%= include 'apps/weather/automations' %>
	<%= include 'apps/weather/map' %>
</div>
