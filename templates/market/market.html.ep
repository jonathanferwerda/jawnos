<% no warnings 'uninitialized'; %>
<%# Market: the shopping side of the warehouse. A vendors dropdown scopes the
    list; the Shopping List tab holds what to buy, each row carrying a need/want
    dial; the Shopping tab reads the same list through a needs/wants/all filter.
    An item the warehouse says is due arrives already marked a need. Enter adds
    an item (like Notes); Shift+Enter is not a newline here - Enter always adds. %>
<%
	my $list = $list || [];
	my @vendors = @{ $vendors || [] };
	my $vendor = $vendor || '';
	my $lists = $lists || {};
	my @nearby = @{ $nearby || [] };
	my @scan_feeds = @{ $scan_feeds || [] };
	my @receipts = @{ $receipts || [] };
	# one renderer for a row, so the list tab and the shopping tab never drift;
	# the list tab carries the need/want dial, the shopping tab a plain badge.
	my $row = sub {
		my ($it, $editable) = @_;
		my $kind = ($it->{'kind'} || '') eq 'need' ? 'need' : 'want';
		my $uuid = $it->{'uuid'} || '';
		my $v = $it->{'vendor'} || '';
		my $o = '<div class="market_row" uuid="' . $uuid . '" data-kind="' . $kind . '" data-vendor="' . $v . '" data-list="' . ($it->{'list'} || '') . '" data-cart="' . ($it->{'cart'} ? 1 : 0) . '" data-picked="' . ($it->{'picked'} ? 1 : 0) . '" style="border-bottom:1px solid var(--line);padding:5px;font-size:18px;">';
		if ($editable) {
			$o .= '<button class="market_pick" uuid="' . $uuid . '" style="min-width:34px;" title="Picked">' . ($it->{'picked'} ? '&#10003;' : '&#9675;') . '</button>';
			$o .= '<button class="market_cart" uuid="' . $uuid . '" style="margin-left:4px;font-size:14px;" title="In cart">' . ($it->{'cart'} ? 'in cart' : 'cart') . '</button>';
			$o .= '<select class="market_kind" uuid="' . $uuid . '" style="font-size:15px;margin-left:4px;">';
			$o .= '<option value="want"' . ($kind eq 'want' ? ' selected' : '') . '>Want</option>';
			$o .= '<option value="need"' . ($kind eq 'need' ? ' selected' : '') . '>Need</option>';
			$o .= '</select>';
		}
		else {
			my $col = $kind eq 'need' ? '#b8860b' : 'var(--line)';
			$o .= '<span style="font-size:14px;font-weight:700;color:' . $col . ';">' . &subs::format_name($kind) . '</span>';
		}
		$o .= '<span class="market_text" style="margin-left:8px;">' . $it->{'text'} . '</span>';
		if ($it->{'vendor'}) {
			$o .= '<span style="opacity:.55;font-size:13px;margin-left:8px;">' . &subs::format_name($it->{'vendor'}) . '</span>';
		}
		if ($it->{'due'}) {
			$o .= '<span style="margin-left:8px;font-size:13px;opacity:.8;">- due</span>';
		}
		$o .= '<button class="market_delete" uuid="' . $uuid . '" style="float:right;" title="Delete">X</button>';
		$o .= '</div>';
		return $o;
	};
%>
<div id="market_body" data-scan="<%= join(',', @scan_feeds) %>" style="width:100%;height:100%;background-color:var(--panel);padding:6px;box-sizing:border-box;display:flex;flex-direction:column;position:relative;">
	<div style="flex:0 0 auto;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
		<b style="font-size:20px;">Market</b>
		<select id="market_list" style="flex:0 1 auto;">
			<option value="">All lists</option>
			<% foreach my $k ( sort { lc($lists->{$a}->{'name'} || $a) cmp lc($lists->{$b}->{'name'} || $b) } keys %{$lists} ) { %>
				<option value="<%= $k %>"><%= $lists->{$k}->{'name'} || $k %></option>
			<% } %>
		</select>
		<select id="market_vendor" style="flex:0 1 auto;">
			<option value="">All vendors</option>
			<% foreach my $v ( @vendors ) { %>
				<option value="<%= $v %>" <% if ($vendor eq $v) { %>selected<% } %>><%= &subs::format_name($v) %></option>
			<% } %>
		</select>
		<span style="flex:1 1 auto;"></span>
		<button id="market_scan" style="font-size:15px;">Scan</button>
		<button id="market_receipt" style="font-size:15px;">Receipt</button>
		<% if (scalar @receipts) { %><button id="market_receipts_open" style="font-size:15px;">Receipts</button><% } %>
		<button id="market_checkout" style="font-size:15px;">Checkout (<span id="market_cart_count">0</span>)</button>
		<button id="market_cancel" style="font-size:15px;">Cancel</button>
		<button class="market_tab" tab="list">Shopping List</button>
		<button class="market_tab" tab="shopping">Shopping</button>
	</div>
	<% if (scalar @nearby) { %>
		<div id="market_nearby" style="flex:0 0 auto;padding:3px 0;font-size:15px;opacity:.85;">Here:
			<% foreach my $n ( @nearby ) { %><span class="market_nearby_list" list="<%= $n->{'key'} %>" style="cursor:pointer;text-decoration:underline;margin-left:6px;"><%= $n->{'name'} %></span><% } %>
		</div>
	<% } %>
	<div id="market_list" style="flex:1 1 auto;overflow:auto;padding-top:6px;display:flex;flex-direction:column;">
		<div style="flex:0 0 auto;padding-bottom:4px;">
			<input id="market_item_input" type="text" placeholder="Add an item... (Enter adds)" style="width:78%;">
			<button id="market_item_add" style="width:18%;">Add</button>
		</div>
		<div id="market_list_rows" style="flex:1 1 auto;overflow:auto;">
			<% if (!scalar @{$list}) { %>
				<span style="font-size:16px;opacity:.7;">Nothing on the list yet. Type an item and press Enter.</span>
			<% } %>
			<% foreach my $it ( @{$list} ) { %><%== $row->($it, 1) %><% } %>
		</div>
	</div>
	<div id="market_shopping" style="flex:1 1 auto;overflow:auto;padding-top:6px;display:none;flex-direction:column;">
		<div style="flex:0 0 auto;padding-bottom:4px;">
			<select id="market_filter">
				<option value="all">All</option>
				<option value="need">Needs</option>
				<option value="want">Wants</option>
			</select>
		</div>
		<div id="market_shopping_rows" style="flex:1 1 auto;overflow:auto;">
			<% foreach my $it ( @{$list} ) { %><%== $row->($it, 0) %><% } %>
		</div>
	</div>
	<%# the kept receipts: each read receipt's pages, with a way to put its lines
	    back on the list. Rendered here so a reload (which replaces the body) keeps
	    it in step. The pages are opened through /file_open like any other picture. %>
	<div id="market_receipts" style="display:none;position:absolute;left:0;top:0;width:100%;height:100%;background-color:var(--panel);z-index:20;overflow:auto;padding:6px;box-sizing:border-box;">
		<div style="display:flex;align-items:center;gap:8px;">
			<b style="font-size:18px;">Kept receipts</b>
			<span style="flex:1 1 auto;"></span>
			<button id="market_receipts_close">Close</button>
		</div>
		<% if (!scalar @receipts) { %>
			<div style="padding:10px;font-size:16px;opacity:.7;">No receipts kept yet. Read one with the Receipt button.</div>
		<% } %>
		<% foreach my $r ( @receipts ) { %>
			<div class="market_receipt_row" data-apply="<%= $r->{'apply_json'} %>" data-files="<%= $r->{'files_json'} %>" data-total="<%= defined $r->{'total'} ? $r->{'total'} : '' %>" data-date="<%= $r->{'date'} %>" data-vendor="<%= $r->{'vendor'} %>" data-payment="<%= $r->{'payment_method'} %>" data-payment-ref="<%= $r->{'payment_ref'} %>" style="border-bottom:1px solid var(--line);padding:6px;">
				<div style="font-size:17px;">
					<b><%= &subs::format_name($r->{'vendor'} || 'Receipt') %></b>
					<% if ($r->{'date'}) { %><span style="opacity:.6;font-size:14px;margin-left:6px;"><%= $r->{'date'} %></span><% } %>
					<% if (defined $r->{'total'}) { %><span style="opacity:.6;font-size:14px;margin-left:6px;">total <%= $r->{'total'} %></span><% } %>
					<% if ($r->{'payment_method'}) { %><span style="opacity:.6;font-size:14px;margin-left:6px;">paid by <%= $r->{'payment_method'} %><% if ($r->{'payment_ref'}) { %> <%= $r->{'payment_ref'} %><% } %></span><% } %>
					<span style="opacity:.6;font-size:14px;margin-left:6px;"><%= scalar @{ $r->{'lines'} || [] } %> lines</span>
					<button class="market_receipt_readd" style="float:right;font-size:15px;">Add to list</button>
				</div>
				<div style="margin-top:4px;">
					<% foreach my $p ( @{ $r->{'pages'} || [] } ) { %><a href="<%= $p->{'url'} %>" target="_blank"><img src="<%= $p->{'url'} %>" style="height:70px;margin-right:6px;border:1px solid var(--line);"></a><% } %>
					<% if (!scalar @{ $r->{'pages'} || [] }) { %><span style="font-size:13px;opacity:.55;">the pages are no longer on disk</span><% } %>
				</div>
			</div>
		<% } %>
	</div>
	<%# a receipt read covers the body until it is confirmed or closed; the pages
	    are chosen with a photo picker (or the scanner), read server-side %>
	<input id="market_receipt_file" type="file" accept="image/*" capture="environment" multiple style="display:none;">
	<div id="market_receipt_panel" style="display:none;position:absolute;left:0;top:0;width:100%;height:100%;background-color:var(--panel);z-index:20;overflow:auto;padding:6px;box-sizing:border-box;"></div>
</div>
