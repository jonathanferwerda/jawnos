<!DOCTYPE html>
<html>
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title><%= &subs::ui('Virtual world') %></title>
		<style>
			html, body { margin: 0; height: 100%; overflow: hidden; background: #0b0d10; }
			/* a double-tap is a step forward here, not the browser's zoom */
			#world_scene, #world_scene canvas { touch-action: none; }
			#world_hint {
				position: absolute; left: 8px; bottom: 8px; z-index: 5;
				font: 11px sans-serif; color: #fff; background: rgba(0,0,0,.55);
				padding: 3px 7px; border-radius: 5px; pointer-events: none;
			}
			#world_loading {
				position: absolute; inset: 0; z-index: 4; display: flex;
				align-items: center; justify-content: center;
				font: 13px sans-serif; color: #ddd; background: #0b0d10;
			}
		</style>
		<script src="/js/aframe/aframe.min.js"></script>
	</head>
	<body>
		<a-scene id="world_scene" embedded
			renderer="antialias: true"
			vr-mode-ui="enabled: false"
			fog="type: exponential; density: 0.0015; color: #cfe3f0">
			<a-sky color="#cfe3f0"></a-sky>
			<a-entity id="world_root"></a-entity>
			<a-entity light="type: hemisphere; color: #ffffff; groundColor: #6b7a5a; intensity: 0.95"></a-entity>
			<a-entity light="type: directional; color: #fff7e8; intensity: 0.7" position="60 100 40"></a-entity>
			<!-- The rig carries no pitch. A pitched rig turns the camera's yaw
			     about a tilted axis, so the horizon leans further the more you
			     look around - a head tipped to one side. The opening look, a
			     little down, is the camera's own pitch instead, set by
			     travel_world.js on look-controls' pitch object, and the rig
			     underneath stays upright.
			     The walk is the rig's own: it moves in the ground plane and holds
			     its height, so a look down can never tip the eye under the ground
			     (A-Frame's wasd-controls moves whatever it sits on, and its pitch
			     handling is the library's to change).
			     Both drags are reversed: the scene comes with the pointer, as the
			     street map pans, rather than the eye swinging away from it. -->
			<a-entity id="world_rig" position="0 3 26" worldwalk="speed: 7; acceleration: 45">
				<a-entity id="world_cam" camera="fov: 68; near: 0.1; far: 900" look-controls="pointerLockEnabled: false; reverseMouseDrag: true; reverseTouchDrag: true"></a-entity>
			</a-entity>
			<a-entity cursor="rayOrigin: mouse" raycaster="objects: .clickable; far: 250"></a-entity>
		</a-scene>
		<div id="world_loading"><%= &subs::ui('Building the virtual world…') %></div>
		<div id="world_hint"><%= &subs::ui('WASD or arrow keys to walk · double-tap to step · drag to look · click a photo') %></div>
		<script src="/js/travel_world.js"></script>
	</body>
</html>
